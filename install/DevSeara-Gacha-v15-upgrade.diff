+	Sequence: 44, PendingTick: 48, Modal: 52, Spin: 56, RightPressed: 60,
+	RollLeadMs: 800, RevealStepMs: 220,
+	// Cosmetic stand-ins only: never use hidden reward IDs to select animation frames.
+	RollIcons: [501,1715,12210,14533,2289,14592,1716,14003,40001,40002],
+	Assets: ["arrow_off_left.png","arrow_off_right.png","arrow_on_left.png","arrow_on_right.png"],
