+	a.emit(0xFF,0x75,28); for(const v of [12,0]) n.pushImm(a,v);
+	a.emit(0x53,0x57,0xFF,0x75,20,0xFF,0x75,16,0x8B,0xCE); a.call(n.TextDraw); a.emit(0x58);
