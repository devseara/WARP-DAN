+		{id:7,x:600,y:355,w:22,h:22,page:-1},
+		{id:8,x:725,y:355,w:22,h:22,page:1},
+		{id:9,x:556,y:22,w:66,h:20,label:"Admin",view:5,admin:true},
+		// Compact English labels at 12px, with seven pixels of horizontal padding.
+		// These same bounds drive drawing, clicks and the native hand cursor.
+		{id:10,x:574,y:385,w:51,h:20,label:"Pull x1",count:1,compact:true},
+		{id:11,x:631,y:385,w:51,h:20,label:"Pull x5",count:5,compact:true},
