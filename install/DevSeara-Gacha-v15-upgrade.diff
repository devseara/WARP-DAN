+};
+GachaUIStatic.store = function(a, address, value) {
+	a.emit(0xC7,0x05); a.dword(address); a.dword(value);
+};
+GachaUIStatic.text = function(a, ptr, x, y, color=0x005A5A5A, bold=0, height=12) {
+	const n=AutoCombatUI.nativeHelpers;
+	for(const v of [0,bold,color,height,0,0,ptr,y,x]) n.pushImm(a,v);
+	a.emit(0x8B,0xCE); a.call(n.TextDraw);
+};
+// stdcall(window, source, x, y, maxWidth, color). Explicit byte lengths preserve
+// complete short labels; long text is bounded to its card. Returns the fitted
