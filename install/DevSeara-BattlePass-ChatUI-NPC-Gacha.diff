+	// DC is native ID 0x165 (dock); E4 is ID 0xCA (delete page).
+	// Do not relabel the delete button as return: it discards page identity.
+	place(0xE4, 0, true, "delete_hidden");
+	place(0xE0, 28, false, "gear_done");
