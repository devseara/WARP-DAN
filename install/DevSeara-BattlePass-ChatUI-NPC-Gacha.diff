+ModernChatUIStatic.buildFloatLayout = function()
+{
+	const a = AutoCombatUI.nativeHelpers.asm();
+	a.emit(0x53, 0x8B, 0xD9);
+	const place = (offset, right, hidden, label) => {
+		a.emit(0x8B, 0x8B); a.dword(offset); a.emit(0x85, 0xC9); a.jcc(0x84, label);
+		if (hidden) a.emit(0x6A, 0x9C, 0x6A, 0x9C);
+		else a.emit(0x6A, 4, 0x8B, 0x43, 0x14, 0x83, 0xE8, right, 0x50);
+		a.emit(0x8B, 0x01, 0xFF, 0x50, 0x10); a.label(label);
+	};
