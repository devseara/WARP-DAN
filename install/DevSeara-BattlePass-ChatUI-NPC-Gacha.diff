+ModernNpcDialog = function(_)
+{
+	const c = ModernNpcDialogStatic;
+	if (Exe.BuildDate !== c.BuildDate || typeof AutoCombatUI === "undefined" ||
+		typeof AutoCombatUI.nativeHelpers === "undefined" || typeof ModernChatUI === "undefined" ||
+		typeof ModernChatUI.nativeHelpers === "undefined")
+		throw Error("ModernNpcDialog requires the 2025-07-16 DevSeara native chat/UI helper scripts");
+	const n = AutoCombatUI.nativeHelpers;
+	for (const [name, table, original] of [["NPC text", c.SayVtable, c.SayDraw],
+		["NPC choices", c.ChoiceVtable, c.ChoiceDraw], ["2025 NPC choices", c.Choice3Vtable, c.ChoiceDraw],
+		["bitmap button", c.ButtonVtable, c.ButtonDraw]])
+		if (Exe.GetUint32(Exe.Vir2Phy(table + 0x50)) !== original)
+			throw Error("ModernNpcDialog: unexpected or already patched " + name + " draw slot");
+	n.assertCode("NPC text draw", c.SayDraw, "6A 00 6A 00 6A 00 6A 00 E8");
+	n.assertCode("NPC choice draw", c.ChoiceDraw, "6A 00 6A 00 6A 00 6A 00 E8");
+	n.assertCode("native bitmap button draw", c.ButtonDraw, "55 8B EC 51 56 8B F1");
+	n.assertCode("NPC text child background", 0x807630, "56 8B F1 FF B6 8C 00 00 00 E8");
+	n.assertCode("NPC text initial background", c.SayTextColorSite, "C7 81 8C 00 00 00 F2 F2 F2 FF");
+	// UIChoose3Wnd inherits the same child layout/Create, but retains its own
+	// native event handler. Verify both, then replace only its draw slot.
+	if (Exe.GetUint32(Exe.Vir2Phy(c.Choice3Vtable + 0x3C)) !== 0x8A3FC0 ||
+		Exe.GetUint32(Exe.Vir2Phy(c.Choice3Vtable + 0x94)) !== 0x8BE590)
+		throw Error("ModernNpcDialog: unexpected 2025 choice layout/event handler");
+	// Set the NPC-only creation default before its first text/layout/paint.
+	// Parent-paint invalidation alone is too late for the initial cached canvas.
+	// Leave the correct choice frame, selection styling and button draws intact.
+	Exe.SetUint32(Exe.Vir2Phy(c.SayTextColorSite + 6, CODE), 0xFFFFF7EE);
+	const fill = n.allocateCode(n.buildFillRect());
+	const round = n.allocateCode(c.buildRound(fill.vir));
+	const say = n.allocateCode(c.buildFrame(round.vir, false));
+	const choice = n.allocateCode(c.buildFrame(round.vir, true));
+	const roles = [];
+	for (const [names, prefix, width, height, off] of [
+		[["btn_apply.bmp"], "apply", 44, 18, false],
+		[["btn_buy.bmp", "btn_buy_out.bmp", "btn_buy_normal.bmp"], "buy", 44, 18, true],
+		[["btn_sell.bmp"], "sell", 44, 18, true],
+		[["btn_view.bmp"], "chance", 66, 18, false],
+		[["btn_close.bmp", "btn_cancel.bmp", "btn_close_normal.bmp"], "clos", 44, 18, false],
+		[["sys_close_off.bmp"], "cls_x", 9, 9, false],
+		[["btn_next.bmp"], "next2", 44, 18, false],
+		[["btn_ok.bmp"], "ok", 44, 18, true]])
+	{
+		const paths = ["out", "over", prefix === "cls_x" ? "over" : "press", off ? "off" : null]
+			.map(state => state ? n.buildResourcePath("genericsui\\" + prefix + "_" + state + ".png").vir : 0);
+		const bytes = [];
+		for (const value of [...paths, width, height])
+			bytes.push(value & 255, value >>> 8 & 255, value >>> 16 & 255, value >>> 24);
+		const descriptor = n.allocateBytes(bytes, 4).vir;
+		const parents = [...c.ButtonParents, ...(c.ExtraButtonParents[prefix] || [])];
+		for (const name of names) roles.push({name, descriptor, parents});
+	}
+	const lookup = n.allocateCode(c.buildLookup(roles));
+	const background = n.allocateCode(c.buildBackground());
+	const blend = n.allocateCode(ModernChatUI.nativeHelpers.buildBlendPixel());
+	const pngDraw = n.allocateCode(ModernChatUI.nativeHelpers.buildPngDraw(blend.vir));
+	const button = n.allocateCode(c.buildButton(lookup.vir, background.vir, pngDraw.vir));
+	for (const [table, draw] of [[c.SayVtable, say], [c.ChoiceVtable, choice],
+		[c.Choice3Vtable, choice], [c.ButtonVtable, button]])
+		Exe.SetUint32(Exe.Vir2Phy(table + 0x50), draw.vir);
+	const marker = n.allocateString("ModernNpcDialog.v3"), record = [];
+	for (const value of [marker.vir, say.vir, choice.vir, lookup.vir, background.vir, button.vir])
+		record.push(value & 255, value >>> 8 & 255, value >>> 16 & 255, value >>> 24);
+	n.allocateBytes(record, 4);
+	CACHE.put("ModernNpcDialog.Contract.v3", {say, choice, lookup, background, button, roles});
+	ModernNpcDialog.onApplied();
+	return true;
+};
+
+ModernNpcDialog.onApplied = function()
+{
+	if (Warp.TestMode) return;
+	const c = ModernNpcDialogStatic, source = Warp.Path + "/Assets/ModernNpcDialog";
+	const folders = ["data", "texture", ModernChatUI.nativeHelpers.uiPrefix(), "genericsui"];
+	const root = System.DirPath(Warp.TgtExe), target = root + "/" + folders.join("/"), missing = [];
+	for (const file of [...c.Assets, ...c.OptionalAssets])
+	{
+		const existing = new BinFile(target + "/" + file, 'r');
+		const present = existing.Valid; existing.Close();
+		if (present) continue;
+		const asset = new BinFile(source + "/" + file, 'r');
+		const available = asset.Valid; asset.Close();
+		if (!available && c.OptionalAssets.includes(file)) continue;
+		if (!available) throw Error("ModernNpcDialog: missing bundled image " + source + "/" + file);
+		missing.push(file);
+	}
+	if (!missing.length) return;
+	let directory = root;
+	for (const folder of folders)
+	{
+		directory += "/" + folder;
+		if (!System.MkDir(directory)) throw Error("ModernNpcDialog: cannot create " + directory);
+	}
+	for (const file of missing)
+		if (!System.Copy(source + "/" + file, target + "/" + file, false))
+			throw Error("ModernNpcDialog: cannot copy " + file + " to " + target);
+};
+
+ModernNpcDialog.validate = () => Exe.BuildDate === ModernNpcDialogStatic.BuildDate;
