+ModernChatUI.onApplied = function()
+{
+	if (Warp.TestMode) return;
+	const c = ModernChatUIStatic;
+	const source = Warp.Path + c.AssetPath;
+	const root = System.DirPath(Warp.TgtExe);
+	const folders = ["data", "texture", c.uiPrefix(), "uirenewal", "chat"];
+	const target = root + "/" + folders.join("/");
+	const missing = [];
+	for (const file of c.Assets)
+	{
+		// User-owned PNGs may have been recolored since the previous build.
+		const existing = new BinFile(target + "/" + file, 'r');
+		const present = existing.Valid;
+		existing.Close();
+		if (present) continue;
+		// Check the complete missing set before creating folders or copying.
+		const asset = new BinFile(source + "/" + file, 'r');
+		const available = asset.Valid;
+		asset.Close();
+		if (!available) throw Error("ModernChatUI: missing bundled image " + source + "/" + file);
+		missing.push(file);
+	}
+	if (missing.length === 0) return;
+	// Create every parent explicitly, including a previously absent data folder.
+	// Always use the selected output EXE, never the source client or WARP folder.
+	let directory = root;
+	for (const folder of folders)
+	{
+		directory += "/" + folder;
+		if (!System.MkDir(directory)) throw Error("ModernChatUI: cannot create " + directory);
+	}
+	for (const file of missing)
+		if (!System.Copy(source + "/" + file, target + "/" + file, false))
+			throw Error("ModernChatUI: cannot copy " + source + "/" + file + " to " + target + "/" + file);
+};
