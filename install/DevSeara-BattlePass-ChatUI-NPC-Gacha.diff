diff --git a/Scripts/Patches/AutoCombatUI.qjs b/Scripts/Patches/AutoCombatUI.qjs
index ba951c374b015e647666130e604c72cd6a896a6c..63db9cba0d74cd18ac43c1b492f98cdd8b65d568 100644
--- a/Scripts/Patches/AutoCombatUI.qjs
+++ b/Scripts/Patches/AutoCombatUI.qjs
@@ -739,6 +739,55 @@ AutoCombatUIStatic.packetTableEntryVir = function(packetId)
 	return AutoCombatUIStatic.PacketSwitchTable + (packetId - 0x73) * 4;
 };
 
+// BPUI and GCHA share one native receive opcode. Per-patch writes to that
+// dispatch slot do not compose: WARP can serialize the independent patch
+// records in a different order, and ordinary reads see the original handler.
+// Own the slot/cells in one shared global tag, as the 0x0BEF route already does.
+AutoCombatUIStatic.registerPacket0BF6 = function(patchName, protocol, handlerVir)
+{
+	const n=AutoCombatUIStatic;
+	if(protocol!=="bpui" && protocol!=="gcha") throw Error("Unknown shared 0x0BF6 protocol");
+	if(!Number.isInteger(handlerVir) || handlerVir<=0) throw Error("Missing shared 0x0BF6 handler");
+	const key="SharedPacket0BF6.Router.Global.v1", cacheKey="SharedPacket0BF6.Router.v1";
+	CACHE.addUser(key,patchName); Exe.ActivateGlobal(); Exe.BeginTag(CACHE.getTag(key));
+	try {
+		const entryVir=n.packetTableEntryVir(0x0BF6),entryPhy=Exe.Vir2Phy(entryVir,CODE);
+		if(entryPhy<0) throw Error("Shared 0x0BF6 dispatch entry is not executable");
+		let route=CACHE.get(cacheKey);
+		if(!route) {
+			const stock=Exe.GetUint32(entryPhy);
+			if(Exe.Vir2Phy(stock,CODE)<0) throw Error("Shared 0x0BF6 stock fallback is not executable");
+			const cells=n.allocateBytes(new Array(12).fill(0),4);
+			route={entryVir,entryPhy,bpuiCellPhy:cells.phy,bpuiCellVir:cells.vir,
+				gchaCellPhy:cells.phy+4,gchaCellVir:cells.vir+4,fallbackCellVir:cells.vir+8,
+				fallbackVir:stock===n.PacketDefaultHandler?n.PacketMainLoopReturn:stock};
+			Exe.SetUint32(cells.phy+8,route.fallbackVir);
+			const a=n.asm(); a.emit(0x9C,0x60,0xBE); a.dword(n.PacketBuffer);
+			a.emit(0x66,0x81,0x3E); a.word(0x0BF6); a.jcc(0x85,"stock");
+			a.emit(0x66,0x83,0x7E,2,8); a.jcc(0x82,"stock");
+			for(const [name,magic] of [["bpui",0x49555042],["gcha",0x41484347]]) {
+				a.emit(0x81,0x7E,4); a.dword(magic); a.jcc(0x84,name);
+			}
+			a.jmp("stock");
+			for(const name of ["bpui","gcha"]) {
+				a.label(name); a.emit(0x83,0x3D); a.dword(route[name+"CellVir"]); a.emit(0); a.jcc(0x84,"unselected");
+				a.emit(0x61,0x9D,0xFF,0x25); a.dword(route[name+"CellVir"]);
+			}
+			a.label("unselected"); a.emit(0x61,0x9D); a.jmp(n.PacketMainLoopReturn);
+			a.label("stock"); a.emit(0x61,0x9D,0xFF,0x25); a.dword(route.fallbackCellVir);
+			const code=n.allocateCode(a); route.routerVir=code.vir;
+			const marker=n.allocateString("SharedPacket0BF6.v1"),record=[];
+			for(const value of [marker.vir,entryVir,route.routerVir,route.bpuiCellVir,route.gchaCellVir,route.fallbackCellVir])
+				record.push(value&255,value>>>8&255,value>>>16&255,value>>>24);
+			n.allocateBytes(record,4); CACHE.put(cacheKey,route);
+		}
+		if(route.entryVir!==entryVir) throw Error("Shared 0x0BF6 route belongs to a different dispatcher");
+		Exe.SetUint32(route[protocol+"CellPhy"],handlerVir);
+		Exe.SetUint32(entryPhy,route.routerVir);
+		return route;
+	} finally { Exe.EndTag(); Exe.ActivePatch=patchName; }
+};
+
 AutoCombatUIStatic.buildSharedPacketRouter = function(route)
 {
 	const a = AutoCombatUIStatic.asm();
@@ -6996,3 +7045,6 @@ AutoCombatUI.validate = function()
 		return false;
 	}
 };
+
+// Shared native canvas/ABI helpers. Exporting these does not enable AutoCombatUI.
+AutoCombatUI.nativeHelpers = AutoCombatUIStatic;
diff --git a/Scripts/Patches/BattlepassUI.qjs b/Scripts/Patches/BattlepassUI.qjs
new file mode 100644
index 0000000000000000000000000000000000000000..0fbae90c071031c480674d37b73dbea9a3e4b870
--- /dev/null
+++ b/Scripts/Patches/BattlepassUI.qjs
@@ -0,0 +1,1646 @@
+/*
+ * Project Rebirth - native Battle Pass window, GPL-3.0-or-later.
+ * Author: DevSeara.
+ * Description: Adds a 796x510 UIFrameWnd using the 2025-07-16 client's
+ * own surface/text/input functions. @battlepassui opens it. BPUI snapshots
+ * use a magic-gated 0x0BF6 route; other emotion packets retain stock handling.
+ * No custom DLL, WebView, foreign UI thread, or runtime EXE/IAT patching.
+ * Native canvas/assembler helpers are provided by AutoCombatUI.qjs.
+ */
+
+const BattlepassUIStatic = {
+	BuildDate: 20250716, Width: 796, Height: 510, WindowId: 0x3F8,
+	// Transparent drawing space lets the original 26px hand cross the right
+	// edge. It is excluded from hit testing and from the visible layout.
+	CursorMargin: 25, FrameHitTest: 0x00A23220,
+	// One WARP height for every label; headings use bold for emphasis.
+	Font: { Body: 16, Heading: 16, Notes: 16, Button: 16, Title: 16, Tab: 16 },
+	RequestId: 0x0BF9, SnapshotId: 0x0BF6, Magic: 0x49555042,
+	PacketSize: 2872, VisualsSize: 2272, DetailsSize: 2240, LegacySize: 788, StateSize: 3028, Snapshot: 32, UserHidden: 3020,
+	EscapeHeld: 3024, KeyEvent: 0x00A471E0,
+	BrowsePage: 3012, BrowseTrack: 3016,
+	SelectionType: 2904, Difficulty: 2908, Pending: 2912, RequestValue: 2916, RewardMode: 2920,
+	RewardPending: 2924, Hover: 2928, Modal: 2932, QuoteToken: 2936, QuoteFee: 2940, CursorX: 2988, CursorY: 2992,
+	CursorPainted: 2996, PaintedX: 3000, PaintedY: 3004, QuoteNonce: 3008,
+	NativeSelection: 0x4000, DetailsAvailable: 0x8000,
+	Window: 0, Tab: 4, Pressed: 8, Timer: 12, SetTimer: 16, KillTimer: 20, Ready: 24,
+	Dragging: 28, FrameDragMove: 0x00880E00, FrameDragMoveSlot: 27,
+	Fields: {
+		player: [20, 24], mission: [44, 64], target: [108, 64],
+		progress: [172, 32], remaining: [204, 32], reward: [236, 48],
+		exp: [284, 32], level: [316, 32], track: [348, 24], fee: [372, 48],
+		status: [420, 48], limit: [468, 48], next: [516, 48], primary: [564, 32],
+		hunt: [596, 96], collect: [692, 96],
+		overall: [1200, 80], levelProgress: [1280, 80],
+		nextNormal: [1360, 64], nextNormalItem: [1424, 64],
+		nextPremium: [1488, 64], nextPremiumItem: [1552, 64],
+		rewardTitle: [1616, 80], rewardStatus: [1696, 64], habitatHint: [2776, 96]
+	}
