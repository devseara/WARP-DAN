+	const root = System.DirPath(Warp.TgtExe);
+	const folders = ["data", "texture", b.uiPrefix(), "battlepassui"];
+	const target = root + "/" + folders.join("/");
+	const missing = [];
+	for (const file of b.ClientAssets)
+	{
+		// Preserve client-side skin edits; install only absent images.
+		const existing = new BinFile(target + "/" + file, 'r');
+		const present = existing.Valid;
