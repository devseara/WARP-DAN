--- a/.gitattributes
+++ b/.gitattributes
@@ -1,6 +1,16 @@
 # Auto detect text files and perform LF normalization
 * text=auto
 
+# DevSeara native UI patches require CRLF and byte-exact raw artwork.
+Scripts/Patches/AutoCombatUI.qjs text eol=crlf
+Scripts/Patches/ModernChatUI.qjs text eol=crlf
+Scripts/Patches/ModernNpcDialog.qjs text eol=crlf
+Scripts/Patches/GachaUI.qjs text eol=crlf
+Assets/GachaUI/*.png binary
+Scripts/Patches/ChatItemIcons.qjs text eol=crlf
+Scripts/Patches/BattlepassUI.qjs text eol=crlf
+Assets/BattlepassUI/*.bgra binary
+
 # WARP requires CRLF; the runtime metadata also pins exact source bytes.
 Scripts/Patches/AllowDualCustomWeaponSprites.qjs text eol=crlf
 CustomDLL/DualWeapon/compositor.c text eol=crlf
