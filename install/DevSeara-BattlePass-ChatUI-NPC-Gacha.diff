+		a.emit(0x68); a.dword(face);
+		// pitch, non-antialiased quality, clipping/output precision, DEFAULT_CHARSET
+		for (const value of [0, 3, 0, 0, 1, 0, 0, 0, weight, 0, 0, 0, -font.size])
+			AutoCombatUI.nativeHelpers.pushImm(a, value);
+		a.emit(0xFF, 0x15); a.dword(0xFC1114); a.emit(0xA3); a.dword(state + offset);
+	};
+	create(font.weight, 0);
+	if (font.weight === 700) { a.emit(0xA1); a.dword(state); a.emit(0xA3); a.dword(state + 16); }
+	else create(700, 16);
+	a.label("done"); a.emit(0x5B);
+	a.label("cached"); a.emit(0x83, 0x7C, 0x24, 4, 0); a.jcc(0x85, "selected");
+	a.emit(0xA1); a.dword(state); a.emit(0xC2, 4, 0);
+	a.label("selected"); a.emit(0xA1); a.dword(state + 16); a.emit(0xC2, 4, 0);
+	return a;
+};
