+ModernChatUIStatic.getTabFont = function()
+{
+	const name = Exe.GetUserInput("$modernChatTabFontName", D_FontName,
+		"Chat Tab Font", "Font family for Main, Party, Battle, Guild and Market only",
+		"Tahoma", {saveDefault: true, sampleSize: 8});
+	if (name === false) Cancel("Chat Tab Font", "Tahoma");
+	const size = Exe.GetUserInput("$modernChatTabFontSize", D_FontSize,
+		"Chat Tab Font Size", "Character height in pixels (8-16, tab rows stay 20px)",
+		8, {sampleName: name, min: 8, max: 16, saveDefault: true});
+	if (size === false) Cancel("Chat Tab Font Size selection cancelled");
+	if (!Number.isInteger(size) || size < 8 || size > 16)
+		throw Error("ModernChatUI: chat tab font size must be between 8 and 16");
+	const style = Exe.GetUserInput("$modernChatTabFontStyle", D_Choice,
+		"Chat Tab Font Style", "Weight for unselected tabs; the selected tab is always white and bold", "Normal",
+		{choices: ["Normal", "Bold"], saveDefault: true});
+	if (style === false) Cancel("Chat Tab Font Style selection cancelled");
+	if (!["Normal", "Bold"].includes(style)) throw Error("ModernChatUI: unsupported tab font style");
+	return {name, size, weight: style === "Bold" ? 700 : 400};
+};
