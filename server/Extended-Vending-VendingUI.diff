+// Included by vending.cpp, so all server build variants compile this module.
+// Currency selection and item currency support derived from Lilith / Easycore
+// Extended_Vending_V3.01. No virtual item IDs collide with the live item DB.
+#include "extended_vending.hpp"
+#include <algorithm>
+#include <array>
+#include <vector>
+#include <map>
+
+namespace extended_vending {
+using namespace vending_ui_wire;
+struct CurrencyData {uint32 id;int32 tax=-1;};
+class CurrencyDatabase final : public TypesafeYamlDatabase<uint32,CurrencyData> {
+public:
+    CurrencyDatabase():TypesafeYamlDatabase("ITEM_VENDING_DB",1){}
+    const std::string getDefaultLocation() override {return std::string(db_path)+"/item_vending_db.yml";}
+    uint64 parseBodyNode(const ryml::NodeRef& node) override {
+        std::string name;if(!asString(node,"Item",name))return 0;
+        auto item=item_db.search_aegisname(name.c_str());
+        if(!item || !itemdb_isstackable2(item.get()) || item->flag.guid || item->flag.autoequip){invalidWarning(node,"Currency must be an existing stackable item without GUID/autoequip.\n");return 0;}
+        int32 rate=-1;if(node.has_child("Tax") && !asInt32(node,"Tax",rate))return 0;
+        if(rate < -1 || rate>10000){invalidWarning(node,"Tax must be -1 or 0..10000.\n");return 0;}
+        auto entry=std::make_shared<CurrencyData>();entry->id=item->nameid;entry->tax=rate;put(entry->id,entry);return 1;
+    }
+};
+static CurrencyDatabase currencies;
+void load(){currencies.clear();currencies.load();}
+bool allowed(uint32 currency){return currency==0 || (battle_config.extended_vending && (currency==cash?battle_config.extended_vending_cash!=0:currencies.exists(currency)));}
+static bool plain(const item& it,uint32 id){
+    if(it.nameid!=id || it.amount<=0 || it.bound || it.expire_time || it.unique_id || it.equip || it.equipSwitch || it.refine || it.attribute || !it.identify || it.enchantgrade)return false;
+    for(auto card:it.card)if(card)return false;
+    for(const auto& option:it.option)if(option.id || option.value || option.param)return false;
+    return true;
+}
+static uint32 balance(const map_session_data& sd,uint32 currency){
+    if(!currency)return sd.status.zeny;if(currency==cash)return static_cast<uint32>(std::max(0,sd.cashPoints));
+    uint32 result=0;for(int i=0;i<MAX_INVENTORY;++i)if(sd.inventory_data[i] && plain(sd.inventory.u.items_inventory[i],currency))result+=sd.inventory.u.items_inventory[i].amount;return result;
+}
+int32 tax(const map_session_data& seller){auto row=currencies.find(seller.vend_currency);return row && row->tax>=0?row->tax:battle_config.vending_tax;}
+uint32 net(const map_session_data& seller,uint32 gross){int32 rate=tax(seller);return gross>=static_cast<uint32>(battle_config.vending_tax_min)?static_cast<uint32>(static_cast<uint64>(gross)*(10000-rate)/10000):gross;}
+static void currency_name(char* out,size_t size,uint32 id){if(!id)safestrncpy(out,"Zeny",size);else if(id==cash)safestrncpy(out,"Cash Points",size);else{auto item=item_db.find(id);safestrncpy(out,item?item->ename.c_str():"Unavailable currency",size);}}
+static uint32 display_id(uint32 id){auto view=itemdb_viewid(id);return view?view:id;}
+static Row row(const item& item,int index,uint32 amount,uint32 price){
+    Row r{};r.item=display_id(item.nameid);r.index=index+2;r.amount=amount;r.price=price;r.identified=item.identify;r.refine=item.refine;r.grade=item.enchantgrade;r.type=static_cast<uint8>(itemdb_type(item.nameid));
+    for(unsigned i=0;i<4;++i)r.cards[i]=item.card[i] && !itemdb_isspecial(item.card[0])?display_id(item.card[i]):item.card[i];
+    for(unsigned i=0;i<5;++i){uint16 id=item.option[i].id;int16 value=item.option[i].value;memcpy(r.options+i*5,&id,2);memcpy(r.options+i*5+2,&value,2);r.options[i*5+4]=item.option[i].param;}return r;
+}
+static void send(const map_session_data& receiver,const map_session_data& seller,Mode mode,const std::vector<Row>& rows,const char* message=""){
+    if(!battle_config.vending_ui || receiver.fd<=0 || rows.size()>max_rows)return;
+    Header h{};h.opcode=snapshot_id;h.magic=magic;h.version=version;h.mode=mode;h.nonce=receiver.vend_ui_nonce;h.owner=seller.status.account_id;h.shop=seller.vender_id;
+    h.currency=seller.vend_currency;h.balance=balance(receiver,h.currency);h.max_price=battle_config.vending_max_value;h.max_slots=std::min<int>(MAX_VENDING,2+pc_checkskill(const_cast<map_session_data*>(&seller),MC_VENDING));
+    h.count=static_cast<uint16>(rows.size());h.tax=static_cast<uint16>(tax(seller));
+    h.history_count=mode==Owner?std::min<unsigned>(seller.vend_ui_history_count,max_history):0;
+    safestrncpy(h.title,seller.message,sizeof(h.title));safestrncpy(h.owner_name,seller.status.name,sizeof(h.owner_name));currency_name(h.currency_name,sizeof(h.currency_name),h.currency);safestrncpy(h.message,message,sizeof(h.message));
+    h.length=static_cast<uint16>(sizeof(h)+rows.size()*sizeof(Row)+h.history_count*sizeof(History));
+    std::vector<uint8> bytes(h.length);memcpy(bytes.data(),&h,sizeof(h));if(!rows.empty())memcpy(bytes.data()+sizeof(h),rows.data(),rows.size()*sizeof(Row));
+    if(h.history_count)memcpy(bytes.data()+sizeof(h)+rows.size()*sizeof(Row),seller.vend_ui_history,h.history_count*sizeof(History));
+    clif_send(bytes.data(),h.length,&receiver,SELF);
+}
+static std::vector<Row> stock(const map_session_data& sd){std::vector<Row> rows;for(int i=0;i<sd.vend_num && rows.size()<max_rows;++i){const auto& v=sd.vending[i];if(v.index>=0 && v.index<MAX_CART && v.amount>0)rows.push_back(row(sd.cart.u.items_cart[v.index],v.index,v.amount,v.value));}return rows;}
+static void show_setup(map_session_data& sd){
+    std::vector<Row> rows;for(int i=0;i<MAX_CART && rows.size()<max_rows;++i){const auto& it=sd.cart.u.items_cart[i];
+        if(it.nameid && it.amount>0 && it.id && it.identify && !it.attribute && !it.expire_time && (!it.bound || pc_can_give_bounded_items(&sd)) && itemdb_cantrade(&it,pc_get_group_level(&sd),pc_get_group_level(&sd)))rows.push_back(row(it,i,it.amount,0));}
+    send(sd,sd,Setup,rows);
+}
+bool setup(map_session_data& sd,uint16 slots){
+    if(!battle_config.vending_ui)return false;
+    sd.vend_currency=0;sd.vend_ui_phase=1;sd.vend_ui_slots=std::min<int>(slots,MAX_VENDING);sd.vend_ui_history_count=0;if(++sd.vend_ui_nonce==0)++sd.vend_ui_nonce;
+    std::vector<Row> rows;Row z{};z.index=0;z.amount=sd.status.zeny;rows.push_back(z);
+    if(battle_config.extended_vending){if(battle_config.extended_vending_cash){Row c{};c.index=cash;c.amount=balance(sd,cash);rows.push_back(c);}
+        std::map<uint32,std::shared_ptr<CurrencyData>> sorted(currencies.begin(),currencies.end());for(const auto& pair:sorted){if(rows.size()==max_rows)break;Row r{};r.item=r.index=pair.first;r.identified=1;r.amount=balance(sd,pair.first);rows.push_back(r);}}
+    if(rows.size()==1){sd.vend_ui_phase=2;show_setup(sd);}else send(sd,sd,Currency,rows);return true;
+}
+bool list(const map_session_data& receiver,const map_session_data& seller){if(!battle_config.vending_ui)return false;send(receiver,seller,Buyer,stock(seller));return true;}
+bool owner(const map_session_data& sd){if(!battle_config.vending_ui)return false;send(sd,sd,Owner,stock(sd));return true;}
+bool report(map_session_data& seller,uint16 index,uint16 amount,uint32 buyer,int32 total){
+    if(!battle_config.vending_ui)return false;
+    for(unsigned i=std::min<unsigned>(seller.vend_ui_history_count,max_history-1);i>0;--i)seller.vend_ui_history[i]=seller.vend_ui_history[i-1];
+    auto& h=seller.vend_ui_history[0];h={};
+    // A sold-out cart slot has already been cleared; retain the last snapshot ID.
+    if(index<MAX_CART)h.item=display_id(seller.vend_ui_item_ids[index]);h.amount=amount;h.total=std::max(0,total);h.time=static_cast<uint32>(time(nullptr));
+    auto* customer=map_charid2sd(buyer);if(customer)safestrncpy(h.buyer,customer->status.name,sizeof(h.buyer));else safestrncpy(h.buyer,"Customer",sizeof(h.buyer));
+    seller.vend_ui_history_count=std::min<unsigned>(seller.vend_ui_history_count+1,max_history);owner(seller);return true;
+}
+void closed(map_session_data& sd){sd.vend_ui_phase=0;sd.vend_currency=0;if(battle_config.vending_ui)send(sd,sd,Closed,{});}
+void failure(const map_session_data& sd,const char* message){if(battle_config.vending_ui)send(sd,sd,Error,{},message);}
+void process(map_session_data& sd,const Request& r){
+    if(!battle_config.vending_ui || r.opcode!=request_id || r.length!=sizeof(r) || r.magic!=magic || r.version!=version || r.reserved || r.nonce!=sd.vend_ui_nonce)return;
+    if(r.action==SelectCurrency && sd.vend_ui_phase==1 && sd.state.prevend && !sd.state.vending && allowed(r.arg) && pc_can_give_items(&sd) && !pc_isdead(&sd)){
+        sd.vend_currency=r.arg;sd.vend_ui_phase=2;show_setup(sd);
+    }else if(r.action==Cancel && (sd.vend_ui_phase==1 || sd.vend_ui_phase==2) && sd.state.prevend && !sd.state.vending){sd.state.prevend=0;sd.state.workinprogress=WIP_DISABLE_NONE;closed(sd);}
+}
+
+// Match pc_additem's slot and stack rules on a private inventory copy. Multiple
+// goods with the same ItemId are checked cumulatively, including cards/unique ID.
+static bool simulate_add(std::array<item,MAX_INVENTORY>& inv,int slots,const item& incoming,int amount){
+    auto data=item_db.find(incoming.nameid);if(!data || amount<=0 || amount>MAX_AMOUNT || (data->stack.inventory && amount>data->stack.amount))return false;
+    int found=-1;if(itemdb_isstackable2(data.get()) && !incoming.expire_time && !data->flag.guid){for(int i=0;i<MAX_INVENTORY;++i)if(inv[i].nameid==incoming.nameid && inv[i].bound==incoming.bound && !inv[i].expire_time && inv[i].unique_id==incoming.unique_id && memcmp(inv[i].card,incoming.card,sizeof(incoming.card))==0){found=i;break;}}
+    if(found>=0){if(found>=slots || amount>MAX_AMOUNT-inv[found].amount || (data->stack.inventory && amount>data->stack.amount-inv[found].amount))return false;inv[found].amount+=amount;}
+    else{for(int i=0;i<std::min(slots,MAX_INVENTORY);++i)if(!inv[i].nameid){inv[i]=incoming;inv[i].amount=amount;return true;}return false;}return true;
+}
+bool preflight_goods(map_session_data& buyer,map_session_data& seller,const uint8* data,int count){
+    std::array<item,MAX_INVENTORY> inventory;memcpy(inventory.data(),buyer.inventory.u.items_inventory,sizeof(inventory));
+    for(int i=0;i<count;++i){uint16 amount,index;memcpy(&amount,data+4*i,2);memcpy(&index,data+4*i+2,2);if(index<2 || index>=MAX_CART+2 || !simulate_add(inventory,buyer.status.inventory_slots,seller.cart.u.items_cart[index-2],amount))return false;}return true;
+}
+bool validate_payment(map_session_data& buyer,map_session_data& seller,int64 gross){
+    if(gross<0 || gross>MAX_ZENY || !allowed(seller.vend_currency))return false;
+    auto cost=static_cast<uint32>(gross),income=net(seller,cost),currency=seller.vend_currency;
+    if(balance(buyer,currency)<cost)return false;
+    if(!currency)return battle_config.vending_over_max || income<=MAX_ZENY-seller.status.zeny;
+    if(currency==cash)return buyer.status.account_id!=seller.status.account_id && income<=static_cast<uint32>(MAX_CASHPOINT-seller.cashPoints);
+    auto info=item_db.find(currency);if(!info || !itemdb_isstackable2(info.get()) || info->flag.guid || info->flag.autoequip)return false;
+    item payment{};payment.nameid=currency;payment.identify=1;
+    if(!itemdb_cantrade(&payment,pc_get_group_level(&buyer),pc_get_group_level(&seller)))return false;
+    if(static_cast<uint64>(info->weight)*income+seller.weight>seller.max_weight)return false;
+    if(!income)return true;
+    std::array<item,MAX_INVENTORY> inventory;memcpy(inventory.data(),seller.inventory.u.items_inventory,sizeof(inventory));
+    return simulate_add(inventory,seller.status.inventory_slots,payment,income);
+}
+bool pay(map_session_data& buyer,map_session_data& seller,int64 gross){
+    if(!validate_payment(buyer,seller,gross))return false;
+    uint32 cost=static_cast<uint32>(gross),income=net(seller,cost),currency=seller.vend_currency;
+    if(!currency){if(pc_payzeny(&buyer,cost,LOG_TYPE_VENDING,seller.status.char_id))return false;pc_getzeny(&seller,income,LOG_TYPE_VENDING,buyer.status.char_id);achievement_update_objective(&buyer,AG_SPEND_ZENY,1,cost);return true;}
+    if(currency==cash){if(pc_paycash(&buyer,cost,0,LOG_TYPE_VENDING)<0)return false;return !income || pc_getcash(&seller,income,0,LOG_TYPE_VENDING)==static_cast<int32>(income);}
+    // All payment slots and seller capacity are validated before mutation.
+    // Commit the currency inventory changes together, then notify/log; native
+    // item-event scripts cannot observe a half-paid purchase or re-enter it.
+    std::array<item,MAX_INVENTORY> before;memcpy(before.data(),buyer.inventory.u.items_inventory,sizeof(before));
+    std::array<item,MAX_INVENTORY> credited;memcpy(credited.data(),seller.inventory.u.items_inventory,sizeof(credited));
