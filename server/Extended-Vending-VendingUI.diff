+    for(int i=0;i<MAX_INVENTORY;++i)if(credited[i].nameid==currency && credited[i].amount!=seller.inventory.u.items_inventory[i].amount){seller.inventory.u.items_inventory[i]=credited[i];seller.inventory_data[i]=info.get();seller.last_addeditem_index=i;}
