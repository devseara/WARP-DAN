*                                                                          *
*   Author(s)     : Louis T Steinhil                                       *
*   Created Date  : 2026-06-21                                             *
*                                                                          *
*   Description   : Opens the 2025-07-16 client's original character-      *
*                   select PIN windows over the active in-game scene. BOH  *
*                   map packet 0x0BEF/PINC is handled on the main client   *
*                   thread; the stock UI then sends its native PIN reply   *
*                   packets through the current map connection. No custom *
*                   DLL, runtime hook, or replacement keypad is used.      *
*                                                                          *
\**************************************************************************/

InGamePincodeUI = function(_)
{
	$$(_, 1, `Validate native in-game PIN bridge`);
	if (Exe.BuildDate !== 20250716)
		Cancel("InGamePincodeUI currently supports only the 2025-07-16 client");

	const c = InGamePincodeUI.Constants;
	InGamePincodeUI.validateClient(c);

	const entryVir = InGamePincodeUI.tableEntryVir(c.SwitchTableVir, c.PacketId);
	const entryPhy = Exe.Vir2Phy(entryVir, CODE);
	if (entryPhy < 0)
		throw Error("InGamePincodeUI: could not resolve map packet dispatcher entry");

	const stateKey = "InGamePincodeUI.State.StockUi.v5";
	const state = CACHE.get(stateKey);
	const previousStockState = CACHE.get("InGamePincodeUI.State.StockUi.v4");
	const olderStockState = CACHE.get("InGamePincodeUI.State.StockUi.v3");
	const oldestStockState = CACHE.get("InGamePincodeUI.State.StockUi.v2");
	const legacyDllState = CACHE.get("InGamePincodeUI.State.CustomDll.v1");
	const legacyState = CACHE.get("InGamePincodeUI.State");
	const current = Exe.GetUint32(entryPhy);

	if (state && state.entryVir === entryVir && current === state.handlerVir)
	{
		$$(_, 1.1, `Native in-game PIN bridge already installed`);
		return true;
	}

	const ownsCurrent =
		(state && state.handlerVir === current) ||
		(previousStockState && previousStockState.handlerVir === current) ||
		(olderStockState && olderStockState.handlerVir === current) ||
		(oldestStockState && oldestStockState.handlerVir === current) ||
		(legacyDllState && legacyDllState.handlerVir === current) ||
		(legacyState && legacyState.handlerVir === current);
	if (current !== c.DefaultHandlerVir && !ownsCurrent)
		throw Error(`InGamePincodeUI: packet 0x${c.PacketId.toString(16).toUpperCase()} dispatcher entry is ${current.toHex(true)}, expected ${c.DefaultHandlerVir.toHex(true)}`);

	$$(_, 2, `Allocate native PIN bridge state`);
	const [retryPhy, retryVir] = Exe.Allocate(8, 4);
	const traceVir = retryVir + 4;
	Exe.SetUint32(retryPhy, 0);
	Exe.SetUint32(retryPhy + 4, 0);

	$$(_, 3, `Allocate stock PIN window dispatcher`);
	let stubBytes = InGamePincodeUI.makeMainStub(0, retryVir, traceVir, c);
	const [stubPhy, stubVir] = Exe.Allocate(stubBytes.length, 0x10);
	stubBytes = InGamePincodeUI.makeMainStub(stubVir, retryVir, traceVir, c);
	Exe.SetHex(stubPhy, InGamePincodeUI.bytesToHex(stubBytes));

	$$(_, 4, `Route BOH PIN trigger to stock client UI`);
	if (Exe.GetUint32(entryPhy) !== current)
		throw Error("InGamePincodeUI: dispatcher entry changed while applying patch");
	Exe.SetUint32(entryPhy, stubVir);

	CACHE.put(stateKey, {
		version: 5,
		packetId: c.PacketId,
		entryVir,
		handlerVir: stubVir,
		retryVir,
		traceVir
	});

	return true;
};

InGamePincodeUI.Constants = {
	PacketId: 0x0BEF,
	PacketMinLen: 18,
	PacketMagic: 0x434E4950,
	PacketBufferVir: 0x015E8198,
	SwitchTableVir: 0x00CAA2E0,
	DefaultHandlerVir: 0x00CAA2B7,
	MainLoopReturnVir: 0x00C9E1DD,

	PinUiFlagVir: 0x015FFA78,
	PinModeVir: 0x015FFA80,
	PinSeedVir: 0x015FFA84,
	PinAidVir: 0x015FFA88,
	InterfaceNamePtrVir: 0x01212D08,
	UiManagerVir: 0x0131F4E8,
	SecondPasswordInputWindowPtrVir: 0x0131F8A0,
	SecondPasswordEditWindowPtrVir: 0x0131F8A4,

	GetResourceManagerVir: 0x00A90350,
	LookupResourceVir: 0x00A9F030,
	ResolveResourceVir: 0x00A8D4A0,
	LoadUiResourceVir: 0x00A4BBF0,
	CreateWindowVir: 0x00A39340,
	CloseWindowVir: 0x00A2E770,
	GetMessageVir: 0x00A9ED30,
	ShowMessageVir: 0x00A31A30,
	FormatStringVir: 0x00A94930,
	DestroyStringVir: 0x004F08F0,

	SecondPasswordInputWindow: 0x00C7,
	SecondPasswordEditWindow: 0x00C8,
	MessageStyleVir: 0x00FDA1A0
};

InGamePincodeUI.makeAssembler = function()
{
	const bytes = [];
	const labels = {};
	const fixups = [];

	function put32(out, pos, value)
	{
		value = value >>> 0;
		out[pos] = value & 0xFF;
		out[pos + 1] = (value >>> 8) & 0xFF;
		out[pos + 2] = (value >>> 16) & 0xFF;
		out[pos + 3] = (value >>> 24) & 0xFF;
	}

	return {
		bytes,
		emit: function()
		{
			for (let i = 0; i < arguments.length; ++i)
				bytes.push(arguments[i] & 0xFF);
		},
		word: function(value)
		{
			this.emit(value, value >>> 8);
		},
		dword: function(value)
		{
			const pos = bytes.length;
			this.emit(0, 0, 0, 0);
			put32(bytes, pos, value);
			return pos;
		},
		label: function(name)
		{
			if (Object.prototype.hasOwnProperty.call(labels, name))
				throw Error(`InGamePincodeUI: duplicate label ${name}`);
			labels[name] = bytes.length;
		},
		rel32: function(opcode, target)
		{
			this.emit(opcode);
			const pos = this.dword(0);
			fixups.push({pos, target});
		},
		call: function(target) { this.rel32(0xE8, target); },
		jmp: function(target) { this.rel32(0xE9, target); },
		jcc: function(opcode, target)
		{
			this.emit(0x0F, opcode);
			const pos = this.dword(0);
			fixups.push({pos, target});
		},
		finish: function(baseVir)
		{
			const out = bytes.slice();
			for (const fixup of fixups)
			{
				if (typeof fixup.target === "string" &&
					!Object.prototype.hasOwnProperty.call(labels, fixup.target))
					throw Error(`InGamePincodeUI: unresolved label ${fixup.target}`);
				const targetVir = typeof fixup.target === "string"
					? baseVir + labels[fixup.target]
					: fixup.target;
				put32(out, fixup.pos, targetVir - (baseVir + fixup.pos + 4));
			}
			return out;
		}
	};
};

InGamePincodeUI.makeMainStub = function(stubVir, retryVir, traceVir, c)
{
	const a = InGamePincodeUI.makeAssembler();

	function setDword(address, value)
	{
		a.emit(0xC7, 0x05); a.dword(address); a.dword(value);
	}

	function setByte(address, value)
	{
		a.emit(0xC6, 0x05); a.dword(address); a.emit(value);
	}

	function pushDword(value)
	{
		a.emit(0x68); a.dword(value);
	}

	let eventDispatchIndex = 0;
	function dispatchWindowEvent(windowPtrVir, eventId)
	{
		const doneLabel = `window_event_done_${eventDispatchIndex++}`;
		a.emit(0x8B, 0x0D); a.dword(windowPtrVir); // MOV ECX,[window pointer]
		a.emit(0x85, 0xC9);                       // TEST ECX,ECX
		a.jcc(0x84, doneLabel);                   // JZ
		pushDword(0);
		pushDword(0);
		pushDword(0);
		a.emit(0x8B, 0x01);                       // MOV EAX,[ECX]
		pushDword(eventId);
		pushDword(6);
		pushDword(0);
		a.emit(0xFF, 0x90); a.dword(0x94);        // CALL [EAX+94h]
		a.label(doneLabel);
	}

	function openState(mode, flag, windowId, windowPtrVir, postEventIds)
	{
		a.call("close_pin_windows");
		setDword(c.PinModeVir, mode);
		setByte(c.PinUiFlagVir, flag);
		setDword(retryVir, 0);
		pushDword(windowId);
		a.call("show_pin_window");
		for (const eventId of postEventIds)
			dispatchWindowEvent(windowPtrVir, eventId);
		a.jmp("done");
	}

	// The map receive switch executes in the normal client update thread.
	// Preserve its complete register/flag contract before calling UI code.
	a.emit(0x9C, 0x60);                         // PUSHFD / PUSHAD
	a.emit(0xBE); a.dword(c.PacketBufferVir);   // MOV ESI, packet buffer
	a.emit(0x66, 0x81, 0x3E); a.word(c.PacketId);
	a.jcc(0x85, "done");                       // JNE
	a.emit(0x66, 0x83, 0x7E, 0x02, c.PacketMinLen);
	a.jcc(0x82, "done");                       // JB
	a.emit(0x81, 0x7E, 0x04); a.dword(c.PacketMagic);
	a.jcc(0x85, "done");                       // JNE

	a.emit(0x0F, 0xB7, 0x46, 0x10);            // MOVZX EAX,word [ESI+16]
	a.emit(0x83, 0xF8, 0x08);                  // CMP EAX,8
	a.jcc(0x87, "done");                       // JA
	a.emit(0x8B, 0xD0);                        // MOV EDX,EAX
	a.emit(0x81, 0xCA); a.dword(0x100);         // OR EDX,100h
	a.emit(0x89, 0x15); a.dword(traceVir);      // trace: packet accepted + state
	a.emit(0x8B, 0x56, 0x08);                  // MOV EDX,[ESI+8]
	a.emit(0x89, 0x15); a.dword(c.PinSeedVir);  // MOV [seed],EDX
	a.emit(0x8B, 0x56, 0x0C);                  // MOV EDX,[ESI+12]
	a.emit(0x89, 0x15); a.dword(c.PinAidVir);   // MOV [AID],EDX

	a.emit(0x83, 0xF8, 0x00); a.jcc(0x84, "state_ok");
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x84, "state_ask");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x84, "state_notset");
	a.emit(0x83, 0xF8, 0x03); a.jcc(0x84, "state_expired");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x84, "state_new");
	a.emit(0x83, 0xF8, 0x05); a.jcc(0x84, "state_illegal");
	a.emit(0x83, 0xF8, 0x06); a.jcc(0x84, "state_rejected");
	a.emit(0x83, 0xF8, 0x07); a.jcc(0x84, "state_passed");
	a.jmp("state_wrong");

	a.label("state_ok");
	a.call("close_pin_windows");
	setDword(c.PinModeVir, 0);
	setDword(retryVir, 0);
	a.jmp("done");

	a.label("state_ask");
	openState(2, 0, c.SecondPasswordInputWindow, 0, []);

	a.label("state_notset");
	openState(4, 1, c.SecondPasswordEditWindow,
		c.SecondPasswordEditWindowPtrVir, [0x0124, 0x00B8]);

	a.label("state_expired");
	openState(3, 0, c.SecondPasswordInputWindow,
		c.SecondPasswordInputWindowPtrVir, [0x0124]);

	a.label("state_new");
	openState(5, 1, c.SecondPasswordEditWindow, 0, []);

	a.label("state_illegal");
	a.call("close_pin_windows");
	pushDword(0x0768);
	a.call("show_message_id");
	a.call("reopen_pin_window");
	a.jmp("done");

	a.label("state_rejected");
	a.call("close_pin_windows");
	pushDword(0x0769);
	a.call("show_message_id");
	a.call("reopen_pin_window");
	a.jmp("done");

	a.label("state_passed");
	a.call("close_pin_windows");
	setDword(c.PinModeVir, 1);
	setDword(retryVir, 0);
	a.jmp("done");

	a.label("state_wrong");
	a.call("close_pin_windows");
	a.emit(0xA1); a.dword(retryVir);            // MOV EAX,[retry]
	a.emit(0x40);                               // INC EAX
	a.emit(0xA3); a.dword(retryVir);            // MOV [retry],EAX
	a.emit(0x83, 0xF8, 0x03);                  // CMP EAX,3
	a.jcc(0x83, "wrong_limit");                // JAE
	a.emit(0xB9); a.dword(3);                  // MOV ECX,3
	a.emit(0x2B, 0xC8);                        // SUB ECX,EAX
	a.emit(0x51);                               // PUSH ECX
	a.call("show_wrong_message");
	a.call("reopen_pin_window");
	a.jmp("done");

	a.label("wrong_limit");
	setDword(c.PinModeVir, 0);
	pushDword(0x0773);
	a.call("show_message_id");
	a.jmp("done");

	a.label("done");
	a.emit(0x61, 0x9D);                        // POPAD / POPFD
	a.emit(0xB8); a.dword(c.MainLoopReturnVir);
	a.emit(0xFF, 0xE0);                        // JMP EAX

	// void __stdcall close_pin_windows()
	a.label("close_pin_windows");
	pushDword(c.SecondPasswordInputWindow);
	a.emit(0xB9); a.dword(c.UiManagerVir);
	a.call(c.CloseWindowVir);
	pushDword(c.SecondPasswordEditWindow);
	a.emit(0xB9); a.dword(c.UiManagerVir);
	a.call(c.CloseWindowVir);
	a.emit(0xC3);

	// void __stdcall reopen_pin_window()
	a.label("reopen_pin_window");
	a.emit(0xA1); a.dword(c.PinModeVir);
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x82, "reopen_done");
	a.emit(0x83, 0xF8, 0x05); a.jcc(0x87, "reopen_done");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x83, "reopen_edit");
	pushDword(c.SecondPasswordInputWindow);
	a.call("show_pin_window");
	a.emit(0xC3);
	a.label("reopen_edit");
	pushDword(c.SecondPasswordEditWindow);
	a.call("show_pin_window");
	a.label("reopen_done");
	a.emit(0xC3);

	// void __stdcall show_pin_window(uint32 windowId)
	// This is the character-select resource-load/create path from D2534B.
	a.label("show_pin_window");
	a.emit(0x55, 0x8B, 0xEC, 0x53);            // PUSH EBP / MOV EBP,ESP / PUSH EBX
	setDword(traceVir, 0x200);                  // entered stock resource path
	a.call(c.GetResourceManagerVir);
	a.emit(0x85, 0xC0); a.jcc(0x84, "show_pin_create");
	setDword(traceVir, 0x201);                  // resource manager available
	a.emit(0x8B, 0xD8);                        // MOV EBX,EAX
	a.emit(0xFF, 0x35); a.dword(c.InterfaceNamePtrVir);
	a.call(c.LookupResourceVir);
	a.emit(0x83, 0xC4, 0x04);                  // caller cleans lookup argument
	a.emit(0x85, 0xC0); a.jcc(0x84, "show_pin_create");
	setDword(traceVir, 0x202);                  // interface resource located
	a.emit(0x50, 0x8B, 0xCB);                  // PUSH EAX / MOV ECX,EBX
	a.call(c.ResolveResourceVir);
	a.emit(0x85, 0xC0); a.jcc(0x84, "show_pin_create");
	setDword(traceVir, 0x203);                  // interface resource resolved
	a.emit(0x50);                              // PUSH resolved resource
	a.emit(0xB9); a.dword(c.UiManagerVir);
	a.call(c.LoadUiResourceVir);
	setDword(traceVir, 0x204);                  // stock resource load attempted
	a.label("show_pin_create");
	setDword(traceVir, 0x205);                  // stock window factory reached
	a.emit(0xFF, 0x75, 0x08);                  // PUSH [EBP+8] window id
	a.emit(0xB9); a.dword(c.UiManagerVir);
	a.call(c.CreateWindowVir);
	a.emit(0x85, 0xC0); a.jcc(0x84, "show_pin_failed");
	setDword(traceVir, 0x206);                  // factory returned a window
	a.jmp("show_pin_done");
	a.label("show_pin_failed");
	setDword(traceVir, 0x2FF);                  // factory rejected the window
	a.label("show_pin_done");
	a.emit(0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x04, 0x00);

	// void __stdcall show_message_id(uint32 messageId)
	a.label("show_message_id");
	a.emit(0x55, 0x8B, 0xEC);
	a.emit(0xFF, 0x75, 0x08);
	a.call(c.GetMessageVir);
	a.emit(0x83, 0xC4, 0x04);
	a.emit(0x85, 0xC0); a.jcc(0x84, "show_message_done");
	a.call("show_message_text");
	a.label("show_message_done");
	a.emit(0x8B, 0xE5, 0x5D, 0xC2, 0x04, 0x00);

	// void __stdcall show_wrong_message(uint32 remaining)
	a.label("show_wrong_message");
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x18, 0x56);
	pushDword(0x0764);
	a.call(c.GetMessageVir);
	a.emit(0x83, 0xC4, 0x04);
	a.emit(0xFF, 0x75, 0x08);                  // PUSH remaining
	a.emit(0x50);                              // PUSH format
	a.emit(0x8D, 0x75, 0xE8, 0x56);            // LEA ESI,[EBP-18] / PUSH ESI
	a.call(c.FormatStringVir);
	a.emit(0x83, 0xC4, 0x0C);
	a.emit(0x83, 0x78, 0x14, 0x10);            // CMP [EAX+14],16
	a.jcc(0x82, "wrong_text_ready");           // JB
	a.emit(0x8B, 0x00);                        // MOV EAX,[EAX]
	a.label("wrong_text_ready");
	a.call("show_message_text");
	a.emit(0x8B, 0xCE);                        // MOV ECX,ESI
	a.call(c.DestroyStringVir);
	a.emit(0x5E, 0x8B, 0xE5, 0x5D, 0xC2, 0x04, 0x00);

	// void __fastcall show_message_text(const char* text in EAX)
	a.label("show_message_text");
	a.emit(0x6A, 0x00, 0x6A, 0x78);
	pushDword(0x0118);
	pushDword(c.MessageStyleVir);
	a.emit(0x6A, 0x00, 0x6A, 0x00, 0x6A, 0x01, 0x6A, 0x00, 0x50);
	a.emit(0xB9); a.dword(c.UiManagerVir);
	a.call(c.ShowMessageVir);
	a.emit(0xC3);

	return a.finish(stubVir);
};

InGamePincodeUI.expectDword = function(vir, expected, label)
{
	const phy = Exe.Vir2Phy(vir);
	if (phy < 0)
		throw Error(`InGamePincodeUI: ${label} is outside file-backed code`);
	const actual = Exe.GetUint32(phy);
	if (actual !== expected)
		throw Error(`InGamePincodeUI: ${label} mismatch at ${vir.toHex(true)}: ${actual.toHex(true)} != ${expected.toHex(true)}`);
};

InGamePincodeUI.validateClient = function(c)
{
	// The old research address D21210 is an 0x0828 handler on this build.
	// D221E0 is the real stock 0x08B9 state handler and identifies this layout.
	InGamePincodeUI.expectDword(0x00D221E0, 0x6AEC8B55, "stock 0x08B9 handler");
	InGamePincodeUI.expectDword(0x00D25333, 0x5FFA80A1, "character-select PIN mode dispatch");
	InGamePincodeUI.expectDword(0x01035498, 0x008C91D0, "UISecondPasswordInputWnd event vtable");
	InGamePincodeUI.expectDword(c.GetResourceManagerVir, 0x6AEC8B55, "resource manager accessor");
	InGamePincodeUI.expectDword(c.LookupResourceVir, 0x6AEC8B55, "UI resource lookup");
	InGamePincodeUI.expectDword(c.ResolveResourceVir, 0x6AEC8B55, "UI resource resolver");
	InGamePincodeUI.expectDword(c.LoadUiResourceVir, 0x56EC8B55, "UI resource loader");
	InGamePincodeUI.expectDword(c.CreateWindowVir, 0x6AEC8B55, "UI window factory");
	InGamePincodeUI.expectDword(c.MainLoopReturnVir, 0xEECC3D83, "map receive loop continuation");
};

InGamePincodeUI.bytesToHex = function(bytes)
{
	return bytes.map(byte => (byte & 0xFF).toHex(1)).join(" ");
};

InGamePincodeUI.tableEntryVir = function(switchTableVir, packetId)
{
	return switchTableVir + (packetId - 0x73) * 4;
};

InGamePincodeUI.validate = function()
{
	return Exe.BuildDate === 20250716;
};
