0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03 00 12 A2 00 01 02 00 12 A2 00 02 06 00 12 97 00 03 07 04 13 71 FF 07 16 04 12 FE FF 07 FA 04 12 FE FF 08 09 04 12 02 00 08 14 04 12 FE FF 09 FB 04 12 FE FF 0A FE 00 12 A0 00 0B FA 00 12 A0 00 0C 00 04 12 B2 00 0D 01 04 12 B2 00 0F E1 04 13 32 00 0F F2 00 13 93 FF 10 DF 04 13 CE FF 10 E3 04 13 32 00 11 1D 00 12 6C FF 12 DE 04 13 CE FF 12 F4 00 13 93 FF 16 DC 04 13 CE FF 17 2B 00 03 50 00 18 2A 00 03 50 00 18 2B 00 03 50 00 18 DC 04 13 CE FF 18 FC 00 13 93 FF 19 2A 00 03 50 00 19 F7 00 13 96 FF 19 F8 00 13 96 FF 19 FB 00 13 93 FF 1A 29 00 03 50 00 1A 2A 00 03 50 00 1C 2D 00 12 6C FF 21 28 00 03 A6 FF 21 2B 00 03 A6 FF 22 2A 00 03 A6 FF 22 2B 00 03 A6 FF 23 29 00 03 A6 FF 24 08 00 12 6C FF 27 F6 00 13 9F FF 28 F6 00 13 9F FF 2A 19 04 12 FE FF 2D 17 00 13 9F FF 2D 18 00 13 9F FF 35 06 00 13 9F FF 36 07 00 13 9F FF 49 27 00 1B 00 00 49 D5 00 1B 00 00 4B 2A 00 1B 00 00 50 D6 00 1B 00 00 AF D6 00 1B 00 00 B5 2A 00 1B 00 00 B6 D5 00 1B 00 00 B7 27 00 1B 00 00 C7 28 00 03 BA FF C7 2A 00 03 BA FF C8 08 00 13 61 00 C8 26 00 03 BA FF C8 27 00 03 BA FF CB 07 00 13 61 00 CD 26 00 03 BA FF D4 17 00 13 61 00 D4 2B 00 03 5A 00 D5 2B 00 03 5A 00 D6 17 00 13 61 00 D6 19 04 12 02 00 D6 2A 00 03 5A 00 D6 2B 00 03 5A 00 D7 29 00 03 5A 00 D7 2A 00 03 5A 00 D7 2B 00 03 5A 00 D8 2A 00 03 5A 00 D8 2B 00 03 5A 00 D9 F7 00 13 61 00 DB 08 00 12 97 00 DB F6 00 13 61 00 E2 2D 00 12 97 00 E3 F8 00 13 6A 00 E6 FC 00 13 6D 00 E7 FC 00 13 6D 00 E9 F9 00 13 6A 00 EA DD 04 13 32 00 EB DF 04 13 32 00 EC 1D 00 12 97 00 ED F3 00 13 6D 00 EE F7 00 02 00 00 EF 03 00 02 00 00 EF F4 00 13 6D 00 F1 00 04 12 4E FF F1 01 04 12 4E FF F1 E1 04 13 32 00 F1 E1 04 13 CE FF F1 F3 00 12 A0 00 F1 F7 00 12 A0 00 F2 E2 04 13 CE FF F4 EF 04 13 25 00 F4 F8 00 12 A0 00 F5 00 04 13 8F 00 F7 FB 04 12 02 00 F9 09 04 12 FE FF F9 FA 04 12 02 00 FA 16 04 12 02 00 FB 14 04 12 02 00 FC 06 00 12 6C FF FD 07 04 13 8F 00 FE 02 00 12 62 FF FE 06 04 13 8F 00 FF 03 00 12 62 FF";

DualWeaponStatic.writeHexChunked = function(phy, hex)
{
	const bytes = hex.split(" ");
	for (let offset = 0; offset < bytes.length; offset += 0x1000)
		Exe.SetHex(phy + offset, bytes.slice(offset, offset + 0x1000).join(" "));
};

DualWeaponStatic.writeZeroesChunked = function(phy, size)
{
	const full = "00 ".repeat(0x1000).trim();
	for (let offset = 0; offset < size; offset += 0x1000)
	{
		const count = Math.min(0x1000, size - offset);
		Exe.SetHex(
			phy + offset,
			count === 0x1000 ? full : "00 ".repeat(count).trim()
		);
	}
};

DualWeaponStatic.OwnedAllocations = [];
DualWeaponStatic.allocateChecked = function(size, alignment)
{
	const allocation = RagexeAllocationStatic.allocate(size, alignment);
	if (!allocation)
		throw Error("DualWeaponStatic: allocation result is invalid");
	const phy = allocation[0];
	const vir = allocation[1];
	if (!Number.isInteger(phy) || !Number.isInteger(vir) || phy < 0x400 ||
		vir < 0x00400000 || phy > 0x0FFFFFFF || vir > 0x0FFFFFFF)
		throw Error(
			"DualWeaponStatic: allocation vir=" + vir +
			" phy=" + phy + " size=" + size + " is outside safe bounds"
		);
	for (const owned of DualWeaponStatic.OwnedAllocations)
	{
		if (phy < owned[1] && phy + size > owned[0])
			throw Error("DualWeaponStatic: allocation overlaps an owned range");
	}
	DualWeaponStatic.OwnedAllocations.push([phy, phy + size]);
	return allocation;
};


// Exe.Allocate alignment can align the file offset while leaving the VA
// unaligned (the crashing build returned state VA 0x01E5F400). Reserve enough
// padding to align the VA ourselves; retain ownership of the entire reservation
// so no later code allocation can share a page changed to PAGE_READWRITE.
DualWeaponStatic.allocateStatePages = function(size)
{
	if (!Number.isInteger(size) || size <= 0 || (size & 0xFFF) !== 0)
		throw Error("DualWeaponStatic: state size must be a positive page multiple");
	const [phy, vir] = DualWeaponStatic.allocateChecked(size + 0xFFF, 0x10);
	const padding = (0x1000 - (vir & 0xFFF)) & 0xFFF;
	return [phy + padding, vir + padding];
};

// Versioned payload produced by tools/build_dual_weapon_compositor.py.
// BinFile is read-only. All relocations are checked before any hook is installed.
DualWeaponStatic.readCompositor = function()
{
	const file = new BinFile(Warp.Path + "/Inputs/DualWeaponRuntime/compositor.dwcp", "r");
	if (!file.Valid) throw Error("DualWeaponStatic: compositor.dwcp is missing; update the complete repository");
	const data = (file.ReadHex().match(/[0-9A-Fa-f]{2}/g) || []).map(x => parseInt(x, 16));
	file.Close();
	const u32 = function(o) {
		return (data[o] | data[o+1]<<8 | data[o+2]<<16 | data[o+3]<<24) >>> 0;
	};
	if (data.length < 32 || u32(0) !== 0x50435744 || u32(4) !== 1)
		throw Error("DualWeaponStatic: invalid compositor header");
	const codeBytes=u32(8), entry=u32(12), count=u32(16), rigBytes=u32(20), gripBytes=u32(24);
	const begin=32+count*4, rig=begin+codeBytes, grip=rig+rigBytes;
	if (codeBytes > 0x100000 || count > 4096 || entry >= codeBytes || grip+gripBytes !== data.length)
		throw Error("DualWeaponStatic: invalid compositor dimensions");
	let crc=0xFFFFFFFF;
	for (let i=32; i<data.length; ++i) {
		crc ^= data[i];
		for (let bit=0; bit<8; ++bit) crc=(crc>>>1)^((crc&1)?0xEDB88320:0);
	}
	if (((crc^0xFFFFFFFF)>>>0) !== u32(28))
		throw Error("DualWeaponStatic: compositor CRC mismatch");
	const relocs=[];
	for (let i=0; i<count; ++i) {
		const offset=u32(32+i*4);
		if (offset+4>codeBytes || u32(begin+offset)>=codeBytes)
			throw Error("DualWeaponStatic: invalid compositor relocation");
		relocs.push([offset,u32(begin+offset)]);
	}
	return {data:data.slice(begin), codeBytes, entry, relocs, rigOffset:codeBytes, gripOffset:codeBytes+rigBytes};
};

AllowDualCustomWeaponSprites = function(_)
{
	const profile = DualWeaponStatic.selectProfile();
	if (!profile.SupportsPose)
		throw Error("DualWeaponStatic: " + profile.Name + " has no dual-weapon compositor");
	const compositor = DualWeaponStatic.readCompositor();
	if (typeof RagexeAllocationStatic !== "undefined")
		RagexeAllocationStatic.prepare();
	const equipPhy = DualWeaponStatic.assertBytes(
		"equipment entry", profile.EquipUpdate, profile.EquipStolen
	);
	const imageHookVir = 0x00605D41;
	const imageHookPhy = DualWeaponStatic.assertBytes(
		"final image metadata selection", imageHookVir,
		"89 45 94 8B 45 0C 89 45 C8"
	);
	const finalDrawVir = 0x00C4A0D0;
	const finalDrawPhy = DualWeaponStatic.assertBytes(
		"final native sprite draw", finalDrawVir,
		"55 8B EC 83 EC 50"
	);
	const vertexDepthHookVir = 0x00C4A647;
	const vertexDepthHookPhy = DualWeaponStatic.assertBytes(
		"completed sprite quad depth boundary", vertexDepthHookVir,
		"A1 F8 15 25 01"
	);
	DualWeaponStatic.assertBytes(
		"item-to-weapon-view entry", profile.ItemToWeaponView,
		profile.ItemToWeaponViewBytes
	);
	DualWeaponStatic.assertBytes(
		"pair mapper entry", profile.PairMapper, profile.PairMapperBytes
	);
	DualWeaponStatic.assertBytes(
		"view-to-weapon-class entry", profile.ViewToWeaponClass, profile.ViewToWeaponClassBytes
	);
	DualWeaponStatic.assertBytes(
		"item weapon-name suffix entry", profile.ItemWeaponSuffix, profile.ItemWeaponSuffixBytes
	);

	DualWeaponStatic.assertBytes("ACT action vector", 0x0070F2E3, "8B B1 10 01 00 00");
	DualWeaponStatic.assertBytes("ACT layer vector", 0x0070F394, "8B 71 20");
	DualWeaponStatic.assertBytes("SPR image kind/index", 0x00605D1D, "8B 46 20 8B 4E 08 83 C0 6C");
	DualWeaponStatic.assertBytes("native weapon palette", 0x006060E7, "8D 81 10 01 00 00");

	const [equipTrampolinePhy, equipTrampolineVir] =
		DualWeaponStatic.allocateChecked(10, 0x10);
	const equipTrampoline = DualWeaponStatic.asm();
	equipTrampoline.emit(0x55, 0x8B, 0xEC, 0x6A, 0xFF);
	equipTrampoline.jmp(profile.EquipUpdate + 5);
	Exe.SetHex(equipTrampolinePhy, equipTrampoline.finish(equipTrampolineVir));

	const [drawTrampolinePhy, drawTrampolineVir] =
		DualWeaponStatic.allocateChecked(11, 0x10);
	const drawTrampoline = DualWeaponStatic.asm();
	drawTrampoline.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x50);
	drawTrampoline.jmp(finalDrawVir + 6);
	Exe.SetHex(drawTrampolinePhy, drawTrampoline.finish(drawTrampolineVir));

	const virtualProtectIat = Exe.FindFunc("VirtualProtect", "kernel32.dll");
	if (virtualProtectIat < 0)
		throw Error("DualWeaponStatic: VirtualProtect IAT missing");
	const stateSize = 0x5000;
	const [statePhy, stateVir] =
		DualWeaponStatic.allocateStatePages(stateSize);
	DualWeaponStatic.writeZeroesChunked(statePhy, stateSize);
	const captureVir = stateVir + 0x10;
	const attackCaptureSize = 0x1000;
	const [attackCapturePhy, attackCaptureVir] =
		DualWeaponStatic.allocateChecked(attackCaptureSize, 0x1000);
	DualWeaponStatic.writeZeroesChunked(attackCapturePhy, attackCaptureSize);
	const registryVir = stateVir + 0x1000;
	const equipCode = DualWeaponStatic.buildEquipHook(
		equipTrampolineVir, stateVir, stateVir, stateSize,
		virtualProtectIat, registryVir, stateVir + 0x400
	);
	const [equipCodePhy, equipCodeVir] =
		DualWeaponStatic.allocateChecked(equipCode.bytes.length, 0x10);
	Exe.SetHex(equipCodePhy, equipCode.finish(equipCodeVir));

	const coreBytes = DualWeaponAuthoredCoreHex.split(" ").length;
	const [corePhy, coreVir] =
		DualWeaponStatic.allocateChecked(coreBytes, 0x10);
	const coreData = DualWeaponAuthoredCoreHex.split(" ");
	for (const relocation of DualWeaponAuthoredCoreRelocs)
	{
		const value = (coreVir + relocation[1]) >>> 0;
		for (let shift = 0; shift < 32; shift += 8)
			coreData[relocation[0] + (shift >>> 3)] =
				((value >>> shift) & 0xFF).toString(16).padStart(2, "0");
	}
	DualWeaponStatic.writeHexChunked(corePhy, coreData.join(" "));
	const rigBytes = DualWeaponAuthoredRigHex.split(" ").length;
	const [rigPhy, rigVir] =
		DualWeaponStatic.allocateChecked(rigBytes, 0x10);
	DualWeaponStatic.writeHexChunked(rigPhy, DualWeaponAuthoredRigHex);

	const debugMessages = [
		"BOH_DWR ENTER",
		"BOH_DWR CAPTURE_OK",
		"BOH_DWR ROW_OK",
		"BOH_DWR FAMILY_OK",
		"BOH_DWR POSE_OK",
		"BOH_DWR MAIN_TRANSFORM_OK",
		"BOH_DWR OFF_TRANSFORM_OK",
		"BOH_DWR MAIN_PREPARE_OK",
		"BOH_DWR OFF_PREPARE_OK",
		"BOH_DWR DUAL_HANDLED",
		"BOH_DWR FAIL_CAPTURE",
		"BOH_DWR FAIL_ROW",
		"BOH_DWR FAIL_FAMILY",
		"BOH_DWR FAIL_POSE_OR_PAIR",
		"BOH_DWR FAIL_TRANSFORM",
		"BOH_DWR FAIL_MAIN_PREPARE",
		"BOH_DWR FAIL_OFF_PREPARE",
		"BOH_DWR OFF_ONLY_HANDLED",
		"BOH_DWR FAIL_OFF_ONLY_PREPARE",
		"BOH_DWR EQUIP_WRAPPER",
		"BOH_DWR IMAGE_WRAPPER",
		"BOH_DWR DRAW_WRAPPER"
	];
	const debugText = [];
	const debugOffsets = [];
	for (const message of debugMessages)
	{
		debugOffsets.push(debugText.length);
		for (let index = 0; index < message.length; ++index)
			debugText.push(message.charCodeAt(index));
		debugText.push(0);
	}
	const [debugTextPhy, debugTextVir] =
		DualWeaponStatic.allocateChecked(debugText.length, 0x10);
	Exe.SetHex(debugTextPhy, debugText.map(value =>
		value.toString(16).padStart(2, "0")).join(" "));
	const debugPointers = [];
	for (const offset of debugOffsets)
	{
		const value = debugTextVir + offset;
		for (let shift = 0; shift < 32; shift += 8)
			debugPointers.push((value >>> shift) & 0xFF);
	}
	const [debugPointersPhy, debugPointersVir] =
		DualWeaponStatic.allocateChecked(debugPointers.length, 0x10);
	Exe.SetHex(debugPointersPhy, debugPointers.map(value =>
		value.toString(16).padStart(2, "0")).join(" "));
	const debugIat = Exe.FindFunc("OutputDebugStringA", "kernel32.dll");
	if (debugIat < 0)
		throw Error("DualWeaponStatic: OutputDebugStringA IAT missing");
	const [debugThunkPhy, debugThunkVir] =
		DualWeaponStatic.allocateChecked(6, 0x10);
	const debugThunk = [0xFF, 0x25];
	for (let shift = 0; shift < 32; shift += 8)
		debugThunk.push((debugIat >>> shift) & 0xFF);
	Exe.SetHex(debugThunkPhy, debugThunk.map(value =>
		value.toString(16).padStart(2, "0")).join(" "));
	const keyIat = Exe.FindFunc("GetAsyncKeyState", "user32.dll");
	if (keyIat < 0)
		throw Error("DualWeaponStatic: GetAsyncKeyState IAT missing");
	const [keyThunkPhy, keyThunkVir] =
		DualWeaponStatic.allocateChecked(6, 0x10);
	const keyThunk = [0xFF, 0x25];
	for (let shift = 0; shift < 32; shift += 8)
		keyThunk.push((keyIat >>> shift) & 0xFF);
	Exe.SetHex(keyThunkPhy, keyThunk.map(value =>
		value.toString(16).padStart(2, "0")).join(" "));
	const debugFlagsVir = stateVir + 0x100;
	const calibrationKeysVir = stateVir + 0x180;
	const calibrationVir = stateVir + 0x200;

	const [resourceCorePhy, resourceCoreVir] = DualWeaponStatic.allocateChecked(compositor.data.length, 0x10);
	for (const [offset, target] of compositor.relocs) {
		const value=(resourceCoreVir+target)>>>0;
		for (let shift=0; shift<32; shift+=8) compositor.data[offset+(shift>>>3)]=(value>>>shift)&255;
	}
	DualWeaponStatic.writeHexChunked(resourceCorePhy, compositor.data.map(x => x.toString(16).padStart(2,"0")).join(" "));
	const contextValues = [
		registryVir, captureVir, rigVir, profile.ActGetFrame, profile.LayerGet,
		0x38, 0x3C, 256,
		debugThunkVir, debugPointersVir, debugFlagsVir,
		profile.ActorMainItem, profile.ActorOffItem,
		keyThunkVir, calibrationVir, calibrationKeysVir,
		attackCaptureVir,
		resourceCoreVir + compositor.rigOffset, stateVir + 0x400,
		coreVir + DualWeaponAuthoredCoreEntry, resourceCoreVir + compositor.gripOffset
	];
	const contextBytes = [];
	for (const value of contextValues)
	{
		for (let shift = 0; shift < 32; shift += 8)
			contextBytes.push((value >>> shift) & 0xFF);
	}
	const [contextPhy, contextVir] =
		DualWeaponStatic.allocateChecked(contextBytes.length, 0x10);
	Exe.SetHex(contextPhy, contextBytes.map(value =>
		value.toString(16).padStart(2, "0")).join(" "));

	const equipEntryCode = DualWeaponStatic.buildEquipEntryDiagnostic(
		equipCodeVir, debugThunkVir, debugTextVir + debugOffsets[19]
	);
	const [equipEntryPhy, equipEntryVir] =
		DualWeaponStatic.allocateChecked(equipEntryCode.bytes.length, 0x10);
	Exe.SetHex(equipEntryPhy, equipEntryCode.finish(equipEntryVir));

	const imageCode = DualWeaponStatic.buildImageCapture(
		captureVir, attackCaptureVir, stateVir,
		debugThunkVir, debugTextVir + debugOffsets[20]
	);
	const [imageCodePhy, imageCodeVir] =
		DualWeaponStatic.allocateChecked(imageCode.bytes.length, 0x10);
	Exe.SetHex(imageCodePhy, imageCode.finish(imageCodeVir));
	const helperBytes = DualWeaponCharacterEnvelopeCoreHex.split(" ").length;
	const [helperPhy, helperVir] =
		DualWeaponStatic.allocateChecked(helperBytes, 0x10);
	const helperData = DualWeaponCharacterEnvelopeCoreHex.split(" ");
	for (const relocation of DualWeaponCharacterEnvelopeCoreRelocs)
	{
		const value = (helperVir + relocation[1]) >>> 0;
		for (let shift = 0; shift < 32; shift += 8)
			helperData[relocation[0] + (shift >>> 3)] =
				((value >>> shift) & 0xFF).toString(16).padStart(2, "0");
	}
	DualWeaponStatic.writeHexChunked(helperPhy, helperData.join(" "));

	const characterDepthCacheSize = 0x88 * 256;
	const [characterDepthCachePhy, characterDepthCacheVir] =
		DualWeaponStatic.allocateChecked(characterDepthCacheSize, 0x10);
	DualWeaponStatic.writeZeroesChunked(characterDepthCachePhy, characterDepthCacheSize);
	const depthMessages = [
		"BOH_DWZ CHARACTER_PLANES_OK",
		"BOH_DWZ CUSTOM_ENVELOPE_Z_OK",
		"BOH_DWZ FAIL_CLOSED"
	];
	const depthText = [];
	const depthOffsets = [];
	for (const message of depthMessages)
	{
		depthOffsets.push(depthText.length);
		for (let index = 0; index < message.length; ++index)
			depthText.push(message.charCodeAt(index));
		depthText.push(0);
	}
	const [depthTextPhy, depthTextVir] =
		DualWeaponStatic.allocateChecked(depthText.length, 0x10);
	Exe.SetHex(depthTextPhy, depthText.map(value =>
		value.toString(16).padStart(2, "0")).join(" "));
	const scopeValues = [
		0, 0, 0, 0, characterDepthCacheVir, 0x39D31F68, 0x38D1B717,
		0x38D1B717, debugThunkVir,
		depthTextVir + depthOffsets[0],
		depthTextVir + depthOffsets[1],
		depthTextVir + depthOffsets[2], 0
	];
	const scopeBytes = [];
	for (const value of scopeValues)
	{
		for (let shift = 0; shift < 32; shift += 8)
			scopeBytes.push((value >>> shift) & 0xFF);
	}
	const [scopePhy, scopeVir] =
		DualWeaponStatic.allocateChecked(scopeBytes.length, 0x10);
	Exe.SetHex(scopePhy, scopeBytes.map(value =>
		value.toString(16).padStart(2, "0")).join(" "));
	const scopedThunk = DualWeaponStatic.buildScopedDepthDrawThunk(
		drawTrampolineVir, scopeVir
	);
	const [scopedThunkPhy, scopedThunkVir] =
		DualWeaponStatic.allocateChecked(scopedThunk.bytes.length, 0x10);
	Exe.SetHex(scopedThunkPhy, scopedThunk.finish(scopedThunkVir));
	const depthBridge = DualWeaponStatic.buildVertexDepthBridge(
		helperVir + DualWeaponCharacterEnvelopeCoreEntry, scopeVir,
		vertexDepthHookVir + 5
	);
	const [depthBridgePhy, depthBridgeVir] =
		DualWeaponStatic.allocateChecked(depthBridge.bytes.length, 0x10);
	Exe.SetHex(depthBridgePhy, depthBridge.finish(depthBridgeVir));

	const drawCode = DualWeaponStatic.buildFinalDrawWrapper(
		resourceCoreVir + compositor.entry, contextVir, drawTrampolineVir,
		scopedThunkVir, captureVir, scopeVir
	);
	const [drawCodePhy, drawCodeVir] =
		DualWeaponStatic.allocateChecked(drawCode.bytes.length, 0x10);
	Exe.SetHex(drawCodePhy, drawCode.finish(drawCodeVir));

	Exe.SetCALL(imageHookPhy, imageCodeVir, 0);
	Exe.SetHex(imageHookPhy + 5, "89 45 94 90");
	Exe.SetJMP(finalDrawPhy, drawCodeVir, 1);
	Exe.SetJMP(vertexDepthHookPhy, depthBridgeVir, 0);
	Exe.SetJMP(equipPhy, equipEntryVir, 0);
	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
	{
		PatchDiagnostics.add("AllowDualCustomWeaponSprites.AuthoredRig", {
			build: profile.Name,
			mode: "authored-physical-hand-rig",
			minimumState: "authored",
			stockSlotsPreserved: true,
			textureCreation: false,
			dllDependency: false,
			diagnostic: true,
			depthMode: "character-front-envelope-per-final-vertex",
			depthHookVir: vertexDepthHookVir,
			depthScopeVir: scopeVir,
			depthCacheVir: characterDepthCacheVir,
			rigBytes,
			resourceCoreVir,
			resourceCoreEntry: resourceCoreVir + compositor.entry,
			offHandOnly: true
		});
	}
	return true;
};

AllowDualCustomWeaponSprites.validate = function()
{
	try
	{
		const profile = DualWeaponStatic.selectProfile();
		return profile.SupportsPose &&
			(typeof RagexeAllocationStatic !== "undefined" &&
			RagexeAllocationStatic.isPrepared());
	}
	catch (error)
	{
		return false;
	}
};
