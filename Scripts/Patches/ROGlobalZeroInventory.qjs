const InventoryTabsStatic = {
	BuildDate: 20250716,
	WindowVtable: 0x0103D460,
	WindowVtableEntry: 0x0103D4B0,
	WindowDrawOriginal: 0x00946DA0,
	WindowMouseVtableEntry: 0x0103D4D0,
	WindowMouseOriginal: 0x0094D450,
	WindowId: 8,
	WindowManager: 0x0131F4E8,
	GetWindow: 0x00A47B90,
	CloseWindow: 0x00A2E770,
	CreateWindow: 0x00A39340,
	TabDrawVtableEntry: 0x0102DD94,
	TabDrawOriginal: 0x00857910,
	TabMouseVtableEntry: 0x0102DDB4,
	TabMouseOriginal: 0x0085A170,
	ZenyInsert: 0x00947477,
	ZenyInsertBytes: "B9 C0 A3 5F 01",
	ItemEndCountSites: [0x00947205, 0x00947448],
	ItemEndCountBytes: "0F AF 83 E0 00 00 00",
	GetTexMgr: 0x00A90350,
	ConvPath: 0x00A9F030,
	LoadSurface: 0x00A8D4A0,
	ImageDraw: 0x00A1D260,
	FillRect: 0x00A1D460,
	TextWidth: 0x00A21C90,
	TextDraw: 0x00A25A70,
	NumberFormat: 0x00A94870,
	NumberFormatBytes: "55 8B EC 83 EC 24 A1 24 B9 22 01",
	ClearSurface: 0x00A1CB30,
	Sprintf: 0x00529850,
	StringAssign: 0x004F1940,
	HitTest: 0x00848E60,
	ClientToScreen: 0x00A1EF70,
	ShowTooltip: 0x00A753D0,
	TooltipManagerPtr: 0x0121333C,
	TabItmFormat: 0x0102AC48,
	WeightIconPath: 0x0103DB00,
	CurrentZeny: 0x015FBA90,
	CurrentWeight: 0x015FBAA0,
	MaximumWeight: 0x015FBA9C,
	WeightWarningPercent: 0x01602324,
	WeightTooltipFormat: 0x0103E5E4,
	PersonalLockState: 0x01600553,
	PersonalTabIndex: 3,
	ControlParentOffset: 0x10,
	TabControlOffset: 0x118,
	SelectedTabOffset: 0x7C,
	TooltipX: 21,
	ZenyRightMargin: 8,
	ZenyBottomMargin: 28,
	ZenyBitmapWidth: 122,
	ZenyWidth: 184,
	ZenyHeight: 36,
	PanelCornerInset: 4,
	PanelBackgroundColor: 0x00EFE7E7,
	PanelTextColor: 0x00232323,
	WeightWarningColor: 0x000000FF,
	ReservedRowColor: 0x00FFFFFF,
	// FillRect consumes COLORREF byte order; this renders as RGB #DEE7FF.
	LockedReservedRowColor: 0x00FFE7DE
};

InventoryTabsStatic.hexNorm = function(hex)
{
	return (hex || "").replace(/\s+/g, " ").trim().toUpperCase();
};

InventoryTabsStatic.bytesToHex = function(bytes)
{
	return bytes.map(value => (value & 0xFF).toString(16).padStart(2, "0")).join(" ");
};

InventoryTabsStatic.asciiBytes = function(text, nulTerminate = true)
{
	const bytes = [];
	for (let i = 0; i < text.length; i++)
		bytes.push(text.charCodeAt(i) & 0xFF);
	if (nulTerminate)
		bytes.push(0);
	return bytes;
};

InventoryTabsStatic.findBytes = function(bytes, needle)
{
	for (let i = 0; i <= bytes.length - needle.length; i++)
	{
		let match = true;
		for (let j = 0; j < needle.length; j++)
		{
			if (bytes[i + j] !== needle[j])
			{
				match = false;
				break;
			}
		}
		if (match)
			return i;
	}
	return -1;
};

InventoryTabsStatic.readCString = function(virAddr, maxLength)
{
	const phyAddr = Exe.Vir2Phy(virAddr);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroInventory: string 0x${virAddr.toString(16)} is not mapped`);

	const bytes = [];
	for (let i = 0; i < maxLength; i++)
	{
		const value = Exe.GetUint8(phyAddr + i);
		bytes.push(value);
		if (value === 0)
			return bytes;
	}
	throw Error(`ROGlobalZeroInventory: unterminated string at 0x${virAddr.toString(16)}`);
};

InventoryTabsStatic.allocateBytes = function(bytes, alignment = 1)
{
	const [phyAddr, virAddr] = Exe.Allocate(bytes.length, alignment);
	Exe.SetHex(phyAddr, InventoryTabsStatic.bytesToHex(bytes));
	return [phyAddr, virAddr];
};

InventoryTabsStatic.buildResourcePaths = function()
{
	const source = InventoryTabsStatic.readCString(InventoryTabsStatic.TabItmFormat, 192);
	const tabNeedle = InventoryTabsStatic.asciiBytes("tab_itm", false);
	const tabPos = InventoryTabsStatic.findBytes(source, tabNeedle);
	if (tabPos < 0)
		throw Error("ROGlobalZeroInventory: tab_itm format marker not found");

	const tabFormat = source.slice();
	const replacement = InventoryTabsStatic.asciiBytes("tab_pri", false);
	for (let i = 0; i < replacement.length; i++)
		tabFormat[tabPos + i] = replacement[i];

	const basicNeedle = InventoryTabsStatic.asciiBytes("basic_interface\\", false);
	const basicPos = InventoryTabsStatic.findBytes(source, basicNeedle);
	if (basicPos < 0)
		throw Error("ROGlobalZeroInventory: texture directory prefix not found");

	const zenyPath = source.slice(0, basicPos).concat(
		InventoryTabsStatic.asciiBytes("uirenewal\\itemui\\bg_zeny.bmp")
	);

	return {
		tabFormatVir: InventoryTabsStatic.allocateBytes(tabFormat)[1],
		zenyPathVir: InventoryTabsStatic.allocateBytes(zenyPath)[1],
		weightPathVir: InventoryTabsStatic.WeightIconPath
	};
};

// Minimal label-aware x86 emitter. Relative targets are resolved after the
// final virtual address of each cave is known.
InventoryTabsStatic.asm = function()
{
	const bytes = [];
	const labels = {};
	const fixups = [];

	const put32 = function(out, pos, value)
	{
		const v = value >>> 0;
		out[pos] = v & 0xFF;
		out[pos + 1] = (v >>> 8) & 0xFF;
		out[pos + 2] = (v >>> 16) & 0xFF;
		out[pos + 3] = (v >>> 24) & 0xFF;
	};

	return {
		bytes,
		emit: function(...values)
		{
			for (const value of values)
				bytes.push(value & 0xFF);
		},
		dword: function(value)
		{
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			put32(bytes, pos, value);
		},
		label: function(name)
		{
			if (Object.prototype.hasOwnProperty.call(labels, name))
				throw Error(`ROGlobalZeroInventory: duplicate label ${name}`);
			labels[name] = bytes.length;
		},
		rel32: function(opcode, target)
		{
			bytes.push(opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		call: function(target) { this.rel32(0xE8, target); },
		jmp: function(target) { this.rel32(0xE9, target); },
		jcc: function(opcode, target)
		{
			bytes.push(0x0F, opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		finish: function(baseVir)
		{
			const out = bytes.slice();
			for (const fixup of fixups)
			{
				if (typeof fixup.target === "string" &&
					!Object.prototype.hasOwnProperty.call(labels, fixup.target))
					throw Error(`ROGlobalZeroInventory: unresolved label ${fixup.target}`);
				const targetVir = typeof fixup.target === "string"
					? baseVir + labels[fixup.target]
					: fixup.target;
				const nextVir = baseVir + fixup.pos + 4;
				put32(out, fixup.pos, targetVir - nextVir);
			}
			return InventoryTabsStatic.bytesToHex(out);
		}
	};
};

InventoryTabsStatic.buildWindowDraw = function(stateVir, loadThemeVir)
{
	const a = InventoryTabsStatic.asm();
	a.emit(0x56);                              // PUSH ESI
	a.emit(0x8B, 0xF1);                        // MOV ESI,ECX
	a.call(loadThemeVir);
	a.emit(0x89, 0x35); a.dword(stateVir);      // MOV [inventoryWindow],ESI
	a.emit(0x8B, 0x86); a.dword(InventoryTabsStatic.TabControlOffset);
	a.emit(0xA3); a.dword(stateVir + 4);        // MOV [inventoryTab],EAX
	a.emit(0x8B, 0xCE);                        // MOV ECX,ESI
	a.call(InventoryTabsStatic.WindowDrawOriginal);
	a.emit(0x5E, 0xC3);                        // POP ESI / RET
	return a;
};

InventoryTabsStatic.buildTabDraw = function(
	stateVir, tabFormatVir, blankVir, themeStateVir
)
{
	const a = InventoryTabsStatic.asm();

	a.emit(0x55, 0x8B, 0xEC);                 // PUSH EBP / MOV EBP,ESP
	a.emit(0x81, 0xEC); a.dword(0xB0);         // SUB ESP,B0
	a.emit(0x53, 0x56, 0x57);                 // PUSH EBX/ESI/EDI
	a.emit(0x8B, 0xF1);                       // MOV ESI,ECX
	a.call(InventoryTabsStatic.TabDrawOriginal);
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "done");
	a.emit(0x3B, 0x35); a.dword(stateVir + 4); // CMP ESI,[inventoryTab]
	a.jcc(0x85, "done");                     // JNE done
	// A closed inventory leaves cached heap addresses behind. Reject a tab
	// control whose address was recycled by Equipment or another window.
	a.emit(0x8B, 0x46, InventoryTabsStatic.ControlParentOffset); // MOV EAX,[ESI+parent]
	a.emit(0x3B, 0x05); a.dword(stateVir);      // CMP EAX,[inventoryWindow]
	a.jcc(0x85, "done");                     // JNE done
	a.emit(0x85, 0xC0);                       // TEST EAX,EAX
	a.jcc(0x84, "done");                     // JE done
	a.emit(0x81, 0x38); a.dword(InventoryTabsStatic.WindowVtable); // CMP [EAX],inventory vtable
	a.jcc(0x85, "done");                     // JNE done
	a.emit(0x3B, 0xB0); a.dword(InventoryTabsStatic.TabControlOffset); // CMP ESI,[EAX+tab]
	a.jcc(0x85, "done");                     // JNE done

	// Blank all four drawn labels after validating the vector has four entries.
	a.emit(0x8B, 0xBE); a.dword(0xB4);         // MOV EDI,[ESI+B4]
	a.emit(0x8B, 0x86); a.dword(0xB8);         // MOV EAX,[ESI+B8]
	a.emit(0x2B, 0xC7);                       // SUB EAX,EDI
	a.emit(0x83, 0xF8, 0x60);                 // CMP EAX,60
	a.jcc(0x82, "heights");                 // JB heights
	for (let i = 0; i < 4; i++)
	{
		a.emit(0x8B, 0xCF);                   // MOV ECX,EDI
		a.emit(0x6A, 0x01);                   // PUSH 1
		a.emit(0x68); a.dword(blankVir);       // PUSH " "
		a.call(InventoryTabsStatic.StringAssign);
		a.emit(0x83, 0xC7, 0x18);             // ADD EDI,18
	}

	a.label("heights");
	a.emit(0x8B, 0x86); a.dword(0xCC);         // MOV EAX,[ESI+CC]
	a.emit(0x85, 0xC0);                       // TEST EAX,EAX
	a.jcc(0x84, "selected");
	a.emit(0xC7, 0x00); a.dword(34);
	a.emit(0xC7, 0x40, 0x04); a.dword(33);
	a.emit(0xC7, 0x40, 0x08); a.dword(33);
	a.emit(0xC7, 0x40, 0x0C); a.dword(34);

	a.label("selected");
	a.emit(0x8B, 0x9E); a.dword(InventoryTabsStatic.SelectedTabOffset);
	a.emit(0x85, 0xDB);                       // TEST EBX,EBX
	a.jcc(0x89, "clamp_high");              // JNS clamp_high
	a.emit(0x33, 0xDB);                       // XOR EBX,EBX
	a.label("clamp_high");
	a.emit(0x83, 0xFB, 0x03);                 // CMP EBX,3
	a.jcc(0x8E, "format");                  // JLE format
	a.emit(0xBB); a.dword(3);                 // MOV EBX,3

	a.label("format");
	a.emit(0x8D, 0x85); a.dword(-0xB0);       // LEA EAX,[EBP-B0]
	a.emit(0x8D, 0x4B, 0x01);                // LEA ECX,[EBX+1]
	a.emit(0x51);                             // PUSH ECX
	a.emit(0x68); a.dword(tabFormatVir);       // PUSH format
	a.emit(0x50);                             // PUSH buffer
	a.call(InventoryTabsStatic.Sprintf);
	a.emit(0x83, 0xC4, 0x0C);                // ADD ESP,C

	a.call(InventoryTabsStatic.GetTexMgr);
	a.emit(0x8B, 0xF8, 0x85, 0xFF);          // MOV EDI,EAX / TEST EDI,EDI
	a.jcc(0x84, "done");
	a.emit(0x8D, 0x85); a.dword(-0xB0);       // LEA EAX,[EBP-B0]
	a.emit(0x50);                             // PUSH buffer
	a.call(InventoryTabsStatic.ConvPath);
	a.emit(0x83, 0xC4, 0x04);                // ADD ESP,4
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0xCF, 0x50);                // MOV ECX,EDI / PUSH EAX
	a.call(InventoryTabsStatic.LoadSurface);
	a.emit(0x8B, 0xF8, 0x85, 0xFF);          // MOV EDI,EAX / TEST EDI,EDI
	a.jcc(0x84, "done");

	a.emit(0x8B, 0xCE);                       // MOV ECX,ESI
	a.emit(0x68); a.dword(0xFFFF00FF);        // PUSH magenta color key
	a.call(InventoryTabsStatic.ClearSurface);
	a.emit(0x6A, 0x00, 0x57, 0x6A, 0x00, 0x6A, 0x00);
	a.emit(0x8B, 0xCE);                       // MOV ECX,ESI
	a.call(InventoryTabsStatic.ImageDraw);

	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B);                // POP EDI/ESI/EBX
	a.emit(0x8B, 0xE5, 0x5D, 0xC3);          // MOV ESP,EBP / POP EBP / RET
	return a;
};

InventoryTabsStatic.buildTabMouse = function(
	stateVir, tooltipTableVir, yTableVir, themeStateVir
)
{
	const a = InventoryTabsStatic.asm();

	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "original");
	a.emit(0x3B, 0x0D); a.dword(stateVir + 4); // CMP ECX,[inventoryTab]
	a.jcc(0x85, "original");
	a.emit(0x8B, 0x41, InventoryTabsStatic.ControlParentOffset); // MOV EAX,[ECX+parent]
	a.emit(0x3B, 0x05); a.dword(stateVir);      // CMP EAX,[inventoryWindow]
	a.jcc(0x85, "original");
	a.emit(0x85, 0xC0);                       // TEST EAX,EAX
	a.jcc(0x84, "original");
	a.emit(0x81, 0x38); a.dword(InventoryTabsStatic.WindowVtable); // CMP [EAX],inventory vtable
	a.jcc(0x85, "original");
	a.emit(0x3B, 0x88); a.dword(InventoryTabsStatic.TabControlOffset); // CMP ECX,[EAX+tab]
	a.jcc(0x85, "original");
	a.emit(0x55, 0x8B, 0xEC);                 // PUSH EBP / MOV EBP,ESP
	a.emit(0x83, 0xEC, 0x08);                 // SUB ESP,8
	a.emit(0x53, 0x56, 0x57);                 // PUSH EBX/ESI/EDI
	a.emit(0x8B, 0xF1);                       // MOV ESI,ECX
	a.emit(0xFF, 0x75, 0x0C);                 // PUSH [EBP+C] y
	a.emit(0xFF, 0x75, 0x08);                 // PUSH [EBP+8] x
	a.call(InventoryTabsStatic.HitTest);
	a.emit(0x83, 0xF8, 0x00);                 // CMP EAX,0
	a.jcc(0x8C, "handled");                 // JL handled
	a.emit(0x83, 0xF8, 0x03);                 // CMP EAX,3
	a.jcc(0x8F, "handled");                 // JG handled
	a.emit(0x8B, 0xD8);                       // MOV EBX,EAX
	a.emit(0xC7, 0x45, 0xFC); a.dword(InventoryTabsStatic.TooltipX);
	a.emit(0x8B, 0x04, 0x9D); a.dword(yTableVir);
	a.emit(0x89, 0x45, 0xF8);                 // MOV [EBP-8],EAX
	a.emit(0x8D, 0x45, 0xF8, 0x50);          // LEA EAX,[EBP-8] / PUSH EAX
	a.emit(0x8D, 0x45, 0xFC, 0x50);          // LEA EAX,[EBP-4] / PUSH EAX
	a.emit(0x8B, 0xCE);                       // MOV ECX,ESI
	a.call(InventoryTabsStatic.ClientToScreen);
	a.emit(0x8B, 0x0D); a.dword(InventoryTabsStatic.TooltipManagerPtr);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "handled");
	a.emit(0x8B, 0x04, 0x9D); a.dword(tooltipTableVir);
	a.emit(0x6A, 0x01, 0x6A, 0x00, 0x6A, 0xFF);
	a.emit(0xFF, 0x75, 0xF8);                 // PUSH y
	a.emit(0xFF, 0x75, 0xFC);                 // PUSH x
	a.emit(0x50);                             // PUSH text
	a.call(InventoryTabsStatic.ShowTooltip);

	a.label("handled");
	a.emit(0x5F, 0x5E, 0x5B);                // POP EDI/ESI/EBX
	a.emit(0x8B, 0xE5, 0x5D);                // MOV ESP,EBP / POP EBP
	a.emit(0xC2, 0x08, 0x00);                // RET 8

	a.label("original");
	a.jmp(InventoryTabsStatic.TabMouseOriginal);
	return a;
};

InventoryTabsStatic.buildZenyUnderlay = function(
	zenyPathVir,
	weightPathVir,
	zenyLabelVir,
	weightFormatVir,
	themeStateVir
)
{
	const a = InventoryTabsStatic.asm();

	const loadSurface = function(pathVir, failedLabel)
	{
		a.call(InventoryTabsStatic.GetTexMgr);
		a.emit(0x8B, 0xF8, 0x85, 0xFF);      // MOV EDI,EAX / TEST EDI,EDI
		a.jcc(0x84, failedLabel);
		a.emit(0x68); a.dword(pathVir);
		a.call(InventoryTabsStatic.ConvPath);
		a.emit(0x83, 0xC4, 0x04);            // ADD ESP,4
		a.emit(0x85, 0xC0);
		a.jcc(0x84, failedLabel);
		a.emit(0x8B, 0xCF, 0x50);            // MOV ECX,EDI / PUSH EAX
		a.call(InventoryTabsStatic.LoadSurface);
		a.emit(0x8B, 0xF8, 0x85, 0xFF);      // MOV EDI,EAX / TEST EDI,EDI
		a.jcc(0x84, failedLabel);
	};

	const drawPanelSurface = function(xOffset)
	{
		a.emit(0x6A, 0x00, 0x57);                // PUSH 0 / PUSH surface
		a.emit(0xFF, 0x75, 0x64);                // PUSH panelY
		a.emit(0x8B, 0x45, 0x60);                // MOV EAX,panelX
		if (xOffset > 0)
		{
			a.emit(0x05); a.dword(xOffset);        // ADD EAX,xOffset
		}
		a.emit(0x50);                            // PUSH x
		a.emit(0x8B, 0xCE);                      // MOV ECX,ESI
		a.call(InventoryTabsStatic.ImageDraw);
	};

	const fillPanelMiddle = function()
	{
		a.emit(0x68); a.dword(InventoryTabsStatic.PanelBackgroundColor);
		a.emit(0x6A, InventoryTabsStatic.ZenyHeight);
		a.emit(0x68); a.dword(
			InventoryTabsStatic.ZenyWidth - InventoryTabsStatic.PanelCornerInset * 2
		);
		a.emit(0xFF, 0x75, 0x64);                // PUSH panelY
		a.emit(0x8B, 0x45, 0x60);                // MOV EAX,panelX
		a.emit(0x83, 0xC0, InventoryTabsStatic.PanelCornerInset);
		a.emit(0x50);                            // PUSH x
		a.emit(0x8B, 0xCE);                      // MOV ECX,ESI
		a.call(InventoryTabsStatic.FillRect);
	};

	const drawTextAbsolute = function(textVir, xOffset, yOffset)
	{
		a.emit(0x8B, 0x45, 0x64);             // MOV EAX,[EBP+64] panelY
		a.emit(0x83, 0xC0, yOffset);
		a.emit(0x6A, 0x00, 0x6A, 0x00);
		a.emit(0x68); a.dword(InventoryTabsStatic.PanelTextColor);
		a.emit(0x6A, 0x0B, 0x6A, 0x00, 0x6A, 0x00);
		a.emit(0x68); a.dword(textVir);
		a.emit(0x50);                           // PUSH y
		a.emit(0x8B, 0x55, 0x60);              // MOV EDX,[EBP+60] panelX
		a.emit(0x83, 0xC2, xOffset);
		a.emit(0x52);                           // PUSH x
		a.emit(0x8B, 0xCE);                    // MOV ECX,ESI
		a.call(InventoryTabsStatic.TextDraw);
	};

	const measureBuffer = function(bufferOffset)
	{
		a.emit(0x6A, 0x00, 0x6A, 0x00, 0x6A, 0x0B, 0x6A, 0x00, 0x6A, 0x00);
		a.emit(0x8D, 0x45, bufferOffset, 0x50); // LEA EAX,[EBP+off] / PUSH EAX
		a.emit(0x8B, 0xCE);
		a.call(InventoryTabsStatic.TextWidth);
		a.emit(0x8B, 0xD8);                    // MOV EBX,EAX
	};

	const drawBufferRight = function(bufferOffset, yOffset, useRegisterColor = false)
	{
		a.emit(0x8B, 0x45, 0x64);              // MOV EAX,[EBP+64] panelY
		a.emit(0x83, 0xC0, yOffset);
		a.emit(0x6A, 0x00, 0x6A, 0x00);
		if (useRegisterColor)
			a.emit(0x57);                          // PUSH EDI color
		else
		{
			a.emit(0x68); a.dword(InventoryTabsStatic.PanelTextColor);
		}
		a.emit(0x6A, 0x0B, 0x6A, 0x00, 0x6A, 0x00);
		a.emit(0x8D, 0x4D, bufferOffset, 0x51); // LEA ECX,[EBP+off] / PUSH ECX
		a.emit(0x50);                           // PUSH y
		a.emit(0x8B, 0x55, 0x60);              // MOV EDX,[EBP+60] panelX
		a.emit(0x81, 0xC2); a.dword(InventoryTabsStatic.ZenyWidth - 5);
		a.emit(0x2B, 0xD3);                    // SUB EDX,EBX width
		a.emit(0x52);                           // PUSH x
		a.emit(0x8B, 0xCE);
		a.call(InventoryTabsStatic.TextDraw);
	};

	a.emit(0x9C, 0x60);                       // PUSHFD / PUSHAD
	a.emit(0x81, 0xEC); a.dword(0x80);         // SUB ESP,80
	a.emit(0x8B, 0xEC);                       // MOV EBP,ESP local base
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "restore");
	a.emit(0x8B, 0xF3, 0x85, 0xF6);          // MOV ESI,EBX / TEST ESI,ESI
	a.jcc(0x84, "restore");

	// Panel origin: bottom-right with an 8px right and 28px bottom margin.
	a.emit(0x8B, 0x46, 0x14);                // MOV EAX,[ESI+14] width
	a.emit(0x2D); a.dword(InventoryTabsStatic.ZenyWidth + InventoryTabsStatic.ZenyRightMargin);
	a.emit(0x85, 0xC0);
	a.jcc(0x89, "x_ok");
	a.emit(0x33, 0xC0);
	a.label("x_ok");
	a.emit(0x89, 0x45, 0x60);                // MOV [EBP+60],EAX
	a.emit(0x8B, 0x46, 0x18);                // MOV EAX,[ESI+18] height
	a.emit(0x2D); a.dword(InventoryTabsStatic.ZenyHeight + InventoryTabsStatic.ZenyBottomMargin);
	a.emit(0x85, 0xC0);
	a.jcc(0x89, "y_ok");
	a.emit(0x33, 0xC0);
	a.label("y_ok");
	a.emit(0x89, 0x45, 0x64);                // MOV [EBP+64],EAX

	// Erase the native empty-slot textures in the final grid row without
	// reducing the window's painted row count. The panel is drawn over this
	// opaque inventory-background reservation immediately afterward.
	a.emit(0x8B, 0x86); a.dword(0xDC);         // MOV EAX,[ESI+DC] rows
	a.emit(0x85, 0xC0);
	a.jcc(0x8E, "blank_row_done");           // JLE blank_row_done
	a.emit(0x48, 0xC1, 0xE0, 0x05);          // DEC EAX / SHL EAX,5
	a.emit(0x83, 0xC0, 0x11);                // ADD EAX,17 row y
	a.emit(0x8B, 0x96); a.dword(0xE0);         // MOV EDX,[ESI+E0] columns
	a.emit(0xC1, 0xE2, 0x05);                // SHL EDX,5 row width
	// Match the two native empty-slot surfaces: ordinary tabs are white, while
	// a locked Personal tab uses the pale-blue itemwin_mid_lock background.
	a.emit(0x83, 0xBE); a.dword(0x10C); a.emit(InventoryTabsStatic.PersonalTabIndex);
	a.jcc(0x85, "regular_row_color");          // JNE regular_row_color
	a.emit(0x80, 0x3D); a.dword(InventoryTabsStatic.PersonalLockState); a.emit(0x01);
	a.jcc(0x85, "regular_row_color");          // JNE regular_row_color
	a.emit(0x68); a.dword(InventoryTabsStatic.LockedReservedRowColor);
	a.jmp("row_color_ready");
	a.label("regular_row_color");
	a.emit(0x68); a.dword(InventoryTabsStatic.ReservedRowColor);
	a.label("row_color_ready");
	a.emit(0x6A, 0x20, 0x52, 0x50, 0x6A, 0x28); // height,width,y,x
	a.emit(0x8B, 0xCE);
	a.call(InventoryTabsStatic.FillRect);
	a.label("blank_row_done");

	// Background first so native text and the added summary remain visible.
	// Overlap two native-width copies for the outer corners, then repaint the
	// uniform center to hide both internal rounded edges. This extends the panel
	// without an edited resource or a scaling hook.
	loadSurface(zenyPathVir, "content");
	drawPanelSurface(0);
	drawPanelSurface(InventoryTabsStatic.ZenyWidth - InventoryTabsStatic.ZenyBitmapWidth);
	fillPanelMiddle();

	a.label("content");
	drawTextAbsolute(zenyLabelVir, 7, 4);

	// Use the client's bounded number formatter so Zeny has comma grouping.
	a.emit(0x6A, 0x20);
	a.emit(0x8D, 0x45, 0x00, 0x50);          // LEA EAX,[EBP] / PUSH EAX
	a.emit(0x6A, 0x00);
	a.emit(0xFF, 0x35); a.dword(InventoryTabsStatic.CurrentZeny);
	a.call(InventoryTabsStatic.NumberFormat);
	a.emit(0x83, 0xC4, 0x10);
	measureBuffer(0x00);
	drawBufferRight(0x00, 4);

	// Draw the native 12x11 weight icon at the start of the second row.
	loadSurface(weightPathVir, "weight_text");
	a.emit(0x6A, 0x01, 0x57);                // PUSH alpha/surface
	a.emit(0x8B, 0x45, 0x64, 0x83, 0xC0, 0x14, 0x50);
	a.emit(0x8B, 0x55, 0x60, 0x83, 0xC2, 0x08, 0x52);
	a.emit(0x8B, 0xCE);
	a.call(InventoryTabsStatic.ImageDraw);

	a.label("weight_text");
	// Format current and maximum weight separately, then compose the summary.
	a.emit(0x6A, 0x20);
	a.emit(0x8D, 0x45, 0x20, 0x50);
	a.emit(0x6A, 0x00);
	a.emit(0xFF, 0x35); a.dword(InventoryTabsStatic.CurrentWeight);
	a.call(InventoryTabsStatic.NumberFormat);
	a.emit(0x83, 0xC4, 0x10);
	a.emit(0x6A, 0x20);
	a.emit(0x8D, 0x45, 0x40, 0x50);
	a.emit(0x6A, 0x00);
	a.emit(0xFF, 0x35); a.dword(InventoryTabsStatic.MaximumWeight);
	a.call(InventoryTabsStatic.NumberFormat);
	a.emit(0x83, 0xC4, 0x10);
	a.emit(0x8D, 0x45, 0x40, 0x50);
	a.emit(0x8D, 0x45, 0x20, 0x50);
	a.emit(0x68); a.dword(weightFormatVir);
	a.emit(0x8D, 0x45, 0x00, 0x50);
	a.call(InventoryTabsStatic.Sprintf);
	a.emit(0x83, 0xC4, 0x10);
	measureBuffer(0x00);

	// Match the stock Basic Info warning path: percent=current*100/max, maximum
	// is clamped to one, and the server-fed warning threshold selects red.
	a.emit(0xBF); a.dword(InventoryTabsStatic.PanelTextColor); // MOV EDI,normal color
	a.emit(0x8B, 0x0D); a.dword(InventoryTabsStatic.MaximumWeight); // MOV ECX,max
	a.emit(0xB8); a.dword(1);                  // MOV EAX,1
	a.emit(0x3B, 0xC8);                       // CMP ECX,EAX
	a.emit(0x0F, 0x4C, 0xC8);                 // CMOVL ECX,EAX
	a.emit(0x6B, 0x05); a.dword(InventoryTabsStatic.CurrentWeight); a.emit(0x64);
	a.emit(0x99, 0xF7, 0xF9);                 // CDQ / IDIV ECX
	a.emit(0x3B, 0x05); a.dword(InventoryTabsStatic.WeightWarningPercent);
	a.jcc(0x8C, "weight_color_ready");       // JL normal color
	a.emit(0xBF); a.dword(InventoryTabsStatic.WeightWarningColor); // MOV EDI,red
	a.label("weight_color_ready");
	drawBufferRight(0x00, 20, true);

	a.label("restore");
	a.emit(0x8B, 0xE5);                       // MOV ESP,EBP
	a.emit(0x81, 0xC4); a.dword(0x80);        // ADD ESP,80
	a.emit(0x61, 0x9D);                       // POPAD / POPFD
	a.emit(0xB9); a.dword(0x015FA3C0);        // stolen MOV ECX,015FA3C0
	a.jmp(InventoryTabsStatic.ZenyInsert + 5);
	return a;
};

InventoryTabsStatic.buildItemEndCount = function(returnVir, themeStateVir)
{
	const a = InventoryTabsStatic.asm();
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "classic");
	a.emit(0x0F, 0xAF, 0x83); a.dword(0xE0); // IMUL EAX,[EBX+E0]
	a.emit(0x2B, 0x83); a.dword(0xE0);         // SUB EAX,[EBX+E0] one row
	a.jmp(returnVir);
	a.label("classic");
	a.emit(0x0F, 0xAF, 0x83); a.dword(0xE0); // original item count
	a.jmp(returnVir);
	return a;
};

InventoryTabsStatic.buildWindowMouse = function(themeStateVir)
{
	const a = InventoryTabsStatic.asm();

	a.emit(0x55, 0x8B, 0xEC);                 // PUSH EBP / MOV EBP,ESP
	a.emit(0x83, 0xEC, 0x48);                 // SUB ESP,48
	a.emit(0x53, 0x56, 0x57);                 // PUSH EBX/ESI/EDI
	a.emit(0x8B, 0xF1);                       // MOV ESI,ECX
	a.emit(0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08);
	a.emit(0x8B, 0xCE);
	a.call(InventoryTabsStatic.WindowMouseOriginal);
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "done");

	// Calculate the bottom-right panel rectangle in inventory-local space.
	a.emit(0x8B, 0x46, 0x14);                // MOV EAX,[ESI+14]
	a.emit(0x2D); a.dword(InventoryTabsStatic.ZenyWidth + InventoryTabsStatic.ZenyRightMargin);
	a.emit(0x85, 0xC0);
	a.jcc(0x89, "panel_x_ok");
	a.emit(0x33, 0xC0);
	a.label("panel_x_ok");
	a.emit(0x89, 0x45, 0xFC);                // MOV [EBP-4],EAX
	a.emit(0x8B, 0x4D, 0x08);                // MOV ECX,[EBP+8] mouseX
	a.emit(0x3B, 0xC8);
	a.jcc(0x8C, "done");                    // JL done
	a.emit(0x05); a.dword(InventoryTabsStatic.ZenyWidth);
	a.emit(0x3B, 0xC8);
	a.jcc(0x8D, "done");                    // JGE done when x >= right

	a.emit(0x8B, 0x46, 0x18);                // MOV EAX,[ESI+18]
	a.emit(0x2D); a.dword(InventoryTabsStatic.ZenyHeight + InventoryTabsStatic.ZenyBottomMargin);
	a.emit(0x85, 0xC0);
	a.jcc(0x89, "panel_y_ok");
	a.emit(0x33, 0xC0);
	a.label("panel_y_ok");
	a.emit(0x89, 0x45, 0xF8);                // MOV [EBP-8],EAX
	a.emit(0x8B, 0x4D, 0x0C);                // MOV ECX,[EBP+C] mouseY
	a.emit(0x8D, 0x50, 0x12);                // LEA EDX,[EAX+12] weight top
	a.emit(0x3B, 0xCA);
	a.jcc(0x8C, "done");
	a.emit(0x83, 0xC0, InventoryTabsStatic.ZenyHeight);
	a.emit(0x3B, 0xC8);
	a.jcc(0x8D, "done");

	// Percent = current * 100 / max, matching the stock Basic Info balloon.
	a.emit(0x8B, 0x0D); a.dword(InventoryTabsStatic.MaximumWeight);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "zero_percent");
	a.emit(0xA1); a.dword(InventoryTabsStatic.CurrentWeight);
	a.emit(0x6B, 0xC0, 0x64);                // IMUL EAX,EAX,100
	a.emit(0x99, 0xF7, 0xF9);                // CDQ / IDIV ECX
	a.jmp("format_percent");
	a.label("zero_percent");
	a.emit(0x33, 0xC0);
	a.label("format_percent");
	a.emit(0x50);
	a.emit(0x68); a.dword(InventoryTabsStatic.WeightTooltipFormat);
	a.emit(0x8D, 0x45, 0xB8, 0x50);          // LEA EAX,[EBP-48] / PUSH EAX
	a.call(InventoryTabsStatic.Sprintf);
	a.emit(0x83, 0xC4, 0x0C);

	// Anchor the balloon at the panel's left edge, immediately above weight.
	a.emit(0x8B, 0x45, 0xFC, 0x89, 0x45, 0xF4);
	a.emit(0x8B, 0x45, 0xF8, 0x40, 0x89, 0x45, 0xF0);
	a.emit(0x8D, 0x45, 0xF0, 0x50);
	a.emit(0x8D, 0x45, 0xF4, 0x50);
	a.emit(0x8B, 0xCE);
	a.call(InventoryTabsStatic.ClientToScreen);
	a.emit(0x8B, 0x0D); a.dword(InventoryTabsStatic.TooltipManagerPtr);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "done");
	a.emit(0x6A, 0x01, 0x6A, 0x00, 0x6A, 0xFF);
	a.emit(0xFF, 0x75, 0xF0, 0xFF, 0x75, 0xF4);
	a.emit(0x8D, 0x45, 0xB8, 0x50);
	a.call(InventoryTabsStatic.ShowTooltip);

	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B);
	a.emit(0x8B, 0xE5, 0x5D);
	a.emit(0xC2, 0x08, 0x00);
	return a;
};

InventoryTabsStatic.buildRefresh = function()
{
	const a = InventoryTabsStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.emit(0x68); a.dword(InventoryTabsStatic.WindowId);
	a.emit(0xB9); a.dword(InventoryTabsStatic.WindowManager);
	a.call(InventoryTabsStatic.GetWindow);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "done");
	a.emit(0x68); a.dword(InventoryTabsStatic.WindowId);
	a.emit(0xB9); a.dword(InventoryTabsStatic.WindowManager);
	a.call(InventoryTabsStatic.CloseWindow);
	a.emit(0x68); a.dword(InventoryTabsStatic.WindowId);
	a.emit(0xB9); a.dword(InventoryTabsStatic.WindowManager);
	a.call(InventoryTabsStatic.CreateWindow);
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

InventoryTabsStatic.assertVtable = function(label, entryVir, expected)
{
	const phyAddr = Exe.Vir2Phy(entryVir);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroInventory: ${label} is not mapped`);
	const actual = Exe.GetUint32(phyAddr);
	if (actual !== expected)
		throw Error(
			`ROGlobalZeroInventory: ${label} expected 0x${expected.toString(16)}, ` +
			`got 0x${actual.toString(16)}`
		);
	return phyAddr;
};

InventoryTabsStatic.assertCode = function(label, virAddr, expectedHex)
{
	const phyAddr = Exe.Vir2Phy(virAddr, CODE);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroInventory: ${label} is not mapped`);
	const count = InventoryTabsStatic.hexNorm(expectedHex).split(" ").length;
	const actual = InventoryTabsStatic.hexNorm(Exe.GetHex(phyAddr, count));
	if (actual !== InventoryTabsStatic.hexNorm(expectedHex))
		throw Error(`ROGlobalZeroInventory: ${label} mismatch, got ${actual}`);
	return phyAddr;
};

ROGlobalZeroInventory = function(_)
{
	if (Exe.BuildDate !== InventoryTabsStatic.BuildDate)
		throw Error("ROGlobalZeroInventory supports only the 2025-07-16 client");
	const theme = CACHE.get("ROGlobalZeroUITheme.State");
	if (!theme || !Number.isInteger(theme.stateVir) ||
		!Number.isInteger(theme.loadVir))
	{
		throw Error(
			"ROGlobalZeroInventory: ROGlobalZeroUITheme must run first"
		);
	}

	$$(_, 1, `Verify inventory vtables, item bounds, and bottom-text sites`);
	const windowEntryPhy = InventoryTabsStatic.assertVtable(
		"inventory window vtable[20]",
		InventoryTabsStatic.WindowVtableEntry,
		InventoryTabsStatic.WindowDrawOriginal
	);
	const tabDrawEntryPhy = InventoryTabsStatic.assertVtable(
		"tab control vtable[20]",
		InventoryTabsStatic.TabDrawVtableEntry,
		InventoryTabsStatic.TabDrawOriginal
	);
	const windowMouseEntryPhy = InventoryTabsStatic.assertVtable(
		"inventory window vtable[28]",
		InventoryTabsStatic.WindowMouseVtableEntry,
		InventoryTabsStatic.WindowMouseOriginal
	);
	const tabMouseEntryPhy = InventoryTabsStatic.assertVtable(
		"tab control vtable[28]",
		InventoryTabsStatic.TabMouseVtableEntry,
		InventoryTabsStatic.TabMouseOriginal
	);
	const zenyInsertPhy = InventoryTabsStatic.assertCode(
		"inventory bottom text block",
		InventoryTabsStatic.ZenyInsert,
		InventoryTabsStatic.ZenyInsertBytes
	);
	InventoryTabsStatic.assertCode(
		"native comma number formatter",
		InventoryTabsStatic.NumberFormat,
		InventoryTabsStatic.NumberFormatBytes
	);
	const itemEndSitePhys = InventoryTabsStatic.ItemEndCountSites.map((virAddr, index) =>
		InventoryTabsStatic.assertCode(
			`inventory item end count ${index + 1}`,
			virAddr,
			InventoryTabsStatic.ItemEndCountBytes
		)
	);

	$$(_, 2, `Build renewal resource paths and fixed tooltip data`);
	const paths = InventoryTabsStatic.buildResourcePaths();
	const zenyLabelVir = InventoryTabsStatic.allocateBytes(
		InventoryTabsStatic.asciiBytes("Zeny")
	)[1];
	const weightFormatVir = InventoryTabsStatic.allocateBytes(
		InventoryTabsStatic.asciiBytes("%s / %s")
	)[1];
	const blankVir = InventoryTabsStatic.allocateBytes(
		InventoryTabsStatic.asciiBytes(" ")
	)[1];
	const tooltipNames = [
		"Consumables", "Equipment", "Miscellaneous", "Personal"
	];
	const tooltipPointers = [];
	for (const name of tooltipNames)
		tooltipPointers.push(InventoryTabsStatic.allocateBytes(InventoryTabsStatic.asciiBytes(name))[1]);
	const [tooltipTablePhy, tooltipTableVir] = Exe.Allocate(16, 4);
	for (let i = 0; i < tooltipPointers.length; i++)
		Exe.SetUint32(tooltipTablePhy + i * 4, tooltipPointers[i]);
	const [yTablePhy, yTableVir] = Exe.Allocate(16, 4);
	[0, 34, 67, 100].forEach((value, index) => Exe.SetUint32(yTablePhy + index * 4, value));
	const [statePhy, stateVir] = Exe.Allocate(8, 4);
	Exe.SetUint32(statePhy, 0);
	Exe.SetUint32(statePhy + 4, 0);

	$$(_, 3, `Inject native inventory, tab, tooltip, and Zeny-panel handlers`);
	const windowCode = InventoryTabsStatic.buildWindowDraw(
		stateVir, theme.loadVir
	);
	const [windowPhy, windowVir] = Exe.Allocate(windowCode.bytes.length, 0x10);
	Exe.SetHex(windowPhy, windowCode.finish(windowVir));
	const windowMouseCode = InventoryTabsStatic.buildWindowMouse(theme.stateVir);
	const [windowMousePhy, windowMouseVir] = Exe.Allocate(windowMouseCode.bytes.length, 0x10);
	Exe.SetHex(windowMousePhy, windowMouseCode.finish(windowMouseVir));

	const tabDrawCode = InventoryTabsStatic.buildTabDraw(
		stateVir, paths.tabFormatVir, blankVir, theme.stateVir
	);
	const [tabDrawPhy, tabDrawVir] = Exe.Allocate(tabDrawCode.bytes.length, 0x10);
	Exe.SetHex(tabDrawPhy, tabDrawCode.finish(tabDrawVir));

	const tabMouseCode = InventoryTabsStatic.buildTabMouse(
		stateVir, tooltipTableVir, yTableVir, theme.stateVir
	);
	const [tabMousePhy, tabMouseVir] = Exe.Allocate(tabMouseCode.bytes.length, 0x10);
	Exe.SetHex(tabMousePhy, tabMouseCode.finish(tabMouseVir));

	const zenyCode = InventoryTabsStatic.buildZenyUnderlay(
		paths.zenyPathVir,
		paths.weightPathVir,
		zenyLabelVir,
		weightFormatVir,
		theme.stateVir
	);
	const [zenyPhy, zenyVir] = Exe.Allocate(zenyCode.bytes.length, 0x10);
	Exe.SetHex(zenyPhy, zenyCode.finish(zenyVir));

	const itemEndBridges = [];
	for (let i = 0; i < InventoryTabsStatic.ItemEndCountSites.length; i++)
	{
		const siteVir = InventoryTabsStatic.ItemEndCountSites[i];
		const code = InventoryTabsStatic.buildItemEndCount(
			siteVir + 7, theme.stateVir
		);
		const [bridgePhy, bridgeVir] = Exe.Allocate(code.bytes.length, 0x10);
		Exe.SetHex(bridgePhy, code.finish(bridgeVir));
		itemEndBridges.push({siteVir, sitePhy: itemEndSitePhys[i], bridgeVir});
	}
	$$(_, 4, `Activate QJS-only inventory renewal handlers`);
	Exe.SetUint32(windowEntryPhy, windowVir);
	Exe.SetUint32(windowMouseEntryPhy, windowMouseVir);
	Exe.SetUint32(tabDrawEntryPhy, tabDrawVir);
	Exe.SetUint32(tabMouseEntryPhy, tabMouseVir);
	for (const bridge of itemEndBridges)
	{
		Exe.SetJMP(bridge.sitePhy, bridge.bridgeVir, 0);
		Exe.SetNOPs(bridge.sitePhy + 5, 2);
	}
	Exe.SetJMP(zenyInsertPhy, zenyVir, 0);

	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
	{
		PatchDiagnostics.add("ROGlobalZeroInventory.QjsOnly", {
			windowVir,
			windowMouseVir,
			tabDrawVir,
			tabMouseVir,
			zenyVir,
			stateVir,
			themeStateVir: theme.stateVir,
			itemEndBridges,
			tabFormatVir: paths.tabFormatVir,
			zenyPathVir: paths.zenyPathVir,
			weightPathVir: paths.weightPathVir,
			tooltips: tooltipNames
		});
	}

	return true;
};

ROGlobalZeroInventory.validate = function()
{
	if (Exe.BuildDate !== InventoryTabsStatic.BuildDate)
		return false;
	try
	{
		InventoryTabsStatic.assertVtable(
			"inventory window vtable[20]",
			InventoryTabsStatic.WindowVtableEntry,
			InventoryTabsStatic.WindowDrawOriginal
		);
		InventoryTabsStatic.assertVtable(
			"tab control vtable[20]",
			InventoryTabsStatic.TabDrawVtableEntry,
			InventoryTabsStatic.TabDrawOriginal
		);
		InventoryTabsStatic.assertVtable(
			"inventory window vtable[28]",
			InventoryTabsStatic.WindowMouseVtableEntry,
			InventoryTabsStatic.WindowMouseOriginal
		);
		InventoryTabsStatic.assertVtable(
			"tab control vtable[28]",
			InventoryTabsStatic.TabMouseVtableEntry,
			InventoryTabsStatic.TabMouseOriginal
		);
		InventoryTabsStatic.assertCode(
			"inventory bottom text block",
			InventoryTabsStatic.ZenyInsert,
			InventoryTabsStatic.ZenyInsertBytes
		);
		InventoryTabsStatic.assertCode(
			"native comma number formatter",
			InventoryTabsStatic.NumberFormat,
			InventoryTabsStatic.NumberFormatBytes
		);
		for (let i = 0; i < InventoryTabsStatic.ItemEndCountSites.length; i++)
			InventoryTabsStatic.assertCode(
				`inventory item end count ${i + 1}`,
				InventoryTabsStatic.ItemEndCountSites[i],
				InventoryTabsStatic.ItemEndCountBytes
			);
		return true;
	}
	catch (error)
	{
		return false;
	}
};
