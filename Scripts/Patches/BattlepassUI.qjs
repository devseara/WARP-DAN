			pages: [0], native: true, type, difficulty: d, available: 1 << (6 + option), action: 4 + option});
	}
}

BattlepassUIStatic.prepareButtonLayout = function(font)
{
	const b = BattlepassUIStatic, n = AutoCombatUI.nativeHelpers;
	const dialog = {w: 600, h: 176, y: 167, geometry: n.allocateBytes(new Array(12).fill(0), 4).vir};
	for (const [key, text] of Object.entries({title: "Abandon Mission", question: "Are you sure you want to abandon this mission?", warning: "Your current mission progress will be lost.", fee: "Fee:", loading: "Checking current fee..."}))
		dialog[key] = n.allocateString(text).vir;
	const dialogAsm = n.asm();
	dialogAsm.emit(0x60, 0x83, 0x3D); dialogAsm.dword(dialog.geometry + 4); dialogAsm.emit(0); dialogAsm.jcc(0x85, "done");
	dialogAsm.emit(0xBB); dialogAsm.dword(180);
	for (const [pointer, height, bold, extra] of [[dialog.question, font.Body, 0, 0], [dialog.warning, font.Body, 0, 0], [dialog.title, font.Title, 1, 0], [dialog.loading, font.Body, 0, 53], [n.allocateString("2,147,483,647 Zeny").vir, font.Body, 0, 53]]) {
		for (const arg of [0, bold, height, 1, 0, pointer]) n.pushImm(dialogAsm, arg);
		dialogAsm.emit(0x8B, 0xCE); dialogAsm.call(n.TextWidth);
		if (extra) { dialogAsm.emit(0x83, 0xC0, extra); }
		dialogAsm.emit(0x3B, 0xD8, 0x0F, 0x42, 0xD8);
	}
	dialogAsm.emit(0x83, 0xC3, 40, 0x81, 0xFB); dialogAsm.dword(dialog.w); dialogAsm.jcc(0x86, "bounded");
	dialogAsm.emit(0xBB); dialogAsm.dword(dialog.w); dialogAsm.label("bounded");
	dialogAsm.emit(0x89, 0x1D); dialogAsm.dword(dialog.geometry + 4);
	dialogAsm.emit(0xB8); dialogAsm.dword(b.Width); dialogAsm.emit(0x2B, 0xC3, 0xD1, 0xE8, 0xA3); dialogAsm.dword(dialog.geometry);
	dialogAsm.label("done"); dialogAsm.emit(0x61, 0xC3);
	dialog.measure = n.allocateCode(dialogAsm).vir; b.abandonLayout = dialog;
	const captions = {
		1: "Quests", 2: "Mission", 3: "Rewards", 4: "My Stats", 7: "Abandon",
		8: ["Claim Reward", "Get New Mission", "Opening Quests..."],
		9: "Choose Challenge", 10: "View / Claim Rewards",
		11: "Hunt Random Monsters", 12: "Collect Random Items",
		30: "View Rewards", 32: "Back",
		33: "Normal Rewards", 34: "Premium Rewards", 35: "Previous", 36: "Next",
		37: "Claim Reward", 38: "Cancel", 39: "Confirm"
	};
	// Footer placement is independent of caption width. Keep primary actions
	// against the content edge and pack related controls with a fixed gap.
	const anchors = {
		7: {right: 618}, 8: {before: 7, gap: 8}, 9: {right: 618}, 10: {right: 618},
		30: {right: 618}, 32: {left: 118}, 35: {after: 32, gap: 5},
		36: {after: 35, gap: 5}, 37: {right: 618},
		38: {center: b.Width / 2, nextLabel: "Confirm", nextMax: 132, gap: 10}, 39: {after: 38, gap: 10}
	};
	for (let id = 21; id <= 28; ++id) anchors[id] = {right: 618};
	b.buttonLayouts = [];
	for (const c of b.controls) {
		const caption = captions[c.id] || (c.id >= 21 && c.id <= 28 ? "Start Challenge" : null);
		if (!caption) continue; // Close is an icon; difficulty choices are table rows.
		c.layouts = (Array.isArray(caption) ? caption : [caption]).map(label => {
			let layout = b.buttonLayouts.find(l => l.label === label && l.x === c.x && l.slotY === c.y);
			if (layout) return layout;
			const tab = c.id <= 4, bold = tab || c.chooseType !== undefined ? 1 : 0;
			const height = tab ? font.Tab : font.Button, padding = tab ? 10 : 8;
			const h = Math.min(c.h, height + 8), y = c.y + Math.floor((c.h - h) / 2);
			const geometry = n.allocateBytes(new Array(12).fill(0), 4).vir, text = n.allocateString(label).vir;
			const anchor = anchors[c.id];
			const a = n.asm();
			// Layout is immutable during this client session. Save all registers so
			// drawing and input can share it without disturbing pointer coordinates.
			a.emit(0x60, 0x83, 0x3D); a.dword(geometry + 4); a.emit(0); a.jcc(0x85, "done");
			n.pushImm(a, 0); n.pushImm(a, bold); n.pushImm(a, height); n.pushImm(a, 1); n.pushImm(a, 0); n.pushImm(a, text);
			a.emit(0x8B, 0xCE); a.call(n.TextWidth); a.emit(0x8B, 0xD8, 0x83, 0xC0, 2 * padding);
			// Bound texture writes and keep exceptionally large fonts in their slot.
			a.emit(0x3D); a.dword(c.w); a.jcc(0x86, "bounded"); a.emit(0xB8); a.dword(c.w);
			a.label("bounded"); a.emit(0xA3); a.dword(geometry + 4);
			if (anchor && anchor.right !== undefined) {
				a.emit(0xB9); a.dword(anchor.right); a.emit(0x2B, 0xC8);
			} else if (anchor && anchor.left !== undefined) {
				a.emit(0xB9); a.dword(anchor.left);
			} else if (anchor && anchor.center !== undefined) {
				// Center the combined measured captions, rather than two wide slots.
				a.emit(0x50);
				for (const arg of [0, bold, height, 1, 0, n.allocateString(anchor.nextLabel).vir]) n.pushImm(a, arg);
				a.emit(0x8B, 0xCE); a.call(n.TextWidth); a.emit(0x83, 0xC0, 2 * padding, 0x3D); a.dword(anchor.nextMax);
				a.jcc(0x86, "peer_bounded"); a.emit(0xB8); a.dword(anchor.nextMax); a.label("peer_bounded");
				a.emit(0x59, 0x03, 0xC1, 0x83, 0xC0, anchor.gap, 0xD1, 0xE8, 0xBA); a.dword(anchor.center);
				a.emit(0x2B, 0xD0, 0x8B, 0xC1, 0x8B, 0xCA);
			} else if (anchor) {
				const reference = b.controls.find(control => control.id === (anchor.before || anchor.after));
				if (!reference || !reference.layouts) throw Error("BattlepassUI: footer anchor must precede its dependent control");
				const target = reference.layouts[0];
				a.call(target.measure); a.emit(0x8B, 0x0D); a.dword(target.geometry);
				if (anchor.before) { a.emit(0x83, 0xE9, anchor.gap, 0x2B, 0xC8); }
				else { a.emit(0x03, 0x0D); a.dword(target.geometry + 4); a.emit(0x83, 0xC1, anchor.gap); }
			} else {
				a.emit(0xB9); a.dword(c.w); a.emit(0x2B, 0xC8, 0xD1, 0xE9, 0x81, 0xC1); a.dword(c.x);
			}
			a.emit(0x89, 0x0D); a.dword(geometry);
			a.emit(0x2B, 0xC3, 0xD1, 0xF8, 0x03, 0xC1, 0xA3); a.dword(geometry + 8);
			a.label("done"); a.emit(0x61, 0xC3);
			layout = {label, x: c.x, slotY: c.y, w: c.w, y, h, height, bold, tab, padding, anchor, geometry, text, measure: n.allocateCode(a).vir};
			b.buttonLayouts.push(layout); return layout;
		});
	}
};

BattlepassUIStatic.emitControlRect = function(a, state, c, next)
{
	const b = BattlepassUIStatic, n = AutoCombatUI.nativeHelpers;
	if (!c.layouts) { n.emitRectGate(a, c.x, c.y, c.x + c.w, c.y + c.h, next); return; }
	const bounds = layout => {
		a.call(layout.measure);
		a.emit(0x3B, 0x1D); a.dword(layout.geometry); a.jcc(0x8C, next);
		a.emit(0xA1); a.dword(layout.geometry); a.emit(0x03, 0x05); a.dword(layout.geometry + 4);
		a.emit(0x3B, 0xD8); a.jcc(0x8D, next);
		a.emit(0x81, 0xFA); a.dword(layout.y); a.jcc(0x8C, next);
		a.emit(0x81, 0xFA); a.dword(layout.y + layout.h); a.jcc(0x8D, next);
	};
	if (!c.mission) { bounds(c.layouts[0]); return; }
	a.emit(0x83, 0x3D); a.dword(state + b.Pending); a.emit(2); a.jcc(0x84, next + "_opening");
	a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 10); a.emit(1); a.jcc(0x84, next + "_new");
	a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 10); a.emit(4); a.jcc(0x85, next + "_new");
	bounds(c.layouts[0]); a.jmp(next + "_rect_done");
	a.label(next + "_new"); bounds(c.layouts[1]); a.jmp(next + "_rect_done");
	a.label(next + "_opening"); bounds(c.layouts[2]); a.label(next + "_rect_done");
};

BattlepassUIStatic.controlGate = function(a, state, c, next, disabled)
{
	const b = BattlepassUIStatic;
	if (c.modal) {
		a.emit(0x83, 0x3D); a.dword(state + b.Modal); a.emit(0); a.jcc(0x84, next);
		a.emit(0x83, 0x3D); a.dword(state + b.Modal); a.emit(3); a.jcc(0x84, disabled);
		if (c.confirm) { a.emit(0x83, 0x3D); a.dword(state + b.Modal); a.emit(2); a.jcc(0x85, disabled); }
	} else {
		a.emit(0x83, 0x3D); a.dword(state + b.Modal); a.emit(0); a.jcc(0x85, next);
	}
		if (c.pages) {
			for (const page of c.pages) {
				a.emit(0x83, 0x3D); a.dword(state + b.Tab); a.emit(page); a.jcc(0x84, next + "_page");
			}
			a.jmp(next); a.label(next + "_page");
		}
		if (c.native || c.legacy) {
			a.emit(0x66, 0xF7, 0x05); a.dword(state + b.Snapshot + 10); a.word(b.NativeSelection);
			a.jcc(c.legacy ? 0x85 : 0x84, next);
		}
		if (Number.isInteger(c.type)) {
			a.emit(0x83, 0x3D); a.dword(state + b.SelectionType); a.emit(c.type); a.jcc(0x85, next);
		}
		if (Number.isInteger(c.difficulty)) {
			a.emit(0x83, 0x3D); a.dword(state + b.Difficulty); a.emit(c.difficulty); a.jcc(0x85, next);
		}
		if (c.native) {
			b.challengeGate(a, state, disabled);
		}
		if (Number.isInteger(c.rewardMode)) {
			a.emit(0x83, 0x3D); a.dword(state + b.RewardMode); a.emit(c.rewardMode); a.jcc(0x85, next);
		}
		if (c.reward) {
			a.emit(0x66, 0x83, 0x3D); a.dword(state + b.Snapshot + 8); a.emit(2); a.jcc(0x82, disabled);
			a.emit(0x83, 0x3D); a.dword(state + b.RewardPending); a.emit(c.rewardClaim ? 0 : 1); a.jcc(c.rewardClaim ? 0x85 : 0x84, disabled);
		}
		if (Number.isInteger(c.rewardDelta)) {
			a.emit(0xA1); a.dword(state + b.Snapshot + 1176);
			a.emit(0x83, 0x3D); a.dword(state + b.RewardPending); a.emit(2); a.jcc(0x85, next + "_nav_page");
			a.emit(0xA1); a.dword(state + b.BrowseTrack); a.emit(0x3B, 0x05); a.dword(state + b.Snapshot + 1192); a.jcc(0x85, disabled);
			a.emit(0xA1); a.dword(state + b.BrowsePage); a.label(next + "_nav_page");
			if (c.rewardDelta < 0) { a.emit(0x85, 0xC0); a.jcc(0x84, disabled); }
			else { a.emit(0x40, 0x3B, 0x05); a.dword(state + b.Snapshot + 1180); a.jcc(0x83, disabled); }
		} else if (c.rewardFlag) {
			a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 1188); a.emit(c.rewardFlag); a.jcc(0x84, disabled);
		}
		if (c.available) {
			a.emit(0x66, 0xF7, 0x05); a.dword(state + b.Snapshot + 10); a.word(c.available); a.jcc(0x84, disabled);
		}
		if (c.action >= 4 && c.action <= 11) {
			a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 10); a.emit(1); a.jcc(0x85, disabled);
		}
		if (Number.isInteger(c.action) && c.action !== 0) {
			a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 10); a.emit(16); a.jcc(0x84, disabled);
		}
		if (c.abandon) {
			a.emit(0x0F, 0xB7, 0x05); a.dword(state + b.Snapshot + 10);
			a.emit(0x83, 0xE0, 7, 0x83, 0xF8, 1); a.jcc(0x85, disabled);
		}
		if (c.mission) {
			a.emit(0x83, 0x3D); a.dword(state + b.Pending); a.emit(0); a.jcc(0x85, disabled);
			a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 10); a.emit(1); a.jcc(0x84, next + "_mission_ready");
			a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 10); a.emit(4); a.jcc(0x85, next + "_mission_expired");
			a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 10); a.emit(2); a.jcc(0x84, disabled); a.jmp(next + "_mission_ready");
			a.label(next + "_mission_expired");
			a.emit(0x66, 0x83, 0x3D); a.dword(state + b.Snapshot + 8); a.emit(4); a.jcc(0x82, disabled);
			a.emit(0x66, 0xF7, 0x05); a.dword(state + b.Snapshot + 1188); a.word(256); a.jcc(0x84, disabled);
			a.label(next + "_mission_ready");
		}
};

BattlepassUIStatic.hover = function(state)
{
	const n = AutoCombatUI.nativeHelpers, b = BattlepassUIStatic, a = n.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	a.emit(0x8B, 0x5D, 0x08, 0x8B, 0x55, 0x0C);
	a.emit(0x3B, 0x1D); a.dword(state + b.CursorX); a.jcc(0x85, "pointer_changed");
	a.emit(0x3B, 0x15); a.dword(state + b.CursorY); a.jcc(0x84, "pointer_unchanged");
	a.label("pointer_changed"); n.emitMarkDirty(a); a.label("pointer_unchanged");
	a.emit(0x89, 0x1D); a.dword(state + b.CursorX); a.emit(0x89, 0x15); a.dword(state + b.CursorY);
	a.emit(0x31, 0xFF);
	a.emit(0x80, 0x7E, n.WindowVisibleOffset, 0); a.jcc(0x84, "found");
	for (const c of b.controls) {
		const next = "hover_" + c.id;
		b.emitControlRect(a, state, c, next);
		b.controlGate(a, state, c, next, next);
		a.emit(0xBF); a.dword(c.id); a.jmp("found"); a.label(next);
	}
	a.label("found");
	a.emit(0x3B, 0x3D); a.dword(state + b.Hover); a.jcc(0x84, "hover_unchanged");
	a.emit(0x89, 0x3D); a.dword(state + b.Hover); n.emitMarkDirty(a); a.label("hover_unchanged");
	a.emit(0x5F, 0x5E, 0x5B, 0x5D, 0xC2, 0x08, 0x00);
	return a;
};

BattlepassUIStatic.itemRightClick = function(state, resolver)
{
	const n = AutoCombatUI.nativeHelpers, b = BattlepassUIStatic, a = n.asm();
	// UIItemImage::OnRButtonUp (0x803CB0), also used by mesitemicon:
	// construct a CItem, put its decimal ID in the inline string at +0x2C,
	// mark identified (+0x5C), acquire window 12, dispatch message 24 with
	// the CItem pointer, then destroy the temporary. Stock owns the panel.
	// The 0xF8-byte CItem never escapes this synchronous message dispatch.
	a.emit(0x55, 0x8B, 0xEC, 0x81, 0xEC); a.dword(0xF8);
	a.emit(0x53, 0x56, 0x57, 0x8B, 0xF1);
	a.emit(0x80, 0x7E, n.WindowVisibleOffset, 0); a.jcc(0x84, "done");
	for (const offset of [b.Modal, b.Dragging, b.Pressed]) {
		a.emit(0x83, 0x3D); a.dword(state + offset); a.emit(0); a.jcc(0x85, "done");
	}
	a.emit(0x83, 0x3D); a.dword(state + b.Tab); a.emit(2); a.jcc(0x85, "done");
	a.emit(0x66, 0x83, 0x3D); a.dword(state + b.Snapshot + 8); a.emit(3); a.jcc(0x82, "done");
	a.emit(0x8B, 0x5D, 0x08, 0x8B, 0x55, 0x0C);
	const icons = [[0, 100, 296, 2240], [0, 100, 364, 2244]];
	for (let i = 0; i < 5; ++i) icons.push([1, 102, 168 + i * 50, 2248 + i * 4]);
	for (const [mode, x, y, offset] of icons) {
		const next = "icon_" + offset;
		a.emit(0x83, 0x3D); a.dword(state + b.RewardMode); a.emit(mode); a.jcc(0x85, next);
		n.emitRectGate(a, x, y, x + 32, y + 32, next);
		a.emit(0x8B, 0x3D); a.dword(state + b.Snapshot + offset); a.jmp("item"); a.label(next);
	}
	a.jmp("done"); a.label("item");
	a.emit(0x85, 0xFF); a.jcc(0x84, "done"); a.emit(0x57); a.call(resolver);
	a.emit(0x85, 0xC0); a.jcc(0x84, "done");
	a.emit(0x8D, 0x9D); a.dword(-0xF8); a.emit(0x8B, 0xCB); a.call(0x006A1B20);
	a.emit(0x57); n.pushImm(a, n.allocateString("%u").vir); a.emit(0x8D, 0x43, 0x2C, 0x50);
	a.call(n.StringFormat); a.emit(0x83, 0xC4, 0x0C, 0x89, 0x43, 0x3C, 0xC6, 0x43, 0x5C, 1);
	n.pushImm(a, 12); a.emit(0xB9); a.dword(n.WindowManager); a.call(0x00A39340);
	a.emit(0x85, 0xC0); a.jcc(0x84, "destroy_item");
	a.emit(0x8B, 0x10); n.pushImm(a, 0); n.pushImm(a, 0); n.pushImm(a, 0);
	a.emit(0x53); n.pushImm(a, 24); n.pushImm(a, 0); a.emit(0x8B, 0xC8, 0xFF, 0x92); a.dword(0x94);
	a.label("destroy_item"); a.emit(0x8B, 0xCB); a.call(0x005A4300);
	a.label("done"); a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00);
	return a;
};

BattlepassUIStatic.mouse = function(state, senders, stop, release)
{
	const n = AutoCombatUI.nativeHelpers, b = BattlepassUIStatic, a = n.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	if (!release) b.emitReleaseInput(a, state, "down_reset");
	a.emit(0x8B, 0x5D, 0x08, 0x8B, 0x55, 0x0C);
	if (release) {
		a.emit(0x8B, 0x3D); a.dword(state + b.Pressed);
		a.emit(0xC7, 0x05); a.dword(state + b.Pressed); a.dword(0);
	}
	for (const c of b.controls) {
		const next = "next_" + c.id;
		if (release) { a.emit(0x83, 0xFF, c.id); a.jcc(0x85, next); }
		b.emitControlRect(a, state, c, next);
		b.controlGate(a, state, c, next, "consumed");
		if (!release) {
			a.emit(0xC7, 0x05); a.dword(state + b.Pressed); a.dword(c.id);
			a.emit(0xC7, 0x05); a.dword(state + b.Hover); a.dword(c.id);
			a.emit(0x56, 0xB9); a.dword(n.WindowManager); a.call(n.WindowCaptureSet);
			a.jmp("consumed");
		} else {
			if (c.cancel) {
				a.emit(0xC7, 0x05); a.dword(state + b.Modal); a.dword(0); a.jmp("base");
			}
			if (c.confirm) {
				a.emit(0xC7, 0x05); a.dword(state + b.Modal); a.dword(3);
				a.call(senders[17]); a.jmp("base");
			}
			if (c.abandon) {
				a.emit(0x66, 0x83, 0x3D); a.dword(state + b.Snapshot + 8); a.emit(3); a.jcc(0x82, "legacy_abandon");
				a.emit(0xC7, 0x05); a.dword(state + b.Modal); a.dword(1);
				a.emit(0xC7, 0x05); a.dword(state + b.QuoteToken); a.dword(0);
				a.emit(0xA1); a.dword(state + b.QuoteNonce); a.emit(0x40, 0x25); a.dword(0xFFFF);
				a.emit(0x75, 0x01, 0x40, 0xA3); a.dword(state + b.QuoteNonce); a.emit(0xA3); a.dword(state + b.RequestValue);
				a.call(senders[16]); a.jmp("base");
				a.label("legacy_abandon"); a.call(senders[3]);
				a.emit(0xC7, 0x46, n.WindowVisibleOffset); a.dword(0); a.call(stop); a.jmp("base");
			}
			if (Number.isInteger(c.setRewardMode)) {
				a.emit(0xC7, 0x05); a.dword(state + b.RewardMode); a.dword(c.setRewardMode);
			}
			if (Number.isInteger(c.rewardTrack) || Number.isInteger(c.rewardDelta) || c.rewardClaim) {
				if (Number.isInteger(c.rewardTrack)) {
					a.emit(0xC7, 0x05); a.dword(state + b.RequestValue); a.dword(0);
					a.emit(0xB8); a.dword(c.rewardTrack);
				} else {
					if (Number.isInteger(c.rewardDelta)) {
						a.emit(0xA1); a.dword(state + b.Snapshot + 1176);
						a.emit(0x83, 0x3D); a.dword(state + b.RewardPending); a.emit(2); a.jcc(0x85, "nav_current_" + c.id);
						a.emit(0xA1); a.dword(state + b.BrowsePage); a.label("nav_current_" + c.id);
						a.emit(0x05); a.dword(c.rewardDelta); a.emit(0xA3); a.dword(state + b.RequestValue);
					}
					a.emit(0xA1); a.dword(state + b.Snapshot + 1192);
				}
				if (!c.rewardClaim) {
					a.emit(0xA3); a.dword(state + b.BrowseTrack);
					a.emit(0x8B, 0x0D); a.dword(state + b.RequestValue); a.emit(0x89, 0x0D); a.dword(state + b.BrowsePage);
				}
				a.emit(0xC7, 0x05); a.dword(state + b.RewardPending); a.dword(c.rewardClaim ? 1 : 2);
				a.emit(0x85, 0xC0); a.jcc(0x85, "reward_premium_" + c.id);
				a.call(senders[c.rewardClaim ? 14 : 12]); a.jmp("base");
				a.label("reward_premium_" + c.id); a.call(senders[c.rewardClaim ? 15 : 13]); a.jmp("base");
			}
			if (c.mission) {
				a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 10); a.emit(4); a.jcc(0x84, "mission_current");
				a.emit(0xC7, 0x05); a.dword(state + b.Pending); a.dword(2);
				a.call(senders[18]); a.jmp("base"); a.label("mission_current");
				a.emit(0x66, 0xF7, 0x05); a.dword(state + b.Snapshot + 10); a.word(b.NativeSelection); a.jcc(0x84, "mission_dialog");
				a.emit(0xF6, 0x05); a.dword(state + b.Snapshot + 10); a.emit(1); a.jcc(0x85, "mission_dialog");
				a.emit(0xC7, 0x05); a.dword(state + b.Tab); a.dword(0); a.jmp("base");
				a.label("mission_dialog");
			}
			if (Number.isInteger(c.chooseType)) {
				a.emit(0xC7, 0x05); a.dword(state + b.SelectionType); a.dword(c.chooseType);
				a.emit(0xC7, 0x05); a.dword(state + b.Difficulty); a.dword(0);
			}
			if (Number.isInteger(c.chooseDifficulty)) {
				a.emit(0xC7, 0x05); a.dword(state + b.Difficulty); a.dword(c.chooseDifficulty);
			}
			if (Number.isInteger(c.tab)) {
				a.emit(0xC7, 0x05); a.dword(state + b.Tab); a.dword(c.tab);
			}
			if (c.close || (c.action > 0 && c.action < 4)) {
				if (c.close) { a.emit(0xC7, 0x05); a.dword(state + b.UserHidden); a.dword(1); }
				a.emit(0xC7, 0x46, n.WindowVisibleOffset); a.dword(0); a.call(stop);
				a.emit(0xC7, 0x05); a.dword(state + b.Modal); a.dword(0);
			}
			if (c.action >= 4) {
				a.emit(0xC7, 0x05); a.dword(state + b.Pending); a.dword(1);
			}
			if (Number.isInteger(c.action)) a.call(senders[c.action]);
			a.jmp("base");
		}
		a.label(next);
	}
	a.jmp("base");
	a.label("consumed");
	n.emitMarkDirty(a);
	if (release) a.jmp("base");
	else {
		a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00);
	}
	a.label("base");
	n.emitMarkDirty(a);
	if (release) b.emitReleaseInput(a, state, "up_input");
	else {
		// Only the title bar starts a native drag. Empty body space and disabled
		// controls must never initialize the frame's movement state.
		a.emit(0x83, 0x3D); a.dword(state + b.Modal); a.emit(0); a.jcc(0x85, "done");
		n.emitRectGate(a, 0, 0, b.Width, 22, "done");
		a.emit(0xC7, 0x05); a.dword(state + b.Dragging); a.dword(1);
		a.emit(0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08, 0x8B, 0xCE);
		a.call(n.FrameMouseDown);
	}
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00);
	return a;
};

BattlepassUIStatic.dragMove = function(state, hover)
{
	const n = AutoCombatUI.nativeHelpers, b = BattlepassUIStatic, a = n.asm();
	// Slot 27 (captured movement), not slot 28 (hover), moves UIFrameWnd.
	// Stock checks capture ownership only, then uses the anchors initialized
	// by FrameMouseDown. Our buttons also capture, so explicitly gate it.
	a.emit(0x83, 0x3D); a.dword(state + b.Dragging); a.emit(1); a.jcc(0x85, "done");
	a.emit(0x83, 0x3D); a.dword(state + b.Pressed); a.emit(0); a.jcc(0x85, "done");
	a.emit(0x80, 0x79, n.WindowVisibleOffset, 0); a.jcc(0x84, "done");
	a.jmp(b.FrameDragMove);
	a.label("done"); a.jmp(hover);
	return a;
};

BattlepassUI = function(_)
{
	BattlepassUIStatic.verify();
	const n = AutoCombatUI.nativeHelpers, b = BattlepassUIStatic;
	// Ask before allocating or writing any client code, so Cancel is clean.
	const font = b.getFontSettings();
	b.prepareButtonLayout(font);
	const state = n.allocateBytes(new Array(b.StateSize).fill(0), 4);
	const putText = (key, text) => {
		const bytes = n.asciiBytes(text).slice(0, b.Fields[key][1] - 1);
		bytes.push(0); Exe.SetHex(state.phy + b.Snapshot + b.Fields[key][0], n.bytesToHex(bytes));
	};
	Exe.SetUint32(state.phy + b.Tab, 1);
	putText("mission", "Waiting for Battle Pass data...");
	putText("status", "Connecting to map server");
	putText("primary", "Get New Mission");
	const refs = n.resolvePacketRefs(_);
	const senders = Array.from({length: 19}, (_, action) => n.allocateCode(b.sender(refs, action, state.vir)).vir);
	const timer = n.allocateCode(b.timerProc(state.vir, senders));
	const stop = n.allocateCode(b.stopTimer(state.vir));
	const imports = {
		module: Exe.FindFunc("GetModuleHandleA", "KERNEL32.dll"),
		proc: Exe.FindFunc("GetProcAddress", "KERNEL32.dll")
	};
	if (imports.module < 0 || imports.proc < 0) throw Error("BattlepassUI: required Windows imports not found");
	const strings = {
		user32: n.allocateString("user32.dll").vir,
		setTimer: n.allocateString("SetTimer").vir,
		killTimer: n.allocateString("KillTimer").vir
	};
	const start = n.allocateCode(b.startTimer(state.vir, timer.vir, imports, strings));
	const destroy = n.allocateCode(b.destructor(state.vir, stop.vir));
	const fill = n.allocateCode(n.buildFillRect());
	const hover = n.allocateCode(b.hover(state.vir));
	const scope = n.allocateCode(b.cursorScope(state.vir, hover.vir));
	const art = b.artwork();
	art.scope = scope.vir;
	art.prepareCursorCanvas = n.allocateCode(b.prepareCursorCanvas()).vir;
	art.cursors = ["cursorshover", "cursorsclick"].map(name => art.full(name));
	for (const name of ["cursorshover", "cursorsclick"]) {
		const image = art.read(name);
		if (image.w !== 26 || image.h < 1 || image.h > 22) throw Error("BattlepassUI: unsupported cursor dimensions");
	}
	const draw = n.allocateCode(b.draw(state.vir, fill.vir, font, art));
	const down = n.allocateCode(b.mouse(state.vir, senders, stop.vir, false));
	const up = n.allocateCode(b.mouse(state.vir, senders, stop.vir, true));
	const drag = n.allocateCode(b.dragMove(state.vir, hover.vir));
	const right = n.allocateCode(b.itemRightClick(state.vir, art.resolver));
	const vtable = n.cloneFrameVtable(draw.vir, down.vir, up.vir, destroy.vir, hover.vir);
	Exe.SetUint32(vtable.phy + b.FrameDragMoveSlot * 4, drag.vir);
	Exe.SetUint32(vtable.phy + 32 * 4, right.vir);
	const hitTest = n.allocateCode(b.hitTest());
	Exe.SetUint32(vtable.phy + 50 * 4, hitTest.vir);
	const toggle = n.allocateCode(b.toggle(state.vir, vtable.vir, senders[0], start.vir, stop.vir));
	// Seven bytes covering complete original instructions; other keys retain stock ABI.
	n.assertCode("Battlepass native key dispatcher", b.KeyEvent, "55 8B EC 53 56 8B F1");
	const keyStockAsm = n.asm(); keyStockAsm.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x8B, 0xF1); keyStockAsm.jmp(b.KeyEvent + 7);
	const keyStock = n.allocateCode(keyStockAsm);
	const key = n.allocateCode(b.escapeKey(state.vir, toggle.vir, keyStock.vir));
	Exe.SetJMP(Exe.Vir2Phy(b.KeyEvent, CODE), key.vir); Exe.SetNOPs(Exe.Vir2Phy(b.KeyEvent + 5, CODE), 2);
	const entryVir = n.packetTableEntryVir(b.SnapshotId);
	const entryPhy = Exe.Vir2Phy(entryVir, CODE);
	if (entryPhy < 0) throw Error("BattlepassUI: snapshot dispatch entry is not mapped");
	// The globally owned 0x0BF6 router handles foreign/stock envelopes. Never
	// compete with GachaUI for an independently serialized dispatch-slot write.
	const fallback = n.PacketMainLoopReturn;
	const receive = n.allocateCode(b.receiver(state.vir, fallback, toggle.vir));
	// A dedicated envelope on 0x0BF6 leaves AutoHunt/Pincode's 0x0BEF router untouched.
	n.registerPacket0BF6(_, "bpui", receive.vir);
	// Six bytes covering complete instructions from the unmodified software cursor.
	// Keep a trampoline for all non-Battle-Pass windows and frame-edge cases.
	n.assertCode("Battlepass software cursor", 0xA74410, "55 8B EC 83 EC 5C");
	const cursorStockAsm = n.asm(); cursorStockAsm.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x5C); cursorStockAsm.jmp(0xA74416);
	const cursorStock = n.allocateCode(cursorStockAsm);
	const cursor = n.allocateCode(b.cursorDraw(state.vir, scope.vir, cursorStock.vir));
	Exe.SetJMP(Exe.Vir2Phy(0xA74410, CODE), cursor.vir); Exe.SetNOPs(Exe.Vir2Phy(0xA74415, CODE), 1);
	const contract = {
		buildDate: b.BuildDate, width: b.Width, height: b.Height, font,
		buttonLayouts: b.buttonLayouts, controls: b.controls, abandonLayout: b.abandonLayout,
		canvasWidth: b.Width + b.CursorMargin, hitTestVir: hitTest.vir, frameHitTestVir: b.FrameHitTest,
		prepareCursorCanvasVir: art.prepareCursorCanvas,
		selectionTypeOffset: b.SelectionType, difficultyOffset: b.Difficulty, pendingOffset: b.Pending, requestValueOffset: b.RequestValue, rewardModeOffset: b.RewardMode, rewardPendingOffset: b.RewardPending,
		cursorScopeVir: scope.vir, cursorDrawVir: cursor.vir, cursorStockVir: cursorStock.vir,
		cursorPaintedOffset: b.CursorPainted, cursorXOffset: b.CursorX, cursorYOffset: b.CursorY,
		hoverVir: hover.vir, hoverOffset: b.Hover, modalOffset: b.Modal, quoteTokenOffset: b.QuoteToken, quoteFeeOffset: b.QuoteFee, quoteNonceOffset: b.QuoteNonce,
		userHiddenOffset: b.UserHidden,
		keyEventVir: b.KeyEvent, keyVir: key.vir, keyStockVir: keyStock.vir, escapeHeldOffset: b.EscapeHeld,
		cursorTextures: art.cursors,
		itemResolverVir: art.resolver, iconBlitVir: art.blit,
		itemRightClickVir: right.vir, browsePageOffset: b.BrowsePage, browseTrackOffset: b.BrowseTrack,
		mapScaleVir: art.mapScale, mapPixelsVir: art.mapPixels,
		skinResources: art.resources,
		stateVir: state.vir, vtableVir: vtable.vir, drawVir: draw.vir,
		mouseDownVir: down.vir, mouseUpVir: up.vir, destructorVir: destroy.vir,
		dragMoveVir: drag.vir, draggingOffset: b.Dragging, frameDragMoveVir: b.FrameDragMove,
		toggleVir: toggle.vir, timerVir: timer.vir, startTimerVir: start.vir, stopTimerVir: stop.vir,
		senders, packetRefs: refs, receiverVir: receive.vir, stockVir: fallback, dispatchVir: entryVir,
		packetSize: b.PacketSize, requestId: b.RequestId, snapshotId: b.SnapshotId,
		imports, externalModules: 0
	};
	CACHE.put("BattlepassUI.Contract.v1", contract);
	if (typeof PatchDiagnostics !== "undefined" && typeof PatchDiagnostics.add === "function")
		PatchDiagnostics.add("BattlepassUI.Native", contract);
	console.info("BattlepassUI contract: " + JSON.stringify(contract));
	// Also deploy during direct patch application; a later callback is a no-op.
	BattlepassUI.onApplied();
	return true;
};

BattlepassUI.validate = function()
{
	// Detailed signature errors are reported by verify() when applying the patch.
	return Exe.BuildDate === BattlepassUIStatic.BuildDate;
};

BattlepassUIStatic.onApplied = function()
{
	if (Warp.TestMode)
		return;
	const b = BattlepassUIStatic;
	const source = Warp.Path + "/Assets/BattlepassUI/client";
	const root = System.DirPath(Warp.TgtExe);
	const folders = ["data", "texture", b.uiPrefix(), "battlepassui"];
	const target = root + "/" + folders.join("/");
	const missing = [];
	for (const file of b.ClientAssets)
	{
		// Preserve client-side skin edits; install only absent images.
		const existing = new BinFile(target + "/" + file, 'r');
		const present = existing.Valid;
		existing.Close();
		if (present) continue;
		const asset = new BinFile(source + "/" + file, 'r');
		const available = asset.Valid;
		asset.Close();
		if (!available) throw Error("BattlepassUI: missing bundled image " + source + "/" + file);
		missing.push(file);
	}
	if (missing.length === 0) return;
	// Create every parent beside the selected target EXE, even without data/.
	let directory = root;
	for (const folder of folders)
	{
		directory += "/" + folder;
		if (!System.MkDir(directory)) throw Error("BattlepassUI: cannot create " + directory);
	}
	for (const file of missing)
		if (!System.Copy(source + "/" + file, target + "/" + file, false))
			throw Error("BattlepassUI: cannot copy " + source + "/" + file + " to " + target + "/" + file);
};

BattlepassUI.onApplied = BattlepassUIStatic.onApplied;
