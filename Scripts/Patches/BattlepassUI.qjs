	a.label("draw_done");
	// Clear the cursor margin each frame, including after a move off Close.
	// Never pass the unflipped hand to the old 796px-wide surface.
	a.emit(0x8B, 0xCE); a.call(art.prepareCursorCanvas);
	a.emit(0x85, 0xC0); a.jcc(0x84, "canvas_done");
	a.call(art.scope); a.emit(0x85, 0xC0); a.jcc(0x84, "cursor_done");
	a.emit(0xB8); a.dword(art.cursors[0]);
	a.emit(0x83, 0x3D); a.dword(state + b.Pressed); a.emit(0); a.jcc(0x84, "cursor_ready");
	a.emit(0xB8); a.dword(art.cursors[1]);
	a.label("cursor_ready");
	a.emit(0xFF, 0x35); a.dword(state + b.CursorY); a.emit(0xFF, 0x35); a.dword(state + b.CursorX);
	a.emit(0x50, 0x56); a.call(art.skinBlit);
	for (const [current, painted] of [[b.CursorX, b.PaintedX], [b.CursorY, b.PaintedY]]) {
		a.emit(0xA1); a.dword(state + current); a.emit(0xA3); a.dword(state + painted);
	}
	a.emit(0xC7, 0x05); a.dword(state + b.CursorPainted); a.dword(1);
	a.label("cursor_done");
	n.emitPreserveSurfaceAlpha(a, "battlepass_cursor");
	a.label("canvas_done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

BattlepassUIStatic.controls = [
