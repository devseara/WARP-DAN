	a.emit(0xD3, 0xE0, 0x0F, 0xB7, 0x15); a.dword(state + b.Snapshot + 10); a.emit(0x85, 0xD0); a.jcc(0x84, "start_disabled");
	button("Start Challenge", 458, 445, 160); a.jmp("start_drawn");
