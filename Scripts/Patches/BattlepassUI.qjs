	n.pushImm(a, dialog.y); a.emit(0xFF, 0x35); a.dword(dialog.geometry);
	n.pushImm(a, art.fitPanel(dialog)); a.emit(0x56); a.call(art.skinBlit);
	const dialogText = (pointer, dx, dy, color = 0x00474747, bold = 0, height = font.Body) => {
		for (const arg of [0, bold, color, height, 1, 0, pointer, dialog.y + dy]) n.pushImm(a, arg);
