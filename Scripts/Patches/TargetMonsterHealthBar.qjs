*   Created Date  : 2026-09-05                                             *
*   Last Modified : 2026-09-07                                             *
*                                                                          *
*   Description   : Replace monster nameplates with a native target HUD    *
*					while hovering or attacking. /monsterhp restores the   *
*					stock presentation when off.                           *
*   Target        : 2025-07-16 Ragexe; guarded static hooks, no runtime    *
*                   code patching.                                         *
*                   Generated from tools/build_target_monster_health_bar.py*
*                   See the contract in docs/target-monster-health-bar.md  *
*					for ABI evidence and live acceptance.                  *
\**************************************************************************/
TargetMonsterHealthBar = function(_) {
	if (Exe.BuildDate !== 20250716) throw Error("TargetMonsterHealthBar: requires 2025-07-16");
	const check = (va, hex) => {
		const phy = Exe.Vir2Phy(va);
		if (Exe.GetHex(phy, hex.replace(/ /g, '').length / 2).replace(/ /g, '').toUpperCase() !== hex.replace(/ /g, '').toUpperCase())
			throw Error("TargetMonsterHealthBar: profile mismatch at " + va.toString(16));
	};
	check(0xC76591, "E8 FA 15 DD FF");
	check(0xC6D308, "E8 C3 16 12 00");
	check(0xC6D355, "E8 D6 5E FD FF");
	check(0xC76580, "E8 2B 32 E0 FF");
	check(0x8361B0, "55 8B EC 6A FF 68 D5 C3 E9 00");
	check(0x573750, "55 8B EC 6A FF 68 45 AB E1 00");
	check(0x573980, "55 8B EC 51 56 8B F1");
	check(0xCF33F0, "55 8B EC 8B 89 CC 00 00 00");
	check(0xCA8AA2, "E8 49 A9 04 00");
	check(0xCAC6F0, "9B 8A CA 00");
	check(0x102BEA0, "80 48 85 00");
	check(0xD43414, "8B 97 00 05 00 00");
	check(0xCF3E4C, "88 87 04 03 00 00");
	CustomPacketDispatch.install(`${_}.Info`, ["EXTN"]);
	const ring = CACHE.get("CustomPacketDispatch.Routes").routes.EXTN;
	if (!ring || ring.transport !== "ring-v2") throw Error("TargetMonsterHealthBar: EXTN ring is unavailable");
	const [phy, vir] = Exe.Allocate(4482800, 0x10);
	Exe.SetHex(phy, "00 ".repeat(4482800).trim());
	for (const [off, hex] of [[0, "FF 74 24 04 E8 87 7B A4 FE 9C 60 89 35 E0 E0 00 02 C7 05 E4 E0 00 02 00 00 00 00 81 3E B8 04 09 01 75 14 85 C0 75 10 85 DB 75 0C 85 FF 74 08 8B 47 18 A3 E4 E0 00 02 89 F1 E8 C2 00 00 00 61 9D C2 04 00"], [53248, "39 0D 00 E0 00 02 75 0A C7 05 00 E0 00 02 00 00 00 00 E9 19 ED 82 FE"], [37376, "55 89 E5 83 EC 20 53 56 57 89 55 E0 8D 75 FF C6 06 00 BB 0A 00 00 00 31 C9 31 D2 F7 F3 80 C2 30 4E 88 16 41 85 C0 74 0D 83 F9 03 75 EC 4E C6 06 2C 31 C9 EB E4 8B 7D E0 AC AA 84 C0 75 FA 8B 45 E0 5F 5E 5B 89 EC 5D C3"], [37888, "31 D2 85 C0 74 15 80 B8 98 00 00 00 01 75 0C 8B 90 94 00 00 00 85 D2 79 02 31 D2 39 15 20 55 44 02 74 10 89 15 20 55 44 02 C7 05 0C E0 00 02 01 00 00 00 C3"], [38400, "55 89 E5 83 EC 20 53 56 57 8B 75 08 83 3D 20 55 44 02 00 0F 84 95 01 00 00 FF 35 20 55 44 02 68 C8 0E 09 01 68 50 55 44 02 E8 22 02 52 FE 83 C4 0C E8 1A 6D A8 FE 89 C7 85 FF 0F 84 6E 01 00 00 68 50 55 44 02 89 F9 E8 B4 4E A8 FE 84 C0 0F 84 5A 01 00 00 68 50 55 44 02 E8 D2 59 A9 FE 83 C4 04 85 C0 0F 84 45 01 00 00 50 89 F9 E8 2F 3E A8 FE 85 C0 0F 84 35 01 00 00 89 C3 8B 83 14 01 00 00 83 F8 01 0F 82 24 01 00 00 83 F8 40 0F 87 1B 01 00 00 89 45 FC 8B 83 18 01 00 00 83 F8 01 0F 82 09 01 00 00 83 F8 40 0F 87 00 01 00 00 89 45 F8 68 80 53 44 02 68 D0 56 44 02 68 50 56 44 02 E8 8B 01 52 FE 83 C4 0C 6A 00 6A 00 6A 0C 6A 01 6A 00 68 50 56 44 02 89 F1 E8 B2 85 A1 FE 89 45 F4 03 45 FC 3D 00 03 00 00 0F 87 BF 00 00 00 BA 00 03 00 00 29 C2 D1 FA 89 15 2C 55 44 02 03 55 F4 89 55 F0 B8 0C 00 00 00 2B 45 F8 D1 F8 03 45 0C 85 C0 0F 88 95 00 00 00 89 45 EC 03 45 F8 3D E8 00 00 00 0F 87 84 00 00 00 6A 04 FF 75 0C 68 50 56 44 02 56 E8 C6 A8 FF FF 6A 01 53 FF 75 EC FF 75 F0 89 F1 E8 16 3B A1 FE 8B 46 24 85 C0 74 6D C6 40 28 01 8B 78 18 85 FF 74 62 8B 45 EC 69 C0 00 03 00 00 03 45 F0 8D 3C 87 8B 55 F8 8B 4D FC 8B 07 25 FF FF FF 00 3D FF 00 FF 00 74 13 83 3F 00 74 14 80 7F 03 00 75 0E 81 0F 00 00 00 FF EB 06 C7 07 00 00 00 00 83 C7 04 49 75 D3 B8 00 03 00 00 2B 45 FC 8D 3C 87 4A 