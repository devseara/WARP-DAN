		[0x0012E5,  1, 0x02445400],
		[0x0012F0,  1, 0x02445400],
		[0x005B05, -1, 0xFED88EC7],
		[0x005B1A, -1, 0xFE688F52],
		[0x005B4F,  1, 0x024456F0],
		[0x005B5A, -1, 0xFE4EBDE2],
		[0x005B61,  1, 0x024456F0],
		[0x005B6C, -1, 0xFE4EBDD0],
		[0x009E05, -1, 0xFEC39427],
		[0x009E1A, -1, 0xFE684C52],
		[0x009E38,  1, 0x0200F000],
		[0x009E41,  1, 0x0200F004],
	]))
		Exe.SetUint32(phy + off, (original + sign * delta) >>> 0);
	Exe.SetUint32(phy + 0xE0C0, ring.blockVir);
	Exe.SetHex(phy + 0xE0FC, Exe.GetHex(Exe.Vir2Phy(0x102BE4C), 4));
	Exe.SetHex(phy + 0xE100, Exe.GetHex(Exe.Vir2Phy(0x102BE50), 0xD4));
	Exe.SetUint32(phy + 0xE100, vir + 0xD000);
	Exe.SetUint32(phy + 0xE150, vir + 0x1000);
	AutoHook(Exe.Vir2Phy(0xCA8AA2), "E9" + Filler(1), {isCall: true, targets: {1: vir + 0x2900}});
	AutoHook(Exe.Vir2Phy(0xC76591), "E9" + Filler(1), {isCall: true, targets: {1: vir}});
	AutoHook(Exe.Vir2Phy(0xC6D308), "E9" + Filler(1), {isCall: true, targets: {1: vir + 0x5B00}});
	AutoHook(Exe.Vir2Phy(0xC6D355), "E9" + Filler(1), {isCall: true, targets: {1: vir + 0x9E00}});
	return true;
};
