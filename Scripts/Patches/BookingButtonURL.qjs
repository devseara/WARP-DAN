*   Description   : Reuses the Basic Info Booking button on the             *
*                   2025-07-16 client to open a custom URL instead of      *
*                   sending the custom packet; packet mode is disabled     *
*                   when this URL mode is selected.                        *
*                                                                          *
\**************************************************************************/

///
/// \brief Reuse the Basic Info "Booking" button by opening a custom URL in
///        the user's default browser. This is the URL-mode counterpart to
///        BookingButtonGuide.
///
BookingButtonURL = function(_)
{
	const urlVarName = '$bookingBtnURL';
	const url = Exe.GetUserInput(
		urlVarName,
		D_Text,
		"Booking Button URL",
		"Enter the URL to open when Booking button is clicked",
		"https://example.com/",
		{minLen: 8, maxLen: 255, saveDefault: true}
	);
	if (url === false)
		Cancel("No Booking URL entered");

	if (!Warp.TestMode)
		Warp.SetPatchState('BookingButtonGuide', false);

	const hoverVarName = '$bookingBtnURLHover';
	const hoverText = Exe.GetUserInput(
		hoverVarName,
		D_Text,
		"Booking Button URL Hover",
		"Enter the hover label to show for the Booking URL button",
		"Booking",
		{minLen: 1, maxLen: 60, saveDefault: true}
	);
	if (hoverText === false)
		Cancel("No Booking URL hover label entered");

	const [, urlAddr] = Exe.AddFromVar(urlVarName);
	const [, openAddr] = Exe.AddText("open");
	const [, hoverAddr] = Exe.AddFromVar(hoverVarName);
	const hoverLen = hoverText.length;
	if (hoverLen <= 0)
		throw Error("Booking URL hover label is empty");

	$$(_, 2.1, `Find ShellExecuteA import`)
	const shellExecIA = Exe.FindFunc("ShellExecuteA", "SHELL32.dll");
	if (shellExecIA < 0)
		throw Error("ShellExecuteA import not found");

	$$(_, 3.3, `Resolve Booking button ID`)
	const targetID = NewBasicButton.getID(_, NewBasicButton.BookingButtonIdx, "Booking");

	$$(_, 4.1, `Register Booking URL hover label`)
	NewBasicButtonHover.registerText(_, targetID, hoverAddr, hoverLen);

	NewBasicButton.ensureVisible(_, targetID);

	$$(_, 5.1, `Register Booking URL click action`)
	NewBasicButtonClick.registerURL(_, targetID, urlAddr, shellExecIA, openAddr);

	return true;
};

///
/// \brief Disable for unsupported clients.
///
BookingButtonURL.validate = function()
{
	return NewBasicButtonClick.validateURL();
};

BookingButtonURL.cleanup = function(patchName)
{
	NewBasicButtonHover.unregister(patchName);
	NewBasicButtonClick.unregister(patchName);
};
