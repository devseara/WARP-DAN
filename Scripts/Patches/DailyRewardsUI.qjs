/*
 * Author: DevSeara.
 * Description: Replaces the existing Attendance menu action with a native
 * Attendance / Daily Quest / Daily Roll window on 2025-07-16 Ragexe.
 * DRUI v1/v2 use independent server state, 0BF8 requests and a magic-gated
 * variable-length 0BF4 receive envelope. Stock quest replies pass through.
 * No external DLL, Lua replacements, new menu child, or Battle Pass changes.
 */
DailyRewardsUI = function(_)
{
	if(!DailyRewardsUI.validate())throw Error("DailyRewardsUI requires 2025-07-16 Ragexe");
	const n=AutoCombatUI.nativeHelpers;
	const read=path=>{const f=new BinFile(path,"r");if(!f.Valid)throw Error("DailyRewardsUI: missing "+path);const h=f.ReadHex();f.Close();return(h.match(/[0-9a-fA-F]{2}/g)||[]).map(v=>parseInt(v,16));};
	const u32=(b,o)=>(b[o]|b[o+1]<<8|b[o+2]<<16|b[o+3]<<24)>>>0;
	const put=(b,o,v)=>{for(let i=0;i<4;++i)b[o+i]=v>>>(i*8)&255;};
	const bytes=read(Warp.Path+"/Inputs/DailyRewardsUI/runtime.bin"),meta=JSON.parse(String.fromCharCode(...read(Warp.Path+"/Inputs/DailyRewardsUI/runtime.json")));
	const size=u32(bytes,8),count=u32(bytes,12),api=u32(bytes,16),start=32+count*4;
	let crc=0xFFFFFFFF;for(let i=32;i<bytes.length;++i){crc^=bytes[i];for(let j=0;j<8;++j)crc=(crc>>>1)^((crc&1)?0xEDB88320:0);}
	if(bytes.length<32 || u32(bytes,0)!==0x49555244 || u32(bytes,4)!==2 || meta.version!==2 || meta.client!==20250716 ||
		start+size!==bytes.length || size!==meta.size || api!==meta.exports.DailyApi || meta.api_size!==44 || api+44>size || u32(bytes,20)!==44 || u32(bytes,24)!==5268 || ((crc^0xFFFFFFFF)>>>0)!==u32(bytes,28))throw Error("DailyRewardsUI: invalid payload");
	const names=["DailyApi","DailyState","_DailyToggle@0","_DailyReceive@4","_DailyHit@8","@DailyDraw@8","@DailyDown@16","@DailyUp@16","@DailyMove@16","@DailyDrag@16","@DailyCursor@16","@DailyDestroy@12","_DailyTick@16","@DailyRightDown@16","@DailyRightUp@16","@DailyWheel@12"];
	if(!Number.isInteger(meta.exports["_BestiaryPreview@32"]) || meta.exports["_BestiaryPreview@32"]<0 || meta.exports["_BestiaryPreview@32"]>=size)throw Error("DailyRewardsUI: missing monster renderer");
	for(const name of names)if(!Number.isInteger(meta.exports[name]) || meta.exports[name]<0 || meta.exports[name]>=size)throw Error("DailyRewardsUI: missing "+name);
	// This is the native Attendance command's complete 0A68/type=5 send arm.
	// Both Classic and New menu layouts dispatch this same native command.
	n.assertCode("Attendance menu sender",0x814EBD,"B8 68 0A 00 00 C6 45 12 05 66 89 45 10 E8 91 FE 3F 00");
	n.assertCode("Attendance menu return",0x814EEE,"E9 D9 FB FF FF");
	n.assertCode("DRUI variable receive registration",0xAA67D3,"6A 00 6A 04 6A FF 68 F4 0B 00 00 8B CE E8 4B 97 FF FF");
	for(const [name,va,hex] of [["monster view resolver",0xD5BB40,"55 8B EC 8B 55 08 83 EC 0C 56 57 8B F9"],["frame ctor",n.FrameConstructor,"55 8B EC 6A FF 68 F9 45 EA 00"],["frame drag",0x880E00,"55 8B EC 83 EC 1C 53 8B D9"],
		["bring to front",0xA39130,"55 8B EC 51 56 57 8B 7D 08 8B F1 85 FF"],
		["CItem ctor",0x6A1B20,"55 8B EC 6A FF 68 8B 54 E5 00"],["CItem destructor",0x5A4300,"55 8B EC 6A FF 68 8B 33 E2 00"]])n.assertCode("DailyRewardsUI "+name,va,hex);
	for(const [slot,expected] of [[0,n.FrameDeletingDestructor],[20,n.FrameVtableDraw],[25,n.FrameMouseDown],[27,0x880E00],[31,n.FrameMouseUp],[32,0x5A8A50],[33,0x5A8A60],[35,0x5A8AF0]])n.assertVtableSlot("DailyRewardsUI frame",slot,expected);
	const entry=n.packetTableEntryVir(0xBF4),entryPhy=Exe.Vir2Phy(entry,CODE),fallback=Exe.GetUint32(entryPhy);
	if(entryPhy<0 || Exe.Vir2Phy(fallback,CODE)<0)throw Error("DailyRewardsUI: quest status receive profile changed");
	const code=bytes.slice(start),[phy,vir]=Exe.Allocate(size,16);
	for(let i=0;i<count;++i){const off=u32(bytes,32+i*4);if(off+4>size || u32(code,off)>=size)throw Error("DailyRewardsUI: invalid relocation");put(code,off,u32(code,off)+vir);}
	const e=name=>vir+meta.exports[name];
	const table=n.allocateBytes(new Array(4+n.FrameVtableEntries*4).fill(0),4);Exe.SetHex(table.phy,Exe.GetHex(Exe.Vir2Phy(n.FrameVtable-4),table.size));
	for(const [slot,name] of [[0,"@DailyDestroy@12"],[20,"@DailyDraw@8"],[25,"@DailyDown@16"],[27,"@DailyDrag@16"],[28,"@DailyMove@16"],[30,"@DailyCursor@16"],[31,"@DailyUp@16"],[32,"@DailyRightDown@16"],[33,"@DailyRightUp@16"],[35,"@DailyWheel@12"]])Exe.SetUint32(table.phy+4+slot*4,e(name));
	const refs=n.resolvePacketRefs(),fit=n.allocateCode(VipUI.nativeDrawing.fit());
	const art={resolver:n.allocateCode(n.buildItemIconResolver()).vir,blit:n.allocateCode(n.buildColorKeyBlit()).vir,format:n.buildResourcePath("item\\%s.bmp").vir,path:n.allocateBytes(new Array(512).fill(0),4).vir};
	const item=n.allocateCode(VipUI.nativeDrawing.item(art)),describe=n.allocateCode(VipUI.nativeDrawing.describe(art.resolver));
	const moduleIat=Exe.FindFunc("GetModuleHandleA","KERNEL32.dll"),procIat=Exe.FindFunc("GetProcAddress","KERNEL32.dll");
	if(moduleIat<0 || procIat<0)throw Error("DailyRewardsUI: timer imports unavailable");
	const center=n.allocateCode(VipUI.nativeDrawing.fit(11,true));
	const monster=n.allocateCode(BestiaryUI.nativeDrawing.monster(e("_BestiaryPreview@32")));
	[2,table.vir+4,refs.packetCtorA,refs.packetSend,fit.vir,item.vir,describe.vir,moduleIat,procIat,center.vir,monster.vir].forEach((v,i)=>put(code,api+i*4,v));
	for(let i=0;i<code.length;i+=4096)Exe.SetHex(phy+i,n.bytesToHex(code.slice(i,i+4096)));
	const menu=n.asm();menu.emit(0x9C,0x60);menu.call(e("_DailyToggle@0"));menu.emit(0x61,0x9D);menu.jmp(0x814ACC);
	const launcher=n.allocateCode(menu);Exe.SetJMP(Exe.Vir2Phy(0x814EBD,CODE),launcher.vir);
	const a=n.asm();a.emit(0x9C,0x60,0xBE);a.dword(n.PacketBuffer);
	a.emit(0x66,0x83,0x7E,2,8);a.jcc(0x82,"stock");a.emit(0x81,0x7E,4);a.dword(0x49555244);a.jcc(0x85,"stock");
	a.emit(0x66,0x81,0x7E,2);a.word(3308);a.jcc(0x84,"receive");
	a.emit(0x66,0x81,0x7E,2);a.word(5268);a.jcc(0x85,"done");a.label("receive");a.emit(0x56);a.call(e("_DailyReceive@4"));
	a.label("done");a.emit(0x61,0x9D);a.jmp(n.PacketMainLoopReturn);
	a.label("stock");a.emit(0x61,0x9D);a.jmp(fallback);
	const receiver=n.allocateCode(a);Exe.SetUint32(entryPhy,receiver.vir);
	const record=[];for(const v of [n.allocateString("DailyRewardsUI.v2").vir,...names.map(e),receiver.vir,launcher.vir,fallback])record.push(v&255,v>>>8&255,v>>>16&255,v>>>24);n.allocateBytes(record,4);
	return true;
};
DailyRewardsUI.validate=()=>Exe.BuildDate===20250716;
