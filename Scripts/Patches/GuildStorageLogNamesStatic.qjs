GuildStorageLogNamesStatic.install=function(state,routes)
{
	if(ExtNameTextStatic.ActiveBuildDate!==20250716||state.guildStorageLogNames128)return state;
	const profile=GuildStorageLogNamesStatic.Profile,edits=[],hooks=[];
	const h=(va,old,a)=>hooks.push([ExtNameStaticAsm.assertCode("guild log inline128",va,old),old.split(" ").length,ExtNameTextStatic.allocateCode(a)]);
	for(const e of profile.edits)edits.push([ExtNameStaticAsm.assertCode("guild log field",e[0],e[1]),e[2]]);
	for(const b of profile.bridges){
		const a=ExtNameStaticAsm.asm(),labels=new Set(b[2].map(i=>i.pc));
		for(const i of b[2]){
			a.label("pc"+i.pc);const target=labels.has(i.target)?"pc"+i.target:i.target;
			if(i.kind==="raw")a.emit(...i.bytes.split(" ").map(v=>parseInt(v,16)));
			else if(i.kind==="call")a.call(target);
			else if(i.kind==="jmp")a.jmp(target);
			else a.jcc(0x80|i.cond,target);
		}a.jmp(b[3]);h(b[0],b[1],a);
	}
	const copy=ExtNameTextStatic.allocateCode(ExtNameTextStatic.buildCopyZ());
	for(let i=0;i<profile.special.length;i++){
		const s=profile.special[i];
		if(i<4){edits.push([ExtNameStaticAsm.assertCode("remove obsolete guild log temporary",s[0],s[1]),s[1].split(" ").map(()=>"90").join(" ")]);continue;}
		const a=ExtNameStaticAsm.asm(),name=(i&1)===0,base=i<6?-0x600:-0x700;
		a.emit(0x68);a.dword(name?128:24);a.emit(0x8D,0x87);a.dword(name?40:168);a.emit(0x50,0x8D,0x85);a.dword(base+(name?9:137));a.emit(0x50);a.call(copy.virAddr);a.jmp(s[2]);h(s[0],s[1],a);
	}
	// A log row is {id,amount,action,name128,time24,pad3,itemTitleString24,...}.
	// Its constructor initializes the real array; there is no secondary alias.
	let a=ExtNameStaticAsm.asm();a.emit(0x57,0x8B,0xF9,0x8B,0xD1,0x33,0xC0,0xB9);a.dword(220);a.emit(0xF3,0xAA,0xC7,0x82);a.dword(184);a.dword(15);a.emit(0x8B,0xC2,0x5F,0xC3);
	h(0x00C997A0,"55 8B EC 6A FF",a);
	const move=ExtNameStaticAsm.asm();move.emit(0x56,0x57,0x8B,0x74,0x24,12,0x8B,0xF9,0x8B,0xD1,0xB9);move.dword(55);move.emit(0xF3,0xA5,0xC7,0x46,0xD8);move.dword(0);move.emit(0xC7,0x46,0xDC);move.dword(15);move.emit(0xC6,0x46,0xC8,0,0x8B,0xC2,0x5F,0x5E,0xC2,4,0);
