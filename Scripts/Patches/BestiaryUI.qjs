BestiaryUI = function(_) {
	const b=BestiaryNative,c=b.ui();b.emissions=[];
	if(Exe.BuildDate!==20250716||!c)throw Error("BestiaryUI requires 2025-07-16 native helpers");
	c.verifyNativeContracts();
	c.assertCode("Bestiary ProcessPushButton",0xA449A0,"55 8B EC 8B 45 08 53 83 C0 F7 56 8B F1");
	c.assertCode("Bestiary frame SendMsg",0x8841D0,"55 8B EC 8B 55 0C 8B C2 83 E8 00");
	c.assertCode("Bestiary CItem constructor",0x6A1B20,"55 8B EC 6A FF 68 8B 54 E5 00");
	c.assertCode("Bestiary CItem numeric identity",0x6A6570,"55 8B EC 83 EC 14 A1 24 B9 22 01");
	c.assertCode("Bestiary native string destructor",0x4F08F0,"55 8B EC 6A FF 68 F0 DB E0 00");
	c.assertCode("Bestiary description factory",0xA39340,"55 8B EC 6A FF 68 07 F0 EE 00");
	if(Exe.GetUint32(Exe.Vir2Phy(c.FrameVtable)+37*4)!==0x8841D0)throw Error("Bestiary frame message slot changed");
