BestiaryUI.validate=function(){return Exe.BuildDate===20250716;};
BestiaryUI.onApplied=function(){
	if(Warp.TestMode)return;
	const target=System.DirPath(Warp.TgtExe)+"/data/texture/bestiary/journal";
	if(!System.MkDir(target))throw Error("Bestiary: cannot create journal resource directory");
	for(const file of BestiaryNative.AssetFiles)
		if(!System.Copy(Warp.Path+"Images/BestiaryUI/journal/"+file,target+"/"+file,true))throw Error("Bestiary: failed to deploy "+file);
};
BestiaryUI.cleanup=function(_){
	const c=BestiaryNative.ui(),m=CACHE.get("BestiaryUI.Native.v1");
	if(m&&m.route){
		c.beginSharedPacketRoute(_||"BestiaryUI");
		Exe.SetUint32(m.route.fallbackCellPhy,m.fallback);
		c.endSharedPacketRoute(_||"BestiaryUI");
	}
	const key="CustomSlashCommand.RegistryByOwner",owners=CACHE.get(key)??{};delete owners.BestiaryUI;CACHE.put(key,owners);
	CustomSlashCommand.refresh(_||"BestiaryUI");CACHE.put("BestiaryUI.Native.v1",null);
};

