BestiaryNative.buildJournalMouse = function(s,p,sender,kind,itemDetail,m) {
	const b=BestiaryNative,c=b.ui(),a=c.asm(),store=(off,v)=>b.store(a,s+off,v),gate=(r,l)=>c.emitRectGate(a,r[0],r[1],r[0]+r[2],r[1]+r[3],l);
	const controls=[{id:5,r:[177,30,58,20],monster:true},{id:4,r:[435,30,61,20]},{id:60,r:[19,477,157,20],other:true},{id:1,r:[740,0,19,24]},{id:2,r:[14,59,160,21],monster:true},{id:3,r:[14,86,160,20],monster:true}];
	for(let i=0;i<4;i++)controls.push({id:120+i,r:[19+i*116,117,112,23],other:true,personal:true});
	for(let i=0;i<6;i++)controls.push({id:140+i,r:[19+(i%2)*365,154+Math.floor(i/2)*82,357,76],other:true,personal:true});
	controls.push({id:130,r:[390,477,110,20],other:true,personal:true},{id:131,r:[506,477,132,20],other:true,personal:true},{id:132,r:[620,477,121,20],other:true,personal:true},{id:133,r:[260,477,110,20],other:true,personal:true},{id:134,r:[692,433,21,20],other:true,personal:true},{id:135,r:[718,433,21,20],other:true,personal:true});
	for(let i=0;i<3;i++)controls.push({id:10+i,r:[506+i*81,30,79,20]},{id:20+i,r:[190+i*84,327,82,20],monster:true});
	for(let i=0;i<3;i++)controls.push({id:70+i,r:[286+i*81,350,79,20],monster:true,info:true});
	for(let i=0;i<4;i++)controls.push({id:80+i,r:[192+(i%2)*279,353+Math.floor(i/2)*54,273,50],monster:true,drop:i});
	for(let i=0;i<6;i++)controls.push({id:100+i,r:[12,112+i*54,164,52],monster:true,row:i});
	controls.push({id:30,r:[14,475,240,20],monster:true},{id:31,r:[663,475,88,20],monster:true},
		{id:40,r:[14,444,23,18],page:[12,26,-1],monster:true},{id:41,r:[150,444,23,18],page:[12,26,1],monster:true},
		{id:42,r:[703,327,19,18],page:[132,42,-1],monster:true},{id:43,r:[725,327,19,18],page:[132,42,1],monster:true},
		{id:44,r:[705,79,18,16],page:[136,48,-1],monster:true},{id:45,r:[726,79,18,16],page:[136,48,1],monster:true},
		{id:50,r:[692,110,55,20],monster:true},{id:51,r:[692,167,55,20],monster:true});
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x57,0x8B,0xF1,0x8B,0x5D,8,0x8B,0x55,12);
	if(kind==="down"){
		store(68,0);a.emit(0x83,0x3D);a.dword(s+208);a.emit(1);a.jcc(0x85,"noFilterPopup");
		for(const [j,off,max] of [[0,216,13],[1,220,4],[2,224,4],[3,228,3],[4,232,6]]){
			gate([277,85+j*31,222,24],"filterCycle"+j);a.emit(0xA1);a.dword(s+off);a.emit(0x40,0x83,0xF8,max);a.jcc(0x82,"filterStore"+j);a.emit(0x33,0xC0);a.label("filterStore"+j);a.emit(0xA3);a.dword(s+off);a.jmp("done");a.label("filterCycle"+j);
		}
		gate([193,253,143,24],"filterCancel");
		for(const [off,src] of [[168,216],[172,220],[176,224],[180,228],[212,232]]){a.emit(0xA1);a.dword(s+src);a.emit(0xA3);a.dword(s+off);}
		for(const [i,min,max] of [[0,0,65535],[1,1,50],[2,51,100],[3,101,150],[4,151,200],[5,201,65535]]){
			a.emit(0x83,0x3D);a.dword(s+212);a.emit(i);a.jcc(0x85,"level"+i);store(184,min);store(188,max);a.label("level"+i);
		}
		store(208,0);store(12,0);store(132,0);store(136,0);b.request(a,s,sender,3,0,0);a.jmp("done");
		a.label("filterCancel");gate([346,253,151,24],"done");store(208,0);
		a.jmp("done");
		a.label("noFilterPopup");a.emit(0x83,0x3D);a.dword(s+124);a.emit(1);a.jcc(0x85,"normal");store(124,0);
		for(let i=0;i<b.Elements.length;i++){
			gate([14,107+i*19,160,19],"pick"+i);store(120,i);store(12,0);store(132,0);store(136,0);b.request(a,s,sender,3,0,0);a.jmp("done");a.label("pick"+i);
		}
		a.jmp("done");a.label("normal");
		for(const q of controls){
			if(q.id===123 || q.id===132){a.emit(0x83,0x3D);a.dword(s+4);a.emit(2);a.jcc(0x85,"down"+q.id);}
			if(q.id===130 || q.id===131){a.emit(0x83,0x3D);a.dword(s+4);a.emit(1);a.jcc(0x85,"down"+q.id);}
			if(q.other){a.emit(0x83,0x3D);a.dword(s+4);a.emit(0);a.jcc(0x84,"down"+q.id);}
			if(q.drop!==undefined){a.emit(0x83,0x3D);a.dword(s+140);a.emit(0);a.jcc(0x85,"down"+q.id);}
			if(q.info){a.emit(0x83,0x3D);a.dword(s+140);a.emit(1);a.jcc(0x85,"down"+q.id);}
			if(q.monster){a.emit(0x83,0x3D);a.dword(s+4);a.emit(0);a.jcc(0x85,"down"+q.id);}
			gate(q.r,"down"+q.id);store(68,q.id);a.jmp("done");a.label("down"+q.id);
		}
		gate([0,0,740,25],"done");a.emit(0xFF,0x75,12,0xFF,0x75,8,0x8B,0xCE);a.call(c.FrameMouseDown);
	}else if(kind==="up"){
		a.emit(0x8B,0x3D);a.dword(s+68);store(68,0);
		for(const q of controls){
			a.emit(0x81,0xFF);a.dword(q.id);a.jcc(0x85,"up"+q.id);gate(q.r,"done");
			if(q.id===1){b.clearFocus(a,s,"closeFocus");b.releaseCapture(a,s,"closeCapture");store(124,0);store(152,0);a.emit(0xC6,0x46,0x28,0);}
			else if(q.id===2){a.emit(0xFF,0x35);a.dword(s+116);a.emit(0xB9);a.dword(c.WindowManager);a.call(c.WindowManagerSetFocusEdit);}
			else if(q.id===5){b.clearFocus(a,s,"filterFocus");store(124,0);store(208,1);
				for(const [off,src] of [[216,168],[220,172],[224,176],[228,180],[232,212]]){a.emit(0xA1);a.dword(s+src);a.emit(0xA3);a.dword(s+off);}}
			else if(q.id===4){a.emit(0x83,0x3D);a.dword(s+156);a.emit(0);a.jcc(0x84,"done");b.clearFocus(a,s,"reloadFocus");store(124,0);b.request(a,s,sender,6);}
			else if(q.id===3){b.clearFocus(a,s,"dropdownFocus");store(124,1);}
			else if(q.id>=10&&q.id<=12 || q.id===31 || q.id===60){
				const tab=q.id===60?0:q.id===31?1:q.id-10;b.clearFocus(a,s,"tabFocus"+q.id);store(4,tab);store(124,0);store(208,0);a.emit(0xA1);a.dword(s+116);a.emit(0x85,0xC0);a.jcc(0x84,"edit"+q.id);a.emit(0xC6,0x40,0x28,tab===0?1:0);a.label("edit"+q.id);
				if(tab>0){b.store(a,m.personalState.vir+4,0);b.store(a,m.personalState.vir+8,0);a.emit(0xA1);a.dword(s+28);a.emit(0xA3);a.dword(m.personalState.vir+24);b.personalRequest(a,m);}
			}else if(q.personal){
				const ps=m.personalState.vir,pp=m.personalPayload.vir;
				if(q.id>=120 && q.id<=123){b.store(a,ps+4,q.id-120);b.store(a,ps+8,0);b.personalRequest(a,m);}
				else if(q.id===133){b.personalRequest(a,m,5);}
				else{
					a.emit(0x83,0x3D);a.dword(ps+12);a.emit(0);a.jcc(0x85,"done");a.emit(0x83,0x3D);a.dword(ps+16);a.emit(1);a.jcc(0x85,"done");
					a.emit(0x83,0x3D);a.dword(pp+20);a.emit(0);a.jcc(0x85,"done");a.emit(0xF6,0x05);a.dword(pp+38);a.emit(4);a.jcc(0x85,"done");
					if(q.id===130 || q.id===131)b.personalRequest(a,m,q.id===130?3:4);
					else if(q.id===132)b.personalRequest(a,m,2,0);
					else if(q.id===134 || q.id===135){a.emit(0xA1);a.dword(ps+8);if(q.id===134){a.emit(0x85,0xC0);a.jcc(0x84,"done");a.emit(0x48);}else{a.emit(0x40,0x0F,0xB7,0x0D);a.dword(pp+34);a.emit(0x3B,0xC1);a.jcc(0x83,"done");}a.emit(0xA3);a.dword(ps+8);b.personalRequest(a,m);}
					else{
						const i=q.id-140,row=pp+512+i*256;a.emit(0x66,0x83,0x3D);a.dword(pp+36);a.emit(i);a.jcc(0x86,"done");
						a.emit(0x83,0x3D);a.dword(s+4);a.emit(2);a.jcc(0x85,"personalSelect"+i);
						a.emit(0xA1);a.dword(row+8);a.emit(0xA8,2);a.jcc(0x84,"personalTitle"+i);a.emit(0xFF,0x35);a.dword(row);c.pushImm(a,1);a.call(m.personalSender.vir);a.jmp("done");
						a.label("personalTitle"+i);a.emit(0xA8,8);a.jcc(0x84,"done");a.emit(0xFF,0x35);a.dword(row);c.pushImm(a,6);a.call(m.personalSender.vir);a.jmp("done");
						a.label("personalSelect"+i);a.emit(0x83,0x3D);a.dword(ps+4);a.emit(0);a.jcc(0x84,"done");a.emit(0xA1);a.dword(row);a.emit(0x83,0x3D);a.dword(ps+4);a.emit(1);a.jcc(0x85,"personalSubject"+i);a.emit(0xA1);a.dword(row+12);a.label("personalSubject"+i);a.emit(0xA3);a.dword(ps+24);b.store(a,ps+4,0);b.store(a,ps+8,0);b.personalRequest(a,m);
					}
				}
			}else if(q.info)store(204,q.id-70);
			else if(q.id>=20&&q.id<=22)store(140,q.id-20);
