/*
	* Description   : Adds a 760x500 native Bestiary journal to 2025-07-16
	*                 Ragexe. BSUI v3 catalogs come from the resolved server
	*                 mob database, with native SPR/ACT, ItemId icons and real
	*                 map thumbnails. Shares Collection's native edit and
	*                 post-reader 0x0BEF router without a DLL or renderer hook.
	*/
const BestiaryNative = {
	WindowId:0x3FA, DrawSprite:0xA1DC80, ResourceExists:0xA8E500,
	Magic:0x49555342, DetailTab:140, Tracked:144, StateSize:244, CacheEntries:64, CacheStride:5228, RequestSize:128, SnapshotSize:5120, CacheKeySize:108,
	Elements:["All","Neutral","Water","Earth","Fire","Wind","Poison","Holy","Shadow","Ghost","Undead"],
	ui:function(){return ItemCollectionUI.nativeFrameV1;}
};
// Writes are restricted to newly allocated storage. Original code is changed
// through the shared slash/packet routes and a byte-guarded Escape entry hook.
// The documented SetHexSafe wrapper is absent in this checkout; verify the
// allocation mapping; the build verifier checks every emitted byte in the PE.
BestiaryNative.alloc = function(bytes, alignment = 4) {
	const c = BestiaryNative.ui();
	const [phy, vir] = Exe.Allocate(bytes.length, alignment);
	if (phy < 0 || vir <= 0 || Exe.Vir2Phy(vir) !== phy)
		throw Error("BestiaryUI: invalid allocation");
	const hex = c.bytesToHex(bytes);
	Exe.SetHex(phy, hex);
	BestiaryNative.emissions.push({vir, hex});
	return {phy, vir, size: bytes.length};
};
BestiaryNative.code = function(a) {
	const [phy, vir] = Exe.Allocate(a.bytes.length, 16);
	if (phy < 0 || vir <= 0 || Exe.Vir2Phy(vir) !== phy)
		throw Error("BestiaryUI: invalid code allocation");
	const hex = a.finish(vir);
	Exe.SetHex(phy, hex);
	BestiaryNative.emissions.push({vir, hex});
	return {phy, vir, size: a.bytes.length};
};
BestiaryNative.store = function(a, address, value) {
	a.emit(0xC7, 0x05); a.dword(address); a.dword(value);
};
BestiaryNative.releaseCapture = function(a, state, label) {
	const c = BestiaryNative.ui();
	a.emit(0xB9); a.dword(c.WindowManager); a.call(c.WindowCaptureGet);
	a.emit(0x3B, 0x05); a.dword(state + c.StateWindow); a.jcc(0x85, label);
	a.emit(0xB9); a.dword(c.WindowManager); a.call(c.WindowCaptureRelease);
	a.label(label);
};
BestiaryNative.clearFocus = function(a, state, label) {
	const c = BestiaryNative.ui();
	a.emit(0xB9); a.dword(c.WindowManager); a.call(c.WindowManagerGetFocusEdit);
	a.emit(0x85, 0xC0); a.jcc(0x84, label);
	a.emit(0x3B, 0x05); a.dword(state + c.StateSearchEdit); a.jcc(0x85, label);
	c.pushImm(a, 0); a.emit(0xB9); a.dword(c.WindowManager); a.call(c.WindowManagerSetFocusEdit);
	a.label(label);
	BestiaryNative.store(a, state + c.StateSearchFocused, 0);
};


/* Native BSUI v3 transport and resource adapters. */
// The cache owns copied, validated protocol data only; never engine pointers.
// Keys are normalized request bytes 20..127 (tab/action excluded), including
// query, element, catalog page, selection, drop page and habitat page.
BestiaryNative.buildCache = function(cache,put) {
	const b=BestiaryNative,c=b.ui(),a=c.asm();
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x57,0xFC,0x8B,0x1D);a.dword(cache);
	a.emit(0x83,0xFB,b.CacheEntries);a.jcc(0x87,"miss");
	a.emit(0xBA);a.dword(cache+8);
	a.label("loop");a.emit(0x85,0xDB);a.jcc(0x84,"miss");
	a.emit(0x8B,0x75,8,0x8B,0xFA,0xB9);a.dword(b.CacheKeySize/4);a.emit(0xF3,0xA7);a.jcc(0x84,"found");
	a.emit(0x81,0xC2);a.dword(b.CacheStride);a.emit(0x4B);a.jmp("loop");
	a.label("miss");
	if(put){
		a.emit(0xA1);a.dword(cache+4);a.emit(0x83,0xF8,b.CacheEntries);a.jcc(0x82,"slot");a.emit(0x33,0xC0);a.label("slot");
		a.emit(0x69,0xD0);a.dword(b.CacheStride);a.emit(0x81,0xC2);a.dword(cache+8);
		a.emit(0x40,0x83,0xE0,b.CacheEntries-1,0xA3);a.dword(cache+4);
		a.emit(0x83,0x3D);a.dword(cache);a.emit(b.CacheEntries);a.jcc(0x83,"found");a.emit(0xFF,0x05);a.dword(cache);
	}else {a.emit(0x33,0xC0);a.jmp("done");}
	a.label("found");
	if(put){a.emit(0x8B,0xFA,0x8B,0x75,8,0xB9);a.dword(b.CacheKeySize/4);a.emit(0xF3,0xA5,0x8B,0x75,12);}
	else {a.emit(0x8D,0x72,b.CacheKeySize,0x8B,0x7D,12);}
	a.emit(0xB9);a.dword(b.SnapshotSize/4);a.emit(0xF3,0xA5,0xB8);a.dword(1);
	a.label("done");a.emit(0x5F,0x5E,0x5B,0x5D,0xC2,8,0);return a;
};
BestiaryNative.buildApplySnapshot = function(state,payload) {
	const b=BestiaryNative,c=b.ui(),a=c.asm();a.emit(0x56,0xBE);a.dword(payload);
	for(const [source,off,word] of [[16,20,false],[24,12,true],[28,52,true],[36,28,false],[40,132,true],[46,136,true]]){
		if(word)a.emit(0x0F,0xB7,0x46,source);else a.emit(0x8B,0x46,source);a.emit(0xA3);a.dword(state+off);
	}
	for(const [source,off] of [[3404,192],[3410,196],[3416,200]]){
		a.emit(0x0F,0xB7,0x86);a.dword(source);a.emit(0xA3);a.dword(state+off);
	}
	for(const [off,value] of [[152,0],[156,0],[164,0],[16,1]])b.store(a,state+off,value);
	a.emit(0x5E,0xC3);return a;
};
// Separate account transport. Never enters the encyclopedia cache or clears it.
// stdcall(action,target); all personal strings are server-bound and terminated.
BestiaryNative.buildPersonalSender=function(m){
	const b=BestiaryNative,c=b.ui(),a=c.asm(),s=m.state.vir,ps=m.personalState.vir;
	a.emit(0x55,0x8B,0xEC,0x81,0xEC);a.dword(128);a.emit(0x53,0x56,0x57,0xFC);
	a.emit(0x8D,0x7D,0x80,0x33,0xC0,0xB9);a.dword(32);a.emit(0xF3,0xAB);
	for(const [off,value] of [[0,0x00800BF8],[4,b.Magic],[8,0x00080003]]){a.emit(0xC7,0x45,0x80+off);a.dword(value);}
	a.emit(0xFF,0x05);a.dword(ps);a.emit(0xA1);a.dword(ps);a.emit(0x89,0x45,0x8C);
	a.emit(0xA1);a.dword(s+4);a.emit(0x85,0xC0);a.jcc(0x85,"tab");a.emit(0x40);a.label("tab");a.emit(0x66,0x89,0x45,0x94);
	for(const [src,dst] of [[4,64],[8,24]]){a.emit(0xA1);a.dword(ps+src);a.emit(0x66,0x89,0x45,0x80+dst);}
	a.emit(0x8B,0x45,8,0x66,0x89,0x45,0x9A,0x8B,0x45,12,0x89,0x45,0x9C);
	b.store(a,ps+12,1);b.store(a,ps+28,1);
	a.emit(0xFF,0x15);a.dword(m.timeGetTimeIat);a.emit(0xA3);a.dword(ps+20);
	a.call(m.packetRefs.packetCtorA);a.emit(0x85,0xC0);a.jcc(0x84,"done");a.emit(0x8B,0xF0,0x8D,0x45,0x80,0x50);c.pushImm(a,128);a.emit(0x8B,0xCE);a.call(m.packetRefs.packetSend);
	a.label("done");a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,8,0);return a;
};
BestiaryNative.personalRequest=function(a,m,action=0,target=null){
	if(target===null){a.emit(0xFF,0x35);a.dword(m.personalState.vir+24);}else BestiaryNative.ui().pushImm(a,target);
	BestiaryNative.ui().pushImm(a,action);a.call(m.personalSender.vir);
};
BestiaryNative.buildPersonalReceiver=function(m){
	const b=BestiaryNative,c=b.ui(),a=c.asm(),ps=m.personalState.vir,p=m.personalPayload.vir;
	a.emit(0x9C,0x60,0xFC,0xBE);a.dword(c.PacketBuffer);
	a.emit(0x66,0x81,0x7E,2);a.word(2176);a.jcc(0x85,"done");a.emit(0x81,0x7E,8);a.dword(0x00090003);a.jcc(0x85,"done");
	a.emit(0x83,0x3D);a.dword(m.state.vir);a.emit(0);a.jcc(0x84,"done");
	a.emit(0x8B,0x46,12,0x3B,0x05);a.dword(ps);a.jcc(0x85,"done");a.emit(0x83,0x7E,20,3);a.jcc(0x87,"done");
	for(const [off,max] of [[28,2],[30,3],[36,6],[38,7]]){a.emit(0x66,0x83,0x7E,off,max);a.jcc(0x87,"done");}
	a.emit(0x66,0x83,0x7E,28,1);a.jcc(0x82,"done");
	a.emit(0x0F,0xB7,0x46,32,0x0F,0xB7,0x56,34,0x85,0xD2);a.jcc(0x84,"zero");a.emit(0x3B,0xC2);a.jcc(0x83,"done");a.jmp("copy");a.label("zero");a.emit(0x85,0xC0);a.jcc(0x85,"done");
	a.label("copy");a.emit(0xBF);a.dword(p);a.emit(0xB9);a.dword(544);a.emit(0xF3,0xA5);
	const fields=[[64,64],[128,128],[256,128],[384,128],[2048,128]];
	for(let i=0;i<6;i++)for(const [off,len] of [[16,64],[80,96],[176,48],[224,32]])fields.push([512+i*256+off,len]);
	for(const [off,len] of fields){a.emit(0xC6,0x05);a.dword(p+off+len-1);a.emit(0);}
	b.store(a,ps+12,0);b.store(a,ps+16,1);
	a.emit(0x0F,0xB7,0x05);a.dword(p+32);a.emit(0xA3);a.dword(ps+8);
	a.label("done");a.emit(0x61,0x9D,0xC3);return a;
};
BestiaryNative.buildPersonalDestructor=function(m,stock){
	const b=BestiaryNative,a=b.ui().asm();a.emit(0x9C,0x60,0xFC,0xFF,0x05);a.dword(m.personalState.vir);
	a.emit(0x33,0xC0,0xBF);a.dword(m.personalState.vir+4);a.emit(0xB9);a.dword(7);a.emit(0xF3,0xAB);
	a.emit(0xBF);a.dword(m.personalPayload.vir);a.emit(0xB9);a.dword(544);a.emit(0xF3,0xAB,0x61,0x9D);a.jmp(stock);return a;
};

BestiaryNative.buildSender = function(m) {
	const b=BestiaryNative,c=b.ui(),a=c.asm(),state=m.state.vir,query=m.query.vir,refs=m.packetRefs;
	a.emit(0x9C,0x60,0x83,0x3D);a.dword(m.personalState.vir+28);a.emit(0);a.jcc(0x85,"personalLoaded");b.personalRequest(a,m,0,0);a.label("personalLoaded");a.emit(0x61,0x9D);
	a.emit(0x55,0x8B,0xEC,0x81,0xEC,0x80,0,0,0,0x53,0x56,0x57,0xFC);
	// Preserve the displayed snapshot on misses and keep cache across reopen.
	// Server notices and explicit error retries invalidate copied snapshots.
	for(const message of [6]){a.emit(0x83,0x7D,8,message);a.jcc(0x85,"reload"+message);b.store(a,m.cache.vir,0);b.store(a,m.cache.vir+4,0);a.label("reload"+message);}
	for(const off of [156,164,240])b.store(a,state+off,0);
	b.store(a,state+152,1);
	a.emit(0xFF,0x15);a.dword(m.timeGetTimeIat);a.emit(0xA3);a.dword(state+148);
	a.emit(0x8D,0x7D,0x80,0x33,0xC0,0xB9);a.dword(b.RequestSize/4);a.emit(0xF3,0xAB);
	for(const [offset,value] of [[0,(b.RequestSize<<16)|0x0BF8],[4,b.Magic],[8,3]]){a.emit(0xC7,0x45,0x80+offset);a.dword(value);}
	a.emit(0x8B,0x45,8,0x66,0x89,0x45,0x8A,0xFF,0x05);a.dword(state+24);
	for(const [offset,off,word] of [[12,24,false],[16,20,false],[20,4,true],[22,120,true],[24,12,true],[32,132,true],[34,136,true]]){
		a.emit(0xA1);a.dword(state+off);if(word)a.emit(0x66);a.emit(0x89,0x45,0x80+offset);
	}
	a.emit(0x8B,0x45,12,0x66,0x89,0x45,0x9A,0x8B,0x45,16,0x89,0x45,0x9C);
	// A changed search always starts at the first drop/habitat page.
	a.emit(0x85,0xC0);a.jcc(0x85,"query");a.emit(0xC7,0x45,0xA0);a.dword(0);
	a.label("query");a.emit(0x8D,0x7D,0xA4,0xBE);a.dword(query);a.emit(0xB9);a.dword(27);
	a.label("query_copy");a.emit(0xAC,0xAA,0x84,0xC0);a.jcc(0x84,"query_done");a.emit(0x49);a.jcc(0x85,"query_copy");
	a.label("query_done");
	for(const [offset,off] of [[64,168],[66,172],[68,176],[70,180],[72,184],[74,188],[76,192],[78,196],[104,200]]){
		a.emit(0xA1);a.dword(state+off);a.emit(0x66,0x89,0x45,0x80+offset);
	}
	a.emit(0x66,0xC7,0x45,0xEA);a.word(1); // server reload subscription
	// New selection/search starts at the beginning of each server-owned section.
	a.emit(0x83,0x7D,16,0);a.jcc(0x85,"subpages");
	a.emit(0xC7,0x45,0xCC);a.dword(0);a.emit(0x66,0xC7,0x45,0xE8);a.word(0);a.label("subpages");
	// Send the exact displayed map, not only a positional habitat index.
	for(let i=0;i<2;i++){
		a.emit(0x83,0x7D,12,i+2);a.jcc(0x85,"nav"+i);
		a.emit(0xBE);a.dword(m.payload.vir+1864+i*128);a.emit(0x8D,0x7D,0xD0,0xB9);a.dword(6);a.emit(0xF3,0xA5);a.label("nav"+i);
	}
	a.emit(0x8D,0x75,0x80,0xBF);a.dword(m.pendingRequest.vir);a.emit(0xB9);a.dword(b.RequestSize/4);a.emit(0xF3,0xA5);
	a.emit(0x8D,0x75,0x94,0xBF);a.dword(m.cacheKey.vir);a.emit(0xB9);a.dword(b.CacheKeySize/4);a.emit(0xF3,0xA5);
	for(const off of [0,6]){a.emit(0x66,0xC7,0x05);a.dword(m.cacheKey.vir+off);a.word(0);}
	for(let off=60;off<84;off+=4)b.store(a,m.cacheKey.vir+off,0);
	// Navigation is a server action and must never be satisfied by a cache hit.
	a.emit(0x83,0x7D,12,2);a.jcc(0x83,"send");
	c.pushImm(a,m.payload.vir);c.pushImm(a,m.cacheKey.vir);a.call(m.cacheGet.vir);a.emit(0x85,0xC0);a.jcc(0x84,"send");
	a.call(m.applySnapshot.vir);a.jmp("done");
	a.label("send");a.call(refs.packetCtorA);a.emit(0x8B,0xF0,0x85,0xF6);a.jcc(0x84,"done");
	a.emit(0x8D,0x45,0x80,0x50);c.pushImm(a,b.RequestSize);a.emit(0x8B,0xCE);a.call(refs.packetSend);
	a.label("done");a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,16,0);return a;
};
// No idle polling. Only a BUSY response may retry the exact saved request,
// at 250 ms and at most three times. Timeouts require an explicit new action.
BestiaryNative.buildRequestTick = function(m) {
	const b=BestiaryNative,c=b.ui(),a=c.asm(),s=m.state.vir;
	a.emit(0x83,0x3D);a.dword(s+240);a.emit(1);a.jcc(0x85,"noReloadNotice");
	a.emit(0xA1);a.dword(s);a.emit(0x85,0xC0);a.jcc(0x84,"noReloadNotice");a.emit(0x80,0x78,0x28,0);a.jcc(0x84,"noReloadNotice");
	b.store(a,s+240,0);b.request(a,s,m.sender.vir,6);a.emit(0xC3);
	a.label("noReloadNotice");
	a.emit(0x56,0xFF,0x15);a.dword(m.timeGetTimeIat);a.emit(0x8B,0xF0);
	const ps=m.personalState.vir,pp=m.personalPayload.vir;
	a.emit(0x83,0x3D);a.dword(ps+12);a.emit(1);a.jcc(0x85,"personalTickDone");
	a.emit(0x2B,0x05);a.dword(ps+20);a.emit(0x3D);a.dword(8000);a.jcc(0x82,"personalTickDone");
	b.store(a,ps+12,0);b.store(a,ps+16,1);b.store(a,pp+20,3);
	const timeout="Research request timed out. Use Sync progress to retry.";
	for(let i=0;i<=timeout.length;i++){a.emit(0xC6,0x05);a.dword(pp+256+i);a.emit(i<timeout.length?timeout.charCodeAt(i):0);}
	a.label("personalTickDone");a.emit(0x8B,0xC6,0x2B,0x05);a.dword(s+148);
	a.emit(0x83,0x3D);a.dword(s+152);a.emit(1);a.jcc(0x85,"busy");
	a.emit(0x3D);a.dword(5000);a.jcc(0x82,"done");b.store(a,s+152,0);b.store(a,s+156,3);a.jmp("done");
	a.label("busy");a.emit(0x83,0x3D);a.dword(s+156);a.emit(2);a.jcc(0x85,"done");a.emit(0x3D);a.dword(250);a.jcc(0x82,"done");
	a.emit(0x83,0x3D);a.dword(s+164);a.emit(3);a.jcc(0x82,"retry");b.store(a,s+156,3);a.jmp("done");
	a.label("retry");a.emit(0xFF,0x05);a.dword(s+164);a.emit(0x89,0x35);a.dword(s+148);b.store(a,s+152,1);b.store(a,s+156,0);
	a.call(m.packetRefs.packetCtorA);a.emit(0x85,0xC0);a.jcc(0x84,"done");a.emit(0x8B,0xC8);c.pushImm(a,m.pendingRequest.vir);c.pushImm(a,b.RequestSize);a.call(m.packetRefs.packetSend);
	a.label("done");a.emit(0x5E,0xC3);return a;
};

BestiaryNative.request = function(a, state, sender, message=3, action=0, target=null) {
	const c=BestiaryNative.ui();c.pushImm(a,0);
	if(target===null){a.emit(0xFF,0x35);a.dword(state+28);}else c.pushImm(a,target);
	c.pushImm(a,action);c.pushImm(a,message);a.call(sender);
};

BestiaryNative.buildReceiver = function(m) {
	const b=BestiaryNative,c=b.ui(),a=c.asm(),state=m.state.vir,payload=m.payload.vir,fallback=m.fallback;
	a.emit(0x9C,0x60,0xFC,0xBE);a.dword(c.PacketBuffer);
	a.emit(0x66,0x81,0x3E);a.word(0x0BEF);a.jcc(0x85,"fallback");
	a.emit(0x66,0x83,0x7E,2,8);a.jcc(0x82,"fallback");
	a.emit(0x81,0x7E,4);a.dword(b.Magic);a.jcc(0x85,"fallback");
	a.emit(0x66,0x81,0x7E,2);a.word(2176);a.jcc(0x85,"catalogPacket");a.call(m.personalReceiver.vir);a.jmp("handled");a.label("catalogPacket");
	// Reload notices invalidate immediately; the next visible draw sends one query.
	a.emit(0x66,0x83,0x7E,2,20);a.jcc(0x85,"snapshot");
	a.emit(0x81,0x7E,8);a.dword(0x00070003);a.jcc(0x85,"handled");a.emit(0x83,0x7E,16,0);a.jcc(0x85,"handled");
	a.emit(0x8B,0x46,12,0x85,0xC0);a.jcc(0x84,"handled");a.emit(0x3B,0x05);a.dword(state+236);a.jcc(0x84,"handled");
	a.emit(0x3B,0x05);a.dword(state+20);a.jcc(0x84,"handled");a.emit(0xA3);a.dword(state+236);
	b.store(a,state+240,1);b.store(a,state+152,0);b.store(a,m.cache.vir,0);b.store(a,m.cache.vir+4,0);a.emit(0xFF,0x05);a.dword(state+24);a.jmp("handled");
	a.label("snapshot");
	// The post-reader owns packet consumption. Reject malformed BSUI without
	// invoking a legacy handler or reading beyond the exact fixed snapshot.
	a.emit(0x66,0x81,0x7E,2);a.word(b.SnapshotSize);a.jcc(0x85,"handled");
	a.emit(0x81,0x7E,8);a.dword(0x00020003);a.jcc(0x85,"handled");
	a.emit(0xA1);a.dword(state+236);a.emit(0x85,0xC0);a.jcc(0x84,"revisionCurrent");a.emit(0x3B,0x46,16);a.jcc(0x85,"handled");a.label("revisionCurrent");
	a.emit(0x8B,0x46,12,0x3B,0x05);a.dword(state+24);a.jcc(0x85,"handled");
	a.emit(0x83,0x3D);a.dword(state+152);a.emit(1);a.jcc(0x85,"handled");
	a.emit(0x83,0x7E,20,3);a.jcc(0x87,"handled");
	for(const [off,max] of [[28,6],[30,10],[44,4],[50,2]]){
		a.emit(0x66,0x83,0x7E,off,max);a.jcc(0x87,"handled");
	}
	for(const [index,count] of [[24,26],[40,42],[46,48]]){
		a.emit(0x0F,0xB7,0x46,index,0x0F,0xB7,0x56,count,0x85,0xD2);a.jcc(0x84,"zero_"+index);
		a.emit(0x3B,0xC2);a.jcc(0x83,"handled");a.jmp("valid_"+index);
		a.label("zero_"+index);a.emit(0x85,0xC0);a.jcc(0x85,"handled");a.label("valid_"+index);
	}
	for(const [off,max] of [[3392,12],[3394,3],[3396,3],[3398,2],[3408,4],[3414,4],[3420,4]]){
		a.emit(0x66,0x83,0xBE);a.dword(off);a.emit(max);a.jcc(0x87,"handled");
	}
	for(const [index,count] of [[3404,3406],[3410,3412],[3416,3418]]){
		a.emit(0x0F,0xB7,0x86);a.dword(index);a.emit(0x0F,0xB7,0x96);a.dword(count);
		a.emit(0x85,0xD2);a.jcc(0x84,"zero_"+index);a.emit(0x3B,0xC2);a.jcc(0x83,"handled");a.jmp("valid_"+index);
		a.label("zero_"+index);a.emit(0x85,0xC0);a.jcc(0x85,"handled");a.label("valid_"+index);
	}
	// Require detail and selected row to identify the same monster.
	a.emit(0x83,0x7E,20,0);a.jcc(0x85,"server_error");
	a.emit(0x8B,0x46,36,0x3B,0x86);a.dword(832);a.jcc(0x85,"handled");
	a.emit(0x0F,0xB7,0x4E,28,0x85,0xC9);a.jcc(0x85,"selection");
	a.emit(0x85,0xC0);a.jcc(0x85,"handled");a.jmp("copy");
	a.label("selection");a.emit(0x8D,0x7E,64);
	a.label("selection_loop");a.emit(0x3B,0x07);a.jcc(0x84,"copy");a.emit(0x81,0xC7);a.dword(128);a.emit(0x49);a.jcc(0x85,"selection_loop");a.jmp("handled");
	a.label("copy");
	// A changed server revision invalidates every cached page before insertion.
	a.emit(0x8B,0x46,16,0x3B,0x05);a.dword(state+20);a.jcc(0x84,"same_revision");b.store(a,m.cache.vir,0);b.store(a,m.cache.vir+4,0);a.label("same_revision");
	a.emit(0xBF);a.dword(payload);a.emit(0xB9);a.dword(b.SnapshotSize/4);a.emit(0xF3,0xA5);
	// Force terminators in every string field before native GDI/formatters.
	const fields=[];
	for(let i=0;i<6;i++)fields.push([64+i*128+20,64],[64+i*128+84,20],[64+i*128+104,24]);
	for(const [off,len] of [[64,64],[128,48],[176,24],[200,24],[224,24],[248,24],[272,24],[296,24],[320,64],[384,24],[408,24],[432,24],[456,56]])fields.push([832+off,len]);
	for(let i=0;i<4;i++)fields.push([1344+i*128+16,64],[1344+i*128+80,24],[1344+i*128+104,24]);
	for(let i=0;i<2;i++)fields.push([1856+i*128+8,24],[1856+i*128+32,64],[1856+i*128+96,32]);
	for(let i=0;i<40;i++)fields.push([2432+i*24,24]);
	for(let i=0;i<4;i++)fields.push([3456+i*160+8,48],[3456+i*160+56,64],[3456+i*160+120,40],[4288+i*112,112],[4800+i*80+8,48],[4800+i*80+56,24]);
	for(let i=0;i<2;i++)fields.push([4096+i*96+16,40],[4096+i*96+56,40]);
	fields.push([4736,64]);
	for(const [off,len] of fields){a.emit(0xC6,0x05);a.dword(payload+off+len-1);a.emit(0);}
	// Store both the request alias (selected=0) and the canonical response
	// key, so selecting the initial monster is also a local cache hit.
	c.pushImm(a,payload);c.pushImm(a,m.cacheKey.vir);a.call(m.cachePut.vir);
	for(const [off,src,word] of [[4,24,true],[8,36,false],[12,40,true],[14,46,true],[56,3404,true],[58,3410,true],[84,3416,true]]){
		if(word)a.emit(0x0F,0xB7,0x05);else a.emit(0xA1);a.dword(payload+src);
		if(word)a.emit(0x66);a.emit(0xA3);a.dword(m.cacheKey.vir+off);
	}
	c.pushImm(a,payload);c.pushImm(a,m.cacheKey.vir);a.call(m.cachePut.vir);
	a.call(m.applySnapshot.vir);b.store(a,state+236,0);b.store(a,state+240,0);
	a.emit(0x8B,0x35);a.dword(state);a.emit(0x85,0xF6);a.jcc(0x84,"handled");c.emitMarkDirty(a);
	a.jmp("handled");
	a.label("server_error");
	// Errors leave the last good snapshot visible and never enter the cache.
	a.emit(0x8B,0x46,20,0xA3);a.dword(state+156);b.store(a,state+152,0);
	a.emit(0x8B,0x35);a.dword(state);a.emit(0x85,0xF6);a.jcc(0x84,"handled");c.emitMarkDirty(a);
	a.label("handled");a.emit(0x61,0x9D);a.jmp(c.PacketMainLoopReturn);
	a.label("fallback");a.emit(0x61,0x9D);a.jmp(fallback);return a;
};

// thiscall draw(viewId,x,y,width,height,cycle). This is the stock numeric
// MonsterInfoWnd name resolver; database/Aegis names are never sprite paths.
BestiaryNative.buildNativeSprite = function(preview) {
	const b=BestiaryNative,c=b.ui(),a=c.asm();
	a.emit(0x55,0x8B,0xEC,0x81,0xEC);a.dword(256);a.emit(0x53,0x56,0x57,0x8B,0xF1);
	c.pushImm(a,-1);a.emit(0xFF,0x75,8,0xB9);a.dword(0x015FA3C0);a.call(0x00D5BB40);
	a.emit(0x85,0xC0);a.jcc(0x84,"missing");a.emit(0x80,0x38,0);a.jcc(0x84,"missing");a.emit(0x8B,0xF8);
	for(const [format,offset] of [[0x0103181C,-256],[0x0103182C,-128]]){
		a.emit(0x57);c.pushImm(a,format);c.pushImm(a,-1);c.pushImm(a,128);a.emit(0x8D,0x85);a.dword(offset);a.emit(0x50);a.call(0x0059CDF0);a.emit(0x83,0xC4,20,0x85,0xC0);a.jcc(0x88,"missing");
	}
	a.call(c.GetTexMgr);a.emit(0x8B,0xD8,0x85,0xDB);a.jcc(0x84,"missing");
	for(const offset of [-256,-128]){a.emit(0x8D,0x85);a.dword(offset);a.emit(0x50,0x8B,0xCB);a.call(b.ResourceExists);a.emit(0x84,0xC0);a.jcc(0x84,"missing");}
	a.emit(0x8D,0x85);a.dword(-256);a.emit(0x50,0x8B,0xCB);a.call(c.LoadSurface);a.emit(0x8B,0xF8,0x85,0xFF);a.jcc(0x84,"missing");
	a.emit(0x8D,0x85);a.dword(-128);a.emit(0x50,0x8B,0xCB);a.call(c.LoadSurface);a.emit(0x85,0xC0);a.jcc(0x84,"missing");
	for(const off of [28,24,20,16,12])a.emit(0xFF,0x75,off);
	a.emit(0x50,0x57,0x56);a.call(preview);a.jmp("done");
	a.label("missing");a.emit(0x33,0xC0);a.label("done");a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,24,0);return a;
};

// thiscall image(path,x,y). Existence is checked before loading so a missing
// minimap/optional skin never emits Resource File Loading fail in game chat.
// Freestanding helper generated from tools/native/bestiary_preview.cpp.
// Relocate only PE HIGHLOW references internal to the injected image. Engine
// addresses are explicit constants and are not relocated with this blob.
BestiaryNative.embedPreview = function() {
	const b=BestiaryNative,data=b.PreviewBlob;
	const bytes=data.hex.match(/../g).map(v=>parseInt(v,16));
	const [phy,base]=Exe.Allocate(bytes.length,16);
	if(phy<0||base<=0||Exe.Vir2Phy(base)!==phy)throw Error("Bestiary: invalid native preview allocation");
	for(const off of data.relocations){
		if(off<0||off+4>bytes.length)throw Error("Bestiary: invalid preview relocation");
		const old=(bytes[off]|bytes[off+1]<<8|bytes[off+2]<<16|bytes[off+3]<<24)>>>0;
		if(old<data.imageBase||old>=data.imageBase+bytes.length)throw Error("Bestiary: external preview relocation");
		const value=(old-data.imageBase+base)>>>0;
		for(let i=0;i<4;i++)bytes[off+i]=(value>>>(i*8))&255;
	}
	const hex=b.ui().bytesToHex(bytes);Exe.SetHex(phy,hex);b.emissions.push({vir:base,hex});
	return {vir:base+data.entryOffset,phy:phy+data.entryOffset,base,size:bytes.length,sourceSha256:data.source_sha256};
};

BestiaryNative.buildImage = function(colorKeyBlit=0) {
	const b=BestiaryNative,c=b.ui(),a=c.asm();
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x57,0x8B,0xF1);a.call(c.GetTexMgr);a.emit(0x8B,0xD8,0x85,0xDB);a.jcc(0x84,"missing");
	a.emit(0xFF,0x75,8);a.call(c.ConvPath);a.emit(0x83,0xC4,4,0x8B,0xF8,0x85,0xFF);a.jcc(0x84,"missing");a.emit(0x57,0x8B,0xCB);a.call(b.ResourceExists);a.emit(0x84,0xC0);a.jcc(0x84,"missing");
	a.emit(0x57,0x8B,0xCB);a.call(c.LoadSurface);a.emit(0x85,0xC0);a.jcc(0x84,"missing");
	if(colorKeyBlit){a.emit(0xFF,0x75,16,0xFF,0x75,12,0x50,0x56);a.call(colorKeyBlit);}else{c.pushImm(a,0);a.emit(0x50,0xFF,0x75,16,0xFF,0x75,12,0x8B,0xCE);a.call(0xA1D260);}a.emit(0xB8);a.dword(1);a.jmp("done");
	a.label("missing");a.emit(0x33,0xC0);a.label("done");a.emit(0x5F,0x5E,0x5B,0x5D,0xC2,12,0);return a;
};

BestiaryNative.buildMap = function(image,format) {
	const c=BestiaryNative.ui(),a=c.asm();
	// thiscall map(name,x,y); accept only canonical map stem characters.
	a.emit(0x55,0x8B,0xEC,0x83,0xEC,96,0x53,0x56,0x57,0x8B,0xF1,0x8B,0x7D,8,0x33,0xC9);
	a.label("char");a.emit(0x83,0xF9,24);a.jcc(0x83,"missing");a.emit(0x8A,0x04,0x0F,0x84,0xC0);a.jcc(0x84,"valid");
	for(const v of [45,64,95]){a.emit(0x3C,v);a.jcc(0x84,"next");}
	for(const [min,max,label] of [[48,57,"digit"],[65,90,"upper"],[97,122,"lower"]]){
		a.emit(0x3C,min);a.jcc(0x82,label);a.emit(0x3C,max);a.jcc(0x86,"next");a.label(label);
	}
	a.jmp("missing");a.label("next");a.emit(0x41);a.jmp("char");
	a.label("valid");a.emit(0x85,0xC9);a.jcc(0x84,"missing");
	a.emit(0x57);c.pushImm(a,format);c.pushImm(a,-1);c.pushImm(a,96);a.emit(0x8D,0x45,0xA0,0x50);a.call(0x59CDF0);a.emit(0x83,0xC4,20,0x85,0xC0);a.jcc(0x88,"missing");
	a.emit(0xFF,0x75,16,0xFF,0x75,12,0x8D,0x45,0xA0,0x50,0x8B,0xCE);a.call(image);a.jmp("done");
	a.label("missing");a.emit(0x33,0xC0);a.label("done");a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,12,0);return a;
};

BestiaryNative.buildItem = function(image,resolver,format) {
	const c=BestiaryNative.ui(),a=c.asm();
	// thiscall item(ItemId,x,y). Resolve client identified resource from ItemId.
	a.emit(0x55,0x8B,0xEC,0x81,0xEC);a.dword(256);a.emit(0x53,0x56,0x57,0x8B,0xF1,0xFF,0x75,8);a.call(resolver);
	a.emit(0x85,0xC0);a.jcc(0x84,"missing");a.emit(0x50);c.pushImm(a,format);c.pushImm(a,-1);c.pushImm(a,256);a.emit(0x8D,0x85);a.dword(-256);a.emit(0x50);a.call(0x59CDF0);a.emit(0x83,0xC4,20,0x85,0xC0);a.jcc(0x88,"missing");
	a.emit(0xFF,0x75,16,0xFF,0x75,12,0x8D,0x85);a.dword(-256);a.emit(0x50,0x8B,0xCE);a.call(image);a.jmp("done");
	a.label("missing");a.emit(0x33,0xC0);a.label("done");a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,12,0);return a;
};
/* Compact journal composition: 760x500 inside an 800x600 game viewport. */
BestiaryNative.buildTextFit = function() {
	const c=BestiaryNative.ui(),a=c.asm();
	// stdcall(window,text,x,y,width,height,bold,COLORREF). Bound by characters
	// and measured native width; a long DB name cannot cross panel boundaries.
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x57,0x8B,0x75,8,0x8B,0x7D,12,0x33,0xDB);
	a.label("length");a.emit(0x83,0xFB,0x7F);a.jcc(0x83,"measure");a.emit(0x80,0x3C,0x1F,0);a.jcc(0x84,"measure");a.emit(0x43);a.jmp("length");
	a.label("measure");a.emit(0x85,0xDB);a.jcc(0x84,"done");
	c.pushImm(a,0);a.emit(0xFF,0x75,32,0xFF,0x75,28);c.pushImm(a,0);a.emit(0x53,0x57,0x8B,0xCE);a.call(0xA21C90);
	a.emit(0x3B,0x45,24);a.jcc(0x8E,"draw");a.emit(0x4B);a.jmp("measure");
	a.label("draw");c.pushImm(a,0);a.emit(0xFF,0x75,32,0xFF,0x75,36,0xFF,0x75,28);c.pushImm(a,0);a.emit(0x53,0x57,0xFF,0x75,20,0xFF,0x75,16,0x8B,0xCE);a.call(0xA25A70);
	a.label("done");a.emit(0x5F,0x5E,0x5B,0x5D,0xC2,32,0);return a;
};

BestiaryNative.buildJournalDraw = function(m) {
	const b=BestiaryNative,c=b.ui(),a=c.asm(),s=m.state.vir,p=m.payload.vir,t=m.strings;
	const push=v=>c.pushImm(a,v),cmp=(off,value,label)=>{a.emit(0x83,0x3D);a.dword(s+off);a.emit(value);a.jcc(0x85,label);};
	const rect=(x,y,w,h,color)=>c.emitFillRect(a,m.fill.vir,x,y,w,h,0xFF000000|color);
	const panel=(x,y,w,h,color=0xFFFFFF)=>{rect(x+1,y,w-2,h,0xC5D1DC);rect(x,y+1,w,h-2,0xC5D1DC);rect(x+1,y+1,w-2,h-2,color);};
	const text=(ptr,x,y,w=180,size=11,bold=0,rgb=0x254267)=>{
		const color=((rgb&255)<<16)|(rgb&0xFF00)|((rgb>>>16)&255);
		for(const v of [color,bold,size,w,y,x,ptr])push(v);a.emit(0x56);a.call(m.textFit.vir);
	};
	const numeric=(ptr,...args)=>{push(m.numberBuffer.vir);push(ptr);a.call(m.numberText.vir);text(m.numberBuffer.vir,...args);};
	const label=(key,x,y,w=180,size=11,bold=0,rgb=0x254267)=>text(t[key],x,y,w,size,bold,rgb);
	const image=(ptr,x,y,entry=m.image.vir)=>{push(y);push(x);push(ptr);a.emit(0x8B,0xCE);a.call(entry);};
	const prop=(field,paths,x,y,key)=>{
		for(let i=0;i<paths.length;i++){a.emit(0x66,0x83,0x3D);a.dword(field);a.emit(i);a.jcc(0x85,key+i);if(paths[i])image(paths[i],x,y,m.iconImage.vir);a.label(key+i);}
	};
	const button=(ptr,x,y,w,h=20,active=false)=>{panel(x,y,w,h,active?0xDDEBFC:0xF4F7FB);rect(x+2,y+2,w-4,Math.max(1,(h>>1)-2),active?0xCCE1FB:0xFFFFFF);text(ptr,x+(w<30?4:7),y+4,w-(w<30?8:12),11,0);};
	let pagerId=0;
	const pager=(ptr,x,y,w,h,current,count,forward,local=false)=>{
		const id="pager"+(pagerId++);
		if(!local){a.emit(0x83,0x3D);a.dword(s+152);a.emit(1);a.jcc(0x84,id+"_disabled");}
		if(local)a.emit(0xA1);else a.emit(0x0F,0xB7,0x05);a.dword(current);
		if(forward){a.emit(0x40);if(local){a.emit(0x3D);a.dword(count);}else{a.emit(0x0F,0xB7,0x0D);a.dword(count);a.emit(0x3B,0xC1);}a.jcc(0x83,id+"_disabled");}
		else {a.emit(0x85,0xC0);a.jcc(0x84,id+"_disabled");}
		button(ptr,x,y,w,h);a.jmp(id+"_done");a.label(id+"_disabled");panel(x,y,w,h,0xF1F4F7);text(ptr,x+4,y+4,w-8,11,0,0xB8C2CD);a.label(id+"_done");
	};
	const detailPager=(current,count,local=false)=>{pager(t.prev,703,327,19,18,current,count,false,local);pager(t.next,725,327,19,18,current,count,true,local);};
	const tab=(ptr,x,y,w,off,index,id)=>{cmp(off,index,id+"_off");button(ptr,x,y,w,20,true);rect(x+2,y+17,w-4,2,0x829ECA);a.jmp(id+"_done");a.label(id+"_off");button(ptr,x,y,w);a.label(id+"_done");};
	const sprite=(view,x,y,w,h,cycle)=>{for(const v of [cycle,h,w,y,x])push(v);a.emit(0xFF,0x35);a.dword(view);a.emit(0x8B,0xCE);a.call(m.sprite.vir);};
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x57,0x8B,0xF1);
	a.call(m.search.vir);
	a.call(m.requestTick.vir);
	push(0x00F8FBFE);a.emit(0x8B,0xCE);a.call(c.WindowClearSurface);
	image(t.skinAsset,0,0);
	label("title",18,5,200,13,1);
	label("heading",12,34,162,12,0,0x243648);
	button(t.filters,177,30,58,20);
	cmp(156,0,"showRetry");a.jmp("retryDone");a.label("showRetry");button(t.reload,435,30,61,20);a.label("retryDone");
	cmp(152,1,"notPending");label("fetching",243,35,187,10);a.jmp("cacheStatusDone");a.label("notPending");
	cmp(156,0,"cacheError");label("cached",243,35,187,10,0,0x75849B);a.jmp("cacheStatusDone");a.label("cacheError");label("reloadError",243,35,187,10,0,0x946742);a.label("cacheStatusDone");
	rect(506,29,245,21,0xF7FAFE);
	for(let i=0;i<3;i++)tab(t.tabs[i],506+i*81,30,79,4,i,"mainTab"+i);
	cmp(4,0,"other");
	
	label("search",30,66,137,11,0,0x8292A7);
	// Edit child paints over this hint when nonempty or focused.
	label("element",20,91,45);
	for(let i=0;i<b.Elements.length;i++){cmp(120,i,"element"+i);text(t.elements[i],68,91,90);a.label("element"+i);}
	
	for(let i=0;i<6;i++){
		const y=112+i*54, row=p+64+i*128;
		rect(12,y,161,49,0xFFFFFF);
		cmp(16,1,"rowEnd"+i);
		a.emit(0x83,0x3D);a.dword(s+52);a.emit(i);a.jcc(0x86,"rowEnd"+i);
		a.emit(0xA1);a.dword(row);a.emit(0x3B,0x05);a.dword(p+36);a.jcc(0x85,"plain"+i);
		rect(12,y,161,49,0xFBE5ED);rect(162,y+1,7,10,0xA995D0);a.label("plain"+i);
		sprite(row+4,17,y+9,31,33,0);text(row+20,55,y+5,115,11,1);text(row+84,55,y+19,115,10,0,0x607A98);prop(row+10,t.elementIcons,55,y+32,"rowProp"+i+"_");text(row+104,72,y+33,98,10,0,0x607A98);
		a.label("rowEnd"+i);
	}
	pager(t.prev,14,444,23,18,p+24,p+26,false);pager(t.next,150,444,23,18,p+24,p+26,true);
	// Counts use a bounded native formatter and the live catalog, not sample 6.
	a.emit(0xFF,0x35);a.dword(p+32);push(t.countFormat);push(-1);push(48);push(m.scratch.vir);a.call(0x59CDF0);a.emit(0x83,0xC4,20);
	text(m.scratch.vir,44,448,103,10);
	cmp(16,1,"loading");
	a.emit(0x83,0x3D);a.dword(s+52);a.emit(0);a.jcc(0x84,"empty");
	const d=p+832;
	text(d+64,196,61,274,20,1,0x294D75);text(d+128,197,87,270,11);
	// Decorative crops are from the approved artwork. Creature art is entirely
	// the native SPR/ACT renderer; no generated monsters remain in any card.
	// All monsters use the union of their entire idle animation, fitted to
	// both viewport dimensions with padding. Native sprite scale never grows
	// above 1; large poses shrink together without clipping or frame jitter.
	sprite(d+4,215,103,240,156,1200);
	
	// Replace the baked divider and reserve the full native text line height.
	panel(191,263,294,52,0xFFFFFF);
	for(const [i,key,off] of [[0,"hp",176],[1,"baseExp",200],[2,"jobExp",224]]){
		if(i)rect(191+i*98,264,1,50,0xDBE6EF);
		label(key,199+i*98,267,84,10);numeric(d+off,199+i*98,279,84,11,1);
	}
	rect(192,298,292,1,0xDBE6EF);
	prop(d+52,t.elementIcons,199,300,"elementBadge");prop(d+50,t.raceIcons,297,300,"raceBadge");prop(d+56,t.sizeIcons,395,300,"sizeBadge");text(d+248,216,300,70,10);text(d+272,314,300,70,10);text(d+296,412,300,67,10);
	label("fieldNotes",501,61,227,14,1);label("habitat",501,89,150,11,1);
	for(let i=0;i<2;i++){
		const y=98+i*57,h=p+1856+i*128;
