*   Author(s)     : Louis T Steinhil                                       *
*   Created Date  : 2026-09-27                                             *
*   Last Modified : 2026-10-11                                             *
*                                                                          *
*   Description   : Installs the Riftlock v1 transport in the profiled     *
*                   2025-07-16 client. Incoming controls are stripped at   *
*                   the native packet reader; native outgoing packets are  *
*                   wrapped after stock packet-key obfuscation and before  *
*                   CPacketQueue insertion.                                *
*                                                                          *
\**************************************************************************/

RiftlockTransport = function(_)
{
	if (Exe.BuildDate !== 20250716)
		throw Error("RiftlockTransport supports only the 2025-07-16 client profile");
	if (typeof CustomDLL === "undefined" || typeof CustomDLL.applySpec !== "function")
		throw Error("RiftlockTransport: CustomDLL.applySpec helper unavailable");
	const dllName = "riftlock.dll";
	$$(_, 1, `Import the standalone Riftlock client module`);
	const result = CustomDLL.applySpec(`${_}.CustomDLL`, [
		{
			Name: dllName,
			Funcs: [
				{Name: "RiftlockInit"},
				{Name: "RiftlockConnectionResetBridge"},
				{Name: "RiftlockQueuePacketBridge"},
				{Name: "RiftlockQueueDeferredPacketBridge"},
				{Name: "RiftlockReceiveBytesBridge"},
				{Name: "RiftlockReadPacketBridge"},
				{Name: "RiftlockReadRawBridge"}
			]
		}
	]);

	RiftlockTransport.installStaticBridges(`${_}.Static`, dllName);
	StaticPatchRefresh.add(
		`${_}.Static`,
		function() { return RiftlockTransport.installStaticBridges(`${_}.Static`, dllName); }
	);
	return result;
};

RiftlockTransport.findIat = function(dllName, exportName)
{
	const iat = (
		typeof CustomDLL.findIat === "function"
	)
		? CustomDLL.findIat(exportName, dllName)
		: Exe.FindFunc(exportName, dllName);
	if (iat < 0)
		throw Error(`RiftlockTransport: import not found: ${dllName}!${exportName}`);
	return iat;
};

RiftlockTransport.hexNorm = function(hex)
{
	return (hex || "").replace(/\s+/g, " ").trim().toUpperCase();
};

RiftlockTransport.installCallBridge = function(stateByLabel, spec, dllName)
{
	const callPhy = Exe.Vir2Phy(spec.callVir, CODE);
	if (callPhy < 0 || Exe.GetUint8(callPhy) !== 0xE8)
		throw Error(`RiftlockTransport: ${spec.label} is not a relative CALL`);

	let state = stateByLabel[spec.label];
	const currentTarget = Exe.GetTgtAddr(callPhy + 1);
	if (!state || typeof state.cavePhy !== "number" || typeof state.caveVir !== "number")
	{
		if (currentTarget !== spec.expectedTarget)
			throw Error(
				`RiftlockTransport: ${spec.label} expected ${spec.expectedTarget.toHex(true)}` +
				`, got ${currentTarget.toHex(true)}`
			);
		const cave = Exe.Allocate(0x20, 0x10);
		state = {
			callVir: spec.callVir,
			expectedTarget: spec.expectedTarget,
			cavePhy: cave[0],
			caveVir: cave[1]
		};
	}
	else if (currentTarget !== state.caveVir && currentTarget !== spec.expectedTarget)
	{
		throw Error(`RiftlockTransport: ${spec.label} already calls ${currentTarget.toHex(true)}`);
	}

	const iat = RiftlockTransport.findIat(dllName, spec.exportName);
	// Preserve the CALL return at the top of the stack while replacing its
	// duplicate with the stock target. The fastcall export receives ECX as
	// the native queue and cleans original/length/data before returning.
	Exe.SetHex(
		state.cavePhy,
		" FF 34 24" +
		" C7 44 24 04 " + spec.expectedTarget.toHex() +
		" FF 25 " + iat.toHex()
	);
	Exe.SetCALL(callPhy, state.caveVir, 0);
	state.iat = iat;
	stateByLabel[spec.label] = state;
};

RiftlockTransport.installPrologueBridge = function(stateByLabel, spec, dllName)
{
	const sitePhy = Exe.Vir2Phy(spec.siteVir, CODE);
	if (sitePhy < 0)
		throw Error(`RiftlockTransport: ${spec.label} entry is not mapped`);

	let state = stateByLabel[spec.label];
	const currentTarget = Exe.GetUint8(sitePhy) === 0xE9
		? Exe.GetTgtAddr(sitePhy + 1)
		: -1;
	if (!state || typeof state.bridgePhy !== "number" ||
		typeof state.bridgeVir !== "number" ||
		typeof state.trampolinePhy !== "number" ||
		typeof state.trampolineVir !== "number")
	{
		const actual = RiftlockTransport.hexNorm(Exe.GetHex(sitePhy, spec.stolenLen));
		const expected = RiftlockTransport.hexNorm(spec.expectedHex);
		if (actual !== expected)
			throw Error(`RiftlockTransport: ${spec.label} prologue mismatch, got ${actual}`);
		const trampoline = Exe.Allocate(spec.stolenLen + 5, 0x10);
		const bridge = Exe.Allocate(0x20, 0x10);
		state = {
			siteVir: spec.siteVir,
			stolenLen: spec.stolenLen,
			stolenHex: actual,
			trampolinePhy: trampoline[0],
			trampolineVir: trampoline[1],
			bridgePhy: bridge[0],
			bridgeVir: bridge[1]
		};
	}
	else if (currentTarget !== state.bridgeVir &&
		RiftlockTransport.hexNorm(Exe.GetHex(sitePhy, spec.stolenLen)) !== state.stolenHex)
	{
		throw Error(`RiftlockTransport: ${spec.label} entry changed`);
	}

	const iat = RiftlockTransport.findIat(dllName, spec.exportName);
	Exe.SetHex(
		state.trampolinePhy,
		state.stolenHex + JMP(spec.siteVir + spec.stolenLen, state.trampolineVir + spec.stolenLen)
	);
	Exe.SetHex(
		state.bridgePhy,
		" FF 34 24" +
		" C7 44 24 04 " + state.trampolineVir.toHex() +
		" FF 25 " + iat.toHex()
	);
	Exe.SetJMP(sitePhy, state.bridgeVir, spec.stolenLen - 5);
	state.iat = iat;
	stateByLabel[spec.label] = state;
};

RiftlockTransport.installStaticBridges = function(_, dllName)
{
	if (Exe.BuildDate !== 20250716)
		throw Error("RiftlockTransport static bridges support only the 2025-07-16 client");

	const cacheKey = "RiftlockTransport.StaticBridges";
	const stateByLabel = CACHE.get(cacheKey) ?? {};
	RiftlockTransport.installPrologueBridge(
		stateByLabel,
		{
			label: "connection reset",
			siteVir: 0x00C13FC0,
			stolenLen: 5,
			expectedHex: "55 8B EC 6A FF",
			exportName: "RiftlockConnectionResetBridge"
		},
		dllName
	);

	RiftlockTransport.installPrologueBridge(
		stateByLabel,
		{
			label: "native packet reader",
			siteVir: 0x00C147D0,
			stolenLen: 6,
			expectedHex: "55 8B EC 83 EC 10",
			exportName: "RiftlockReadPacketBridge"
		},
		dllName
	);
	RiftlockTransport.installPrologueBridge(
		stateByLabel,
		{
			label: "raw character bootstrap reader",
			siteVir: 0x00C14780,
			stolenLen: 7,
			expectedHex: "55 8B EC 80 7D 10 00",
			exportName: "RiftlockReadRawBridge"
		},
		dllName
	);
	// The DLL uses these stock queue methods to peek/read complete controls.
	for (const address of [0x00C16810, 0x00C16570])
	{
		const phy = Exe.Vir2Phy(address, CODE);
		if (phy < 0 || RiftlockTransport.hexNorm(Exe.GetHex(phy, 3)) !== "55 8B EC")
			throw Error("RiftlockTransport: native queue method profile mismatch");
	}

	const queueCalls = [
		{
			label: "native receive queue insertion",
			callVir: 0x00C145D2,
			expectedTarget: 0x00C16640,
			exportName: "RiftlockReceiveBytesBridge"
		},
		{
			label: "deferred native packet queue",
			callVir: 0x00C1495D,
			expectedTarget: 0x00C16640,
			exportName: "RiftlockQueueDeferredPacketBridge"
		},
		{
			label: "immediate native packet queue",
			callVir: 0x00C1496C,
			expectedTarget: 0x00C16640,
			exportName: "RiftlockQueuePacketBridge"
		}
	];
	for (const spec of queueCalls)
		RiftlockTransport.installCallBridge(stateByLabel, spec, dllName);

	CACHE.put(cacheKey, stateByLabel);
	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
		PatchDiagnostics.add("RiftlockTransport.StaticBridges", stateByLabel);
	$$(_, 4, `Riftlock transport bridges installed`);
	return true;
};

RiftlockTransport.validate = function()
{
	if (Exe.BuildDate !== 20250716)
		return false;
	const connect = Exe.Vir2Phy(0x00C13FC0, CODE);
	const reader = Exe.Vir2Phy(0x00C147D0, CODE);
	const rawReader = Exe.Vir2Phy(0x00C14780, CODE);
	const sendBuffered = Exe.Vir2Phy(0x00C1495D, CODE);
	const sendImmediate = Exe.Vir2Phy(0x00C1496C, CODE);
	return connect >= 0 && rawReader >= 0 && reader >= 0 && sendBuffered >= 0 && sendImmediate >= 0;
};
