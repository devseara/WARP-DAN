*   Created Date  : 2025-07-16                                             *
*   Last Modified : 2026-07-12                                             *
*                                                                          *
*   Description   : QJS-only player-name color patch for the 2025-07-16    *
*                   client. Uses the shared EXTN exact-text map and applies *
*                   RGB only around non-shadow TextOutW player-name draws, *
*                   matching the former DLL bridge without a custom DLL.  *
*                                                                          *
\**************************************************************************/

CustomPlayerNameColor = function(_)
{
	if (typeof ExtNameTextStatic === "undefined" ||
		typeof ExtNameTextStatic.enable !== "function")
		throw Error("CustomPlayerNameColor: ExtNameTextStatic helper unavailable");
	$$(_, 1, "Install QJS-only exact player-name color bridge");
	ExtNameTextStatic.enable(_, ExtNameTextStatic.FeatureColors);
	$$(_, 2, "Player name colors are applied around TextOutW; no visual DLL");
	return true;
};

CustomPlayerNameColor.validate = function()
{
	return Exe.BuildDate === 20250716 &&
		typeof ExtNameTextStatic !== "undefined";
};
