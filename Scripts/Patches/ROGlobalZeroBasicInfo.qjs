BasicInfoZeroStatic.hexNorm = function(hex)
{
	return (hex || "").replace(/\s+/g, " ").trim().toUpperCase();
};

BasicInfoZeroStatic.bytesToHex = function(bytes)
{
	return bytes.map(value => (value & 0xFF).toString(16).padStart(2, "0")).join(" ");
};

BasicInfoZeroStatic.asciiBytes = function(text, nulTerminate = true)
{
	const bytes = [];
	for (let i = 0; i < text.length; i++)
		bytes.push(text.charCodeAt(i) & 0xFF);
	if (nulTerminate)
		bytes.push(0);
	return bytes;
};

BasicInfoZeroStatic.findBytes = function(bytes, needle)
{
	for (let i = 0; i <= bytes.length - needle.length; i++)
	{
		let match = true;
		for (let j = 0; j < needle.length; j++)
		{
			if (bytes[i + j] !== needle[j])
			{
				match = false;
				break;
			}
		}
		if (match)
			return i;
	}
	return -1;
};

BasicInfoZeroStatic.readCString = function(virAddr, maxLength)
{
	const phyAddr = Exe.Vir2Phy(virAddr);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroBasicInfo: string 0x${virAddr.toString(16)} is not mapped`);

	const bytes = [];
	for (let i = 0; i < maxLength; i++)
	{
		const value = Exe.GetUint8(phyAddr + i);
		bytes.push(value);
		if (value === 0)
			return bytes;
	}
	throw Error(`ROGlobalZeroBasicInfo: unterminated string at 0x${virAddr.toString(16)}`);
};

BasicInfoZeroStatic.allocateBytes = function(bytes, alignment = 1)
{
	const [phyAddr, virAddr] = Exe.Allocate(bytes.length, alignment);
	Exe.SetHex(phyAddr, BasicInfoZeroStatic.bytesToHex(bytes));
	return [phyAddr, virAddr];
};

BasicInfoZeroStatic.buildResourcePath = function(relativePath)
{
	const source = BasicInfoZeroStatic.readCString(BasicInfoZeroStatic.TabItmFormat, 192);
	const basicNeedle = BasicInfoZeroStatic.asciiBytes("basic_interface\\", false);
	const basicPos = BasicInfoZeroStatic.findBytes(source, basicNeedle);
	if (basicPos < 0)
		throw Error("ROGlobalZeroBasicInfo: texture directory prefix not found");
	return BasicInfoZeroStatic.allocateBytes(
		source.slice(0, basicPos).concat(BasicInfoZeroStatic.asciiBytes(relativePath))
	)[1];
};

// Minimal label-aware x86 emitter. Relative targets are fixed after WARP has
// selected the final virtual address for the allocated code cave.
BasicInfoZeroStatic.asm = function()
{
	const bytes = [];
	const labels = {};
	const fixups = [];

	const put32 = function(out, pos, value)
	{
		const v = value >>> 0;
		out[pos] = v & 0xFF;
		out[pos + 1] = (v >>> 8) & 0xFF;
		out[pos + 2] = (v >>> 16) & 0xFF;
		out[pos + 3] = (v >>> 24) & 0xFF;
	};

	return {
		bytes,
		emit: function(...values)
		{
			for (const value of values)
				bytes.push(value & 0xFF);
		},
		dword: function(value)
		{
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			put32(bytes, pos, value);
		},
		label: function(name)
		{
			if (Object.prototype.hasOwnProperty.call(labels, name))
				throw Error(`ROGlobalZeroBasicInfo: duplicate label ${name}`);
			labels[name] = bytes.length;
		},
		rel32: function(opcode, target)
		{
			bytes.push(opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		call: function(target) { this.rel32(0xE8, target); },
		jmp: function(target) { this.rel32(0xE9, target); },
		jcc: function(opcode, target)
		{
			bytes.push(0x0F, opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		finish: function(baseVir)
		{
			const out = bytes.slice();
			for (const fixup of fixups)
			{
				if (typeof fixup.target === "string" &&
					!Object.prototype.hasOwnProperty.call(labels, fixup.target))
					throw Error(`ROGlobalZeroBasicInfo: unresolved label ${fixup.target}`);
				const targetVir = typeof fixup.target === "string"
					? baseVir + labels[fixup.target]
					: fixup.target;
				const nextVir = baseVir + fixup.pos + 4;
				put32(out, fixup.pos, targetVir - nextVir);
			}
			return BasicInfoZeroStatic.bytesToHex(out);
		}
	};
};

BasicInfoZeroStatic.pushImm = function(a, value)
{
	if (value >= -128 && value <= 127)
		a.emit(0x6A, value);
	else
	{
		a.emit(0x68);
		a.dword(value);
	}
};

BasicInfoZeroStatic.pushLocal = function(a, offset)
{
	a.emit(0x8D, 0x85); a.dword(offset);       // LEA EAX,[EBP+offset]
	a.emit(0x50);                              // PUSH EAX
};

BasicInfoZeroStatic.emitLoadEax = function(a, source)
{
	if (typeof source === "number")
	{
		a.emit(0xA1); a.dword(source);           // MOV EAX,[absolute]
	}
	else
	{
		a.emit(0x8B, 0x85); a.dword(source.local); // MOV EAX,[EBP+local]
	}
};

BasicInfoZeroStatic.emitLoadEcx = function(a, source)
{
	if (typeof source === "number")
	{
		a.emit(0x8B, 0x0D); a.dword(source);     // MOV ECX,[absolute]
	}
	else
	{
		a.emit(0x8B, 0x8D); a.dword(source.local); // MOV ECX,[EBP+local]
	}
};

BasicInfoZeroStatic.emitPushDword = function(a, source)
{
	if (typeof source === "number")
	{
		a.emit(0xFF, 0x35); a.dword(source);     // PUSH [absolute]
	}
	else
	{
		a.emit(0xFF, 0xB5); a.dword(source.local); // PUSH [EBP+local]
	}
};

BasicInfoZeroStatic.emitLoadSurface = function(a, path, missingLabel)
{
	a.call(BasicInfoZeroStatic.GetTexMgr);
	a.emit(0x8B, 0xD8, 0x85, 0xDB);           // MOV EBX,EAX / TEST EBX,EBX
	a.jcc(0x84, missingLabel);                 // JZ missing
	if (path.local)
		BasicInfoZeroStatic.pushLocal(a, path.value);
	else
	{
		a.emit(0x68); a.dword(path.value);
	}
	a.call(BasicInfoZeroStatic.ConvPath);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);     // ADD ESP,4 / TEST EAX,EAX
	a.jcc(0x84, missingLabel);
	a.emit(0x50, 0x8B, 0xCB);                 // PUSH EAX / MOV ECX,EBX
	a.call(BasicInfoZeroStatic.LoadSurface);
	a.emit(0x85, 0xC0);                       // TEST EAX,EAX
	a.jcc(0x84, missingLabel);
};

BasicInfoZeroStatic.emitDrawFull = function(a, pathVir, x, y, label)
{
	const done = `${label}_done`;
	BasicInfoZeroStatic.emitLoadSurface(a, {local: false, value: pathVir}, done);
	BasicInfoZeroStatic.pushImm(a, 0);          // fixed-size PNG (no stretching)
	a.emit(0x50);                              // surface
	BasicInfoZeroStatic.pushImm(a, y);
	BasicInfoZeroStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);                       // MOV ECX,ESI (UIBasicInfoWnd)
	a.call(BasicInfoZeroStatic.ImageDraw);
	a.label(done);
};

// Private source-over crop for the live gradient strips. Shared PNG helpers
// remain unchanged; this routine also handles one-pixel near-empty gauges.
BasicInfoZeroStatic.buildGaugeDraw = function(blend)
{
	const a = BasicInfoZeroStatic.asm();
	// thiscall(x,y,texture,width,height), source x/y=0, preserve source stride.
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x18, 0x53, 0x56, 0x57);
	a.emit(0x8B, 0x71, 0x24, 0x85, 0xF6); a.jcc(0x84, "done");
	a.emit(0x8B, 0x4D, 0x10, 0x85, 0xC9); a.jcc(0x84, "done");
	a.emit(0x8B, 0x46, 0x18, 0x85, 0xC0); a.jcc(0x84, "done");
	a.emit(0x83, 0x7D, 8, 0); a.jcc(0x8C, "done");
	a.emit(0x83, 0x7D, 12, 0); a.jcc(0x8C, "done");
	a.emit(0x8B, 0x81); a.dword(0x114);
	a.emit(0xC1, 0xE0, 2, 0x89, 0x45, 0xF4); // source stride
	a.emit(0x8B, 0x81); a.dword(0x11C);
	a.emit(0x85, 0xC0); a.jcc(0x84, "done");
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0x8B, 0x56, 4, 0x2B, 0x55, 8); // available destination width
	a.emit(0x3B, 0x91); a.dword(0x114); a.jcc(0x8E, "source_width_ready");
	a.emit(0x8B, 0x91); a.dword(0x114);
	a.label("source_width_ready");
	a.emit(0x3B, 0x55, 0x14); a.jcc(0x8E, "width_ready");
	a.emit(0x8B, 0x55, 0x14);
	a.label("width_ready"); a.emit(0x85, 0xD2); a.jcc(0x8E, "done");
	a.emit(0x89, 0x55, 0xF0);
	a.emit(0x8B, 0x56, 8, 0x2B, 0x55, 12);
	a.emit(0x3B, 0x91); a.dword(0x118); a.jcc(0x8E, "source_height_ready");
	a.emit(0x8B, 0x91); a.dword(0x118);
	a.label("source_height_ready");
	a.emit(0x3B, 0x55, 0x18); a.jcc(0x8E, "height_ready");
	a.emit(0x8B, 0x55, 0x18);
	a.label("height_ready"); a.emit(0x85, 0xD2); a.jcc(0x8E, "done");
	a.emit(0x89, 0x55, 0xEC, 0x8B, 0x46, 4, 0xC1, 0xE0, 2, 0x89, 0x45, 0xE8);
	a.emit(0x0F, 0xAF, 0x45, 12, 0x03, 0x46, 0x18, 0x8B, 0x55, 8);
	a.emit(0x8D, 0x04, 0x90, 0x89, 0x45, 0xFC);
	a.label("row"); a.emit(0x8B, 0x7D, 0xFC, 0x33, 0xDB);
	a.label("pixel");
	a.emit(0x8B, 0x55, 0xF8, 0xFF, 0x37, 0xFF, 0x34, 0x9A); a.call(blend);
	a.emit(0x89, 0x07, 0x83, 0xC7, 4, 0x43, 0x3B, 0x5D, 0xF0); a.jcc(0x8C, "pixel");
	a.emit(0x8B, 0x45, 0xF4, 0x01, 0x45, 0xF8, 0x8B, 0x45, 0xE8, 0x01, 0x45, 0xFC);
	a.emit(0xFF, 0x4D, 0xEC); a.jcc(0x85, "row");
	a.emit(0xC6, 0x46, 0x28, 1, 0xC6, 0x46, 0x1C, 1);
	a.label("done"); a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x14, 0);
	return a;
};

BasicInfoZeroStatic.emitDrawPart = function(a, pathVir, x, y, widthOffset, height, label)
{
	const done = label + "_done";
	a.emit(0x83, 0xBD); a.dword(widthOffset); a.emit(0);
	a.jcc(0x8E, done);
	BasicInfoZeroStatic.emitLoadSurface(a, {local: false, value: pathVir}, done);
	BasicInfoZeroStatic.pushImm(a, height);
	a.emit(0xFF, 0xB5); a.dword(widthOffset);
	a.emit(0x50);
	BasicInfoZeroStatic.pushImm(a, y);
	BasicInfoZeroStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE); a.call(BasicInfoZeroStatic.ImageDrawPart);
	a.label(done);
};

// Use a full-width product before division: large live HP values must not
// overflow the signed 32-bit multiplication used by the old narrow HUD.
BasicInfoZeroStatic.emitScaledValue = function(a, current, maximum, scale, label, round = false)
{
	BasicInfoZeroStatic.emitLoadEax(a, current);
	a.emit(0x85, 0xC0); a.jcc(0x8E, label + "_zero");
	BasicInfoZeroStatic.emitLoadEcx(a, maximum);
	a.emit(0x85, 0xC9); a.jcc(0x8E, label + "_zero");
	a.emit(0x3B, 0xC1); a.jcc(0x8D, label + "_full");
	a.emit(0xBA); a.dword(scale);
	a.emit(0xF7, 0xE2); // MUL EDX -> EDX:EAX
	if (round)
	{
		a.emit(0x8B, 0xF9, 0xD1, 0xEF, 0x03, 0xC7, 0x83, 0xD2, 0x00);
	}
	a.emit(0xF7, 0xF1); // DIV ECX
	a.jmp(label + "_done");
	a.label(label + "_full"); a.emit(0xB8); a.dword(scale);
	a.jmp(label + "_done");
	a.label(label + "_zero"); a.emit(0x33, 0xC0);
	a.label(label + "_done");
};

BasicInfoZeroStatic.emitRatioWidth = function(a, current, maximum, output, label)
{
	BasicInfoZeroStatic.emitScaledValue(a, current, maximum,
		BasicInfoZeroStatic.GaugeWidth, label, true);
	a.emit(0x89, 0x85); a.dword(output);
};

BasicInfoZeroStatic.emitTextWidth = function(a, bufferOffset, height, bold)
{
	BasicInfoZeroStatic.pushImm(a, 0);
	BasicInfoZeroStatic.pushImm(a, 0);
	if (typeof height === "number")
		BasicInfoZeroStatic.pushImm(a, height);
	else
		BasicInfoZeroStatic.emitPushDword(a, height);
	BasicInfoZeroStatic.pushImm(a, bold);
	BasicInfoZeroStatic.pushImm(a, 0);
	BasicInfoZeroStatic.pushLocal(a, bufferOffset);
	a.emit(0x8B, 0xCE);
	a.call(BasicInfoZeroStatic.TextWidth);
};

BasicInfoZeroStatic.emitText = function(
	a, bufferOffset, x, y, color, height, bold, storedX = false
)
{
	BasicInfoZeroStatic.pushImm(a, 0);
	BasicInfoZeroStatic.pushImm(a, 0);
	BasicInfoZeroStatic.pushImm(a, color);
	if (typeof height === "number")
		BasicInfoZeroStatic.pushImm(a, height);
	else
		BasicInfoZeroStatic.emitPushDword(a, height);
	BasicInfoZeroStatic.pushImm(a, bold);
	BasicInfoZeroStatic.pushImm(a, 0);
	BasicInfoZeroStatic.pushLocal(a, bufferOffset);
	BasicInfoZeroStatic.pushImm(a, y);
	if (storedX)
	{
		a.emit(0xFF, 0xB5); a.dword(x);         // PUSH [EBP+x]
	}
	else
		BasicInfoZeroStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(BasicInfoZeroStatic.TextDraw);
};

BasicInfoZeroStatic.emitValueRow = function(
	a, currentSource, maximumSource, formats, y, label
)
{
	// Draw the HP/SP/AP label separately from the centered live values.
	a.emit(0x68); a.dword(formats[label]);
	BasicInfoZeroStatic.pushLocal(a, BasicInfoZeroStatic.ValueBuffer);
	a.call(BasicInfoZeroStatic.Sprintf); a.emit(0x83, 0xC4, 0x08);
	BasicInfoZeroStatic.emitText(a, BasicInfoZeroStatic.ValueBuffer,
		70, y, BasicInfoZeroStatic.White, 11, 0);
	BasicInfoZeroStatic.emitPushDword(a, maximumSource);
	BasicInfoZeroStatic.emitPushDword(a, currentSource);
	a.emit(0x68); a.dword(formats.value);
	BasicInfoZeroStatic.pushLocal(a, BasicInfoZeroStatic.ValueBuffer);
	a.call(BasicInfoZeroStatic.Sprintf); a.emit(0x83, 0xC4, 0x10);
	const font = {local: BasicInfoZeroStatic.TextHeight};
	a.emit(0xC7, 0x85); a.dword(font.local); a.dword(11);
	a.label(label + "_fit_value");
	BasicInfoZeroStatic.emitTextWidth(a, BasicInfoZeroStatic.ValueBuffer, font, 0);
	a.emit(0x3D); a.dword(142); a.jcc(0x8E, label + "_value_ready");
	a.emit(0x83, 0xBD); a.dword(font.local); a.emit(8);
	a.jcc(0x8E, label + "_value_ready");
	a.emit(0xFF, 0x8D); a.dword(font.local);
	a.jmp(label + "_fit_value");
	a.label(label + "_value_ready");
	a.emit(0xD1, 0xF8, 0xBA); a.dword(165); // center of x=94..236
	a.emit(0x2B, 0xD0, 0x89, 0x95); a.dword(BasicInfoZeroStatic.TextX);
	BasicInfoZeroStatic.emitText(a, BasicInfoZeroStatic.ValueBuffer,
		BasicInfoZeroStatic.TextX, y, BasicInfoZeroStatic.White, font, 0, true);
	BasicInfoZeroStatic.emitScaledValue(a, currentSource, maximumSource, 100,
		label + "_percent");
	a.emit(0x50, 0x68); a.dword(formats.percent);
	BasicInfoZeroStatic.pushLocal(a, BasicInfoZeroStatic.PercentBuffer);
	a.call(BasicInfoZeroStatic.Sprintf); a.emit(0x83, 0xC4, 0x0C);
	BasicInfoZeroStatic.emitTextWidth(a, BasicInfoZeroStatic.PercentBuffer, 11, 0);
	a.emit(0xBA); a.dword(274);
	a.emit(0x2B, 0xD0, 0x89, 0x95); a.dword(BasicInfoZeroStatic.TextX);
	BasicInfoZeroStatic.emitText(a, BasicInfoZeroStatic.PercentBuffer,
		BasicInfoZeroStatic.TextX, y, BasicInfoZeroStatic.White, 11, 0, true);
};

BasicInfoZeroStatic.buildCompactDraw = function(
	paths, formats, exitVir, fallbackVir, fallbackKind, themeStateVir, loadThemeVir,
	jobChildOffset, basicInfoOffset
)
{
	const a = BasicInfoZeroStatic.asm();
	a.call(loadThemeVir);
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x85, "renewal");
	if (fallbackKind === "classic")
	{
		a.emit(0x8D, 0x85, 0x34, 0xFF, 0xFF, 0xFF);
		a.emit(0xB9); a.dword(0x011FE3A8);
	}
	else
	{
		a.emit(0x8B, 0xCB);
		a.call(0x0095DA30);
	}
	a.jmp(fallbackVir);
	a.label("renewal");
	a.emit(0x9C, 0x60);                       // PUSHFD / PUSHAD
	a.emit(0x81, 0xEC); a.dword(BasicInfoZeroStatic.LocalSize);
	a.emit(0x8B, 0xEC);                       // MOV EBP,ESP (stable cave locals)
	a.emit(0x8B, 0xF3, 0x85, 0xF6);          // MOV ESI,EBX / TEST ESI,ESI
	a.jcc(0x84, "restore");
	// The reference HUD has no opaque 220x55 basic_bg_mini underlay. The two
	// stock title buttons remain separate native children; their visibility is
	// synchronized to the active theme by the parent Draw wrapper.
	// The Job icon is not painted into this parent renderer. A genuine
	// UIJobIconButton child owns its own render context, clipping, position,
	// and z-order and draws after the parent HP/SP/AP composition.

	// AllowAPBarforAllJobs populates the same native stat map used by the
	// fourth-Job renderer. Read SP_AP/SP_MAXAP through that client-owned map
	// instead of duplicating packet state or depending on private globals.
	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.CurrentAPStat);
	a.emit(0xB9); a.dword(BasicInfoZeroStatic.Session);
	a.call(BasicInfoZeroStatic.GetStatusPoint);
	a.emit(0x89, 0x85); a.dword(BasicInfoZeroStatic.CurrentAP);
	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.MaximumAPStat);
	a.emit(0xB9); a.dword(BasicInfoZeroStatic.Session);
	a.call(BasicInfoZeroStatic.GetStatusPoint);
	a.emit(0x89, 0x85); a.dword(BasicInfoZeroStatic.MaximumAP);

	// The stock selector contract is SP_AP=0xE8 and SP_MAXAP=0xE9. Some
	// non-fourth Job sessions exposed by AllowAPBarforAllJobs deliver the
	// impossible transient pair current>0/max<=0 (live capture: 200/0).
	// The server's all-Job BaseAp overlay is 200, so preserve current and supply
	// only the missing maximum. Valid native pairs remain untouched.
	a.emit(0x8B, 0x85); a.dword(BasicInfoZeroStatic.MaximumAP);
	a.emit(0x85, 0xC0);
	a.jcc(0x8F, "ap_values_ready");             // JG
	a.emit(0xC7, 0x85); a.dword(BasicInfoZeroStatic.MaximumAP);
	a.dword(BasicInfoZeroStatic.MissingAPMaximum);
	a.label("ap_values_ready");

	// Recompose from transparent pixels, so old values/fills cannot persist.
	BasicInfoZeroStatic.pushImm(a, 0);
	a.emit(0x8B, 0xCE); a.call(BasicInfoZeroStatic.ClearSurface);
	BasicInfoZeroStatic.emitDrawFull(a, paths.background, 0, 0, "background");
	BasicInfoZeroStatic.emitRatioWidth(a, BasicInfoZeroStatic.CurrentHP,
		BasicInfoZeroStatic.MaximumHP, BasicInfoZeroStatic.HPWidth, "hp_width");
	BasicInfoZeroStatic.emitScaledValue(a, BasicInfoZeroStatic.CurrentHP,
		BasicInfoZeroStatic.MaximumHP, 100, "hp_color");
	a.emit(0x83, 0xF8, 25); a.jcc(0x8F, "hp_green");
	BasicInfoZeroStatic.emitDrawPart(a, paths.hpRed, BasicInfoZeroStatic.GaugeX,
		BasicInfoZeroStatic.HPY, BasicInfoZeroStatic.HPWidth, BasicInfoZeroStatic.HPHeight, "hp_red");
	a.jmp("hp_ready");
	a.label("hp_green");
	BasicInfoZeroStatic.emitDrawPart(a, paths.hp, BasicInfoZeroStatic.GaugeX,
		BasicInfoZeroStatic.HPY, BasicInfoZeroStatic.HPWidth, BasicInfoZeroStatic.HPHeight, "hp_green");
	a.label("hp_ready");
	BasicInfoZeroStatic.emitRatioWidth(a, BasicInfoZeroStatic.CurrentSP,
		BasicInfoZeroStatic.MaximumSP, BasicInfoZeroStatic.SPWidth, "sp_width");
	BasicInfoZeroStatic.emitDrawPart(a, paths.sp, BasicInfoZeroStatic.GaugeX,
		BasicInfoZeroStatic.SPY, BasicInfoZeroStatic.SPWidth, BasicInfoZeroStatic.SPHeight, "sp");
	BasicInfoZeroStatic.emitRatioWidth(a, {local: BasicInfoZeroStatic.CurrentAP},
		{local: BasicInfoZeroStatic.MaximumAP}, BasicInfoZeroStatic.APWidth, "ap_width");
	BasicInfoZeroStatic.emitDrawPart(a, paths.ap, BasicInfoZeroStatic.GaugeX,
		BasicInfoZeroStatic.APY, BasicInfoZeroStatic.APWidth, BasicInfoZeroStatic.APHeight, "ap");
	// Restore the supplied rounded borders over the clipped gradient fills.
	BasicInfoZeroStatic.emitDrawFull(a, paths.gauge,
		BasicInfoZeroStatic.GaugeFrameX, BasicInfoZeroStatic.GaugeFrameY, "gauge");

	// The stock compact name child at +C0 is drawn after this parent and would
	// overlap the custom level/name title. Keep that child off-canvas while the
	// Alt+V selector below holds the window in compact mode.
	a.emit(0x8B, 0x8E); a.dword(BasicInfoZeroStatic.NameControlOffset);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "stock_name_hidden");
	a.emit(0x8B, 0x01);                       // MOV EAX,[ECX]
	BasicInfoZeroStatic.pushImm(a, -100);
	BasicInfoZeroStatic.pushImm(a, -100);
	a.emit(0xFF, 0x50, 0x10);                 // CALL [EAX+10] (SetPosition)
	a.label("stock_name_hidden");

	// The decoded native name remains authoritative. Fit a long UTF-8 name
	// to the 132px name strip, trimming only at character boundaries.
	a.emit(0xB9); a.dword(BasicInfoZeroStatic.Session);
	a.call(BasicInfoZeroStatic.GetCharacterName);
	a.emit(0x50, 0x68); a.dword(formats.name);
	BasicInfoZeroStatic.pushLocal(a, BasicInfoZeroStatic.NameBuffer);
	a.call(BasicInfoZeroStatic.Sprintf); a.emit(0x83, 0xC4, 0x0C);
	BasicInfoZeroStatic.emitTextWidth(a, BasicInfoZeroStatic.NameBuffer, 11, 0);
	a.emit(0x3D); a.dword(132); a.jcc(0x8E, "name_ready");
	a.emit(0x33, 0xFF); // EDI=byte length
	a.label("name_length");
	a.emit(0x80, 0x7C, 0x3D, 0x00, 0x00); a.jcc(0x84, "name_trim");
	a.emit(0x47); a.jmp("name_length");
	a.label("name_trim");
	a.emit(0x4F, 0x85, 0xFF); a.jcc(0x8E, "name_ellipsis");
	a.emit(0x8A, 0x44, 0x3D, 0x00, 0x24, 0xC0, 0x3C, 0x80);
	a.jcc(0x84, "name_trim");
	a.label("name_ellipsis");
	a.emit(0xC7, 0x44, 0x3D, 0x00); a.dword(0x002E2E2E);
	BasicInfoZeroStatic.emitTextWidth(a, BasicInfoZeroStatic.NameBuffer, 11, 0);
	a.emit(0x3D); a.dword(132); a.jcc(0x8F, "name_trim");
	a.label("name_ready");
	BasicInfoZeroStatic.emitText(a, BasicInfoZeroStatic.NameBuffer,
		BasicInfoZeroStatic.TitleX, BasicInfoZeroStatic.TitleY,
		BasicInfoZeroStatic.White, 11, 0);
	BasicInfoZeroStatic.emitValueRow(a, BasicInfoZeroStatic.CurrentHP,
		BasicInfoZeroStatic.MaximumHP, formats, 25, "hp");
	BasicInfoZeroStatic.emitValueRow(a, BasicInfoZeroStatic.CurrentSP,
		BasicInfoZeroStatic.MaximumSP, formats, 40, "sp");
	BasicInfoZeroStatic.emitValueRow(a, {local: BasicInfoZeroStatic.CurrentAP},
		{local: BasicInfoZeroStatic.MaximumAP}, formats, 54, "ap");

	a.emit(0x8B, 0xCE); a.call(BasicInfoZeroStatic.FinalizePixels);

	// Refresh the live level badge when the parent redraws (including level-up).
	// Only touch the child belonging to this exact Basic Info instance.
	a.emit(0x3B, 0x35); a.dword(themeStateVir + basicInfoOffset);
	a.jcc(0x85, "restore");
	a.emit(0x8B, 0x0D); a.dword(themeStateVir + jobChildOffset);
	a.emit(0x85, 0xC9); a.jcc(0x84, "restore");
	a.emit(0x8B, 0x01, 0xFF, 0x50, 0x50);

	a.label("restore");
	a.emit(0x8B, 0xE5);                       // MOV ESP,EBP
	a.emit(0x81, 0xC4); a.dword(BasicInfoZeroStatic.LocalSize);
	a.emit(0x61, 0x9D);                       // POPAD / POPFD
	a.jmp(exitVir);
	return a;
};

BasicInfoZeroStatic.emitJobSurfaceTry = function(
	a, formatVir, jobOffset, drawOffset, missingLabel
)
{
	// Format into the shared 256-byte local buffer, normalize through the
	// client's texture path converter, and leave the loaded surface in EAX.
	a.emit(0xFF, 0xB5); a.dword(jobOffset);       // PUSH [EBP+job]
	a.emit(0x68); a.dword(formatVir);
	a.emit(0x8D, 0x85); a.dword(-0x100);
	a.emit(0x50);
	a.call(BasicInfoZeroStatic.Sprintf);
	a.emit(0x83, 0xC4, 0x0C);
	a.emit(0x8D, 0x85); a.dword(-0x100);
	a.emit(0x50);
	a.call(BasicInfoZeroStatic.ConvPath);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, missingLabel);
	a.emit(0x50, 0x8B, 0xCB);                  // PUSH path / ECX=TexMgr
	a.call(BasicInfoZeroStatic.LoadSurface);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, missingLabel);
	a.emit(0xBE); a.dword(drawOffset);           // supplied artwork is drawn at its intrinsic size
	a.jmp("draw_surface");
};

BasicInfoZeroStatic.buildJobChildDraw = function(jobFormats, themeStateVir)
{
	const rawJob = -0x104;
	const aliasJob = -0x108;
	const a = BasicInfoZeroStatic.asm();
	a.emit(0x55, 0x8B, 0xEC);                   // PUSH EBP / MOV EBP,ESP
	a.emit(0x81, 0xEC); a.dword(0x110);         // path buffer + resolver locals
	a.emit(0x53, 0x56, 0x57, 0x8B, 0xF9);     // preserve regs / EDI=this child
	// The Job icon owns a persistent child surface. Clear it on every draw so
	// switching to Classic cannot leave the last renewal icon cached onscreen.
	BasicInfoZeroStatic.pushImm(a, 0);
	a.emit(0x8B, 0xCF);
	a.call(BasicInfoZeroStatic.ClearSurface);
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "done");

	// Preserve the raw client job ID. GetJobId intentionally is not used here:
	// it collapses mounted/costume identities and caused mismatched resources.
	a.emit(0xA1); a.dword(BasicInfoZeroStatic.CurrentJob);
	a.emit(0x89, 0x85); a.dword(rawJob);
	a.call(BasicInfoZeroStatic.GetTexMgr);
	a.emit(0x8B, 0xD8, 0x85, 0xDB);            // EBX=TexMgr
	a.jcc(0x84, "done");

	// Supplied circular art: exact job, lineage alias, then Novice.
	BasicInfoZeroStatic.emitJobSurfaceTry(
		a, jobFormats.big, rawJob, 0, "resolve_alias"
	);

	a.label("resolve_alias");
	a.emit(0x8B, 0x85); a.dword(rawJob);          // EAX=raw ID
	for (let index = 0; index < BasicInfoZeroStatic.JobAliases.length; index++)
	{
		const alias = BasicInfoZeroStatic.JobAliases[index];
		a.emit(0x3D); a.dword(alias[0]);
		a.jcc(0x84, `alias_${index}`);
	}
	a.emit(0x33, 0xC0);                          // no alias
	a.jmp("alias_ready");
	for (let index = 0; index < BasicInfoZeroStatic.JobAliases.length; index++)
	{
		const alias = BasicInfoZeroStatic.JobAliases[index];
		a.label(`alias_${index}`);
		a.emit(0xB8); a.dword(alias[1]);
		a.jmp("alias_ready");
	}
	a.label("alias_ready");
	a.emit(0x89, 0x85); a.dword(aliasJob);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "novice_fallback");
	BasicInfoZeroStatic.emitJobSurfaceTry(
		a, jobFormats.big, aliasJob, 0, "novice_fallback"
	);

	a.label("novice_fallback");
	a.emit(0xC7, 0x85); a.dword(aliasJob); a.dword(0);
	BasicInfoZeroStatic.emitJobSurfaceTry(a, jobFormats.big, aliasJob, 0, "level_badge");

	a.label("draw_surface");
	BasicInfoZeroStatic.pushImm(a, 0);           // fixed-size PNG
	a.emit(0x50);                                // surface
	a.emit(0x56, 0x56);                          // centered Y / X
	a.emit(0x8B, 0xCF);                         // MOV ECX,EDI
	a.call(BasicInfoZeroStatic.ImageDraw);

	// Draw badge after the circle in the same child, so it cannot be covered
	// by the later native child composition. Its height includes the badge.
	a.label("level_badge");
	a.emit(0x8B, 0xF7); // ESI=this child for shared image/text helpers
	BasicInfoZeroStatic.emitDrawFull(a, jobFormats.level, 10, 51, "level_frame");
	a.emit(0xFF, 0x35); a.dword(BasicInfoZeroStatic.JobLevel);
	a.emit(0xFF, 0x35); a.dword(BasicInfoZeroStatic.BaseLevel);
	a.emit(0x68); a.dword(jobFormats.levelFormat);
	BasicInfoZeroStatic.pushLocal(a, -0x100);
	a.call(BasicInfoZeroStatic.Sprintf); a.emit(0x83, 0xC4, 0x10);
	BasicInfoZeroStatic.emitTextWidth(a, -0x100, 11, 0);
	a.emit(0xD1, 0xF8, 0xBA); a.dword(33);
	a.emit(0x2B, 0xD0, 0x89, 0x95); a.dword(-0x110);
	BasicInfoZeroStatic.emitText(a, -0x100, -0x110, 53,
		BasicInfoZeroStatic.White, 11, 0, true);

	a.label("done");
	a.emit(0x8B, 0xCF); a.call(BasicInfoZeroStatic.FinalizePixels);
	a.emit(0x5F, 0x5E, 0x5B);                   // POP EDI / ESI / EBX
	a.emit(0x8B, 0xE5, 0x5D, 0xC3);             // restore frame / RET
	return a;
};

BasicInfoZeroStatic.buildJobChildDestructor = function(themeStateVir, jobChildOffset)
{
	const a = BasicInfoZeroStatic.asm();
	a.emit(0x3B, 0x0D); a.dword(themeStateVir + jobChildOffset);
	a.jcc(0x85, "pass");
	a.emit(0xC7, 0x05); a.dword(themeStateVir + jobChildOffset); a.dword(0);
	a.label("pass");
	a.jmp(BasicInfoZeroStatic.JobButtonDestructor);
	return a;
};

BasicInfoZeroStatic.cloneJobButtonVtable = function(
	childDrawVir, childHoverVir, childDestructorVir
)
{
	const jobPhy = Exe.Vir2Phy(BasicInfoZeroStatic.JobButtonVtable);
	const basePhy = Exe.Vir2Phy(BasicInfoZeroStatic.ImageButtonVtable);
	if (jobPhy < 0 || basePhy < 0)
		throw Error("ROGlobalZeroBasicInfo: Job button vtable is not mapped");

	const byteCount = BasicInfoZeroStatic.JobButtonVtableEntries * 4;
	const [clonePhy, cloneVir] = Exe.Allocate(byteCount, 4);
	Exe.SetHex(clonePhy, Exe.GetHex(jobPhy, byteCount));

	// Keep the real UIJobIconButton inherited lifecycle, but clear our shared
	// pointer before its deleting destructor runs and give this instance the
	// independent renderer above. Its Job-specific
	// input overrides dispatch to unrelated stock windows, so use the neutral
	// UIImgButton handlers for this display-only child.
	Exe.SetUint32(clonePhy, childDestructorVir);
	Exe.SetUint32(clonePhy + 20 * 4, childDrawVir);
	Exe.SetUint32(clonePhy + 28 * 4, childHoverVir);
	for (const slot of [25, 31, 33])
		Exe.SetUint32(clonePhy + slot * 4, Exe.GetUint32(basePhy + slot * 4));

	return {phy: clonePhy, vir: cloneVir, size: byteCount};
};

BasicInfoZeroStatic.buildFactorySize = function(themeStateVir, loadThemeVir)
{
	const a = BasicInfoZeroStatic.asm();
	a.emit(0x55, 0x8B, 0xEC);                 // frame
	a.emit(0x56);                             // preserve ESI
	a.emit(0x8B, 0xF1);                       // ESI=UIBasicInfoWnd
	a.call(loadThemeVir);

	// This wrapper replaces only the factory call to UIWindow::SetWindowSize.
	// Native vtable slot 15 performs child creation later, so do not attach the
	// Job child here: its early registration is discarded by native OnCreate.
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "classic_size");
	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.PanelHeight);
	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.PanelWidth);
	a.jmp("set_size");
	a.label("classic_size");
	a.emit(0xFF, 0xB6); a.dword(0xB8);         // stock expanded height
	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.ClassicPanelWidth);
	a.label("set_size");
	a.emit(0x8B, 0xCE);
	a.call(BasicInfoZeroStatic.SetWindowSize);
	a.emit(0x5E, 0x8B, 0xE5, 0x5D);
	a.emit(0xC2, 0x08, 0x00);                 // RET 8, matching SetWindowSize
	return a;
};

BasicInfoZeroStatic.buildCreateWrapper = function(
	jobVtableVir, themeStateVir, loadThemeVir, jobChildOffset, basicInfoOffset
)
{
	const a = BasicInfoZeroStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.emit(0x8B, 0xF1);                       // ESI=UIBasicInfoWnd
	a.call(loadThemeVir);

	// Let native OnCreate build and lay out every stock child first. Its child
	// list initialization is why the former factory-time Job child disappeared
	// on the first login until Character Select rebuilt the window.
	a.emit(0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08, 0x8B, 0xCE);
	a.call(BasicInfoZeroStatic.WindowCreateOriginal);
	a.emit(0x8B, 0xD8);                       // EBX=native return value

	// Reuse only a child owned by this exact Basic Info instance. Character
	// Select can create the replacement parent before the old parent finishes
	// destruction, so a non-null child pointer alone is not sufficient.
	a.emit(0x3B, 0x35); a.dword(themeStateVir + basicInfoOffset);
	a.jcc(0x85, "new_parent");
	a.emit(0x83, 0x3D); a.dword(themeStateVir + jobChildOffset); a.emit(0x00);
	a.jcc(0x85, "redraw");
	a.jmp("create");
	a.label("new_parent");
	a.emit(0x89, 0x35); a.dword(themeStateVir + basicInfoOffset);
	a.emit(0xC7, 0x05); a.dword(themeStateVir + jobChildOffset); a.dword(0);
	a.label("create");
	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.JobButtonObjectSize);
	a.call(BasicInfoZeroStatic.OperatorNew);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0xF8, 0x8B, 0xCF);
	a.call(BasicInfoZeroStatic.JobButtonConstructor);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0xF8);
	a.emit(0xC7, 0x07); a.dword(jobVtableVir);

	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.PanelHeight);
	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.JobIconSize);
	a.emit(0x8B, 0xCF);
	a.call(BasicInfoZeroStatic.SetWindowSize);
	a.emit(0x8B, 0x07);
	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.JobIconY);
	BasicInfoZeroStatic.pushImm(a, BasicInfoZeroStatic.JobIconX);
	a.emit(0x8B, 0xCF, 0xFF, 0x50, 0x10);
	a.emit(0x89, 0x3D); a.dword(themeStateVir + jobChildOffset);
	a.emit(0x57, 0x8B, 0xCE);
	a.call(BasicInfoZeroStatic.AddChild);

	// Populate or clear the cached surface immediately for the active theme.
	a.label("redraw");
	a.emit(0x8B, 0x0D); a.dword(themeStateVir + jobChildOffset);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x01, 0xFF, 0x50, 0x50);
	a.label("done");
	a.emit(0x8B, 0xC3, 0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D);
	a.emit(0xC2, 0x08, 0x00);
	return a;
};

BasicInfoZeroStatic.buildCompactToggle = function(themeStateVir, loadThemeVir)
{
	const a = BasicInfoZeroStatic.asm();
	a.call(loadThemeVir);
	a.emit(0x8B, 0x86); a.dword(0xB4);          // stock compact height
	a.emit(0x57, 0x8B, 0x7E, 0x18);            // PUSH EDI / current height
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x85, "target_ready");                // New UI always remains compact
	a.emit(0x3B, 0xF8);                         // Classic UI preserves Alt+V
	a.jcc(0x85, "target_ready");
	a.emit(0x8B, 0x86); a.dword(0xB8);          // stock expanded height
	a.label("target_ready");
	a.emit(0x50);
	a.jmp(BasicInfoZeroStatic.CompactToggleResume);
	return a;
};

BasicInfoZeroStatic.emitTitleButtonVisibility = function(
	a, themeStateVir, prefix
)
{
	a.emit(0x85, 0xC0);
	a.jcc(0x84, prefix + "_done");
	a.emit(0xBA); a.dword(1);                    // Classic visible
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, prefix + "_apply");
	a.emit(0x33, 0xD2);                          // New UI hidden
	a.label(prefix + "_apply");
	a.emit(0x39, 0x50, 0x28);                    // visibility already correct?
	a.jcc(0x84, prefix + "_done");
	a.emit(0x89, 0x50, 0x28);                    // direct visible state
	a.emit(0xC7, 0x40, 0x58); a.dword(1);        // request native redraw
	a.label(prefix + "_done");
};

BasicInfoZeroStatic.buildTitleButtonCreate = function(
	originalVir, buttonStateVir, resumeVir, argumentBytes
)
{
	const a = BasicInfoZeroStatic.asm();
	if (argumentBytes === 8)
	{
		a.emit(0x55, 0x8B, 0xEC);               // preserve caller argument frame
		a.emit(0xFF, 0x75, 0x0C);               // forward arg2
		a.emit(0xFF, 0x75, 0x08);               // forward arg1
	}
	else if (argumentBytes !== 0)
	{
		throw Error(
			"ROGlobalZeroBasicInfo: unsupported title-button argument size"
		);
	}
	// Both stock sites have already preserved UIBasicInfoWnd in EDI.
	a.emit(0x8B, 0xCF);                         // MOV ECX,EDI
	a.call(originalVir);
	a.emit(0xA3); a.dword(buttonStateVir);
	if (resumeVir)
	{
		if (argumentBytes !== 0)
			throw Error("ROGlobalZeroBasicInfo: jump wrapper cannot own arguments");
		a.jmp(resumeVir);
	}
	else if (argumentBytes === 8)
	{
		a.emit(0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00); // RET 8
	}
	else
		a.emit(0xC3);
	return a;
};

BasicInfoZeroStatic.buildDrawLifecycleGuard = function(
	themeStateVir, loadThemeVir, titleButtonStateVir
)
{
	const a = BasicInfoZeroStatic.asm();
	a.emit(0x56, 0x8B, 0xF1);                   // preserve ESI / ESI=this
	a.call(loadThemeVir);
	// Creation can precede the final persisted-theme load. Reconcile both
	// stock controls every frame so startup and live theme switches converge.
	a.emit(0xA1); a.dword(titleButtonStateVir);
	BasicInfoZeroStatic.emitTitleButtonVisibility(
		a, themeStateVir, "base_button"
	);
	a.emit(0xA1); a.dword(titleButtonStateVir + 4);
	BasicInfoZeroStatic.emitTitleButtonVisibility(
		a, themeStateVir, "mini_button"
	);
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "draw");                       // Classic UI keeps native state
	a.emit(0x81, 0x7E, 0x14); a.dword(BasicInfoZeroStatic.PanelWidth);
	a.jcc(0x85, "resize");
	a.emit(0x8B, 0x86); a.dword(0xB4);          // configured compact height
	a.emit(0x39, 0x46, 0x18);                   // current height already compact?
	a.jcc(0x84, "draw");
	a.label("resize");
	a.emit(0xC7, 0x46, 0x14); a.dword(BasicInfoZeroStatic.PanelWidth);
	a.emit(0xFF, 0xB6); a.dword(0xB4);
	a.emit(0x8B, 0xCE);
	a.call(BasicInfoZeroStatic.BasicInfoResize);
	a.label("draw");
	a.emit(0x8B, 0xCE, 0x5E);
	a.jmp(BasicInfoZeroStatic.WindowDrawOriginal);
	return a;
};

BasicInfoZeroStatic.buildJobChildHover = function(themeStateVir, tooltips)
{
	const a = BasicInfoZeroStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x08); // EBP frame, two POINT locals
	a.emit(0x56, 0x57, 0x8B, 0xF1);             // preserve ESI/EDI; ESI=this
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "done");

	// The registered child receives its own local mouse coordinates. Keeping
	// the hit test here avoids relying on the parent handler, which is bypassed
	// whenever UI dispatch selects the child first.
	a.emit(0x8B, 0x45, 0x08);                   // X
	a.emit(0x85, 0xC0);
	a.jcc(0x88, "done");                        // JS
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.JobIconSize);
	a.jcc(0x8D, "done");                        // JGE
	a.emit(0x8B, 0x45, 0x0C);                   // Y
	a.emit(0x85, 0xC0);
	a.jcc(0x88, "done");
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.PanelHeight);
	a.jcc(0x8D, "done");

	// The enlarged Job child overlaps the left edge of all three gauges. Parent
	// dispatch selects the child first, so route those overlapping pixels to
	// the matching gauge tooltip before falling back to the native Job name.
	a.emit(0x8B, 0x45, 0x08);
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.GaugeX -
		BasicInfoZeroStatic.JobIconX);
	a.jcc(0x8C, "job_tooltip");                  // JL
	a.emit(0x8B, 0x45, 0x0C);
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.HPY -
		BasicInfoZeroStatic.JobIconY);
	a.jcc(0x8C, "job_tooltip");
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.HPY +
		BasicInfoZeroStatic.HPHeight - BasicInfoZeroStatic.JobIconY);
	a.jcc(0x8C, "hp_tooltip");
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.SPY -
		BasicInfoZeroStatic.JobIconY);
	a.jcc(0x8C, "job_tooltip");
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.SPY +
		BasicInfoZeroStatic.SPHeight - BasicInfoZeroStatic.JobIconY);
	a.jcc(0x8C, "sp_tooltip");
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.APY -
		BasicInfoZeroStatic.JobIconY);
	a.jcc(0x8C, "job_tooltip");
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.APY +
		BasicInfoZeroStatic.APHeight - BasicInfoZeroStatic.JobIconY);
	a.jcc(0x8D, "job_tooltip");
	a.emit(0xBF); a.dword(tooltips.ap);
	a.jmp("show_tooltip");
	a.label("hp_tooltip");
	a.emit(0xBF); a.dword(tooltips.hp);
	a.jmp("show_tooltip");
	a.label("sp_tooltip");
	a.emit(0xBF); a.dword(tooltips.sp);
	a.jmp("show_tooltip");

	// Use the same effective Job ID/name path as the stock expanded panel. It
	// keeps mounted/transformed sprites mapped to the user-facing Job name.
	a.label("job_tooltip");
	a.emit(0xB9); a.dword(BasicInfoZeroStatic.Session);
	a.call(BasicInfoZeroStatic.GetJobId);
	BasicInfoZeroStatic.pushImm(a, -1);
	a.emit(0x50);
	a.emit(0xB9); a.dword(BasicInfoZeroStatic.Session);
	a.call(BasicInfoZeroStatic.GetJobName);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0xF8);                         // EDI=Job-name pointer

	// Match the Inventory hover placement: immediately above and to the right
	// of the live mouse pointer, converted through this child window.
	a.label("show_tooltip");
	a.emit(0x8B, 0x45, 0x08);                   // child-local mouse X
	a.emit(0x83, 0xC0, BasicInfoZeroStatic.TooltipXOffset);
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0x8B, 0x45, 0x0C);                   // child-local mouse Y
	a.emit(0x83, 0xC0, BasicInfoZeroStatic.TooltipYOffset);
	a.emit(0x89, 0x45, 0xFC);
	a.emit(0x8D, 0x45, 0xFC, 0x50);             // PUSH &Y
	a.emit(0x8D, 0x45, 0xF8, 0x50);             // PUSH &X
	a.emit(0x8B, 0xCE);
	a.call(BasicInfoZeroStatic.ClientToScreen);
	a.emit(0x8B, 0x0D); a.dword(BasicInfoZeroStatic.TooltipManager);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "done");
	BasicInfoZeroStatic.pushImm(a, 1);
	BasicInfoZeroStatic.pushImm(a, 0);
	BasicInfoZeroStatic.pushImm(a, -1);
	a.emit(0xFF, 0x75, 0xFC);                   // screen Y
	a.emit(0xFF, 0x75, 0xF8);                   // screen X
	a.emit(0x57);                               // Job-name pointer
	a.call(BasicInfoZeroStatic.ShowTooltip);

	a.label("done");
	a.emit(0x5F, 0x5E, 0x8B, 0xE5, 0x5D);       // restore EDI/ESI/frame
	a.emit(0xC2, 0x08, 0x00);
	return a;
};

BasicInfoZeroStatic.buildBarHover = function(themeStateVir, tooltips)
{
	const a = BasicInfoZeroStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x08); // EBP frame, two POINT locals
	a.emit(0x56, 0x57, 0x8B, 0xF1);             // preserve ESI/EDI; ESI=this
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "pass");
	a.emit(0x8B, 0x46, 0x18);                   // current parent height
	a.emit(0x3B, 0x86); a.dword(0xB4);          // compact height
	a.jcc(0x85, "pass");

	a.emit(0x8B, 0x45, 0x08);                   // X
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.GaugeX);
	a.jcc(0x8C, "pass");
	a.emit(0x3D); a.dword(
		BasicInfoZeroStatic.GaugeX + BasicInfoZeroStatic.GaugeWidth
	);
	a.jcc(0x8D, "pass");

	a.emit(0x8B, 0x45, 0x0C);                   // Y
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.HPY);
	a.jcc(0x8C, "pass");
	a.emit(0x83, 0xF8,
		BasicInfoZeroStatic.HPY + BasicInfoZeroStatic.HPHeight);
	a.jcc(0x8C, "hp_tooltip");
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.SPY);
	a.jcc(0x8C, "pass");
	a.emit(0x83, 0xF8,
		BasicInfoZeroStatic.SPY + BasicInfoZeroStatic.SPHeight);
	a.jcc(0x8C, "sp_tooltip");
	a.emit(0x83, 0xF8, BasicInfoZeroStatic.APY);
	a.jcc(0x8C, "pass");
	a.emit(0x83, 0xF8,
		BasicInfoZeroStatic.APY + BasicInfoZeroStatic.APHeight);
	a.jcc(0x8D, "pass");
	a.emit(0xBF); a.dword(tooltips.ap);
	a.jmp("show");
	a.label("hp_tooltip");
	a.emit(0xBF); a.dword(tooltips.hp);
	a.jmp("show");
	a.label("sp_tooltip");
	a.emit(0xBF); a.dword(tooltips.sp);

	a.label("show");
	// Match the Inventory hover placement from the live parent-local pointer.
	a.emit(0x8B, 0x45, 0x08);
	a.emit(0x83, 0xC0, BasicInfoZeroStatic.TooltipXOffset);
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0x8B, 0x45, 0x0C);
	a.emit(0x83, 0xC0, BasicInfoZeroStatic.TooltipYOffset);
	a.emit(0x89, 0x45, 0xFC);
	a.emit(0x8D, 0x45, 0xFC, 0x50);
	a.emit(0x8D, 0x45, 0xF8, 0x50);
	a.emit(0x8B, 0xCE);
	a.call(BasicInfoZeroStatic.ClientToScreen);
	a.emit(0x8B, 0x0D); a.dword(BasicInfoZeroStatic.TooltipManager);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "done");
	BasicInfoZeroStatic.pushImm(a, 1);
	BasicInfoZeroStatic.pushImm(a, 0);
	BasicInfoZeroStatic.pushImm(a, -1);
	a.emit(0xFF, 0x75, 0xFC);
	a.emit(0xFF, 0x75, 0xF8);
	a.emit(0x57);
	a.call(BasicInfoZeroStatic.ShowTooltip);

	a.label("done");
	a.emit(0x5F, 0x5E, 0x8B, 0xE5, 0x5D);
	a.emit(0xC2, 0x08, 0x00);
	a.label("pass");
	a.emit(0x5F, 0x5E, 0x8B, 0xE5, 0x5D);
	a.jmp(BasicInfoZeroStatic.WindowMouseOriginal);
	return a;
};

BasicInfoZeroStatic.assertVtableSlot = function(label, entryVir, expectedVir)
{
	const phyAddr = Exe.Vir2Phy(entryVir);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroBasicInfo: ${label} is not mapped`);
	const actual = Exe.GetUint32(phyAddr);
	if (actual !== expectedVir)
	{
		throw Error(
			`ROGlobalZeroBasicInfo: ${label} expected ` +
			`0x${expectedVir.toString(16)}, ` +
			`got 0x${actual.toString(16)}`
		);
	}
	return phyAddr;
};

BasicInfoZeroStatic.assertVtables = function()
{
	return {
		create: BasicInfoZeroStatic.assertVtableSlot(
			"UIBasicInfoWnd OnCreate vtable[15]",
			BasicInfoZeroStatic.WindowCreateVtableEntry,
			BasicInfoZeroStatic.WindowCreateOriginal
		),
		draw: BasicInfoZeroStatic.assertVtableSlot(
			"UIBasicInfoWnd vtable[20]",
			BasicInfoZeroStatic.WindowDrawVtableEntry,
			BasicInfoZeroStatic.WindowDrawOriginal
		),
		mouse: BasicInfoZeroStatic.assertVtableSlot(
			"UIBasicInfoWnd vtable[28]",
			BasicInfoZeroStatic.WindowMouseVtableEntry,
			BasicInfoZeroStatic.WindowMouseOriginal
		),
		jobDestructor: BasicInfoZeroStatic.assertVtableSlot(
			"UIJobIconButton vtable[0]",
			BasicInfoZeroStatic.JobButtonVtable,
			BasicInfoZeroStatic.JobButtonDestructor
		),
		jobDraw: BasicInfoZeroStatic.assertVtableSlot(
			"UIJobIconButton vtable[20]",
			BasicInfoZeroStatic.JobButtonVtable + 20 * 4,
			BasicInfoZeroStatic.JobButtonDrawOriginal
		),
		jobInput25: BasicInfoZeroStatic.assertVtableSlot(
			"UIJobIconButton vtable[25]",
			BasicInfoZeroStatic.JobButtonVtable + 25 * 4,
			BasicInfoZeroStatic.JobButtonInput25
		),
		jobMouse28: BasicInfoZeroStatic.assertVtableSlot(
			"UIJobIconButton vtable[28]",
			BasicInfoZeroStatic.JobButtonVtable + 28 * 4,
			BasicInfoZeroStatic.JobButtonMouse28
		),
		jobInput31: BasicInfoZeroStatic.assertVtableSlot(
			"UIJobIconButton vtable[31]",
			BasicInfoZeroStatic.JobButtonVtable + 31 * 4,
			BasicInfoZeroStatic.JobButtonInput31
		),
		jobInput33: BasicInfoZeroStatic.assertVtableSlot(
			"UIJobIconButton vtable[33]",
			BasicInfoZeroStatic.JobButtonVtable + 33 * 4,
			BasicInfoZeroStatic.JobButtonInput33
		),
		baseInput25: BasicInfoZeroStatic.assertVtableSlot(
			"UIImgButton vtable[25]",
			BasicInfoZeroStatic.ImageButtonVtable + 25 * 4,
			BasicInfoZeroStatic.ImageButtonInput25
		),
		baseInput31: BasicInfoZeroStatic.assertVtableSlot(
			"UIImgButton vtable[31]",
			BasicInfoZeroStatic.ImageButtonVtable + 31 * 4,
			BasicInfoZeroStatic.ImageButtonInput31
		),
		baseInput33: BasicInfoZeroStatic.assertVtableSlot(
			"UIImgButton vtable[33]",
			BasicInfoZeroStatic.ImageButtonVtable + 33 * 4,
			BasicInfoZeroStatic.ImageButtonInput33
		)
	};
};

BasicInfoZeroStatic.assertCode = function(label, virAddr, expectedBytes)
{
	const phyAddr = Exe.Vir2Phy(virAddr, CODE);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroBasicInfo: ${label} is not mapped`);
	const count = BasicInfoZeroStatic.hexNorm(expectedBytes).split(" ").length;
	const actual = BasicInfoZeroStatic.hexNorm(Exe.GetHex(phyAddr, count));
	if (actual !== BasicInfoZeroStatic.hexNorm(expectedBytes))
		throw Error(`ROGlobalZeroBasicInfo: ${label} mismatch, got ${actual}`);
	return phyAddr;
};

ROGlobalZeroBasicInfo = function(_)
{
	if (Exe.BuildDate !== BasicInfoZeroStatic.BuildDate)
		throw Error("ROGlobalZeroBasicInfo supports only the 2025-07-16 client");
	const theme = CACHE.get("ROGlobalZeroUITheme.State");
	if (!theme || !Number.isInteger(theme.stateVir) ||
		!Number.isInteger(theme.loadVir) ||
		!Number.isInteger(theme.jobChildOffset) ||
		!Number.isInteger(theme.basicInfoOffset))
		throw Error("ROGlobalZeroBasicInfo: ROGlobalZeroUITheme must run first");

	$$(_, 1, "Verify Basic Info and Job button vtable boundaries");
	const vtableSlots = BasicInfoZeroStatic.assertVtables();
	const classicInsertPhy = BasicInfoZeroStatic.assertCode(
		"classic compact draw branch",
		BasicInfoZeroStatic.ClassicCompactInsert,
		BasicInfoZeroStatic.ClassicCompactBytes
	);
	const specialInsertPhy = BasicInfoZeroStatic.assertCode(
		"AP-class compact draw branch",
		BasicInfoZeroStatic.SpecialCompactInsert,
		BasicInfoZeroStatic.SpecialCompactBytes
	);
	const compactTogglePhy = BasicInfoZeroStatic.assertCode(
		"Alt+V compact/expanded selector",
		BasicInfoZeroStatic.CompactToggleBlock,
		BasicInfoZeroStatic.CompactToggleBytes
	);
	const factorySizePhy = BasicInfoZeroStatic.assertCode(
		"UIBasicInfoWnd factory size call",
		BasicInfoZeroStatic.WindowFactorySizeCall,
		BasicInfoZeroStatic.WindowFactorySizeBytes
	);
	const factoryHeightPhy = BasicInfoZeroStatic.assertCode(
		"UIBasicInfoWnd classic factory height",
		BasicInfoZeroStatic.FactoryClassicHeight,
		BasicInfoZeroStatic.FactoryClassicHeightBytes
	);
	const compactHeightPrimaryPhy = BasicInfoZeroStatic.assertCode(
		"UIBasicInfoWnd primary compact height",
		BasicInfoZeroStatic.CompactHeightPrimary,
		BasicInfoZeroStatic.CompactHeightPrimaryBytes
	);
	const compactHeightAPPhy = BasicInfoZeroStatic.assertCode(
		"UIBasicInfoWnd AP compact height",
		BasicInfoZeroStatic.CompactHeightAP,
		BasicInfoZeroStatic.CompactHeightAPBytes
	);
	const compactHeightSavedPhy = BasicInfoZeroStatic.assertCode(
		"UIBasicInfoWnd saved compact height",
		BasicInfoZeroStatic.CompactHeightSaved,
		BasicInfoZeroStatic.CompactHeightSavedBytes
	);
	const titleButtonsPhy = BasicInfoZeroStatic.assertCode(
		"UIBasicInfoWnd title-button creation",
		BasicInfoZeroStatic.TitleButtonsCreate,
		BasicInfoZeroStatic.TitleButtonsBytes
	);
	const titleButtonsSecondPhy = BasicInfoZeroStatic.assertCode(
		"UIBasicInfoWnd second title-button creation",
		BasicInfoZeroStatic.TitleButtonsSecondCreate,
		BasicInfoZeroStatic.TitleButtonsSecondBytes
	);
	// Reuse the existing independent PNG builders without applying or changing
	// the chat feature. Only these private HUD call sites use the allocations.
	const n = AutoCombatUI.nativeHelpers;
	const png = ModernChatUI.nativeHelpers;
	const blend = n.allocateCode(png.buildBlendPixel());
	BasicInfoZeroStatic.ImageDraw = n.allocateCode(png.buildPngDraw(blend.vir)).vir;
	BasicInfoZeroStatic.ImageDrawPart = n.allocateCode(BasicInfoZeroStatic.buildGaugeDraw(blend.vir)).vir;
	BasicInfoZeroStatic.FinalizePixels = n.allocateCode(png.buildFinalizePixels()).vir;
	$$(_, 2, "Build RO Global Zero Basic Info resource paths");
	const resource = file => BasicInfoZeroStatic.buildResourcePath("basicinfoui\\" + file);
	const paths = {
		background: resource("bg.png"), gauge: resource("bg_barover.png"),
		hp: resource("bar_hp_g_wide.png"), hpRed: resource("bar_hp_r_wide.png"),
		sp: resource("bar_sp_wide.png"), ap: resource("bar_ap_wide.png"),
		level: resource("bg_level.png"), jobBigFormat: resource("class\\%d.png")
	};
	const string = value => BasicInfoZeroStatic.allocateBytes(BasicInfoZeroStatic.asciiBytes(value))[1];
	const formats = {
		name: string("%.96s"), level: string("%d/%d"),
		value: string("%d / %d"), percent: string("%d%%"),
		hp: string("HP"), sp: string("SP"), ap: string("AP")
	};
	const tooltips = {
		hp: BasicInfoZeroStatic.allocateBytes(
			BasicInfoZeroStatic.asciiBytes("Health Pool")
		)[1],
		sp: BasicInfoZeroStatic.allocateBytes(
			BasicInfoZeroStatic.asciiBytes("Mana Pool")
		)[1],
		ap: BasicInfoZeroStatic.allocateBytes(
			BasicInfoZeroStatic.asciiBytes("Activity Points")
		)[1]
	};

	$$(_, 3, "Inject classic and AP-class compact native HUD renderers");
	const classicCode = BasicInfoZeroStatic.buildCompactDraw(
		paths, formats, BasicInfoZeroStatic.ClassicCompactExit,
		BasicInfoZeroStatic.ClassicCompactStockResume,
		"classic", theme.stateVir, theme.loadVir, theme.jobChildOffset, theme.basicInfoOffset
	);
	const [classicCodePhy, classicCodeVir] = Exe.Allocate(
		classicCode.bytes.length, 0x10
	);
	Exe.SetHex(classicCodePhy, classicCode.finish(classicCodeVir));
	const specialCode = BasicInfoZeroStatic.buildCompactDraw(
		paths, formats, BasicInfoZeroStatic.SpecialCompactExit,
		BasicInfoZeroStatic.SpecialCompactExit,
		"special", theme.stateVir, theme.loadVir, theme.jobChildOffset, theme.basicInfoOffset
	);
	const [specialCodePhy, specialCodeVir] = Exe.Allocate(
		specialCode.bytes.length, 0x10
	);
	Exe.SetHex(specialCodePhy, specialCode.finish(specialCodeVir));

	$$(_, 4, "Create the native Job icon child renderer and vtable");
	const childDrawCode = BasicInfoZeroStatic.buildJobChildDraw(
		{big: paths.jobBigFormat, level: paths.level, levelFormat: formats.level},
		theme.stateVir
	);
	const [childDrawCodePhy, childDrawCodeVir] = Exe.Allocate(
		childDrawCode.bytes.length, 0x10
	);
	Exe.SetHex(
		childDrawCodePhy,
		childDrawCode.finish(childDrawCodeVir)
	);
	const childHoverCode = BasicInfoZeroStatic.buildJobChildHover(
		theme.stateVir, tooltips
	);
	const [childHoverCodePhy, childHoverCodeVir] = Exe.Allocate(
		childHoverCode.bytes.length, 0x10
	);
	Exe.SetHex(
		childHoverCodePhy,
		childHoverCode.finish(childHoverCodeVir)
	);
	const barHoverCode = BasicInfoZeroStatic.buildBarHover(
		theme.stateVir, tooltips
	);
	const [barHoverCodePhy, barHoverCodeVir] = Exe.Allocate(
		barHoverCode.bytes.length, 0x10
	);
	Exe.SetHex(
		barHoverCodePhy,
		barHoverCode.finish(barHoverCodeVir)
	);
	const childDestructorCode = BasicInfoZeroStatic.buildJobChildDestructor(
		theme.stateVir, theme.jobChildOffset
	);
	const [childDestructorCodePhy, childDestructorCodeVir] = Exe.Allocate(
		childDestructorCode.bytes.length, 0x10
	);
	Exe.SetHex(
		childDestructorCodePhy,
		childDestructorCode.finish(childDestructorCodeVir)
	);
	const childVtable = BasicInfoZeroStatic.cloneJobButtonVtable(
		childDrawCodeVir,
		childHoverCodeVir,
		childDestructorCodeVir
	);
	const factoryCode = BasicInfoZeroStatic.buildFactorySize(
		theme.stateVir, theme.loadVir
	);
	const [factoryCodePhy, factoryCodeVir] = Exe.Allocate(
		factoryCode.bytes.length, 0x10
	);
	Exe.SetHex(factoryCodePhy, factoryCode.finish(factoryCodeVir));
	const createCode = BasicInfoZeroStatic.buildCreateWrapper(
		childVtable.vir, theme.stateVir, theme.loadVir,
		theme.jobChildOffset, theme.basicInfoOffset
	);
	const [createCodePhy, createCodeVir] = Exe.Allocate(
		createCode.bytes.length, 0x10
	);
	Exe.SetHex(createCodePhy, createCode.finish(createCodeVir));

	const compactToggleCode = BasicInfoZeroStatic.buildCompactToggle(
		theme.stateVir, theme.loadVir
	);
	const [compactToggleCodePhy, compactToggleCodeVir] = Exe.Allocate(
		compactToggleCode.bytes.length, 0x10
	);
	Exe.SetHex(
		compactToggleCodePhy,
		compactToggleCode.finish(compactToggleCodeVir)
	);
	const [titleButtonStatePhy, titleButtonStateVir] = BasicInfoZeroStatic.allocateBytes(
		new Array(8).fill(0), 4
	);
	const drawLifecycleCode = BasicInfoZeroStatic.buildDrawLifecycleGuard(
		theme.stateVir, theme.loadVir, titleButtonStateVir
	);
	const [drawLifecycleCodePhy, drawLifecycleCodeVir] = Exe.Allocate(
		drawLifecycleCode.bytes.length, 0x10
	);
	Exe.SetHex(
		drawLifecycleCodePhy,
		drawLifecycleCode.finish(drawLifecycleCodeVir)
	);
	const titleButtonBaseCreateCode = BasicInfoZeroStatic.buildTitleButtonCreate(
		BasicInfoZeroStatic.TitleButtonsOriginal,
		titleButtonStateVir,
		BasicInfoZeroStatic.TitleButtonsResume, 0
	);
	const [titleButtonBaseCreateCodePhy, titleButtonBaseCreateCodeVir] =
		Exe.Allocate(titleButtonBaseCreateCode.bytes.length, 0x10);
	Exe.SetHex(
		titleButtonBaseCreateCodePhy,
		titleButtonBaseCreateCode.finish(titleButtonBaseCreateCodeVir)
	);
	const titleButtonMiniCreateCode = BasicInfoZeroStatic.buildTitleButtonCreate(
		BasicInfoZeroStatic.TitleButtonsSecondOriginal,
		titleButtonStateVir + 4,
		0, 8
	);
	const [titleButtonMiniCreateCodePhy, titleButtonMiniCreateCodeVir] =
		Exe.Allocate(titleButtonMiniCreateCode.bytes.length, 0x10);
	Exe.SetHex(
		titleButtonMiniCreateCodePhy,
		titleButtonMiniCreateCode.finish(titleButtonMiniCreateCodeVir)
	);

	$$(_, 5, "Install child creation, theme-aware title buttons, draw, hover, and Alt+V routing");
	Exe.SetJMP(classicInsertPhy, classicCodeVir, 0);
	Exe.SetJMP(specialInsertPhy, specialCodeVir, 0);
	Exe.SetNOPs(specialInsertPhy + 5, 2);
	Exe.SetJMP(compactTogglePhy, compactToggleCodeVir, 0);
	Exe.SetNOPs(compactTogglePhy + 5, 16);
	Exe.SetUint32(vtableSlots.create, createCodeVir);
	Exe.SetUint32(vtableSlots.draw, drawLifecycleCodeVir);
	Exe.SetUint32(vtableSlots.mouse, barHoverCodeVir);
	Exe.SetUint32(
		factorySizePhy + BasicInfoZeroStatic.WindowFactoryWidthOffset,
		BasicInfoZeroStatic.PanelWidth
	);
	Exe.SetUint32(
		factoryHeightPhy + BasicInfoZeroStatic.FactoryClassicHeightOffset,
		BasicInfoZeroStatic.PanelHeight
	);
	Exe.SetUint32(
		compactHeightPrimaryPhy + BasicInfoZeroStatic.CompactHeightPrimaryOffset,
		BasicInfoZeroStatic.PanelHeight
	);
	Exe.SetUint32(
		compactHeightAPPhy + BasicInfoZeroStatic.CompactHeightAPOffset,
		BasicInfoZeroStatic.PanelHeight
	);
	Exe.SetUint32(
		compactHeightSavedPhy + BasicInfoZeroStatic.CompactHeightSavedOffset,
		BasicInfoZeroStatic.PanelHeight
	);
	Exe.SetCALL(
		factorySizePhy + BasicInfoZeroStatic.WindowFactoryCallOffset,
		factoryCodeVir
	);
	Exe.SetJMP(titleButtonsPhy, titleButtonBaseCreateCodeVir, 0);
	Exe.SetCALL(titleButtonsSecondPhy, titleButtonMiniCreateCodeVir, 0);
	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
	{
		PatchDiagnostics.add("ROGlobalZeroBasicInfo.QjsOnly", {
			factoryCodeVir,
			factoryCodeSize: factoryCode.bytes.length,
			factoryCallVir: BasicInfoZeroStatic.WindowFactorySizeCall +
				BasicInfoZeroStatic.WindowFactoryCallOffset,
			createVtableVir: BasicInfoZeroStatic.WindowCreateVtableEntry,
			createCodeVir,
			createCodeSize: createCode.bytes.length,
			drawLifecycleVtableVir: BasicInfoZeroStatic.WindowDrawVtableEntry,
			drawLifecycleCodeVir,
			drawLifecycleCodeSize: drawLifecycleCode.bytes.length,
			classicCodeVir,
			classicCodeSize: classicCode.bytes.length,
			classicInsertVir: BasicInfoZeroStatic.ClassicCompactInsert,
			classicExitVir: BasicInfoZeroStatic.ClassicCompactExit,
			specialCodeVir,
			specialCodeSize: specialCode.bytes.length,
			specialInsertVir: BasicInfoZeroStatic.SpecialCompactInsert,
			specialExitVir: BasicInfoZeroStatic.SpecialCompactExit,
			paths,
			formats,
			pngDrawVir: BasicInfoZeroStatic.ImageDraw,
			gaugeDrawVir: BasicInfoZeroStatic.ImageDrawPart,
			finalizeVir: BasicInfoZeroStatic.FinalizePixels,
			tooltips: ["Health Pool", "Mana Pool", "Activity Points"],
			tooltipAnchor: "live mouse +16,-16",
			apMissingMaximumFallback: BasicInfoZeroStatic.MissingAPMaximum,
			titleStyle: "11px dark blue; bounded name strip; base/job badge",
			childDrawCodeVir,
			childDrawCodeSize: childDrawCode.bytes.length,
			jobIconResolution:
				"exact circular art, circular lineage alias, circular Novice fallback",
			jobAliasCount: BasicInfoZeroStatic.JobAliases.length,
			childHoverCodeVir,
			childHoverCodeSize: childHoverCode.bytes.length,
			barHoverCodeVir,
			barHoverCodeSize: barHoverCode.bytes.length,
			childDestructorCodeVir,
			childDestructorCodeSize: childDestructorCode.bytes.length,
			childVtableVir: childVtable.vir,
			childVtableSize: childVtable.size,
			parentMouseVtableVir: BasicInfoZeroStatic.WindowMouseVtableEntry,
			compactToggleVir: BasicInfoZeroStatic.CompactToggleBlock,
			compactToggleCodeVir,
			themeStateVir: theme.stateVir,
			factorySizeVir: BasicInfoZeroStatic.WindowFactorySizeCall,
			factoryWidth: BasicInfoZeroStatic.PanelWidth,
			factoryHeight: BasicInfoZeroStatic.PanelHeight,
			compactHeightPrimaryVir: BasicInfoZeroStatic.CompactHeightPrimary,
			compactHeightAPVir: BasicInfoZeroStatic.CompactHeightAP,
			compactHeightSavedVir: BasicInfoZeroStatic.CompactHeightSaved,
			titleButtonsCreateVir: BasicInfoZeroStatic.TitleButtonsCreate,
			titleButtonsOriginalVir: BasicInfoZeroStatic.TitleButtonsOriginal,
			titleButtonsResumeVir: BasicInfoZeroStatic.TitleButtonsResume,
			titleButtonsSecondCreateVir:
				BasicInfoZeroStatic.TitleButtonsSecondCreate,
			titleButtonsSecondOriginalVir:
				BasicInfoZeroStatic.TitleButtonsSecondOriginal,
			titleButtonStatePhy,
			titleButtonStateVir,
			titleButtonBaseCreateCodeVir,
			titleButtonBaseCreateCodeSize:
				titleButtonBaseCreateCode.bytes.length,
			titleButtonMiniCreateCodeVir,
			titleButtonMiniCreateCodeSize:
				titleButtonMiniCreateCode.bytes.length,
			titleButtonsPolicy:
				"both stock children retained; Draw synchronizes Classic visible and New hidden",
			externalModules: 0
		});
	}
	return true;
};

ROGlobalZeroBasicInfo.validate = function()
{
	if (Exe.BuildDate !== BasicInfoZeroStatic.BuildDate)
		return false;
	try
	{
		BasicInfoZeroStatic.assertVtables();
		BasicInfoZeroStatic.assertCode(
			"classic compact draw branch",
			BasicInfoZeroStatic.ClassicCompactInsert,
			BasicInfoZeroStatic.ClassicCompactBytes
		);
		BasicInfoZeroStatic.assertCode(
			"AP-class compact draw branch",
			BasicInfoZeroStatic.SpecialCompactInsert,
			BasicInfoZeroStatic.SpecialCompactBytes
		);
		BasicInfoZeroStatic.assertCode(
			"Alt+V compact/expanded selector",
			BasicInfoZeroStatic.CompactToggleBlock,
			BasicInfoZeroStatic.CompactToggleBytes
		);
		BasicInfoZeroStatic.assertCode(
			"UIBasicInfoWnd factory size call",
			BasicInfoZeroStatic.WindowFactorySizeCall,
			BasicInfoZeroStatic.WindowFactorySizeBytes
		);
		BasicInfoZeroStatic.assertCode(
			"UIBasicInfoWnd classic factory height",
			BasicInfoZeroStatic.FactoryClassicHeight,
			BasicInfoZeroStatic.FactoryClassicHeightBytes
		);
		BasicInfoZeroStatic.assertCode(
			"UIBasicInfoWnd primary compact height",
			BasicInfoZeroStatic.CompactHeightPrimary,
			BasicInfoZeroStatic.CompactHeightPrimaryBytes
		);
		BasicInfoZeroStatic.assertCode(
			"UIBasicInfoWnd AP compact height",
			BasicInfoZeroStatic.CompactHeightAP,
			BasicInfoZeroStatic.CompactHeightAPBytes
		);
		BasicInfoZeroStatic.assertCode(
			"UIBasicInfoWnd saved compact height",
			BasicInfoZeroStatic.CompactHeightSaved,
			BasicInfoZeroStatic.CompactHeightSavedBytes
		);
		BasicInfoZeroStatic.assertCode(
			"UIBasicInfoWnd title-button creation",
			BasicInfoZeroStatic.TitleButtonsCreate,
			BasicInfoZeroStatic.TitleButtonsBytes
		);
		BasicInfoZeroStatic.assertCode(
			"UIBasicInfoWnd second title-button creation",
			BasicInfoZeroStatic.TitleButtonsSecondCreate,
			BasicInfoZeroStatic.TitleButtonsSecondBytes
		);
		return true;
	}
	catch (error)
	{
		return false;
	}
};

// Package the supplied artwork in the requested basicinfoui resource folder
// beside each newly patched client.
ROGlobalZeroBasicInfo.onApplied = function()
{
	if (Warp.TestMode) return;
	const prefix = String.fromCharCode(0xC0, 0xAF, 0xC0, 0xFA, 0xC0, 0xCE,
		0xC5, 0xCD, 0xC6, 0xE4, 0xC0, 0xCC, 0xBD, 0xBA);
	const target = System.DirPath(Warp.TgtExe) + '/data/texture/' + prefix + '/basicinfoui';
	if (!System.MkDir(target + '/class'))
		throw Error('ROGlobalZeroBasicInfo: unable to create HUD asset directory');
	const source = Warp.Path + 'Inputs/BasicInfoUI/assets/';
	for (const file of ["bar_ap.png", "bar_ap_wide.png", "bar_hp_g.png", "bar_hp_g_wide.png", "bar_hp_r.png", "bar_hp_r_wide.png", "bar_sp.png", "bar_sp_wide.png", "bg.png", "bg_bar.png", "bg_barover.png", "bg_level.png", "class/0.png", "class/1.png", "class/10.png", "class/11.png", "class/12.png", "class/14.png", "class/15.png", "class/16.png", "class/17.png", "class/18.png", "class/19.png", "class/2.png", "class/20.png", "class/3.png", "class/4.png", "class/4008.png", "class/4009.png", "class/4010.png", "class/4011.png", "class/4012.png", "class/4013.png", "class/4015.png", "class/4016.png", "class/4017.png", "class/4018.png", "class/4019.png", "class/4020.png", "class/4021.png", "class/5.png", "class/6.png", "class/7.png", "class/8.png", "class/9.png", "class/icon_acolyte.png", "class/icon_archer.png", "class/icon_mage.png", "class/icon_merchant.png", "class/icon_novice.png", "class/icon_swordman.png", "class/icon_thief.png", "class/null.png"])
	{
		if (!System.Copy(source + file, target + '/' + file, true))
			throw Error('ROGlobalZeroBasicInfo: unable to copy ' + file);
	}
};
