*                                                                          *
*   Author(s)     : Ylen X Walker, Louis T Steinhil                        *
*   Created Date  : 2026-09-06                                             *
*   Last Modified : 2026-09-08                                             *
*                                                                          *
*   Description   : Target: Main 2025-07-16 Ragexe. Complete native        *
*                   social packet name fields for Main 2025-07- 16:        *
*                   128-byte invitations, alliance and ban records, and    *
*                   clan-chat header. Native std::string/list ownership    *
*                   is retained; no short-name identity. Native hooks,     *
*                   data and code revert together with the selecting       *
*                   patch.                                                 *
*                                                                          *
\**************************************************************************/

SocialNamesStatic = {};
SocialNamesStatic.install = function(state, routes)
{
	if (ExtNameTextStatic.ActiveBuildDate !== 20250716 || state.socialNames128) return state;
	const patches = [], edits = [];
	const leaf = (va, old, bytes, end) => patches.push([va, old, () => GuildNamesStatic.leaf(bytes,end)]);
	const nop = (va, old) => edits.push([va,old,old.split(" ").map(() => "90").join(" ")]);
	// The alliance collection has eight scalar bytes followed by one name.
	leaf(0x00CE43C9,"0F BF 42 02 83 E8 04 C1 E8 05",
		[0x0F,0xB7,0x42,2,0x83,0xE8,4,0x52,0x51,0x33,0xD2,0xB9,136,0,0,0,0xF7,0xF1,0x59,0x5A],0x00CE43D3);
	leaf(0x00CE46AB,"83 C7 20 46 C7 45 B4 00 00 00 00",
		[0x81,0xC7,136,0,0,0,0x46,0xC7,0x45,0xB4,0,0,0,0],0x00CE46B6);
	for (const va of [0x00CE4444,0x00CE44A9,0x00CE453D,0x00CE4550])
		edits.push([va,"8D 45 D4","8D 47 04"]);
	for (const e of [[0x00CE4440,"0F 10 47 04"],[0x00CE4447,"C6 45 EC 00"],[0x00CE444C,"0F 11 45 D4"],[0x00CE4455,"F3 0F 7E 47 14"],[0x00CE445A,"66 0F D6 45 E4"]]) nop(...e);
	// Modern guild bans retain their 40-byte reason and expand only the name.
	leaf(0x00CE0A5A,"6A 00 6A 44 0F BF 46 02",[0x6A,0,0x68,172,0,0,0,0x0F,0xBF,0x46,2],0x00CE0A62);
	leaf(0x00CE0FF4,"83 C1 44 99 C7 45 8C 00 00 00 00",[0x81,0xC1,172,0,0,0,0x99,0xC7,0x45,0x8C,0,0,0,0],0x00CE0FFF);
	// EDI is also used to copy the preceding reason: keep its old position.
	// The only name-length consumer is native std::string::assign.
	edits.push([0x00CE0BEE,"6A 18","6A 7F"]);
	// Invitation dispatchers pass a complete native packet name directly.
	leaf(0x00CA24C6,"6A 18 8D 45 B8 68 9E 81 5E 01 50 FF 15 1C 1B FC 00 83 C4 0C C6 45 D0 00",[],0x00CA24DE);
	for (const va of [0x00CA24DE,0x00CA254D,0x00CA25E9])
		leaf(va,va===0x00CA25E9?"8D 45 B8 51 50":"8D 45 B8 B9 C8 C2 59 01",
			va===0x00CA25E9?[0xB8,0x9E,0x81,0x5E,1,0x51,0x50]:[0xB8,0x9E,0x81,0x5E,1,0xB9,0xC8,0xC2,0x59,1],va===0x00CA25E9?0x00CA25EE:va+8);
	leaf(0x00CA25D9,"8D 4D B8 8D 51 01",[0xB9,0x9E,0x81,0x5E,1,0x8D,0x51,1],0x00CA25DF);
	leaf(0x00CA2608,"8D 4D B8 8B 10 51",[0xB9,0x9E,0x81,0x5E,1,0x8B,0x10,0x51],0x00CA260E);
	for (const e of [[0x00CA50F4,"0F 10 05 9E 81 5E 01"],[0x00CA5101,"C6 85 7C FF FF FF 00"],[0x00CA5109,"0F 11 85 64 FF FF FF"],[0x00CA5115,"F3 0F 7E 05 AE 81 5E 01"],[0x00CA511D,"66 0F D6 85 74 FF FF FF"]]) nop(...e);
	for (const va of [0x00CA50FB,0x00CA518B]) edits.push([va,"8D 85 64 FF FF FF","B8 9E 81 5E 01 90"]);
	edits.push([0x00CA51BE,"8D 8D 64 FF FF FF","B9 9E 81 5E 01 90"]);
	for (const e of [[0x00CA5812,"0F 10 05 9E 81 5E 01"],[0x00CA581C,"C6 45 98 00"],[0x00CA5821,"0F 11 45 80"],[0x00CA582A,"F3 0F 7E 05 AE 81 5E 01"],[0x00CA5832,"66 0F D6 45 90"]]) nop(...e);
	leaf(0x00CA5819,"8D 45 80 C6 45 98 00",[0xB8,0x9E,0x81,0x5E,1],0x00CA5820);
	patches.push([0x00CA5861,"8D 45 80 50 E8 A6 F6 DD FF",function(){const a=ExtNameStaticAsm.asm();a.emit(0xB8,0x9E,0x81,0x5E,1,0x50);a.call(0x00A84F10);a.jmp(0x00CA586A);return a;}]);
	leaf(0x00CA588C,"8D 4D 80 8B 10 51",[0xB9,0x9E,0x81,0x5E,1,0x8B,0x10,0x51],0x00CA5892);
	// The ACK already owns a dynamic string; move the result footer.
	for (const va of [0x00CB2E22,0x00CB2F20])
		leaf(va,"8B 46 1A 83 "+(va===0x00CB2E22?"F8 04":"C0 FB"),
			[0x8B,0x86,130,0,0,0,0x83,va===0x00CB2E22?0xF8:0xC0,va===0x00CB2E22?4:0xFB],va+6);
	// Reserve a 1024-byte stack message below existing ACK locals.
	edits.push([0x00CB2D91,"81 EC 34 01 00 00","81 EC 34 05 00 00"]);
	for (const va of [0x00CB2F69,0x00CB2F78]) edits.push([va,"8D 85 F0 FE FF FF","8D 85 B8 FA FF FF"]);
	// Clan text includes its sender. Preserve it all after the widened header.
	leaf(0x00CF8893,"83 E8 1C 3D DC 00 00 00",[0x2D,132,0,0,0,0x3D,0xFF,3,0,0],0x00CF889B);
	leaf(0x00CF88B4,"8D 46 1C 50 8D 85 14 FF FF FF",[0x8D,0x86,132,0,0,0,0x50,0x8D,0x85,0xF4,0xFA,0xFF,0xFF],0x00CF88BE);
	edits.push([0x00CF8871,"81 EC F8 00 00 00","81 EC F8 04 00 00"]);
	for (const va of [0x00CF88A1,0x00CF88BE]) edits.push([va,"68 DC 00 00 00","68 00 04 00 00"]);
	for (const va of [0x00CF88A6,0x00CF88CD,0x00CF893E,0x00CF89C7]) edits.push([va,"8D 85 14 FF FF FF","8D 85 F4 FA FF FF"]);
	// Party withdrawal identifies the same full canonical member name.
	leaf(0x00CBB5DC,"0F 10 43 06 0F B6 43 1E 0F 11 45 E0 F3 0F 7E 43 16 66 0F D6 45 F0",[0x0F,0xB6,0x83,134,0,0,0],0x00CBB5F2);
	for(const va of [0x00CBB608,0x00CBB61E])edits.push([va,"8D 45 E0","8D 43 06"]);
	edits.push([0x00CBB631,"8D 75 E0","8D 73 06"]);
	// Secondary exception-path GS cookies move with each expanded native frame.
	edits.push([0x00F2525F,"8B 8A C0 FE FF FF","8B 8A C0 FA FF FF"],[0x00F2C289,"8B 8A 00 FF FF FF","8B 8A 00 FB FF FF"]);
	const safeFormat=ExtNameStaticAsm.asm();safeFormat.emit(0x55,0x8B,0xEC,0xFF,0x75,16,0xFF,0x75,12,0x6A,0xFF,0x68);safeFormat.dword(1024);safeFormat.emit(0xFF,0x75,8);safeFormat.call(0x0059CDF0);safeFormat.emit(0x83,0xC4,20,0x5D,0xC3);
	const formatter=ExtNameTextStatic.allocateCode(safeFormat);
	const formatSite=ExtNameStaticAsm.assertCode("party ACK bounded notice",0x00CB2F70,"E8 DB 68 87 FF");
	// Variable packets must consist of complete records before native iteration.
	const dispatches=[];
	for (const spec of [[0x014C,0x00CA51E0,136,0x00CE4390],[0x0B7C,0x00CA9561,172,0x00CE0A20]])
	{
		const phy=Exe.Vir2Phy(CustomPacketDispatch.tableEntryVir(routes.switchTableVir,spec[0]),CODE);
		if(phy<0 || Exe.GetUint32(phy)!==spec[1])throw Error("SocialNamesStatic: unexpected list route");
		const a=ExtNameStaticAsm.asm();
		a.emit(0x0F,0xB7,0x05);a.dword(routes.packetBufferVir+2);a.emit(0x83,0xF8,4);a.jcc(0x82,"done");
		a.emit(0x83,0xE8,4,0x33,0xD2,0xB9);a.dword(spec[2]);a.emit(0xF7,0xF1,0x85,0xD2);a.jcc(0x85,"done");
		a.emit(0x68);a.dword(routes.packetBufferVir);a.emit(0x8B,0xCF);a.call(spec[3]);a.label("done");a.jmp(routes.mainLoopReturnVir);
		dispatches.push([phy,ExtNameTextStatic.allocateCode(a).virAddr]);
	}
	for(const p of patches){p.push(ExtNameStaticAsm.assertCode("social bridge",p[0],p[1]));p.push(ExtNameTextStatic.allocateCode(p[2]()));}
	for(const e of edits)e.push(ExtNameStaticAsm.assertCode("social field",e[0],e[1]));
	const owner=Exe.ActivePatch;Exe.BeginTag("SocialNamesStatic.NamePackets128",true);
	try{
		for(const e of edits)Exe.SetHex(e[3],e[2]);
		for(const p of patches){Exe.SetJMP(p[3],p[4].virAddr,0);Exe.SetNOPs(p[3]+5,p[1].split(" ").length-5);}
		for(const d of dispatches)Exe.SetUint32(d[0],d[1]);
		Exe.SetCALL(formatSite,formatter.virAddr,0);
	}finally{Exe.EndTag();Exe.ActivePatch=owner;}
	state.socialNames128=true;return state;
};
