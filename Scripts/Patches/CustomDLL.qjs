*   Author(s)     : Neo-Mind                                               *
*   Created Date  : 2020-11-19                                             *
*   Last Modified : 2023-08-26                                             *
*                                                                          *
*   Description   : Rebuilds the PE import table to add custom DLLs and    *
*                   their exported functions. Extracts existing imports via *
*                   GetImpTable, merges new DLL specs via mergeSpec (CACHE- *
*                   based dedup across multiple callers), allocates space   *
*                   for strings/entries/table, then replaces the PE import  *
*                   directory entry via SetDirAddr/SetDirSize.              *
*                   RISK: Full import table replacement; any error in the   *
*                   new table makes the EXE unlaunchable. Patches using     *
*                   this: CustomExtName, CustomColoredItemName, FpsOverlay, *
*                   CustomRuneSystem, GenMapEffect.                         *
*                   Target: Ragexe clients 2014-2025 (excluding 2014-2017   *
*                   import-table bugs).                                     *
*                                                                          *
\**************************************************************************/

// TODO - Need to find an alternative for clients with repetitive imports

///
/// \brief Create a new import table containing all the existing DLL + functions
///        along with the specified DLL + functions.
///
CustomDLL = function(_)
{
	$$(_, 1.1, `Get the list file containing the dlls and functions to add`)
	const inFile = Exe.GetUserInput('$customDLL', D_InFile, "DLL Spec", "Enter the DLL specification file", "Inputs/DLLSpec.yml", {filters: YMLFILTER});
	if (inFile === false)
		Cancel("No file specified");

	$$(_, 1.2, `Retrieve the specification`)
	const dllSpec = Warp.LoadYaml(inFile);

	return CustomDLL.applySpec(_, dllSpec);
};

///
/// \brief Add the supplied DLL spec to the import table.
///
/// This helper lets dedicated one-click patches reuse the CustomDLL import
/// table builder without requiring the user to select the generic CustomDLL
/// patch separately.
///
CustomDLL.applySpec = function(_, dllSpec)
{
	if (typeof PatchDiagnostics !== "undefined" &&
	    typeof PatchDiagnostics.add === "function")
		PatchDiagnostics.add('CustomDLL.applySpec.input', {
			owner: _,
			spec: dllSpec
		});

	$$(_, 1.3, `Validate the DLL specification`)
	if (!Array.isArray(dllSpec))
		Cancel("Improper/Non-existent DLL specification");

	CustomDLL.rememberRequest(_, dllSpec);

	dllSpec = CustomDLL.mergeSpec(_, dllSpec);
	if (typeof PatchDiagnostics !== "undefined" &&
	    typeof PatchDiagnostics.add === "function")
		PatchDiagnostics.add('CustomDLL.applySpec.merged', {
			owner: _,
			spec: dllSpec
		});

	// Every caller rebuilds the same PE import directory fields. Keep those
	// shared header writes under one global tag so the latest cumulative table
	// replaces the previous one instead of competing with the feature patch
	// that happened to request imports first.
	const callerPatch = Exe.ActivePatch;
	Exe.ActivateGlobal();
	Exe.BeginTag(CACHE.getTag('CustomDLL.ImportTable'), true);

	try
	{
	$$(_, 1.4, `Extract the import table (if HShield patch is enabled then skip aossdk entry while extracting)`)
	const dirEntries = GetImpTable(Warp.GetPatchState("NoHShield") ? "aossdk.dll" : null);

	$$(_, 2, `Construct list of strings of all the names as well as compute the relative offsets for all the new entries`)
	let dirSize = dirEntries.byteCount(); //Holds the size of Import Table
	let strData = "";                     //Holds all the dll and function names as one hex string
	let strSize = 0;                      //Holds the size of strData

	const found = dllSpec.filter( hash =>
	{
		if ('Name' in hash === false || !Array.isArray(hash.Funcs))
			return false;

		hash.Offset = strSize;
		strData += hash.Name.toHex() + " 00"; //Append DLL Name
		strSize += hash.Name.length + 1; //Add name length + 1 for NULL

		dirSize += 20; //Increment for each entry

		const found = hash.Funcs.filter( (func, idx) =>
		{
			if ('Ordinal' in func)
			{
				func.Offset = 0x80000000 | func.Ordinal;
			}
			else if (('Name' in func) && IsStr(func.Name))
			{
				func.Offset = strSize;
				strData += idx.toHex(2) + func.Name.toHex() + " 00"; //Append function name
				strSize += 2 + func.Name.length + 1; //Add the 2 for the index bytes, name length and 1 for NULL

				if (func.Name.length % 2 !== 0) //Even the Odds xD
				{
					strData += " 00";
					strSize++;
				}
			}
			else
			{
				return false;
			}

			dirSize += 4; //Thunk Value VIRTUALs & Ordinals
			return true;
		});

		dirSize += 4; //Last Value is 00 00 00 00 after Thunks

		return (!found.isEmpty());
	});
	if (found.isEmpty())
		Cancel("No usable entries in specified file");

	dirSize += 20; //Accomodate for IAT End Entry

	$$(_, 3.1, `Allocate space to add the new table`)
	const [free, freeVir] = Exe.Allocate(strSize + dirSize);

	$$(_, 3.2, `Construct the new Import table using the dllSpec object`)
	const strRVA  = freeVir - Exe.ImageBase;
	const baseRVA = strRVA + strSize;
	const prefix  = ' 00'.repeat(12);

	let dirEntryData = "";
	let dirTableData = "";
	let entryPtr = 0;
	const customIat = {};

	dllSpec.forEach( (hash, idx) =>
	{
		const __ = `${_} [${idx}]`;

		$$(__, 3.3, `Sanity check (skip empty function names - shouldnt happen but still)`)
		if ('Offset' in hash === false || hash.Funcs.isEmpty())
			return;

		$$(__, 3.4, `Append the 12 byte prefix along with the offset of the dllname & its entry`)
		dirTableData += prefix + (strRVA + hash.Offset).toHex() + (baseRVA + entryPtr).toHex();

		for (const func of hash.Funcs)
		{
			if ('Name' in func)
			{
				const iatKey = (hash.Name + '!' + func.Name).toLowerCase();
				customIat[iatKey] = baseRVA + Exe.ImageBase + entryPtr;
			}

			if ('Ordinal' in func)
				dirEntryData += func.Offset.toHex();
			else if ('Offset' in func)
				dirEntryData += (strRVA + func.Offset).toHex();
			else
				return;

			entryPtr += 4;
		}

		$$(__, 3.5, `Append 0s as the end of entry table`)
		dirEntryData += " 00 00 00 00";
		entryPtr += 4;
	});

	$$(_, 3.6, `Prefix the original import table & append 0s as the end of the new import table`)
	dirTableData = dirEntries + dirTableData + prefix + ' 00'.repeat(8);

	$$(_, 3.7, `Save the size of the entry data`)
	const entSize = dirEntryData.byteCount();

	$$(_, 4.1, `Load all the details to ImpInfo`)
	CACHE.put('ImpInfo',
	{
		Addr    : free,
		Strings : strData,
		Entries : dirEntryData,

		TblData : dirTableData,
		TblAddr : baseRVA + Exe.ImageBase + dirEntryData.byteCount(),
		TblSize : dirTableData.byteCount() - 20
	});
	CACHE.put('CustomDLL.IAT', customIat);
	if (typeof PatchDiagnostics !== "undefined" &&
	    typeof PatchDiagnostics.add === "function")
		PatchDiagnostics.add('CustomDLL.applySpec.iat', customIat);

	// Snapshot old import directory address for diagnostics (read-only, safe)
	CACHE.put('ImpInfo.OldDir', { addr: Exe.GetDirAddr(D_Import, PHYSICAL) });

	$$(_, 4.2, `Call the helper function to setup the new Import table in the client`)
	CustomDLL.stage();
	}
	finally
	{
		Exe.EndTag();
		Exe.ActivePatch = callerPatch;
	}

	// Imported thunks move whenever the cumulative import table is rebuilt.
	// Refresh the shared slash-command cave so it calls the current IAT.
	if (typeof CustomSlashCommand !== "undefined" &&
	    typeof CustomSlashCommand.refresh === "function")
		CustomSlashCommand.refresh(`${_}.CustomSlashCommand`);
	CustomDLL.runRefreshHooks(_);

	return true;
};

CustomDLL.rememberRequest = function(ownerName, dllSpec)
{
	const key = 'CustomDLL.ImportRequests';
	const requests = CACHE.get(key) ?? [];
	let spec = null;
	try
	{
		spec = JSON.parse(JSON.stringify(dllSpec));
	}
	catch (e)
	{
		spec = String(dllSpec);
	}

	requests.push({
		owner: ownerName,
		ownerPatch: CustomDLL.ownerPatchName(ownerName),
		spec
	});
	CACHE.put(key, requests);
};

///
/// \brief Merge every CustomDLL user into one cumulative import spec.
///
/// WARP can run the generic CustomDLL patch and dedicated patches that reuse
/// CustomDLL.applySpec in the same session. Without merging, whichever patch
/// runs last rebuilds the import table with only its own DLL list and silently
/// drops earlier DLLs.
///
CustomDLL.mergeSpec = function(ownerName, dllSpec)
{
	const key = 'CustomDLL.MergedSpecByOwner';
	const ownerSpecs = CACHE.get(key) ?? {};
	const ownerPatch = CustomDLL.ownerPatchName(ownerName);

	const cloneFunc = func =>
	{
		if ('Ordinal' in func)
			return {Ordinal: func.Ordinal};
		if ('Name' in func && IsStr(func.Name))
			return {Name: func.Name};
		return null;
	};

	const cloneHash = hash =>
	{
		if ('Name' in hash === false || !Array.isArray(hash.Funcs))
			return null;
		return {
			Name: hash.Name,
			Funcs: hash.Funcs.map(cloneFunc).filter(func => func !== null)
		};
	};
	const cloneSpec = spec => spec.map(cloneHash).filter(hash => hash !== null);

	ownerSpecs[ownerPatch] = cloneSpec(dllSpec);
	CACHE.put(key, ownerSpecs);

	const merged = [];
	const mergeOne = hash =>
	{
		if ('Name' in hash === false || !Array.isArray(hash.Funcs))
			return;

		let target = merged.find(entry => entry.Name.toLowerCase() === hash.Name.toLowerCase());
		if (!target)
		{
			target = {Name: hash.Name, Funcs: []};
			merged.push(target);
		}

		for (const func of hash.Funcs)
		{
			const clean = cloneFunc(func);
			if (!clean)
				continue;

			const exists = target.Funcs.some(old =>
				('Ordinal' in clean && 'Ordinal' in old && clean.Ordinal === old.Ordinal) ||
				('Name' in clean && 'Name' in old && clean.Name === old.Name)
			);

			if (!exists)
				target.Funcs.push(clean);
		}
	};

	for (const patchName in ownerSpecs)
	{
		if (patchName !== ownerPatch && !Warp.GetPatchState(patchName))
			continue;
		for (const hash of ownerSpecs[patchName])
			mergeOne(hash);
	}

	// Dedicated helper calls can run before WARP has marked the owner patch as
	// selected. Keep the current caller's import request even in that case.
	for (const hash of dllSpec)
		mergeOne(hash);

	return cloneSpec(merged);
};

CustomDLL.ownerPatchName = function(name)
{
	if (!IsStr(name) || name.isEmpty())
		return Exe.ActivePatch;

	const dot = name.indexOf('.');
	if (dot > 0)
		return name.substring(0, dot);

	const bracket = name.indexOf(' ');
	if (bracket > 0)
		return name.substring(0, bracket);

	return name;
};

CustomDLL.ownerIsActive = function(ownerName, currentOwner)
{
	return ownerName === currentOwner || Warp.GetPatchState(ownerName);
};

CustomDLL.addRefreshHook = function(name, hook)
{
	if (!IsStr(name) || !hook)
		throw Error("CustomDLL.addRefreshHook requires a name and hook spec");

	if (typeof hook === "function")
		hook = {callback: hook};

	const key = 'CustomDLL.RefreshHooksByName';
	const hooks = CACHE.get(key) ?? {};
	hooks[name] = Object.assign({}, hook, {
		owner: CustomDLL.ownerPatchName(name),
	});
	CACHE.put(key, hooks);
};

CustomDLL.runRefreshHooks = function(_)
{
	const currentOwner = CustomDLL.ownerPatchName(_);
	const hooks = CACHE.get('CustomDLL.RefreshHooksByName') ?? {};
	const refreshed = [];

	for (const name in hooks)
	{
		const hook = hooks[name];
		if (typeof hook.callback === "function")
		{
			hook.callback();
			refreshed.push(name);
		}
	}

	if (typeof PatchDiagnostics !== "undefined" &&
	    typeof PatchDiagnostics.add === "function" &&
	    !refreshed.isEmpty())
		PatchDiagnostics.add('CustomDLL.runRefreshHooks', {
			owner: currentOwner,
			refreshed
		});

	return true;
};

CustomDLL.getDllName = function(inputKey, title, description, defaultName, dedicatedName)
{
	const cacheKey = 'CustomDLL.Input.' + inputKey;
	const cached = CACHE.get(cacheKey);
	if (IsStr(cached) && !cached.isEmpty())
		return cached;

	const dllName = Exe.GetUserInput(
		inputKey,
		D_Text,
		title,
		description,
		defaultName,
		{minLen: 5, maxLen: 64}
	);
	if (dllName === false)
		Cancel(`No ${title} name specified`);
	if (!/^[A-Za-z0-9_.-]+\.dll$/i.test(dllName))
		throw Error(`${title} must be a filename only, for example ${dedicatedName || defaultName}`);

	CACHE.put(cacheKey, dllName);
	if (typeof PatchDiagnostics !== "undefined" &&
	    typeof PatchDiagnostics.add === "function")
		PatchDiagnostics.add('CustomDLL.getDllName', {
			inputKey,
			title,
			dllName
		});

	// WARP keeps GetUserInput values around in the GUI process. DLL names must
	// come from the active profile/build, so do not let one uploaded profile
	// pin old import names until warp.exe restarts.
	if (typeof Exe.ClearSavedInput === "function")
		Exe.ClearSavedInput(inputKey);

	return dllName;
};

CustomDLL.findIat = function(exportName, dllName)
{
	const iatMap = CACHE.get('CustomDLL.IAT') ?? {};

	if (IsStr(dllName) && !dllName.isEmpty())
	{
		const exactIat = Exe.FindFunc(exportName, dllName);
		if (exactIat >= 0)
			return exactIat;

		const exactKey = (dllName + '!' + exportName).toLowerCase();
		if (exactKey in iatMap)
			return iatMap[exactKey];
	}

	return -1;
};

/*
///
/// \brief Disable for 2014-2017 clients since their import tables are messed up
///        and the client doesnt allow its movement.
///
CustomDLL.validate = () => Exe.BuildDate < 20140700 || Exe.BuildDate > 20170700 ;
*/

///
/// \brief Rerun the NoHShield function if the HShield patch is selected
///        so that it doesnt accomodate for Custom DLL
///
CustomDLL.cleanup = () =>
{
	CustomDLL.runRefreshHooks('CustomDLL.cleanup');
	ReloadPatch("NoHShield");
};

///
/// \brief Helper function which uses the data from ROC.ImpInfo hash
///        to create a new import table in the client
///
CustomDLL.stage = tblData =>
{
	const _ = 'CustomDLL.stage';

	$$(_, 1, `Add the strings, dll entries and import table (either tblData or ROC.ImpInfo.tblData) at the offset`)
	const impInfo = CACHE.get('ImpInfo');
	if (impInfo)
	{
		Exe.SetHex(
			impInfo.Addr,
			impInfo.Strings +
			impInfo.Entries +
			(tblData ?? impInfo.TblData)
		);

		$$(_, 2, `Update the PE Table Import Data Directory Address`)
		Exe.SetDirAddr(D_Import, impInfo.TblAddr);
		Exe.SetDirSize(D_Import, impInfo.TblSize);
	}
};
