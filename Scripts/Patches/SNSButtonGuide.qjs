///
/// \brief Reuse the Basic Info "SNS" button to send the custom in-game
///        guide/settings packet. This is the packet-mode counterpart to
///        SNSButtonURL.
///
SNSButtonGuide = function(_)
{
	const packetID = Exe.GetUserInput(
		'$snsBtnPacket',
		D_Uint16,
		"SNS Button Packet",
		"Enter the packet ID to send when SNS button is clicked",
		0x0BB2,
		{min: 1, saveDefault: true}
	);
	if (packetID === false)
		Cancel("No SNS packet ID entered");

	const hoverVarName = '$snsBtnPacketHover';
	const hoverText = Exe.GetUserInput(
		hoverVarName,
		D_Text,
		"SNS Button Packet Hover",
		"Enter the hover label to show for the SNS packet button",
		"In-Game Settings",
		{minLen: 1, maxLen: 60, saveDefault: true}
	);
	if (hoverText === false)
		Cancel("No SNS packet hover label entered");

	const [, hoverAddr] = Exe.AddFromVar(hoverVarName);
	const hoverLen = hoverText.length;
	if (hoverLen <= 0)
		throw Error("SNS packet hover label is empty");

	$$(_, 3.3, `Resolve SNS button ID`)
	const targetID = NewBasicButton.getID(_, NewBasicButton.SNSButtonIdx, "SNS");

	$$(_, 4.1, `Register SNS packet hover label`)
	NewBasicButtonHover.registerText(_, targetID, hoverAddr, hoverLen);

	NewBasicButton.ensureVisible(_, targetID);

	$$(_, 5.1, `Register SNS packet click action`)
	NewBasicButtonClick.registerPacket(_, targetID, packetID);

	return true;
};

///
/// \brief Disable for unsupported clients.
///
SNSButtonGuide.validate = function()
{
	return NewBasicButtonClick.validatePacket();
};

SNSButtonGuide.cleanup = function(patchName)
{
	NewBasicButtonHover.unregister(patchName);
	NewBasicButtonClick.unregister(patchName);
};
