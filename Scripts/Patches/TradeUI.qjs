/*
 * Description: 548x428 player Trade UI using original tradeui/genericsui PNGs.
 * Target: 2025-07-16 Ragexe. Uses the native UIExchangeWnd protocol, item lists,
 * amount dialogs and two-stage confirmation through a private vtable. Live
 * comma input is stripped only at the native trade submission call sites.
 * No server changes, custom trade packets or shared item rendering hooks.
 */
TradeUI = function(_)
{
	if(!TradeUI.validate())throw Error("TradeUI requires 2025-07-16 Ragexe");
	const n=AutoCombatUI.nativeHelpers;
	const read=path=>{const f=new BinFile(path,"r");if(!f.Valid)throw Error("TradeUI: missing "+path);const h=f.ReadHex();f.Close();return(h.match(/[0-9a-fA-F]{2}/g)||[]).map(v=>parseInt(v,16));};
	const u32=(b,o)=>(b[o]|b[o+1]<<8|b[o+2]<<16|b[o+3]<<24)>>>0;
	const put=(b,o,v)=>{for(let i=0;i<4;++i)b[o+i]=v>>>(i*8)&255;};
	const bytes=read(Warp.Path+"/Inputs/TradeUI/runtime.bin"),meta=JSON.parse(String.fromCharCode(...read(Warp.Path+"/Inputs/TradeUI/runtime.json")));
	const size=u32(bytes,8),count=u32(bytes,12),api=u32(bytes,16),start=32+count*4;
	let crc=0xFFFFFFFF;for(let i=32;i<bytes.length;++i){crc^=bytes[i];for(let j=0;j<8;++j)crc=(crc>>>1)^((crc&1)?0xEDB88320:0);}
	if(bytes.length<32 || u32(bytes,0)!==0x49555254 || u32(bytes,4)!==1 || meta.version!==1 || meta.client!==20250716 ||
		start+size!==bytes.length || size!==meta.size || api!==meta.exports.TradeApi || meta.api_size!==104 || api+104>size || u32(bytes,20)!==104 || u32(bytes,24)!==20250716 || ((crc^0xFFFFFFFF)>>>0)!==u32(bytes,28))throw Error("TradeUI: invalid payload");
	const names=["TradeApi", "TradeState", "@TradeConstruct@8", "@TradeCreate@16", "@TradeProcess@8", "@TradeDraw@8", "@TradeDown@16", "@TradeUp@16", "@TradeMove@16", "@TradeRight@16", "@TradeDrop@20", "@TradeDestroy@12", "@TradeEvent@32", "@TradeEditDraw@8", "@TradeEditEvent@32", "@TradeNumeric@8", "_TradeFormat@12", "_TradeHit@8", "@TradeInitialize@12"];
	for(const name of names)if(!Number.isInteger(meta.exports[name]) || meta.exports[name]<0 || meta.exports[name]>=size)throw Error("TradeUI: missing "+name);
	n.assertCode("TradeUI exchange factory",0x9C8F83,"68 4C 01 00 00 E8 C2 2C 3F 00");
	n.assertCode("TradeUI exchange constructor call",0x9C8FA0,"E8 CB 49 00 00");
	n.assertCode("TradeUI modern factory dispatch",0x9A8A7A,"8B F0 53 8B CE 8B 16 FF 92 B4 00 00 00 8B 16 8B CE FF 92 D4 00 00 00");
	n.assertCode("TradeUI modern factory return",0x9A8B5F,"5F 8B C6 5E 5B 8B 4D FC 33 CD E8 66 30 41 00");
	n.assertCode("TradeUI legacy constructor",0x88DA00,"55 8B EC 6A FF 68 55 8E EA 00");
	n.assertCode("TradeUI native OK input",0x8C0FD1,"E8 CA 00 F6 FF");
	n.assertCode("TradeUI native amount input",0x8C11AC,"E8 EF FE F5 FF");
	n.assertCode("TradeUI native input inset",0x8250D2,"8B 86 F4 00 00 00 8B CE 83 C0 02 89 86 B4 00 00 00");
	const original=0x1031EDC,slots=53,changes=[[0,"@TradeDestroy@12",0x892910],[10,"@TradeDrop@20",0x896110],[15,"@TradeCreate@16",0x8A6900],[19,"@TradeProcess@8",0x8BAC90],[20,"@TradeDraw@8",0x8B36B0],[25,"@TradeDown@16",0x880AD0],[28,"@TradeMove@16",0x8BA250],[31,"@TradeUp@16",0x880BB0],[32,"@TradeRight@16",0x8BB400],[37,"@TradeEvent@32",0x8C0EA0]];
	for(const [slot,name,expected] of changes)if(Exe.GetUint32(Exe.Vir2Phy(original+slot*4))!==expected)throw Error("TradeUI: native vtable changed: "+name);
	for(const [slot,expected] of [[20,0x824FC0],[37,0x82C4E0]])if(Exe.GetUint32(Exe.Vir2Phy(0x1028908+slot*4))!==expected)throw Error("TradeUI: edit vtable changed");
	const code=bytes.slice(start),[phy,vir]=Exe.Allocate(size,16);
	for(let i=0;i<count;++i){const off=u32(bytes,32+i*4);if(off+4>size || u32(code,off)>=size)throw Error("TradeUI: invalid relocation");put(code,off,u32(code,off)+vir);}
	const e=name=>vir+meta.exports[name];
	const table=n.allocateBytes(new Array(4+slots*4).fill(0),4);Exe.SetHex(table.phy,Exe.GetHex(Exe.Vir2Phy(original-4),table.size));
	for(const [slot,name] of changes)Exe.SetUint32(table.phy+4+slot*4,e(name));
	const edit=n.allocateBytes(new Array(4+58*4).fill(0),4);Exe.SetHex(edit.phy,Exe.GetHex(Exe.Vir2Phy(0x1028908-4),edit.size));
	for(const [slot,name] of [[20,"@TradeEditDraw@8"],[37,"@TradeEditEvent@32"]])Exe.SetUint32(edit.phy+4+slot*4,e(name));
	const fit=n.allocateCode(VipUI.nativeDrawing.fit(11,false,false));
	const blend=n.allocateCode(ModernChatUI.nativeHelpers.buildBlendPixel()),rawPng=n.allocateCode(ModernChatUI.nativeHelpers.buildPngDraw(blend.vir));
	// Private adapter preserves this frame's opaque surface mode after PNG alpha.
	const draw=n.asm();draw.emit(0x55,0x8B,0xEC,0x53,0x56,0x8B,0x71,0x24,0x85,0xF6);draw.jcc(0x84,"done");
	draw.emit(0x0F,0xB6,0x5E,0x28);for(const off of [20,16,12,8])draw.emit(0xFF,0x75,off);
	draw.call(rawPng.vir);draw.emit(0x88,0x5E,0x28);draw.label("done");draw.emit(0x5E,0x5B,0x5D,0xC2,16,0);
	const png=n.allocateCode(draw),paths=TradeUI.assets().map(p=>p.replace(/\//g,'\\'));
	[1,table.vir+4,edit.vir+4,fit.vir,png.vir,...paths.map(p=>n.buildResourcePath(p).vir)].forEach((v,i)=>put(code,api+i*4,v));
	for(let i=0;i<code.length;i+=4096)Exe.SetHex(phy+i,n.bytesToHex(code.slice(i,i+4096)));
	for(const [site,name] of [[0x9C8FA0,"@TradeConstruct@8"],[0x8C0FD1,"@TradeNumeric@8"],[0x8C11AC,"@TradeNumeric@8"]])Exe.SetCALL(Exe.Vir2Phy(site),e(name));
	// Branch only on this patch's exact private vtable. Stock/fallback windows
	// replay the displaced instructions and retain their complete CUI lifecycle.
	// Our legacy frame returns before slot 53 and the incompatible CUI flag reads.
	const init=n.asm();init.emit(0x8B,0xF0,0x81,0x3E);init.dword(table.vir+4);init.jcc(0x85,"stock");
	init.emit(0x53,0x8B,0xCE);init.call(e("@TradeInitialize@12"));init.jmp(0x9A8B5F);
	init.label("stock");init.emit(0x53,0x8B,0xCE,0x8B,0x16);init.jmp(0x9A8A81);
	const initHook=n.allocateCode(init);Exe.SetJMP(Exe.Vir2Phy(0x9A8A7A),initHook.vir);Exe.SetNOPs(Exe.Vir2Phy(0x9A8A7F),2);
	const record=[];for(const v of [n.allocateString("TradeUI.v1").vir,...names.map(e)])record.push(v&255,v>>>8&255,v>>>16&255,v>>>24);n.allocateBytes(record,4);
	TradeUI.onApplied();return true;
};
TradeUI.validate=()=>Exe.BuildDate===20250716;
TradeUI.assets=()=>["tradeui/bg.png", "tradeui/bg_send.png", "tradeui/bg_send_cancel.png", "tradeui/bg_send_ok.png", "tradeui/bg_receive.png", "tradeui/bg_receive_cancel.png", "tradeui/bg_receive_ok.png", "tradeui/ss_off.png", "tradeui/ss_on.png", "tradeui/trade_off.png", "tradeui/trade_out.png", "tradeui/trade_over.png", "tradeui/trade_press.png", "genericsui/ok_off.png", "genericsui/ok_out.png", "genericsui/ok_over.png", "genericsui/ok_press.png", "genericsui/cancel_off.png", "genericsui/cancel_out.png", "genericsui/cancel_over.png", "genericsui/cancel_press.png"];
TradeUI.onApplied=function()
{
	if(Warp.TestMode)return;
	const root=System.DirPath(Warp.TgtExe),folders=['data','texture',ModernChatUI.nativeHelpers.uiPrefix()],target=root+'/'+folders.join('/'),missing=[];
	for(const file of TradeUI.assets()){
		const existing=new BinFile(target+'/'+file,'r'),exists=existing.Valid;existing.Close();if(exists)continue;
		const source=new BinFile(Warp.Path+'/Assets/TradeUI/'+file,'r'),valid=source.Valid;source.Close();if(!valid)throw Error('TradeUI: missing bundled asset '+file);
		missing.push(file);
	}
	if(!missing.length)return;
	let path=root;for(const folder of folders){path+='/'+folder;if(!System.MkDir(path))throw Error('TradeUI: cannot create '+path);}
	for(const folder of ['tradeui','genericsui'])if(!System.MkDir(target+'/'+folder))throw Error('TradeUI: cannot create '+target+'/'+folder);
	for(const file of missing)if(!System.Copy(Warp.Path+'/Assets/TradeUI/'+file,target+'/'+file,false))throw Error('TradeUI: cannot copy '+file);
};
