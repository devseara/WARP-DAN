*                                                                          *
*   Author(s)     : Louis T Steinhil                                       *
*   Last Modified : 2026-06-15                                             *
*   Description   : Shared slash-command dispatcher for imported DLL and   *
*                   static native-cave features. Commands call their       *
*                   registered target directly, avoiding sentinel files,  *
*                   polling, and competing hooks.                         *
*                                                                          *
\**************************************************************************/

CustomSlashCommand = {};

CustomSlashCommand.ownerPatchName = function(name)
{
	if (!IsStr(name) || name.isEmpty())
		return Exe.ActivePatch;

	const dot = name.indexOf('.');
	if (dot > 0)
		return name.substring(0, dot);

	const bracket = name.indexOf(' ');
	if (bracket > 0)
		return name.substring(0, bracket);

	return name;
};

CustomSlashCommand.ownerIsActive = function(ownerName, currentOwner)
{
	return ownerName === currentOwner || Warp.GetPatchState(ownerName);
};

CustomSlashCommand.addRefreshHook = function(name, hook)
{
	if (!IsStr(name) || !hook)
		throw Error("CustomSlashCommand.addRefreshHook requires a name and hook spec");

	if (typeof hook === "function")
		hook = {callback: hook};

	const key = 'CustomSlashCommand.RefreshHooksByName';
	const hooks = CACHE.get(key) ?? {};
	hooks[name] = Object.assign({}, hook, {
		owner: CustomSlashCommand.ownerPatchName(name),
	});
	CACHE.put(key, hooks);
};

CustomSlashCommand.register = function(_, spec)
{
	const hasDllTarget = spec && IsStr(spec.dllName) && IsStr(spec.exportName);
	const hasStaticTarget = spec && Number.isInteger(spec.targetVir) && spec.targetVir > 0;
	if (!spec || !IsStr(spec.command) || hasDllTarget === hasStaticTarget)
		throw Error(
			"CustomSlashCommand.register requires exactly one DLL export or static targetVir"
		);

	const command = spec.command.toLowerCase();
	if (!/^\/[a-z0-9_]+$/.test(command))
		throw Error(`Invalid custom slash command: ${spec.command}`);

	const clean = {
		command,
		dllName: hasDllTarget ? spec.dllName : null,
		exportName: hasDllTarget ? spec.exportName : null,
		targetVir: hasStaticTarget ? spec.targetVir : null,
		optionId: Number.isInteger(spec.optionId) ? spec.optionId : null,
		settingsExportName: IsStr(spec.settingsExportName)
			? spec.settingsExportName
			: null
	};

	const owner = CustomSlashCommand.ownerPatchName(_);
	const key = 'CustomSlashCommand.RegistryByOwner';
	const registryByOwner = CACHE.get(key) ?? {};
	const registry = registryByOwner[owner] ?? [];
	const existing = registry.find(entry => entry.command === command);

	if (existing)
	{
		existing.dllName = clean.dllName;
		existing.exportName = clean.exportName;
		existing.targetVir = clean.targetVir;
		existing.optionId = clean.optionId;
		existing.settingsExportName = clean.settingsExportName;
	}
	else
	{
		registry.push(clean);
	}

	registryByOwner[owner] = registry;
	CACHE.put(key, registryByOwner);
	if (typeof PatchDiagnostics !== "undefined" &&
	    typeof PatchDiagnostics.add === "function")
		PatchDiagnostics.add('CustomSlashCommand.register', {
			owner,
			command: clean.command,
			dllName: clean.dllName,
			exportName: clean.exportName,
			targetVir: clean.targetVir,
			optionId: clean.optionId,
			settingsExportName: clean.settingsExportName
		});

	if (clean.optionId !== null && clean.settingsExportName !== null)
	{
		CustomSlashCommand.addRefreshHook(
			`${owner}.GameSettings`,
			{type: 'CustomSlashCommand.GameSettings'}
		);
	}
	return CustomSlashCommand.refresh(_);
};

CustomSlashCommand.refresh = function(_)
{
	const currentOwner = CustomSlashCommand.ownerPatchName(_);
	CACHE.put('CustomSlashCommand.CurrentRefreshOwner', currentOwner);
	const registryByOwner = CACHE.get('CustomSlashCommand.RegistryByOwner') ?? {};
	const registry = [];
	for (const owner in registryByOwner)
	{
		if (!CustomSlashCommand.ownerIsActive(owner, currentOwner))
			continue;
		for (const entry of registryByOwner[owner])
			registry.push(entry);
	}

	const callerPatch = Exe.ActivePatch;
	Exe.ActivateGlobal();
	Exe.BeginTag(CACHE.getTag('CustomSlashCommand.Dispatch'), true);

	try
	{
		if (registry.isEmpty())
			return true;

		const cmn = (ROC.HasFP ? FP_STOP : '') + RETN(4);
		let prefix, suffix, movPos, extraPops, tgtReg;

		switch (Exe.Version)
		{
			case 6:
				prefix = MOV(EAX, [R32, 4]) + POP(EDI) + POP(ESI) + POP(EBX) + cmn;
				suffix = POP(EDI) + POP(ESI) + MOV(EAX, 3) + POP(EBX) + cmn;
				movPos = 2; extraPops = POP(EDI) + POP(ESI); tgtReg = ESI; break;
			case 9:
				prefix = MOV(EAX, [R32, 4]) + POP(EDI) + POP(ESI) + POP(ECX) + cmn;
				suffix = POP(EDI) + MOV(EAX, 3) + POP(ESI) + POP(ECX) + cmn;
				movPos = 1; extraPops = POP(EDI); tgtReg = EBP; break;
			case 10: case 11:
				prefix = MOV(EAX, [R32, 4]) + cmn;
				suffix = MOV(EAX, 3) + cmn;
				movPos = 0; extraPops = ''; tgtReg = EDI; break;
			default:
				prefix = MOV(EAX, [R32, 4]) + POP(EDI) + POP(ESI) + cmn;
				suffix = POP(EDI) + MOV(EAX, 3) + POP(ESI) + cmn;
				movPos = 1; extraPops = POP(EDI); tgtReg = EDI; break;
		}

		let funcEnd = Exe.FindHex(prefix + suffix);
		if (funcEnd < 0)
		{
			let ms;
			switch (Exe.Version)
			{
				case 6: ms = POP(EDI) + POP(ESI) + XOR(EAX, EAX) + ADD(tgtReg, 1) + POP(EBX) + cmn; break;
				case 9: ms = POP(EDI) + XOR(EAX, EAX) + ADD(tgtReg, 1) + POP(ESI) + POP(ECX) + cmn; break;
				case 10: case 11: ms = XOR(EAX, EAX) + ADD(tgtReg, 1) + cmn; break;
				default: ms = POP(EDI) + XOR(EAX, EAX) + ADD(tgtReg, 1) + POP(ESI) + cmn; break;
			}
			funcEnd = Exe.FindHex(prefix + ms);
		}
		if (funcEnd < 0)
			throw Error("CustomSlashCommand: GetNoParamTalkType suffix not found");

		const suffixStart = funcEnd + prefix.byteCount();
		const afterHookVir = Exe.Phy2Vir(suffixStart + movPos + 5, CODE);

		if (movPos > 0)
		{
			const pPat = (ROC.HasFP ? FP_START : '') + SUB(ESP, 8);
			const prologue = Exe.FindLastHex(pPat, funcEnd, funcEnd - 0x500);
			if (prologue >= 0)
			{
				const bw = Exe.FindHex(' 89 4D 08 8B 09', prologue, funcEnd);
				const br = Exe.FindHex(' 8B 55 08 83 C8 FF', prologue, funcEnd);
				if (bw >= 0 && br >= 0)
				{
					Exe.SetInt8(prologue + pPat.byteCount() - 1, 0x0C);
					Exe.SetInt8(bw + 2, 0xF4);
					Exe.SetInt8(br + 2, 0xF4);
				}
			}
		}

		const commands = registry.map(entry =>
		{
			if (Number.isInteger(entry.targetVir) && entry.targetVir > 0)
				return {
					command: entry.command,
					targetVir: entry.targetVir,
					optionId: entry.optionId
				};

			const iat = (
				typeof CustomDLL !== "undefined" &&
				typeof CustomDLL.findIat === "function"
			)
				? CustomDLL.findIat(entry.exportName, entry.dllName)
				: Exe.FindFunc(entry.exportName, entry.dllName);
			if (iat < 0)
				throw Error(`CustomSlashCommand: import not found: ${entry.dllName}!${entry.exportName}`);
			return {
				command: entry.command,
				iat,
				targetVir: null,
				optionId: entry.optionId
			};
		});
		if (typeof PatchDiagnostics !== "undefined" &&
		    typeof PatchDiagnostics.add === "function")
			PatchDiagnostics.add('CustomSlashCommand.refresh.commands', {
				owner: currentOwner,
				commands
			});

		const caveSize = 0x80 + commands.reduce(
			(total, entry) => total + (entry.command.length + 1) * 12 + 80,
			0
		);
		const [cavePhy, caveVir] = Exe.Allocate(caveSize, 0x10);
		const b = [];
		const u32 = value =>
		{
			const v = value >>> 0;
			b.push(v & 0xFF, (v >>> 8) & 0xFF, (v >>> 16) & 0xFF, (v >>> 24) & 0xFF);
		};
		const off = () => b.length;
		const hexBytes = hex =>
		{
			if (!hex)
				return;
			for (const part of hex.trim().split(/ +/))
			{
				if (part.length === 2)
					b.push(parseInt(part, 16));
				else
					for (let i = 0; i < part.length; i += 2)
						b.push(parseInt(part.substring(i, i + 2), 16));
			}
		};
		const emitCmpJne = (disp, imm) =>
		{
			if (disp === 0)
				b.push(0x80, 0x3F, imm & 0xFF);
			else
				b.push(0x80, 0x7F, disp & 0xFF, imm & 0xFF);
			b.push(0x0F, 0x85);
			const rel = off();
			u32(0);
			return rel;
		};
		const emitJmp = () =>
		{
			b.push(0xE9);
			const rel = off();
			u32(0);
			return rel;
		};
		const emitMovEaxImm = value =>
		{
			b.push(0xB8);
			u32(value);
		};
		const patchRel = (at, targetVir) =>
		{
			const rel = targetVir - (caveVir + at + 4);
			b[at] = rel & 0xFF;
			b[at + 1] = (rel >>> 8) & 0xFF;
			b[at + 2] = (rel >>> 16) & 0xFF;
			b[at + 3] = (rel >>> 24) & 0xFF;
		};
		const settingsLookupReturnVir =
			Exe.BuildDate === 20250716 ? 0x0068FCE8 : 0;

		b.push(0x8B, 0x7D, 0x08); // MOV EDI,[EBP+8]
		let previousMisses = [];

		for (const entry of commands)
		{
			const commandStart = caveVir + off();
			for (const miss of previousMisses)
				patchRel(miss, commandStart);

			previousMisses = [];
			for (let i = 0; i < entry.command.length; ++i)
				previousMisses.push(emitCmpJne(i, entry.command.charCodeAt(i)));
			previousMisses.push(emitCmpJne(entry.command.length, 0));

			if (settingsLookupReturnVir)
			{
				b.push(0x8B, 0x45, 0x00); // MOV EAX,[EBP] ; caller frame
				b.push(0x81, 0x78, 0x04); // CMP DWORD PTR [EAX+4],imm32
				u32(settingsLookupReturnVir);
				b.push(0x0F, 0x85); // JNE runtime command path
				const runtimeRel = off();
				u32(0);

				hexBytes(extraPops);
				emitMovEaxImm(entry.optionId !== null ? entry.optionId : 3);
				const optionOut = emitJmp();
				patchRel(optionOut, afterHookVir);
				patchRel(runtimeRel, caveVir + off());
			}

			if (Number.isInteger(entry.targetVir) && entry.targetVir > 0)
			{
				b.push(0xE8);                     // CALL static cave
				const callRel = off();
				u32(0);
				patchRel(callRel, entry.targetVir);
			}
			else
			{
				b.push(0xFF, 0x15); u32(entry.iat); // CALL DWORD PTR [iat]
			}
			hexBytes(extraPops);
			b.push(0x33, 0xC0); // XOR EAX,EAX
			const out = emitJmp();
			patchRel(out, afterHookVir);
		}

		const notMatchedVir = caveVir + off();
		for (const miss of previousMisses)
			patchRel(miss, notMatchedVir);

		hexBytes(extraPops);
		emitMovEaxImm(3); // TT_UNKNOWN
		const notMatchedOut = emitJmp();
		patchRel(notMatchedOut, afterHookVir);

		let hex = '';
		for (const value of b)
			hex += ' ' + (value < 0x10 ? '0' : '') + value.toString(16).toUpperCase();

		Exe.SetHex(cavePhy, hex);
		Exe.SetJMP(suffixStart, caveVir, 0);

		const refreshHooks = CACHE.get('CustomSlashCommand.RefreshHooksByName') ?? {};
		for (const name in refreshHooks)
		{
			const hook = refreshHooks[name];
			if (!CustomSlashCommand.ownerIsActive(hook.owner, currentOwner))
				continue;

			CustomSlashCommand.runRefreshHook(hook);
		}

		return true;
	}
	finally
	{
		Exe.EndTag();
		Exe.ActivePatch = callerPatch;
	}
};

CustomSlashCommand.installSettingsBridge = function()
{
	const currentOwner =
		CACHE.get('CustomSlashCommand.CurrentRefreshOwner') ??
		CustomSlashCommand.ownerPatchName(Exe.ActivePatch);
	const registryByOwner =
		CACHE.get('CustomSlashCommand.RegistryByOwner') ?? {};
	const setters = [];
	const seen = {};
	for (const owner in registryByOwner)
	{
		if (!CustomSlashCommand.ownerIsActive(owner, currentOwner))
			continue;

		for (const entry of registryByOwner[owner])
		{
			if (entry.optionId === null ||
			    !Number.isInteger(entry.optionId) ||
			    !IsStr(entry.settingsExportName) ||
			    entry.settingsExportName.length === 0)
				continue;

			const key = entry.optionId.toString();
			if (seen[key])
				continue;
			seen[key] = true;

			const iat = (
				typeof CustomDLL !== "undefined" &&
				typeof CustomDLL.findIat === "function"
			)
				? CustomDLL.findIat(entry.settingsExportName, entry.dllName)
				: Exe.FindFunc(entry.settingsExportName, entry.dllName);
			if (iat < 0)
				throw Error(
					`CustomSlashCommand: settings import not found: ` +
					`${entry.dllName}!${entry.settingsExportName}`
				);

			setters.push({
				optionId: entry.optionId,
				iat,
				command: entry.command
			});
		}
	}

	if (setters.isEmpty())
		return true;

	const cacheKey = 'CustomSlashCommand.SettingsBridge';
	let state = CACHE.get(cacheKey);
	if (state && typeof state.callbackAddr === "number" &&
	    typeof state.bridgeVir === "number")
	{
		const currentTarget = Exe.GetUint8(state.callbackAddr) === 0xE9
			? Exe.GetTgtAddr(state.callbackAddr + 1)
			: -1;
		if (currentTarget !== state.bridgeVir)
			state = null;
	}

	const bridgeSize = 0x20 + setters.length * 0x30;
	if (!state || typeof state.bridgePhy !== "number")
	{
		const callbackPattern =
			'8B F9 8B 35 7C EE 31 01 85 F6 75 33';
		const callbackAddr = Exe.FindHex(callbackPattern);
		if (callbackAddr < 0)
			throw Error(
				'CustomSlashCommand: Game Settings ON/OFF callback not found'
			);

		const returnVir = Exe.Phy2Vir(callbackAddr + 8, CODE);
		const originalGlobal = Exe.GetUint32(callbackAddr + 4);
		const [bridgePhy, bridgeVir] = Exe.Allocate(bridgeSize, 0x10);
		state = {
			callbackAddr,
			returnVir,
			originalGlobal,
			bridgePhy,
			bridgeVir,
			bridgeCapacity: bridgeSize
		};
	}
	else if (typeof state.bridgeCapacity !== "number" ||
	    state.bridgeCapacity < bridgeSize)
	{
		const [bridgePhy, bridgeVir] = Exe.Allocate(bridgeSize, 0x10);
		state.bridgePhy = bridgePhy;
		state.bridgeVir = bridgeVir;
		state.bridgeCapacity = bridgeSize;
	}

	let bridge =
		' 8B F9' +
		' 8B 35 ' + state.originalGlobal.toHex();
	const appendReturn = function()
	{
		bridge += JMP(
			state.returnVir,
			state.bridgeVir + bridge.byteCount()
		);
	};

	for (const setter of setters)
	{
		bridge +=
			' 81 BF F8 00 00 00 ' + setter.optionId.toHex() +
			' 75 17' +
			' FF 75 08' +
			' FF B7 F8 00 00 00' +
			' FF 15 ' + setter.iat.toHex() +
			' 83 C4 08';
		appendReturn();
	}
	appendReturn();

	Exe.SetHex(state.bridgePhy, bridge);
	Exe.SetJMP(state.callbackAddr, state.bridgeVir, 0);
	Exe.SetHex(state.callbackAddr + 5, NOPs(3));
	state.setters = setters;
	CACHE.put(cacheKey, state);
	return true;
};

CustomSlashCommand.runRefreshHook = function(hook)
{
	if (hook.type === 'CustomSlashCommand.GameSettings')
		return CustomSlashCommand.installSettingsBridge();

	if (typeof hook.callback === "function")
		return hook.callback();

	throw Error("CustomSlashCommand: unknown refresh hook type");
};
