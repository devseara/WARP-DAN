///
/// \brief Intercepts the raw Zeny value in the Barter window and routes it
///        through the client's native number formatter to display commas.
///        e.g. "1000000 z" -> "1,000,000 z"
///
CustomBarterZenySep = function()
{
	const _ = 'CustomBarterZenySep : ';

	$$(_ + '1.1 - Find the native number formatter (sub_A7C670)')
	const fmtCode =
		"55 8B EC 83 EC ?? "
	+	"A1 ?? ?? ?? ?? "
	+	"33 C5 89 45 FC "
	+	"56 8B 75 10 "
	+	"85 F6 74 2D";

	const fmtPhy = Exe.FindHex(fmtCode);
	if (fmtPhy < 0)
		throw Error("Number formatter function not found");

	const fmtFunc = Exe.Phy2Vir(fmtPhy, CODE);

	$$(_ + '1.2 - Find both hook patterns')
	const hookCode =
		"E8 ?? ?? ?? ?? "
	+	"8B BD ?? ?? ?? ?? "
	+	"8D 45 ?? "
	+	"83 C4 ?? "
	+	"8B CF "
	+	"6A 00 6A 00 6A 0C 6A 00 6A 00 "
	+	"50";

	const addrs = Exe.FindHexN(2, hookCode);
	if (addrs.length < 2)
		throw Error("Hook pattern not found (expected 2 matches)");

	$$(_ + '1.3 - Resolve hook #1')
	const hookAddr1 = addrs[0];
	const rel1      = Exe.GetInt32(hookAddr1 + 1);
	const nextVir1  = Exe.Phy2Vir(hookAddr1 + 5, CODE);
	const drawFunc1 = nextVir1 + rel1;
	const retVir1   = nextVir1;

	$$(_ + '1.4 - Resolve hook #2')
	const hookAddr2 = addrs[1];
	const rel2      = Exe.GetInt32(hookAddr2 + 1);
	const nextVir2  = Exe.Phy2Vir(hookAddr2 + 5, CODE);
	const drawFunc2 = nextVir2 + rel2;
	const retVir2   = nextVir2;

	$$(_ + '2.1 - Allocate shared data for string + buffer')
	const [dataPhy, dataVir] = Exe.Allocate(0x20, 0x10);
	if (dataPhy < 0)
		throw Error("No free space for data");

	const strVir = dataVir;        // "%s z\0"
	const bufVir = dataVir + 0x10; // output buffer

	$$(_ + '2.2 - Write format string')
	Exe.SetHex(dataPhy, "25 73 20 7A 00"); // "%s z\0"

	$$(_ + '3.1 - Build code cave for hook #1')
	const code1 =
		" 60"
	+	" 8B 44 24 30"
	+	" 68 04 01 00 00"
	+	PUSH(bufVir)
	+	" 6A 00"
	+	" 50"
	+	CALL(Filler(1))
	+	" 83 C4 10"
	+	" 61"
	+	MOV([ESP, 0xC],  strVir)
	+	MOV([ESP, 0x10], bufVir)
	+	CALL(Filler(2))
	+	JMP(Filler(3));

	$$(_ + '3.2 - Apply hook #1')
	AutoHook(hookAddr1, code1,
	{
		targets :
		{
			1 : fmtFunc,
			2 : drawFunc1,
			3 : retVir1,
		},
	});

	$$(_ + '4.1 - Build code cave for hook #2')
	const code2 =
		" 60"
	+	" 8B 44 24 30"
	+	" 68 04 01 00 00"
	+	PUSH(bufVir)
	+	" 6A 00"
	+	" 50"
	+	CALL(Filler(1))
	+	" 83 C4 10"
	+	" 61"
	+	MOV([ESP, 0xC],  strVir)
	+	MOV([ESP, 0x10], bufVir)
	+	CALL(Filler(2))
	+	JMP(Filler(3));

	$$(_ + '4.2 - Apply hook #2')
	AutoHook(hookAddr2, code2,
	{
		targets :
		{
			1 : fmtFunc,
			2 : drawFunc2,
			3 : retVir2,
		},
	});

	return true;
}

CustomBarterZenySep.validate = () =>
	Exe.BuildDate > 20230400;