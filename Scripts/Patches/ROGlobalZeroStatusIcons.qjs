*   Created Date  : 2026-07-21                                             *
*   Last Modified : 2026-07-23                                             *
*                                                                          *
*   Description   : Version 2 ties the 2025-07-16 Ragexe status-effect     *
*                   layout to the shared RO Global Classic UI / New UI     *
*                   setting. New UI uses a resolution-aware top block      *
*                   beside the minimap while Classic UI replays the        *
*                   pristine native renderer, hover, and tooltip paths.    *
*                   Native icon rendering and scale remain untouched. New  *
*                   UI fills from the minimap toward HP/SP and wraps only  *
*                   after the resolution-derived first row is exhausted.  *
*                   Hover covers each rendered 32x32 tile on the 34x35     *
*                   grid, leaving 2px X and 3px Y gutters. QJS-only.       *
*                                                                          *
\**************************************************************************/

const GlobalZeroStatusIconStatic = {
	BuildDate: 20250716,
	DisplayPointer: 0x012515F8,
	MinimapLogicalWidth: 128,
	MinimapRightInset: 17,
	LeftBoundary: 246,
	RightInset: 172,
	FirstRowY: 34,
	HitTestTopY: 17,
	TooltipYBase: 20,
	IconSize: 16,
	HitCellWidth: 32,
	HitCellHeight: 32,
	HitCellRightOffset: 15,
	ColumnPitch: 34,
	RowPitch: 35,
	StateLastApplied: 0,
	StateSize: 4,
	RendererSite: 0x00BD43D0,
	RendererNativeResume: 0x00BD43D8,
	RendererResume: 0x00BD43FF,
	RendererBytes: "33 C0 81 C1 96 00 00 00",
	HitTestSite: 0x00C93D3E,
	HitTestNativeResume: 0x00C93D43,
	HitTestResume: 0x00C93E47,
	HitTestReject: 0x00C947E5,
	HitTestBytes: "B8 EB A0 0E EA",
	TooltipDivideSite: 0x00C94587,
	TooltipDivideResume: 0x00C9458D,
	TooltipDivideBytes: "F7 BD 5C FE FF FF",
	TooltipPristineEnd: 0x00C945E7,
	TooltipPristineSize: 0x60,
	TooltipColumnPitchSite: 0x00C94599,
	TooltipColumnPitchBytes: "6B C0 D3",
	TooltipRowPitchSite: 0x00C945A7,
	TooltipRowPitchBytes: "6B F2 23",
	TooltipYBaseSite: 0x00C945D3,
	TooltipYBaseBytes: "8D 87 AB 00 00 00",
	TooltipYClampSite: 0x00C945E1,
	TooltipYClampBytes: "81 C6 AB 00 00 00",
	RelayoutSite: 0x00BD424B,
	RelayoutResume: 0x00BD4251,
	RelayoutBytes: "8B 83 78 01 00 00 3D FE E0 F5 05"
};

GlobalZeroStatusIconStatic.normalizeHex = function(hex)
{
	return (hex || "").replace(/\s+/g, " ").trim().toUpperCase();
};

GlobalZeroStatusIconStatic.bytesToHex = function(bytes)
{
	return bytes.map(value =>
		(value & 0xFF).toString(16).padStart(2, "0")
	).join(" ");
};

GlobalZeroStatusIconStatic.assertCode = function(label, virAddr, expected)
{
	const phyAddr = Exe.Vir2Phy(virAddr);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroStatusIcons: ${label} is not mapped`);
	const normalized = GlobalZeroStatusIconStatic.normalizeHex(expected);
	const actual = GlobalZeroStatusIconStatic.normalizeHex(
		Exe.GetHex(phyAddr, normalized.split(" ").length)
	);
	if (actual !== normalized)
	{
		throw Error(
			`ROGlobalZeroStatusIcons: ${label} mismatch at ` +
			`0x${virAddr.toString(16).toUpperCase()}; got ${actual}`
		);
	}
	return phyAddr;
};

GlobalZeroStatusIconStatic.asm = function()
{
	const bytes = [];
	const labels = {};
	const fixups = [];
	const put32 = function(out, pos, value)
	{
		const v = value >>> 0;
		out[pos] = v & 0xFF;
		out[pos + 1] = (v >>> 8) & 0xFF;
		out[pos + 2] = (v >>> 16) & 0xFF;
		out[pos + 3] = (v >>> 24) & 0xFF;
	};
	const addRelative = function(target)
	{
		const pos = bytes.length;
		bytes.push(0, 0, 0, 0);
		fixups.push({pos, target});
	};
	return {
		bytes,
		emit: function(...values)
		{
			for (const value of values)
				bytes.push(value & 0xFF);
		},
		dword: function(value)
		{
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			put32(bytes, pos, value);
		},
		label: function(name)
		{
			if (labels[name] !== undefined)
				throw Error(`ROGlobalZeroStatusIcons: duplicate label ${name}`);
			labels[name] = bytes.length;
		},
		call: function(target)
		{
			bytes.push(0xE8);
			addRelative(target);
		},
		jmp: function(target)
		{
			bytes.push(0xE9);
			addRelative(target);
		},
		jcc: function(opcode, target)
		{
			bytes.push(0x0F, opcode & 0xFF);
			addRelative(target);
		},
		finish: function(baseVir)
		{
			for (const fixup of fixups)
			{
				if (typeof fixup.target === "string" &&
					labels[fixup.target] === undefined)
				{
					throw Error(
						`ROGlobalZeroStatusIcons: unresolved label ${fixup.target}`
					);
				}
				const targetVir = typeof fixup.target === "number"
					? fixup.target
					: baseVir + labels[fixup.target];
				put32(bytes, fixup.pos, targetVir - (baseVir + fixup.pos + 4));
			}
			return GlobalZeroStatusIconStatic.bytesToHex(bytes);
		}
	};
};

GlobalZeroStatusIconStatic.allocateCode = function(assembly)
{
	const [phyAddr, virAddr] = Exe.Allocate(assembly.bytes.length, 0x10);
	Exe.SetHex(phyAddr, assembly.finish(virAddr));
	return {phy: phyAddr, vir: virAddr, size: assembly.bytes.length};
};

GlobalZeroStatusIconStatic.buildPreservedThemeLoad = function(themeLoadVir)
{
	const a = GlobalZeroStatusIconStatic.asm();
	a.emit(0x9C, 0x60);                            // PUSHFD / PUSHAD
	a.call(themeLoadVir);
	a.emit(0x61, 0x9D, 0xC3);                      // POPAD / POPFD / RET
	return a;
};

GlobalZeroStatusIconStatic.buildColumnCount = function(a, widthRegister)
{
	const reserved = GlobalZeroStatusIconStatic.LeftBoundary +
		GlobalZeroStatusIconStatic.RightInset;
	if (widthRegister === "ecx")
	{
		a.emit(0x81, 0xE9); a.dword(reserved);       // SUB ECX, reserved
	}
	else
	{
		a.emit(0x8B, 0xCE);                         // MOV ECX, ESI
		a.emit(0x81, 0xE9); a.dword(reserved);       // SUB ECX, reserved
	}
	a.jcc(0x8F, "calculate_columns");              // JG calculate_columns
	a.emit(0xB9); a.dword(1);                      // MOV ECX, 1
	a.jmp("columns_ready");
	a.label("calculate_columns");
	a.emit(0x8B, 0xC1);                            // MOV EAX, ECX
	a.emit(0x33, 0xD2);                            // XOR EDX, EDX
	a.emit(0xB9); a.dword(GlobalZeroStatusIconStatic.ColumnPitch);
	a.emit(0xF7, 0xF1);                            // DIV ECX
	a.emit(0x40);                                  // INC EAX
	a.emit(0x8B, 0xC8);                            // MOV ECX, EAX
	a.label("columns_ready");
};

GlobalZeroStatusIconStatic.buildRenderer = function(themeEnabledVir, loadVir)
{
	const s = GlobalZeroStatusIconStatic;
	const a = s.asm();
	a.call(loadVir);
	a.emit(0x9C);                                    // PUSHFD
	a.emit(0x83, 0x3D); a.dword(themeEnabledVir); a.emit(0x00);
	a.jcc(0x85, "custom_renderer");                 // JNE custom_renderer
	a.emit(0x9D);                                    // POPFD
	a.emit(0x33, 0xC0, 0x81, 0xC1, 0x96, 0x00, 0x00, 0x00);
	a.jmp(s.RendererNativeResume);
	a.label("custom_renderer");
	a.emit(0x9D);                                    // POPFD
	a.emit(0xA1); a.dword(s.DisplayPointer);        // MOV EAX, [display]
	a.emit(0x8B, 0x48, 0x28);                      // MOV ECX, [EAX+28] (width)
	s.buildColumnCount(a, "ecx");
	a.emit(0x8B, 0xC3);                            // MOV EAX, EBX (icon index)
	a.emit(0x33, 0xD2);                            // XOR EDX, EDX
	a.emit(0xF7, 0xF1);                            // DIV ECX (row, column)
	a.emit(0x6B, 0xD2, s.ColumnPitch);             // IMUL EDX, EDX, column pitch
	a.emit(0xF7, 0xDA);                            // NEG EDX
	a.emit(0x81, 0xEA); a.dword(s.RightInset - 0x20); // SUB EDX, minimap reserve delta
	a.emit(0x89, 0x55, 0xF0);                      // MOV [EBP-10], EDX
	a.emit(0x6B, 0xC0, s.RowPitch);                // IMUL EAX, EAX, row pitch
	a.emit(0x05); a.dword(s.FirstRowY - 0x96);     // ADD EAX, first row-nativeY
	a.emit(0x89, 0x45, 0xF8);                      // MOV [EBP-8], EAX
	a.emit(0x8B, 0x55, 0xF0);                      // MOV EDX, [EBP-10]
	a.emit(0x8B, 0x4D, 0xFC);                      // MOV ECX, [EBP-4]
	a.jmp(s.RendererResume);
	return a;
};

GlobalZeroStatusIconStatic.buildHitTest = function(themeEnabledVir, loadVir)
{
	const s = GlobalZeroStatusIconStatic;
	const a = s.asm();
	const tooltipBaseDisp = 14 - s.RightInset;
	const rightEdgeDisp = s.HitCellRightOffset - s.RightInset;
	a.call(loadVir);
	a.emit(0x9C);                                    // PUSHFD
	a.emit(0x83, 0x3D); a.dword(themeEnabledVir); a.emit(0x00);
	a.jcc(0x85, "custom_hit_test");                 // JNE custom_hit_test
	a.emit(0x9D);                                    // POPFD
	a.emit(0xB8, 0xEB, 0xA0, 0x0E, 0xEA);
	a.jmp(s.HitTestNativeResume);
	a.label("custom_hit_test");
	a.emit(0x9D);                                    // POPFD
	s.buildColumnCount(a, "esi");
	a.emit(0x89, 0x8D, 0x5C, 0xFE, 0xFF, 0xFF);    // MOV [EBP-1A4], ECX
	a.emit(0x8D, 0x86); a.dword(tooltipBaseDisp);  // LEA EAX, [ESI-right+14]
	a.emit(0x89, 0x85, 0x50, 0xFE, 0xFF, 0xFF);    // MOV [EBP-1B0], EAX

	// Column = (right icon edge - mouse X) / pitch. The remainder rejects gaps.
	a.emit(0x8D, 0x86); a.dword(rightEdgeDisp);    // LEA EAX,[ESI-right+cell-1]
	a.emit(0x2B, 0x45, 0x08);                      // SUB EAX, [EBP+8]
	a.jcc(0x88, s.HitTestReject);                  // JS reject
	a.emit(0x33, 0xD2);                            // XOR EDX, EDX
	a.emit(0xB9); a.dword(s.ColumnPitch);          // MOV ECX, column pitch
	a.emit(0xF7, 0xF1);                            // DIV ECX
	a.emit(0x83, 0xFA, s.HitCellWidth);            // CMP EDX, hit-cell width
	a.jcc(0x83, s.HitTestReject);                  // JAE reject (horizontal gap)
	a.emit(0x3B, 0x85, 0x5C, 0xFE, 0xFF, 0xFF);    // CMP EAX, [EBP-1A4]
	a.jcc(0x83, s.HitTestReject);                  // JAE reject (past left edge)
	a.emit(0x89, 0x85, 0x68, 0xFE, 0xFF, 0xFF);    // MOV [EBP-198], EAX

	// Row = (mouse Y - top Y) / pitch. Use the same gap rejection as X.
	a.emit(0x8B, 0x45, 0x0C);                      // MOV EAX, [EBP+C]
	a.emit(0x83, 0xE8, s.HitTestTopY);             // SUB EAX, hover-grid top
	a.jcc(0x88, s.HitTestReject);                  // JS reject
	a.emit(0x33, 0xD2);                            // XOR EDX, EDX
	a.emit(0xB9); a.dword(s.RowPitch);             // MOV ECX, row pitch
	a.emit(0xF7, 0xF1);                            // DIV ECX
	a.emit(0x83, 0xFA, s.HitCellHeight);           // CMP EDX, hit-cell height
	a.jcc(0x83, s.HitTestReject);                  // JAE reject (vertical gap)
	a.emit(0x8B, 0xF0);                            // MOV ESI, EAX (row)
	a.emit(0x0F, 0xAF, 0x85, 0x5C, 0xFE, 0xFF, 0xFF); // IMUL EAX,[cols]
	a.emit(0x03, 0x85, 0x68, 0xFE, 0xFF, 0xFF);    // ADD EAX, [column]
	a.emit(0x89, 0x85, 0x68, 0xFE, 0xFF, 0xFF);    // MOV [EBP-198], EAX
	a.jmp(s.HitTestResume);
	return a;
};

GlobalZeroStatusIconStatic.buildTooltipDivide = function(
	themeEnabledVir, pristineVir, loadVir
)
{
	const s = GlobalZeroStatusIconStatic;
	const a = s.asm();
	a.call(loadVir);
	a.emit(0x9C);                                    // PUSHFD
	a.emit(0x83, 0x3D); a.dword(themeEnabledVir); a.emit(0x00);
	a.jcc(0x85, "custom_tooltip");                  // JNE custom_tooltip
	a.emit(0x9D);                                    // POPFD
	a.jmp(pristineVir);
	a.label("custom_tooltip");
	a.emit(0x9D);                                    // POPFD
	a.emit(0xF7, 0xBD, 0x5C, 0xFE, 0xFF, 0xFF);    // IDIV [EBP-1A4]
	a.emit(0x92);                                  // XCHG EAX, EDX (column, row)
	a.jmp(s.TooltipDivideResume);
	return a;
};

GlobalZeroStatusIconStatic.buildRelayout = function(
	themeEnabledVir, lastAppliedVir, loadVir
)
{
	const s = GlobalZeroStatusIconStatic;
	const a = s.asm();
	a.call(loadVir);
	a.emit(0xA1); a.dword(themeEnabledVir);          // MOV EAX,[theme enabled]
	a.emit(0x3B, 0x05); a.dword(lastAppliedVir);
	a.jcc(0x84, "replay_native");                   // JE replay_native
	a.emit(0xA3); a.dword(lastAppliedVir);
	a.emit(0xC7, 0x83, 0x74, 0x01, 0x00, 0x00); a.dword(1);
	a.label("replay_native");
	a.emit(0x8B, 0x83, 0x78, 0x01, 0x00, 0x00);    // stolen MOV EAX,[EBX+178]
	a.jmp(s.RelayoutResume);
	return a;
};

ROGlobalZeroStatusIcons = function(_)
{
	const s = GlobalZeroStatusIconStatic;
	if (Exe.BuildDate !== s.BuildDate)
		throw Error("ROGlobalZeroStatusIcons supports only the 2025-07-16 client");
	const theme = CACHE.get("ROGlobalZeroUITheme.State");
	if (!theme || !Number.isInteger(theme.stateVir) ||
		!Number.isInteger(theme.enabledOffset) ||
		!Number.isInteger(theme.loadVir))
	{
		throw Error(
			"ROGlobalZeroStatusIcons: ROGlobalZeroUITheme must run first"
		);
	}
	const themeEnabledVir = theme.stateVir + theme.enabledOffset;

	$$(_, 1, "Verify native status, hover, tooltip, and relayout seams");
	const rendererPhy = s.assertCode("renderer grid", s.RendererSite, s.RendererBytes);
	const hitTestPhy = s.assertCode("hover grid", s.HitTestSite, s.HitTestBytes);
	const relayoutPhy = s.assertCode(
		"status relayout seam", s.RelayoutSite, s.RelayoutBytes
	);
	const tooltipDividePhy = s.assertCode(
		"tooltip row/column divide", s.TooltipDivideSite, s.TooltipDivideBytes
	);
	const tooltipColumnPitchPhy = s.assertCode(
		"tooltip column pitch", s.TooltipColumnPitchSite,
		s.TooltipColumnPitchBytes
	);
	const tooltipRowPitchPhy = s.assertCode(
		"tooltip row pitch", s.TooltipRowPitchSite, s.TooltipRowPitchBytes
	);
	const tooltipYBasePhy = s.assertCode(
		"tooltip Y base", s.TooltipYBaseSite, s.TooltipYBaseBytes
	);
	const tooltipYClampPhy = s.assertCode(
		"tooltip Y clamp", s.TooltipYClampSite, s.TooltipYClampBytes
	);

	$$(_, 2, "Allocate theme bridge, relayout state, and pristine tooltip code");
	const [statePhy, stateVir] = Exe.Allocate(s.StateSize, 4);
	Exe.SetUint32(statePhy + s.StateLastApplied, 0xFFFFFFFF);
	const load = s.allocateCode(
		s.buildPreservedThemeLoad(theme.loadVir)
	);

	const [tooltipPristinePhy, tooltipPristineVir] = Exe.Allocate(
		s.TooltipPristineSize + 5, 0x10
	);
	Exe.SetHex(
		tooltipPristinePhy,
		Exe.GetHex(tooltipDividePhy, s.TooltipPristineSize)
	);
	const tooltipPristineTailPhy =
		tooltipPristinePhy + s.TooltipPristineSize;
	const tooltipPristineTailVir =
		tooltipPristineVir + s.TooltipPristineSize;
	Exe.SetHex(tooltipPristineTailPhy, "E9 00 00 00 00");
	Exe.SetInt32(
		tooltipPristineTailPhy + 1,
		s.TooltipPristineEnd - (tooltipPristineTailVir + 5)
	);

	$$(_, 3, "Build theme-gated layout, hover, tooltip, and relayout caves");
	const renderer = s.allocateCode(
		s.buildRenderer(themeEnabledVir, load.vir)
	);
	const hitTest = s.allocateCode(
		s.buildHitTest(themeEnabledVir, load.vir)
	);
	const tooltipDivide = s.allocateCode(
		s.buildTooltipDivide(
			themeEnabledVir, tooltipPristineVir, load.vir
		)
	);
	const relayout = s.allocateCode(
		s.buildRelayout(
			themeEnabledVir,
			stateVir + s.StateLastApplied,
			load.vir
		)
	);

	$$(_, 4, "Install Classic UI / New UI status-icon selection");
	Exe.SetJMP(rendererPhy, renderer.vir, 0);
	Exe.SetNOPs(rendererPhy + 5, s.RendererBytes.split(" ").length - 5);
	Exe.SetJMP(hitTestPhy, hitTest.vir, 0);
	Exe.SetJMP(tooltipDividePhy, tooltipDivide.vir, 0);
	Exe.SetNOPs(tooltipDividePhy + 5, 1);
	Exe.SetJMP(relayoutPhy, relayout.vir, 0);
	Exe.SetNOPs(relayoutPhy + 5, 1);
	Exe.SetHex(
		tooltipColumnPitchPhy,
		GlobalZeroStatusIconStatic.bytesToHex([0x6B, 0xC0, 0x100 - s.ColumnPitch])
	);
	Exe.SetHex(
		tooltipRowPitchPhy,
		GlobalZeroStatusIconStatic.bytesToHex([0x6B, 0xF2, s.RowPitch])
	);
	Exe.SetInt32(tooltipYBasePhy + 2, s.TooltipYBase);
	Exe.SetInt32(tooltipYClampPhy + 2, s.TooltipYBase);

	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
	{
		PatchDiagnostics.add("ROGlobalZeroStatusIcons.QjsOnly", {
			version: 2,
			controller: "ROGlobalZeroUITheme",
			newUiValue: 1,
			classicUiValue: 0,
			themeStateVir: theme.stateVir,
			themeEnabledVir,
			stateVir,
			lastAppliedVir: stateVir + s.StateLastApplied,
			loadVir: load.vir,
			themeLoadVir: theme.loadVir,
			rendererVir: renderer.vir,
			rendererSize: renderer.size,
			hitTestVir: hitTest.vir,
			hitTestSize: hitTest.size,
			tooltipDivideVir: tooltipDivide.vir,
			tooltipPristineVir,
			tooltipPristineSize: s.TooltipPristineSize,
			relayoutVir: relayout.vir,
			leftBoundary: s.LeftBoundary,
			rightInset: s.RightInset,
			firstRowY: s.FirstRowY,
			hitTestTopY: s.HitTestTopY,
			tooltipYBase: s.TooltipYBase,
			iconSize: s.IconSize,
			hitCellWidth: s.HitCellWidth,
			hitCellHeight: s.HitCellHeight,
			hitCellRightOffset: s.HitCellRightOffset,
			horizontalGutter: s.ColumnPitch - s.HitCellWidth,
			verticalGutter: s.RowPitch - s.HitCellHeight,
			columnPitch: s.ColumnPitch,
			rowPitch: s.RowPitch,
			dynamicColumns: true,
			slashCommand: false,
			independentPersistence: false,
			externalModules: 0
		});
	}
	return true;
};

ROGlobalZeroStatusIcons.validate = function()
{
	const s = GlobalZeroStatusIconStatic;
	if (Exe.BuildDate !== s.BuildDate)
		return false;
	try
	{
		s.assertCode("renderer grid", s.RendererSite, s.RendererBytes);
		s.assertCode("hover grid", s.HitTestSite, s.HitTestBytes);
		s.assertCode("status relayout seam", s.RelayoutSite, s.RelayoutBytes);
		s.assertCode(
			"tooltip row/column divide", s.TooltipDivideSite,
			s.TooltipDivideBytes
		);
		s.assertCode(
			"tooltip column pitch", s.TooltipColumnPitchSite,
			s.TooltipColumnPitchBytes
		);
		s.assertCode(
			"tooltip row pitch", s.TooltipRowPitchSite,
			s.TooltipRowPitchBytes
		);
		s.assertCode("tooltip Y base", s.TooltipYBaseSite, s.TooltipYBaseBytes);
		s.assertCode("tooltip Y clamp", s.TooltipYClampSite, s.TooltipYClampBytes);
		return true;
	}
	catch (error)
	{
		return false;
	}
};
