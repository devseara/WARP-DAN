|**************************************************************************|
*                                                                          *
*   Author(s)     : Louis T Steinhil                                       *
*   Last Modified : 2026-10-12                                             *
*                                                                          *
*   Description   : Stops character sprites and shadows sinking into the   *
*                   floor below their feet on 2025-07-16 Ragexe. Rect      *
*                   builder 0x00C40C20 gives each layer row depth          *
*                   z+0.16*(y-anchorY) (0.06 on one path), so rows below   *
*                   the anchor fall behind the floor in front and a hard   *
*                   line slices boots, robes and the shadow; the margin    *
*                   shrinks with zoom and low camera pitch. For CPlayer,   *
*                   CPc, CNpc, CCharacterNpc, CHallu* and CBlurPC this     *
*                   clamps (y-anchorY) to <= 0 so such rows keep the       *
*                   anchor plane; the reversed 0x9C path and effects stay  *
*                   stock. The shadow 0x00C49D20 is drawn 180 degrees      *
*                   through the anchor, so its pre-rotation offset is      *
*                   clamped to >= 0. Rows above the anchor, XY, UV,        *
*                   color and the stock contact bias are unchanged.        *
*                                                                          *
*   Evidence      : docs/sprite-quad-depth.md                              *
*   Verifier      : tools/verify_floor_safe_sprite_depth.py                *
*                                                                          *
\**************************************************************************/

FloorSafeSpriteDepth = function(_)
{
	const self = FloorSafeSpriteDepth;
	if (!self.validate())
		throw Error('FloorSafeSpriteDepth: only profiled for 2025-07-16');
	const read = (va, count) =>
	{
		const phy = Exe.Vir2Phy(va);
		if (phy < 0) throw Error('FloorSafeSpriteDepth: unmapped native address ' + va.toString(16));
		return Exe.GetHex(phy, count).replace(/\s+/g, '').toLowerCase();
	};
	const le32 = value => [0, 8, 16, 24].map(n => ((value >>> n) & 255).toString(16).padStart(2, '0')).join(' ');

	$$(_, 1, 'Verify the actor rect builder, shadow builder and actor vtables');
	if (read(self.bodySig, self.bodyHex.length / 2) !== self.bodyHex)
		throw Error('FloorSafeSpriteDepth: actor rect builder differs from the 2025-07-16 profile');
	if (read(self.shadowSig, self.shadowHex.length / 2) !== self.shadowHex)
		throw Error('FloorSafeSpriteDepth: shadow builder differs from the 2025-07-16 profile');
	for (const actor of self.actors)
	{
		// CelestialDial may already own CPlayer's draw slot. Its registered
		// wrapper still runs the native draw exactly once; retain that owner.
		const weather = CACHE.get("CelestialDial.Contract.v3");
		const render = read(actor.vtable + 0x0C, 4);
		const weatherPlayer = actor.name === "CPlayer" && weather &&
			Number.isInteger(weather.playerDraw) &&
			render === le32(weather.playerDraw).replace(/ /g, '');
		if (read(actor.vtable + 0x24, 4) !== le32(0x00C40C20).replace(/ /g, '') ||
			(render !== le32(actor.render).replace(/ /g, '') && !weatherPlayer))
			throw Error('FloorSafeSpriteDepth: unexpected ' + actor.name + ' vtable');
	}

	$$(_, 2, 'Build the floor-safe depth caves');
	// Items: hex text, {label}, {jcc8, to} or {jmp32: absolute target}.
	const assemble = (origin, items) =>
	{
		const size = item => typeof item === 'string' ? item.trim().split(/\s+/).length :
			item.label !== undefined ? 0 : item.jcc8 ? 2 : 5;
		const labels = {};
		let at = origin;
		for (const item of items)
		{
			if (typeof item !== 'string' && item.label !== undefined) labels[item.label] = at;
			at += size(item);
		}
		const out = [];
		at = origin;
		for (const item of items)
		{
			if (typeof item === 'string') out.push(item.trim());
			else if (item.jcc8)
			{
				const rel = labels[item.to] - (at + 2);
				if (!(rel >= -128 && rel <= 127)) throw Error('FloorSafeSpriteDepth: rel8 out of range');
				out.push(item.jcc8 + ' ' + ((rel + 256) & 255).toString(16).padStart(2, '0'));
			}
			else if (item.jmp32 !== undefined) out.push('E9 ' + le32((item.jmp32 - (at + 5)) >>> 0));
			at += size(item);
		}
		return out.join(' ');
	};
	const [phy, vir] = Exe.Allocate(self.caveSize, 0x10);
	const zero = le32(vir);
	const bodyVir = vir + 0x10;
	// Entered from 0x00C40F9F after cmp byte [edi+0x9C],0. SSE ops keep EFLAGS,
	// and the actor test is wrapped in pushfd/popfd so the native je still sees
	// that comparison. EAX holds the native depth-bias index and is preserved.
	const bodyCave = ['F3 0F 5C 6D 1C', {jcc8: '75', to: 'back'}, '9C 50 8B 07'];
	for (const actor of self.actors)
		bodyCave.push('3D ' + le32(actor.vtable), {jcc8: '74', to: 'clamp'});
	bodyCave.push(
		{jcc8: 'EB', to: 'restore'},
		{label: 'clamp'},
		'F3 0F 5D 25 ' + zero,
		'F3 0F 5D 2D ' + zero,
		{label: 'restore'},
		'58 9D',
		{label: 'back'},
		{jmp32: 0x00C40FA4}
	);
	const bodyCode = assemble(bodyVir, bodyCave);
	const shadowVir = bodyVir + bodyCode.split(' ').length;
	// Replays 0x00C49FEE..0x00C4A003 with both pre-rotation offsets clamped.
	const shadowCode = assemble(shadowVir, [
		'F3 0F 5F 3D ' + zero,
		'F3 0F 59 3D 7C D4 1D 01',
		'03 C8 0F B6 47 12',
		'F3 0F 5F 35 ' + zero,
		'F3 0F 59 35 7C D4 1D 01',
		{jmp32: 0x00C4A004}
	]);
	const caveBytes = 0x10 + bodyCode.split(' ').length + shadowCode.split(' ').length;
	if (caveBytes > self.caveSize)
		throw Error('FloorSafeSpriteDepth: cave overflow ' + caveBytes);
	Exe.SetHex(phy, '00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 ' + bodyCode + ' ' + shadowCode);

	$$(_, 3, 'Route the below-anchor depth rows through the caves');
	Exe.SetHex(Exe.Vir2Phy(0x00C40F9F), 'E9 ' + le32((bodyVir - 0x00C40FA4) >>> 0));
	Exe.SetHex(Exe.Vir2Phy(0x00C49FEE), 'E9 ' + le32((shadowVir - 0x00C49FF3) >>> 0) + ' 90'.repeat(17));
	return true;
};
FloorSafeSpriteDepth.validate = () => Exe.BuildDate === 20250716;

FloorSafeSpriteDepth.caveSize = 0xA0;
FloorSafeSpriteDepth.actors = [
	{name: "CPlayer", vtable: 0x01094810, render: 0x00D3A220},
	{name: "CPc", vtable: 0x010943A8, render: 0x00D3A220},
	{name: "CNpc", vtable: 0x010939D4, render: 0x00D32600},
	{name: "CCharacterNpc", vtable: 0x00FD8CE8, render: 0x00598AD0},
	{name: "CHalluPC", vtable: 0x01093C44, render: 0x00D32470},
	{name: "CHalluPC2", vtable: 0x01093D40, render: 0x00D323F0},
	{name: "CHalluNPC", vtable: 0x01093E3C, render: 0x00D32290},
	{name: "CBlurPC", vtable: 0x01093B48, render: 0x00D32100}
];
// 0x00C40F7B..0x00C41078: bias index, (bottom/top - anchorY) in XMM4/XMM5,
// the 0x9C branch and both +0.16/+0.06 reciprocal-depth paths.
FloorSafeSpriteDepth.bodySig = 0x00C40F7B;
FloorSafeSpriteDepth.bodyHex = '';
// 0x00C49FB3..0x00C4A05E: shadow rows, z-0.16*(y-anchorY) and RHW stores.
FloorSafeSpriteDepth.shadowSig = 0x00C49FB3;
FloorSafeSpriteDepth.shadowHex = '';
