	{address:0x008B43FD,original:"0F 85 BE 02 00 00",predicate:"ItemDescriptionCustomDraw",target:0x008B4712,fallTarget:0x008B46C1}
];
ItemDescriptionNative.installLifecycleHooks = function(c, entries)
{
