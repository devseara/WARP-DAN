	{address:0x008C2238,original:"80 BF 0C 02 00 00 00",predicate:"ItemDescriptionNativeOpen",target:0x008C2284,fastHex:"C7 87 FC 01 00 00 00 00 00 00"},
	{address:0x008C2554,original:"8B 8F B0 01 00 00",predicate:"ItemDescriptionNativeOpen",target:0x008C2A78},
	{address:0x008C2B53,original:"8B 87 B0 01 00 00",predicate:"ItemDescriptionNativeOpen",target:0x008C2C58,fastHex:"8B B5 D8 FD FF FF"},
