	{
		c.assertCode("ItemDescription " + spec.name + " inspection entry", spec.address, spec.original);
		const a = c.asm(); a.emit(...spec.original.split(" ").map(value => parseInt(value, 16))); a.jmp(spec.address + 5);
		const trampoline = ItemDescriptionNative.code(a), entry = entries["ItemDescription" + spec.name + "Right"];
