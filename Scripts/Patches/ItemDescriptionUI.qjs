// The redesigned Inventory/Cart/Storage windows install their own vtables and
// call these native handlers directly. Scope the shared function entry instead
// of competing for their virtual right-click slot. No pending-byte chaining.
ItemDescriptionNative.SourceEntries = [
	{name:"Inventory",address:0x0094F380,original:"55 8B EC 6A FF",configWord:57},
	{name:"Cart",address:0x0094FAA0,original:"55 8B EC 6A FF",configWord:166},
	{name:"Storage",address:0x0094F200,original:"55 8B EC 6A FF",configWord:167}
