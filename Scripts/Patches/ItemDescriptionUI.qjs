	a.emit(0x9C, 0x60, 0xFC, 0xBE); a.dword(c.PacketBuffer);
	a.emit(0x66, 0x81, 0x3E); a.word(0x0BEF); a.jcc(0x85, "fallback");
	a.emit(0x66, 0x83, 0x7E, 2, 8); a.jcc(0x82, "fallback");
	a.emit(0x81, 0x7E, 4); a.dword(b.Magic); a.jcc(0x85, "fallback");
	a.emit(0x0F, 0xB7, 0x46, 2, 0x50, 0x56); a.call(entry);
	a.emit(0x61, 0x9D); a.jmp(c.PacketMainLoopReturn);
	a.label("fallback"); a.emit(0x61, 0x9D); a.jmp(fallback);
	return a;
};
// Only these profiled blocks build/paint the legacy body underneath our card.
// Predicates are scoped to the exact native receiver; stock fallback, CItem
