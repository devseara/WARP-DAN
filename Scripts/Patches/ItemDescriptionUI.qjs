	Vtable: 0x01032AAC,
	ComparisonVtable: 0x01032C5C,
	ComponentVtable: 0x01032B84,
	InventoryVtable: 0x0103D460,
	EquipmentVtable: 0x0103223C,
	InventoryRight: 0x0094F380,
	EquipmentRight: 0x008BB340,
	RequestSize: 96,
	SnapshotSize: 12416,
	StateSize: 123664,
	ui: function() { return ItemCollectionUI.nativeFrameV1; }
};
ItemDescriptionNative.code = function(a)
{
	const c = ItemDescriptionNative.ui();
	const [phy, vir] = Exe.Allocate(a.bytes.length, 16);
	if (phy < 0 || vir <= 0 || Exe.Vir2Phy(vir) !== phy)
		throw Error("ItemDescriptionUI: invalid code allocation");
