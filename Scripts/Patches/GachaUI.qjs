	// Center the actual bitmap dimensions, including non-24px item artwork.
	a.emit(0xB9);a.dword(h);a.emit(0x2B,0x88);a.dword(n.TextureHeightOffset);a.emit(0xD1,0xE9,0x81,0xC1);a.dword(y);a.emit(0x51);
	a.emit(0xB9);a.dword(w);a.emit(0x2B,0x88);a.dword(n.TextureWidthOffset);a.emit(0xD1,0xE9,0x81,0xC1);a.dword(x+g.ContentX);a.emit(0x51,0x50,0x56);a.call(art.blit);a.label(done);
};
GachaUIStatic.finalize = function() {
	const a=AutoCombatUI.nativeHelpers.asm();
	// GDI TextDraw leaves zero alpha in its colored foreground pixels.
	// Preserve untouched transparent corners, normalize painted pixels only.
	a.emit(0x53,0x56,0x8B,0x71,0x24,0x85,0xF6); a.jcc(0x84,"done");
	a.emit(0x8B,0x4E,4,0x0F,0xAF,0x4E,8,0x8B,0x76,0x18,0x85,0xC9); a.jcc(0x84,"done");
	a.label("pixel"); a.emit(0x8B,0x06,0x85,0xC0); a.jcc(0x84,"next");
	a.emit(0x0D); a.dword(0xFF000000); a.emit(0x89,0x06);
	a.label("next"); a.emit(0x83,0xC6,4,0x49); a.jcc(0x85,"pixel");
	a.label("done"); a.emit(0x5E,0x5B,0xC3); return a;
};
// thiscall(x,y,texture,stretchInput), private to Gacha. PNG pixels are already
// composited over the opaque parent; never switch CSurface's upload mode.
// Stock 0x53F290/0x53EA90 caches eight opaque <=256px tiles for 920x440. Setting
// +0x28 to 1 later reuses those tiles as full-window alpha textures: the entire
// window shrinks into each tile and all tiles are presented at the same origin.
GachaUIStatic.arrowDraw = function(png) {
	const n=AutoCombatUI.nativeHelpers,a=n.asm();
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x8B,0x71,0x24,0x85,0xF6);a.jcc(0x84,"done");
	a.emit(0x0F,0xB6,0x5E,0x28);
	for(const off of [20,16,12,8])a.emit(0xFF,0x75,off);
	a.call(png);a.emit(0x88,0x5E,0x28);
	a.label("done");a.emit(0x5E,0x5B,0x5D,0xC2,16,0);return a;
};
// Draw the original marketui/itembox_00.png's blue-Z region without changing
// the source file. Also accepts a standalone <=26px replacement zeny.png.
GachaUIStatic.zenyDraw = function(png) {
	const n=AutoCombatUI.nativeHelpers,a=n.asm(),temp=n.allocateBytes(new Array(0x130+13*13*4).fill(0),4).vir;
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x57,0x8B,0x75,12);
	a.emit(0x81,0xBE);a.dword(n.TextureWidthOffset);a.dword(161);a.jcc(0x85,"standalone");
	a.emit(0x81,0xBE);a.dword(n.TextureHeightOffset);a.dword(18);a.jcc(0x85,"done");
	// The profiled native descriptor is exactly 0x120 bytes; do not read
	// allocator padding beyond it when making the private cropped view.
