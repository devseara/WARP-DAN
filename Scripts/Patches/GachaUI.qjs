	const rect=(x,y,w,h,c)=>n.emitFillRect(a,fill,x,y,w,h,c);
	const text=(v,x,y,c=0x005A5A5A,b=0,h=12)=>g.text(a,n.allocateString(v).vir,x,y,c,b,h);
	const val=(off,x,y,c=0x005A5A5A)=>g.text(a,p+off,x,y,c);
