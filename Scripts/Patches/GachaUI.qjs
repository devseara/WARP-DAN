	a.emit(0x0D); a.dword(0xFF000000); a.emit(0x89,0x06);
	a.label("next"); a.emit(0x83,0xC6,4,0x49); a.jcc(0x85,"pixel");
	a.label("done"); a.emit(0x5E,0x5B,0xC3); return a;
};
// thiscall(x,y,texture,stretchInput), private to Gacha. PNG pixels are already
// composited over the opaque parent; never switch CSurface's upload mode.
// Stock 0x53F290/0x53EA90 caches six opaque <=256px tiles for 760x440. Setting
// +0x28 to 1 later reuses those tiles as full-window alpha textures: the entire
// window shrinks into each tile and all six are presented at the same origin.
