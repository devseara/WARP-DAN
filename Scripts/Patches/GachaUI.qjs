	// taken for inspection, so that outside right-up belongs to another window.
	a.emit(0x83,0x3D); a.dword(0x11E40E8); a.emit(0); a.jcc(0x85,"right_held");
	g.store(a,s+g.RightPressed,0); a.label("right_held");
	a.emit(0xFF,0x15); a.dword(n.TimeGetTimeIat); a.emit(0x8B,0xD8);
	// Server-relative countdown: never trust the PC's wall clock. Continue to
	// disable pulls at zero even if a wallet reply is delayed or lost.
	a.emit(0xF7,0x05);a.dword(s+g.Wallet+24);a.dword(1024);a.jcc(0x84,"countdown_done");
	a.emit(0x2B,0x05);a.dword(s+g.WalletTick);a.emit(0x33,0xD2,0xB9);a.dword(1000);a.emit(0xF7,0xF1);
	a.emit(0x8B,0x0D);a.dword(s+g.Wallet+668);a.emit(0x2B,0xC8);a.jcc(0x83,"countdown_positive");a.emit(0x33,0xC9);
	a.label("countdown_positive");a.emit(0x3B,0x0D);a.dword(s+g.Remaining);a.jcc(0x84,"countdown_done");
	a.emit(0x89,0x0D);a.dword(s+g.Remaining);n.emitMarkDirty(a);
	a.emit(0x85,0xC9);a.jcc(0x85,"countdown_done");a.emit(0x81,0x25);a.dword(s+g.Snapshot+24);a.dword(0xFFFFFF1E);
	a.label("countdown_done");a.emit(0x8B,0xC3);
	a.emit(0x83,0x3D); a.dword(s+g.Rolling); a.emit(0); a.jcc(0x84,"pending");
	// Animation uses its own continuous clock. Delivery ACKs only reset the
	// server deadline clock, never the animation phase of unfinished slots.
	a.emit(0x2B,0x05);a.dword(s+g.SpinEpoch);
	a.emit(0x33,0xD2,0xB9); a.dword(100); a.emit(0xF7,0xF1);
	a.emit(0xA3); a.dword(s+g.Spin); n.emitMarkDirty(a);
	a.emit(0x8B,0xFB,0x2B,0x3D);a.dword(s+g.RevealTick);
	// Remaining slots keep spinning while this slot's authoritative reply is
	// pending. Revealed slots no longer read Spin or cosmetic item IDs.
	a.emit(0x83,0x3D); a.dword(s+g.Rolling); a.emit(1); a.jcc(0x85,"pending");
	a.emit(0x83,0x3D);a.dword(s+g.SkipQueued);a.emit(0);a.jcc(0x85,"finish_roll");
	a.emit(0x3B,0x3D); a.dword(s+g.Snapshot+668); a.jcc(0x82,"pending");
	a.label("finish_roll"); g.store(a,s+g.Rolling,2);
	a.emit(0x83,0x3D);a.dword(s+g.SkipQueued);a.emit(0);a.jcc(0x84,"next_slot");
	g.store(a,s+g.SkipQueued,0);for(const v of [0,0,13])n.pushImm(a,v);a.call(sender);a.jmp("done");
	a.label("next_slot");
	// Request only the exact next slot, never a reward ID or price. The server
	// enforces the deadline and this index, preventing replay/skip-ahead pulls.
	n.pushImm(a,0); a.emit(0xA1); a.dword(s+g.Snapshot+24); a.emit(0xC1,0xE8,16,0x40,0x50); n.pushImm(a,6);
	a.call(sender); n.emitMarkDirty(a); a.jmp("done");
	a.label("pending"); a.emit(0x83,0x3D); a.dword(s+g.Pending); a.emit(0); a.jcc(0x84,"wallet_poll");
	a.emit(0x2B,0x1D); a.dword(s+g.PendingTick); a.emit(0x81,0xFB); a.dword(5000); a.jcc(0x82,"done");
	// Never automatically retry a purchase. A new request must use server state.
	g.store(a,s+g.Pending,0); g.store(a,s+g.Modal,0);
	// An uncertain completion is never retried automatically. Close/reopen to
	// recover; keep pull input locked instead of creating a second purchase.
	n.emitMarkDirty(a);
	a.jmp("done");a.label("wallet_poll");
	// Metadata only, never a paid request. Do not interrupt in-flight reels,
	// item inspection/dragging or a held button. Existing purchase timeouts stay.
	for(const off of [g.Rolling,g.Pressed,g.RightPressed,g.LeftItem,g.Dragging]) {a.emit(0x83,0x3D);a.dword(s+off);a.emit(0);a.jcc(0x85,"done");}
	a.emit(0xF7,0x05);a.dword(s+g.Snapshot+24);a.dword(256);a.jcc(0x84,"done");
	a.emit(0x8B,0xC3,0x2B,0x05);a.dword(s+g.WalletPoll);a.emit(0x3D);a.dword(1000);a.jcc(0x82,"done");
	a.emit(0x89,0x1D);a.dword(s+g.WalletPoll);for(const v of [0,0,12])n.pushImm(a,v);a.call(sender);
	a.label("done"); a.emit(0x61,0x9D,0xC2,16,0); return a;
};
GachaUIStatic.stop = function(s) {
