GachaUIStatic.timer = function(s,sender) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x9C,0x60,0x8B,0x35); a.dword(s+g.Window); a.emit(0x85,0xF6); a.jcc(0x84,"done");
	a.emit(0x80,0x7E,n.WindowVisibleOffset,0); a.jcc(0x84,"done");
