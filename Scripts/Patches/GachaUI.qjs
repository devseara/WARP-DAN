GachaUIStatic.icon = function(a,s,art,off,x,y,label,w=32,h=32) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,done=label+"_done";
	if(off!==null) { a.emit(0xA1); a.dword(s+g.Snapshot+off); }
	a.emit(0x85,0xC0); a.jcc(0x84,done);
	// Resolve every reward/ticket/featured/rolling ItemId through the current
	// client item database. Item artwork is not copied or overridden in gachaui.
	a.emit(0x50); a.call(art.resolver); a.emit(0x85,0xC0); a.jcc(0x84,done); a.emit(0x33,0xC9);
	a.label(label+"_key"); a.emit(0x80,0x3C,0x08,0); a.jcc(0x84,label+"_path");
	a.emit(0x41,0x81,0xF9); a.dword(180); a.jcc(0x82,label+"_key"); a.jmp(done);
	a.label(label+"_path"); a.emit(0x50); n.pushImm(a,art.format); n.pushImm(a,art.path); a.call(n.StringFormat); a.emit(0x83,0xC4,12);
	n.emitLoadSurface(a,art.path,done);
