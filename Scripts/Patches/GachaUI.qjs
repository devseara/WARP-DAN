GachaUI = function(_) {
	if(Exe.BuildDate!==20250716 || typeof AutoCombatUI==="undefined" || !AutoCombatUI.nativeHelpers) throw Error("GachaUI requires the 2025-07-16 native helpers");
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic;
	for(const [name,va,bytes] of [
		["frame constructor",n.FrameConstructor,"55 8B EC 6A FF 68 F9 45 EA 00"],
		["frame down",n.FrameMouseDown,"55 8B EC 83 EC 08 56 8B F1"],
		["frame drag",0x880E00,"55 8B EC 83 EC 1C 53 8B D9"],
		["text metrics",n.TextWidth,"55 8B EC 6A FF 68 5D B6 EE 00"],
		["mesitemicon dispatch",0x00803D15,"6A 0C B9 E8 F4 31 01 C6 85 54 FF FF FF 01 E8 18 56 23 00"],
		["CItem constructor",0x006A1B20,"55 8B EC 6A FF 68 8B 54 E5 00"],
		["CItem destructor",0x005A4300,"55 8B EC 6A FF 68 8B 33 E2 00"],
		["cursor action",0xA764A0,"55 8B EC 8B 45 08 56 8B F1 39 46 50"]]) n.assertCode("Gacha "+name,va,bytes);
	n.assertCode("Gacha manager right down",0xA46ECD,"FF 90 80 00 00 00");
	n.assertCode("Gacha manager right up",0xA46F32,"FF 90 84 00 00 00");
	n.assertCode("Gacha native surface mode",0x53EAB2,"80 7F 28 01");
	for(const [slot,expected] of [[0,n.FrameDeletingDestructor],[20,n.FrameVtableDraw],[25,n.FrameMouseDown],[27,0x880E00],[31,n.FrameMouseUp],[32,0x005A8A50],[33,0x005A8A60]]) n.assertVtableSlot("Gacha frame",slot,expected);
	const state=n.allocateBytes(new Array(g.StateSize).fill(0),4),s=state.vir;
	const refs=n.resolvePacketRefs(),sender=n.allocateCode(g.sender(s,refs));
	const timer=n.allocateCode(g.timer(s,sender.vir)),stop=n.allocateCode(g.stop(s));
	const imports={module:Exe.FindFunc("GetModuleHandleA","KERNEL32.dll"),proc:Exe.FindFunc("GetProcAddress","KERNEL32.dll")};
	if(imports.module<0 || imports.proc<0) throw Error("GachaUI: timer imports unavailable");
	const strings={user32:n.allocateString("user32.dll").vir,set:n.allocateString("SetTimer").vir,kill:n.allocateString("KillTimer").vir};
	const start=n.allocateCode(g.start(s,timer.vir,imports,strings));
	const fill=n.allocateCode(n.buildFillRect()),fit=n.allocateCode(g.fitText());
	const rollBytes=[]; for(const id of g.RollIcons) rollBytes.push(id&255,id>>>8&255,id>>>16&255,id>>>24);
	const art={resolver:n.allocateCode(n.buildItemIconResolver()).vir,blit:n.allocateCode(n.buildColorKeyBlit()).vir,
		buttonText:n.allocateCode(g.fitText(true)).vir,
		balanceText:n.allocateCode(g.fitText(false,true)).vir,
		plain:n.allocateCode(g.plainText()).vir,
		plainCenter:n.allocateCode(g.plainText(true)).vir,
		png:n.allocateCode(g.arrowDraw(n.allocateCode(ModernChatUI.nativeHelpers.buildPngDraw(n.allocateCode(ModernChatUI.nativeHelpers.buildBlendPixel()).vir)).vir)).vir,
		arrows:g.Assets.map(file=>n.buildResourcePath("gachaui\\"+file).vir),
		cards:g.CardAssets.map(file=>n.buildResourcePath("gachaui\\"+file).vir),
		bannerFormat:n.buildResourcePath("gachaui\\banner_%u.png").vir,
		customBannerFormat:n.buildResourcePath("gachaui\\%s").vir,
		buttons:g.controls.filter(c=>c.label).reduce((buttons,c)=>{buttons[c.id]={};for(const state of ['out','over','press','off'])buttons[c.id][state]=n.buildResourcePath("gachaui\\button_"+c.id+"_"+state+".png").vir;return buttons;},{}),
		currency:['zeny','ticket'].map(name=>{const paths={};for(const state of ['out','selected','off'])paths[state]=n.buildResourcePath("gachaui\\currency_"+name+"_"+state+".png").vir;return paths;}),
		star:n.buildResourcePath("gachaui\\rarity_star.png").vir,zeny:n.buildResourcePath("gachaui\\zeny.png").vir,
		quantity:n.allocateBytes(new Array(32).fill(0),4).vir,
		countdown:n.allocateBytes(new Array(64).fill(0),4).vir,
		rollIds:n.allocateBytes(rollBytes,4).vir,
		finalize:n.allocateCode(g.finalize()).vir,
		format:n.buildResourcePath("item\\%s.bmp").vir,path:n.allocateBytes(new Array(512).fill(0),4).vir};
	art.zenyDraw=n.allocateCode(g.zenyDraw(art.png)).vir;
	const hit=n.allocateCode(g.hit(s)),draw=n.allocateCode(g.draw(s,fill.vir,fit.vir,art));
	const itemHit=n.allocateCode(g.itemHit(s)),rightDown=n.allocateCode(g.itemRight(s,itemHit.vir,art.resolver,false)),rightUp=n.allocateCode(g.itemRight(s,itemHit.vir,art.resolver,true));
	const down=n.allocateCode(g.mouse(s,hit.vir,sender.vir,stop.vir,false,itemHit.vir,rightDown.vir,rightUp.vir)),up=n.allocateCode(g.mouse(s,hit.vir,sender.vir,stop.vir,true,itemHit.vir,rightDown.vir,rightUp.vir));
	const move=n.allocateCode(g.move(s,hit.vir,itemHit.vir)),cursor=n.allocateCode(g.move(s,hit.vir,itemHit.vir,true));
	const drag=n.allocateCode(g.drag(s,move.vir)),destroy=n.allocateCode(g.destroy(s,stop.vir));
	const source=Exe.Vir2Phy(n.FrameVtable-4),table=n.allocateBytes(new Array(4+n.FrameVtableEntries*4).fill(0),4);
	Exe.SetHex(table.phy,Exe.GetHex(source,table.size));
	for(const [slot,code] of [[0,destroy],[20,draw],[25,down],[27,drag],[28,move],[30,cursor],[31,up],[32,rightDown],[33,rightUp]]) Exe.SetUint32(table.phy+4+slot*4,code.vir);
	const open=n.allocateCode(g.open(s,table.vir+4,start.vir));
	const entry=n.packetTableEntryVir(0x0BF6),phy=Exe.Vir2Phy(entry,CODE);
	if(phy<0) throw Error("GachaUI: snapshot dispatcher unavailable");
	const receiver=n.allocateCode(g.receiver(s,n.PacketMainLoopReturn,open.vir));
	n.registerPacket0BF6(_,"gcha",receiver.vir);
	const contract={state:s,draw:draw.vir,hit:hit.vir,down:down.vir,up:up.vir,move:move.vir,cursor:cursor.vir,drag:drag.vir,
		open:open.vir,receiver:receiver.vir,sender:sender.vir,timer:timer.vir,start:start.vir,stop:stop.vir,destroy:destroy.vir,
		vtable:table.vir+4,fill:fill.vir,fit:fit.vir,resolver:art.resolver,blit:art.blit,packetSize:g.PacketSize,
		packetCtor:refs.packetCtorA,packetSend:refs.packetSend,
		itemHit:itemHit.vir,rightDown:rightDown.vir,rightUp:rightUp.vir,spinOffset:g.Spin,rightOffset:g.RightPressed,
		rollLead:g.RollLeadMs,revealStep:g.RevealStepMs,rollIds:art.rollIds,rollCount:g.RollIcons.length,plain:art.plain,png:art.png,plainCenter:art.plainCenter,refs};
	const marker=n.allocateString("GachaUI.v22"),record=[];
	for(const value of [marker.vir,...Object.values(contract).filter(Number.isInteger)]) record.push(value&255,value>>>8&255,value>>>16&255,value>>>24);
	n.allocateBytes(record,4); CACHE.put("GachaUI.Contract.v22",contract);
	GachaUI.onApplied();
	console.info("GachaUI contract: "+JSON.stringify(contract)); return true;
};
GachaUI.validate = () => Exe.BuildDate===20250716;
GachaUI.onApplied = function() {
	if(Warp.TestMode) return;
	const root=System.DirPath(Warp.TgtExe),folders=["data","texture",ModernChatUI.nativeHelpers.uiPrefix(),"gachaui"];
	let target=root;for(const folder of folders) {target+="/"+folder;if(!System.MkDir(target))throw Error("GachaUI: cannot create "+target);}
	for(const file of [...GachaUIStatic.Assets,...GachaUIStatic.CardAssets,...GachaUIStatic.BannerAssets,...GachaUIStatic.WidgetAssets,...GachaUIStatic.buttonAssets()]) {
		const existing=new BinFile(target+"/"+file,'r'),present=existing.Valid;existing.Close();if(present)continue;
		if(!System.Copy(Warp.Path+"/Assets/GachaUI/"+file,target+"/"+file,false))throw Error("GachaUI: cannot install "+file);
	}
	const zenySource=new BinFile(Warp.Path+"/Assets/GachaUI/zeny.png",'r'),hasZeny=zenySource.Valid;zenySource.Close();
	const zenyTarget=new BinFile(target+"/zeny.png",'r'),customZeny=zenyTarget.Valid;zenyTarget.Close();
	if(hasZeny&&!customZeny&&!System.Copy(Warp.Path+"/Assets/GachaUI/zeny.png",target+"/zeny.png",false))throw Error("GachaUI: cannot install zeny.png");
};
