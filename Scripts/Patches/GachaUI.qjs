GachaUIStatic.mouse = function(s,hit,sender,stop,release,itemHit,rightDown,rightUp) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x57,0x8B,0xF1,0xFF,0x75,12,0xFF,0x75,8); a.call(hit); a.emit(0x8B,0xD8);
	if(release) {
		a.emit(0x8B,0x3D); a.dword(s+g.Pressed); g.store(a,s+g.Pressed,0); g.release(a,s,"release");
		a.emit(0xA1);a.dword(s+g.LeftItem);g.store(a,s+g.LeftItem,0);a.emit(0x85,0xC0);a.jcc(0x84,"control_release");
		a.emit(0xA3);a.dword(s+g.RightPressed);a.emit(0xFF,0x75,12,0xFF,0x75,8,0x8B,0xCE);a.call(rightUp);a.jmp("done");a.label("control_release");
		a.emit(0x85,0xDB); a.jcc(0x84,"done"); a.emit(0x3B,0xDF); a.jcc(0x85,"done");
		for(const c of g.controls) {
			const next="action"+c.id; a.emit(0x83,0xFB,c.id); a.jcc(0x85,next);
			if(c.motion) {a.emit(0x83,0x35);a.dword(s+g.MotionOff);a.emit(1);a.jmp("done");a.label(next);continue;}
			if(c.skip) {
				// Send immediately, including while an earlier slot is pending.
				// TCP/server dispatch serialize the requests; Sequence rejects the
				// superseded slot's reply, and the final batch snapshot owns all rows.
				g.store(a,s+g.Skip,1);g.store(a,s+g.SkipQueued,0);g.store(a,s+g.Rolling,2);
				for(const v of [0,0,13])n.pushImm(a,v);a.call(sender);
				a.jmp("done");a.label(next);continue;
			}
			const action=c.currency!==undefined?11:c.banner!==undefined?9:c.bannerPage?10:c.action??(c.close?4:c.id===20?5:c.id===21?2:c.count?1:3);
			if(c.banner!==undefined) {n.pushImm(a,0);a.emit(0xFF,0x35);a.dword(s+g.Catalog+672+c.banner*96);}
			else if(c.bannerPage) {n.pushImm(a,0);a.emit(0xA1);a.dword(s+g.Catalog+g.Page);a.emit(c.bannerPage<0?0x48:0x40,0x50);}
			else if(c.page) {
