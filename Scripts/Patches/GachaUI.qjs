GachaUIStatic.store = function(a, address, value) {
	a.emit(0xC7,0x05); a.dword(address); a.dword(value);
};
GachaUIStatic.text = function(a, ptr, x, y, color=0x005A5A5A, bold=0, height=12) {
	const n=AutoCombatUI.nativeHelpers;
	for(const v of [0,bold,color,height,0,0,ptr,y,x]) n.pushImm(a,v);
	a.emit(0x8B,0xCE); a.call(n.TextDraw);
};
// stdcall(window, source, x, y, maxWidth, color). Explicit byte lengths preserve
// complete short labels; long text is bounded to its card. Returns the fitted
// native pixel width in EAX, also used by the compact base-rate column.
GachaUIStatic.fitText = function(center=false) {
	const n=AutoCombatUI.nativeHelpers,a=n.asm();
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x57,0x8B,0x75,8,0x8B,0x7D,12,0x33,0xDB);
	a.label("length"); a.emit(0x83,0xFB,127); a.jcc(0x83,"measure");
	a.emit(0x80,0x3C,0x1F,0); a.jcc(0x84,"measure"); a.emit(0x43); a.jmp("length");
	a.label("measure"); a.emit(0x33,0xC0,0x85,0xDB); a.jcc(0x84,"done");
	for(const v of [0,0,12,0]) n.pushImm(a,v);
	a.emit(0x53,0x57,0x8B,0xCE); a.call(n.TextWidth);
	a.emit(0x3B,0x45,24); a.jcc(0x86,"draw");
	a.emit(0x4B); a.jmp("measure");
	a.label("draw"); a.emit(0x50);
	if(center) a.emit(0x8B,0x55,24,0x2B,0xD0,0xD1,0xEA,0x03,0x55,16,0x89,0x55,16);
	for(const v of [0,0]) n.pushImm(a,v);
	a.emit(0xFF,0x75,28); for(const v of [12,0]) n.pushImm(a,v);
	a.emit(0x53,0x57,0xFF,0x75,20,0xFF,0x75,16,0x8B,0xCE); a.call(n.TextDraw); a.emit(0x58);
	a.label("done"); a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,24,0); return a;
};
// Same six-argument fit ABI, but ONLY canonical Gacha character names use this
// private GDI path. Never toggle shared EXTN features or patch global TextOut.
// Native surface acquisition/font cache are retained; raw imported GDI consumes
// the exact SQL UTF-8 span, so matching actor titles cannot replace it.
GachaUIStatic.plainText = function(center=false) {
	const n=AutoCombatUI.nativeHelpers,a=n.asm();
	const iat=(v)=>{a.emit(0xFF,0x15);a.dword(v);};
	a.emit(0x55,0x8B,0xEC,0x81,0xEC);a.dword(320);a.emit(0x53,0x56,0x57,0x8B,0x75,8,0x8B,0x7D,12,0x33,0xDB);
	a.label("length");a.emit(0x83,0xFB,127);a.jcc(0x83,"convert");a.emit(0x80,0x3C,0x1F,0);a.jcc(0x84,"convert");a.emit(0x43);a.jmp("length");
	a.label("convert");a.emit(0x85,0xDB);a.jcc(0x84,"done");
	n.pushImm(a,128);a.emit(0x8D,0x85);a.dword(-320);a.emit(0x50,0x53,0x57);n.pushImm(a,0);n.pushImm(a,65001);iat(0xFC1200);
	a.emit(0x8B,0xD8,0x85,0xDB);a.jcc(0x84,"done");
	a.emit(0xFF,0x76,0x24,0x8D,0x4D,0xE0);a.call(0x5443C0);
	a.emit(0x83,0x7D,0xE0,0);a.jcc(0x84,"destroy");
	for(const v of [0,0,12,0])n.pushImm(a,v);a.emit(0x8D,0x4D,0xE0);a.call(0x546F60);
	a.emit(0x0F,0xB6,0x45,0xFE,0x50,0x0F,0xB6,0x45,0xFD,0x50,0x6A,0,0xFF,0x75,0xF0,0xFF,0x75,0xEC,0xB9);a.dword(0x124F3CC);a.call(0x546270);
	a.emit(0x50,0xFF,0x75,0xE0);iat(0xFC1120);
	a.emit(0xFF,0x75,28,0xFF,0x75,0xE0);iat(0xFC10E0);a.emit(0x89,0x45,0xD4);
	a.label("measure");a.emit(0x8D,0x45,0xD8,0x50,0x53,0x8D,0x85);a.dword(-320);a.emit(0x50,0xFF,0x75,0xE0);iat(0xFC112C);
	a.emit(0x85,0xC0);a.jcc(0x84,"restore");a.emit(0x8B,0x45,0xD8,0x3B,0x45,24);a.jcc(0x86,"draw");
	a.emit(0x4B);a.jcc(0x84,"restore");a.jmp("measure");
	a.label("draw");
	// Center the measured, fitted UTF-16 span, not an estimated byte length.
	if(center) a.emit(0x8B,0x55,24,0x2B,0x55,0xD8,0xD1,0xEA,0x03,0x55,16,0x89,0x55,16);
	a.emit(0x53,0x8D,0x85);a.dword(-320);a.emit(0x50,0xFF,0x75,20,0xFF,0x75,16,0xFF,0x75,0xE0);iat(0xFC10DC);
	a.label("restore");a.emit(0xFF,0x75,0xD4,0xFF,0x75,0xE0);iat(0xFC10E0);
	a.label("destroy");a.emit(0x8D,0x4D,0xE0);a.call(0x5446F0);
	a.label("done");a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,24,0);return a;
};
GachaUIStatic.gate = function(a,s,c,fail,paint=false) {
	const g=GachaUIStatic;
	if(c.close) return;
	if(c.admin) { a.emit(0xF6,0x05); a.dword(s+g.Snapshot+24); a.emit(g.Administrator); a.jcc(0x84,fail); }
	// Pending input stays locked without flashing every button to disabled gray.
	if(!paint) { a.emit(0x83,0x3D); a.dword(s+g.Pending); a.emit(0); a.jcc(0x85,fail); }
	a.emit(0x83,0x3D); a.dword(s+g.Rolling); a.emit(0); a.jcc(0x85,fail);
	a.emit(0x83,0x3D); a.dword(s+g.Modal); a.emit(0); a.jcc(c.modal?0x84:0x85,fail);
	if(c.modal) { a.emit(0x83,0x3D); a.dword(s+g.Modal); a.emit(c.modal); a.jcc(0x85,fail); }
	if(c.reset || c.id===22 || c.id===23) { a.emit(0x83,0x3D); a.dword(s+g.Snapshot+56); a.emit(5); a.jcc(0x85,fail); }
	if(!c.modal) { a.emit(0x83,0x3D); a.dword(s+g.Reveal); a.emit(12); a.jcc(0x82,fail); }
	if(c.page) {
		a.emit(0x83,0x3D); a.dword(s+g.Snapshot+56); a.emit(4); a.jcc(0x87,fail);
		a.emit(0x83,0x3D); a.dword(s+g.Snapshot+56); a.emit(0); a.jcc(0x84,fail);
		a.emit(0xA1); a.dword(s+g.Snapshot+g.Page);
		if(c.page<0) {a.emit(0x83,0xF8,1);a.jcc(0x86,fail);}
		else {
			a.emit(0x3B,0x05);a.dword(s+g.Snapshot+g.Pages);a.jcc(0x83,fail);
			// The server probes the next record; a full page alone proves nothing.
			a.emit(0xF6,0x05);a.dword(s+g.Snapshot+24);a.emit(g.HasNextPage);a.jcc(0x84,fail);
		}
	}
	if(c.count || c.id===21) {
		a.emit(0x83,0x3D); a.dword(s+g.Snapshot+56); a.emit(0); a.jcc(0x85,fail);
		a.emit(0xF6,0x05); a.dword(s+g.Snapshot+24); a.emit(1); a.jcc(0x84,fail);
	}
};
// stdcall(x,y) -> eligible control id. Same partition for paint/input/cursor.
GachaUIStatic.hit = function(s) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x55,0x8B,0xEC,0x53,0x8B,0x5D,8,0x8B,0x55,12);
	for(const c of g.controls) {
		const next="hit_"+c.id; g.gate(a,s,c,next);
		n.emitRectGate(a,c.x,c.y,c.x+c.w,c.y+c.h,next);
		a.emit(0xB8); a.dword(c.id); a.jmp("done"); a.label(next);
	}
	a.emit(0x33,0xC0); a.label("done"); a.emit(0x5B,0x5D,0xC2,8,0); return a;
};
// thiscall(x,y) -> address of a visible, revealed icon's snapshot ItemId.
// The address identifies the slot too, so releasing over another copy of the
// same item cannot open the wrong card. No hidden result IDs are read here.
GachaUIStatic.itemHit = function(s) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x55,0x8B,0xEC,0x53,0x8B,0x5D,8,0x8B,0x55,12);
	a.emit(0x80,0x79,n.WindowVisibleOffset,0); a.jcc(0x84,"none");
	for(const off of [g.Hidden,g.Pending,g.Modal,g.Dragging,g.Pressed]) {
		a.emit(0x83,0x3D); a.dword(s+off); a.emit(0); a.jcc(0x85,"none");
	}
	// Native +0x19C capture is a LEFT-button/drag route. Its poll does not
	// dispatch right-up, and dereferences capture again after left-down.
	// Never inspect or change capture while any window owns that route.
	a.emit(0x83,0x3D); a.dword(n.WindowManager+0x19C); a.emit(0); a.jcc(0x85,"none");
	const slots=[];
	for(let i=0;i<g.FeaturedOffsets.length;i++) slots.push({off:g.FeaturedOffsets[i],x:22+i*35,y:88,w:31,h:30});
	for(let i=0;i<12;i++) slots.push({off:672+i*96,x:25+(i%4)*185,y:140+Math.floor(i/4)*76,w:33,h:33,row:i});
	for(const c of slots) {
		const next="item_"+c.off;
		n.emitRectGate(a,c.x,c.y,c.x+c.w,c.y+c.h,next);
		if(c.row!==undefined) {
			for(const off of [g.Snapshot+52,g.Reveal]) { a.emit(0x83,0x3D); a.dword(s+off); a.emit(c.row); a.jcc(0x86,"none"); }
		}
		a.emit(0xB8); a.dword(s+g.Snapshot+c.off); a.emit(0x83,0x38,0); a.jcc(0x85,"done"); a.jmp("none"); a.label(next);
	}
	a.label("none"); a.emit(0x33,0xC0); a.label("done"); a.emit(0x5B,0x5D,0xC2,8,0); return a;
};
GachaUIStatic.itemRight = function(s,hit,resolver,release) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x55,0x8B,0xEC,0x81,0xEC); a.dword(0xF8); a.emit(0x53,0x56,0x57,0x8B,0xF1);
	if(release) {
		a.emit(0x8B,0x1D); a.dword(s+g.RightPressed); a.emit(0x85,0xDB); a.jcc(0x84,"done");
		g.store(a,s+g.RightPressed,0);
	} else {
		// Do not steal an active left-button drag or button press.
		for(const off of [g.Pressed,g.Dragging]) { a.emit(0x83,0x3D); a.dword(s+off); a.emit(0); a.jcc(0x85,"done"); }
		g.store(a,s+g.RightPressed,0);
	}
	a.emit(0xFF,0x75,12,0xFF,0x75,8,0x8B,0xCE); a.call(hit); a.emit(0x85,0xC0); a.jcc(0x84,"done");
	if(!release) {
		a.emit(0xA3); a.dword(s+g.RightPressed);
	} else {
		a.emit(0x3B,0xC3); a.jcc(0x85,"done"); a.emit(0x8B,0x38,0x57); a.call(resolver); a.emit(0x85,0xC0); a.jcc(0x84,"done");
		// Same synchronous CItem -> window 12/message 24 path as mesitemicon.
		// Only the local CItem is temporary; the native item-description owns its UI.
		a.emit(0x8D,0x9D); a.dword(-0xF8); a.emit(0x8B,0xCB); a.call(0x006A1B20);
		a.emit(0x57); n.pushImm(a,n.allocateString("%u").vir); a.emit(0x8D,0x43,0x2C,0x50);
		a.call(n.StringFormat); a.emit(0x83,0xC4,12,0x89,0x43,0x3C,0xC6,0x43,0x5C,1);
		n.pushImm(a,12); a.emit(0xB9); a.dword(n.WindowManager); a.call(0x00A39340);
		a.emit(0x85,0xC0); a.jcc(0x84,"destroy_item");
		a.emit(0x8B,0x10); for(const v of [0,0,0]) n.pushImm(a,v);
		a.emit(0x53); n.pushImm(a,24); n.pushImm(a,0); a.emit(0x8B,0xC8,0xFF,0x92); a.dword(0x94);
		a.label("destroy_item"); a.emit(0x8B,0xCB); a.call(0x005A4300);
	}
	a.label("done"); a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,8,0); return a;
};
// stdcall(action,count,view), using the normal client packet serializer.
GachaUIStatic.sender = function(s,refs) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x55,0x8B,0xEC,0x83,0xEC,32,0x53,0x56,0x57,0xFC,0x8D,0x7D,0xE0,0x33,0xC0,0xB9); a.dword(8); a.emit(0xF3,0xAB);
	a.emit(0xC7,0x45,0xE0); a.dword(0x00200BF8);
	a.emit(0xC7,0x45,0xE4); a.dword(g.Magic);
	a.emit(0x66,0xC7,0x45,0xE8,g.WireVersion,0,0x8B,0x45,8,0x66,0x89,0x45,0xEA);
	a.emit(0xFF,0x05); a.dword(s+g.Sequence); a.emit(0xA1); a.dword(s+g.Sequence); a.emit(0x89,0x45,0xEC);
	for(const [off,local] of [[16,0xF0],[20,0xF4]]) {
		a.emit(0xA1); a.dword(s+g.Snapshot+off); a.emit(0x89,0x45,local);
	}
	a.emit(0x8B,0x45,12,0x89,0x45,0xF8,0x8B,0x45,16,0x89,0x45,0xFC);
	g.store(a,s+g.Pending,1); a.emit(0xFF,0x15); a.dword(n.TimeGetTimeIat); a.emit(0xA3); a.dword(s+g.PendingTick);
	a.call(refs.packetCtorA); a.emit(0x85,0xC0); a.jcc(0x84,"failed");
	a.emit(0x8B,0xF0,0x8D,0x45,0xE0,0x50,0x6A,32,0x8B,0xCE); a.call(refs.packetSend); a.jmp("done");
	a.label("failed"); g.store(a,s+g.Pending,0);
	a.label("done"); a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,12,0); return a;
};
GachaUIStatic.release = function(a,s,label) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic;
	g.store(a,s+g.RightPressed,0);
	a.emit(0x83,0x3D); a.dword(s+g.Dragging); a.emit(0); a.jcc(0x84,label+"_capture");
	g.store(a,s+g.Dragging,0); a.emit(0x6A,0,0x6A,0,0x8B,0xCE); a.call(n.FrameMouseUp);
	a.label(label+"_capture"); a.emit(0xB9); a.dword(n.WindowManager); a.call(n.WindowCaptureGet);
	a.emit(0x3B,0xC6); a.jcc(0x85,label+"_done"); a.emit(0xB9); a.dword(n.WindowManager); a.call(n.WindowCaptureRelease);
	a.label(label+"_done");
};
GachaUIStatic.timer = function(s,sender) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x9C,0x60,0x8B,0x35); a.dword(s+g.Window); a.emit(0x85,0xF6); a.jcc(0x84,"done");
	a.emit(0x80,0x7E,n.WindowVisibleOffset,0); a.jcc(0x84,"done");
	// Cancel a right press released outside this window; no native capture is
	// taken for inspection, so that outside right-up belongs to another window.
	a.emit(0x83,0x3D); a.dword(0x11E40E8); a.emit(0); a.jcc(0x85,"right_held");
	g.store(a,s+g.RightPressed,0); a.label("right_held");
	a.emit(0xFF,0x15); a.dword(n.TimeGetTimeIat); a.emit(0x8B,0xD8);
	a.emit(0x83,0x3D); a.dword(s+g.Rolling); a.emit(0); a.jcc(0x84,"pending");
	a.emit(0x2B,0x05); a.dword(s+g.RevealTick); a.emit(0x8B,0xF8);
	a.emit(0x33,0xD2,0xB9); a.dword(100); a.emit(0xF7,0xF1);
	a.emit(0xA3); a.dword(s+g.Spin); n.emitMarkDirty(a);
	// Remaining slots keep spinning while this slot's authoritative reply is
	// pending. Revealed slots no longer read Spin or cosmetic item IDs.
	a.emit(0x83,0x3D); a.dword(s+g.Rolling); a.emit(1); a.jcc(0x85,"pending");
	a.emit(0x3B,0x3D); a.dword(s+g.Snapshot+668); a.jcc(0x82,"pending");
	a.label("finish_roll"); g.store(a,s+g.Rolling,2);
	// Request only the exact next slot, never a reward ID or price. The server
	// enforces the deadline and this index, preventing replay/skip-ahead pulls.
	n.pushImm(a,0); a.emit(0xA1); a.dword(s+g.Snapshot+24); a.emit(0xC1,0xE8,16,0x40,0x50); n.pushImm(a,6);
	a.call(sender); n.emitMarkDirty(a); a.jmp("done");
	a.label("pending"); a.emit(0x83,0x3D); a.dword(s+g.Pending); a.emit(0); a.jcc(0x84,"done");
	a.emit(0x2B,0x1D); a.dword(s+g.PendingTick); a.emit(0x81,0xFB); a.dword(5000); a.jcc(0x82,"done");
	// Never automatically retry a purchase. A new request must use server state.
	g.store(a,s+g.Pending,0); g.store(a,s+g.Modal,0);
	// An uncertain completion is never retried automatically. Close/reopen to
	// recover; keep pull input locked instead of creating a second purchase.
	n.emitMarkDirty(a);
	a.label("done"); a.emit(0x61,0x9D,0xC2,16,0); return a;
};
GachaUIStatic.stop = function(s) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm(); a.emit(0x9C,0x60,0xA1); a.dword(s+g.Timer);
	a.emit(0x85,0xC0); a.jcc(0x84,"done"); a.emit(0x50,0x6A,0,0xFF,0x15); a.dword(s+g.KillTimer);
