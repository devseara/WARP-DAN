	text("This machine's history, Top Spenders and Legendary Winners for all players",34,201);
	text("Every character's pity for THIS machine, including offline characters",34,221);
	text("Recovery copies are kept. Awarded items and spent Zeny are not refunded.",34,253,0x00808080,0,11);
