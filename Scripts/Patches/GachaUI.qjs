	for(const [off,value] of [[n.TextureWidthOffset,13],[n.TextureHeightOffset,13],[n.TexturePixelsOffset,temp+0x130]])GachaUIStatic.store(a,temp+off,value);
	a.emit(0x8B,0x75,12,0x8B,0xB6);a.dword(n.TexturePixelsOffset);a.emit(0x81,0xC6);a.dword((2*161+5)*4);
	a.emit(0xBF);a.dword(temp+0x130);
	for(let row=0;row<13;row++){a.emit(0xB9);a.dword(13);a.emit(0xF3,0xA5,0x81,0xC6);a.dword((161-13)*4);}
	a.emit(0xBE);a.dword(temp);a.jmp("draw");a.label("standalone");
	for(const dim of [n.TextureWidthOffset,n.TextureHeightOffset]){a.emit(0x8B,0x86);a.dword(dim);a.emit(0x48,0x83,0xF8,25);a.jcc(0x87,"done");}
	a.label("draw");a.emit(0x6A,0,0x56,0xFF,0x75,20,0xFF,0x75,16,0x8B,0x4D,8);a.call(png);
	a.label("done");a.emit(0x5F,0x5E,0x5B,0x5D,0xC2,16,0);return a;
};
