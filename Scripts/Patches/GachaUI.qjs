GachaUIStatic.mouse = function(s,hit,sender,stop,release) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x55,0x8B,0xEC,0x53,0x56,0x57,0x8B,0xF1,0xFF,0x75,12,0xFF,0x75,8); a.call(hit); a.emit(0x8B,0xD8);
	if(release) {
		a.emit(0x8B,0x3D); a.dword(s+g.Pressed); g.store(a,s+g.Pressed,0); g.release(a,s,"release");
		a.emit(0x85,0xDB); a.jcc(0x84,"done"); a.emit(0x3B,0xDF); a.jcc(0x85,"done");
		for(const c of g.controls) {
			const next="action"+c.id; a.emit(0x83,0xFB,c.id); a.jcc(0x85,next);
			const action=c.action??(c.close?4:c.id===20?5:c.id===21?2:c.count?1:3);
			if(c.page) {
				a.emit(0xFF,0x35);a.dword(s+g.Snapshot+56);
				a.emit(0xA1);a.dword(s+g.Snapshot+g.Page);a.emit(c.page<0?0x48:0x40,0x50);
			} else {n.pushImm(a,c.view||0);n.pushImm(a,c.count||0);}
			n.pushImm(a,action); a.call(sender);
			// Keep the confirmation surface until its response arrives. Removing it
			// here briefly exposed stale results + a waiting label behind the modal.
			if(c.close) { a.emit(0xC7,0x46,n.WindowVisibleOffset); a.dword(0); g.store(a,s+g.Hidden,1); g.store(a,s+g.Modal,0); a.call(stop); }
			a.jmp("done"); a.label(next);
		}
	} else {
		g.release(a,s,"down"); g.store(a,s+g.Pressed,0);
		a.emit(0x85,0xDB); a.jcc(0x84,"drag"); a.emit(0x89,0x1D); a.dword(s+g.Pressed);
		a.emit(0x56,0xB9); a.dword(n.WindowManager); a.call(n.WindowCaptureSet); a.jmp("done");
		a.label("drag"); a.emit(0x83,0x7D,12,18); a.jcc(0x83,"done");
		g.store(a,s+g.Dragging,1); a.emit(0xFF,0x75,12,0xFF,0x75,8,0x8B,0xCE); a.call(n.FrameMouseDown);
	}
	a.label("done"); n.emitMarkDirty(a); a.emit(0x5F,0x5E,0x5B,0x8B,0xE5,0x5D,0xC2,8,0); return a;
};
GachaUIStatic.move = function(s,hit,itemHit,cursor=false) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x55,0x8B,0xEC,0x56,0x8B,0xF1);
	if(cursor) { a.emit(0xFF,0x75,12,0xFF,0x75,8,0x8B,0xCE); a.call(0xA23470); }
	a.emit(0xFF,0x75,12,0xFF,0x75,8); a.call(hit);
	a.emit(0x85,0xC0); a.jcc(0x85,"hover_ready");
	a.emit(0xFF,0x75,12,0xFF,0x75,8,0x8B,0xCE); a.call(itemHit); a.label("hover_ready");
	a.emit(0x83,0x3D); a.dword(s+g.RightPressed); a.emit(0); a.jcc(0x84,"right_valid");
	a.emit(0x3B,0x05); a.dword(s+g.RightPressed); a.jcc(0x84,"right_valid");
	g.store(a,s+g.RightPressed,0); a.label("right_valid");
	a.emit(0x3B,0x05); a.dword(s+g.Hover); a.jcc(0x84,"same"); a.emit(0xA3); a.dword(s+g.Hover); n.emitMarkDirty(a); a.label("same");
	if(cursor) {
