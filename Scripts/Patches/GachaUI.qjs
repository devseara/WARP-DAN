GachaUIStatic.destroy = function(s,stop) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x56,0x8B,0xF1); g.release(a,s,"destroy"); a.call(stop); g.store(a,s+g.Window,0); g.store(a,s+g.Hidden,1);
