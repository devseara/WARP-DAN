GachaUIStatic.finalize = function() {
	const a=AutoCombatUI.nativeHelpers.asm();
	// GDI TextDraw leaves zero alpha in its colored foreground pixels.
	// Preserve untouched transparent corners, normalize painted pixels only.
	a.emit(0x53,0x56,0x8B,0x71,0x24,0x85,0xF6); a.jcc(0x84,"done");
	a.emit(0x8B,0x4E,4,0x0F,0xAF,0x4E,8,0x8B,0x76,0x18,0x85,0xC9); a.jcc(0x84,"done");
