};
GachaUIStatic.drag = function(s,move) {
	const n=AutoCombatUI.nativeHelpers,g=GachaUIStatic,a=n.asm();
	a.emit(0x83,0x3D); a.dword(s+g.Dragging); a.emit(1); a.jcc(0x85,"hover"); a.jmp(0x880E00);
