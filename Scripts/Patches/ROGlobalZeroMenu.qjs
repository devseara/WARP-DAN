MenuZeroStatic.hexNorm = function(hex)
{
	return (hex || "").replace(/\s+/g, " ").trim().toUpperCase();
};

MenuZeroStatic.bytesToHex = function(bytes)
{
	return bytes.map(value => (value & 0xFF).toString(16).padStart(2, "0")).join(" ");
};

MenuZeroStatic.hexToBytes = function(hex)
{
	return MenuZeroStatic.hexNorm(hex).split(" ").map(value => parseInt(value, 16));
};

MenuZeroStatic.asciiBytes = function(text, nulTerminate = true)
{
	const bytes = [];
	for (let i = 0; i < text.length; i++)
		bytes.push(text.charCodeAt(i) & 0xFF);
	if (nulTerminate)
		bytes.push(0);
	return bytes;
};

MenuZeroStatic.findBytes = function(bytes, needle)
{
	for (let i = 0; i <= bytes.length - needle.length; i++)
	{
		let match = true;
		for (let j = 0; j < needle.length; j++)
		{
			if (bytes[i + j] !== needle[j])
			{
				match = false;
				break;
			}
		}
		if (match)
			return i;
	}
	return -1;
};

MenuZeroStatic.readCString = function(virAddr, maxLength)
{
	const phyAddr = Exe.Vir2Phy(virAddr);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroMenu: string 0x${virAddr.toString(16)} is not mapped`);

	const bytes = [];
	for (let i = 0; i < maxLength; i++)
	{
		const value = Exe.GetUint8(phyAddr + i);
		bytes.push(value);
		if (value === 0)
			return bytes;
	}
	throw Error(`ROGlobalZeroMenu: unterminated string at 0x${virAddr.toString(16)}`);
};

MenuZeroStatic.allocateBytes = function(bytes, alignment = 1)
{
	const [phyAddr, virAddr] = Exe.Allocate(bytes.length, alignment);
	Exe.SetHex(phyAddr, MenuZeroStatic.bytesToHex(bytes));
	return {phy: phyAddr, vir: virAddr, bytes};
};

MenuZeroStatic.allocateCode = function(assembly)
{
	const [phy, vir] = Exe.Allocate(assembly.bytes.length, 0x10);
	Exe.SetHex(phy, assembly.finish(vir));
	return {phy, vir, size: assembly.bytes.length};
};

MenuZeroStatic.resourcePrefix = function()
{
	const source = MenuZeroStatic.readCString(MenuZeroStatic.TabItmFormat, 192);
	const needle = MenuZeroStatic.asciiBytes("basic_interface\\", false);
	const position = MenuZeroStatic.findBytes(source, needle);
	if (position < 0)
		throw Error("ROGlobalZeroMenu: texture directory prefix not found");
	return source.slice(0, position);
};

MenuZeroStatic.buildResourceBytes = function(prefix, relativePath, nulTerminate = true)
{
	return prefix.concat(MenuZeroStatic.asciiBytes(relativePath, nulTerminate));
};

MenuZeroStatic.asm = function()
{
	const bytes = [];
	const labels = {};
	const fixups = [];

	const put32 = function(out, pos, value)
	{
		const v = value >>> 0;
		out[pos] = v & 0xFF;
		out[pos + 1] = (v >>> 8) & 0xFF;
		out[pos + 2] = (v >>> 16) & 0xFF;
		out[pos + 3] = (v >>> 24) & 0xFF;
	};

	return {
		bytes,
		emit: function(...values)
		{
			for (const value of values)
				bytes.push(value & 0xFF);
		},
		dword: function(value)
		{
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			put32(bytes, pos, value);
		},
		label: function(name)
		{
			if (Object.prototype.hasOwnProperty.call(labels, name))
				throw Error(`ROGlobalZeroMenu: duplicate label ${name}`);
			labels[name] = bytes.length;
		},
		rel32: function(opcode, target)
		{
			bytes.push(opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		call: function(target) { this.rel32(0xE8, target); },
		jmp: function(target) { this.rel32(0xE9, target); },
		jcc: function(opcode, target)
		{
			bytes.push(0x0F, opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		finish: function(baseVir)
		{
			const out = bytes.slice();
			for (const fixup of fixups)
			{
				if (typeof fixup.target === "string" &&
					!Object.prototype.hasOwnProperty.call(labels, fixup.target))
					throw Error(`ROGlobalZeroMenu: unresolved label ${fixup.target}`);
				const targetVir = typeof fixup.target === "string"
					? baseVir + labels[fixup.target]
					: fixup.target;
				const nextVir = baseVir + fixup.pos + 4;
				put32(out, fixup.pos, targetVir - nextVir);
			}
			return MenuZeroStatic.bytesToHex(out);
		}
	};
};

MenuZeroStatic.pushImmediate = function(a, value)
{
	if (value >= -128 && value <= 127)
		a.emit(0x6A, value);
	else
	{
		a.emit(0x68);
		a.dword(value);
	}
};

MenuZeroStatic.buildPreservedThemeLoad = function(themeLoadVir)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x9C, 0x60);                              // PUSHFD / PUSHAD
	a.call(themeLoadVir);
	a.emit(0x61, 0x9D, 0xC3);                        // POPAD / POPFD / RET
	return a;
};

MenuZeroStatic.buildButtonDestructor = function(buttonStateVir)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x3B, 0x0D); a.dword(buttonStateVir);         // CMP ECX,[button]
	a.jcc(0x85, "native");
	a.emit(0xC7, 0x05); a.dword(buttonStateVir); a.dword(0);
	a.emit(0xC7, 0x05); a.dword(buttonStateVir + 4); a.dword(0);
	a.label("native");
	a.jmp(MenuZeroStatic.ButtonDeletingDestructor);
	return a;
};

MenuZeroStatic.buildButtonHover = function(textVir)
{
	const s = MenuZeroStatic;
	const a = s.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x08);
	a.emit(0x56, 0x8B, 0xF1);
	a.emit(0x83, 0x7E, 0x28, 0x00);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x45, 0x08, 0x85, 0xC0);
	a.jcc(0x88, "done");
	a.emit(0x3B, 0x46, 0x14);
	a.jcc(0x8D, "done");
	a.emit(0x8B, 0x45, 0x0C, 0x85, 0xC0);
	a.jcc(0x88, "done");
	a.emit(0x3B, 0x46, 0x18);
	a.jcc(0x8D, "done");
	a.emit(0x8B, 0x45, 0x08);
	a.emit(0x83, 0xC0, s.TooltipXOffset);
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0x8B, 0x45, 0x0C);
	a.emit(0x83, 0xC0, s.TooltipYOffset);
	a.emit(0x89, 0x45, 0xFC);
	a.emit(0x8D, 0x45, 0xFC, 0x50);
	a.emit(0x8D, 0x45, 0xF8, 0x50);
	a.emit(0x8B, 0xCE);
	a.call(s.ClientToScreen);
	a.emit(0x8B, 0x0D); a.dword(s.TooltipManager);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "done");
	s.pushImmediate(a, 1);
	s.pushImmediate(a, 0);
	s.pushImmediate(a, -1);
	a.emit(0xFF, 0x75, 0xFC);
	a.emit(0xFF, 0x75, 0xF8);
	s.pushImmediate(a, textVir);
	a.call(s.ShowTooltip);
	a.label("done");
	a.emit(0x5E, 0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00);
	return a;
};
MenuZeroStatic.buildButtonMouseUp = function(requestVir)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x56);                    // frame / PUSH ESI
	a.emit(0x8B, 0xF1);                                // MOV ESI,ECX
	a.emit(0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08);       // PUSH y / PUSH x
	a.emit(0x8B, 0xCE);                                // MOV ECX,ESI
	a.call(MenuZeroStatic.ButtonMouseUp);               // restore stock button state
	a.emit(0x50);                                      // preserve stock return
	a.call(requestVir);                                // defer open/close to next UI tick
	a.emit(0x58, 0x5E, 0x8B, 0xE5, 0x5D);
	a.emit(0xC2, 0x08, 0x00);                          // RET 8
	return a;
};

MenuZeroStatic.cloneButtonVtable = function(mouseUpVir, hoverVir, destructorVir)
{
	const sourcePhy = Exe.Vir2Phy(MenuZeroStatic.ButtonVtable);
	if (sourcePhy < 0)
		throw Error("ROGlobalZeroMenu: UIButton vtable is not mapped");
	const bytes = [];
	for (let index = 0; index < MenuZeroStatic.ButtonVtableEntries; index++)
	{
		let value = Exe.GetUint32(sourcePhy + index * 4);
		if (index === 0)
			value = destructorVir;
		else if (index === 28)
			value = hoverVir;
		else if (index === 31)
			value = mouseUpVir;
		for (let shift = 0; shift < 32; shift += 8)
			bytes.push((value >>> shift) & 0xFF);
	}
	return MenuZeroStatic.allocateBytes(bytes, 4);
};

MenuZeroStatic.buildEnsureAutoHuntButtons = function(
	buttonStateVir, buttonVtableVir, imagePaths, themeStateVir
)
{
	const s = MenuZeroStatic;
	const a = s.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.emit(0x8B, 0xF1);                                // ESI=menu parent
	a.emit(0x83, 0x3D); a.dword(buttonStateVir); a.emit(0x00);
	a.jcc(0x84, "create");
	a.emit(0x39, 0x35); a.dword(buttonStateVir + 4);     // current owner == ESI?
	a.jcc(0x84, "done");
	a.label("create");
	s.pushImmediate(a, 0x120);
	a.call(s.OperatorNew);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0xF8, 0x8B, 0xCF);
	a.call(s.ButtonConstructor);
	a.emit(0xC7, 0x07); a.dword(buttonVtableVir);
	const emitImages = function(paths)
	{
		for (let state = 0; state < 3; state++)
		{
			s.pushImmediate(a, 0);
			s.pushImmediate(a, state);
			s.pushImmediate(a, paths[state]);
			a.emit(0x8B, 0xCF);
			a.call(s.ButtonSetImage);
		}
	};
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "classic_images");
	emitImages(imagePaths.renewal);
	a.jmp("images_ready");
	a.label("classic_images");
	emitImages(imagePaths.classic);
	a.label("images_ready");
	a.emit(0xFF, 0xB7); a.dword(0xB8);
	a.emit(0xFF, 0xB7); a.dword(0xB4);
	a.emit(0x8B, 0xCF);
	a.call(s.WindowSetImageSize);
	a.emit(0xC7, 0x47, 0x2C); a.dword(s.AutoHuntWindowId);
	a.emit(0x57, 0x8B, 0xCE);
	a.call(s.WindowAddChild);
	a.emit(0x89, 0x3D); a.dword(buttonStateVir);
	a.emit(0x89, 0x35); a.dword(buttonStateVir + 4);
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};
MenuZeroStatic.buildSyncAutoHuntButtons = function(
	buttonStateVir, visibleMaskVir, visibleVir, themeStateVir
)
{
	const s = MenuZeroStatic;
	const a = s.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.emit(0x8B, 0xF1);                                // ESI=menu
	a.emit(0x8B, 0x3D); a.dword(buttonStateVir);
	a.emit(0x85, 0xFF);
	a.jcc(0x84, "done");
	a.emit(0xC6, 0x47, 0x28, 0x00);                    // visible=false
	a.emit(0x83, 0x3D); a.dword(visibleVir); a.emit(0x00);
	a.jcc(0x84, "done");
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "selected");                         // Classic parent owns visibility
	a.emit(0x80, 0x3D); a.dword(s.MenuExpandedFlag); a.emit(0x00);
	a.jcc(0x84, "done");                             // New UI zero = collapsed
	a.label("selected");
	a.emit(0xC6, 0x47, 0x28, 0x01);                    // visible=true
	a.emit(0xC7, 0x47, 0x58); a.dword(1);              // dirty=true
	a.emit(0xA1); a.dword(visibleMaskVir);
	a.emit(0x33, 0xD2);                                // EDX=native visible count
	a.label("count");
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "count_done");
	a.emit(0x8D, 0x48, 0xFF, 0x23, 0xC1, 0x42);
	a.jmp("count");
	a.label("count_done");
	a.emit(0x8B, 0xC2, 0x33, 0xD2);
	a.emit(0xB9); a.dword(s.GridColumns);
	a.emit(0xF7, 0xF1);                                // EAX=row, EDX=column
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "classic_position");
	a.emit(0x6B, 0xD2, s.GridStrideX);
	a.emit(0x83, 0xC2, s.GridX);
	a.emit(0x6B, 0xC0, s.GridStrideY);
	a.emit(0x83, 0xC0, s.GridY);
	a.jmp("set_position");
	a.label("classic_position");
	a.emit(0x6B, 0xD2, s.OldGridStrideX);
	a.emit(0x83, 0xC2, s.OldGridX);
	a.emit(0x6B, 0xC0, s.OldGridStrideY);
	a.emit(0x83, 0xC0, s.OldGridY);
	a.label("set_position");
	a.emit(0x50, 0x52);
	a.emit(0x8B, 0x17, 0x8B, 0xCF);
	a.emit(0xFF, 0x52, 0x10);
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};
MenuZeroStatic.buildDrawWrapper = function(syncAutoHuntVir)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x51);                                      // preserve menu ECX
	a.call(syncAutoHuntVir);
	a.emit(0x59);                                      // restore menu ECX
	a.jmp(MenuZeroStatic.DrawOriginal);
	return a;
};

MenuZeroStatic.buildBackgroundCopy = function(
	backgrounds, rowCountVir, themeStateVir, loadThemeVir
)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x9C, 0x60);
	a.call(loadThemeVir);
	a.emit(0x61, 0x9D);
	// At BackgroundCopyBlock, EDI is a stack-local std::string, not the menu.
	// Row measurement must remain in hooks whose native receiver is UIMenuIconWnd.
	a.emit(0x50, 0x56);                                // preserve dest EAX / ESI
	a.emit(0xA1); a.dword(rowCountVir);
	a.emit(0x85, 0xC0);
	a.jcc(0x85, "row_min_ready");
	a.emit(0x40);
	a.label("row_min_ready");
	a.emit(0x83, 0xF8, backgrounds.renewal.length);
	a.jcc(0x86, "row_max_ready");                     // JBE
	a.emit(0xB8); a.dword(backgrounds.renewal.length);
	a.label("row_max_ready");
	a.emit(0x48);                                      // zero-based row
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "classic");
	for (let index = 0; index < backgrounds.renewal.length; index++)
	{
		a.emit(0x83, 0xF8, index);
		a.jcc(0x84, "renewal_" + index);
	}
	a.jmp("renewal_0");
	for (let index = 0; index < backgrounds.renewal.length; index++)
	{
		a.label("renewal_" + index);
		a.emit(0xBE); a.dword(backgrounds.renewal[index]);
		a.jmp("selected");
	}
	a.label("classic");
	for (let index = 0; index < backgrounds.classic.length; index++)
	{
		a.emit(0x83, 0xF8, index);
		a.jcc(0x84, "classic_" + index);
	}
	a.jmp("classic_0");
	for (let index = 0; index < backgrounds.classic.length; index++)
	{
		a.label("classic_" + index);
		a.emit(0xBE); a.dword(backgrounds.classic[index]);
		a.jmp("selected");
	}
	a.label("selected");
	a.emit(0x8B, 0x54, 0x24, 0x04);                   // EDX=saved destination
	a.emit(0xC7, 0x47, 0x10); a.dword(backgrounds.pathLength);
	a.emit(0xC7, 0x47, 0x14); a.dword(MenuZeroStatic.BackgroundBufferSize - 1);
	a.emit(0x0F, 0x10, 0x06);
	a.emit(0x0F, 0x11, 0x02);
	a.emit(0x0F, 0x10, 0x46, 0x10);
	a.emit(0x0F, 0x11, 0x42, 0x10);
	a.emit(0x0F, 0x10, 0x46, 0x20);
	a.emit(0x0F, 0x11, 0x42, 0x20);
	a.emit(0x89, 0x17);                                // destination string pointer
	a.emit(0x5E, 0x58);                                // restore ESI / EAX
	a.jmp(MenuZeroStatic.BackgroundCopyReturn);
	return a;
};

// Replace a five-byte PUSH immediate with a five-byte CALL. The helper
// preserves EAX and returns with the selected pointer/value left on the
// caller's stack exactly as the original PUSH would have done.
MenuZeroStatic.buildPushSelector = function(
	classicValue, renewalValue, themeStateVir, loadThemeVir
)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x9C, 0x60);
	a.call(loadThemeVir);
	a.emit(0x61, 0x9D);
	a.emit(0x50);                                      // PUSH EAX
	a.emit(0x8B, 0x44, 0x24, 0x04);                    // MOV EAX,[ESP+4] return
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x85, "renewal");
	a.emit(0xC7, 0x44, 0x24, 0x04); a.dword(classicValue);
	a.jmp("finish");
	a.label("renewal");
	a.emit(0xC7, 0x44, 0x24, 0x04); a.dword(renewalValue);
	a.label("finish");
	a.emit(0x87, 0x04, 0x24, 0xC3);                    // XCHG [ESP],EAX / RET
	return a;
};

MenuZeroStatic.buildBackgroundDraw = function(themeStateVir, loadThemeVir)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x9C, 0x60);
	a.call(loadThemeVir);
	a.emit(0x61, 0x9D);
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x85, "renewal");
	MenuZeroStatic.pushImmediate(a, 13);
	a.jmp("origin_ready");
	a.label("renewal");
	MenuZeroStatic.pushImmediate(a, 0);
	a.label("origin_ready");
	MenuZeroStatic.pushImmediate(a, 0);
	a.emit(0xC7, 0x45, 0xFC); a.dword(-1);
	a.jmp(MenuZeroStatic.BackgroundDrawReturn);
	return a;
};

MenuZeroStatic.buildBackgroundHeight = function(
	measureRowsVir, panelHeightVir, oldPanelHeightVir, themeStateVir, loadThemeVir
)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x9C, 0x60);
	a.call(loadThemeVir);
	a.emit(0x61, 0x9D);
	a.emit(0x8B, 0xCF);                                // MOV ECX,EDI (menu)
	a.call(measureRowsVir);
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "classic");
	a.emit(0xFF, 0x35); a.dword(panelHeightVir);        // renewal full image
	a.jmp("height_ready");
	a.label("classic");
	a.emit(0xFF, 0x35); a.dword(oldPanelHeightVir);     // classic full image
	a.label("height_ready");
	a.emit(0x80, 0x3D); a.dword(MenuZeroStatic.MenuExpandedFlag);
	a.emit(0x00);                                      // CMP BYTE [expanded],0
	a.jmp(MenuZeroStatic.BackgroundHeightReturn);
	return a;
};

MenuZeroStatic.buildDescriptorLength = function(themeStateVir, loadThemeVir)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x9C, 0x60);
	a.call(loadThemeVir);
	a.emit(0x61, 0x9D);
	a.emit(0x8D, 0x4D, 0x90);                         // LEA ECX,[EBP-70]
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x85, "renewal");
	MenuZeroStatic.pushImmediate(a, 16);
	a.jmp("length_ready");
	a.label("renewal");
	MenuZeroStatic.pushImmediate(a, 8);
	a.label("length_ready");
	a.emit(0xC7, 0x45, 0x90); a.dword(0);
	a.jmp(MenuZeroStatic.DescriptorLengthReturn);
	return a;
};

MenuZeroStatic.buildAnchor = function()
{
	const a = MenuZeroStatic.asm();
	a.emit(0x56);                                      // PUSH ESI
	a.emit(0x8B, 0xF1);                                // MOV ESI,ECX
	a.emit(0xA1); a.dword(MenuZeroStatic.DisplayPointer);
	a.emit(0x85, 0xC0);                                // TEST EAX,EAX
	a.jcc(0x84, "done");                              // JZ done
	a.emit(0x8B, 0x50, 0x28);                          // MOV EDX,[EAX+28]
	a.emit(0x2B, 0x56, 0x14);                          // SUB EDX,[ESI+14]
	a.emit(0x83, 0xEA, MenuZeroStatic.ScreenMargin);   // SUB EDX,margin
	a.jcc(0x89, "x_valid");                           // JNS x_valid
	a.emit(0x33, 0xD2);                                // XOR EDX,EDX
	a.label("x_valid");
	a.emit(0x89, 0x56, 0x1C);                          // MOV [ESI+1C],EDX
	a.emit(0x8B, 0x40, 0x2C);                          // MOV EAX,[EAX+2C]
	a.emit(0x2B, 0x46, 0x18);                          // SUB EAX,[ESI+18]
	a.emit(0x83, 0xE8, MenuZeroStatic.ScreenMargin);   // SUB EAX,margin
	a.jcc(0x89, "y_valid");                           // JNS y_valid
	a.emit(0x33, 0xC0);                                // XOR EAX,EAX
	a.label("y_valid");
	a.emit(0x89, 0x46, 0x20);                          // MOV [ESI+20],EAX
	a.emit(0x56);                                      // PUSH ESI
	a.emit(0xB9); a.dword(MenuZeroStatic.WindowManager);
	a.call(MenuZeroStatic.WindowManagerUpdate);
	a.label("done");
	a.emit(0x5E, 0xC3);                                // POP ESI / RET
	return a;
};

MenuZeroStatic.buildPositionWrapper = function(
	anchorVir, themeStateVir, syncLaunchersVir
)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "classic");
	a.emit(0x51);                                      // preserve menu ECX
	a.call(anchorVir);
	a.emit(0x59);                                      // restore menu ECX
	a.call(syncLaunchersVir);
	a.emit(0xC2, 0x08, 0x00);
	a.label("classic");
	a.jmp(MenuZeroStatic.PositionOriginal);
	return a;
};

MenuZeroStatic.buildHitTestWrapper = function(themeStateVir)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x55, 0x8B, 0xEC);                          // frame
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "stock");
	a.emit(0x80, 0x3D); a.dword(MenuZeroStatic.MenuExpandedFlag);
	a.emit(0x00);                                      // CMP BYTE [expanded],0
	a.jcc(0x85, "stock");                             // JNE stock
	a.emit(0x56);                                      // PUSH ESI
	a.emit(0x8B, 0xF1);                                // MOV ESI,ECX
	a.emit(0x8B, 0x86); a.dword(0xD0);                 // MOV EAX,[ESI+D0]
	a.emit(0x85, 0xC0);                                // TEST EAX,EAX
	a.jcc(0x84, "miss");                              // JZ miss

	a.emit(0x8B, 0x56, 0x1C);                          // MOV EDX,[ESI+1C]
	a.emit(0x03, 0x50, 0x1C);                          // ADD EDX,[EAX+1C]
	a.emit(0x39, 0x55, 0x08);                          // CMP [EBP+8],EDX
	a.jcc(0x8C, "miss");                              // JL miss
	a.emit(0x03, 0x50, 0x14);                          // ADD EDX,[EAX+14]
	a.emit(0x39, 0x55, 0x08);                          // CMP [EBP+8],EDX
	a.jcc(0x8D, "miss");                              // JGE miss

	a.emit(0x8B, 0x56, 0x20);                          // MOV EDX,[ESI+20]
	a.emit(0x03, 0x50, 0x20);                          // ADD EDX,[EAX+20]
	a.emit(0x39, 0x55, 0x0C);                          // CMP [EBP+C],EDX
	a.jcc(0x8C, "miss");                              // JL miss
	a.emit(0x03, 0x50, 0x18);                          // ADD EDX,[EAX+18]
	a.emit(0x39, 0x55, 0x0C);                          // CMP [EBP+C],EDX
	a.jcc(0x8D, "miss");                              // JGE miss

	a.emit(0x5E);                                      // POP ESI
	a.emit(0x8B, 0x50, 0x1C);                          // MOV EDX,[EAX+1C]
	a.emit(0x29, 0x55, 0x08);                          // SUB [EBP+8],EDX
	a.emit(0x8B, 0x50, 0x20);                          // MOV EDX,[EAX+20]
	a.emit(0x29, 0x55, 0x0C);                          // SUB [EBP+C],EDX
	a.emit(0x8B, 0xE5, 0x5D);                          // restore frame
	a.jmp(MenuZeroStatic.HitTestOriginal);             // stock selection/guards

	a.label("miss");
	a.emit(0x33, 0xC0);                                // XOR EAX,EAX
	a.emit(0x5E);                                      // POP ESI
	a.emit(0x8B, 0xE5, 0x5D);                          // restore frame
	a.emit(0xC2, 0x08, 0x00);                          // RET 8

	a.label("stock");
	a.emit(0x8B, 0xE5, 0x5D);                          // restore frame
	a.jmp(MenuZeroStatic.HitTestOriginal);
	return a;
};

MenuZeroStatic.emitSetChildPosition = function(
	a, offset, x, panelHeightVir, label
)
{
	a.emit(0x8B, 0x8E); a.dword(offset);               // MOV ECX,[ESI+offset]
	a.emit(0x85, 0xC9);                                // TEST ECX,ECX
	a.jcc(0x84, label);                                // JZ label
	a.emit(0x8B, 0x11);                                // MOV EDX,[ECX]
	a.emit(0xA1); a.dword(panelHeightVir);              // MOV EAX,[panel height]
	a.emit(0x83, 0xE8, MenuZeroStatic.ToggleBottomInset);
	a.emit(0x50);                                      // PUSH EAX (dynamic Y)
	MenuZeroStatic.pushImmediate(a, x);
	a.emit(0xFF, 0x52, 0x10);                          // CALL [EDX+10]
	a.label(label);
};

MenuZeroStatic.emitCollectTree = function(a, treeOffset, prefix, maskVir)
{
	const done = `${prefix}_done`;
	const loop = `${prefix}_loop`;
	const advance = `${prefix}_advance`;
	const hasRight = `${prefix}_has_right`;
	const descend = `${prefix}_descend`;
	const climb = `${prefix}_climb`;
	const setNode = `${prefix}_set_node`;

	a.emit(0x8B, 0xBE); a.dword(treeOffset);           // MOV EDI,[ESI+treeOffset]
	a.emit(0x85, 0xFF);                                // TEST EDI,EDI
	a.jcc(0x84, done);                                 // JZ done
	a.emit(0x8B, 0x1F);                                // MOV EBX,[EDI] (leftmost)
	a.label(loop);
	a.emit(0x3B, 0xDF);                                // CMP EBX,EDI
	a.jcc(0x84, done);                                 // JE done
	a.emit(0x8B, 0x43, 0x10);                          // MOV EAX,[EBX+10] (command)
	for (let i = 0; i < MenuZeroStatic.CommandGrid.length; i++)
	{
		const [command] = MenuZeroStatic.CommandGrid[i];
		a.emit(0x3D); a.dword(command);                  // CMP EAX,command
		a.jcc(0x84, `${prefix}_command_${i}`);           // JE command
	}
	a.jmp(advance);

	for (let i = 0; i < MenuZeroStatic.CommandGrid.length; i++)
	{
		const [, index] = MenuZeroStatic.CommandGrid[i];
		a.label(`${prefix}_command_${i}`);
		a.emit(0x8B, 0x4B, 0x14);                        // MOV ECX,[EBX+14] (child)
		a.emit(0x85, 0xC9);                              // TEST ECX,ECX
		a.jcc(0x84, advance);                            // JZ advance
		a.emit(0x81, 0x0D); a.dword(maskVir); a.dword(1 << index);
		a.jmp(advance);
	}

	a.label(advance);
	a.emit(0x8B, 0x43, 0x08);                          // MOV EAX,[EBX+8] (right)
	a.emit(0x80, 0x78, 0x0D, 0x00);                    // CMP BYTE [EAX+0D],0
	a.jcc(0x84, hasRight);                             // JE has_right
	a.emit(0x8B, 0x43, 0x04);                          // MOV EAX,[EBX+4] (parent)
	a.label(climb);
	a.emit(0x80, 0x78, 0x0D, 0x00);                    // CMP BYTE [EAX+0D],0
	a.jcc(0x85, setNode);                              // JNE set_node
	a.emit(0x3B, 0x58, 0x08);                          // CMP EBX,[EAX+8]
	a.jcc(0x85, setNode);                              // JNE set_node
	a.emit(0x8B, 0xD8);                                // MOV EBX,EAX
	a.emit(0x8B, 0x40, 0x04);                          // MOV EAX,[EAX+4]
	a.jmp(climb);
	a.label(setNode);
	a.emit(0x8B, 0xD8);                                // MOV EBX,EAX
	a.jmp(loop);

	a.label(hasRight);
	a.emit(0x8B, 0xD8);                                // MOV EBX,EAX
	a.label(descend);
	a.emit(0x8B, 0x0B);                                // MOV ECX,[EBX] (left)
	a.emit(0x80, 0x79, 0x0D, 0x00);                    // CMP BYTE [ECX+0D],0
	a.jcc(0x85, loop);                                 // JNE loop
	a.emit(0x8B, 0xD9);                                // MOV EBX,ECX
	a.jmp(descend);
	a.label(done);
};

MenuZeroStatic.emitRepositionTree = function(
	a, treeOffset, prefix, maskVir
)
{
	const done = `${prefix}_done`;
	const loop = `${prefix}_loop`;
	const advance = `${prefix}_advance`;
	const hasRight = `${prefix}_has_right`;
	const descend = `${prefix}_descend`;
	const climb = `${prefix}_climb`;
	const setNode = `${prefix}_set_node`;

	a.emit(0x8B, 0xBE); a.dword(treeOffset);           // MOV EDI,[ESI+treeOffset]
	a.emit(0x85, 0xFF);                                // TEST EDI,EDI
	a.jcc(0x84, done);                                 // JZ done
	a.emit(0x8B, 0x1F);                                // MOV EBX,[EDI] (leftmost)
	a.label(loop);
	a.emit(0x3B, 0xDF);                                // CMP EBX,EDI
	a.jcc(0x84, done);                                 // JE done
	a.emit(0x8B, 0x43, 0x10);                          // MOV EAX,[EBX+10] (command)
	for (let i = 0; i < MenuZeroStatic.CommandGrid.length; i++)
	{
		const [command] = MenuZeroStatic.CommandGrid[i];
		a.emit(0x3D); a.dword(command);                  // CMP EAX,command
		a.jcc(0x84, `${prefix}_command_${i}`);           // JE command
	}
	a.jmp(advance);

	for (let i = 0; i < MenuZeroStatic.CommandGrid.length; i++)
	{
		const [, index] = MenuZeroStatic.CommandGrid[i];
		const priorMask = index === 0 ? 0 : (2 ** index) - 1;
		a.label(`${prefix}_command_${i}`);
		a.emit(0x8B, 0x4B, 0x14);                        // MOV ECX,[EBX+14] (child)
		a.emit(0x85, 0xC9);                              // TEST ECX,ECX
		a.jcc(0x84, advance);                            // JZ advance
		if (priorMask === 0)
			a.emit(0x33, 0xC0);                            // XOR EAX,EAX
		else
		{
			a.emit(0xA1); a.dword(maskVir);                // MOV EAX,[visible mask]
			a.emit(0x25); a.dword(priorMask);              // AND EAX,prior mask
		}
		a.emit(0x33, 0xD2);                              // XOR EDX,EDX (count)
		a.label(`${prefix}_count_${i}`);
		a.emit(0x85, 0xC0);                              // TEST EAX,EAX
		a.jcc(0x84, `${prefix}_count_${i}_done`);         // JZ count done
		a.emit(0x8D, 0x48, 0xFF);                        // LEA ECX,[EAX-1]
		a.emit(0x23, 0xC1);                              // AND EAX,ECX
		a.emit(0x42);                                    // INC EDX
		a.jmp(`${prefix}_count_${i}`);
		a.label(`${prefix}_count_${i}_done`);
		a.emit(0x8B, 0xC2);                              // MOV EAX,EDX (compact slot)
		a.emit(0x33, 0xD2);                              // XOR EDX,EDX
		a.emit(0xB9); a.dword(MenuZeroStatic.GridColumns);
		a.emit(0xF7, 0xF1);                              // DIV ECX; EAX=row, EDX=column
		a.emit(0x6B, 0xD2, MenuZeroStatic.GridStrideX);   // IMUL EDX,EDX,stride X
		a.emit(0x83, 0xC2, MenuZeroStatic.GridX);         // ADD EDX,grid X
		a.emit(0x6B, 0xC0, MenuZeroStatic.GridStrideY);   // IMUL EAX,EAX,stride Y
		a.emit(0x83, 0xC0, MenuZeroStatic.GridY);         // ADD EAX,grid Y
		a.emit(0x50, 0x52);                              // PUSH Y / PUSH X
		a.emit(0x8B, 0x4B, 0x14);                        // MOV ECX,[EBX+14] (child)
		a.emit(0x8B, 0x11);                              // MOV EDX,[ECX]
		a.emit(0xFF, 0x52, 0x10);                        // CALL [EDX+10]
		a.jmp(advance);
	}

	a.label(advance);
	a.emit(0x8B, 0x43, 0x08);                          // MOV EAX,[EBX+8] (right)
	a.emit(0x80, 0x78, 0x0D, 0x00);                    // CMP BYTE [EAX+0D],0
	a.jcc(0x84, hasRight);                             // JE has_right
	a.emit(0x8B, 0x43, 0x04);                          // MOV EAX,[EBX+4] (parent)
	a.label(climb);
	a.emit(0x80, 0x78, 0x0D, 0x00);                    // CMP BYTE [EAX+0D],0
	a.jcc(0x85, setNode);                              // JNE set_node
	a.emit(0x3B, 0x58, 0x08);                          // CMP EBX,[EAX+8]
	a.jcc(0x85, setNode);                              // JNE set_node
	a.emit(0x8B, 0xD8);                                // MOV EBX,EAX
	a.emit(0x8B, 0x40, 0x04);                          // MOV EAX,[EAX+4]
	a.jmp(climb);
	a.label(setNode);
	a.emit(0x8B, 0xD8);                                // MOV EBX,EAX
	a.jmp(loop);

	a.label(hasRight);
	a.emit(0x8B, 0xD8);                                // MOV EBX,EAX
	a.label(descend);
	a.emit(0x8B, 0x0B);                                // MOV ECX,[EBX] (left)
	a.emit(0x80, 0x79, 0x0D, 0x00);                    // CMP BYTE [ECX+0D],0
	a.jcc(0x85, loop);                                 // JNE loop
	a.emit(0x8B, 0xD9);                                // MOV EBX,ECX
	a.jmp(descend);
	a.label(done);
};

MenuZeroStatic.buildMeasureRows = function(
	maskVir, panelHeightVir, rowCountVir, oldPanelHeightVir, autoVisibleVir,
	themeStateVir
)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x60);                                      // PUSHAD
	a.emit(0x8B, 0xF1);                                // MOV ESI,ECX (menu)
	a.emit(0xC7, 0x05); a.dword(maskVir); a.dword(0);  // clear visible mask
	MenuZeroStatic.emitCollectTree(a, MenuZeroStatic.TreeOffsets[0], "measure_b4", maskVir);
	MenuZeroStatic.emitCollectTree(a, MenuZeroStatic.TreeOffsets[1], "measure_bc", maskVir);
	a.emit(0xA1); a.dword(maskVir);                    // MOV EAX,[visible mask]
	a.emit(0x33, 0xD2);                                // XOR EDX,EDX (count)
	a.label("measure_count");
	a.emit(0x85, 0xC0);                                // TEST EAX,EAX
	a.jcc(0x84, "measure_count_done");
	a.emit(0x8D, 0x48, 0xFF);                          // LEA ECX,[EAX-1]
	a.emit(0x23, 0xC1);                                // AND EAX,ECX
	a.emit(0x42);                                      // INC EDX
	a.jmp("measure_count");
	a.label("measure_count_done");
	a.emit(0x83, 0x3D); a.dword(autoVisibleVir); a.emit(0x00);
	a.jcc(0x84, "auto_counted");
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "append_auto");                    // Classic parent owns visibility
	a.emit(0x80, 0x3D); a.dword(MenuZeroStatic.MenuExpandedFlag); a.emit(0x00);
	a.jcc(0x84, "auto_counted");                     // New UI zero = collapsed
	a.label("append_auto");
	a.emit(0x42);                                      // append Auto Hunt
	a.label("auto_counted");
	a.emit(0x8B, 0xC2);                                // MOV EAX,EDX
	a.emit(0x83, 0xC0, MenuZeroStatic.GridColumns - 1);
	a.emit(0x33, 0xD2);                                // XOR EDX,EDX
	a.emit(0xB9); a.dword(MenuZeroStatic.GridColumns);
	a.emit(0xF7, 0xF1);                                // DIV ECX; EAX=rows
	a.emit(0x85, 0xC0);
	a.jcc(0x85, "measure_rows_nonzero");
	a.emit(0x40);                                      // minimum one row
	a.label("measure_rows_nonzero");
	a.emit(0x83, 0xF8, 0x06);
	a.jcc(0x86, "measure_rows_ready");                 // JBE
	a.emit(0xB8); a.dword(6);
	a.label("measure_rows_ready");
	a.emit(0xA3); a.dword(rowCountVir);
	a.emit(0x6B, 0xC0, MenuZeroStatic.GridStrideY);
	a.emit(0x83, 0xC0, MenuZeroStatic.PanelBaseHeight);
	a.emit(0xA3); a.dword(panelHeightVir);
	a.emit(0xA1); a.dword(rowCountVir);
	a.emit(0x6B, 0xC0, MenuZeroStatic.OldGridStrideY);
	a.emit(0x83, 0xC0, MenuZeroStatic.OldPanelBaseHeight);
	a.emit(0xA3); a.dword(oldPanelHeightVir);
	a.emit(0x61, 0xC3);                                // POPAD / RET
	return a;
};

MenuZeroStatic.buildLayoutWrapper = function(
	anchorVir, measureRowsVir, maskVir, panelHeightVir, oldPanelHeightVir,
	themeStateVir, ensureAutoHuntVir, syncAutoHuntVir, syncLaunchersVir
)
{
	const a = MenuZeroStatic.asm();
	a.emit(0x55, 0x8B, 0xEC);                          // frame
	a.emit(0x53, 0x56, 0x57);                          // preserve EBX/ESI/EDI
	a.emit(0x8B, 0xF1);                                // MOV ESI,ECX
	a.emit(0xFF, 0x75, 0x0C);                          // PUSH arg2
	a.emit(0xFF, 0x75, 0x08);                          // PUSH arg1
	a.emit(0x8B, 0xCE);                                // MOV ECX,ESI
	a.call(MenuZeroStatic.LayoutOriginal);
	a.emit(0x50);                                      // preserve stock EAX
	a.emit(0x8B, 0xCE);
	a.call(ensureAutoHuntVir);
	a.emit(0x8B, 0xCE);
	a.call(measureRowsVir);
	a.emit(0x83, 0x3D); a.dword(themeStateVir); a.emit(0x00);
	a.jcc(0x84, "classic");

	a.emit(0xA1); a.dword(panelHeightVir);
	a.emit(0x83, 0xC0, MenuZeroStatic.ParentExtraHeight);
	a.emit(0x50);                                      // PUSH renewal height
	MenuZeroStatic.pushImmediate(a, MenuZeroStatic.ParentWidth);
	a.emit(0x8B, 0x06, 0x8B, 0xCE);
	a.emit(0xFF, 0x50, 0x04);                          // SetSize
	for (let i = 0; i < MenuZeroStatic.ChildOffsets.length; i++)
	{
		MenuZeroStatic.emitSetChildPosition(
			a,
			MenuZeroStatic.ChildOffsets[i],
			MenuZeroStatic.ToggleX,
			panelHeightVir,
			"toggle_" + i + "_done"
		);
	}
	MenuZeroStatic.emitRepositionTree(
		a, MenuZeroStatic.TreeOffsets[0], "tree_b4", maskVir
	);
	MenuZeroStatic.emitRepositionTree(
		a, MenuZeroStatic.TreeOffsets[1], "tree_bc", maskVir
	);
	a.emit(0x8B, 0xCE);
	a.call(syncAutoHuntVir);
	a.emit(0x8B, 0xCE);
	a.call(anchorVir);
	a.jmp("sync_external");

	a.label("classic");
	a.emit(0xA1); a.dword(oldPanelHeightVir);
	a.emit(0x83, 0xC0, MenuZeroStatic.ClassicParentExtraHeight);
	a.emit(0x50);                                      // PUSH classic height
	MenuZeroStatic.pushImmediate(a, MenuZeroStatic.ClassicParentWidth);
	a.emit(0x8B, 0x06, 0x8B, 0xCE);
	a.emit(0xFF, 0x50, 0x04);                          // SetSize
	a.emit(0x8B, 0xCE);
	a.call(syncAutoHuntVir);

	a.label("sync_external");
	a.call(syncLaunchersVir);
	a.emit(0x58);                                      // restore stock EAX
	a.emit(0x5F, 0x5E, 0x5B);
	a.emit(0x8B, 0xE5, 0x5D);
	a.emit(0xC2, 0x08, 0x00);
	return a;
};

MenuZeroStatic.buildRefresh = function()
{
	const a = MenuZeroStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.emit(0x68); a.dword(MenuZeroStatic.WindowId);
	a.emit(0xB9); a.dword(MenuZeroStatic.WindowManager);
	a.call(MenuZeroStatic.GetWindow);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "create");
	a.emit(0x68); a.dword(MenuZeroStatic.WindowId);
	a.emit(0xB9); a.dword(MenuZeroStatic.WindowManager);
	a.call(MenuZeroStatic.CloseWindow);
	a.label("create");
	a.emit(0x68); a.dword(MenuZeroStatic.WindowId);
	a.emit(0xB9); a.dword(MenuZeroStatic.WindowManager);
	a.call(MenuZeroStatic.CreateWindow);
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

MenuZeroStatic.buildLauncherVisibility = function(
	stateVir, themeEnabledVir, loadThemeVir, syncVir
)
{
	const s = MenuZeroStatic;
	const a = s.asm();
	a.emit(0x56);                                      // PUSH ESI
	a.emit(0x8B, 0xF1);                                // MOV ESI,ECX (window)
	a.call(loadThemeVir);
	a.emit(0x8B, 0x44, 0x24, 0x08);                   // original visibility
	a.emit(0x50, 0x8B, 0xCE);                         // PUSH value / MOV ECX,ESI
	a.call(s.SetVisibleOriginal);                      // always honor native request
	a.emit(0x83, 0x3D); a.dword(themeEnabledVir); a.emit(0x00);
	a.jcc(0x84, "done");                             // Classic UI
	a.emit(0x39, 0x35); a.dword(stateVir + s.LauncherStateWindow);
	a.jcc(0x85, "done");                             // construction not captured yet
	a.emit(0x83, 0x3D);
	a.dword(stateVir + s.LauncherStatePositionValid);
	a.emit(0x00);
	a.jcc(0x84, "done");
	a.emit(0x50);                                      // preserve native return value
	a.call(syncVir);
	a.emit(0x58);
	a.label("done");
	a.emit(0x5E, 0xC2, 0x04, 0x00);                  // POP ESI / RET 4
	return a;
};

MenuZeroStatic.buildSyncLaunchers = function(
	launcherStateVir, themeEnabledVir, loadThemeVir
)
{
	const s = MenuZeroStatic;
	const a = s.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.call(loadThemeVir);
	a.emit(0x33, 0xDB);                               // EBX=next stacked Y (unset)
	for (let index = 0; index < s.ManagedWindows.length; index++)
	{
		const spec = s.ManagedWindows[index];
		const stateVir = launcherStateVir +
			index * s.LauncherStateStride;
		a.emit(0x68); a.dword(spec.windowId);
		a.emit(0xB9); a.dword(s.WindowManager);
		a.call(s.GetWindow);
		a.emit(0x8B, 0xF0);                            // MOV ESI,EAX (window)
		a.emit(0x85, 0xF6);
		a.jcc(0x84, `missing_${index}`);

		a.emit(0x39, 0x35);
		a.dword(stateVir + s.LauncherStateWindow);
		a.jcc(0x84, `identity_ready_${index}`);
		a.emit(0x89, 0x35);
		a.dword(stateVir + s.LauncherStateWindow);
		a.emit(0xC7, 0x05);
		a.dword(stateVir + s.LauncherStatePositionValid);
		a.dword(0);
		a.label(`identity_ready_${index}`);

		a.emit(0x83, 0x3D);
		a.dword(stateVir + s.LauncherStatePositionValid);
		a.emit(0x00);
		a.jcc(0x85, `position_ready_${index}`);
		a.emit(0xA1); a.dword(s.DisplayPointer);
		a.emit(0x85, 0xC0);
		a.jcc(0x84, `next_${index}`);
		a.emit(0x8B, 0x78, 0x28);                      // display width
		a.emit(0x2B, 0x7E, 0x1C);                      // minus native X
		a.emit(0x89, 0x3D);
		a.dword(stateVir + s.LauncherStateNativeRightInset);
		a.emit(0x8B, 0x7E, 0x20);
		a.emit(0x89, 0x3D);
		a.dword(stateVir + s.LauncherStateNativeY);
		a.emit(0xC7, 0x05);
		a.dword(stateVir + s.LauncherStatePositionValid);
		a.dword(1);
		a.label(`position_ready_${index}`);

		a.emit(0x83, 0x3D); a.dword(themeEnabledVir); a.emit(0x00);
		a.jcc(0x84, `classic_${index}`);
		a.emit(0x83, 0x7E, 0x28, 0x00);                // naturally visible?
		a.jcc(0x84, `next_${index}`);                  // hidden consumes no row
		a.emit(0x85, 0xDB);
		a.jcc(0x85, `stack_y_ready_${index}`);
		a.emit(0x8B, 0x7E, 0x18);                      // first window height
		a.emit(0x47, 0xD1, 0xEF);                      // ceil(height / 2)
		a.emit(0xBB); a.dword(s.LauncherFirstCenterY);
		a.emit(0x2B, 0xDF);                            // first top = center-half
		a.label(`stack_y_ready_${index}`);
		a.emit(0xA1); a.dword(s.DisplayPointer);
		a.emit(0x85, 0xC0);
		a.jcc(0x84, `next_${index}`);
		a.emit(0x8B, 0x40, 0x28);                      // display width
		a.emit(0x83, 0xE8, s.MinimapRightInset);
		a.emit(0x2B, 0x46, 0x14);                      // right-align native width
		a.emit(0x53, 0x50);                            // PUSH Y / PUSH X
		a.emit(0x8B, 0x06, 0x8B, 0xCE);
		a.emit(0xFF, 0x50, 0x10);                      // virtual SetPosition
		a.emit(0x03, 0x5E, 0x18);                      // next Y += height
		a.emit(0x83, 0xC3, s.LauncherRowGap);
		a.jmp(`next_${index}`);

		a.label(`classic_${index}`);
		a.emit(0xFF, 0x35);
		a.dword(stateVir + s.LauncherStateNativeY);
		a.emit(0xA1); a.dword(s.DisplayPointer);
		a.emit(0x85, 0xC0);
		a.jcc(0x84, `discard_y_${index}`);
		a.emit(0x8B, 0x40, 0x28);
		a.emit(0x2B, 0x05);
		a.dword(stateVir + s.LauncherStateNativeRightInset);
		a.emit(0x50);
		a.emit(0x8B, 0x06, 0x8B, 0xCE);
		a.emit(0xFF, 0x50, 0x10);                      // restore native position
		a.jmp(`next_${index}`);
		a.label(`discard_y_${index}`);
		a.emit(0x58);                                  // discard pushed native Y
		a.jmp(`next_${index}`);

		a.label(`missing_${index}`);
		a.emit(0xC7, 0x05);
		a.dword(stateVir + s.LauncherStateWindow);
		a.dword(0);
		a.emit(0xC7, 0x05);
		a.dword(stateVir + s.LauncherStatePositionValid);
		a.dword(0);
		a.label(`next_${index}`);
	}
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D);
	a.emit(0xC3);
	return a;
};

MenuZeroStatic.buildPostMakeWindow = function(
	launcherStateVir, syncVir
)
{
	const s = MenuZeroStatic;
	const a = s.asm();
	a.emit(0x9C, 0x60);                              // preserve MakeWindow state
	a.emit(0x8B, 0x45, 0x08);                        // MOV EAX,[EBP+8] (ID)
	a.emit(0x3D); a.dword(s.WindowId);
	a.jcc(0x84, "menu_ready");
	for (let index = 0; index < s.ManagedWindows.length; index++)
	{
		a.emit(0x3D); a.dword(s.ManagedWindows[index].windowId);
		a.jcc(0x84, `capture_${index}`);
	}
	a.jmp("done");

	for (let index = 0; index < s.ManagedWindows.length; index++)
	{
		const spec = s.ManagedWindows[index];
		const stateVir = launcherStateVir +
			index * s.LauncherStateStride;
		a.label(`capture_${index}`);
		a.emit(0x8B, 0x75, 0xEC);                      // new window
		a.emit(0x85, 0xF6);
		a.jcc(0x84, "done");
		a.emit(0x39, 0x35);
		a.dword(stateVir + s.LauncherStateWindow);
		a.jcc(0x84, `state_ready_${index}`);
		a.emit(0x89, 0x35);
		a.dword(stateVir + s.LauncherStateWindow);
		a.emit(0xC7, 0x05);
		a.dword(stateVir + s.LauncherStatePositionValid);
		a.dword(0);
		a.label(`state_ready_${index}`);
		a.call(syncVir);
		a.jmp("done");
	}

	a.label("menu_ready");
	a.emit(0x8B, 0x75, 0xEC);                        // created/existing menu
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "done");
	a.call(syncVir);

	a.label("done");
	a.emit(0x61, 0x9D);
	a.emit(0x8B, 0x45, 0xEC, 0x85, 0xC0);            // stolen MOV/TEST
	a.jmp(s.PostMakeWindowReturn);
	return a;
};

MenuZeroStatic.buildGoldPositionCapture = function(stateVir)
{
	const s = MenuZeroStatic;
	const a = s.asm();
	a.emit(0x8B, 0x0D); a.dword(s.DisplayPointer);
	a.emit(0x8B, 0x49, 0x28);
	a.emit(0x2B, 0xC8);                                // display width - native X
	a.emit(0x89, 0x0D);
	a.dword(stateVir + s.LauncherStateNativeRightInset);
	a.emit(0x8B, 0x0C, 0x24);
	a.emit(0x89, 0x0D); a.dword(stateVir + s.LauncherStateNativeY);
	a.emit(0xC7, 0x05);
	a.dword(stateVir + s.LauncherStatePositionValid);
	a.dword(1);
	a.emit(0x89, 0x35);
	a.dword(stateVir + s.LauncherStateWindow);
	a.emit(0x50, 0x8B, 0xCE, 0xFF, 0xD2);            // stolen block
	a.jmp(s.GoldPositionReturn);
	return a;
};

MenuZeroStatic.assertCode = function(label, virAddr, expectedHex)
{
	const phyAddr = Exe.Vir2Phy(virAddr, CODE);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroMenu: ${label} is not mapped`);
	const normalized = MenuZeroStatic.hexNorm(expectedHex);
	const count = normalized.split(" ").length;
	const actual = MenuZeroStatic.hexNorm(Exe.GetHex(phyAddr, count));
	if (actual !== normalized)
		throw Error(`ROGlobalZeroMenu: ${label} mismatch, got ${actual}`);
	return phyAddr;
};

MenuZeroStatic.assertVtable = function(label, entryVir, expectedVir)
{
	const phyAddr = Exe.Vir2Phy(entryVir);
	if (phyAddr < 0)
		throw Error(`ROGlobalZeroMenu: ${label} is not mapped`);
	const actual = Exe.GetUint32(phyAddr);
	if (actual !== expectedVir)
	{
		throw Error(
			`ROGlobalZeroMenu: ${label} expected 0x${expectedVir.toString(16)}, ` +
			`got 0x${actual.toString(16)}`
		);
	}
	return phyAddr;
};

MenuZeroStatic.getManagedWindowRoutes = function()
{
	const s = MenuZeroStatic;
	const switchPhy = s.assertCode(
		"UIWindowMgr::MakeWindow main switch",
		s.MakeWindowSwitchSite,
		s.MakeWindowSwitchBytes
	);
	const indexTableVir = Exe.GetUint32(switchPhy + 3);
	const indexTablePhy = Exe.Vir2Phy(indexTableVir, CODE);
	if (indexTablePhy < 0)
		throw Error("ROGlobalZeroMenu: MakeWindow index table is not mapped");
	const routes = [];
	for (const spec of s.ManagedWindows)
	{
		const entryPhy = indexTablePhy + spec.windowId;
		const currentCase = Exe.GetUint8(entryPhy);
		if (currentCase !== spec.windowCase)
		{
			throw Error(
				`ROGlobalZeroMenu: ${spec.label} route expected ` +
				`0x${spec.windowCase.toString(16).toUpperCase()}, got ` +
				`0x${currentCase.toString(16).toUpperCase()}`
			);
		}
		routes.push({key: spec.key, entryPhy, currentCase});
	}
	return routes;
};

MenuZeroStatic.pushBytes = function(pointer)
{
	const bytes = [0x68];
	for (let shift = 0; shift < 32; shift += 8)
		bytes.push((pointer >>> shift) & 0xFF);
	return MenuZeroStatic.bytesToHex(bytes);
};

MenuZeroStatic.verifyNativeLayout = function()
{
	const verified = {
		factoryCasePhy: MenuZeroStatic.assertCode(
			"UIMenuIconWnd factory case",
			MenuZeroStatic.FactoryCase,
			MenuZeroStatic.FactoryBytes
		),
		drawVtablePhy: MenuZeroStatic.assertVtable(
			"UIMenuIconWnd vtable[20]",
			MenuZeroStatic.DrawVtableEntry,
			MenuZeroStatic.DrawOriginal
		),
		positionVtablePhy: MenuZeroStatic.assertVtable(
			"UIMenuIconWnd vtable[4]",
			MenuZeroStatic.PositionVtableEntry,
			MenuZeroStatic.PositionOriginal
		),
		hitTestVtablePhy: MenuZeroStatic.assertVtable(
			"UIMenuIconWnd vtable[50]",
			MenuZeroStatic.HitTestVtableEntry,
			MenuZeroStatic.HitTestOriginal
		),
		layoutVtablePhy: MenuZeroStatic.assertVtable(
			"UIMenuIconWnd vtable[15]",
			MenuZeroStatic.LayoutVtableEntry,
			MenuZeroStatic.LayoutOriginal
		),
		buttonDestructorVtablePhy: MenuZeroStatic.assertVtable(
			"UIButton vtable[0]",
			MenuZeroStatic.ButtonVtable,
			MenuZeroStatic.ButtonDeletingDestructor
		),
		buttonMouseUpVtablePhy: MenuZeroStatic.assertVtable(
			"UIButton vtable[31]",
			MenuZeroStatic.ButtonVtable + 31 * 4,
			MenuZeroStatic.ButtonMouseUp
		),
		backgroundCopyPhy: MenuZeroStatic.assertCode(
			"background std::string copy block",
			MenuZeroStatic.BackgroundCopyBlock,
			MenuZeroStatic.BackgroundCopyBytes
		),
		backgroundDrawPhy: MenuZeroStatic.assertCode(
			"background draw coordinates",
			MenuZeroStatic.BackgroundDrawBlock,
			MenuZeroStatic.BackgroundDrawBytes
		),
		backgroundHeightPhy: MenuZeroStatic.assertCode(
			"background draw height",
			MenuZeroStatic.BackgroundHeightBlock,
			MenuZeroStatic.BackgroundHeightBytes
		),
		provisionalSizePhy: MenuZeroStatic.assertCode(
			"provisional UIMenuIconWnd size",
			MenuZeroStatic.ProvisionalSize,
			MenuZeroStatic.ProvisionalSizeBytes
		),
		finalSizePhy: MenuZeroStatic.assertCode(
			"final UIMenuIconWnd size",
			MenuZeroStatic.FinalSize,
			MenuZeroStatic.FinalSizeBytes
		),
		descriptorLengthPhy: MenuZeroStatic.assertCode(
			"adventurerAgency descriptor length",
			MenuZeroStatic.DescriptorLengthBlock,
			MenuZeroStatic.DescriptorLengthBytes
		),
		descriptorPointerPhy: MenuZeroStatic.assertCode(
			"adventurerAgency descriptor pointer",
			MenuZeroStatic.DescriptorPointer,
			MenuZeroStatic.DescriptorPointerBytes
		),
		postMakeWindowPhy: MenuZeroStatic.assertCode(
			"post-MakeWindow launcher seam",
			MenuZeroStatic.PostMakeWindowSite,
			MenuZeroStatic.PostMakeWindowBytes
		),
		goldPositionPhy: MenuZeroStatic.assertCode(
			"Gold native-position seam",
			MenuZeroStatic.GoldPositionSite,
			MenuZeroStatic.GoldPositionBytes
		),
		managedWindowRoutes: MenuZeroStatic.getManagedWindowRoutes(),
		launcherVisibilityEntries: [],
		resourcePushes: []
	};

	for (const spec of MenuZeroStatic.ManagedWindows)
	{
		verified.launcherVisibilityEntries.push({
			spec,
			entryPhy: MenuZeroStatic.assertVtable(
				`${spec.label} visibility vtable`,
				spec.vtable + 14 * 4,
				MenuZeroStatic.SetVisibleOriginal
			)
		});
	}

	for (const resource of MenuZeroStatic.ResourcePushes)
	{
		for (const siteVir of resource.sites)
		{
			verified.resourcePushes.push({
				resource,
				siteVir,
				sitePhy: MenuZeroStatic.assertCode(
					`${resource.name} resource PUSH`,
					siteVir,
					MenuZeroStatic.pushBytes(resource.oldPointer)
				)
			});
		}
	}
	return verified;
};

ROGlobalZeroMenu = function(_)
{
	if (Exe.BuildDate !== MenuZeroStatic.BuildDate)
		throw Error("ROGlobalZeroMenu supports only the 2025-07-16 client");
	const theme = CACHE.get("ROGlobalZeroUITheme.State");
	if (!theme || !Number.isInteger(theme.stateVir) ||
		!Number.isInteger(theme.loadVir))
	{
		throw Error("ROGlobalZeroMenu: ROGlobalZeroUITheme must run first");
	}
	if (!Warp.TestMode)
		Warp.SetPatchState("MoveShopIcon", false);
	const themeEnabledVir = theme.stateVir +
		(Number.isInteger(theme.enabledOffset) ? theme.enabledOffset : 0);
	const autoHuntBridge = CACHE.get("AutoCombatUI.MenuButton.v1");
	if (!autoHuntBridge || !Number.isInteger(autoHuntBridge.toggleVir) ||
		!Number.isInteger(autoHuntBridge.requestVir) ||
		!Number.isInteger(autoHuntBridge.visibleVir))
	{
		throw Error("ROGlobalZeroMenu: AutoCombatUI must run first");
	}
	const autoHuntHoverText = "Auto Hunt";
	const autoHuntHover = MenuZeroStatic.allocateBytes(
		MenuZeroStatic.asciiBytes(autoHuntHoverText)
	);

	$$(_, 1, "Verify menu, launcher, visibility, and layout seams");
	const verified = MenuZeroStatic.verifyNativeLayout();

	$$(_, 2, "Allocate renewal menu resources and the chatting descriptor");
	const prefix = MenuZeroStatic.resourcePrefix();
	const resourcePaths = {};
	for (const resource of MenuZeroStatic.ResourcePushes)
	{
		resourcePaths[resource.name] = MenuZeroStatic.allocateBytes(
			MenuZeroStatic.buildResourceBytes(prefix, resource.relative)
		);
	}
	const descriptor = MenuZeroStatic.allocateBytes(MenuZeroStatic.asciiBytes("chatting"));
	const backgrounds = {
		renewal: [],
		classic: [],
		pathLength: 0
	};
	for (let row = 1; row <= 6; row++)
	{
		for (const spec of [
			{key: "renewal", relative: "uirenewal\\menuicon\\bg_m" + row + ".tga"},
			{key: "classic", relative: "uirenewal\\menuicon\\bg_o" + row + ".tga"}
		])
		{
			const bytes = MenuZeroStatic.buildResourceBytes(
				prefix, spec.relative, false
			);
			if (backgrounds.pathLength === 0)
				backgrounds.pathLength = bytes.length;
			else if (bytes.length !== backgrounds.pathLength)
			{
				throw Error(
					"ROGlobalZeroMenu: row background paths must have equal length"
				);
			}
			if (bytes.length >= MenuZeroStatic.BackgroundBufferSize)
				throw Error("ROGlobalZeroMenu: row background path exceeds buffer");
			while (bytes.length < MenuZeroStatic.BackgroundBufferSize)
				bytes.push(0);
			backgrounds[spec.key].push(
				MenuZeroStatic.allocateBytes(bytes, 0x10).vir
			);
		}
	}
	const buttonPathSpecs = {
		renewal: [
			"uirenewal\\menuicon\\bt_autohunt_normal.bmp",
			"uirenewal\\menuicon\\bt_autohunt_mouseon.bmp",
			"uirenewal\\menuicon\\bt_autohunt_pressed.bmp"
		],
		classic: [
			"uirenewal\\menuicon\\bt_autohunt_old_normal.bmp",
			"uirenewal\\menuicon\\bt_autohunt_old_mouseon.bmp",
			"uirenewal\\menuicon\\bt_autohunt_old_pressed.bmp"
		]
	};
	const buttonImagePaths = {renewal: [], classic: []};
	for (const key of ["renewal", "classic"])
	{
		for (const relative of buttonPathSpecs[key])
		{
			buttonImagePaths[key].push(
				MenuZeroStatic.allocateBytes(
					MenuZeroStatic.buildResourceBytes(prefix, relative)
				).vir
			);
		}
	}
	const buttonState = MenuZeroStatic.allocateBytes(
		new Array(MenuZeroStatic.AutoHuntButtonStateSize).fill(0),
		4
	);
	const oldPanelHeight = 6 * MenuZeroStatic.OldGridStrideY +
		MenuZeroStatic.OldPanelBaseHeight;
	const layoutState = MenuZeroStatic.allocateBytes([
		0, 0, 0, 0,
		MenuZeroStatic.PanelHeight & 0xFF,
		(MenuZeroStatic.PanelHeight >>> 8) & 0xFF,
		(MenuZeroStatic.PanelHeight >>> 16) & 0xFF,
		(MenuZeroStatic.PanelHeight >>> 24) & 0xFF,
		6, 0, 0, 0,
		oldPanelHeight & 0xFF,
		(oldPanelHeight >>> 8) & 0xFF,
		(oldPanelHeight >>> 16) & 0xFF,
		(oldPanelHeight >>> 24) & 0xFF
	], 4);
	const visibleMaskVir = layoutState.vir;
	const panelHeightVir = layoutState.vir + 4;
	const rowCountVir = layoutState.vir + 8;
	const oldPanelHeightVir = layoutState.vir + 12;
	const launcherState = MenuZeroStatic.allocateBytes(
		new Array(
			MenuZeroStatic.ManagedWindows.length *
			MenuZeroStatic.LauncherStateStride
		).fill(0),
		4
	);
	const loadTheme = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildPreservedThemeLoad(theme.loadVir)
	);
	const buttonDestructor = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildButtonDestructor(buttonState.vir)
	);
	const buttonMouseUp = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildButtonMouseUp(autoHuntBridge.requestVir)
	);
	const buttonHover = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildButtonHover(autoHuntHover.vir)
	);
	const buttonVtable = MenuZeroStatic.cloneButtonVtable(
		buttonMouseUp.vir, buttonHover.vir, buttonDestructor.vir
	);
	const ensureAutoHunt = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildEnsureAutoHuntButtons(
			buttonState.vir, buttonVtable.vir, buttonImagePaths,
			theme.stateVir
		)
	);
	const syncAutoHunt = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildSyncAutoHuntButtons(
			buttonState.vir,
			visibleMaskVir,
			autoHuntBridge.visibleVir,
			theme.stateVir
		)
	);
	const drawWrapper = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildDrawWrapper(syncAutoHunt.vir)
	);
	const syncLaunchers = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildSyncLaunchers(
			launcherState.vir,
			themeEnabledVir,
			loadTheme.vir
		)
	);
	const launcherVisibility = [];
	for (let index = 0; index < MenuZeroStatic.ManagedWindows.length; index++)
	{
		const stateVir = launcherState.vir +
			index * MenuZeroStatic.LauncherStateStride;
		launcherVisibility.push(
			MenuZeroStatic.allocateCode(
				MenuZeroStatic.buildLauncherVisibility(
					stateVir,
					themeEnabledVir,
					loadTheme.vir,
					syncLaunchers.vir
				)
			)
		);
	}

	$$(_, 3, "Inject compact menu reflow and under-minimap launchers");
	const measureRows = MenuZeroStatic.buildMeasureRows(
		visibleMaskVir,
		panelHeightVir,
		rowCountVir,
		oldPanelHeightVir,
		autoHuntBridge.visibleVir,
		theme.stateVir
	);
	const [measureRowsPhy, measureRowsVir] = Exe.Allocate(
		measureRows.bytes.length, 0x10
	);
	Exe.SetHex(measureRowsPhy, measureRows.finish(measureRowsVir));
	const backgroundCopy = MenuZeroStatic.buildBackgroundCopy(
		backgrounds,
		rowCountVir,
		theme.stateVir,
		theme.loadVir
	);
	const [backgroundCopyPhy, backgroundCopyVir] = Exe.Allocate(
		backgroundCopy.bytes.length, 0x10
	);
	Exe.SetHex(backgroundCopyPhy, backgroundCopy.finish(backgroundCopyVir));
	const backgroundDraw = MenuZeroStatic.buildBackgroundDraw(
		theme.stateVir, theme.loadVir
	);
	const [backgroundDrawPhy, backgroundDrawVir] = Exe.Allocate(
		backgroundDraw.bytes.length, 0x10
	);
	Exe.SetHex(backgroundDrawPhy, backgroundDraw.finish(backgroundDrawVir));
	const backgroundHeight = MenuZeroStatic.buildBackgroundHeight(
		measureRowsVir,
		panelHeightVir,
		oldPanelHeightVir,
		theme.stateVir,
		theme.loadVir
	);
	const [backgroundHeightPhy, backgroundHeightVir] = Exe.Allocate(
		backgroundHeight.bytes.length, 0x10
	);
	Exe.SetHex(
		backgroundHeightPhy,
		backgroundHeight.finish(backgroundHeightVir)
	);
	const descriptorLength = MenuZeroStatic.buildDescriptorLength(
		theme.stateVir, theme.loadVir
	);
	const [descriptorLengthPhy, descriptorLengthVir] = Exe.Allocate(
		descriptorLength.bytes.length, 0x10
	);
	Exe.SetHex(
		descriptorLengthPhy,
		descriptorLength.finish(descriptorLengthVir)
	);
	const descriptorSelector = MenuZeroStatic.buildPushSelector(
		0x0102833C, descriptor.vir, theme.stateVir, theme.loadVir
	);
	const [descriptorSelectorPhy, descriptorSelectorVir] = Exe.Allocate(
		descriptorSelector.bytes.length, 0x10
	);
	Exe.SetHex(
		descriptorSelectorPhy,
		descriptorSelector.finish(descriptorSelectorVir)
	);
	const anchor = MenuZeroStatic.buildAnchor();
	const [anchorPhy, anchorVir] = Exe.Allocate(anchor.bytes.length, 0x10);
	Exe.SetHex(anchorPhy, anchor.finish(anchorVir));
	const positionWrapper = MenuZeroStatic.buildPositionWrapper(
		anchorVir, theme.stateVir, syncLaunchers.vir
	);
	const [positionWrapperPhy, positionWrapperVir] = Exe.Allocate(
		positionWrapper.bytes.length, 0x10
	);
	Exe.SetHex(positionWrapperPhy, positionWrapper.finish(positionWrapperVir));
	const hitTestWrapper = MenuZeroStatic.buildHitTestWrapper(theme.stateVir);
	const [hitTestWrapperPhy, hitTestWrapperVir] = Exe.Allocate(
		hitTestWrapper.bytes.length, 0x10
	);
	Exe.SetHex(hitTestWrapperPhy, hitTestWrapper.finish(hitTestWrapperVir));
	const layoutWrapper = MenuZeroStatic.buildLayoutWrapper(
		anchorVir,
		measureRowsVir,
		visibleMaskVir,
		panelHeightVir,
		oldPanelHeightVir,
		theme.stateVir,
		ensureAutoHunt.vir,
		syncAutoHunt.vir,
		syncLaunchers.vir
	);
	const [layoutWrapperPhy, layoutWrapperVir] = Exe.Allocate(
		layoutWrapper.bytes.length, 0x10
	);
	Exe.SetHex(layoutWrapperPhy, layoutWrapper.finish(layoutWrapperVir));
	const postMakeWindow = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildPostMakeWindow(
			launcherState.vir,
			syncLaunchers.vir
		)
	);
	let goldIndex = -1;
	for (let index = 0; index < MenuZeroStatic.ManagedWindows.length; index++)
	{
		if (MenuZeroStatic.ManagedWindows[index].key === "goldPc")
			goldIndex = index;
	}
	if (goldIndex < 0)
		throw Error("ROGlobalZeroMenu: Gold PC launcher specification missing");
	const goldPositionCapture = MenuZeroStatic.allocateCode(
		MenuZeroStatic.buildGoldPositionCapture(
			launcherState.vir +
			goldIndex * MenuZeroStatic.LauncherStateStride
		)
	);
	const resourceSelectors = {};
	for (const resource of MenuZeroStatic.ResourcePushes)
	{
		const selector = MenuZeroStatic.buildPushSelector(
			resource.oldPointer,
			resourcePaths[resource.name].vir,
			theme.stateVir,
			theme.loadVir
		);
		const [phy, vir] = Exe.Allocate(selector.bytes.length, 0x10);
		Exe.SetHex(phy, selector.finish(vir));
		resourceSelectors[resource.name] = {phy, vir, size: selector.bytes.length};
	}
	const sizeSelectors = {};
	for (const selectorSpec of [
		["provisionalHeight", MenuZeroStatic.ClassicProvisionalHeight, MenuZeroStatic.ParentHeight],
		["provisionalWidth", MenuZeroStatic.ClassicParentWidth, MenuZeroStatic.ParentWidth],
		["finalHeight", MenuZeroStatic.ClassicFinalHeight, MenuZeroStatic.ParentHeight],
		["finalWidth", MenuZeroStatic.ClassicParentWidth, MenuZeroStatic.ParentWidth]
	])
	{
		const selector = MenuZeroStatic.buildPushSelector(
			selectorSpec[1], selectorSpec[2], theme.stateVir, theme.loadVir
		);
		const [phy, vir] = Exe.Allocate(selector.bytes.length, 0x10);
		Exe.SetHex(phy, selector.finish(vir));
		sizeSelectors[selectorSpec[0]] = {phy, vir, size: selector.bytes.length};
	}
	$$(_, 4, "Activate theme geometry and reversible launcher ownership");
	for (const push of verified.resourcePushes)
	{
		Exe.SetCALL(
			push.sitePhy,
			resourceSelectors[push.resource.name].vir,
			0
		);
	}
	Exe.SetJMP(verified.descriptorLengthPhy, descriptorLengthVir, 0);
	Exe.SetNOPs(verified.descriptorLengthPhy + 5, 7);
	Exe.SetCALL(verified.descriptorPointerPhy, descriptorSelectorVir, 0);
	Exe.SetJMP(verified.backgroundCopyPhy, backgroundCopyVir, 0);
	Exe.SetNOPs(verified.backgroundCopyPhy + 5, 45);
	Exe.SetJMP(verified.backgroundDrawPhy, backgroundDrawVir, 0);
	Exe.SetNOPs(verified.backgroundDrawPhy + 5, 6);
	Exe.SetJMP(verified.backgroundHeightPhy, backgroundHeightVir, 0);
	Exe.SetNOPs(verified.backgroundHeightPhy + 5, 4);
	Exe.SetCALL(verified.provisionalSizePhy, sizeSelectors.provisionalHeight.vir, 0);
	Exe.SetCALL(verified.provisionalSizePhy + 5, sizeSelectors.provisionalWidth.vir, 0);
	Exe.SetCALL(verified.finalSizePhy, sizeSelectors.finalHeight.vir, 0);
	Exe.SetCALL(verified.finalSizePhy + 5, sizeSelectors.finalWidth.vir, 0);
	Exe.SetUint32(verified.drawVtablePhy, drawWrapper.vir);
	Exe.SetUint32(verified.positionVtablePhy, positionWrapperVir);
	Exe.SetUint32(verified.hitTestVtablePhy, hitTestWrapperVir);
	Exe.SetUint32(verified.layoutVtablePhy, layoutWrapperVir);
	for (let index = 0; index < verified.launcherVisibilityEntries.length; index++)
	{
		Exe.SetUint32(
			verified.launcherVisibilityEntries[index].entryPhy,
			launcherVisibility[index].vir
		);
	}
	Exe.SetJMP(verified.postMakeWindowPhy, postMakeWindow.vir, 0);
	Exe.SetJMP(verified.goldPositionPhy, goldPositionCapture.vir, 0);

	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
	{
		const pathPointers = {};
		for (const resource of MenuZeroStatic.ResourcePushes)
			pathPointers[resource.name] = resourcePaths[resource.name].vir;
		const launcherDiagnostics = [];
		for (let index = 0; index < MenuZeroStatic.ManagedWindows.length; index++)
		{
			const spec = MenuZeroStatic.ManagedWindows[index];
			launcherDiagnostics.push({
				key: spec.key,
				label: spec.label,
				windowId: spec.windowId,
				naturalRouteCase:
					verified.managedWindowRoutes[index].currentCase,
				stackOrder: index,
				forceCreated: false,
				visibilityVtableVir: spec.vtable + 14 * 4,
				visibilityWrapperVir: launcherVisibility[index].vir,
				stateVir: launcherState.vir +
					index * MenuZeroStatic.LauncherStateStride
			});
		}
		PatchDiagnostics.add("ROGlobalZeroMenu.QjsOnly", {
			version: 3,
			menuWindowId: MenuZeroStatic.WindowId,
			nativeDispatcherVir: MenuZeroStatic.NativeDispatcher,
			factoryCaseVir: MenuZeroStatic.FactoryCase,
			drawVtableVir: MenuZeroStatic.DrawVtableEntry,
			drawWrapperVir: drawWrapper.vir,
			positionVtableVir: MenuZeroStatic.PositionVtableEntry,
			positionWrapperVir,
			positionWrapperSize: positionWrapper.bytes.length,
			hitTestVtableVir: MenuZeroStatic.HitTestVtableEntry,
			hitTestWrapperVir,
			hitTestWrapperSize: hitTestWrapper.bytes.length,
			layoutVtableVir: MenuZeroStatic.LayoutVtableEntry,
			layoutWrapperVir,
			layoutWrapperSize: layoutWrapper.bytes.length,
			anchorVir,
			anchorSize: anchor.bytes.length,
			backgroundCopyVir,
			backgroundCopySize: backgroundCopy.bytes.length,
			backgroundDrawVir,
			backgroundDrawSize: backgroundDraw.bytes.length,
			backgroundHeightVir,
			backgroundHeightSize: backgroundHeight.bytes.length,
			measureRowsVir,
			measureRowsSize: measureRows.bytes.length,
			visibleMaskVir,
			panelHeightVir,
			oldPanelHeightVir,
			rowCountVir,
			autoHunt: {
				windowId: MenuZeroStatic.AutoHuntWindowId,
				hoverText: autoHuntHoverText,
				hoverTextVir: autoHuntHover.vir,
				requestVir: autoHuntBridge.requestVir,
				visibleVir: autoHuntBridge.visibleVir,
				toggleVir: autoHuntBridge.toggleVir,
				buttonStateVir: buttonState.vir,
				buttonVtableVir: buttonVtable.vir,
				buttonDestructorVir: buttonDestructor.vir,
				buttonMouseUpVir: buttonMouseUp.vir,
				buttonHoverVir: buttonHover.vir,
				ensureVir: ensureAutoHunt.vir,
				syncVir: syncAutoHunt.vir,
				positionPolicy: "after all visible native buttons"
			},
			themeStateVir: theme.stateVir,
			themeEnabledVir,
			themeLoadBridgeVir: loadTheme.vir,
			launcherStateVir: launcherState.vir,
			syncLaunchersVir: syncLaunchers.vir,
			launcherLayoutPolicy:
				"visible existing windows compact below the minimap",
			launcherRightInset: MenuZeroStatic.MinimapRightInset,
			launcherFirstCenterY: MenuZeroStatic.LauncherFirstCenterY,
			launcherRowGap: MenuZeroStatic.LauncherRowGap,
			postMakeWindowVir: postMakeWindow.vir,
			goldPositionCaptureVir: goldPositionCapture.vir,
			launchers: launcherDiagnostics,
			externalCashShopPolicy: "natural visibility; first stack slot",
			rodexNotificationPolicy: "natural visibility; fourth stack slot",
			missingLauncherPolicy: "query only; never create",
			backgroundPathVirs: {
				renewal: backgrounds.renewal,
				classic: backgrounds.classic
			},
			backgroundPathLength: backgrounds.pathLength,
			backgroundPolicy: "complete row-specific texture; never clipped",
			descriptorVir: descriptor.vir,
			descriptorName: "chatting",
			descriptorLengthVir,
			descriptorSelectorVir,
			parentWidth: MenuZeroStatic.ParentWidth,
			maxParentHeight: MenuZeroStatic.ParentHeight,
			panelWidth: MenuZeroStatic.PanelWidth,
			maxPanelHeight: MenuZeroStatic.PanelHeight,
			gridOrigin: [MenuZeroStatic.GridX, MenuZeroStatic.GridY],
			gridStride: [MenuZeroStatic.GridStrideX, MenuZeroStatic.GridStrideY],
			gridColumns: MenuZeroStatic.GridColumns,
			toggleX: MenuZeroStatic.ToggleX,
			toggleY: "panelHeight - 51",
			dynamicRows: true,
			visibilityPatches: ["HideNewButtons", "ShowNewButtons"],
			commandCount: MenuZeroStatic.CommandGrid.length,
			resourcePaths: pathPointers,
			externalModules: 0
		});
	}

	return true;
};

ROGlobalZeroMenu.validate = function()
{
	if (Exe.BuildDate !== MenuZeroStatic.BuildDate)
		return false;
	try
	{
		MenuZeroStatic.verifyNativeLayout();
		return true;
	}
	catch (error)
	{
		return false;
	}
};
