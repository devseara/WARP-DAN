*                                                                          *
*   Description   : Eliminates FPS lag from character model rendering in   *
*                   ALL UI windows. Patches UIDisplayCharacter::Draw to    *
*                   skip the expensive 3D mini-render-pass. A cheap static *
*                   cached 2D sprite may still remain visible in the skill *
*                   tree, but it has no performance impact.                *
*                                                                          *
\**************************************************************************/

///
/// \brief Patch UIDisplayCharacter::Draw to return immediately.
///        Stops the expensive per-instance 3D mini-render-pass in ALL
///        UI windows (Skill Tree, Equipment, Character Creation, etc.)
///        which eliminates FPS lag. A cheap cached 2D sprite may still
///        show in the skill tree window, but it has zero performance impact.
///
DisableExpensiveCharRender = function(_)
{
	$$(_, 1, `Find UIDisplayCharacter::Draw (vtable[20])`);

	/// UIDisplayCharacter vtable RVA = 0x0102571C
	/// vtable[20] = 0x0102571C + 20*4 = 0x0102576C
	/// At 0x0102576C the value is 0x007F2790 for 2025-07-16 client.
	/// We patch the function at 0x007F2790 to 'ret' (0xC3).
	///
	/// First instruction at 0x007F2790:
	///   55 8b ec 6a ff 68 10 14 e9 00 ...
	///   (push ebp; mov ebp, esp; ...)
	///
	/// We replace the first byte with RET (0xC3).

	const funcAddr = 0x007F2790;
	const pattern = "55 8b ec 6a ff 68 10 14 e9 00";

	let addr = Exe.FindHex(pattern);
	if (addr < 0)
	{
		addr = funcAddr;
		$$(_, 1.1, `Pattern not found, using hardcoded address 0x${funcAddr.toString(16).toUpperCase()}`);
	}
	else
	{
		$$(_, 1.1, `Found UIDisplayCharacter::Draw at 0x${addr.toString(16).toUpperCase()}`);
	}

	$$(_, 2, `Patch first byte to RET (0xC3)`);
	Exe.SetHex(addr, "C3");

	return true;
};

///
/// \brief Validate that the function exists and looks right.
///
DisableExpensiveCharRender.validate = function()
{
	const pattern = "55 8b ec 6a ff 68 10 14 e9 00";
	let addr = Exe.FindHex(pattern);
	if (addr < 0)
		addr = 0x007F2790;

	/// Check that the byte at the target is 0x55 (push ebp)
	/// or already patched (0xC3)
	const firstByte = Exe.GetUint8(addr);
	return (firstByte === 0x55 || firstByte === 0xC3);
};
