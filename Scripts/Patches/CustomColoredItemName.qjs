*                                                                          *
*   Author(s)     : Louis T Steinhil                                       *
*   Created Date  : 2025-07-16                                             *
*   Last Modified : 2026-07-24                                             *
*                                                                          *
*   Description   : Routes the Banquet 0x0BDD item-color list into a       *
*                   bounded EXE-resident table and colors item-title and   *
*                   optional grade-name spans independently at the         *
*                   client's TextOutW surfaces.                            *
*                   The implementation is fully EXE-resident and retains  *
*                   bounded UTF-8 exact matching.                         *
*                   Normal colors are limited to item-title               *
*                   shapes so bracketed description headings stay stock.  *
*                   Inventory and ground item-label producers recolor     *
*                   only the center glyph while retaining the client's    *
*                   native outline. Targets: 2025-07-16 Ragexe and        *
*                   2026-02-19 Ragexe.                                    *
*                                                                          *
\**************************************************************************/

ItemColorStatic = {
	Profiles: {
		20250716: {
			Name: "2025-07-16 Ragexe",
			ItemTooltipShow: 0x00A753D0,
			InventoryTooltipCallSites: [0x0094D594, 0x0094D639],
			EquipmentTooltipCallSites: [
				0x008B9EC6,
				0x008B9F48,
				0x008BA00E,
				0x008BA0B1
			],
			GroundTooltipProject: 0x00C72CE0,
			GroundTooltipCallSites: [0x00C7147C],
			BalloonPlainTextDraw: 0x00A27C20,
			BalloonPlainTextDrawCallSites: [0x00826529],
			BalloonStyledTextDraw: 0x00A26540,
			BalloonStyledTextDrawCallSites: [0x00826503],
			GetTickCountIat: 0x00FC120C,
			GetModuleHandleIat: 0x00FC1268,
			GetProcAddressIat: 0x00FC1390
		},
		20260219: {
			Name: "2026-02-19 Ragexe",
			ItemTooltipShow: 0x00AD6510,
			InventoryTooltipCallSites: [0x00987744, 0x009877E9],
			EquipmentTooltipCallSites: [
				0x008F3F76,
				0x008F3FF8,
				0x008F40BE,
				0x008F4161
			],
			GroundTooltipProject: 0x00CDD350,
			GroundTooltipCallSites: [0x00CDBADC],
			BalloonPlainTextDraw: 0x00A86510,
			BalloonPlainTextDrawCallSites: [0x0085E209],
			BalloonStyledTextDraw: 0x00A84E30,
			BalloonStyledTextDrawCallSites: [0x0085E1E3],
			GetTickCountIat: 0x010C7254,
			GetModuleHandleIat: 0x010C72B0,
			GetProcAddressIat: 0x010C7228
		}
	},
	ActiveBuildDate: 0,
	PacketId: 0x0BDD,
	PacketMagic: 0x49434F4C,
	PacketMax: 4092,
	// The protected 2026 image cannot grow. A 256-entry bounded table fits
	// its existing .xdiff cave and retains the first 256 valid
	// records if a server sends an unusually dense 4092-byte packet.
	TableCapacity: 256,
	NameCapacity: 128,
	EntrySize: 0x8C,
	EntryColor: 0,
	EntryLength: 4,
	EntryFlags: 8,
	EntryName: 12,
	EntryGrade: 1,
	StateCount: 0,
	StatePreviousTextOut: 4,
	StateContinuationColor: 8,
	StateContinuationHdc: 12,
	StateContinuationX: 16,
	StateContinuationY: 20,
	StateContinuationTick: 24,
	StateContinuationValid: 28,
	StateBalloonBypass: 32,
	StateGetTextAlign: 36,
	StateSetTextAlign: 40,
	StateSize: 44,
	AnsiScratchSize: 512,
	ContinuationMs: 150,
	GroundItemName: 0x158,
	GroundItemNameLength: 0x168,
	GroundItemNameCapacity: 0x16C,
	TooltipCenterColor: 0x90,
	BalloonTextMax: 255
};

ItemColorStatic.selectProfile = function()
{
	const profileId = RagexeClientProfile.Id;
	const profile = ItemColorStatic.Profiles[profileId];
	if (!profile)
		throw Error(`ItemColorStatic does not support client profile ${profileId}`);
	if (ItemColorStatic.ActiveBuildDate === profileId)
		return profile;

	for (const key in profile)
		ItemColorStatic[key] = profile[key];
	ItemColorStatic.ActiveBuildDate = profileId;
	return profile;
};

ItemColorStatic.allocateCode = function(assembler)
{
	return ExtNameTextStatic.allocateCode(assembler);
};

ItemColorStatic.callIat = function(a, iat)
{
	a.emit(0xFF, 0x15); a.dword(iat);
};

ItemColorStatic.buildDrain = function(icolVir, stateVir, tableVir)
{
	const a = ExtNameStaticAsm.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x18, 0x53, 0x56, 0x57);
	a.emit(0x83, 0x3D); a.dword(icolVir + 4); a.emit(0x01);
	a.jcc(0x85, "done");
	// Claim the single-slot packet before parsing so malformed data cannot
	// stall later client packets or be reparsed on every draw.
	a.emit(0xC7, 0x05); a.dword(icolVir + 4); a.dword(0);
	a.emit(0x81, 0x3D); a.dword(icolVir); a.dword(ItemColorStatic.PacketMagic);
	a.jcc(0x85, "done");
	a.emit(0xA1); a.dword(icolVir + 8);
	a.emit(0x83, 0xF8, 0x08);
	a.jcc(0x82, "done");
	a.emit(0x3D); a.dword(ItemColorStatic.PacketMax);
	a.jcc(0x87, "done");
	a.emit(0xBE); a.dword(icolVir + 12);
	a.emit(0x8D, 0x14, 0x06, 0x89, 0x55, 0xF0); // packet end
	a.emit(0x66, 0x81, 0x3E); a.emit(ItemColorStatic.PacketId & 0xFF,
		(ItemColorStatic.PacketId >>> 8) & 0xFF);
	a.jcc(0x85, "done");
	a.emit(0x0F, 0xB7, 0x56, 0x02, 0x3B, 0xD0);
	a.jcc(0x85, "done");
	a.emit(0x8B, 0x4E, 0x04, 0x89, 0x4D, 0xFC);
	a.emit(0xC7, 0x45, 0xF8); a.dword(0);
	a.emit(0xC7, 0x05); a.dword(stateVir + ItemColorStatic.StateCount); a.dword(0);
	a.emit(0x83, 0xC6, 0x08);
	a.label("entry_loop");
	a.emit(0x83, 0x7D, 0xFC, 0x00);
	a.jcc(0x84, "publish");
	a.emit(0x8D, 0x46, 0x02, 0x3B, 0x45, 0xF0);
	a.jcc(0x87, "publish");
	a.emit(0x0F, 0xB7, 0x1E, 0x83, 0xC6, 0x02);
	a.emit(0x85, 0xDB);
	a.jcc(0x84, "publish");
	a.emit(0x8D, 0x44, 0x1E, 0x04, 0x3B, 0x45, 0xF0);
	a.jcc(0x87, "publish");
	a.emit(0x89, 0x45, 0xF4); // next entry
	a.emit(0x80, 0x7C, 0x1E, 0xFF, 0x00);
	a.jcc(0x85, "advance");
	a.emit(0x81, 0x7D, 0xF8); a.dword(ItemColorStatic.TableCapacity);
	a.jcc(0x83, "advance");
	a.emit(0x81, 0xFB); a.dword(ItemColorStatic.NameCapacity);
	a.jcc(0x87, "advance");

	// Convert server 0x00RRGGBB to Win32 COLORREF 0x00BBGGRR.
	a.emit(0x8B, 0x14, 0x1E, 0x8B, 0xC2, 0xC1, 0xE8, 0x10);
	a.emit(0x25); a.dword(0xFF);
	a.emit(0x8B, 0xCA, 0x81, 0xE1); a.dword(0xFF00);
	a.emit(0x81, 0xE2); a.dword(0xFF);
	a.emit(0xC1, 0xE2, 0x10, 0x0B, 0xC1, 0x0B, 0xC2, 0x89, 0x45, 0xEC);

	// Normal entries store the UTF-8 item substring. Grade sentinels use
	// _GRADE_<n>_<label>; store only <label>, which matches [Label] draws.
	a.emit(0x8B, 0xD6, 0x8B, 0xCB, 0x49, 0x33, 0xC0); // src,len,flags=0
	a.emit(0x83, 0xFB, 0x09);
	a.jcc(0x82, "have_name");
	a.emit(0x81, 0x3E); a.dword(0x4152475F); // _GRA
	a.jcc(0x85, "have_name");
	a.emit(0x81, 0x7E, 0x03); a.dword(0x5F454441); // ADE_
	a.jcc(0x85, "have_name");
	a.emit(0x8D, 0x56, 0x07, 0x8D, 0x4C, 0x1E, 0xFF); // scan,end-without-NUL
	a.label("grade_scan");
	a.emit(0x3B, 0xD1);
	a.jcc(0x83, "advance");
	a.emit(0x80, 0x3A, 0x5F);
	a.jcc(0x84, "grade_label");
	a.emit(0x42);
	a.jmp("grade_scan");
	a.label("grade_label");
	a.emit(0x42, 0x3B, 0xD1);
	a.jcc(0x83, "advance");
	a.emit(0x2B, 0xCA, 0xB8); a.dword(ItemColorStatic.EntryGrade);
	a.label("have_name");
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "advance");
	a.emit(0x81, 0xF9); a.dword(ItemColorStatic.NameCapacity - 1);
	a.jcc(0x87, "advance");

	a.emit(0x8B, 0x7D, 0xF8, 0x69, 0xFF); a.dword(ItemColorStatic.EntrySize);
	a.emit(0x81, 0xC7); a.dword(tableVir);
	a.emit(0x8B, 0x5D, 0xEC, 0x89, 0x5F, ItemColorStatic.EntryColor);
	a.emit(0x89, 0x4F, ItemColorStatic.EntryLength);
	a.emit(0x89, 0x47, ItemColorStatic.EntryFlags);
	a.emit(0x53, 0x56); // preserve packet length and packet cursor
	a.emit(0x8B, 0xF2, 0x8D, 0x7F, ItemColorStatic.EntryName);
	a.emit(0xF3, 0xA4, 0xC6, 0x07, 0x00);
	a.emit(0x5E, 0x5B);
	a.emit(0xFF, 0x45, 0xF8);
	a.label("advance");
	a.emit(0x8B, 0x75, 0xF4, 0xFF, 0x4D, 0xFC);
	a.jmp("entry_loop");
	a.label("publish");
	a.emit(0x8B, 0x45, 0xF8, 0xA3); a.dword(stateVir + ItemColorStatic.StateCount);
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

ItemColorStatic.buildLookup = function(stateVir, tableVir)
{
	const a = ExtNameStaticAsm.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x0C, 0x53, 0x56, 0x57);
	a.emit(0xA1); a.dword(stateVir + ItemColorStatic.StateCount);
	a.emit(0x89, 0x45, 0xFC, 0xBF); a.dword(tableVir);
	a.label("entry_loop");
	a.emit(0x83, 0x7D, 0xFC, 0x00);
	a.jcc(0x84, "not_found");

	// Lookup mode 1 accepts grade sentinels only. Modes 0 and 2 accept complete
	// normal item-title shapes with known client decorations; neither permits
	// a packet name to float inside a different item name.
	a.emit(0x8B, 0x47, ItemColorStatic.EntryFlags);
	a.emit(0xA9); a.dword(ItemColorStatic.EntryGrade);
	a.jcc(0x84, "normal_entry");
	a.emit(0x83, 0x7D, 0x10, 0x01);
	a.jcc(0x85, "next_entry");

	// Grade labels are valid only as the leading token [<label>]. Substring
	// matching made ordinary headings such as [Shoes Description] eligible.
	a.emit(0x8B, 0x57, ItemColorStatic.EntryLength, 0x85, 0xD2);
	a.jcc(0x84, "next_entry");
	a.emit(0x8B, 0xC2, 0x83, 0xC0, 0x02, 0x3B, 0x45, 0x0C);
	a.jcc(0x87, "next_entry");
	a.emit(0x8B, 0x75, 0x08, 0x80, 0x3E, 0x5B);
	a.jcc(0x85, "next_entry");
	a.emit(0x46, 0x8D, 0x5F, ItemColorStatic.EntryName, 0x8B, 0xCA);
	a.label("grade_compare");
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "grade_close");
	a.emit(0x8A, 0x06, 0x3A, 0x03);
	a.jcc(0x85, "next_entry");
	a.emit(0x46, 0x43, 0x49);
	a.jmp("grade_compare");
	a.label("grade_close");
	a.emit(0x80, 0x3E, 0x5D);
	a.jcc(0x85, "next_entry");
	// If the formatter emitted more than [Label], the token must be followed
	// by its normal separating space.
	a.emit(0x8B, 0x45, 0x0C, 0x2B, 0xC2, 0x83, 0xF8, 0x02);
	a.jcc(0x84, "found");
	a.emit(0x80, 0x7E, 0x01, 0x20);
	a.jcc(0x84, "found");
	a.jmp("next_entry");

	a.label("normal_entry");
	a.emit(0x8B, 0x45, 0x10, 0x83, 0xF8, 0x01);
	a.jcc(0x84, "next_entry");
	a.emit(0x83, 0xF8, 0x02);
	a.jcc(0x87, "next_entry");
	a.emit(0x8B, 0x75, 0x08, 0x8B, 0x4D, 0x0C);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "next_entry");

	// Accept an optional stock grade token "[Label] " before the item name.
	a.emit(0x80, 0x3E, 0x5B);
	a.jcc(0x85, "refine_probe");
	a.emit(0x46, 0x49);
	a.label("grade_prefix_scan");
	a.emit(0x83, 0xF9, 0x02);
	a.jcc(0x82, "next_entry");
	a.emit(0x80, 0x3E, 0x5D);
	a.jcc(0x84, "grade_prefix_close");
	a.emit(0x46, 0x49);
	a.jmp("grade_prefix_scan");
	a.label("grade_prefix_close");
	a.emit(0x80, 0x7E, 0x01, 0x20);
	a.jcc(0x85, "next_entry");
	a.emit(0x83, 0xC6, 0x02, 0x83, 0xE9, 0x02);

	// Accept the stock equipment-name decoration +<digits><space> without
	// permitting the item name to float inside arbitrary UI prose.
	a.label("refine_probe");
	a.emit(0x80, 0x3E, 0x2B);
	a.jcc(0x85, "normal_candidate");
	a.emit(0x83, 0xF9, 0x03);
	a.jcc(0x82, "normal_candidate");
	a.emit(0x8A, 0x46, 0x01, 0x3C, 0x30);
	a.jcc(0x82, "normal_candidate");
	a.emit(0x3C, 0x39);
	a.jcc(0x87, "normal_candidate");
	a.emit(0x83, 0xC6, 0x02, 0x83, 0xE9, 0x02);
	a.label("refine_prefix");
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "next_entry");
	a.emit(0x8A, 0x06, 0x3C, 0x30);
	a.jcc(0x82, "refine_space");
	a.emit(0x3C, 0x39);
	a.jcc(0x87, "refine_space");
	a.emit(0x46, 0x49);
	a.jmp("refine_prefix");
	a.label("refine_space");
	a.emit(0x3C, 0x20);
	a.jcc(0x85, "next_entry");
	a.emit(0x46, 0x49);

	a.label("normal_candidate");
	a.emit(0x89, 0x4D, 0xF8);
	a.emit(0x8B, 0x57, ItemColorStatic.EntryLength, 0x85, 0xD2);
	a.jcc(0x84, "next_entry");
	a.emit(0x3B, 0xD1);
	a.jcc(0x87, "next_entry");
	a.emit(0x8D, 0x5F, ItemColorStatic.EntryName, 0x8B, 0xCA);
	a.label("normal_compare");
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "normal_suffix");
	a.emit(0x8A, 0x06, 0x3A, 0x03);
	a.jcc(0x85, "next_entry");
	a.emit(0x46, 0x43, 0x49);
	a.jmp("normal_compare");

	a.label("normal_suffix");
	a.emit(0x8B, 0x4D, 0xF8, 0x2B, 0xCA);
	a.jcc(0x84, "found");
	// Accept only the two stock item-title suffixes: numeric slots " [<n>]"
	// and item-balloon quantities " <count> ea.".
	a.emit(0x83, 0xF9, 0x04);
	a.jcc(0x82, "next_entry");
	a.emit(0x80, 0x3E, 0x20);
	a.jcc(0x85, "next_entry");
	a.emit(0x80, 0x7E, 0x01, 0x5B);
	a.jcc(0x84, "slot_suffix");

	// Quantity suffix: one or more digits followed by the exact " ea." tail.
	a.emit(0x83, 0xF9, 0x06);
	a.jcc(0x82, "next_entry");
	a.emit(0x8A, 0x46, 0x01, 0x3C, 0x30);
	a.jcc(0x82, "next_entry");
	a.emit(0x3C, 0x39);
	a.jcc(0x87, "next_entry");
	a.emit(0x46, 0x49);
	a.label("quantity_digits");
	a.emit(0x83, 0xF9, 0x04);
	a.jcc(0x86, "quantity_tail");
	a.emit(0x8A, 0x06, 0x3C, 0x30);
	a.jcc(0x82, "quantity_tail");
	a.emit(0x3C, 0x39);
	a.jcc(0x87, "quantity_tail");
	a.emit(0x46, 0x49);
	a.jmp("quantity_digits");
	a.label("quantity_tail");
	a.emit(0x83, 0xF9, 0x04);
	a.jcc(0x85, "next_entry");
	a.emit(0x81, 0x3E); a.dword(0x2E616520); // " ea."
	a.jcc(0x84, "found");
	a.jmp("next_entry");

	a.label("slot_suffix");
	a.emit(0x83, 0xC6, 0x02, 0x83, 0xE9, 0x02);
	a.emit(0x83, 0xF9, 0x02);
	a.jcc(0x82, "next_entry");
	a.emit(0x8A, 0x06, 0x3C, 0x30);
	a.jcc(0x82, "next_entry");
	a.emit(0x3C, 0x39);
	a.jcc(0x87, "next_entry");
	a.emit(0x46, 0x49);
	a.label("slot_digits");
	a.emit(0x83, 0xF9, 0x01);
	a.jcc(0x82, "next_entry");
	a.emit(0x80, 0x3E, 0x5D);
	a.jcc(0x84, "slot_close");
	a.emit(0x8A, 0x06, 0x3C, 0x30);
	a.jcc(0x82, "next_entry");
	a.emit(0x3C, 0x39);
	a.jcc(0x87, "next_entry");
	a.emit(0x46, 0x49);
	a.jmp("slot_digits");
	a.label("slot_close");
	a.emit(0x46, 0x49);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "found");
	// Inventory hover labels combine both decorations as
	// "<name> [slots]: <count> ea.".
	a.emit(0x83, 0xF9, 0x07);
	a.jcc(0x82, "next_entry");
	a.emit(0x66, 0x81, 0x3E, 0x3A, 0x20); // ": "
	a.jcc(0x85, "next_entry");
	a.emit(0x83, 0xC6, 0x02, 0x83, 0xE9, 0x02);
	a.emit(0x83, 0xF9, 0x05);
	a.jcc(0x82, "next_entry");
	a.emit(0x8A, 0x06, 0x3C, 0x30);
	a.jcc(0x82, "next_entry");
	a.emit(0x3C, 0x39);
	a.jcc(0x87, "next_entry");
	a.jmp("quantity_digits");

	a.label("next_entry");
	a.emit(0x81, 0xC7); a.dword(ItemColorStatic.EntrySize);
	a.emit(0xFF, 0x4D, 0xFC);
	a.jmp("entry_loop");
	a.label("found");
	a.emit(0x8B, 0xC7);
	a.jmp("return");
	a.label("not_found");
	a.emit(0x33, 0xC0);
	a.label("return");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

ItemColorStatic.buildContinuationLookup = function(stateVir, getTickCountIat)
{
	const a = ExtNameStaticAsm.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.emit(0x83, 0x3D); a.dword(stateVir + ItemColorStatic.StateContinuationValid); a.emit(0x00);
	a.jcc(0x84, "invalid");
	a.emit(0x8B, 0x45, 0x08, 0x3B, 0x05); a.dword(stateVir + ItemColorStatic.StateContinuationHdc);
	a.jcc(0x85, "invalid");
	ItemColorStatic.callIat(a, getTickCountIat);
	a.emit(0x2B, 0x05); a.dword(stateVir + ItemColorStatic.StateContinuationTick);
	a.emit(0x3D); a.dword(ItemColorStatic.ContinuationMs);
	a.jcc(0x87, "invalid");

	// Wrapped continuation: approximately same X, next line within 22 pixels.
	a.emit(0x8B, 0x5D, 0x0C, 0x2B, 0x1D); a.dword(stateVir + ItemColorStatic.StateContinuationX);
	a.emit(0x8B, 0xF3, 0xC1, 0xFE, 0x1F, 0x33, 0xDE, 0x2B, 0xDE);
	a.emit(0x83, 0xFB, 0x02);
	a.jcc(0x87, "same_line");
	a.emit(0x8B, 0x45, 0x10, 0x2B, 0x05); a.dword(stateVir + ItemColorStatic.StateContinuationY);
	a.emit(0x85, 0xC0);
	a.jcc(0x8E, "same_line");
	a.emit(0x83, 0xF8, 0x16);
	a.jcc(0x86, "valid");
	a.label("same_line");
	// Same-line continuation: approximately same Y and up to 120 px right.
	a.emit(0x8B, 0x5D, 0x10, 0x2B, 0x1D); a.dword(stateVir + ItemColorStatic.StateContinuationY);
	a.emit(0x8B, 0xF3, 0xC1, 0xFE, 0x1F, 0x33, 0xDE, 0x2B, 0xDE);
	a.emit(0x83, 0xFB, 0x02);
	a.jcc(0x87, "invalid");
	a.emit(0x8B, 0x45, 0x0C, 0x2B, 0x05); a.dword(stateVir + ItemColorStatic.StateContinuationX);
	a.emit(0x85, 0xC0);
	a.jcc(0x8E, "invalid");
	a.emit(0x83, 0xF8, 0x78);
	a.jcc(0x87, "invalid");
	a.label("valid");
	a.emit(0xA1); a.dword(stateVir + ItemColorStatic.StateContinuationColor);
	a.jmp("return");
	a.label("invalid");
	a.emit(0xB8); a.dword(0xFFFFFFFF);
	a.label("return");
	a.emit(0x5F, 0x5E, 0x5B, 0x5D, 0xC3);
	return a;
};

ItemColorStatic.buildItemTooltip = function(
	drainVir,
	lookupVir,
	gradeColorsEnabled
)
{
	const a = ExtNameStaticAsm.asm();
	// Inventory and equipment producers pass the complete ANSI hover label and
	// an RGB color to A753D0. Match only their exact callsites, replace that RGB
	// argument, and tail-jump so the stock constructor still creates both the
	// center and outline passes.
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x51);
	a.call(drainVir);
	a.emit(0x8B, 0x75, 0x08, 0x85, 0xF6); // esi = ANSI item label
	a.jcc(0x84, "passthrough");
	a.emit(0x33, 0xC9);
	a.label("scan_loop");
	a.emit(0x81, 0xF9); a.dword(ItemColorStatic.BalloonTextMax);
	a.jcc(0x83, "passthrough");
	a.emit(0x80, 0x3C, 0x0E, 0x00);
	a.jcc(0x84, "have_length");
	a.emit(0x41);
	a.jmp("scan_loop");

	a.label("have_length");
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "passthrough");
	if (!gradeColorsEnabled)
	{
		// Item-only v10 leaves every decorated [Grade] title entirely stock.
		a.emit(0x80, 0x3E, 0x5B);
		a.jcc(0x84, "passthrough");
	}
	a.emit(0x8B, 0xF9);
	if (gradeColorsEnabled)
	{
		// The stock producer owns this complete styled label. An exact leading
		// grade token overrides the normal item entry for the entire span.
		a.emit(0x6A, 0x01, 0x57, 0x56);
		a.call(lookupVir);
		a.emit(0x83, 0xC4, 0x0C, 0x85, 0xC0);
		a.jcc(0x85, "matched");
	}
	a.emit(0x6A, 0x02, 0x57, 0x56);
	a.call(lookupVir);
	a.emit(0x83, 0xC4, 0x0C, 0x85, 0xC0);
	a.jcc(0x84, "passthrough");
	if (gradeColorsEnabled)
		a.label("matched");
	a.emit(0x8B, 0x00); // ICOL table stores Win32 COLORREF 0x00BBGGRR
	// A753D0 accepts 0x00RRGGBB and converts it to COLORREF internally.
	a.emit(0x8B, 0xD0, 0x81, 0xE2); a.dword(0xFF);
	a.emit(0xC1, 0xE2, 0x10);
	a.emit(0x8B, 0xD8, 0x81, 0xE3); a.dword(0xFF00);
	a.emit(0xC1, 0xE8, 0x10, 0x25); a.dword(0xFF);
	a.emit(0x0B, 0xC3, 0x0B, 0xC2, 0x89, 0x45, 0x14);

	a.label("passthrough");
	a.emit(0x59, 0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D);
	a.jmp(ItemColorStatic.ItemTooltipShow);
	return a;
};

ItemColorStatic.buildGroundTooltip = function(
	drainVir,
	lookupVir,
	gradeColorsEnabled
)
{
	const a = ExtNameStaticAsm.asm();
	// The world-hover producer passes its new balloon as arg1 and CItem as arg2
	// to C72CE0. Read CItem's MSVC std::string at +158, recolor only the
	// balloon's center field at +90, then preserve the stock projection path.
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x51);
	a.call(drainVir);
	a.emit(0x8B, 0x5D, 0x0C, 0x85, 0xDB); // ebx = CItem
	a.jcc(0x84, "passthrough");
	a.emit(0x8B, 0x8B); a.dword(ItemColorStatic.GroundItemNameLength);
	a.emit(0x85, 0xC9);
	a.jcc(0x84, "passthrough");
	a.emit(0x81, 0xF9); a.dword(ItemColorStatic.BalloonTextMax);
	a.jcc(0x87, "passthrough");
	a.emit(0x8D, 0xB3); a.dword(ItemColorStatic.GroundItemName);
	a.emit(0x83, 0xBB); a.dword(ItemColorStatic.GroundItemNameCapacity); a.emit(0x10);
	a.jcc(0x82, "have_text");
	a.emit(0x8B, 0xB3); a.dword(ItemColorStatic.GroundItemName);
	a.label("have_text");
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "passthrough");
	if (!gradeColorsEnabled)
	{
		a.emit(0x80, 0x3E, 0x5B);
		a.jcc(0x84, "passthrough");
	}
	a.emit(0x8B, 0xF9);
	if (gradeColorsEnabled)
	{
		a.emit(0x6A, 0x01, 0x57, 0x56);
		a.call(lookupVir);
		a.emit(0x83, 0xC4, 0x0C, 0x85, 0xC0);
		a.jcc(0x85, "matched");
	}
	a.emit(0x6A, 0x02, 0x57, 0x56);
	a.call(lookupVir);
	a.emit(0x83, 0xC4, 0x0C, 0x85, 0xC0);
	a.jcc(0x84, "passthrough");
	if (gradeColorsEnabled)
		a.label("matched");
	a.emit(0x8B, 0x00, 0x8B, 0x55, 0x08, 0x85, 0xD2);
	a.jcc(0x84, "passthrough");
	a.emit(0x89, 0x82); a.dword(ItemColorStatic.TooltipCenterColor);

	a.label("passthrough");
	a.emit(0x59, 0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D);
	a.jmp(ItemColorStatic.GroundTooltipProject);
	return a;
};

ItemColorStatic.buildBalloonTextScope = function(stateVir, stockDrawVir, argBytes)
{
	const a = ExtNameStaticAsm.asm();
	// The semantic producer owns item-balloon colors. Scope the generic
	// TextOutW item bridge out for both 8263A0 draw branches so the stock helper
	// can render its native black shadow and already-colored center unchanged.
	a.emit(0x55, 0x8B, 0xEC, 0x51); // receiver in [ebp-4]
	a.emit(0xFF, 0x05); a.dword(stateVir + ItemColorStatic.StateBalloonBypass);
	for (let offset = argBytes + 4; offset >= 8; offset -= 4)
		a.emit(0xFF, 0x75, offset);
	a.emit(0x8B, 0x4D, 0xFC);
	a.call(stockDrawVir);
	a.emit(0xFF, 0x0D); a.dword(stateVir + ItemColorStatic.StateBalloonBypass);
	a.emit(0x8B, 0xE5, 0x5D, 0xC2, argBytes & 0xFF, (argBytes >>> 8) & 0xFF);
	return a;
};

ItemColorStatic.buildTextOut = function(
	stateVir,
	drainVir,
	lookupVir,
	continuationVir,
	ansiScratchVir,
	previousTextOutVir,
	entityFindWideVir,
	apis,
	emojiTokensEnabled,
	gradeColorsEnabled
)
{
	const a = ExtNameStaticAsm.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x40, 0x53, 0x56, 0x57);
	a.emit(0xC7, 0x45, 0xF4); a.dword(0);          // old color valid
	a.emit(0xC7, 0x45, 0xE8); a.dword(0);          // TextOutW result
	a.emit(0xC7, 0x45, 0xE4); a.dword(0xFFFFFFFF); // grade COLORREF
	a.emit(0xC7, 0x45, 0xE0); a.dword(0xFFFFFFFF); // item COLORREF
	a.emit(0xC7, 0x45, 0xDC); a.dword(0);          // grade prefix chars
	a.emit(0x83, 0x3D); a.dword(stateVir + ItemColorStatic.StateBalloonBypass); a.emit(0x00);
	a.jcc(0x84, "item_text_bridge");
	if (gradeColorsEnabled)
	{
		// Inventory, equipment, and ground balloons already received one
		// grade-priority center color from their semantic producers. Preserve
		// their stock single-span outline and suffix rendering verbatim.
		a.jmp("draw");
	}
	else
	{
		// The item-only build may split a decorated name so the grade token
		// retains its stock color while the exact base item uses ICOL.
		a.emit(0x83, 0x7D, 0x14, 0x00);
		a.jcc(0x84, "draw");
		a.emit(0x8B, 0x45, 0x14, 0x66, 0x83, 0x38, 0x5B);
		a.jcc(0x84, "item_text_bridge");
		a.jmp("draw");
	}
	a.label("item_text_bridge");
	a.call(drainVir);
	if (emojiTokensEnabled)
	{
		// Fluent Emoji labels are UI text, never item-name candidates. Let the
		// underlying emoji bridge own any span containing a complete @token@;
		// otherwise item matching can suppress the stock shadow pass and
		// prevent the label from reaching TextOutW at all.
		a.emit(0x8B, 0x75, 0x14, 0x85, 0xF6);       // esi = text
		a.jcc(0x84, "emoji_scan_done");
		a.emit(0x8B, 0x4D, 0x18, 0x85, 0xC9);       // ecx = count
		a.jcc(0x8E, "emoji_scan_done");
		a.emit(0x33, 0xD2);                         // edx = index
		a.label("emoji_scan_open");
		a.emit(0x3B, 0xD1);
		a.jcc(0x83, "emoji_scan_done");
		a.emit(0x66, 0x83, 0x3C, 0x56, 0x40);       // text[index] == '@'
		a.jcc(0x84, "emoji_scan_close_next");
		a.emit(0x42);
		a.jmp("emoji_scan_open");
		a.label("emoji_scan_close_next");
		a.emit(0x42);
		a.label("emoji_scan_close");
		a.emit(0x3B, 0xD1);
		a.jcc(0x83, "emoji_scan_done");
		a.emit(0x66, 0x83, 0x3C, 0x56, 0x40);
		a.jcc(0x84, "draw");
		a.emit(0x42);
		a.jmp("emoji_scan_close");
		a.label("emoji_scan_done");
	}
	// EXTN owns entity names and metadata rows. Exclude every exact EXTN key
	// before item-title matching so NPC titles such as
	// "[Reset Stats/Skills]" cannot collide with ICOL entries.
	a.emit(0x83, 0x7D, 0x14, 0x00);
	a.jcc(0x84, "draw");
	a.emit(0x8B, 0x45, 0x18, 0x85, 0xC0);
	a.jcc(0x8E, "draw");
	a.emit(0xFF, 0x75, 0x18, 0xFF, 0x75, 0x14);
	a.call(entityFindWideVir);
	a.emit(0x85, 0xC0);
	a.jcc(0x85, "draw");
	a.emit(0x83, 0x7D, 0x14, 0x00);
	a.jcc(0x84, "draw");
	a.emit(0x8B, 0x45, 0x18, 0x85, 0xC0);
	a.jcc(0x8E, "draw");
	a.emit(0x3D); a.dword(127);
	a.jcc(0x87, "draw");

	// Convert exactly the TextOutW span to bounded UTF-8 for packet-name matching.
	a.emit(0x6A, 0x00, 0x6A, 0x00, 0x68); a.dword(ItemColorStatic.AnsiScratchSize - 1);
	a.emit(0x68); a.dword(ansiScratchVir);
	a.emit(0xFF, 0x75, 0x18, 0xFF, 0x75, 0x14, 0x6A, 0x00, 0x68); a.dword(65001);
	ItemColorStatic.callIat(a, apis.wideToMulti);
	a.emit(0x85, 0xC0);
	a.jcc(0x8E, "draw");
	a.emit(0x89, 0x45, 0xEC, 0xBA); a.dword(ansiScratchVir);
	a.emit(0xC6, 0x04, 0x02, 0x00);

	// Item and grade are independent channels. Normal lookup accepts the
	// complete decorated title but returns only the exact base-item entry.
	a.emit(0x6A, 0x00);
	a.emit(0xFF, 0x75, 0xEC, 0x68); a.dword(ansiScratchVir);
	a.call(lookupVir);
	a.emit(0x83, 0xC4, 0x0C, 0x85, 0xC0);
	a.jcc(0x84, "grade_lookup");
	a.emit(0x8B, 0x00, 0x89, 0x45, 0xE0);

	a.label("grade_lookup");
	if (gradeColorsEnabled)
	{
		// Grade colors are opt-in. The companion patch enables this lookup;
		// without it, the prefix is always drawn in the stock COLORREF.
		a.emit(0x80, 0x3D); a.dword(ansiScratchVir); a.emit(0x5B);
		a.jcc(0x85, "lookup_complete");
		a.emit(0x6A, 0x01);
		a.emit(0xFF, 0x75, 0xEC, 0x68); a.dword(ansiScratchVir);
		a.call(lookupVir);
		a.emit(0x83, 0xC4, 0x0C, 0x85, 0xC0);
		a.jcc(0x84, "lookup_complete");
		a.emit(0x8B, 0x00, 0x89, 0x45, 0xE4);
	}
	a.label("lookup_complete");
	if (gradeColorsEnabled)
	{
		// Grade-enabled mode never fragments a client-owned styled string.
		// Grade wins. The description renderer may issue "[Grade]" and the
		// exact item name as adjacent calls, so carry grade only into a
		// following span that has already passed exact normal-item lookup.
		a.emit(0x83, 0x7D, 0xE4, 0xFF);
		a.jcc(0x85, "track_grade");
		a.emit(0x83, 0x7D, 0xE0, 0xFF);
		a.jcc(0x84, "draw");
		a.emit(0xFF, 0x75, 0x10, 0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08);
		a.call(continuationVir);
		a.emit(0x83, 0xC4, 0x0C, 0x83, 0xF8, 0xFF);
		a.jcc(0x84, "single_color");
		a.emit(0x89, 0x45, 0xE4);
		a.jmp("single_color");

		a.label("track_grade");
		a.emit(0x8B, 0x45, 0xE4, 0xA3);
		a.dword(stateVir + ItemColorStatic.StateContinuationColor);
		a.emit(0x8B, 0x45, 0x08, 0xA3);
		a.dword(stateVir + ItemColorStatic.StateContinuationHdc);
		a.emit(0x8B, 0x45, 0x0C, 0xA3);
		a.dword(stateVir + ItemColorStatic.StateContinuationX);
		a.emit(0x8B, 0x45, 0x10, 0xA3);
		a.dword(stateVir + ItemColorStatic.StateContinuationY);
		ItemColorStatic.callIat(a, apis.getTickCount);
		a.emit(0xA3);
		a.dword(stateVir + ItemColorStatic.StateContinuationTick);
		a.emit(0xC7, 0x05);
		a.dword(stateVir + ItemColorStatic.StateContinuationValid);
		a.dword(1);
		a.jmp("single_color");
	}
	else
	{
		a.emit(0x83, 0x7D, 0xE0, 0xFF);
		a.jcc(0x85, "split_probe");
		a.emit(0x83, 0x7D, 0xE4, 0xFF);
		a.jcc(0x84, "draw");
	}

	// Split only the canonical stock prefix "[Label] ". The prefix includes
	// its separating space; the base item begins at the following UTF-16 code
	// unit and retains an independent exact item lookup.
	a.label("split_probe");
	a.emit(0x8B, 0x75, 0x14, 0x85, 0xF6);
	a.jcc(0x84, "single_color");
	a.emit(0x66, 0x83, 0x3E, 0x5B);
	a.jcc(0x85, "single_color");
	a.emit(0x8B, 0x4D, 0x18, 0x33, 0xD2);
	a.label("split_scan");
	a.emit(0x3B, 0xD1);
	a.jcc(0x83, "single_color");
	a.emit(0x66, 0x83, 0x3C, 0x56, 0x5D);
	a.jcc(0x85, "split_next");
	a.emit(0x8D, 0x42, 0x01, 0x3B, 0xC1);
	a.jcc(0x83, "single_color");
	a.emit(0x66, 0x83, 0x7C, 0x56, 0x02, 0x20);
	a.jcc(0x85, "single_color");
	a.emit(0x83, 0xC2, 0x02, 0x3B, 0xD1);
	a.jcc(0x83, "single_color");
	a.emit(0x89, 0x55, 0xDC);
	a.jmp("split_color");
	a.label("split_next");
	a.emit(0x42);
	a.jmp("split_scan");

	a.label("split_color");
	// SetTextColor returns the original COLORREF. Capture it with whichever
	// custom channel is present so an absent grade/item channel can stay stock.
	a.emit(0x8B, 0x5D, 0xE4, 0x83, 0xFB, 0xFF);
	a.jcc(0x85, "split_capture");
	a.emit(0x8B, 0x5D, 0xE0);
	a.label("split_capture");
	a.emit(0x53, 0xFF, 0x75, 0x08);
	ItemColorStatic.callIat(a, apis.setTextColor);
	a.emit(0x89, 0x45, 0xF0);
	a.emit(0x8B, 0xD0, 0x81, 0xE2); a.dword(0xFF);
	a.emit(0x83, 0xFA, 0x20);
	a.jcc(0x87, "split_foreground");
	a.emit(0x8B, 0xD0, 0xC1, 0xEA, 0x08, 0x81, 0xE2); a.dword(0xFF);
	a.emit(0x83, 0xFA, 0x20);
	a.jcc(0x87, "split_foreground");
	a.emit(0xC1, 0xE8, 0x10, 0x25); a.dword(0xFF);
	a.emit(0x83, 0xF8, 0x20);
	a.jcc(0x87, "split_foreground");
	// Preserve the stock dark outline inside semantic item balloons; other UI
	// surfaces keep the established thin title rendering.
	a.emit(0xFF, 0x75, 0xF0, 0xFF, 0x75, 0x08);
	ItemColorStatic.callIat(a, apis.setTextColor);
	a.emit(0x83, 0x3D); a.dword(stateVir + ItemColorStatic.StateBalloonBypass); a.emit(0x00);
	a.jcc(0x85, "draw");
	a.jmp("shadow_done");

	a.label("split_foreground");
	if (!gradeColorsEnabled)
	{
		// Preserve the archived item-only v10 layout. Item balloons are centered
		// by their semantic producer; other title surfaces use the stock X.
		a.emit(0x8D, 0x45, 0xD8, 0x50, 0xFF, 0x75, 0xDC,
			0xFF, 0x75, 0x14, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.extent);
		a.emit(0x83, 0x3D);
		a.dword(stateVir + ItemColorStatic.StateBalloonBypass);
		a.emit(0x00);
		a.jcc(0x84, "legacy_split_draw");
		a.emit(0x8D, 0x45, 0xD0, 0x50, 0xFF, 0x75, 0x18,
			0xFF, 0x75, 0x14, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.extent);

		a.label("legacy_split_draw");
		a.emit(0x8B, 0x5D, 0xE4, 0x83, 0xFB, 0xFF);
		a.jcc(0x85, "legacy_split_grade_color");
		a.emit(0x8B, 0x5D, 0xF0);
		a.label("legacy_split_grade_color");
		a.emit(0x53, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.setTextColor);
		a.emit(0xFF, 0x75, 0xDC, 0xFF, 0x75, 0x14, 0xFF, 0x75, 0x10);
		a.emit(0x83, 0x3D);
		a.dword(stateVir + ItemColorStatic.StateBalloonBypass);
		a.emit(0x00);
		a.jcc(0x84, "legacy_split_prefix_stock_x");
		a.emit(0x8B, 0x45, 0x0C, 0x8B, 0x55, 0xD0, 0xD1, 0xFA);
		a.emit(0x2B, 0xC2, 0x8B, 0x55, 0xD8, 0xD1, 0xFA, 0x03, 0xC2);
		a.jmp("legacy_split_prefix_x_ready");
		a.label("legacy_split_prefix_stock_x");
		a.emit(0x8B, 0x45, 0x0C);
		a.label("legacy_split_prefix_x_ready");
		a.emit(0x50, 0xFF, 0x75, 0x08);
		a.call(previousTextOutVir);

		a.emit(0x8B, 0x5D, 0xE0, 0x83, 0xFB, 0xFF);
		a.jcc(0x85, "legacy_split_item_color");
		a.emit(0x8B, 0x5D, 0xF0);
		a.label("legacy_split_item_color");
		a.emit(0x53, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.setTextColor);
		a.emit(0x8B, 0x45, 0xDC, 0x8B, 0x4D, 0x18, 0x2B, 0xC8, 0x51);
		a.emit(0x8B, 0x55, 0x14, 0x8D, 0x14, 0x42, 0x52);
		a.emit(0xFF, 0x75, 0x10);
		a.emit(0x83, 0x3D);
		a.dword(stateVir + ItemColorStatic.StateBalloonBypass);
		a.emit(0x00);
		a.jcc(0x84, "legacy_split_item_stock_x");
		a.emit(0x8B, 0x45, 0x0C, 0x8B, 0x55, 0xD8, 0xD1, 0xFA, 0x03, 0xC2);
		a.jmp("legacy_split_item_x_ready");
		a.label("legacy_split_item_stock_x");
		a.emit(0x8B, 0x45, 0x0C, 0x03, 0x45, 0xD8);
		a.label("legacy_split_item_x_ready");
		a.emit(0x50, 0xFF, 0x75, 0x08);
		a.call(previousTextOutVir);
		a.emit(0x89, 0x45, 0xE8);
		a.emit(0xFF, 0x75, 0xF0, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.setTextColor);
		a.jmp("return");
	}
	else
	{
		// Measure the prefix and complete source span before changing alignment.
		a.emit(0x8D, 0x45, 0xD8, 0x50, 0xFF, 0x75, 0xDC,
			0xFF, 0x75, 0x14, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.extent);
		a.emit(0x8D, 0x45, 0xD0, 0x50, 0xFF, 0x75, 0x18,
			0xFF, 0x75, 0x14, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.extent);

		// Resolve GetTextAlign/SetTextAlign lazily from the already-loaded GDI32
		// module. The protected 2026 image does not import either API and cannot
		// safely grow its import table.
		a.emit(0x83, 0x3D);
		a.dword(stateVir + ItemColorStatic.StateGetTextAlign);
		a.emit(0x00);
		a.jcc(0x84, "split_align_resolve");
		a.emit(0x83, 0x3D);
		a.dword(stateVir + ItemColorStatic.StateSetTextAlign);
		a.emit(0x00);
		a.jcc(0x85, "split_align_ready");
		a.label("split_align_resolve");
		a.emit(0x68); a.dword(apis.gdiModuleNameVir);
		ItemColorStatic.callIat(a, apis.getModuleHandle);
		a.emit(0x85, 0xC0);
		a.jcc(0x84, "split_align_fallback");
		a.emit(0x8B, 0xD8);
		a.emit(0x68); a.dword(apis.getTextAlignNameVir);
		a.emit(0x53);
		ItemColorStatic.callIat(a, apis.getProcAddress);
		a.emit(0x85, 0xC0);
		a.jcc(0x84, "split_align_fallback");
		a.emit(0xA3);
		a.dword(stateVir + ItemColorStatic.StateGetTextAlign);
		a.emit(0x68); a.dword(apis.setTextAlignNameVir);
		a.emit(0x53);
		ItemColorStatic.callIat(a, apis.getProcAddress);
		a.emit(0x85, 0xC0);
		a.jcc(0x84, "split_align_fallback");
		a.emit(0xA3);
		a.dword(stateVir + ItemColorStatic.StateSetTextAlign);

		// Convert the caller's true TA_LEFT/TA_RIGHT/TA_CENTER reference point to
		// a physical left edge, then temporarily force TA_LEFT for both spans.
		a.label("split_align_ready");
		a.emit(0xFF, 0x75, 0x08, 0xFF, 0x15);
		a.dword(stateVir + ItemColorStatic.StateGetTextAlign);
		a.emit(0x83, 0xF8, 0xFF);
		a.jcc(0x84, "split_align_fallback");
		a.emit(0x89, 0x45, 0xC8);
		// TA_UPDATECP ignores the supplied X/Y; retain the stock whole-span draw
		// rather than guessing at the DC's current position.
		a.emit(0xA8, 0x01);
		a.jcc(0x85, "split_align_fallback");
		a.emit(0x8B, 0x4D, 0x0C, 0x83, 0xE0, 0x06);
		a.emit(0x83, 0xF8, 0x06);
		a.jcc(0x84, "split_align_center");
		a.emit(0x83, 0xF8, 0x02);
		a.jcc(0x84, "split_align_right");
		a.jmp("split_align_origin");
		a.label("split_align_center");
		a.emit(0x8B, 0x45, 0xD0, 0xD1, 0xF8, 0x2B, 0xC8);
		a.jmp("split_align_origin");
		a.label("split_align_right");
		a.emit(0x2B, 0x4D, 0xD0);
		a.label("split_align_origin");
		a.emit(0x89, 0x4D, 0xC4);
		a.emit(0x8B, 0x45, 0xC8, 0x83, 0xE0, 0xF8);
		a.emit(0x50, 0xFF, 0x75, 0x08, 0xFF, 0x15);
		a.dword(stateVir + ItemColorStatic.StateSetTextAlign);
		a.emit(0x83, 0xF8, 0xFF);
		a.jcc(0x84, "split_align_fallback");

		// Draw the grade prefix from the normalized left edge.
		a.emit(0x8B, 0x5D, 0xE4, 0x83, 0xFB, 0xFF);
		a.jcc(0x85, "split_grade_color");
		a.emit(0x8B, 0x5D, 0xF0);
		a.label("split_grade_color");
		a.emit(0x53, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.setTextColor);
		a.emit(0xFF, 0x75, 0xDC, 0xFF, 0x75, 0x14, 0xFF, 0x75, 0x10,
			0xFF, 0x75, 0xC4, 0xFF, 0x75, 0x08);
		a.call(previousTextOutVir);

		// Draw the remaining base item and suffix immediately after the prefix.
		a.emit(0x8B, 0x5D, 0xE0, 0x83, 0xFB, 0xFF);
		a.jcc(0x85, "split_item_color");
		a.emit(0x8B, 0x5D, 0xF0);
		a.label("split_item_color");
		a.emit(0x53, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.setTextColor);
		a.emit(0x8B, 0x45, 0xDC, 0x8B, 0x4D, 0x18, 0x2B, 0xC8, 0x51);
		a.emit(0x8B, 0x55, 0x14, 0x8D, 0x14, 0x42, 0x52);
		a.emit(0xFF, 0x75, 0x10, 0x8B, 0x45, 0xC4, 0x03, 0x45, 0xD8);
		a.emit(0x50, 0xFF, 0x75, 0x08);
		a.call(previousTextOutVir);
		a.emit(0x89, 0x45, 0xE8);
		// Restore the caller's exact alignment and COLORREF.
		a.emit(0xFF, 0x75, 0xC8, 0xFF, 0x75, 0x08, 0xFF, 0x15);
		a.dword(stateVir + ItemColorStatic.StateSetTextAlign);
		a.emit(0xFF, 0x75, 0xF0, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.setTextColor);
		a.jmp("return");

		a.label("split_align_fallback");
		a.emit(0xFF, 0x75, 0xF0, 0xFF, 0x75, 0x08);
		ItemColorStatic.callIat(a, apis.setTextColor);
		a.jmp("draw");
	}

	a.label("single_color");
	// Grade-enabled mode gives the exact leading grade token priority over the
	// normal item entry. Item-only mode retains its normal item-first path.
	if (gradeColorsEnabled)
	{
		a.emit(0x8B, 0x5D, 0xE4, 0x83, 0xFB, 0xFF);
		a.jcc(0x85, "single_apply");
		a.emit(0x8B, 0x5D, 0xE0);
	}
	else
	{
		a.emit(0x8B, 0x5D, 0xE0, 0x83, 0xFB, 0xFF);
		a.jcc(0x85, "single_apply");
		a.emit(0x8B, 0x5D, 0xE4);
	}
	a.label("single_apply");
	a.emit(0x53, 0xFF, 0x75, 0x08);
	ItemColorStatic.callIat(a, apis.setTextColor);
	a.emit(0x89, 0x45, 0xF0);
	a.emit(0x8B, 0xD0, 0x81, 0xE2); a.dword(0xFF);
	a.emit(0x83, 0xFA, 0x20);
	a.jcc(0x87, "single_foreground");
	a.emit(0x8B, 0xD0, 0xC1, 0xEA, 0x08, 0x81, 0xE2); a.dword(0xFF);
	a.emit(0x83, 0xFA, 0x20);
	a.jcc(0x87, "single_foreground");
	a.emit(0xC1, 0xE8, 0x10, 0x25); a.dword(0xFF);
	a.emit(0x83, 0xF8, 0x20);
	a.jcc(0x86, "single_shadow");
	a.label("single_foreground");
	a.emit(0xC7, 0x45, 0xF4); a.dword(1);
	a.jmp("draw");
	a.label("single_shadow");
	a.emit(0xFF, 0x75, 0xF0, 0xFF, 0x75, 0x08);
	ItemColorStatic.callIat(a, apis.setTextColor);
	a.emit(0x83, 0x3D); a.dword(stateVir + ItemColorStatic.StateBalloonBypass); a.emit(0x00);
	a.jcc(0x85, "draw");
	a.jmp("shadow_done");

	a.label("draw");
	a.emit(0xFF, 0x75, 0x18, 0xFF, 0x75, 0x14, 0xFF, 0x75, 0x10,
		0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08);
	// Embed the immutable EXE-cave target. A shared-state function pointer is
	// cleared when WARP replays the global text-bridge tag in a full build.
	a.call(previousTextOutVir);
	a.emit(0x89, 0x45, 0xE8);
	a.emit(0x83, 0x7D, 0xF4, 0x00);
	a.jcc(0x84, "return");
	a.emit(0xFF, 0x75, 0xF0, 0xFF, 0x75, 0x08);
	ItemColorStatic.callIat(a, apis.setTextColor);
	a.jmp("return");
	a.label("shadow_done");
	a.emit(0xC7, 0x45, 0xE8); a.dword(1);
	a.label("return");
	a.emit(0x8B, 0x45, 0xE8, 0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D,
		0xC2, 0x14, 0x00);
	return a;
};

ItemColorStatic.findApis = function()
{
	return {
		wideToMulti: ExtNameTextStatic.StableIat.wideToMulti,
		extent: ExtNameTextStatic.StableIat.extent,
		getTickCount: ItemColorStatic.GetTickCountIat,
		setTextColor: ExtNameTextStatic.StableIat.setTextColor,
		getModuleHandle: ItemColorStatic.GetModuleHandleIat,
		getProcAddress: ItemColorStatic.GetProcAddressIat
	};
};

ItemColorStatic.patchTextSurfaces = function(state)
{
	ExtNameTextStatic.selectProfile();
	const apis = ItemColorStatic.findApis();
	if (state.gradeColorsEnabled)
	{
		if (!Number.isInteger(apis.getModuleHandle) ||
			apis.getModuleHandle < 0 ||
			!Number.isInteger(apis.getProcAddress) ||
			apis.getProcAddress < 0)
			throw Error("ItemColorStatic: GDI resolver imports unavailable");
		if (!Number.isInteger(state.gdiModuleNameVir))
			state.gdiModuleNameVir =
				ExtNameTextStatic.allocateText("GDI32.dll");
		if (!Number.isInteger(state.getTextAlignNameVir))
			state.getTextAlignNameVir =
				ExtNameTextStatic.allocateText("GetTextAlign");
		if (!Number.isInteger(state.setTextAlignNameVir))
			state.setTextAlignNameVir =
				ExtNameTextStatic.allocateText("SetTextAlign");
		apis.gdiModuleNameVir = state.gdiModuleNameVir;
		apis.getTextAlignNameVir = state.getTextAlignNameVir;
		apis.setTextAlignNameVir = state.setTextAlignNameVir;
	}
	if (state.gradeColorsEnabled && !Number.isInteger(state.continuationVir))
	{
		const continuation = ItemColorStatic.allocateCode(
			ItemColorStatic.buildContinuationLookup(
				state.stateVir,
				apis.getTickCount
			)
		);
		state.continuationVir = continuation.virAddr;
	}
	let previousTextOutVir;
	let entityFindWideVir;
	let emojiTokensEnabled = false;
	if (state.semanticOnly)
	{
		if (!Number.isInteger(state.ansiScratchVir))
		{
			const [scratchPhy, scratchVir] = RagexeAllocationStatic.allocate(
				ItemColorStatic.AnsiScratchSize,
				0x10
			);
			ExtNameTextStatic.zeroBlock(
				scratchPhy,
				ItemColorStatic.AnsiScratchSize
			);
			state.ansiScratchVir = scratchVir;
		}
		if (!Number.isInteger(state.stockTextOutVir))
		{
			const stockTextOut = ExtNameStaticAsm.asm();
			stockTextOut.emit(0xFF, 0x25);
			stockTextOut.dword(ExtNameTextStatic.StableIat.textOut);
			state.stockTextOutVir =
				ItemColorStatic.allocateCode(stockTextOut).virAddr;
		}
		if (!Number.isInteger(state.entityFindWideVir))
		{
			const noEntityMatch = ExtNameStaticAsm.asm();
			noEntityMatch.emit(0x33, 0xC0, 0xC2, 0x08, 0x00);
			state.entityFindWideVir =
				ItemColorStatic.allocateCode(noEntityMatch).virAddr;
		}
		previousTextOutVir = state.stockTextOutVir;
		entityFindWideVir = state.entityFindWideVir;
	}
	else
	{
		const extState = CACHE.get("ExtNameTextStatic.State");
		if (!extState || !Number.isInteger(extState.textOutVir))
		{
			throw Error(
				"ItemColorStatic: underlying ExtNameTextStatic " +
				"TextOutW bridge unavailable"
			);
		}
		previousTextOutVir = extState.textOutVir;
		entityFindWideVir = extState.findWideVir;
		emojiTokensEnabled =
			(extState.features & ExtNameTextStatic.FeatureEmoji) !== 0 &&
			!!CACHE.get("FluentEmojiStatic.State");
	}
	const textOut = ItemColorStatic.allocateCode(
		ItemColorStatic.buildTextOut(
			state.stateVir,
			state.drainVir,
			state.lookupVir,
			state.continuationVir,
			state.ansiScratchVir,
			previousTextOutVir,
			entityFindWideVir,
			apis,
			emojiTokensEnabled,
			state.gradeColorsEnabled
		)
	);
	const owner = Exe.ActivePatch;
	Exe.ActivateGlobal();
	Exe.BeginTag(CACHE.getTag("ItemColorStatic.TextBridge"), true);
	try
	{
		const directPhy = Exe.Vir2Phy(ExtNameTextStatic.TextOutDirect, CODE);
		const thunkPhy = Exe.Vir2Phy(ExtNameTextStatic.TextOutThunk, CODE);
		if (directPhy < 0 || thunkPhy < 0)
			throw Error("ItemColorStatic: a TextOutW surface is not mapped");
		Exe.SetCALL(directPhy, textOut.virAddr, 0);
		Exe.SetNOPs(directPhy + 5, 1);
		Exe.SetJMP(thunkPhy, textOut.virAddr, 0);
		Exe.SetNOPs(thunkPhy + 5, 1);
	}
	finally
	{
		Exe.EndTag();
		Exe.ActivePatch = owner;
	}
	state.textOutVir = textOut.virAddr;
	state.apis = apis;
	return state;
};

ItemColorStatic.patchItemLabelSurfaces = function(state)
{
	if (!Number.isInteger(state.itemTooltipVir) ||
		!Number.isInteger(state.groundTooltipVir) ||
		!Number.isInteger(state.balloonPlainScopeVir) ||
		!Number.isInteger(state.balloonStyledScopeVir))
		throw Error("ItemColorStatic: item-label bridge unavailable");
	const groups = [
		{
			stockVir: ItemColorStatic.ItemTooltipShow,
			bridgeVir: state.itemTooltipVir,
			callSites: ItemColorStatic.InventoryTooltipCallSites
		},
		{
			stockVir: ItemColorStatic.ItemTooltipShow,
			bridgeVir: state.itemTooltipVir,
			callSites: ItemColorStatic.EquipmentTooltipCallSites
		},
		{
			stockVir: ItemColorStatic.GroundTooltipProject,
			bridgeVir: state.groundTooltipVir,
			callSites: ItemColorStatic.GroundTooltipCallSites
		},
		{
			stockVir: ItemColorStatic.BalloonPlainTextDraw,
			bridgeVir: state.balloonPlainScopeVir,
			callSites: ItemColorStatic.BalloonPlainTextDrawCallSites
		},
		{
			stockVir: ItemColorStatic.BalloonStyledTextDraw,
			bridgeVir: state.balloonStyledScopeVir,
			callSites: ItemColorStatic.BalloonStyledTextDrawCallSites
		}
	];
	const owner = Exe.ActivePatch;
	Exe.ActivateGlobal();
	Exe.BeginTag(CACHE.getTag("ItemColorStatic.ItemLabelBridge"), true);
	try
	{
		for (const group of groups)
		{
			for (const callVir of group.callSites)
			{
				const callPhy = Exe.Vir2Phy(callVir, CODE);
				if (callPhy < 0)
					throw Error(`ItemColorStatic: item-label call ${callVir.toHex()} is not mapped`);
				const target = Exe.GetTgtAddr(callPhy + 1);
				if (target !== group.stockVir && target !== group.bridgeVir)
					throw Error(`ItemColorStatic: unexpected item-label target ${target.toHex()}`);
				Exe.SetCALL(callPhy, group.bridgeVir, 0);
			}
		}
	}
	finally
	{
		Exe.EndTag();
		Exe.ActivePatch = owner;
	}
	return state;
};

ItemColorStatic.enable = function(_, icolVir, gradeColorsEnabled)
{
	const profile = ItemColorStatic.selectProfile();
	if (!Number.isInteger(icolVir))
		throw Error("ItemColorStatic: ICOL dispatcher block unavailable");

	let state = CACHE.get("ItemColorStatic.State");
	if (!state || !Number.isInteger(state.stateVir))
	{
		const [statePhy, stateVir] = RagexeAllocationStatic.allocate(
			ItemColorStatic.StateSize,
			4
		);
		ExtNameTextStatic.zeroBlock(statePhy, ItemColorStatic.StateSize);
		const tableSize = ItemColorStatic.TableCapacity * ItemColorStatic.EntrySize;
		const [tablePhy, tableVir] =
			RagexeAllocationStatic.allocate(tableSize, 0x10);
		ExtNameTextStatic.zeroBlock(tablePhy, tableSize);
		const drain = ItemColorStatic.allocateCode(
			ItemColorStatic.buildDrain(icolVir, stateVir, tableVir)
		);
		const lookup = ItemColorStatic.allocateCode(
			ItemColorStatic.buildLookup(stateVir, tableVir)
		);
		state = {
			statePhy,
			stateVir,
			tableVir,
			drainVir: drain.virAddr,
			lookupVir: lookup.virAddr,
			icolVir,
			semanticOnly: RagexeAllocationStatic.UsesStaticCave,
			gradeColorsEnabled: !!gradeColorsEnabled
		};
		if (!state.semanticOnly)
		{
			const [scratchPhy, scratchVir] = RagexeAllocationStatic.allocate(
				ItemColorStatic.AnsiScratchSize,
				0x10
			);
			ExtNameTextStatic.zeroBlock(
				scratchPhy,
				ItemColorStatic.AnsiScratchSize
			);
			state.ansiScratchVir = scratchVir;
		}
	}
	if (!Number.isInteger(state.itemTooltipVir))
	{
		const tooltip = ItemColorStatic.allocateCode(
			ItemColorStatic.buildItemTooltip(
				state.drainVir,
				state.lookupVir,
				state.gradeColorsEnabled
			)
		);
		state.itemTooltipVir = tooltip.virAddr;
	}
	if (!Number.isInteger(state.groundTooltipVir))
	{
		const tooltip = ItemColorStatic.allocateCode(
			ItemColorStatic.buildGroundTooltip(
				state.drainVir,
				state.lookupVir,
				state.gradeColorsEnabled
			)
		);
		state.groundTooltipVir = tooltip.virAddr;
	}
	if (!Number.isInteger(state.balloonPlainScopeVir))
	{
		const scope = ItemColorStatic.allocateCode(
			ItemColorStatic.buildBalloonTextScope(
				state.stateVir,
				ItemColorStatic.BalloonPlainTextDraw,
				0x24
			)
		);
		state.balloonPlainScopeVir = scope.virAddr;
	}
	if (!Number.isInteger(state.balloonStyledScopeVir))
	{
		const scope = ItemColorStatic.allocateCode(
			ItemColorStatic.buildBalloonTextScope(
				state.stateVir,
				ItemColorStatic.BalloonStyledTextDraw,
				0x20
			)
		);
		state.balloonStyledScopeVir = scope.virAddr;
	}
	ItemColorStatic.patchTextSurfaces(state);
	ItemColorStatic.patchItemLabelSurfaces(state);
	CACHE.put("ItemColorStatic.State", state);

	if (!state.semanticOnly)
	{
		StaticPatchRefresh.add("CustomColoredItemName.StaticTextBridge", function()
		{
			const current = CACHE.get("ItemColorStatic.State");
			if (!current || !Number.isInteger(current.stateVir))
				return false;
			ItemColorStatic.patchTextSurfaces(current);
			CACHE.put("ItemColorStatic.State", current);
			return true;
		});
	}

	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
	{
		PatchDiagnostics.add("ItemColorStatic.QjsOnly", {
			owner: _,
			build: profile.Name,
			packetId: ItemColorStatic.PacketId,
			tableCapacity: ItemColorStatic.TableCapacity,
			gradeColorsEnabled: state.gradeColorsEnabled,
			icolVir,
			textOutVir: state.textOutVir,
			itemTooltipVir: state.itemTooltipVir,
			groundTooltipVir: state.groundTooltipVir,
			balloonPlainScopeVir: state.balloonPlainScopeVir,
			balloonStyledScopeVir: state.balloonStyledScopeVir,
			externalModules: 0
		});
	}
	return true;
};

CustomColoredItemName = function(_)
{
	ItemColorStatic.selectProfile();
	if (typeof ExtNameTextStatic === "undefined" ||
		typeof ExtNameTextStatic.enable !== "function")
		throw Error("CustomColoredItemName: ExtNameTextStatic helper unavailable");
	if (typeof CustomPacketDispatch === "undefined" ||
		typeof CustomPacketDispatch.install !== "function")
		throw Error("CustomColoredItemName: dispatcher helper unavailable");

	// The protected 2026 image cannot host the EXTN ring/map used by the
	// generic text bridge. Its semantic item-label producers are sufficient
	// for inventory, equipment, ground labels, and item balloons.
	if (!RagexeAllocationStatic.UsesStaticCave)
		ExtNameTextStatic.enable(`${_}.Base`, 0);
	CustomPacketDispatch.install(
		`${_}.Dispatch`,
		RagexeAllocationStatic.UsesStaticCave ? ["ICOL", "EXTN"] : ["ICOL"]
	);
	const routes = CACHE.get("CustomPacketDispatch.Routes");
	const icol = routes && routes.routes ? routes.routes.ICOL : null;
	if (!icol || !Number.isInteger(icol.blockVir))
		throw Error("CustomColoredItemName: ICOL shared block unavailable");

	const gradeColorsEnabled =
		CACHE.get("CustomColoredItemName.GradeColorsEnabled") === true;
	return ItemColorStatic.enable(_, icol.blockVir, gradeColorsEnabled);
};

CustomColoredItemName.validate = function()
{
	return !!ItemColorStatic.Profiles[RagexeClientProfile.Id] &&
		(typeof RagexeAllocationStatic === "undefined" ||
			RagexeAllocationStatic.isPrepared()) &&
		typeof ExtNameTextStatic !== "undefined" &&
		typeof ItemColorStatic !== "undefined";
};
