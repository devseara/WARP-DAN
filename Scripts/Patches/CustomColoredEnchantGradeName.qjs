*   Last Modified : 2026-07-24                                             *
*                                                                          *
*   Description   : Enables independent ICOL coloring for the leading      *
*                   enchant-grade token in CustomColoredItemName. The      *
*                   grade prefix and exact base item remain separate GDI   *
*                   spans. Targets: 2025-07-16 and 2026-02-19 Ragexe.      *
*                                                                          *
\**************************************************************************/

CustomColoredEnchantGradeName = function(_)
{
	CACHE.put("CustomColoredItemName.GradeColorsEnabled", true);
	$$(_, 1, "Enable independent enchant-grade prefix colors");
	return true;
};

CustomColoredEnchantGradeName.validate = function()
{
	return typeof RagexeClientProfile !== "undefined" &&
		(RagexeClientProfile.Id === 20250716 ||
			RagexeClientProfile.Id === 20260219);
};
