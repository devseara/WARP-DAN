///
/// \brief Shared hook for replacing New Basic button hover labels before the
///        client dispatches into the first/second button-ID switch tables.
///
NewBasicButtonHover = {
	refsKey: 'NBH_Refs',
	overridesKey: 'NBH_Overrides',
	noHotkeyBehaviorID: 0x2732,

	registerMsgString: function(patchName, buttonID, msgID)
	{
		this.register(patchName, {
			owner: patchName,
			kind: 'msg',
			buttonID,
			msgID
		});
	},

	registerText: function(patchName, buttonID, textAddr, textLen)
	{
		this.register(patchName, {
			owner: patchName,
			kind: 'text',
			buttonID,
			textAddr,
			textLen
		});
	},

	register: function(patchName, entry)
	{
		let entries = CACHE.has(this.overridesKey) ? CACHE.get(this.overridesKey) : [];
		entries = entries.filter(item => item.owner !== patchName);
		entries.push(entry);
		CACHE.put(this.overridesKey, entries);
		this.stage(patchName);
	},

	unregister: function(patchName)
	{
		let entries = CACHE.has(this.overridesKey) ? CACHE.get(this.overridesKey) : [];
		entries = entries.filter(item => item.owner !== patchName);
		CACHE.put(this.overridesKey, entries);
		if (entries.isEmpty())
		{
			Exe.DelTag('NewBasicHover', true);
			return;
		}

		this.stage(patchName);
	},

	resolveRefs: function(_)
	{
		if (CACHE.has(this.refsKey))
			return CACHE.get(this.refsKey);

		$$(_, 4.1, `Find New Basic hover mapper`)
		const mapperStart =
			MOV(EAX, [EAX, 0x2C]) // mov eax, dword ptr [button + button_id]
		+	MOV(EDX, this.noHotkeyBehaviorID)
		+	MOV(EDI, 0x1103)
		+	CMP(EAX, 0x1CD);

		const addr = Exe.FindHex(mapperStart);
		if (addr < 0)
			throw Error("New Basic hover mapper start not found");

		const hookAddr = addr
			+ MOV(EAX, [EAX, 0x2C]).byteCount()
			+ MOV(EDX, this.noHotkeyBehaviorID).byteCount()
			+ MOV(EDI, 0x1103).byteCount();

		const continueVir = Exe.Phy2Vir(hookAddr + CMP(EAX, 0x1CD).byteCount(), CODE);
		if (continueVir < 0)
			throw Error("New Basic hover mapper continuation conversion failed");

		const subId =
			SUB(EAX, 0xC0)
		+	CMP(EAX, 0xEE)
		+	JA(POS4WC);

		const subAddr = Exe.FindHex(subId, hookAddr, hookAddr + 0x80);
		if (subAddr < 0)
			throw Error("New Basic hover mapper switch not found");

		const cmpAddr = subAddr + SUB(EAX, 0xC0).byteCount();
		const jaAddr = cmpAddr + CMP(EAX, 0xEE).byteCount();
		const defaultAddr = Exe.GetTgtAddr(jaAddr + 2);

		const assignAddr = Exe.FindHex("8D 45 D0 C7 45 D0 00 00 00 00", hookAddr, hookAddr + 0x200);
		if (assignAddr < 0)
			throw Error("New Basic hover label assignment path not found");

		const assignVir = Exe.Phy2Vir(assignAddr, CODE);
		if (assignVir < 0)
			throw Error("New Basic hover label assignment conversion failed");

		const assignCall = Exe.FindHex("8B CE 52 50 E8", assignAddr, assignAddr + 0x180);
		if (assignCall < 0)
			throw Error("New Basic hover std::string assign call not found");

		const textAssignVir = Exe.GetTgtAddr(assignCall + 5);
		if (textAssignVir < 0)
			throw Error("New Basic hover std::string assign target not found");

		const refs = {hookAddr, continueVir, assignVir, defaultAddr, textAssignVir};
		CACHE.put(this.refsKey, refs);
		return refs;
	},

	stage: function(patchName)
	{
		const refs = this.resolveRefs(patchName + " hover");
		const entries = CACHE.has(this.overridesKey) ? CACHE.get(this.overridesKey) : [];
		if (entries.isEmpty())
			return;

		let fillerIdx = 1;
		let targets = {};
		const continueIdx = fillerIdx++;
		targets[continueIdx] = refs.continueVir;

		let parts = [];
		for (const entry of entries)
		{
			const skipIdx = fillerIdx++;
			let body = "";

			if (entry.kind === 'msg')
			{
				const assignIdx = fillerIdx++;
				targets[assignIdx] = refs.assignVir;

				body =
					MOV(EDX, this.noHotkeyBehaviorID)
				+	MOV(EDI, entry.msgID)
				+	JMP(Filler(assignIdx));
			}
			else if (entry.kind === 'text')
			{
				const assignFnIdx = fillerIdx++;
				const doneIdx = fillerIdx++;
				targets[assignFnIdx] = refs.textAssignVir;
				targets[doneIdx] = refs.defaultAddr;

				body =
					MOV(ESI, [EBP, -0x34])
				+	LEA(ECX, [ESI, 0x94])
				+	PUSH(entry.textLen)
				+	PUSH(entry.textAddr)
				+	CALL(Filler(assignFnIdx))
				+	JMP(Filler(doneIdx));
			}
			else
			{
				continue;
			}

			let block =
				CMP(EAX, entry.buttonID)
			+	JNE(Filler(skipIdx, 1))
			+	body;

			block = SwapFillers(block, {[skipIdx + ',1']: body.byteCount()});
			parts.push(block);
		}

		parts.push(
			CMP(EAX, 0x1CD)
		+	JMP(Filler(continueIdx))
		);

		Exe.ActivateGlobal();
		Exe.BeginTag('NewBasicHover', true);
		const [, stubVir] = AutoHook(null, parts, {targets});
		Exe.SetJMP(refs.hookAddr, stubVir);
		Exe.EndTag();
		Exe.ActivePatch = patchName;
	}
};

///
/// \brief Shared discovery for New Basic button IDs and visibility switch state.
///
NewBasicButton = {
	refsKey: 'NBB_Refs',
	BookingButtonIdx: 8,
	BattlegroundButtonIdx: 11,
	SNSButtonIdx: 19,

	resolveRefs: function(_)
	{
		if (CACHE.has(this.refsKey))
			return CACHE.get(this.refsKey);

		$$(_, 3.1, `Find New Basic button ID table anchor`)
		const strNavigation = Exe.FindText("navigation");
		if (strNavigation < 0)
			throw Error("'navigation' string not found");

		const addrNavigation = Exe.FindHex(PUSH(strNavigation));
		if (addrNavigation < 0)
			throw Error("'navigation' PUSH reference not found");

		$$(_, 3.2, `Find MOVAPS blocks that load the button-ID table`)
		let code =
			MOVAPS(XMM0, XMMWORD_PTR, [POS4WC])  // movaps xmm0, xmmword ptr [ListButtonsID]
		+	MOV(EAX, [POS3WC]);                  // mov eax, dword ptr [dword]

		let addr = Exe.FindHex(code, addrNavigation - 0x5000, addrNavigation);
		if (addr < 0)
			throw Error("Button-ID MOVAPS pattern not found");

		const movAps = MOVAPS(XMM0, XMMWORD_PTR, [POS4WC]);
		let listAddrRefs = [];
		for (let i = 0; i < 6; ++i)
		{
			addr = Exe.FindHex(movAps, addr, addr + 0x20);
			if (addr < 0)
				throw Error("Button-ID MOVAPS block not found at index " + i);

			listAddrRefs.push(Exe.GetUint32(addr + 3));
			addr += movAps.byteCount();
		}

		listAddrRefs.sort();
		const listPhy = Exe.Vir2Phy(listAddrRefs[0]);
		if (listPhy < 0)
			throw Error("Button-ID table conversion failed");

		let ids = [];
		for (let i = 0; i < 24; ++i)
			ids.push(Exe.GetUint32(listPhy + (i * 4)));

		const refs = {addrNavigation, ids};
		CACHE.put(this.refsKey, refs);
		return refs;
	},

	getID: function(_, buttonIdx, label)
	{
		const refs = this.resolveRefs(_);
		const id = refs.ids[buttonIdx];
		if (id <= 0)
			throw Error(label + " button ID is invalid");

		return id;
	},

	ensureVisible: function(_, buttonID)
	{
		const refs = this.resolveRefs(_);
		$$(_, 3.5, `Keep New Basic button visible`)
		const swPrefix = MOVZX(EAX, BYTE_PTR, [EAX, POS4WC]); // movzx eax, byte ptr [eax + switchTbl]
		const swSuffix = JMP([4, EAX, POS4WC]);               // jmp dword ptr [eax*4 + jumpTbl]
		const swPattern = swPrefix + swSuffix;

		let swRefs = Exe.FindHexN(swPattern, refs.addrNavigation - 0x3000, refs.addrNavigation + 0x7000);
		if (swRefs.isEmpty())
			swRefs = Exe.FindHexN(swPattern);

		if (swRefs.isEmpty())
			return;

		for (const swAddr of swRefs)
		{
			const switchTblVir = Exe.GetUint32(swAddr + 3);
			let switchTblPhy = Exe.Vir2Phy(switchTblVir, CODE);
			if (switchTblPhy < 0)
				switchTblPhy = Exe.Vir2Phy(switchTblVir);

			let minLimit = null;
			let range = null;

			let limPrefix = LEA(EAX, [EBX, NEG2WC]);
			let limAddr = Exe.FindLastHex(limPrefix + CMP(EAX, POS1WC), swAddr, swAddr - 0x80);
			if (limAddr > 0)
			{
				const cmpAddr = limAddr + limPrefix.byteCount();
				minLimit = -Exe.GetInt32(cmpAddr - 4);
				range = Exe.GetInt32(cmpAddr + 1);
			}

			if (minLimit === null)
			{
				limPrefix = ADD(EAX, NEG2WC);
				limAddr = Exe.FindLastHex(limPrefix + CMP(EAX, POS1WC), swAddr, swAddr - 0x80);
				if (limAddr > 0)
				{
					const cmpAddr = limAddr + limPrefix.byteCount();
					minLimit = -Exe.GetInt32(cmpAddr - 4);
					range = Exe.GetInt32(cmpAddr + 1);
				}
			}

			if (switchTblPhy < 0 || minLimit === null || range === null)
				continue;

			if (buttonID < minLimit || buttonID > minLimit + range)
				continue;

			const visFlagAddr = switchTblPhy + buttonID - minLimit;
			if (Exe.GetInt8(visFlagAddr) === 0)
				Exe.SetInt8(visFlagAddr, 1);

			break;
		}
	},

	validate: function()
	{
		return Exe.BuildDate > 20170000 && Exe.FindText("navigation") >= 0;
	}
};

///
/// \brief Shared click dispatcher for New Basic buttons. URL actions are given
///        priority over packet actions for the same button for compatibility.
///
NewBasicButtonClick = {
	entriesKey: 'NBC_Entries',
	refsKey: 'NBC_Refs',
	packetRefsKey: 'NBC_PacketRefs',

	registerURL: function(patchName, buttonID, urlAddr, shellExecIA, openAddr)
	{
		this.register(patchName, {
			owner: patchName,
			kind: 'url',
			priority: 100,
			buttonID,
			urlAddr,
			shellExecIA,
			openAddr
		});
	},

	registerPacket: function(patchName, buttonID, packetID)
	{
		this.register(patchName, {
			owner: patchName,
			kind: 'packet',
			priority: 10,
			buttonID,
			packetStubVir: this.buildPacketSender(patchName, packetID)
		});
	},

	register: function(patchName, entry)
	{
		let entries = CACHE.has(this.entriesKey) ? CACHE.get(this.entriesKey) : [];
		entries = entries.filter(item => item.owner !== patchName);
		entries.push(entry);
		CACHE.put(this.entriesKey, entries);
		this.stage(patchName);
	},

	unregister: function(patchName)
	{
		let entries = CACHE.has(this.entriesKey) ? CACHE.get(this.entriesKey) : [];
		entries = entries.filter(item => item.owner !== patchName);
		CACHE.put(this.entriesKey, entries);
		if (entries.isEmpty())
		{
			Exe.DelTag('NewBasicClick', true);
			return;
		}

		this.stage(patchName);
	},

	resolveClickRefs: function(_)
	{
		if (CACHE.has(this.refsKey))
			return CACHE.get(this.refsKey);

		$$(_, 5.1, `Find New Basic click switch`)
		const strRecEnd = Exe.FindText("REC End please");
		if (strRecEnd < 0)
			throw Error("'REC End please' string not found");

		const addrRecEnd = Exe.FindHex(PUSH(strRecEnd));
		if (addrRecEnd < 0)
			throw Error("'REC End please' PUSH reference not found");

		const clickSwitchPrefix = "8B 5D 10 8B C8 53 E8 ?? ?? ?? ?? 84 C0 75 ?? ";
		const code =
			clickSwitchPrefix
		+	CMP(EBX, 0x1CD);       // cmp ebx, 1CDh ; start of the click switch

		const addr = Exe.FindHex(code, addrRecEnd - 0x300, addrRecEnd + 0x200);
		if (addr < 0)
			throw Error("New Basic click switch not found");

		const cmpSwitch = CMP(EBX, 0x1CD);
		const cmpAddr = addr + 15; // byte length of clickSwitchPrefix
		const jneAddr = cmpAddr - 2; // short JNE immediately before the CMP is 2 bytes
		let shortJump = Exe.GetUint8(jneAddr + 1);
		if (shortJump > 0x7F)
			shortJump -= 0x100;

		const forwardPhy = jneAddr + 2 + shortJump;
		const forwardVir = Exe.Phy2Vir(forwardPhy, CODE);
		const cmpContinueVir = Exe.Phy2Vir(cmpAddr + cmpSwitch.byteCount(), CODE);
		if (forwardVir < 0 || cmpContinueVir < 0)
			throw Error("New Basic click switch target conversion failed");

		const refs = {cmpAddr, cmpSwitch, forwardVir, cmpContinueVir};
		CACHE.put(this.refsKey, refs);
		return refs;
	},

	resolvePacketRefs: function(_)
	{
		if (CACHE.has(this.packetRefsKey))
			return CACHE.get(this.packetRefsKey);

		$$(_, 4.2, `Find packet send helper calls`)
		const packetTemplate =
			MOV(EAX, 0x0844)  // mov eax, CZ_SE_CASHSHOP_OPEN1
		+	PUSH(ESI)
		+	MOV([EBP, 0x8], AX);

		const packetTemplateAddrs = Exe.FindHexN(packetTemplate);
		if (packetTemplateAddrs.isEmpty())
			throw Error("Packet sender template not found");

		const senderCandidates = packetTemplateAddrs.filter(addr =>
			Exe.FindLastHex(PUSH(0x13E), addr, addr - 0x80) > 0
		);
		if (senderCandidates.length !== 1)
			throw Error("Expected one packet sender template, found " + senderCandidates.length);

		const packetSender = senderCandidates[0];
		const refs = {
			packetCtorA: Exe.GetTgtAddr(packetSender + 0x0A + 1),
			packetCtorB: Exe.GetTgtAddr(packetSender + 0x11 + 1),
			packetLookup: Exe.GetTgtAddr(packetSender + 0x1D + 1),
			packetSend: Exe.GetTgtAddr(packetSender + 0x29 + 1)
		};
		CACHE.put(this.packetRefsKey, refs);
		return refs;
	},

	buildPacketSender: function(patchName, packetID)
	{
		const refs = this.resolvePacketRefs(patchName);
		let packetSenderCode =
			PUSH(EBP)
		+	MOV(EBP, ESP)
		+	SUB(ESP, 4)
		+	PUSH(ESI)
		+	MOV(EAX, packetID)
		+	" 66 89 45 FC"       // mov word ptr [ebp-4], ax
		+	CALL(Filler(1))
		+	MOV(ESI, EAX)
		+	CALL(Filler(2))
		+	" 0F BF 4D FC"       // movsx ecx, word ptr [ebp-4]
		+	PUSH(ECX)
		+	MOV(ECX, EAX)
		+	CALL(Filler(3))
		+	" 8D 4D FC"          // lea ecx, [ebp-4]
		+	PUSH(ECX)
		+	PUSH(EAX)
		+	MOV(ECX, ESI)
		+	CALL(Filler(4))
		+	POP(ESI)
		+	MOV(ESP, EBP)
		+	POP(EBP)
		+	RETN();

		const [packetStubPhy, packetStubVir] = Exe.Allocate(packetSenderCode.byteCount(), 0x10);
		packetSenderCode = SetFillTargets(packetSenderCode, {
			start: packetStubVir,
			1: refs.packetCtorA,
			2: refs.packetCtorB,
			3: refs.packetLookup,
			4: refs.packetSend
		});
		Exe.SetHex(packetStubPhy, packetSenderCode);
		return packetStubVir;
	},

	activeEntries: function()
	{
		const entries = CACHE.has(this.entriesKey) ? CACHE.get(this.entriesKey) : [];
		let selected = [];
		for (const entry of entries)
		{
			const idx = selected.findIndex(item => item.buttonID === entry.buttonID);
			if (idx < 0)
			{
				selected.push(entry);
			}
			else if (entry.priority > selected[idx].priority)
			{
				selected[idx] = entry;
			}
		}

		return selected;
	},

	stage: function(patchName)
	{
		const refs = this.resolveClickRefs(patchName);
		const entries = this.activeEntries();
		if (entries.isEmpty())
			return;

		let fillerIdx = 1;
		let targets = {};
		const handledIdx = fillerIdx++;
		const continueIdx = fillerIdx++;
		targets[handledIdx] = refs.forwardVir;
		targets[continueIdx] = refs.cmpContinueVir;

		let parts = [];
		for (const entry of entries)
		{
			const skipIdx = fillerIdx++;
			let body = "";

			if (entry.kind === 'url')
			{
				body =
					PUSHAD
				+	PUSH(1)                   // SW_SHOWNORMAL
				+	PUSH_0                    // lpDirectory
				+	PUSH_0                    // lpParameters
				+	PUSH(entry.urlAddr)       // lpFile
				+	PUSH(entry.openAddr)      // lpOperation ("open")
				+	PUSH_0                    // hwnd
				+	CALL([entry.shellExecIA]) // call dword ptr [<&SHELL32.ShellExecuteA>]
				+	POPAD
				+	JMP(Filler(handledIdx));
			}
			else if (entry.kind === 'packet')
			{
				const packetIdx = fillerIdx++;
				targets[packetIdx] = entry.packetStubVir;
				body =
					PUSHAD
				+	CALL(Filler(packetIdx))
				+	POPAD
				+	JMP(Filler(handledIdx));
			}
			else
			{
				continue;
			}

			let block =
				CMP(EBX, entry.buttonID)
			+	JNE(Filler(skipIdx, 1))
			+	body;

			block = SwapFillers(block, {[skipIdx + ',1']: body.byteCount()});
			parts.push(block);
		}

		parts.push(
			refs.cmpSwitch
		+	JMP(Filler(continueIdx))
		);

		Exe.ActivateGlobal();
		Exe.BeginTag('NewBasicClick', true);
		const [, stubVir] = AutoHook(null, parts, {targets});
		Exe.SetJMP(refs.cmpAddr, stubVir, 1);
		Exe.EndTag();
		Exe.ActivePatch = patchName;
	},

	validatePacket: function()
	{
		const packetTemplate =
			MOV(EAX, 0x0844)
		+	PUSH(ESI)
		+	MOV([EBP, 0x8], AX);

		return NewBasicButton.validate()
			&& Exe.FindText("REC End please") >= 0
			&& Exe.FindHex(packetTemplate) > 0;
	},

	validateURL: function()
	{
		return NewBasicButton.validate()
			&& Exe.FindText("REC End please") >= 0
			&& Exe.FindFunc("ShellExecuteA", "SHELL32.dll") > 0;
	}
};

///
/// \brief Reuse the Basic Info "SNS" button by opening a custom URL in the
///        user's default browser while replacing the hover label and suppressing
///        the original SNS hotkey suffix.
///
SNSButtonURL = function(_)
{
	$$(_, 1.1, `Get URL from user`)
	const varName = '$snsBtnURL';
	const url = Exe.GetUserInput(
		varName,
		D_Text,
		"SNS Button URL",
		"Enter the URL to open when SNS button is clicked",
		"https://example.com/",
		{minLen: 8, maxLen: 255, saveDefault: true}
	);
	if (url === false)
		Cancel("No URL entered");

	if (!Warp.TestMode)
		Warp.SetPatchState('SNSButtonGuide', false);

	$$(_, 1.2, `Get hover label from user`)
	const hoverVarName = '$snsBtnHover';
	const hoverText = Exe.GetUserInput(
		hoverVarName,
		D_Text,
		"SNS Button Hover",
		"Enter the hover label to show for the SNS button",
		"Discord Channel",
		{minLen: 1, maxLen: 60, saveDefault: true}
	);
	if (hoverText === false)
		Cancel("No hover label entered");

	$$(_, 1.3, `Add URL and hover strings`)
	const [, urlAddr] = Exe.AddFromVar(varName);
	const [, openAddr] = Exe.AddText("open");
	const [, hoverAddr] = Exe.AddFromVar(hoverVarName);
	const hoverLen = hoverText.length;
	if (hoverLen <= 0)
		throw Error("SNS hover label is empty");

	$$(_, 2.1, `Find ShellExecuteA import`)
	const shellExecIA = Exe.FindFunc("ShellExecuteA", "SHELL32.dll");
	if (shellExecIA < 0)
		throw Error("ShellExecuteA import not found");

	$$(_, 3.3, `Resolve SNS button ID`)
	const targetID = NewBasicButton.getID(_, NewBasicButton.SNSButtonIdx, "SNS");

	$$(_, 3.4, `Register SNS hover label`)
	NewBasicButtonHover.registerText(_, targetID, hoverAddr, hoverLen);

	NewBasicButton.ensureVisible(_, targetID);

	$$(_, 4.1, `Register SNS URL click action`)
	NewBasicButtonClick.registerURL(_, targetID, urlAddr, shellExecIA, openAddr);

	return true;
};

///
/// \brief Disable for unsupported clients.
///
SNSButtonURL.validate = function()
{
	return NewBasicButtonClick.validateURL();
};

SNSButtonURL.cleanup = function(patchName)
{
	NewBasicButtonHover.unregister(patchName);
	NewBasicButtonClick.unregister(patchName);
};
