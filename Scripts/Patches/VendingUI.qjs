/*
 * Description: Independent 590x450 native player Vending UI for 2025-07-16 Ragexe.
 * Uses original marketui artwork, native editing with live comma prices, and
 * server-authoritative VNUI currency selection / cart / buyer / history views.
 * Requires the matching extended-vending server module and SQL migration.
 * Drag-only item selection with native stack-amount input and purchase confirmation.
 * Private scroll panes, SOLD overlays and inset card controls.
 * Esc closes visited shops while keeping the own-store controls available.
 * Private receive, walk-request and shop-switch gates; unrelated traffic stays stock.
 */
VendingUI = function(_)
{
	if(!VendingUI.validate())throw Error("VendingUI requires 2025-07-16 Ragexe");
	const n=AutoCombatUI.nativeHelpers;
	const read=path=>{const f=new BinFile(path,"r");if(!f.Valid)throw Error("VendingUI: missing "+path);const h=f.ReadHex();f.Close();return(h.match(/[0-9a-fA-F]{2}/g)||[]).map(v=>parseInt(v,16));};
	const u32=(b,o)=>(b[o]|b[o+1]<<8|b[o+2]<<16|b[o+3]<<24)>>>0;
	const put=(b,o,v)=>{for(let i=0;i<4;++i)b[o+i]=v>>>(i*8)&255;};
	const bytes=read(Warp.Path+"/Inputs/VendingUI/runtime.bin"),meta=JSON.parse(String.fromCharCode(...read(Warp.Path+"/Inputs/VendingUI/runtime.json")));
	const size=u32(bytes,8),count=u32(bytes,12),api=u32(bytes,16),start=32+count*4;
	let crc=0xFFFFFFFF;for(let i=32;i<bytes.length;++i){crc^=bytes[i];for(let j=0;j<8;++j)crc=(crc>>>1)^((crc&1)?0xEDB88320:0);}
	if(bytes.length<32 || u32(bytes,0)!==0x49554E56 || u32(bytes,4)!==1 || meta.version!==1 || meta.client!==20250716 ||
		start+size!==bytes.length || size!==meta.size || api!==meta.exports.VendingApi || meta.api_size!==172 || api+172>size || u32(bytes,20)!==172 || u32(bytes,24)!==20250716 || ((crc^0xFFFFFFFF)>>>0)!==u32(bytes,28))throw Error("VendingUI: invalid payload");
	const names=["VendingApi","VendingState","_VendingReceive@4","_VendingHit@8","@VendingDraw@8","@VendingDown@16","@VendingUp@16","@VendingMove@16","@VendingDrag@16","@VendingCursor@16","@VendingDestroy@12","@VendingRightDown@16","@VendingRightUp@16","@VendingWheel@12","_VendingName@8","_VendingResource@4","VendingIconIdentified","_VendingFormat@12","@VendingEditDraw@8","_VendingDescribe@4","_VendingBlocksWalk@0","_VendingSwitchShop@0"];
	for(const name of names.concat(["@VendingEditEvent@32"]))if(!Number.isInteger(meta.exports[name]) || meta.exports[name]<0 || meta.exports[name]>=size)throw Error("VendingUI: missing "+name);
	n.assertCode("VendingUI packet registration",0xAA67C1,"6A 00 6A 04 6A FF 68 F3 0B 00 00 8B CE E8 5D 97 FF FF");
	n.assertCode("VendingUI frame ctor",n.FrameConstructor,"55 8B EC 6A FF 68 F9 45 EA 00");
	for(const [slot,expected] of [[0,n.FrameDeletingDestructor],[20,n.FrameVtableDraw],[25,n.FrameMouseDown],[27,0x880E00],[31,n.FrameMouseUp],[32,0x5A8A50],[33,0x5A8A60],[35,0x5A8AF0]])n.assertVtableSlot("VendingUI frame",slot,expected);
	for(const [slot,expected] of [[20,0x824FC0],[23,0x822E30],[24,0x8266D0],[37,0x82C4E0],[53,0x8303F0],[56,0x82B2D0]])if(Exe.GetUint32(Exe.Vir2Phy(0x1028908)+slot*4)!==expected)throw Error("VendingUI: edit control changed");
	n.assertCode("VendingUI native edit event",0x82C4E0,"55 8B EC 6A FF 68 7F AF E9 00");
	const packetPhy=Exe.Vir2Phy(n.packetTableEntryVir(0xBF3),CODE),original=Exe.GetUint32(packetPhy);
	if(original!==0xCAA2B7)throw Error("VendingUI profiled route changed");
	n.assertCode("VendingUI profile CAA2B7",0xCAA2B7,"E8 A4 AA F6 FF 8B C8 E8 ED A5");
	n.assertCode("VendingUI profile 817DA0",0x817DA0,"55 8B EC 6A FF 68 45 81 E9 00");
	n.assertCode("VendingUI profile A1B780",0xA1B780,"55 8B EC 8B 45 08 89 48 10 83");
	n.assertCode("VendingUI profile A1CB70",0xA1CB70,"55 8B EC 53 8B D9 56 57 8B 4B");
	n.assertCode("VendingUI profile A4B760",0xA4B760,"55 8B EC 53 56 8B 75 08 57 8B");
	n.assertCode("VendingUI profile A6EA10",0xA6EA10,"55 8B EC 53 56 57 8B D9 E8 93");
	n.assertCode("VendingUI profile A7E780",0xA7E780,"55 8B EC 6A FF 68 9D 54 EF 00");
	n.assertCode("VendingUI profile 8303F0",0x8303F0,"55 8B EC 8B 55 08 8B C2 53 56");
	n.assertCode("VendingUI profile 824FC0",0x824FC0,"55 8B EC 83 EC 1C A1 24 B9 22");
	n.assertCode("VendingUI walk request gate",0xC8F852,"E8 F9 68 FF FF 3C 01 0F 84 7D 9A FF FF");
	n.assertCode("VendingUI stock walk check",0xC86150,"68 22 01 00 00 B9 E8 F4 31 01");
	n.assertCode("VendingUI switch request",0xC8E636,"B8 30 01 00 00 66 89 85 70 F9 FE FF");
	n.assertCode("VendingUI cart summary",0xCA3E2E,"0F BF 05 9A 81 5E 01 A3 D4 B2 5F 01 0F BF 05 9C 81 5E 01 A3 D8 B2 5F 01");
	const routes=[{op:0xBF3,phy:packetPhy,original}];
	n.assertCode("VendingUI instance 6A1B20",0x6A1B20,"55 8B EC 6A FF 68 8B 54 E5 00");
	n.assertCode("VendingUI instance 6A6570",0x6A6570,"55 8B EC 83 EC 14 A1 24 B9 22");
	n.assertCode("VendingUI instance 5A4300",0x5A4300,"55 8B EC 6A FF 68 8B 33 E2 00");
	n.assertCode("VendingUI instance A39340",0xA39340,"55 8B EC 6A FF 68 07 F0 EE 00");
	n.assertCode("VendingUI instance D0A2B4",0xD0A2B4,"8D 8D B8 FE FF FF 0F BF 45 B6 FF 75 B9 89 85 BC FE FF FF 8B 45 B0 89 85 CC FE FF FF 89 85 D0 FE FF FF 0F B6 45 B8 89 85 B8 FE FF FF 0F BF 45 B4 89 85 C8 FE FF FF 0F B6 45 BD 88 85 14 FF FF FF 0F B6 45 BE 88 85 15 FF FF FF 0F B6 45 EE 89 85 18 FF FF FF");
	n.assertCode("VendingUI instance D0A311",0xD0A311,"66 3B 4D CF 0F 10 45 BF 0F 95 C0 33 D2 66 3B 55 D4 0F 11 85 D4 FE FF FF");
	n.assertCode("VendingUI instance D0A358",0xD0A358,"89 85 50 FF FF FF");
	n.assertCode("VendingUI instance D0A378",0xD0A378,"8D B5 54 FF FF FF 03 F0");
	n.assertCode("VendingUI instance D0A3C6",0xD0A3C6,"0F B6 45 EF 66 89 85 40 FF FF FF");
	const keys=Exe.FindFunc("GetAsyncKeyState","USER32.dll");if(keys<0)throw Error("VendingUI: keyboard import missing");
	const code=bytes.slice(start),[phy,vir]=Exe.Allocate(size,16);
	for(let i=0;i<count;++i){const off=u32(bytes,32+i*4);if(off+4>size || u32(code,off)>=size)throw Error("VendingUI: invalid relocation");put(code,off,u32(code,off)+vir);}
	const e=name=>vir+meta.exports[name];
	const table=n.allocateBytes(new Array(4+n.FrameVtableEntries*4).fill(0),4);Exe.SetHex(table.phy,Exe.GetHex(Exe.Vir2Phy(n.FrameVtable-4),table.size));
	for(const [slot,name] of [[0,"@VendingDestroy@12"],[20,"@VendingDraw@8"],[25,"@VendingDown@16"],[27,"@VendingDrag@16"],[28,"@VendingMove@16"],[30,"@VendingCursor@16"],[31,"@VendingUp@16"],[32,"@VendingRightDown@16"],[33,"@VendingRightUp@16"],[35,"@VendingWheel@12"]])Exe.SetUint32(table.phy+4+slot*4,e(name));
	const editTable=n.allocateBytes(new Array(4+58*4).fill(0),4);Exe.SetHex(editTable.phy,Exe.GetHex(Exe.Vir2Phy(0x1028908-4),editTable.size));Exe.SetUint32(editTable.phy+4+20*4,e("@VendingEditDraw@8"));Exe.SetUint32(editTable.phy+4+37*4,e("@VendingEditEvent@32"));
	const refs=n.resolvePacketRefs(),fit=n.allocateCode(VipUI.nativeDrawing.fit(11,false,false)),caption=n.allocateCode(VipUI.nativeDrawing.fit(12,true,true));
	const art={resolver:e("_VendingResource@4"),blit:n.allocateCode(n.buildColorKeyBlit()).vir,format:n.buildResourcePath("item\\%s.bmp").vir,path:n.allocateBytes(new Array(512).fill(0),4).vir};
	const item=n.allocateCode(VipUI.nativeDrawing.item(art)),describe=n.allocateCode(VipUI.nativeDrawing.describe(art.resolver));
	const name={vir:e("_VendingName@8")};
	const blend=n.allocateCode(ModernChatUI.nativeHelpers.buildBlendPixel()),rawPng=n.allocateCode(ModernChatUI.nativeHelpers.buildPngDraw(blend.vir));
	// Private adapter preserves this frame's opaque surface mode after PNG alpha.
	const draw=n.asm();draw.emit(0x55,0x8B,0xEC,0x53,0x56,0x8B,0x71,0x24,0x85,0xF6);draw.jcc(0x84,"done");
	draw.emit(0x0F,0xB6,0x5E,0x28);for(const off of [20,16,12,8])draw.emit(0xFF,0x75,off);
	draw.call(rawPng.vir);draw.emit(0x88,0x5E,0x28);draw.label("done");draw.emit(0x5E,0x5B,0x5D,0xC2,16,0);
	const png=n.allocateCode(draw),paths=VendingUI.assets().map(p=>p.replace(/\//g,'\\'));
	[1,table.vir+4,refs.packetCtorA,refs.packetSend,fit.vir,item.vir,describe.vir,name.vir,png.vir,keys,editTable.vir+4,caption.vir,...paths.map(p=>n.buildResourcePath(p).vir)].forEach((v,i)=>put(code,api+i*4,v));
	for(let i=0;i<code.length;i+=4096)Exe.SetHex(phy+i,n.bytesToHex(code.slice(i,i+4096)));
	const receivers=[];
	for(const r of routes){
		const a=n.asm();a.emit(0x9C,0x60,0x68);a.dword(n.PacketBuffer);a.call(e("_VendingReceive@4"));
		{a.emit(0x85,0xC0);a.jcc(0x84,"stock");a.emit(0x61,0x9D);a.jmp(n.PacketMainLoopReturn);}
		a.label("stock");a.emit(0x61,0x9D);a.jmp(r.original);const handler=n.allocateCode(a);Exe.SetUint32(r.phy,handler.vir);receivers.push(handler.vir);
	}
	// Extend only the native walk-request call, not the shared helper used by
	// trades, skills, or other UIs. All registers/flags survive the private check.
	const walk=n.asm();walk.emit(0x9C,0x60);walk.call(e("_VendingBlocksWalk@0"));walk.emit(0x85,0xC0);walk.jcc(0x84,"stock");walk.emit(0x61,0x9D,0xB0,0x01,0xC3);walk.label("stock");walk.emit(0x61,0x9D);walk.jmp(0xC86150);
	Exe.SetCALL(Exe.Vir2Phy(0xC8F852),n.allocateCode(walk).vir);
	const switchShop=n.asm();switchShop.emit(0x9C,0x60);switchShop.call(e("_VendingSwitchShop@0"));switchShop.emit(0x61,0x9D,0xB8);switchShop.dword(0x130);switchShop.jmp(0xC8E63B);
	Exe.SetJMP(Exe.Vir2Phy(0xC8E636),n.allocateCode(switchShop).vir);
	const record=[];for(const v of [n.allocateString("VendingUI.v1").vir,...names.map(e),...receivers])record.push(v&255,v>>>8&255,v>>>16&255,v>>>24);n.allocateBytes(record,4);
	VendingUI.onApplied();return true;
};
VendingUI.validate=()=>Exe.BuildDate===20250716;
VendingUI.assets=()=>["marketui/bg_building.png", "marketui/bg_buying.png", "marketui/bg_selling.png", "marketui/itembox_bg.png", "marketui/slot_sell.png", "marketui/slot_sellput.png", "marketui/slot_buy.png", "marketui/slot_sold.png", "marketui/itembox_00.png", "marketui/itembox_01.png", "marketui/itembox_02.png", "marketui/itembox_03.png", "marketui/itembox_04.png", "marketui/itembox_05.png", "marketui/buy_out.png", "marketui/buy_over.png", "marketui/buy_press.png", "marketui/openstore_out.png", "marketui/openstore_over.png", "marketui/openstore_press.png", "marketui/closestore_out.png", "marketui/closestore_over.png", "marketui/closestore_press.png", "genericsui/cancel_out.png", "genericsui/cancel_over.png", "genericsui/cancel_press.png", "marketui/tag_sold.png", "genericsui/ok_off.png", "genericsui/ok_out.png", "genericsui/ok_over.png", "genericsui/ok_press.png"];
VendingUI.onApplied=function()
{
	if(Warp.TestMode)return;
	const root=System.DirPath(Warp.TgtExe),folders=['data','texture',ModernChatUI.nativeHelpers.uiPrefix()],target=root+'/'+folders.join('/'),missing=[];
	for(const file of VendingUI.assets()){
		const existing=new BinFile(target+'/'+file,'r'),exists=existing.Valid;existing.Close();if(exists)continue;
		const source=new BinFile(Warp.Path+'/Assets/VendingUI/'+file,'r'),valid=source.Valid;source.Close();if(!valid)throw Error('VendingUI: missing bundled asset '+file);
		missing.push(file);
	}
	if(!missing.length)return;
	let path=root;for(const folder of folders){path+='/'+folder;if(!System.MkDir(path))throw Error('VendingUI: cannot create '+path);}
	for(const folder of ['marketui','genericsui'])if(!System.MkDir(target+'/'+folder))throw Error('VendingUI: cannot create '+target+'/'+folder);
	for(const file of missing)if(!System.Copy(Warp.Path+'/Assets/VendingUI/'+file,target+'/'+file,false))throw Error('VendingUI: cannot copy '+file);
};
