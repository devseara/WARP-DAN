		const store = `potion_drag_${index}_store`;
		const groupX = index % 2 === 0 ? 21 : 247;
		const groupY = (index < 2 ? 89 : 200) + 64;
		const trackX = groupX + 14;
		const rightX = groupX + 149;
		const rowVir = potionRowsVir + index * AutoCombatUIStatic.PotionRowSize;
		const valueVir = rowVir + (index < 2 ? AutoCombatUIStatic.PotionRowMinHpOffset :
