	a.label("snapshot_no_loot_details");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotItemRowsSize);
	a.jcc(0x82, "snapshot_no_item_rows");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotItemRowsOffset);
	a.emit(0xBF); a.dword(itemRowsVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.ItemRowsSize / 4);
	a.emit(0xF3, 0xA5);
	// Treat an exhausted configured item as an empty UI slot. Older map-server
	// builds may still serialize its saved item id together with quantity zero.
	for (let index = 0; index < AutoCombatUIStatic.ItemDynamicRows; index++)
	{
		const rowVir = itemRowsVir + index * AutoCombatUIStatic.ItemRowSize;
		const keep = `snapshot_item_${index}_keep`;
		a.emit(0x83, 0x3D); a.dword(rowVir + AutoCombatUIStatic.ItemRowIdOffset); a.emit(0);
		a.jcc(0x84, keep);
		a.emit(0x66, 0x83, 0x3D);
		a.dword(rowVir + AutoCombatUIStatic.ItemRowFlagsOffset + 2); a.emit(0);
		a.jcc(0x85, keep);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.ItemRowIdOffset); a.dword(0);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.ItemRowDelayMsOffset); a.dword(0);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.ItemRowFlagsOffset); a.dword(0);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.ItemRowDelayTextOffset); a.dword(0);
		a.label(keep);
	}
	a.emit(0x81, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.dword(AutoCombatUIStatic.FeatureItemRows);
	a.label("snapshot_no_item_rows");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotItemIconKeysSize);
	a.jcc(0x82, "snapshot_no_item_icons");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotItemIconKeysOffset);
	a.emit(0xBF); a.dword(itemIconKeysVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.ItemIconKeysSize / 4);
	a.emit(0xF3, 0xA5);
	a.emit(0x81, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.dword(AutoCombatUIStatic.FeatureItemIcons);
	a.label("snapshot_no_item_icons");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotPotionRowsSize);
	a.jcc(0x82, "snapshot_no_potion_rows");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotPotionRowsOffset);
	a.emit(0xBF); a.dword(potionRowsVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.PotionRowsSize / 4);
	a.emit(0xF3, 0xA5);
	for (let index = 0; index < AutoCombatUIStatic.PotionDynamicRows; index++)
	{
		const rowVir = potionRowsVir + index * AutoCombatUIStatic.PotionRowSize;
		const keep = `snapshot_potion_${index}_keep`;
		a.emit(0x83, 0x3D); a.dword(rowVir + AutoCombatUIStatic.PotionRowIdOffset); a.emit(0);
		a.jcc(0x84, keep);
		a.emit(0x66, 0x83, 0x3D);
		a.dword(rowVir + AutoCombatUIStatic.PotionRowQuantityOffset); a.emit(0);
		a.jcc(0x85, keep);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.PotionRowIdOffset); a.dword(0);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.PotionRowMinHpOffset); a.dword(0);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.PotionRowFlagsOffset); a.dword(0);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.PotionRowUiSlotOffset); a.dword(0);
		a.label(keep);
	}
	a.emit(0x81, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.dword(AutoCombatUIStatic.FeaturePotionRows);
	a.label("snapshot_no_potion_rows");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotPotionIconKeysSize);
	a.jcc(0x82, "snapshot_no_potion_icons");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotPotionIconKeysOffset);
	a.emit(0xBF); a.dword(potionIconKeysVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.PotionIconKeysSize / 4);
	a.emit(0xF3, 0xA5);
	a.emit(0x81, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.dword(AutoCombatUIStatic.FeaturePotionIcons);
	a.label("snapshot_no_potion_icons");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotMoveRowsSize);
	a.jcc(0x82, "snapshot_no_move_rows");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotMoveRowsOffset);
	a.emit(0xBF); a.dword(moveRowsVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.MoveRowsSize / 4);
	a.emit(0xF3, 0xA5);
	for (let index = 0; index < AutoCombatUIStatic.MoveDynamicRows; index++)
	{
		const rowVir = moveRowsVir + index * AutoCombatUIStatic.MoveRowSize;
		const keep = `snapshot_move_${index}_keep`;
		a.emit(0x83, 0x3D); a.dword(rowVir + AutoCombatUIStatic.MoveRowIdOffset); a.emit(0);
		a.jcc(0x84, keep);
		a.emit(0x66, 0x83, 0x3D);
		a.dword(rowVir + AutoCombatUIStatic.MoveRowKindOffset);
		a.emit(AutoCombatUIStatic.MoveKindItem);
		a.jcc(0x85, keep);
		a.emit(0x66, 0x83, 0x3D);
		a.dword(rowVir + AutoCombatUIStatic.MoveRowLevelOffset); a.emit(0);
		a.jcc(0x85, keep);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.MoveRowIdOffset); a.dword(0);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.MoveRowLevelOffset); a.dword(0);
		a.emit(0xC7, 0x05); a.dword(rowVir + AutoCombatUIStatic.MoveRowFlagsOffset); a.dword(0);
		a.label(keep);
	}
	a.emit(0x81, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.dword(AutoCombatUIStatic.FeatureMoveRows);
	a.label("snapshot_no_move_rows");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotMoveIconKeysSize);
	a.jcc(0x82, "snapshot_no_move_icons");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotMoveIconKeysOffset);
	a.emit(0xBF); a.dword(moveIconKeysVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.MoveIconKeysSize / 4);
	a.emit(0xF3, 0xA5);
	a.emit(0x81, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.dword(AutoCombatUIStatic.FeatureMoveIcons);
	a.label("snapshot_no_move_icons");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotBasicThresholdsSize);
	a.jcc(0x82, "snapshot_no_basic_thresholds");
	a.emit(0x0F, 0xB7, 0x86); a.dword(AutoCombatUIStatic.SnapshotBasicThresholdsOffset);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateNormalAttackSpThreshold);
	a.emit(0x0F, 0xB7, 0x86); a.dword(AutoCombatUIStatic.SnapshotBasicThresholdsOffset + 2);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateStopAttackSpThreshold);
	a.emit(0x81, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.dword(AutoCombatUIStatic.FeatureBasicThresholds);
	a.label("snapshot_no_basic_thresholds");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateReady);
	a.dword(1);
	a.emit(0x8B, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateWindow);
	a.emit(0x85, 0xFF);
	a.jcc(0x84, "settings_dirty_done");
	a.emit(0xC7, 0x47, AutoCombatUIStatic.WindowDirtyOffset);
	a.dword(1);
	a.label("settings_dirty_done");
	for (const windowOffset of [AutoCombatUIStatic.StateAutoBattleWindow])
	{
		a.emit(0x8B, 0x3D); a.dword(stateVir + windowOffset);
		a.emit(0x85, 0xFF);
		a.jcc(0x84, `controller_dirty_next_${windowOffset}`);
		a.emit(0xC7, 0x47, AutoCombatUIStatic.WindowDirtyOffset);
		a.dword(1);
		a.label(`controller_dirty_next_${windowOffset}`);
	}
	a.label("handled");
	a.emit(0x61, 0x9D);
	a.emit(0xB8); a.dword(AutoCombatUIStatic.PacketMainLoopReturn);
	a.emit(0xFF, 0xE0);
	a.label("fallback");
	a.emit(0x61, 0x9D);
	a.emit(0xA1); a.dword(route.fallbackCellVir);
	a.emit(0xFF, 0xE0);
	return a;
};

AutoCombatUIStatic.installSnapshotReceiver = function(_, stateVir, monsterRowsVir, attackSkillRowsVir, attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, healingSkillRowVir, healingSkillIconKeyVir, recoverySkillRowsVir, recoverySkillIconKeysVir, itemRowsVir, itemIconKeysVir, potionRowsVir, potionIconKeysVir, moveRowsVir, moveIconKeysVir)
{
	const entryVir = AutoCombatUIStatic.packetTableEntryVir(
		AutoCombatUIStatic.ServerPacketId
	);
	const entryPhy = Exe.Vir2Phy(entryVir, CODE);
	if (entryPhy < 0)
		throw Error("AutoCombatUI: could not resolve AHUI dispatcher entry");
	AutoCombatUIStatic.beginSharedPacketRoute(_);
	const route = AutoCombatUIStatic.ensureSharedPacketRoute(entryVir, entryPhy);
	AutoCombatUIStatic.endSharedPacketRoute(_);

	const stateKey = "AutoCombatUI.SnapshotReceiver.v11";
	const receiver = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildSnapshotReceiver(stateVir, monsterRowsVir, attackSkillRowsVir, attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, healingSkillRowVir, healingSkillIconKeyVir, recoverySkillRowsVir, recoverySkillIconKeysVir, itemRowsVir, itemIconKeysVir, potionRowsVir, potionIconKeysVir, moveRowsVir, moveIconKeysVir, route)
	);
	const ahuiHandlerCellPhy = route.ahuiHandlerCellPhy;
	const pincodeHandlerCellPhy = route.pincodeHandlerCellPhy;
	if (!Number.isInteger(ahuiHandlerCellPhy) || !Number.isInteger(pincodeHandlerCellPhy))
		throw Error("AutoCombatUI: shared 0x0BEF router cells are unavailable");
	const pincodeState = CACHE.get("InGamePincodeUI.State.StockUi.v8");
	AutoCombatUIStatic.beginSharedPacketRoute(_);
	if (Exe.GetUint32(entryPhy) !== route.routerVir)
		Exe.SetUint32(entryPhy, route.routerVir);
	if (pincodeState && pincodeState.entryVir === entryVir)
		Exe.SetUint32(pincodeHandlerCellPhy, pincodeState.handlerVir);
	Exe.SetUint32(ahuiHandlerCellPhy, receiver.vir);
	AutoCombatUIStatic.endSharedPacketRoute(_);

	CACHE.put(stateKey, {
		packetId: AutoCombatUIStatic.ServerPacketId,
		entryVir,
		handlerVir: receiver.vir,
		continueVir: route.fallbackVir,
		stateVir,
		monsterRowsVir,
		attackSkillRowsVir,
		attackSkillIconKeysVir,
		supportSkillRowsVir,
		supportSkillIconKeysVir,
		healingSkillRowVir,
		healingSkillIconKeyVir,
		recoverySkillRowsVir,
		recoverySkillIconKeysVir,
		itemRowsVir,
		itemIconKeysVir,
		potionRowsVir,
		potionIconKeysVir,
		routerVir: route.routerVir
	});
	return receiver.vir;
};

AutoCombatUIStatic.emitPreserveSurfaceAlpha = function(a, label)
{
	const done = `${label}_surface_alpha_done`;
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowSurfaceOffset);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, done);
	a.emit(0xC6, 0x40, AutoCombatUIStatic.SurfaceAlphaOffset, 0x01);
	a.label(done);
};

AutoCombatUIStatic.emitLoadSurface = function(a, pathVir, missingLabel)
{
	a.call(AutoCombatUIStatic.GetTexMgr);
	a.emit(0x8B, 0xD8, 0x85, 0xDB);
	a.jcc(0x84, missingLabel);
	AutoCombatUIStatic.pushImm(a, pathVir);
	a.call(AutoCombatUIStatic.ConvPath);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, missingLabel);
	a.emit(0x50, 0x8B, 0xCB);
	a.call(AutoCombatUIStatic.LoadSurface);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, missingLabel);
};

AutoCombatUIStatic.emitDrawFull = function(a, pathVir, x, y, label)
{
	const done = `${label}_done`;
	AutoCombatUIStatic.emitLoadSurface(a, pathVir, done);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.ImageDraw);
	a.label(done);
};

AutoCombatUIStatic.emitDrawColorKeyFull = function(a, pathVir, x, y, label)
{
	const done = `${label}_done`;
	AutoCombatUIStatic.emitLoadSurface(a, pathVir, done);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x50, 0x56);
	a.call(AutoCombatUIStatic.ColorKeyBlitVir);
	a.label(done);
};


AutoCombatUIStatic.readBakedTga = function(relativePath)
{
	const fullPath = Warp.Path + "/" + relativePath;
	const handle = new BinFile(fullPath, 'r');
	if (!handle.Valid)
		throw Error(`AutoCombatUI: unable to read baked controller frame ${fullPath}`);
	const hex = handle.ReadHex();
	handle.Close();
	const pairs = hex.match(/[0-9A-Fa-f]{2}/g) || [];
	const bytes = pairs.map(value => parseInt(value, 16));
	if (bytes.length < 18 || bytes[1] !== 0 || bytes[2] !== 2 || bytes[16] !== 32)
		throw Error(`AutoCombatUI: unsupported baked TGA ${relativePath}`);
	const width = bytes[12] | (bytes[13] << 8);
	const height = bytes[14] | (bytes[15] << 8);
	if (width !== AutoCombatUIStatic.ControllerSize ||
		height !== AutoCombatUIStatic.ControllerSize)
	{
		throw Error(
			`AutoCombatUI: baked TGA ${relativePath} is ${width}x${height}, ` +
			`expected ${AutoCombatUIStatic.ControllerSize}x${AutoCombatUIStatic.ControllerSize}`
		);
	}
	const dataOffset = 18 + bytes[0];
	const rowBytes = width * 4;
	if (dataOffset + rowBytes * height > bytes.length)
		throw Error(`AutoCombatUI: truncated baked TGA ${relativePath}`);
	const topOrigin = (bytes[17] & 0x20) !== 0;
	const rightOrigin = (bytes[17] & 0x10) !== 0;
	const pixels = new Array(rowBytes * height);
	for (let y = 0; y < height; ++y)
	{
		const sourceY = topOrigin ? y : height - 1 - y;
		for (let x = 0; x < width; ++x)
		{
			const sourceX = rightOrigin ? width - 1 - x : x;
			const source = dataOffset + sourceY * rowBytes + sourceX * 4;
			const target = (y * width + x) * 4;
			pixels[target] = bytes[source];
			pixels[target + 1] = bytes[source + 1];
			pixels[target + 2] = bytes[source + 2];
			pixels[target + 3] = bytes[source + 3];
		}
	}
	return pixels;
};

AutoCombatUIStatic.allocateBakedSurface = function(relativePath)
{
	const descriptor = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.TextureDescriptorSize).fill(0), 4
	);
	const pixels = AutoCombatUIStatic.allocateBytes(
		AutoCombatUIStatic.readBakedTga(relativePath), 4
	);
	Exe.SetUint32(
		descriptor.phy + AutoCombatUIStatic.TextureWidthOffset,
		AutoCombatUIStatic.ControllerSize
	);
	Exe.SetUint32(
		descriptor.phy + AutoCombatUIStatic.TextureHeightOffset,
		AutoCombatUIStatic.ControllerSize
	);
	Exe.SetUint32(
		descriptor.phy + AutoCombatUIStatic.TexturePixelsOffset,
		pixels.vir
	);
	return {
		descriptorPhy: descriptor.phy,
		descriptorVir: descriptor.vir,
		pixelsVir: pixels.vir
	};
};

AutoCombatUIStatic.buildBakedSurfaceInitializer = function(referencePathVir, surfaces)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	a.emit(0x83, 0x3D); a.dword(
		surfaces[0].descriptorVir + AutoCombatUIStatic.TextureReadyOffset
	); a.emit(0x01);
	a.jcc(0x84, "baked_done");
	AutoCombatUIStatic.emitLoadSurface(a, referencePathVir, "baked_done");
	a.emit(0x8B, 0x98); a.dword(AutoCombatUIStatic.TextureFlagsOffset);
	for (const surface of surfaces)
	{
		a.emit(0x89, 0x1D); a.dword(
			surface.descriptorVir + AutoCombatUIStatic.TextureFlagsOffset
		);
		a.emit(0xC7, 0x05); a.dword(
			surface.descriptorVir + AutoCombatUIStatic.TextureReadyOffset
		); a.dword(1);
	}
	a.label("baked_done");
	a.emit(0x61, 0x9D, 0xC3);
	return a;
};

AutoCombatUIStatic.prepareControllerVisual = function(group, referencePath)
{
	const prepared = {initializers: [], surfaces: []};
	const prepare = function(name)
	{
		const relativePath =
			`${AutoCombatUIStatic.ControllerAssetPath}/${group}/${name}`;
		const surface = AutoCombatUIStatic.allocateBakedSurface(relativePath);
		prepared.surfaces.push(surface);
		return surface;
	};
	prepared.activeFrames = [];
	for (let index = 0; index < AutoCombatUIStatic.ControllerFrameCount; ++index)
		prepared.activeFrames.push(prepare(`active_${index.toString().padStart(2, "0")}.tga`));
	prepared.inactive = prepare("inactive.tga");
	const initializer = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildBakedSurfaceInitializer(
			referencePath.vir, prepared.surfaces
		)
	);
	prepared.initializers.push(initializer.vir);
	return prepared;
};

AutoCombatUIStatic.emitDrawSurface = function(a, surface, x, y)
{
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, surface.descriptorVir);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.ImageDraw);
};

AutoCombatUIStatic.buildColorKeyBlit = function()
{
	const a = AutoCombatUIStatic.asm();
	// stdcall(window, sourceTexture, x, y). AutoHunt renders into one opaque
	// parent surface, so use a local magenta color-key copy instead of changing
	// the stock ImageDraw behavior used by the Skill Bar and every other UI.
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x18, 0x53, 0x56, 0x57);
	a.emit(0x8B, 0x75, 0x08, 0x85, 0xF6); a.jcc(0x84, "done");
	a.emit(0x8B, 0x76, AutoCombatUIStatic.WindowSurfaceOffset, 0x85, 0xF6);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x7E, AutoCombatUIStatic.SurfacePixelsOffset, 0x85, 0xFF);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x5E, AutoCombatUIStatic.SurfaceWidthOffset, 0x85, 0xDB);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x45, 0x14, 0x0F, 0xAF, 0xC3, 0x03, 0x45, 0x10);
	a.emit(0x8D, 0x3C, 0x87, 0x89, 0x7D, 0xFC);
	a.emit(0xC1, 0xE3, 0x02, 0x89, 0x5D, 0xEC);
	a.emit(0x8B, 0x75, 0x0C, 0x85, 0xF6); a.jcc(0x84, "done");
	a.emit(0x8B, 0x86); a.dword(AutoCombatUIStatic.TextureWidthOffset);
	a.emit(0x85, 0xC0); a.jcc(0x84, "done");
	a.emit(0x89, 0x45, 0xF4, 0x8D, 0x04, 0x85); a.dword(0);
	a.emit(0x89, 0x45, 0xE8);
	a.emit(0x8B, 0x86); a.dword(AutoCombatUIStatic.TextureHeightOffset);
	a.emit(0x85, 0xC0); a.jcc(0x84, "done");
	a.emit(0x89, 0x45, 0xF0);
	a.emit(0x8B, 0xB6); a.dword(AutoCombatUIStatic.TexturePixelsOffset);
	a.emit(0x85, 0xF6); a.jcc(0x84, "done");
	a.emit(0x89, 0x75, 0xF8);
	a.label("row");
	a.emit(0x8B, 0x7D, 0xFC, 0x8B, 0x75, 0xF8, 0x8B, 0x4D, 0xF4);
	a.label("pixel");
	a.emit(0x8B, 0x06, 0x8B, 0xD0, 0x81, 0xE2); a.dword(0x00FFFFFF);
	a.emit(0x81, 0xFA); a.dword(0x00FF00FF);
	a.jcc(0x84, "skip_pixel");
	a.emit(0x89, 0x07);
	a.label("skip_pixel");
	a.emit(0x83, 0xC6, 0x04, 0x83, 0xC7, 0x04, 0x49);
	a.jcc(0x85, "pixel");
	a.emit(0x01, 0x5D, 0xFC, 0x8B, 0x45, 0xE8, 0x01, 0x45, 0xF8);
	a.emit(0xFF, 0x4D, 0xF0); a.jcc(0x85, "row");
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x10, 0x00);
	return a;
};

AutoCombatUIStatic.emitDrawSkillIcon = function(
	a, fillRectVir, iconKeyVir, iconFormatVir, iconPathVir, x, y, fallbackColor, label
)
{
	const missing = `${label}_missing`;
	const done = `${label}_done`;
	a.emit(0x80, 0x3D); a.dword(iconKeyVir); a.emit(0x00);
	a.jcc(0x84, missing);
	AutoCombatUIStatic.pushImm(a, iconKeyVir);
	AutoCombatUIStatic.pushImm(a, iconFormatVir);
	AutoCombatUIStatic.pushImm(a, iconPathVir);
	a.call(AutoCombatUIStatic.StringFormat);
	a.emit(0x83, 0xC4, 0x0C);
	AutoCombatUIStatic.emitLoadSurface(a, iconPathVir, missing);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x50, 0x56);
	a.call(AutoCombatUIStatic.ColorKeyBlitVir);
	a.jmp(done);
	a.label(missing);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 2, y + 2, 20, 20, fallbackColor);
	a.label(done);
};

AutoCombatUIStatic.buildItemIconResolver = function()
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x56);
	a.emit(0x8B, 0x35); a.dword(AutoCombatUIStatic.ItemInfoManager);
	a.emit(0x85, 0xF6); a.jcc(0x84, "missing");
	// CItemInfoMgr's native map lookup takes a pointer to the item ID and
	// returns its item-info node. Identified inventory resources are stored as
	// std::string at node + 0x58, exactly as used by the stock Item Bar.
	a.emit(0x8D, 0x45, 0x08, 0x50, 0x8D, 0x4E, 0x08);
	a.call(AutoCombatUIStatic.ItemInfoLookup);
	a.emit(0x85, 0xC0); a.jcc(0x84, "missing");
	a.emit(0x83, 0xC0); a.emit(AutoCombatUIStatic.ItemInfoIdentifiedResourceOffset);
	a.emit(0x83, 0x78); a.emit(AutoCombatUIStatic.ItemInfoStringCapacityOffset); a.emit(0x10);
	a.jcc(0x82, "done");
	a.emit(0x8B, 0x00);
	a.jmp("done");
	a.label("missing");
	a.emit(0x33, 0xC0);
	a.label("done");
	a.emit(0x5E, 0x5D, 0xC2, 0x04, 0x00);
	return a;
};

AutoCombatUIStatic.emitDrawItemIcon = function(
	a, fillRectVir, itemIdVir, itemResolverVir, iconFormatVir, iconPathVir,
	x, y, fallbackColor, label
)
{
	const missing = `${label}_missing`;
	const done = `${label}_done`;
	a.emit(0xA1); a.dword(itemIdVir);
	a.emit(0x85, 0xC0); a.jcc(0x84, missing);
	a.emit(0x50);
	a.call(itemResolverVir);
	a.emit(0x85, 0xC0); a.jcc(0x84, missing);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, iconFormatVir);
	AutoCombatUIStatic.pushImm(a, iconPathVir);
	a.call(AutoCombatUIStatic.StringFormat);
	a.emit(0x83, 0xC4, 0x0C);
	AutoCombatUIStatic.emitLoadSurface(a, iconPathVir, missing);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x50, 0x56);
	a.call(AutoCombatUIStatic.ColorKeyBlitVir);
	a.jmp(done);
	a.label(missing);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 2, y + 2, 20, 20, fallbackColor);
	a.label(done);
};
AutoCombatUIStatic.emitDrawSkillLevel = function(
	a, fillRectVir, skillLevelVir, levelFormatVir, levelTextVir, x, y
)
{
	a.emit(0x0F, 0xB7, 0x05); a.dword(skillLevelVir);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, levelFormatVir);
	AutoCombatUIStatic.pushImm(a, levelTextVir);
	a.call(AutoCombatUIStatic.StringFormat);
	a.emit(0x83, 0xC4, 0x0C);
	// Match the stock shortcut/item bars: right-align the level or quantity at
	// the slot's lower-right edge. Keeping it below the item artwork prevents
	// dark icons from swallowing the native black counter.
	AutoCombatUIStatic.emitRightAlignedText(
		a, levelTextVir, x + 34, y + 18, 13, 0x00000000, 1
	);
};

AutoCombatUIStatic.emitFillRect = function(a, fillRectVir, x, y, width, height, color)
{
	AutoCombatUIStatic.pushImm(a, color);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, width);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x56);
	a.call(fillRectVir);
};

AutoCombatUIStatic.emitHorizontalSlider = function(
	a, fillRectVir, valueVir, x, y, width, label
)
{
	// Draw a dark outer rail, a white inset, and a pale empty track. The
	// supplied BSON already contains the rounded field; these inset layers
	// increase contrast without spilling beyond that native outline.
	AutoCombatUIStatic.emitFillRect(
		a, fillRectVir, x - 1, y - 2, width + 2, 7, 0xFF6A82A4
	);
	AutoCombatUIStatic.emitFillRect(
		a, fillRectVir, x, y - 1, width, 5, 0xFFFFFFFF
	);
	AutoCombatUIStatic.emitFillRect(
		a, fillRectVir, x + 1, y, width - 2, 3, 0xFFDCE8F6
	);

	a.emit(0x53);
	a.emit(0xA1); a.dword(valueVir);
	a.emit(0x83, 0xF8, 0x64);
	a.jcc(0x86, `${label}_clamped`);
	a.emit(0xB8); a.dword(100);
	a.label(`${label}_clamped`);
	a.emit(0x69, 0xC0); a.dword(width - 2);
	a.emit(0x33, 0xD2, 0xB9); a.dword(100);
	a.emit(0xF7, 0xF1);
	a.emit(0x8B, 0xD8);
	a.emit(0x85, 0xDB);
	a.jcc(0x84, `${label}_fill_done`);
	AutoCombatUIStatic.pushImm(a, 0xFF4F91D7);
	AutoCombatUIStatic.pushImm(a, 3);
	a.emit(0x53);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x + 1);
	a.emit(0x56);
	a.call(fillRectVir);
	a.label(`${label}_fill_done`);

	// Keep the thumb entirely inside the rail at both 0% and 100%.
	a.emit(0x81, 0xFB); a.dword(width - 3);
	a.jcc(0x86, `${label}_thumb_clamped`);
	a.emit(0xBB); a.dword(width - 3);
	a.label(`${label}_thumb_clamped`);
	a.emit(0x8D, 0x83); a.dword(x - 1);
	AutoCombatUIStatic.pushImm(a, 0xFF4C6384);
	AutoCombatUIStatic.pushImm(a, 7);
	AutoCombatUIStatic.pushImm(a, 5);
	AutoCombatUIStatic.pushImm(a, y - 2);
	a.emit(0x50, 0x56);
	a.call(fillRectVir);
	a.emit(0x8D, 0x83); a.dword(x);
	AutoCombatUIStatic.pushImm(a, 0xFFFFFFFF);
	AutoCombatUIStatic.pushImm(a, 5);
	AutoCombatUIStatic.pushImm(a, 3);
	AutoCombatUIStatic.pushImm(a, y - 1);
	a.emit(0x50, 0x56);
	a.call(fillRectVir);
	a.emit(0x5B);
};

AutoCombatUIStatic.emitText = function(a, textVir, x, y, height, color, bold = 0)
{
	if (!Number.isInteger(textVir) || textVir <= 0)
		throw Error("AutoCombatUI: invalid native text pointer");
	// Native order is TextDraw(x, y, text, count, fontSelector, height,
	// color, bold, italic). Keep selector 1 for the stock UI font and pass
	// emphasis through the actual LOGFONT weight flag.
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, bold);
	AutoCombatUIStatic.pushImm(a, color);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, 1);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, textVir);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.TextDraw);
};
AutoCombatUIStatic.emitCenteredText = function(
	a, textVir, left, y, width, height, color, maxChars, label, bold = 0
)
{
	if (!Number.isInteger(textVir) || textVir <= 0)
		throw Error("AutoCombatUI: invalid centered text pointer");
	a.emit(0x53);
	// Use the client's active font metrics. Fixed-width estimates drift on bold
	// headings and make otherwise-correct text look off-center in painted bands.
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, bold);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, 1);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, textVir);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.TextWidth);
	a.emit(0xBB); a.dword(width);
	a.emit(0x2B, 0xD8, 0xD1, 0xFB);
	a.emit(0x81, 0xC3); a.dword(left);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, bold);
	AutoCombatUIStatic.pushImm(a, color);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, 1);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, textVir);
	AutoCombatUIStatic.pushImm(a, y);
	a.emit(0x53, 0x8B, 0xCE);
	a.call(AutoCombatUIStatic.TextDraw);
	a.emit(0x5B);
};
AutoCombatUIStatic.emitRightAlignedText = function(
	a, textVir, right, y, height, color, bold = 1
)
{
	if (!Number.isInteger(textVir) || textVir <= 0)
		throw Error("AutoCombatUI: invalid right-aligned text pointer");
	a.emit(0x53);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, bold);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, 1);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, textVir);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.TextWidth);
	a.emit(0xBB); a.dword(right);
	a.emit(0x2B, 0xD8);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, bold);
	AutoCombatUIStatic.pushImm(a, color);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, 1);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, textVir);
	AutoCombatUIStatic.pushImm(a, y);
	a.emit(0x53, 0x8B, 0xCE);
	a.call(AutoCombatUIStatic.TextDraw);
	a.emit(0x5B);
};
AutoCombatUIStatic.emitDrawNativeHealingSlider = function(
	a, stateVir, paths, fillRectVir, valueVir, label
)
{
	const drawArrow = function(controlId, normal, over, pressed, x, suffix)
	{
		const hover = `${label}_${suffix}_hover`;
		const normalDraw = `${label}_${suffix}_normal`;
		const done = `${label}_${suffix}_done`;
		a.emit(0x83, 0x3D);
		a.dword(stateVir + AutoCombatUIStatic.StatePressedControl);
		a.emit(controlId);
		a.jcc(0x85, hover);
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, pressed.vir, x, AutoCombatUIStatic.HealingSliderGroupY,
			`${label}_${suffix}_pressed_draw`
		);
		a.jmp(done);
		a.label(hover);
		a.emit(0x83, 0x3D);
		a.dword(stateVir + AutoCombatUIStatic.StateHoverControl);
		a.emit(controlId);
		a.jcc(0x85, normalDraw);
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, over.vir, x, AutoCombatUIStatic.HealingSliderGroupY,
			`${label}_${suffix}_over_draw`
		);
		a.jmp(done);
		a.label(normalDraw);
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, normal.vir, x, AutoCombatUIStatic.HealingSliderGroupY,
			`${label}_${suffix}_normal_draw`
		);
		a.label(done);
	};

	// The BSON already owns the empty rounded rail. Draw only the clipped
	// native gauge, thumb, and arrows so the controls do not double its border.
	const gaugeMissing = `${label}_gauge_missing`;
	AutoCombatUIStatic.emitLoadSurface(a, paths.sliderGaugeHp.vir, gaugeMissing);
	a.emit(0x53, 0x8B, 0xD8);
	a.emit(0xA1); a.dword(valueVir);
	a.emit(0x83, 0xF8, 0x64);
	a.jcc(0x86, `${label}_gauge_value_clamped`);
	a.emit(0xB8); a.dword(100);
	a.label(`${label}_gauge_value_clamped`);
	a.emit(0x69, 0xC0); a.dword(AutoCombatUIStatic.HealingSliderThumbTravel);
	a.emit(0x33, 0xD2, 0xB9); a.dword(100);
	a.emit(0xF7, 0xF1, 0x83, 0xC0, 0x07);
	// ImageDrawRect(x, y, surface, alpha, useFullRect, sx, sy, sw, sh).
	AutoCombatUIStatic.pushImm(a, 9);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x53);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.HealingSliderTrackY);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.HealingSliderTrackX);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.ImageDrawRect);
	a.emit(0x5B);
	a.label(gaugeMissing);

	const thumbMissing = `${label}_thumb_missing`;
	a.emit(0x53);
	AutoCombatUIStatic.emitLoadSurface(a, paths.sliderThumbHp.vir, thumbMissing);
	a.emit(0x8B, 0xD8);
	a.emit(0xA1); a.dword(valueVir);
	a.emit(0x83, 0xF8, 0x64);
	a.jcc(0x86, `${label}_thumb_value_clamped`);
	a.emit(0xB8); a.dword(100);
	a.label(`${label}_thumb_value_clamped`);
	a.emit(0x69, 0xC0); a.dword(AutoCombatUIStatic.HealingSliderThumbTravel);
	a.emit(0x33, 0xD2, 0xB9); a.dword(100);
	a.emit(0xF7, 0xF1);
	a.emit(0x05); a.dword(AutoCombatUIStatic.HealingSliderTrackX);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.HealingSliderThumbY);
	a.emit(0x50, 0x53, 0x56);
	a.call(AutoCombatUIStatic.ColorKeyBlitVir);
	a.label(thumbMissing);
	a.emit(0x5B);

	drawArrow(
		5, paths.sliderLeft, paths.sliderLeftOver, paths.sliderLeftPressed,
		AutoCombatUIStatic.HealingSliderGroupX, "left"
	);
	drawArrow(
		6, paths.sliderRight, paths.sliderRightOver, paths.sliderRightPressed,
		AutoCombatUIStatic.HealingSliderRightArrowX, "right"
	);
};

AutoCombatUIStatic.emitDrawNativePotionSlider = function(
	a, stateVir, paths, fillRectVir, valueVir, isSp, groupX, groupY,
	controlBase, label
)
{
	const trackX = groupX + 14;
	const trackY = groupY + 5;
	const rightX = groupX + 149;
	const thumbY = groupY + 2;
	const gaugePath = isSp ? paths.sliderGaugeSp : paths.sliderGaugeHp;
	const thumbPath = isSp ? paths.sliderThumbSp : paths.sliderThumbHp;
	const drawArrow = function(controlId, normal, over, pressed, x, suffix)
	{
		const hover = `${label}_${suffix}_hover`;
		const normalDraw = `${label}_${suffix}_normal`;
		const done = `${label}_${suffix}_done`;
		a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StatePressedControl);
		a.emit(controlId);
		a.jcc(0x85, hover);
		AutoCombatUIStatic.emitDrawColorKeyFull(a, pressed.vir, x, groupY,
			`${label}_${suffix}_pressed_draw`);
		a.jmp(done);
		a.label(hover);
		a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateHoverControl);
		a.emit(controlId);
		a.jcc(0x85, normalDraw);
		AutoCombatUIStatic.emitDrawColorKeyFull(a, over.vir, x, groupY,
			`${label}_${suffix}_over_draw`);
		a.jmp(done);
		a.label(normalDraw);
		AutoCombatUIStatic.emitDrawColorKeyFull(a, normal.vir, x, groupY,
			`${label}_${suffix}_normal_draw`);
		a.label(done);
	};

	const gaugeMissing = `${label}_gauge_missing`;
	AutoCombatUIStatic.emitLoadSurface(a, gaugePath.vir, gaugeMissing);
	a.emit(0x53, 0x8B, 0xD8);
	a.emit(0x0F, 0xB7, 0x05); a.dword(valueVir);
	a.emit(0x83, 0xF8, 0x64);
	a.jcc(0x86, `${label}_gauge_value_clamped`);
	a.emit(0xB8); a.dword(100);
	a.label(`${label}_gauge_value_clamped`);
	a.emit(0x69, 0xC0); a.dword(AutoCombatUIStatic.HealingSliderThumbTravel);
	a.emit(0x33, 0xD2, 0xB9); a.dword(100);
	a.emit(0xF7, 0xF1, 0x83, 0xC0, 0x07);
	AutoCombatUIStatic.pushImm(a, 9);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x53);
	AutoCombatUIStatic.pushImm(a, trackY);
	AutoCombatUIStatic.pushImm(a, trackX);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.ImageDrawRect);
	a.emit(0x5B);
	a.label(gaugeMissing);

	const thumbMissing = `${label}_thumb_missing`;
	a.emit(0x53);
	AutoCombatUIStatic.emitLoadSurface(a, thumbPath.vir, thumbMissing);
	a.emit(0x8B, 0xD8);
	a.emit(0x0F, 0xB7, 0x05); a.dword(valueVir);
	a.emit(0x83, 0xF8, 0x64);
	a.jcc(0x86, `${label}_thumb_value_clamped`);
	a.emit(0xB8); a.dword(100);
	a.label(`${label}_thumb_value_clamped`);
	a.emit(0x69, 0xC0); a.dword(AutoCombatUIStatic.HealingSliderThumbTravel);
	a.emit(0x33, 0xD2, 0xB9); a.dword(100);
	a.emit(0xF7, 0xF1);
	a.emit(0x05); a.dword(trackX);
	AutoCombatUIStatic.pushImm(a, thumbY);
	a.emit(0x50, 0x53, 0x56);
	a.call(AutoCombatUIStatic.ColorKeyBlitVir);
	a.label(thumbMissing);
	a.emit(0x5B);

	drawArrow(controlBase, paths.sliderLeft, paths.sliderLeftOver,
		paths.sliderLeftPressed, groupX, "left");
	drawArrow(controlBase + 1, paths.sliderRight, paths.sliderRightOver,
		paths.sliderRightPressed, rightX, "right");
};
AutoCombatUIStatic.emitDrawNativeLootSlider = function(
