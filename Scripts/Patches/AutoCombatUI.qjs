	a.emit(0x8B, 0x45, 0x0C, 0x83, 0xE8, 0x18, 0x89, 0x45, 0xFC);
	a.emit(0x8D, 0x45, 0xFC, 0x50, 0x8D, 0x45, 0xF8, 0x50);
