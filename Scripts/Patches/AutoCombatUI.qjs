	);
	a.jmp("body_done");
	a.label("body_looting");
	a.emit(0x83, 0xF8, 0x04);
	a.jcc(0x85, "body_move");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage);
	a.emit(0x83, 0xF8, 0x01);
	a.jcc(0x85, "body_looting_2");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.looting1.vir, 0, AutoCombatUIStatic.TabsBottom, "body_looting_1_page"
	);
	a.jmp("body_done");
	a.label("body_looting_2");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.looting2.vir, 0, AutoCombatUIStatic.TabsBottom, "body_looting_2_page"
	);
	a.jmp("body_done");
	a.label("body_move");
	a.emit(0x83, 0xF8, 0x05);
	a.jcc(0x85, "body_item");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.move.vir, 0, AutoCombatUIStatic.TabsBottom, "body_move_page"
	);
	a.jmp("body_done");
	a.label("body_item");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.item.vir, 0, AutoCombatUIStatic.TabsBottom, "body_item_page"
	);
	a.label("body_done");
};

AutoCombatUIStatic.emitChrome = function(a, stateVir, fillRectVir, strings)
{
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 0, 0, 470, 17, 0xFF7E97BE);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 1, 1, 468, 15, 0xFFDDEBFA);
	for (let y = 3; y < 15; y += 2)
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, 2, y, 466, 1, 0xFFEEF5FD);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 0, 16, 470, 1, 0xFF7892BA);
	for (const x of [6, 441, 456])
	{
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, 6, 7, 7, 0xFF708FC1);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, 6, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 5, 6, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, 11, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 5, 11, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 2, 8, 3, 3, 0xFFDDEBFA);
	}

	const widths = [67, 67, 67, 67, 67, 67, 68];
	let left = 0;
	for (let index = 0; index < 7; index++)
	{
		const normalLabel = `tab_${index}_normal`;
		const doneLabel = `tab_${index}_done`;
		a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab);
		a.emit(0x00 + index);
		a.jcc(0x85, normalLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, widths[index], 21, 0xFFD8E7FA
		);
		a.jmp(doneLabel);
		a.label(normalLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, widths[index], 21, 0xFFF2F6FC
		);
		a.label(doneLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, 1, 21, 0xFF97ADCF
		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 37, widths[index], 1, 0xFF97ADCF
		);
		AutoCombatUIStatic.emitText(
				a, strings.tabs[index].vir, left + 14, 20, 14, 0x00844E30
		);
		left += widths[index];
	}
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 469, 17, 1, 21, 0xFF97ADCF);
};

AutoCombatUIStatic.emitPageText = function(a, stateVir, strings)
{
	const emitPair = function(heading, subtitle, headingX, subtitleX)
	{
		AutoCombatUIStatic.emitText(a, heading.vir, headingX, 42, 15, 0x0078432C);
		AutoCombatUIStatic.emitText(a, subtitle.vir, subtitleX, 60, 14, 0x00B27E41);
	};
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x00); a.jcc(0x85, "text_monster");
	emitPair(strings.headings[0], strings.subtitles[0], 112, 53);
	a.jmp("page_text_done");
	a.label("text_monster");
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_skill");
	emitPair(strings.headings[1], strings.subtitles[1], 131, 126);
	a.jmp("page_text_done");
	a.label("text_skill");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "text_potion");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_skill_2");
	emitPair(strings.skillHeadings[0], strings.skillSubtitles[0], 178, 139);
	AutoCombatUIStatic.emitText(a, strings.attackSettings.vir, 177, 87, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.normalAttack.vir, 48, 276, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_skill_2");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "text_skill_3");
	emitPair(strings.skillHeadings[1], strings.skillSubtitles[1], 174, 128);
	AutoCombatUIStatic.emitText(a, strings.supportSettings.vir, 170, 87, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_skill_3");
	emitPair(strings.skillHeadings[2], strings.skillSubtitles[2], 158, 126);
	AutoCombatUIStatic.emitText(a, strings.healSettings.vir, 76, 87, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.statusSettings.vir, 304, 87, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_potion");
	a.emit(0x83, 0xF8, 0x03); a.jcc(0x85, "text_looting");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StatePotionPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_potion_2");
	emitPair(strings.potionHeadings[0], strings.potionSubtitles[0], 139, 78);
	a.jmp("page_text_done");
	a.label("text_potion_2");
	emitPair(strings.potionHeadings[1], strings.potionSubtitles[1], 130, 112);
	AutoCombatUIStatic.emitText(a, strings.statusPotion.vir, 164, 87, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_looting");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x85, "text_move");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_looting_2");
	emitPair(strings.lootingHeadings[0], strings.lootingSubtitles[0], 159, 112);
	AutoCombatUIStatic.emitText(a, strings.weight.vir, 198, 104, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_looting_2");
	emitPair(strings.lootingHeadings[1], strings.lootingSubtitles[1], 142, 118);
	a.jmp("page_text_done");
	a.label("text_move");
	a.emit(0x83, 0xF8, 0x05); a.jcc(0x85, "text_item");
	emitPair(strings.headings[5], strings.subtitles[5], 160, 128);
	AutoCombatUIStatic.emitText(a, strings.teleport.vir, 195, 88, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.returning.vir, 198, 183, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_item");
	emitPair(strings.headings[6], strings.subtitles[6], 169, 79);
	AutoCombatUIStatic.emitText(a, strings.buffItems.vir, 185, 87, 14, 0x0078432C);
	a.label("page_text_done");
	AutoCombatUIStatic.emitText(a, strings.reset.vir, 15, 322, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.close.vir, 431, 322, 14, 0x0078432C);
};

AutoCombatUIStatic.emitPageControls = function(
	a, stateVir, paths, fillRectVir, strings, monsterRowsVir
)
{
	const dark = 0x00554B46;
	const blue = 0x0078432C;
	const link = 0x00B27E41;
	const drawCheck = function(on, x, y, label, id)
	{
		AutoCombatUIStatic.emitDrawFull(
			a, (on ? paths.checkboxOn : paths.checkboxOff).vir, x, y,
			`control_check_${id}`
		);
		if (label)
			AutoCombatUIStatic.emitText(a, label.vir, x + 20, y - 2, 14, dark);
	};
	const drawStateCheck = function(test, x, y, label, id)
	{
		const offLabel = `control_check_${id}_off`;
		const doneLabel = `control_check_${id}_done`;
		if (test.kind === "flag")
		{
			a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
			a.emit(0xA9); a.dword(test.mask);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "nonzero")
		{
			a.emit(0x83, 0x3D); a.dword(stateVir + test.offset); a.emit(0);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "eq")
		{
			a.emit(0x83, 0x3D); a.dword(stateVir + test.offset); a.emit(test.value);
			a.jcc(0x85, offLabel);
		}
		else if (test.kind === "neq")
		{
			a.emit(0x83, 0x3D); a.dword(stateVir + test.offset); a.emit(test.value);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "bit")
		{
			a.emit(0xA1); a.dword(stateVir + test.offset);
			a.emit(0xA9); a.dword(test.mask);
			a.jcc(0x84, offLabel);
		}
		AutoCombatUIStatic.emitDrawFull(
			a, paths.checkboxOn.vir, x, y, `control_check_${id}_on`
		);
		a.jmp(doneLabel);
		a.label(offLabel);
		AutoCombatUIStatic.emitDrawFull(
			a, paths.checkboxOff.vir, x, y, `control_check_${id}_off_draw`
		);
		a.label(doneLabel);
		if (label)
			AutoCombatUIStatic.emitText(a, label.vir, x + 20, y - 2, 14, dark);
	};
	const drawMonsterRow = function(mask, textVir, y, id)
	{
		const offLabel = `monster_row_${id}_off`;
		const doneLabel = `monster_row_${id}_done`;
		a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateMonsterBits);
		a.emit(0xA9); a.dword(mask);
		a.jcc(0x84, offLabel);
		AutoCombatUIStatic.emitDrawFull(
			a, paths.monsterRowOn.vir, 14, y, `monster_row_${id}_on_draw`
		);
		a.jmp(doneLabel);
		a.label(offLabel);
		AutoCombatUIStatic.emitDrawFull(
			a, paths.monsterRowOff.vir, 14, y, `monster_row_${id}_off_draw`
		);
		a.label(doneLabel);
		AutoCombatUIStatic.emitText(a, textVir, 90, y + 9, 14, dark);
		drawStateCheck(
			{kind: "bit", offset: AutoCombatUIStatic.StateMonsterBits, mask},
			420, y + 10, null, `monster_${id}`
		);
	};

	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x00); a.jcc(0x85, "controls_monster");
	drawStateCheck({kind: "eq", offset: AutoCombatUIStatic.StateStopMelee, value: 2}, 28, 143, strings.basicOptions[0], "basic_0");
	drawStateCheck({kind: "eq", offset: AutoCombatUIStatic.StateStopMelee, value: 1}, 28, 177, strings.basicOptions[1], "basic_1");
	drawStateCheck({kind: "nonzero", offset: AutoCombatUIStatic.StateTeleportNoMobDelay}, 28, 211, strings.basicOptions[2], "basic_2");
	drawStateCheck({kind: "nonzero", offset: AutoCombatUIStatic.StateMonsterSurround}, 28, 245, strings.basicOptions[3], "basic_3");
	drawStateCheck({kind: "flag", mask: 1 << 7}, 28, 279, strings.basicOptions[4], "basic_4");
	AutoCombatUIStatic.emitText(a, strings.basicNormal.vir, 48, 160, 13, link);
	a.jmp("controls_done");

	a.label("controls_monster");
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "controls_skill");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(0xA9); a.dword(AutoCombatUIStatic.FeatureMonsterRows);
	a.jcc(0x84, "controls_monster_static");
	drawMonsterRow(1, strings.monsters[0].vir, 87, "dynamic_all");
	for (let index = 0; index < AutoCombatUIStatic.MonsterDynamicRows; index++)
	{
		const visibleLabel = `monster_dynamic_${index}_visible`;
		const skipLabel = `monster_dynamic_${index}_skip`;
		a.emit(0x83, 0x3D);
		a.dword(stateVir + AutoCombatUIStatic.StateMonsterRowCount);
		a.emit(index + 1);
		a.jcc(0x83, visibleLabel);
		a.jmp(skipLabel);
		a.label(visibleLabel);
		drawMonsterRow(
			1 << (index + 1),
			monsterRowsVir + index * AutoCombatUIStatic.MonsterRowSize +
				AutoCombatUIStatic.MonsterRowNameOffset,
			87 + (index + 1) * 38,
			`dynamic_${index}`
		);
		a.label(skipLabel);
	}
	a.jmp("controls_done");
	a.label("controls_monster_static");
	for (let index = 0; index < strings.monsters.length; index++)
	{
		const mask = 1 << index;
		drawMonsterRow(mask, strings.monsters[index].vir, 87 + index * 38, `static_${index}`);
	}
	a.jmp("controls_done");

	a.label("controls_skill");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "controls_potion");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "controls_done");
	const skillXs = [108, 185, 262];
	const skillColors = [0xFFDF564C, 0xFFEF9F41, 0xFF648FDB];
	for (let index = 0; index < 3; index++)
	{
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, skillXs[index], 132 + (index === 2 ? 74 : 0), 20, 20, skillColors[index]);
		AutoCombatUIStatic.emitText(a, strings.skillLetters[index].vir, skillXs[index] + 5, 134 + (index === 2 ? 74 : 0), 14, 0x00FFFFFF);
		AutoCombatUIStatic.emitText(a, strings.skillNames[index].vir, skillXs[index] - 4, 166 + (index === 2 ? 74 : 0), 13, dark);
	}
	drawStateCheck({kind: "neq", offset: AutoCombatUIStatic.StateStopMelee, value: 1}, 28, 277, null, "normal_attack");
	a.jmp("controls_done");

	a.label("controls_potion");
	a.emit(0x83, 0xF8, 0x03); a.jcc(0x85, "controls_looting");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StatePotionPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "controls_done");
	for (let index = 0; index < 4; index++)
	{
		const x = index % 2 === 0 ? 21 : 247;
		const y = index < 2 ? 89 : 200;
		AutoCombatUIStatic.emitDrawFull(a, paths.toggleOn.vir, x + 182, y, `potion_toggle_${index}`);
		AutoCombatUIStatic.emitText(a, strings.potionPanels[index].vir, x + 70, y, 14, blue);
		AutoCombatUIStatic.emitText(a, strings.useBelow.vir, x + 16, y + 39, 13, dark);
	}
	a.jmp("controls_done");

	a.label("controls_looting");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x85, "controls_move");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "controls_done");
	drawStateCheck({kind: "bit", offset: AutoCombatUIStatic.StateLootCategoryBits, mask: 1 << 0}, 28, 226, strings.lootOptions[0], "loot_0");
	drawStateCheck({kind: "bit", offset: AutoCombatUIStatic.StateLootCategoryBits, mask: 1 << 1}, 136, 226, strings.lootOptions[1], "loot_1");
	drawStateCheck({kind: "bit", offset: AutoCombatUIStatic.StateLootCategoryBits, mask: 1 << 2}, 232, 226, strings.lootOptions[2], "loot_2");
	drawStateCheck({kind: "bit", offset: AutoCombatUIStatic.StateLootCategoryBits, mask: 1 << 3}, 354, 226, strings.lootOptions[3], "loot_3");
	AutoCombatUIStatic.emitText(a, strings.weightNote.vir, 37, 78, 13, dark);
	a.jmp("controls_done");

	a.label("controls_move");
	a.emit(0x83, 0xF8, 0x05); a.jcc(0x85, "controls_item");
	drawStateCheck({kind: "flag", mask: 1 << 6}, 129, 116, null, "move_0");
	drawStateCheck({kind: "flag", mask: 1 << 5}, 277, 116, null, "move_1");
	drawStateCheck({kind: "flag", mask: 1 << 1}, 129, 211, null, "move_2");
	drawStateCheck({kind: "nonzero", offset: AutoCombatUIStatic.StateActionOnEnd}, 277, 211, null, "move_3");
	AutoCombatUIStatic.emitText(a, strings.registerItem.vir, 116, 146, 13, dark);
	AutoCombatUIStatic.emitText(a, strings.registerSkill.vir, 265, 146, 13, dark);
	AutoCombatUIStatic.emitText(a, strings.registerItem.vir, 116, 241, 13, dark);
	AutoCombatUIStatic.emitText(a, strings.registerSkill.vir, 265, 241, 13, dark);
	a.jmp("controls_done");

	a.label("controls_item");
	const itemXs = [108, 185, 262];
	for (let index = 0; index < 3; index++)
	{
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, itemXs[index], 122 + (index === 2 ? 74 : 0), 20, 20, skillColors[index]);
		AutoCombatUIStatic.emitText(a, strings.itemLetters[index].vir, itemXs[index] + 5, 124 + (index === 2 ? 74 : 0), 14, 0x00FFFFFF);
	}
