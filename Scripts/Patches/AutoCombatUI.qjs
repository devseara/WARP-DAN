		a.emit(AutoCombatUIStatic.MoveKindItem);
		a.jcc(0x85, skill);
		AutoCombatUIStatic.emitDrawItemIcon(
			a, fillRectVir, rowVir + AutoCombatUIStatic.MoveRowIdOffset,
			itemResolverVir, paths.skillIconFormat.vir, skillIconPathVir,
			slot.x, slot.y, skillColors[index % skillColors.length],
			`move_${index}_item_icon`
		);
		a.jmp(iconDone);
		a.label(skill);
		a.emit(0x66, 0x83, 0x3D);
		a.dword(rowVir + AutoCombatUIStatic.MoveRowKindOffset);
		a.emit(AutoCombatUIStatic.MoveKindSkill);
		a.jcc(0x85, empty);
		AutoCombatUIStatic.emitDrawSkillIcon(
			a, fillRectVir, iconKeyVir, paths.skillIconFormat.vir, skillIconPathVir,
			slot.x, slot.y, skillColors[index % skillColors.length],
			`move_${index}_skill_icon`
		);
		a.label(iconDone);
		AutoCombatUIStatic.emitDrawSkillLevel(
			a, fillRectVir, rowVir + AutoCombatUIStatic.MoveRowLevelOffset,
			strings.skillLevelFormat.vir, skillLevelTextVir, slot.x, slot.y
		);
		drawStateCheck(
			{kind: "mem_bit", address: rowVir + AutoCombatUIStatic.MoveRowFlagsOffset, mask: 1},
			slot.checkX, slot.y + 5, null, `move_${index}`
		);
		a.label(empty);
	}
	a.label("controls_move_done");
	AutoCombatUIStatic.emitCenteredText(
		a, strings.moveReturnHintLine1.vir, 25, 270, 420, 12, link, 75,
		"move_return_hint_1"
	);
	AutoCombatUIStatic.emitCenteredText(
		a, strings.moveReturnHintLine2.vir, 25, 286, 420, 12, link, 75,
		"move_return_hint_2"
	);
	a.jmp("controls_done");
	a.label("controls_item");
	const itemXs = [108, 185, 262, 339];
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(0xA9); a.dword(AutoCombatUIStatic.FeatureItemRows);
	a.jcc(0x84, "controls_item_return");
	for (let index = 0; index < AutoCombatUIStatic.ItemDynamicRows; index++)
	{
		const x = itemXs[index % itemXs.length];
		const y = 121 + Math.floor(index / itemXs.length) * 74;
		const rowVir = itemRowsVir + index * AutoCombatUIStatic.ItemRowSize;

		const empty = `buff_item_${index}_empty`;
		const done = `buff_item_${index}_done`;
		a.emit(0x83, 0x3D); a.dword(rowVir + AutoCombatUIStatic.ItemRowIdOffset); a.emit(0);
		a.jcc(0x84, empty);
		AutoCombatUIStatic.emitDrawItemIcon(
			a, fillRectVir, rowVir + AutoCombatUIStatic.ItemRowIdOffset,
			itemResolverVir, paths.skillIconFormat.vir, skillIconPathVir,
			x, y, skillColors[index % skillColors.length], `buff_item_${index}_icon`
		);
		AutoCombatUIStatic.emitDrawSkillLevel(
			a, fillRectVir, rowVir + AutoCombatUIStatic.ItemRowFlagsOffset + 2,
			strings.skillLevelFormat.vir, skillLevelTextVir, x, y
		);
		a.jmp(done);
		a.label(empty);
		AutoCombatUIStatic.emitText(a, strings.skillEmpty.vir, x + 5, y + 2, 14, link);
		a.label(done);
		AutoCombatUIStatic.emitCenteredText(
			a, rowVir + AutoCombatUIStatic.ItemRowDelayTextOffset,
			x - 6, y + 32, 34, 14, dark, 8, `buff_item_${index}_delay`
		);
		AutoCombatUIStatic.emitText(a, strings.secondsSuffix.vir, x + 31, y + 32, 13, dark);
	}
	a.label("controls_item_return");
	drawStateCheck({kind: "nonzero", offset: AutoCombatUIStatic.StateActionOnEnd}, 28, 275, strings.returnTown, "item_return");
	AutoCombatUIStatic.emitText(a, strings.itemReturnHint.vir, 48, 294, 12, link);
	a.label("controls_done");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x8C, "navigation_done");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x8F, "navigation_done");
	AutoCombatUIStatic.emitDrawColorKeyFull(
		a, paths.sliderLeft.vir, 199, 318, "page_navigation_left"
	);
	AutoCombatUIStatic.emitDrawColorKeyFull(
		a, paths.sliderRight.vir, 257, 318, "page_navigation_right"
	);
	a.label("navigation_done");
};

AutoCombatUIStatic.emitLootDropdown = function(a, stateVir, fillRectVir, strings)
{
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab); a.emit(0x04);
	a.jcc(0x85, "loot_dropdown_done");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage); a.emit(0x01);
	a.jcc(0x85, "loot_dropdown_done");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateLootDropdown); a.emit(0x01);
	a.jcc(0x85, "loot_dropdown_armor_test");

	const emitPopup = function(currentVir, top, prefix)
	{
		for (let option = 0; option <= 5; option++)
		{
			const y = top + option * 17;
			const normal = `${prefix}_${option}_normal`;
			const backgroundDone = `${prefix}_${option}_background_done`;
			a.emit(0x83, 0x3D); a.dword(currentVir); a.emit(option);
			a.jcc(0x85, normal);
			AutoCombatUIStatic.emitFillRect(a, fillRectVir, 201, y, 150, 17, 0xFFD8E7FA);
			a.jmp(backgroundDone);
			a.label(normal);
			AutoCombatUIStatic.emitFillRect(a, fillRectVir, 201, y, 150, 17, 0xFFFFFFFF);
			a.label(backgroundDone);
			AutoCombatUIStatic.emitFillRect(a, fillRectVir, 201, y, 150, 1, 0xFF9AAAC0);
			AutoCombatUIStatic.emitFillRect(a, fillRectVir, 201, y, 1, 17, 0xFF9AAAC0);
			AutoCombatUIStatic.emitFillRect(a, fillRectVir, 350, y, 1, 17, 0xFF9AAAC0);
			if (option === 5)
				AutoCombatUIStatic.emitFillRect(a, fillRectVir, 201, y + 16, 150, 1, 0xFF9AAAC0);
			AutoCombatUIStatic.emitText(
				a, strings.lootOptionChoices[option].vir, 206, y + 1, 12, 0x0078432C
			);
		}
	};

	emitPopup(
		stateVir + AutoCombatUIStatic.StateLootWeaponOptionMin,
		221, "loot_dropdown_weapon"
	);
	a.jmp("loot_dropdown_done");
	a.label("loot_dropdown_armor_test");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateLootDropdown); a.emit(0x02);
	a.jcc(0x85, "loot_dropdown_done");
	emitPopup(
		stateVir + AutoCombatUIStatic.StateLootArmorOptionMin,
		126, "loot_dropdown_armor"
	);
	a.label("loot_dropdown_done");
};
AutoCombatUIStatic.buildDraw = function(stateVir, paths, fillRectVir, strings, monsterRowsVir, attackSkillRowsVir, attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, healingSkillRowVir, healingSkillIconKeyVir, recoverySkillRowsVir, recoverySkillIconKeysVir, itemRowsVir, itemIconKeysVir, potionRowsVir, potionIconKeysVir, moveRowsVir, moveIconKeysVir, itemResolverVir, skillIconPathVir, skillLevelTextVir, lootWeaponTextVir, lootArmorTextVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	AutoCombatUIStatic.pushImm(a, 0x00FFFFFF);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.WindowClearSurface);
	AutoCombatUIStatic.emitBody(a, stateVir, paths);
	AutoCombatUIStatic.emitChrome(a, stateVir, paths, fillRectVir, strings);
	AutoCombatUIStatic.emitPageText(a, stateVir, strings);
	AutoCombatUIStatic.emitPageControls(
		a, stateVir, paths, fillRectVir, strings, monsterRowsVir, attackSkillRowsVir,
		attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, healingSkillRowVir,
		healingSkillIconKeyVir, recoverySkillRowsVir, recoverySkillIconKeysVir, itemRowsVir,
		itemIconKeysVir, potionRowsVir, potionIconKeysVir, moveRowsVir, moveIconKeysVir,
		itemResolverVir, skillIconPathVir, skillLevelTextVir, lootWeaponTextVir, lootArmorTextVir
	);
	AutoCombatUIStatic.emitLootDropdown(a, stateVir, fillRectVir, strings);
	AutoCombatUIStatic.emitSkillRejectDialog(a, stateVir, fillRectVir, strings);
	AutoCombatUIStatic.emitFooterButtons(a, stateVir, paths);

	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

AutoCombatUIStatic.emitMarkDirty = function(a)
{
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowDirtyOffset);
	a.dword(1);
};

AutoCombatUIStatic.emitRectGate = function(a, left, top, right, bottom, failLabel)
{
	a.emit(0x81, 0xFB); a.dword(left);
	a.jcc(0x8C, failLabel);
	a.emit(0x81, 0xFB); a.dword(right);
	a.jcc(0x8D, failLabel);
	a.emit(0x81, 0xFA); a.dword(top);
	a.jcc(0x8C, failLabel);
	a.emit(0x81, 0xFA); a.dword(bottom);
	a.jcc(0x8D, failLabel);
};

AutoCombatUIStatic.emitSendScalarConst = function(a, mutationSenderVir, settingId, value)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, value);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.emitSendScalarPairConst = function(a, mutationSenderVir, settingId, value, value2)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	AutoCombatUIStatic.pushImm(a, value2);
	AutoCombatUIStatic.pushImm(a, value);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.emitSendScalarPairMem = function(a, mutationSenderVir, settingId, valueVir, value2)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	AutoCombatUIStatic.pushImm(a, value2);
	a.emit(0xFF, 0x35); a.dword(valueVir);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.emitSendScalarPairConstIfFeature = function(
	a, stateVir, mutationSenderVir, featureMask, settingId, value, value2, id
)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	const skipLabel = `send_scalar_pair_${id}_skip`;
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(0xA9); a.dword(featureMask);
	a.jcc(0x84, skipLabel);
	AutoCombatUIStatic.emitSendScalarPairConst(a, mutationSenderVir, settingId, value, value2);
	a.label(skipLabel);
};

AutoCombatUIStatic.emitSendScalarPairMemIfFeature = function(
	a, stateVir, mutationSenderVir, featureMask, settingId, valueVir, value2, id
)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	const skipLabel = `send_scalar_pair_mem_${id}_skip`;
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(0xA9); a.dword(featureMask);
	a.jcc(0x84, skipLabel);
	AutoCombatUIStatic.pushImm(a, value2);
	a.emit(0xFF, 0x35); a.dword(valueVir);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
	a.label(skipLabel);
};

AutoCombatUIStatic.emitSendScalarFlagToggle = function(a, stateVir, mutationSenderVir, settingId, mask)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	a.emit(0x33, 0xC9);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.emit(0xA9); a.dword(mask);
	a.emit(0x0F, 0x94, 0xC1);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x51);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
	a.emit(0x81, 0x35); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.dword(mask);
};

AutoCombatUIStatic.emitSendScalarEqToggle = function(
	a, stateVir, mutationSenderVir, offset, eqValue, settingId, eqSendValue, neSendValue, id
)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	const neLabel = `send_scalar_${id}_ne`;
	const callLabel = `send_scalar_${id}_call`;
	a.emit(0x83, 0x3D); a.dword(stateVir + offset); a.emit(eqValue);
	a.jcc(0x85, neLabel);
	a.emit(0xC7, 0x05); a.dword(stateVir + offset); a.dword(eqSendValue);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, eqSendValue);
	a.jmp(callLabel);
	a.label(neLabel);
	a.emit(0xC7, 0x05); a.dword(stateVir + offset); a.dword(neSendValue);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, neSendValue);
	a.label(callLabel);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.buildNativeSliderMouseMove = function(
	stateVir, percentFormatVir, percentTextVir, potionRowsVir,
	attackSkillRowsVir, supportSkillRowsVir, healingSkillRowVir,
	recoverySkillRowsVir, moveRowsVir, itemRowsVir,
	skillTooltipFormatVir, moveSkillTooltipFormatVir, itemTooltipFormatVir,
	hoverTextVir
)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x0C, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	// Preserve the native frame drag/capture path while the title is moving.
	a.emit(0x80, 0x7E, AutoCombatUIStatic.WindowDragStateOffset, AutoCombatUIStatic.WindowDragIdle);
	a.jcc(0x85, "pass");
	a.emit(0x8B, 0x5D, 0x08);
	a.emit(0x8B, 0x55, 0x0C);

	const emitSlotTooltip = function(rowVir, idOffset, nameOffset, levelOffset,
		delayOffset, kind, left, top, right, bottom, hoverId, prefix)
	{
		const next = `${prefix}_next`;
		AutoCombatUIStatic.emitRectGate(a, left, top, right, bottom, next);
		a.emit(0x83, 0x3D); a.dword(rowVir + idOffset); a.emit(0);
		a.jcc(0x84, next);
		if (kind === "skill")
		{
			AutoCombatUIStatic.pushImm(a, rowVir + delayOffset);
			a.emit(0x0F, 0xB7, 0x05); a.dword(rowVir + levelOffset);
			a.emit(0x50);
			AutoCombatUIStatic.pushImm(a, rowVir + nameOffset);
			AutoCombatUIStatic.pushImm(a, skillTooltipFormatVir);
			AutoCombatUIStatic.pushImm(a, hoverTextVir);
			a.call(AutoCombatUIStatic.StringFormat);
			a.emit(0x83, 0xC4, 0x14);
			a.emit(0xB8); a.dword(hoverTextVir);
		}
		else if (kind === "move_skill")
		{
			a.emit(0x0F, 0xB7, 0x05); a.dword(rowVir + levelOffset);
			a.emit(0x50);
			AutoCombatUIStatic.pushImm(a, rowVir + nameOffset);
			AutoCombatUIStatic.pushImm(a, moveSkillTooltipFormatVir);
			AutoCombatUIStatic.pushImm(a, hoverTextVir);
			a.call(AutoCombatUIStatic.StringFormat);
			a.emit(0x83, 0xC4, 0x10);
			a.emit(0xB8); a.dword(hoverTextVir);
		}
		else if (kind === "item")
		{
			a.emit(0x0F, 0xB7, 0x05); a.dword(rowVir + levelOffset);
			a.emit(0x50);
			AutoCombatUIStatic.pushImm(a, rowVir + nameOffset);
			AutoCombatUIStatic.pushImm(a, itemTooltipFormatVir);
			AutoCombatUIStatic.pushImm(a, hoverTextVir);
			a.call(AutoCombatUIStatic.StringFormat);
			a.emit(0x83, 0xC4, 0x10);
			a.emit(0xB8); a.dword(hoverTextVir);
		}
		else
		{
			a.emit(0xB8); a.dword(rowVir + nameOffset);
		}
		a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateHoverControl);
		a.dword(hoverId);
		a.jmp("show_slot_tooltip");
		a.label(next);
	};

	const skillXs = [108, 185, 262, 339];
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab); a.emit(0x02);
	a.jcc(0x85, "hover_potion_tab");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage); a.emit(0x01);
	a.jcc(0x85, "hover_support_skills");
	for (let index = 0; index < AutoCombatUIStatic.AttackSkillDynamicRows; index++)
	{
		const x = skillXs[index % 4];
		const y = 132 + Math.floor(index / 4) * 74;
		emitSlotTooltip(
			attackSkillRowsVir + index * AutoCombatUIStatic.AttackSkillRowSize,
			AutoCombatUIStatic.AttackSkillRowIdOffset,
			AutoCombatUIStatic.AttackSkillRowNameOffset,
			AutoCombatUIStatic.AttackSkillRowLevelOffset,
			AutoCombatUIStatic.AttackSkillRowDelayTextOffset,
			"skill", x - 4, y - 4, x + 34, y + 34,
			100 + index, `hover_attack_${index}`
		);
	}
	a.jmp("slider_hover_test");
	a.label("hover_support_skills");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage); a.emit(0x02);
	a.jcc(0x85, "hover_recovery_skills");
	for (let index = 0; index < AutoCombatUIStatic.AttackSkillDynamicRows; index++)
	{
		const x = skillXs[index % 4];
		const y = 132 + Math.floor(index / 4) * 74;
		emitSlotTooltip(
			supportSkillRowsVir + index * AutoCombatUIStatic.AttackSkillRowSize,
			AutoCombatUIStatic.AttackSkillRowIdOffset,
			AutoCombatUIStatic.AttackSkillRowNameOffset,
			AutoCombatUIStatic.AttackSkillRowLevelOffset,
			AutoCombatUIStatic.AttackSkillRowDelayTextOffset,
			"skill", x - 4, y - 4, x + 34, y + 34,
			110 + index, `hover_support_${index}`
		);
	}
	a.jmp("slider_hover_test");
	a.label("hover_recovery_skills");
	emitSlotTooltip(
		healingSkillRowVir, AutoCombatUIStatic.AttackSkillRowIdOffset,
		AutoCombatUIStatic.AttackSkillRowNameOffset,
		AutoCombatUIStatic.AttackSkillRowLevelOffset,
		AutoCombatUIStatic.AttackSkillRowDelayTextOffset,
		"skill", 222, 129, 260, 167, 120, "hover_healing"
	);
	for (let index = 0; index < AutoCombatUIStatic.RecoverySkillDynamicRows; index++)
	{
		const x = AutoCombatUIStatic.RecoverySkillFirstX +
			index * AutoCombatUIStatic.RecoverySkillSpacing;
		emitSlotTooltip(
			recoverySkillRowsVir + index * AutoCombatUIStatic.AttackSkillRowSize,
			AutoCombatUIStatic.AttackSkillRowIdOffset,
			AutoCombatUIStatic.AttackSkillRowNameOffset,
			AutoCombatUIStatic.AttackSkillRowLevelOffset,
			AutoCombatUIStatic.AttackSkillRowDelayTextOffset,
			"skill", x - 4, 129, x + 34, 167,
			121 + index, `hover_recovery_${index}`
		);
	}
	a.jmp("slider_hover_test");

	a.label("hover_potion_tab");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab); a.emit(0x03);
	a.jcc(0x85, "hover_move_tab");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StatePotionPage); a.emit(0x01);
	a.jcc(0x85, "slider_hover_test");
	for (let index = 0; index < AutoCombatUIStatic.PotionDynamicRows; index++)
	{
		const x = (index % 2 === 0 ? 21 : 247) + 174;
		const y = (index < 2 ? 89 : 200) + 65;
		emitSlotTooltip(
			potionRowsVir + index * AutoCombatUIStatic.PotionRowSize,
			AutoCombatUIStatic.PotionRowIdOffset,
			AutoCombatUIStatic.PotionRowNameOffset,
			AutoCombatUIStatic.PotionRowQuantityOffset, 0,
			"item", x - 4, y - 4, x + 36, y + 36,
			130 + index, `hover_potion_${index}`
		);
	}
	a.jmp("slider_hover_test");

	a.label("hover_move_tab");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab); a.emit(0x05);
	a.jcc(0x85, "hover_item_tab");
	const moveAnchors = [[156, 125], [302, 125], [156, 220], [302, 220]];
	for (let index = 0; index < AutoCombatUIStatic.MoveDynamicRows; index++)
	{
		const rowVir = moveRowsVir + index * AutoCombatUIStatic.MoveRowSize;
		const x = moveAnchors[index][0];
		const y = moveAnchors[index][1];
		const itemNext = `hover_move_${index}_skill_test`;
		a.emit(0x66, 0x83, 0x3D); a.dword(rowVir + AutoCombatUIStatic.MoveRowKindOffset);
		a.emit(AutoCombatUIStatic.MoveKindItem);
		a.jcc(0x85, itemNext);
		emitSlotTooltip(
			rowVir, AutoCombatUIStatic.MoveRowIdOffset,
			AutoCombatUIStatic.MoveRowNameOffset,
			AutoCombatUIStatic.MoveRowLevelOffset, 0,
			"item", x - 4, y - 4, x + 36, y + 36,
			140 + index, `hover_move_item_${index}`
		);
		a.label(itemNext);
		emitSlotTooltip(
			rowVir, AutoCombatUIStatic.MoveRowIdOffset,
			AutoCombatUIStatic.MoveRowNameOffset,
			AutoCombatUIStatic.MoveRowLevelOffset, 0,
			"move_skill", x - 4, y - 4, x + 36, y + 36,
			140 + index, `hover_move_skill_${index}`
		);
	}
	a.jmp("slider_hover_test");

	a.label("hover_item_tab");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab); a.emit(0x06);
	a.jcc(0x85, "slider_hover_test");
	for (let index = 0; index < AutoCombatUIStatic.ItemDynamicRows; index++)
	{
		const x = skillXs[index % 4];
		const y = 121 + Math.floor(index / 4) * 74;
		emitSlotTooltip(
			itemRowsVir + index * AutoCombatUIStatic.ItemRowSize,
			AutoCombatUIStatic.ItemRowIdOffset,
			AutoCombatUIStatic.ItemRowNameOffset,
			AutoCombatUIStatic.ItemRowFlagsOffset + 2, 0,
			"item", x - 4, y - 4, x + 36, y + 36,
			150 + index, `hover_item_${index}`
		);
	}

	a.label("slider_hover_test");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab); a.emit(0x02);
	a.jcc(0x85, "potion_slider_test");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage); a.emit(0x03);
	a.jcc(0x85, "clear_hover");
	a.emit(0x8B, 0x5D, 0x08);
