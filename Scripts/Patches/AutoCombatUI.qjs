	);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("body_move_3");
	AutoCombatUIStatic.emitRectGate(a, 266, 203, 303, 235, "consume");
	AutoCombatUIStatic.emitSendScalarEqToggle(
		a, stateVir, mutationSenderVir,
		AutoCombatUIStatic.StateActionOnEnd, 0,
		AutoCombatUIStatic.SettingActionOnEnd, 1, 0, "action_on_end"
	);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("body_item");
	a.emit(0x83, 0xF8, 0x06); a.jcc(0x85, "consume");
	AutoCombatUIStatic.emitRectGate(a, 20, 268, 235, 300, "consume");
	AutoCombatUIStatic.emitSendScalarEqToggle(
		a, stateVir, mutationSenderVir,
		AutoCombatUIStatic.StateActionOnEnd, 0,
		AutoCombatUIStatic.SettingActionOnEnd, 1, 0, "item_return"
	);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.label("consume");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D);
	a.emit(0xC2, 0x08, 0x00);
	return a;
};

AutoCombatUIStatic.buildDestructor = function(stateVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateWindow);
	a.dword(0);
	a.jmp(AutoCombatUIStatic.FrameDeletingDestructor);
	return a;
};

AutoCombatUIStatic.cloneFrameVtable = function(drawVir, mouseDownVir, destructorVir)
{
	const sourcePhy = Exe.Vir2Phy(AutoCombatUIStatic.FrameVtable);
	if (sourcePhy < 0)
		throw Error("AutoCombatUI: UIFrameWnd vtable is not mapped");
	const byteCount = AutoCombatUIStatic.FrameVtableEntries * 4;
	const [clonePhy, cloneVir] = Exe.Allocate(byteCount, 4);
	Exe.SetHex(clonePhy, Exe.GetHex(sourcePhy, byteCount));
	Exe.SetUint32(clonePhy + 0 * 4, destructorVir);
	Exe.SetUint32(clonePhy + 20 * 4, drawVir);
	Exe.SetUint32(clonePhy + 25 * 4, mouseDownVir);
	return {phy: clonePhy, vir: cloneVir, size: byteCount};
};

AutoCombatUIStatic.buildToggle = function(stateVir, vtableVir, openSenderVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	if (Number.isInteger(openSenderVir) && openSenderVir > 0)
		a.call(openSenderVir);
	a.emit(0x8B, 0x35); a.dword(stateVir + AutoCombatUIStatic.StateWindow);
	a.emit(0x85, 0xF6);
	a.jcc(0x85, "toggle_existing");
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.FrameObjectSize);
	a.call(AutoCombatUIStatic.OperatorNew);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0xF0);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameConstructor);
	a.emit(0xC7, 0x06); a.dword(vtableVir);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.WindowHeight);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.WindowWidth);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.WindowSetSize);
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowIdOffset); a.dword(0x3F0);
	a.emit(0x8B, 0x15); a.dword(AutoCombatUIStatic.Renderer);
	a.emit(0x85, 0xD2);
	a.jcc(0x84, "position_ready");
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererWidthOffset);
	a.emit(0x2D); a.dword(AutoCombatUIStatic.WindowWidth);
	a.emit(0xD1, 0xF8);
	a.emit(0x89, 0x46, AutoCombatUIStatic.WindowXOffset);
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererHeightOffset);
	a.emit(0x2D); a.dword(AutoCombatUIStatic.WindowHeight);
	a.emit(0xD1, 0xF8);
	a.emit(0x89, 0x46, AutoCombatUIStatic.WindowYOffset);
	a.label("position_ready");
	a.emit(0x89, 0x35); a.dword(stateVir + AutoCombatUIStatic.StateWindow);
	a.emit(0x56);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.WindowManager);
	a.call(AutoCombatUIStatic.WindowAddTopLevelFront);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("done");
	a.label("toggle_existing");
	a.emit(0x80, 0x76, AutoCombatUIStatic.WindowVisibleOffset, 0x01);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.emit(0x83, 0x7E, AutoCombatUIStatic.WindowVisibleOffset, 0x00);
	a.jcc(0x84, "done");
	a.emit(0x56);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.WindowManager);
	a.call(AutoCombatUIStatic.WindowBringToFront);
	a.label("done");
	a.emit(0x61, 0x9D, 0xC3);
	return a;
};

AutoCombatUIStatic.assertCode = function(label, virAddr, expectedBytes)
{
	const phy = Exe.Vir2Phy(virAddr, CODE);
	if (phy < 0)
		throw Error(`AutoCombatUI: ${label} is not mapped`);
	const expected = expectedBytes.replace(/\s+/g, " ").trim().toUpperCase();
	const actual = Exe.GetHex(phy, expected.split(" ").length)
		.replace(/\s+/g, " ").trim().toUpperCase();
	if (actual !== expected)
		throw Error(`AutoCombatUI: ${label} mismatch, got ${actual}`);
};

AutoCombatUIStatic.assertVtableSlot = function(label, slot, expectedVir)
{
	const phy = Exe.Vir2Phy(AutoCombatUIStatic.FrameVtable + slot * 4);
	if (phy < 0)
		throw Error(`AutoCombatUI: ${label} vtable slot is not mapped`);
	const actual = Exe.GetUint32(phy);
	if (actual !== expectedVir)
	{
		throw Error(
			`AutoCombatUI: ${label} expected 0x${expectedVir.toString(16)}, ` +
			`got 0x${actual.toString(16)}`
		);
	}
};

AutoCombatUIStatic.verifyNativeContracts = function()
{
	AutoCombatUIStatic.assertCode(
		"UIFrameWnd constructor", AutoCombatUIStatic.FrameConstructor,
		"55 8B EC 6A FF 68 F9 45 EA 00"
	);
	AutoCombatUIStatic.assertCode(
		"UIFrameWnd mouse-down handler", AutoCombatUIStatic.FrameMouseDown,
		"55 8B EC 83 EC 08 56 8B F1"
	);
	AutoCombatUIStatic.assertVtableSlot(
		"UIFrameWnd deleting destructor", 0,
		AutoCombatUIStatic.FrameVtableDestructor
	);
	AutoCombatUIStatic.assertVtableSlot(
		"UIFrameWnd OnDraw", 20, AutoCombatUIStatic.FrameVtableDraw
	);
	AutoCombatUIStatic.assertVtableSlot(
		"UIFrameWnd mouse down", 25, AutoCombatUIStatic.FrameVtableMouseDown
	);
};

AutoCombatUI = function(_)
{
	if (Exe.BuildDate !== AutoCombatUIStatic.BuildDate)
		throw Error("AutoCombatUI supports only the 2025-07-16 client");
	if (typeof CustomSlashCommand === "undefined" ||
		typeof CustomSlashCommand.register !== "function")
		throw Error("AutoCombatUI: CustomSlashCommand helper unavailable");

	$$(_, 1, "Verify the native UIFrameWnd ABI and input handlers");
	AutoCombatUIStatic.verifyNativeContracts();

	$$(_, 2, "Build client-native Auto Hunt resource paths");
	const paths = {
		basic: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_default\\bg_default_autohunt.bmp"
		),
		monster: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_monster\\bg_monster_autohunt.bmp"
		),
		skill1: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_skill\\bg_skill_autohunt.bmp"
		),
		skill2: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_skill\\bg_skill_autohunt2.bmp"
		),
		skill3: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_skill\\bg_skill_autohunt3.bmp"
		),
		potion1: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_potion\\bg_potion1_autohunt.bmp"
		),
		potion2: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_potion\\bg_potion2_autohunt.bmp"
		),
		looting1: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_looting\\bg_looting1_autohunt.bmp"
		),
		looting2: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_looting\\bg_looting2_autohunt.bmp"
		),
		move: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_move\\bg_move_autohunt.bmp"
		),
		item: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_item\\bg_item_autohunt.bmp"
		),
		checkboxOn: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\checkbox_on_autohunt.bmp"
		),
		checkboxOff: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\checkbox_off_autohunt.bmp"
		),
		monsterRowOn: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_monster\\bg_list_checkon_autohunt.bmp"
		),
		monsterRowOff: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_monster\\bg_list_checkoff_autohunt.bmp"
		),
		toggleOn: AutoCombatUIStatic.buildResourcePath(
			"autohunt\\setting_potion\\toggle_on.bmp"
		)
	};

	const tabLabels = ["Basic", "Monster", "Skill", "Potion", "Looting", "Move", "Item"];
	const headings = [
		"Configure the automatic hunting feature.",
		"Please select monsters to hunt.",
		"Set the attack skill.",
		"Configure recovery items to use.",
		"Configure looting behavior.",
		"Configure movement items.",
		"Configure buff-type items."
	];
	const subtitles = [
		"Automatic hunting settings are saved separately for each character.",
		"Select monsters to prioritize or ignore.",
		"Skills are used at each configured delay time.",
		"Items with equal recovery ratios are used from left to right.",
		"Automatically loot items of the checked types.",
		"You can set teleport and return methods.",
		"Registered buff items are used at each configured delay."
	];
	const strings = {
		leftGlyph: AutoCombatUIStatic.allocateString("o"),
		minimize: AutoCombatUIStatic.allocateString("-"),
		closeGlyph: AutoCombatUIStatic.allocateString("x"),
		tabs: tabLabels.map(text => AutoCombatUIStatic.allocateString(text)),
		headings: headings.map(text => AutoCombatUIStatic.allocateString(text)),
		subtitles: subtitles.map(text => AutoCombatUIStatic.allocateString(text)),
		headingX: [112, 131, 178, 139, 159, 160, 169],
		subtitleX: [53, 126, 139, 78, 112, 128, 79],
		attackSettings: AutoCombatUIStatic.allocateString("Attack Skill Settings"),
		supportSettings: AutoCombatUIStatic.allocateString("Support Skill Settings"),
		healSettings: AutoCombatUIStatic.allocateString("HP Recovery"),
		statusSettings: AutoCombatUIStatic.allocateString("Status Recovery"),
		normalAttack: AutoCombatUIStatic.allocateString("Use Normal Attack"),
		skillHeadings: [
			"Set the attack skill.",
			"Set support skills.",
			"Configure recovery skills."
		].map(text => AutoCombatUIStatic.allocateString(text)),
		skillSubtitles: [
			"Skills are used at each configured delay time.",
			"Support skills are used at each configured delay time.",
			"Set healing thresholds and status recovery skills."
		].map(text => AutoCombatUIStatic.allocateString(text)),
		potionHeadings: [
			"Configure recovery items to use.",
			"Configure status recovery items."
		].map(text => AutoCombatUIStatic.allocateString(text)),
		potionSubtitles: [
			"Items with equal recovery ratios are used from left to right.",
			"Register items used to remove harmful status effects."
		].map(text => AutoCombatUIStatic.allocateString(text)),
		lootingHeadings: [
			"Configure looting behavior.",
			"Configure detailed item looting."
		].map(text => AutoCombatUIStatic.allocateString(text)),
		lootingSubtitles: [
			"Automatically loot items of the checked types.",
			"Use the item list to define detailed pickup rules."
		].map(text => AutoCombatUIStatic.allocateString(text)),
		statusPotion: AutoCombatUIStatic.allocateString("Status Recovery Item"),
		weight: AutoCombatUIStatic.allocateString("Weight Settings"),
		teleport: AutoCombatUIStatic.allocateString("Enable Teleport"),
		returning: AutoCombatUIStatic.allocateString("Enable Return"),
		buffItems: AutoCombatUIStatic.allocateString("Buff Item Settings"),
		basicOptions: [
			"When SP is below 10%, use only normal attacks.",
			"When SP is below 5%, stop attacking and moving.",
			"Teleport if combat does not occur for 10 seconds.",
			"Teleport if more than 10 monsters are on screen.",
			"Teleport when an MVP boss monster appears."
		].map(text => AutoCombatUIStatic.allocateString(text)),
		basicNormal: AutoCombatUIStatic.allocateString(
			"Normal Attack is used when configured skills cannot be used."
		),
		monsters: ["All Monsters", "Poring", "Drops", "Poporing", "Lunatic", "Fabre"]
			.map(text => AutoCombatUIStatic.allocateString(text)),
		skillLetters: ["B", "M", "P"]
			.map(text => AutoCombatUIStatic.allocateString(text)),
		skillNames: ["Bash", "Magnum", "Provoke"]
			.map(text => AutoCombatUIStatic.allocateString(text)),
		potionPanels: ["HP Recovery", "HP Recovery", "SP Recovery", "SP Recovery"]
			.map(text => AutoCombatUIStatic.allocateString(text)),
		useBelow: AutoCombatUIStatic.allocateString("Auto recover when below"),
		lootOptions: ["Consumable", "Cards", "Miscellaneous", "Costume"]
			.map(text => AutoCombatUIStatic.allocateString(text)),
		weightNote: AutoCombatUIStatic.allocateString(
			"Automatic looting stops when character weight reaches the limit."
		),
		registerItem: AutoCombatUIStatic.allocateString("Register Item"),
		registerSkill: AutoCombatUIStatic.allocateString("Register Skill"),
		itemLetters: ["H", "S", "B"]
			.map(text => AutoCombatUIStatic.allocateString(text)),
		returnTown: AutoCombatUIStatic.allocateString("Return to Town Settings"),
		reset: AutoCombatUIStatic.allocateString("Reset"),
		close: AutoCombatUIStatic.allocateString("Close")
	};

	const state = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.StateSize).fill(0), 4
	);
	const monsterRows = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.MonsterRowsSize).fill(0), 4
	);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateSkillPage, 1);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StatePotionPage, 1);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateLootingPage, 1);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateMonsterBits, 0x07);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateLootCategoryBits, 0x0F);

	$$(_, 3, "Create the AutoHunt UI AHUI packet sender and snapshot receiver");
	const packetRefs = AutoCombatUIStatic.resolvePacketRefs(_);
	const openSender = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildOpenSender(state.vir, packetRefs)
	);
	const scalarSender = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildScalarSender(state.vir, packetRefs)
	);
	const snapshotReceiverVir = AutoCombatUIStatic.installSnapshotReceiver(
		_, state.vir, monsterRows.vir
	);

	$$(_, 4, "Create the QJS-only Auto Combat UIFrameWnd renderer and input path");
	const fillRect = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildFillRect()
	);
	const draw = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildDraw(state.vir, paths, fillRect.vir, strings, monsterRows.vir)
	);
	const mouseDown = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildMouseDown(state.vir, scalarSender.vir, monsterRows.vir)
	);
	const destructor = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildDestructor(state.vir)
	);
	const vtable = AutoCombatUIStatic.cloneFrameVtable(
		draw.vir, mouseDown.vir, destructor.vir
	);
	const toggle = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildToggle(state.vir, vtable.vir, openSender.vir)
	);

	$$(_, 5, "Register /autohunt directly to the static UI cave");
	CustomSlashCommand.register(`${_}.SlashCommand`, {
		command: "/autohunt",
		targetVir: toggle.vir
	});

	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
	{
		PatchDiagnostics.add("AutoCombatUI.QjsOnly", {
			buildDate: Exe.BuildDate,
			command: "/autohunt",
			nativeHost: "UIFrameWnd",
			windowSize: [
				AutoCombatUIStatic.WindowWidth,
				AutoCombatUIStatic.WindowHeight
			],
			tabs: tabLabels,
			pages: {Basic: 1, Monster: 1, Skill: 3, Potion: 2, Looting: 2, Move: 1, Item: 1},
			stateVir: state.vir,
			vtableVir: vtable.vir,
			drawVir: draw.vir,
			mouseDownVir: mouseDown.vir,
			toggleVir: toggle.vir,
			openSenderVir: openSender.vir,
			scalarSenderVir: scalarSender.vir,
			snapshotReceiverVir,
			monsterRowsVir: monsterRows.vir,
			clientPacketId: AutoCombatUIStatic.ClientPacketId,
			serverPacketId: AutoCombatUIStatic.ServerPacketId,
			externalModules: 0,
			serverBehavior: "snapshot-open-set-scalar",
			persistence: true
		});
	}
	return true;
};

AutoCombatUI.validate = function()
{
	if (Exe.BuildDate !== AutoCombatUIStatic.BuildDate)
		return false;
	try
	{
		AutoCombatUIStatic.verifyNativeContracts();
		return true;
	}
	catch (_)
	{
		return false;
	}
};
