AutoCombatUIStatic.buildControllerDraw = function(stateVir, autoBattleVisual, autoSupportVisual)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	AutoCombatUIStatic.pushImm(a, 0x00000000);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.WindowClearSurface);
	AutoCombatUIStatic.emitPreserveSurfaceAlpha(a, "controller_clear");

	const emitVisual = function(visual, flagBit, x, prefix)
	{
		a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
		a.emit(0xA9); a.dword(1 << flagBit);
		a.jcc(0x84, prefix + "_off");
		a.emit(0xFF, 0x15); a.dword(AutoCombatUIStatic.TimeGetTimeIat);
		a.emit(0x33, 0xD2, 0xB9); a.dword(
			AutoCombatUIStatic.ControllerFrameDurationMs
		); a.emit(0xF7, 0xF1);
		a.emit(0x33, 0xD2, 0xB9); a.dword(visual.activeFrames.length); a.emit(0xF7, 0xF1);
		for (let index = 0; index < visual.activeFrames.length; index++)
		{
			const next = prefix + "_frame_" + index + "_next";
			a.emit(0x83, 0xFA, index);
			a.jcc(0x85, next);
			AutoCombatUIStatic.emitDrawSurface(a, visual.activeFrames[index], x, 0);
			a.jmp(prefix + "_done");
			a.label(next);
		}
		a.jmp(prefix + "_done");
		a.label(prefix + "_off");
		AutoCombatUIStatic.emitDrawSurface(a, visual.inactive, x, 0);
		a.label(prefix + "_done");
	};

	emitVisual(autoBattleVisual, 12, 0, "autobattle");
	emitVisual(
		autoSupportVisual, 3, AutoCombatUIStatic.ControllerSize, "autosupport"
	);
	AutoCombatUIStatic.emitPreserveSurfaceAlpha(a, "controller_draw");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

AutoCombatUIStatic.buildControllerMouseDown = function(stateVir, downXOffset, downYOffset)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	a.emit(0x8B, 0x5D, 0x08, 0x8B, 0x55, 0x0C);
	a.emit(0x85, 0xDB); a.jcc(0x88, "controller_down_base");
	a.emit(0x81, 0xFB); a.dword(AutoCombatUIStatic.ControllerGroupWidth);
	a.jcc(0x83, "controller_down_base");
	a.emit(0x85, 0xD2); a.jcc(0x88, "controller_down_base");
	a.emit(0x81, 0xFA); a.dword(AutoCombatUIStatic.ControllerGroupHeight);
	a.jcc(0x83, "controller_down_base");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateControllerPressed); a.dword(1);
	a.emit(0x89, 0x1D); a.dword(stateVir + AutoCombatUIStatic.StateControllerDownLocalX);
	a.emit(0x89, 0x15); a.dword(stateVir + AutoCombatUIStatic.StateControllerDownLocalY);
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowXOffset, 0xA3); a.dword(stateVir + downXOffset);
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowYOffset, 0xA3); a.dword(stateVir + downYOffset);
	a.label("controller_down_base");
	a.emit(0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08, 0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameMouseDown);
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00);
	return a;
};

AutoCombatUIStatic.buildControllerMouseUp = function(
	stateVir, mutationSenderVir, downXOffset, downYOffset
)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	a.emit(0x8B, 0x5D, 0x08, 0x8B, 0x7D, 0x0C);
	a.emit(0x57, 0x53, 0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameMouseUp);
	// FrameMouseUp commits the final drag coordinates. Preserve that exact
	// user-owned position so a map-change geometry reset cannot relocate the
	// persistent controller on the next render tick.
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowXOffset, 0xA3);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerLastX);
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowYOffset, 0xA3);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerLastY);
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerPositionValid);
	a.dword(1);
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateControllerPressed); a.emit(0x01);
	a.jcc(0x85, "controller_mouse_done");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateControllerPressed); a.dword(0);
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowXOffset, 0x2B, 0x05); a.dword(stateVir + downXOffset);
	a.emit(0x99, 0x33, 0xC2, 0x2B, 0xC2, 0x83, 0xF8, 0x03);
	a.jcc(0x87, "controller_mouse_done");
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowYOffset, 0x2B, 0x05); a.dword(stateVir + downYOffset);
	a.emit(0x99, 0x33, 0xC2, 0x2B, 0xC2, 0x83, 0xF8, 0x03);
	a.jcc(0x87, "controller_mouse_done");
	a.emit(0x85, 0xDB); a.jcc(0x88, "controller_mouse_done");
	a.emit(0x81, 0xFB); a.dword(AutoCombatUIStatic.ControllerGroupWidth);
	a.jcc(0x83, "controller_mouse_done");
	a.emit(0x85, 0xFF); a.jcc(0x88, "controller_mouse_done");
	a.emit(0x81, 0xFF); a.dword(AutoCombatUIStatic.ControllerGroupHeight);
	a.jcc(0x83, "controller_mouse_done");

	const emitToggle = function(flagBit, settingId)
	{
		a.emit(0x33, 0xC9, 0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
		a.emit(0xA9); a.dword(1 << flagBit);
		a.emit(0x0F, 0x94, 0xC1);
		AutoCombatUIStatic.pushImm(a, 0);
		a.emit(0x51);
		AutoCombatUIStatic.pushImm(a, settingId);
		a.call(mutationSenderVir);
		AutoCombatUIStatic.emitMarkDirty(a);
	};

	a.emit(0x81, 0xFB); a.dword(AutoCombatUIStatic.ControllerSize);
	a.jcc(0x83, "controller_autosupport");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateControllerDownLocalX);
	a.emit(AutoCombatUIStatic.ControllerSize);
	a.jcc(0x83, "controller_mouse_done");
	emitToggle(12, AutoCombatUIStatic.SettingAutoHuntEnabled);
	a.jmp("controller_mouse_done");
	a.label("controller_autosupport");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateControllerDownLocalX);
	a.emit(AutoCombatUIStatic.ControllerSize);
	a.jcc(0x82, "controller_mouse_done");
	emitToggle(3, AutoCombatUIStatic.SettingAutoSupportEnabled);
	a.label("controller_mouse_done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00);
	return a;
};

AutoCombatUIStatic.buildControllerDestructor = function(stateVir, windowOffset)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0xC7, 0x05);
	a.dword(stateVir + windowOffset);
	a.dword(0);
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateReady);
	a.dword(0);
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerPressed);
	a.dword(0);
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerNextSyncTick);
	a.dword(0);
	a.jmp(AutoCombatUIStatic.FrameDeletingDestructor);
	return a;
};

AutoCombatUIStatic.buildEnsureController = function(
	stateVir, windowOffset, vtableVir, visuals, windowId, rightInset, bottomInset,
	width, height
)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	for (const visual of visuals)
	{
		for (const initializerVir of visual.initializers)
			a.call(initializerVir);
	}
	for (const visual of visuals)
	{
		for (let index = 0; index < visual.surfaces.length; index++)
		{
			a.emit(0x83, 0x3D); a.dword(
				visual.surfaces[index].descriptorVir + AutoCombatUIStatic.TextureReadyOffset
			); a.emit(0x01);
			a.jcc(0x85, "controller_done");
		}
	}
	a.emit(0x8B, 0x35); a.dword(stateVir + windowOffset);
	a.emit(0x85, 0xF6);
	a.jcc(0x85, "controller_exists");
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.FrameObjectSize);
	a.call(AutoCombatUIStatic.OperatorNew);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, "controller_done");
	a.emit(0x8B, 0xF0);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameConstructor);
	a.emit(0xC7, 0x06); a.dword(vtableVir);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, width);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.WindowSetSize);
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowIdOffset); a.dword(windowId);
	a.emit(0x8B, 0x15); a.dword(AutoCombatUIStatic.Renderer);
	a.emit(0x85, 0xD2);
	a.jcc(0x84, "controller_position_ready");
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererWidthOffset, 0x2D); a.dword(rightInset);
	a.emit(0x85, 0xC0); a.jcc(0x89, "controller_x_ready"); a.emit(0x33, 0xC0);
	a.label("controller_x_ready");
	a.emit(0x89, 0x46, AutoCombatUIStatic.WindowXOffset);
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererHeightOffset, 0x2D); a.dword(bottomInset);
	a.emit(0x85, 0xC0); a.jcc(0x89, "controller_y_ready"); a.emit(0x33, 0xC0);
	a.label("controller_y_ready");
	a.emit(0x89, 0x46, AutoCombatUIStatic.WindowYOffset);
	a.label("controller_position_ready");
	a.emit(0x89, 0x35); a.dword(stateVir + windowOffset);
	a.emit(0x56, 0xB9); a.dword(AutoCombatUIStatic.WindowManager);
	a.call(AutoCombatUIStatic.WindowAddTopLevelFront);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("controller_done");
	a.label("controller_exists");
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowVisibleOffset); a.dword(1);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.label("controller_done");
	a.emit(0x61, 0x9D, 0xC3);
	return a;
};

AutoCombatUIStatic.buildSyncController = function(stateVir, controllerVtableVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);                                // preserve render-pass state
	a.emit(0x8B, 0x35); a.dword(
		stateVir + AutoCombatUIStatic.StateAutoBattleWindow
	);
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "sync_done");
	a.emit(0x81, 0x3E); a.dword(controllerVtableVir);
	a.jcc(0x84, "identity_ready");
	// A destroyed/reused frame must never be treated as our controller. Keep
	// its last good position, clear only the dead identity, and let bootstrap
	// recreate the frame through the normal UI lifecycle below.
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateAutoBattleWindow);
	a.dword(0);
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerPressed);
	a.dword(0);
	a.jmp("sync_done");

	a.label("identity_ready");
	// The controller is an independent top-level frame. Menu expansion must not
	// remove the Auto Combat / Auto Support controls from the HUD.
	a.emit(0x83, 0x7E, AutoCombatUIStatic.WindowVisibleOffset, 0x01);
	a.jcc(0x84, "visibility_done");
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowVisibleOffset); a.dword(1);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.label("visibility_done");

	a.emit(0x83, 0x3D);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerPositionValid);
	a.emit(0x00);
	a.jcc(0x84, "capture_position");

	// Only a mouse-down that began inside this controller owns a live drag.
	// Map transitions can leave the native drag byte non-idle without such an
	// owner; treating that stale byte as a drag would save the reset position.
	a.emit(0x80, 0x7E, AutoCombatUIStatic.WindowDragStateOffset);
	a.emit(AutoCombatUIStatic.WindowDragIdle);
	a.jcc(0x84, "restore_position");
	a.emit(0x83, 0x3D);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerPressed);
	a.emit(0x01);
	a.jcc(0x84, "capture_position");
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowDragStateOffset);
	a.dword(AutoCombatUIStatic.WindowDragIdle);
	a.jmp("restore_position");

	a.label("capture_position");
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowXOffset, 0xA3);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerLastX);
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowYOffset, 0xA3);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerLastY);
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateControllerPositionValid);
	a.dword(1);
	a.jmp("sync_done");

	a.label("restore_position");
	// Clamp the saved user position to the current render surface, then reclaim
	// it if native map initialization moved the live frame behind our back.
	a.emit(0x8B, 0x1D); a.dword(
		stateVir + AutoCombatUIStatic.StateControllerLastX
	);
	a.emit(0x85, 0xDB);
	a.jcc(0x89, "x_nonnegative");
	a.emit(0x33, 0xDB);
	a.label("x_nonnegative");
	a.emit(0x8B, 0x15); a.dword(AutoCombatUIStatic.Renderer);
	a.emit(0x85, 0xD2);
	a.jcc(0x84, "x_store");
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererWidthOffset);
	a.emit(0x2D); a.dword(AutoCombatUIStatic.ControllerGroupWidth);
	a.jcc(0x89, "x_max_ready");
	a.emit(0x33, 0xC0);
	a.label("x_max_ready");
	a.emit(0x3B, 0xD8);
	a.jcc(0x8E, "x_store");
	a.emit(0x8B, 0xD8);
	a.label("x_store");
	a.emit(0x89, 0x1D); a.dword(
		stateVir + AutoCombatUIStatic.StateControllerLastX
	);

	a.emit(0x8B, 0x3D); a.dword(
		stateVir + AutoCombatUIStatic.StateControllerLastY
	);
	a.emit(0x85, 0xFF);
	a.jcc(0x89, "y_nonnegative");
	a.emit(0x33, 0xFF);
	a.label("y_nonnegative");
	a.emit(0x8B, 0x15); a.dword(AutoCombatUIStatic.Renderer);
	a.emit(0x85, 0xD2);
	a.jcc(0x84, "y_store");
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererHeightOffset);
	a.emit(0x2D); a.dword(AutoCombatUIStatic.ControllerGroupHeight);
	a.jcc(0x89, "y_max_ready");
	a.emit(0x33, 0xC0);
	a.label("y_max_ready");
	a.emit(0x3B, 0xF8);
	a.jcc(0x8E, "y_store");
	a.emit(0x8B, 0xF8);
	a.label("y_store");
	a.emit(0x89, 0x3D); a.dword(
		stateVir + AutoCombatUIStatic.StateControllerLastY
	);

	a.emit(0x39, 0x5E, AutoCombatUIStatic.WindowXOffset);
	a.jcc(0x85, "set_position");
	a.emit(0x39, 0x7E, AutoCombatUIStatic.WindowYOffset);
	a.jcc(0x84, "sync_done");
	a.label("set_position");
	a.emit(0x57, 0x53, 0x8B, 0xCE);                   // PUSH Y / PUSH X
	a.call(AutoCombatUIStatic.WindowSetPosition);
	AutoCombatUIStatic.emitMarkDirty(a);

	a.label("sync_done");
	a.emit(0x61, 0x9D, 0xC3);
	return a;
};
AutoCombatUIStatic.buildControllerRedrawBridge = function(controllerVtableVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C);
	a.emit(0x81, 0x3B); a.dword(controllerVtableVir);
	a.jcc(0x84, "controller_animate");
	a.emit(0x9D, 0xC7, 0x43, AutoCombatUIStatic.WindowDirtyOffset);
	a.dword(0);
	a.jmp(AutoCombatUIStatic.UiUpdateSurfaceDirtyResume);
	a.label("controller_animate");
	a.emit(0x9D, 0xC7, 0x43, AutoCombatUIStatic.WindowDirtyOffset);
	a.dword(1);
	a.jmp(AutoCombatUIStatic.UiUpdateSurfaceDirtyResume);
	return a;
};

AutoCombatUIStatic.buildMenuToggleRequest = function(pendingVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0xFF, 0x15); a.dword(AutoCombatUIStatic.TimeGetTimeIat);
	a.emit(0x83, 0xC0, AutoCombatUIStatic.MenuToggleDelayMs);
	a.emit(0xA3); a.dword(pendingVir + 4);
	a.emit(0xC7, 0x05); a.dword(pendingVir); a.dword(1);
	a.emit(0xC3);
	return a;
};

AutoCombatUIStatic.buildControllerBootstrap = function(
	stateVir, openSenderVir, ensureControllerVir, syncControllerVir,
	pendingVir, toggleVir, getAsyncKeyStateIat
)
{
	const a = AutoCombatUIStatic.asm();
	// Preserve the original in-game render-pass call before QJS-owned work.
	a.call(AutoCombatUIStatic.ControllerBootstrapOriginal);
	a.emit(0x9C, 0x60);
	// A menu button mouse-up queues the toggle. Creating a top-level frame
	// inside the native mouse dispatch leaks the dispatch's drag state into the
	// new frame; consume it here on the next render/update tick instead.
	a.emit(0x83, 0x3D); a.dword(pendingVir); a.emit(0x00);
	a.jcc(0x84, "bootstrap_sync");
	AutoCombatUIStatic.pushImm(a, 0x01);               // VK_LBUTTON
	a.emit(0xFF, 0x15); a.dword(getAsyncKeyStateIat);
	a.emit(0x66, 0xA9, 0x00, 0x80);                   // physical button still down?
	a.jcc(0x85, "bootstrap_sync");
	a.emit(0xFF, 0x15); a.dword(AutoCombatUIStatic.TimeGetTimeIat);
	a.emit(0x2B, 0x05); a.dword(pendingVir + 4);
	a.jcc(0x88, "bootstrap_sync");                    // wait past dispatch boundary
	a.emit(0xC7, 0x05); a.dword(pendingVir); a.dword(0);
	a.call(toggleVir);
	a.label("bootstrap_sync");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateReady); a.emit(0x01);
	a.jcc(0x84, "bootstrap_controller");
	a.emit(0xFF, 0x15); a.dword(AutoCombatUIStatic.TimeGetTimeIat);
	a.emit(0x8B, 0xD8, 0x2B, 0x05); a.dword(
		stateVir + AutoCombatUIStatic.StateControllerNextSyncTick
	);
	a.jcc(0x88, "bootstrap_controller");
	a.emit(0x81, 0xC3); a.dword(2000);
	a.emit(0x89, 0x1D); a.dword(
		stateVir + AutoCombatUIStatic.StateControllerNextSyncTick
	);
	a.call(openSenderVir);
	a.label("bootstrap_controller");
	// Validate and repair the live top-level controller every render pass.
	// A map change can mutate its geometry without destroying the object.
	a.call(syncControllerVir);
	a.emit(0x83, 0x3D); a.dword(
		stateVir + AutoCombatUIStatic.StateAutoBattleWindow
	); a.emit(0x00);
	a.jcc(0x85, "bootstrap_done");
	a.call(ensureControllerVir);
	a.call(syncControllerVir);
	a.label("bootstrap_done");
	a.emit(0x61, 0x9D, 0xC3);
	return a;
};

AutoCombatUIStatic.buildWindowProcTrampoline = function()
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x6A, 0xFF);
	a.jmp(AutoCombatUIStatic.WindowMainProcResume);
	return a;
};

AutoCombatUIStatic.buildMouseWheel = function(stateVir)
{
	const a = AutoCombatUIStatic.asm();
	// UIFrameWnd vtable slot 35 receives the client's signed wheel direction
	// through its internal input dispatcher. Negative scrolls down; positive
	// scrolls up. This is the same ABI used by stock scrollable client windows.
	a.emit(0x55, 0x8B, 0xEC, 0x56, 0x8B, 0xF1);
	a.emit(0x83, 0x7D, 0x08, 0x00); a.jcc(0x84, "return");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x87, "return");
	a.emit(0x83, 0x7D, 0x08, 0x00); a.jcc(0x8C, "wheel_down");

	// Positive wheel direction: move the visible window toward its first row.
	a.emit(0x85, 0xC0); a.jcc(0x85, "monster_up");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateBasicScroll);
	a.emit(0x00); a.jcc(0x8E, "handled");
	a.emit(0xFF, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateBasicScroll);
	a.jmp("handled");
	a.label("monster_up");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateMonsterScroll);
	a.emit(0x00); a.jcc(0x8E, "handled");
	a.emit(0xFF, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateMonsterScroll);
	a.jmp("handled");

	// Negative wheel direction: advance by one row, bounded to actual content.
	a.label("wheel_down");
	a.emit(0x85, 0xC0); a.jcc(0x85, "monster_down");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateBasicScroll);
	a.emit(AutoCombatUIStatic.BasicScrollMaximum); a.jcc(0x8D, "handled");
	a.emit(0xFF, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateBasicScroll);
	a.jmp("handled");
	a.label("monster_down");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateMonsterRowCount);
	a.emit(0x83, 0xE8, AutoCombatUIStatic.MonsterVisibleRows);
	a.jcc(0x89, "monster_limit_nonnegative");
	a.emit(0x33, 0xC0);
	a.label("monster_limit_nonnegative");
	a.emit(0x83, 0xF8, AutoCombatUIStatic.MonsterScrollMaximum);
	a.jcc(0x8E, "monster_limit_ready");
	a.emit(0xB8); a.dword(AutoCombatUIStatic.MonsterScrollMaximum);
	a.label("monster_limit_ready");
	a.emit(0x39, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateMonsterScroll);
	a.jcc(0x8D, "handled");
	a.emit(0xFF, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateMonsterScroll);

	a.label("handled");
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowDirtyOffset); a.dword(1);
	a.label("return");
	a.emit(0x5E, 0x5D, 0xC2, 0x04, 0x00);
	return a;
};
AutoCombatUIStatic.buildDestructor = function(stateVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateLootDropdown);
	a.dword(0);
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateHoverControl);
	a.dword(0);
	a.emit(0xC7, 0x05);
	a.dword(stateVir + AutoCombatUIStatic.StateWindow);
	a.dword(0);
	a.jmp(AutoCombatUIStatic.FrameDeletingDestructor);
	return a;
};

AutoCombatUIStatic.cloneFrameVtable = function(
	drawVir, mouseDownVir, mouseUpVir, destructorVir, mouseMoveVir, mouseWheelVir
)
{
	const sourcePhy = Exe.Vir2Phy(AutoCombatUIStatic.FrameVtable);
	if (sourcePhy < 0)
		throw Error("AutoCombatUI: UIFrameWnd vtable is not mapped");
	const byteCount = AutoCombatUIStatic.FrameVtableEntries * 4;
	const [clonePhy, cloneVir] = Exe.Allocate(byteCount, 4);
	Exe.SetHex(clonePhy, Exe.GetHex(sourcePhy, byteCount));
	Exe.SetUint32(clonePhy + 0 * 4, destructorVir);
	Exe.SetUint32(clonePhy + 20 * 4, drawVir);
	Exe.SetUint32(clonePhy + 25 * 4, mouseDownVir);
	if (Number.isInteger(mouseMoveVir) && mouseMoveVir > 0)
		Exe.SetUint32(clonePhy + 28 * 4, mouseMoveVir);
	Exe.SetUint32(clonePhy + 31 * 4, mouseUpVir);
	if (Number.isInteger(mouseWheelVir) && mouseWheelVir > 0)
		Exe.SetUint32(clonePhy + 35 * 4, mouseWheelVir);
	return {phy: clonePhy, vir: cloneVir, size: byteCount};
};

AutoCombatUIStatic.buildToggle = function(stateVir, vtableVir, openSenderVir, ensureControllerVirs)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	if (Number.isInteger(openSenderVir) && openSenderVir > 0)
		a.call(openSenderVir);
	for (const ensureControllerVir of ensureControllerVirs)
	{
		if (Number.isInteger(ensureControllerVir) && ensureControllerVir > 0)
			a.call(ensureControllerVir);
	}
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateLootDropdown); a.dword(0);
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateHoverControl); a.dword(0);
	a.emit(0x8B, 0x35); a.dword(stateVir + AutoCombatUIStatic.StateWindow);
	a.emit(0x85, 0xF6);
	a.jcc(0x85, "toggle_existing");
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.FrameObjectSize);
	a.call(AutoCombatUIStatic.OperatorNew);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0xF0);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameConstructor);
	a.emit(0xC7, 0x06); a.dword(vtableVir);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.WindowHeight);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.WindowWidth);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.WindowSetSize);
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowIdOffset); a.dword(0x3F0);
	a.emit(0x8B, 0x15); a.dword(AutoCombatUIStatic.Renderer);
	a.emit(0x85, 0xD2);
	a.jcc(0x84, "position_ready");
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererWidthOffset);
	a.emit(0x2D); a.dword(AutoCombatUIStatic.WindowWidth);
	a.emit(0xD1, 0xF8);
	a.emit(0x89, 0x46, AutoCombatUIStatic.WindowXOffset);
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererHeightOffset);
	a.emit(0x2D); a.dword(AutoCombatUIStatic.WindowHeight);
	a.emit(0xD1, 0xF8);
	a.emit(0x89, 0x46, AutoCombatUIStatic.WindowYOffset);
	a.label("position_ready");
	a.emit(0x89, 0x35); a.dword(stateVir + AutoCombatUIStatic.StateWindow);
	a.emit(0x56);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.WindowManager);
	a.call(AutoCombatUIStatic.WindowAddTopLevelFront);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("done");
	a.label("toggle_existing");
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameMouseUp);
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowDragStateOffset);
	a.dword(AutoCombatUIStatic.WindowDragIdle);
	a.emit(0x80, 0x76, AutoCombatUIStatic.WindowVisibleOffset, 0x01);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.label("done");
	a.emit(0x61, 0x9D, 0xC3);
	return a;
};

AutoCombatUIStatic.assertCode = function(label, virAddr, expectedBytes)
{
	const phy = Exe.Vir2Phy(virAddr, CODE);
	if (phy < 0)
		throw Error(`AutoCombatUI: ${label} is not mapped`);
	const expected = expectedBytes.replace(/\s+/g, " ").trim().toUpperCase();
	const actual = Exe.GetHex(phy, expected.split(" ").length)
		.replace(/\s+/g, " ").trim().toUpperCase();
	if (actual !== expected)
		throw Error(`AutoCombatUI: ${label} mismatch, got ${actual}`);
	return phy;
};

AutoCombatUIStatic.assertVtableSlot = function(label, slot, expectedVir)
{
	const phy = Exe.Vir2Phy(AutoCombatUIStatic.FrameVtable + slot * 4);
	if (phy < 0)
		throw Error(`AutoCombatUI: ${label} vtable slot is not mapped`);
	const actual = Exe.GetUint32(phy);
	if (actual !== expectedVir)
	{
		throw Error(
			`AutoCombatUI: ${label} expected 0x${expectedVir.toString(16)}, ` +
			`got 0x${actual.toString(16)}`
		);
	}
};

AutoCombatUIStatic.verifyNativeContracts = function()
{
	const controllerBootstrapPhy = AutoCombatUIStatic.assertCode(
		"controller in-game bootstrap call",
		AutoCombatUIStatic.ControllerBootstrapHook,
		AutoCombatUIStatic.ControllerBootstrapHookBytes
	);
	AutoCombatUIStatic.assertCode(
		"UI update dirty clear", AutoCombatUIStatic.UiUpdateSurfaceDirty,
		"C7 43 58 00 00 00 00"
	);
	AutoCombatUIStatic.assertCode(
		"clipped image draw", AutoCombatUIStatic.ImageDrawRect,
		"55 8B EC 56 8B 71 24"
	);	AutoCombatUIStatic.assertCode(
		"Item Bar item-info lookup", AutoCombatUIStatic.ItemInfoLookup,
		"55 8B EC 6A FF 68 9D 54 EF 00"
	);
	AutoCombatUIStatic.assertCode(
		"UIFrameWnd constructor", AutoCombatUIStatic.FrameConstructor,
		"55 8B EC 6A FF 68 F9 45 EA 00"
	);
	const windowMainProcPhy = AutoCombatUIStatic.assertCode(
		"main window procedure", AutoCombatUIStatic.WindowMainProc,
		"55 8B EC 6A FF"
	);
	AutoCombatUIStatic.assertCode(
		"UIFrameWnd mouse-down handler", AutoCombatUIStatic.FrameMouseDown,
		"55 8B EC 83 EC 08 56 8B F1"
	);
	AutoCombatUIStatic.assertCode(
		"UIFrameWnd mouse-move handler", AutoCombatUIStatic.FrameMouseMove,
		"C2 08 00"
	);
	AutoCombatUIStatic.assertCode(
		"UIFrameWnd mouse-up handler", AutoCombatUIStatic.FrameMouseUp,
		"56 8B F1 B9 E8 F4 31 01 E8"
	);
	AutoCombatUIStatic.assertCode(
		"UIFrameWnd mouse-wheel handler", AutoCombatUIStatic.FrameMouseWheel,
		"C2 04 00"
	);
	AutoCombatUIStatic.assertVtableSlot(
		"UIFrameWnd deleting destructor", 0,
		AutoCombatUIStatic.FrameVtableDestructor
	);
	AutoCombatUIStatic.assertVtableSlot(
		"UIFrameWnd OnDraw", 20, AutoCombatUIStatic.FrameVtableDraw
	);
	AutoCombatUIStatic.assertVtableSlot(
		"UIFrameWnd mouse down", 25, AutoCombatUIStatic.FrameVtableMouseDown
	);
	AutoCombatUIStatic.assertVtableSlot(
		"UIFrameWnd mouse move", 28, AutoCombatUIStatic.FrameVtableMouseMove
	);
	AutoCombatUIStatic.assertVtableSlot(
		"UIFrameWnd mouse up", 31, AutoCombatUIStatic.FrameVtableMouseUp
	);
	AutoCombatUIStatic.assertVtableSlot(
		"UIFrameWnd mouse wheel", 35, AutoCombatUIStatic.FrameVtableMouseWheel
	);
	return {controllerBootstrapPhy, windowMainProcPhy};
};

AutoCombatUI = function(_)
{
	if (Exe.BuildDate !== AutoCombatUIStatic.BuildDate)
		throw Error("AutoCombatUI supports only the 2025-07-16 client");
	if (typeof CustomSlashCommand === "undefined" ||
