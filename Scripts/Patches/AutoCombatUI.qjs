	a.jcc(0x8E, "monster_thumb_limit_ready");
	a.emit(0xB8); a.dword(AutoCombatUIStatic.MonsterScrollMaximum);
	a.label("monster_thumb_limit_ready");
	a.emit(0x8B, 0xC8, 0x85, 0xC9);
	a.jcc(0x85, "monster_thumb_scale");
	a.emit(0xB8); a.dword(thumbTop);
	a.jmp("monster_thumb_store");
	a.label("monster_thumb_scale");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateMonsterScroll);
	a.emit(0x69, 0xC0); a.dword(thumbTravel);
	a.emit(0x33, 0xD2, 0xF7, 0xF1);
	a.emit(0x05); a.dword(thumbTop);
	a.label("monster_thumb_store");
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateMonsterThumbY);
	AutoCombatUIStatic.emitDrawColorKeyStateY(
		a, paths.scrollThumbUp.vir, AutoCombatUIStatic.BasicScrollX,
		stateVir + AutoCombatUIStatic.StateMonsterThumbY, 0,
		"monster_scroll_thumb_up"
	);
