	return a;
};

AutoCombatUIStatic.buildEnsureController = function(
	stateVir, windowOffset, vtableVir, visual, windowId, rightInset, bottomInset
)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	for (const initializerVir of visual.initializers)
		a.call(initializerVir);
	for (let index = 0; index < visual.surfaces.length; index++)
	{
		a.emit(0x83, 0x3D); a.dword(
			visual.surfaces[index].descriptorVir + AutoCombatUIStatic.TextureReadyOffset
		); a.emit(0x01);
		a.jcc(0x85, "controller_done");
	}
	a.emit(0x8B, 0x35); a.dword(stateVir + windowOffset);
	a.emit(0x85, 0xF6);
	a.jcc(0x85, "controller_exists");
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.FrameObjectSize);
	a.call(AutoCombatUIStatic.OperatorNew);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, "controller_done");
	a.emit(0x8B, 0xF0);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameConstructor);
	a.emit(0xC7, 0x06); a.dword(vtableVir);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.ControllerSize);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.ControllerSize);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.WindowSetSize);
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowIdOffset); a.dword(windowId);
	a.emit(0x8B, 0x15); a.dword(AutoCombatUIStatic.Renderer);
	a.emit(0x85, 0xD2);
	a.jcc(0x84, "controller_position_ready");
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererWidthOffset, 0x2D); a.dword(rightInset);
	a.emit(0x85, 0xC0); a.jcc(0x89, "controller_x_ready"); a.emit(0x33, 0xC0);
	a.label("controller_x_ready");
	a.emit(0x89, 0x46, AutoCombatUIStatic.WindowXOffset);
	a.emit(0x8B, 0x42, AutoCombatUIStatic.RendererHeightOffset, 0x2D); a.dword(bottomInset);
	a.emit(0x85, 0xC0); a.jcc(0x89, "controller_y_ready"); a.emit(0x33, 0xC0);
	a.label("controller_y_ready");
	a.emit(0x89, 0x46, AutoCombatUIStatic.WindowYOffset);
	a.label("controller_position_ready");
	a.emit(0x89, 0x35); a.dword(stateVir + windowOffset);
	a.emit(0x56, 0xB9); a.dword(AutoCombatUIStatic.WindowManager);
	a.call(AutoCombatUIStatic.WindowAddTopLevelFront);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("controller_done");
	a.label("controller_exists");
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowVisibleOffset); a.dword(1);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.label("controller_done");
	a.emit(0x61, 0x9D, 0xC3);
	return a;
};

