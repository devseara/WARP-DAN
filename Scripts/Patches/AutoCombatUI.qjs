		AutoCombatUIStatic.emitMarkDirty(a);
		a.jmp("consume");
		a.label(next);
	}
	a.jmp("consume");
	a.label("body_move");
	a.emit(0x83, 0xF8, 0x05); a.jcc(0x85, "body_item");
	AutoCombatUIStatic.emitRectGate(a, 118, 108, 155, 140, "body_move_1");
	AutoCombatUIStatic.emitSendScalarFlagToggle(
		a, stateVir, mutationSenderVir,
		AutoCombatUIStatic.SettingTeleportFlyWing, 1 << 6
	);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("body_move_1");
	AutoCombatUIStatic.emitRectGate(a, 266, 108, 303, 140, "body_move_2");
	AutoCombatUIStatic.emitSendScalarFlagToggle(
		a, stateVir, mutationSenderVir,
		AutoCombatUIStatic.SettingTeleportSkill, 1 << 5
	);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("body_move_2");
	AutoCombatUIStatic.emitRectGate(a, 118, 203, 155, 235, "body_move_3");
	AutoCombatUIStatic.emitSendScalarFlagToggle(
		a, stateVir, mutationSenderVir,
		AutoCombatUIStatic.SettingReturnSavePoint, 1 << 1
	);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("body_move_3");
	AutoCombatUIStatic.emitRectGate(a, 266, 203, 303, 235, "consume");
	AutoCombatUIStatic.emitSendScalarEqToggle(
		a, stateVir, mutationSenderVir,
		AutoCombatUIStatic.StateActionOnEnd, 0,
		AutoCombatUIStatic.SettingActionOnEnd, 1, 0, "action_on_end"
	);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("body_item");
	a.emit(0x83, 0xF8, 0x06); a.jcc(0x85, "consume");
	AutoCombatUIStatic.emitRectGate(a, 20, 268, 235, 300, "consume");
	AutoCombatUIStatic.emitSendScalarEqToggle(
		a, stateVir, mutationSenderVir,
		AutoCombatUIStatic.StateActionOnEnd, 0,
		AutoCombatUIStatic.SettingActionOnEnd, 1, 0, "item_return"
	);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.label("consume");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D);
	a.emit(0xC2, 0x08, 0x00);
	return a;
};
AutoCombatUIStatic.buildMouseUp = function(stateVir, mutationSenderVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	a.emit(0x8B, 0x5D, 0x08);
	a.emit(0x8B, 0x55, 0x0C);
	a.emit(0x85, 0xDB); a.jcc(0x88, "base_mouse_up");
	a.emit(0x85, 0xD2); a.jcc(0x88, "base_mouse_up");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab); a.emit(0x02);
	a.jcc(0x85, "base_mouse_up");

	const skillXs = [108, 185, 262, 339];
	const emitSkillDropGrid = function(featureMask, registerSetting, prefix)
	{
		a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
		a.emit(0xA9); a.dword(featureMask);
		a.jcc(0x84, "base_mouse_up");
		for (let index = 0; index < AutoCombatUIStatic.AttackSkillDynamicRows; index++)
		{
			const x = skillXs[index % skillXs.length];
			const y = 132 + Math.floor(index / skillXs.length) * 74;
			const next = `${prefix}_drop_${index}_next`;
			AutoCombatUIStatic.emitRectGate(a, x - 16, y - 8, x + 32, y + 30, next);

			a.emit(0xB9); a.dword(AutoCombatUIStatic.ShortcutManager);
			a.call(AutoCombatUIStatic.ShortcutManagerGetActive);
			a.emit(0x85, 0xC0); a.jcc(0x84, "base_mouse_up");
			a.emit(0x8B, 0xF8);
			a.emit(0x80, 0xBF); a.dword(AutoCombatUIStatic.ShortcutDragActiveOffset); a.emit(0x01);
			a.jcc(0x85, "base_mouse_up");
			a.emit(0x83, 0xBF); a.dword(AutoCombatUIStatic.ShortcutDragTypeOffset);
			a.emit(AutoCombatUIStatic.ShortcutDragSkillType);
			a.jcc(0x85, "base_mouse_up");
			a.emit(0x8B, 0x87); a.dword(AutoCombatUIStatic.ShortcutDragSkillIdOffset);
			a.emit(0x25); a.dword(0x0000FFFF);
			a.emit(0x85, 0xC0); a.jcc(0x84, "base_mouse_up");
			a.emit(0x8B, 0x8F); a.dword(AutoCombatUIStatic.ShortcutDragSkillLevelOffset);
			a.emit(0x81, 0xE1); a.dword(0x0000FFFF);
			a.emit(0x85, 0xC9); a.jcc(0x84, "base_mouse_up");
			a.emit(0xC1, 0xE1, 0x10, 0x0B, 0xC8);
			a.emit(0x51);
			AutoCombatUIStatic.pushImm(a, index);
			AutoCombatUIStatic.pushImm(a, registerSetting);
			a.call(mutationSenderVir);
			AutoCombatUIStatic.emitMarkDirty(a);

			a.emit(0x8B, 0x07);
			AutoCombatUIStatic.pushImm(a, 0);
			AutoCombatUIStatic.pushImm(a, 0);
			AutoCombatUIStatic.pushImm(a, 0);
			AutoCombatUIStatic.pushImm(a, 0);
			AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.ShortcutDragCancelMessage);
			a.emit(0x8B, 0xCF, 0xFF, 0x50, 0x18);
			a.jmp("base_mouse_up");
			a.label(next);
		}
	};

	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage); a.emit(0x01);
	a.jcc(0x85, "skill_drop_support");
	emitSkillDropGrid(
		AutoCombatUIStatic.FeatureAttackSkills,
		AutoCombatUIStatic.SettingAttackSkillRegister,
		"attack_skill"
	);
	a.jmp("base_mouse_up");

	a.label("skill_drop_support");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage); a.emit(0x02);
	a.jcc(0x85, "base_mouse_up");
	emitSkillDropGrid(
		AutoCombatUIStatic.FeatureSupportSkills,
		AutoCombatUIStatic.SettingSupportSkillRegister,
		"support_skill"
	);

	a.label("base_mouse_up");
	a.emit(0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08, 0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameMouseUp);
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D);
	a.emit(0xC2, 0x08, 0x00);
	return a;
};

AutoCombatUIStatic.buildControllerDraw = function(stateVir, visual, flagBit)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	AutoCombatUIStatic.pushImm(a, 0x00000000);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.WindowClearSurface);
	AutoCombatUIStatic.emitPreserveSurfaceAlpha(a, "controller_clear");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.emit(0xA9); a.dword(1 << flagBit);
	a.jcc(0x84, "controller_off");
	a.emit(0xFF, 0x15); a.dword(AutoCombatUIStatic.TimeGetTimeIat);
	a.emit(0x33, 0xD2, 0xB9); a.dword(
		AutoCombatUIStatic.ControllerFrameDurationMs
	); a.emit(0xF7, 0xF1);
	a.emit(0x33, 0xD2, 0xB9); a.dword(visual.activeFrames.length); a.emit(0xF7, 0xF1);
	for (let index = 0; index < visual.activeFrames.length; index++)
	{
		const next = `controller_frame_${index}_next`;
		a.emit(0x83, 0xFA, index);
		a.jcc(0x85, next);
		AutoCombatUIStatic.emitDrawSurface(a, visual.activeFrames[index], 0, 0);
		a.jmp("controller_done");
		a.label(next);
	}
	a.jmp("controller_done");
	a.label("controller_off");
	AutoCombatUIStatic.emitDrawSurface(a, visual.inactive, 0, 0);
	a.label("controller_done");
	AutoCombatUIStatic.emitPreserveSurfaceAlpha(a, "controller_draw");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};
AutoCombatUIStatic.buildControllerMouseDown = function(stateVir, downXOffset, downYOffset)
