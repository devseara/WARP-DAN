	AutoCombatUIStatic.pushImm(a, percentTextVir);
	a.call(AutoCombatUIStatic.ShowTooltip);

	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00);
	a.label("pass");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D);
	a.jmp(AutoCombatUIStatic.FrameMouseMove);
	return a;
};

AutoCombatUIStatic.buildMouseDown = function(
	stateVir, mutationSenderVir, monsterRowsVir, attackSkillRowsVir,
	supportSkillRowsVir, healingSkillRowVir, recoverySkillRowsVir, itemRowsVir,
	potionRowsVir, moveRowsVir
)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	a.emit(0x8B, 0x5D, 0x08);
	a.emit(0x8B, 0x55, 0x0C);
	a.emit(0x85, 0xDB);
	a.jcc(0x88, "consume");
	a.emit(0x85, 0xD2);
	a.jcc(0x88, "consume");

	// An open random-option popup owns the first click so its rows cannot
	// click through into the Looting page underneath it.
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateLootDropdown); a.emit(0);
	a.jcc(0x84, "loot_dropdown_check_done");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab); a.emit(0x04);
	a.jcc(0x85, "loot_dropdown_close");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage); a.emit(0x01);
	a.jcc(0x85, "loot_dropdown_close");

	const emitLootDropdownSelection = function(
		minimumVir, settingId, filterMask, top, prefix
	)
	{
		for (let option = 0; option <= 5; option++)
		{
			const next = `${prefix}_${option}_next`;
			AutoCombatUIStatic.emitRectGate(
				a, 201, top + option * 17, 351, top + (option + 1) * 17, next
			);
			a.emit(0xC7, 0x05); a.dword(minimumVir); a.dword(option);
			a.emit(0x33, 0xC9);
			a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateLootFilterFlags);
			a.emit(0xA9); a.dword(filterMask);
			a.emit(0x0F, 0x95, 0xC1);
			AutoCombatUIStatic.pushImm(a, option);
			a.emit(0x51);
			AutoCombatUIStatic.pushImm(a, settingId);
			a.call(mutationSenderVir);
			a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateLootDropdown);
			a.dword(0);
			AutoCombatUIStatic.emitMarkDirty(a);
			a.jmp("consume");
			a.label(next);
		}
	};

	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateLootDropdown); a.emit(0x01);
	a.jcc(0x85, "loot_dropdown_armor_click");
	emitLootDropdownSelection(
		stateVir + AutoCombatUIStatic.StateLootWeaponOptionMin,
		AutoCombatUIStatic.SettingLootWeaponFilter, 1 << 0,
		221, "loot_dropdown_weapon_click"
	);
	a.jmp("loot_dropdown_close");
	a.label("loot_dropdown_armor_click");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateLootDropdown); a.emit(0x02);
	a.jcc(0x85, "loot_dropdown_close");
	emitLootDropdownSelection(
		stateVir + AutoCombatUIStatic.StateLootArmorOptionMin,
		AutoCombatUIStatic.SettingLootArmorFilter, 1 << 1,
		126, "loot_dropdown_armor_click_row"
	);
	a.label("loot_dropdown_close");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateLootDropdown); a.dword(0);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("loot_dropdown_check_done");
	a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateSkillRejectVisible);
	a.emit(0);
	a.jcc(0x84, "title_test");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateSkillRejectVisible);
	a.dword(0);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("title_test");
	a.emit(0x83, 0xFA, AutoCombatUIStatic.TitleHeight);
	a.jcc(0x8D, "tabs_or_body");
	a.emit(0x81, 0xFB); a.dword(456);
	a.jcc(0x8C, "title_minimize_test");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StatePressedControl);
	a.dword(4);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("title_minimize_test");
	a.emit(0x81, 0xFB); a.dword(441);
	a.jcc(0x8C, "drag_title");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StatePressedControl);
	a.dword(3);
	AutoCombatUIStatic.emitMarkDirty(a);
	a.jmp("consume");
	a.label("drag_title");
	a.emit(0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08, 0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameMouseDown);
	a.jmp("consume");
	a.label("tabs_or_body");
	a.emit(0x83, 0xFA, AutoCombatUIStatic.TabsBottom);
	a.jcc(0x8D, "footer_test");
