AutoCombatUIStatic.buildDraw = function(stateVir, paths, fillRectVir, strings, monsterRowsVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	AutoCombatUIStatic.pushImm(a, 0x00FFFFFF);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.WindowClearSurface);
	AutoCombatUIStatic.emitBody(a, stateVir, paths);
	AutoCombatUIStatic.emitChrome(a, stateVir, fillRectVir, strings);
	AutoCombatUIStatic.emitPageText(a, stateVir, strings);
	AutoCombatUIStatic.emitPageControls(
		a, stateVir, paths, fillRectVir, strings, monsterRowsVir
	);
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

AutoCombatUIStatic.emitMarkDirty = function(a)
{
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowDirtyOffset);
	a.dword(1);
};

AutoCombatUIStatic.emitRectGate = function(a, left, top, right, bottom, failLabel)
{
	a.emit(0x81, 0xFB); a.dword(left);
	a.jcc(0x8C, failLabel);
	a.emit(0x81, 0xFB); a.dword(right);
	a.jcc(0x8D, failLabel);
	a.emit(0x81, 0xFA); a.dword(top);
	a.jcc(0x8C, failLabel);
	a.emit(0x81, 0xFA); a.dword(bottom);
	a.jcc(0x8D, failLabel);
};

AutoCombatUIStatic.emitSendScalarConst = function(a, mutationSenderVir, settingId, value)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, value);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.emitSendScalarPairConst = function(a, mutationSenderVir, settingId, value, value2)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	AutoCombatUIStatic.pushImm(a, value2);
	AutoCombatUIStatic.pushImm(a, value);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.emitSendScalarPairMem = function(a, mutationSenderVir, settingId, valueVir, value2)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	AutoCombatUIStatic.pushImm(a, value2);
	a.emit(0xFF, 0x35); a.dword(valueVir);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.emitSendScalarPairConstIfFeature = function(
	a, stateVir, mutationSenderVir, featureMask, settingId, value, value2, id
)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	const skipLabel = `send_scalar_pair_${id}_skip`;
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(0xA9); a.dword(featureMask);
	a.jcc(0x84, skipLabel);
	AutoCombatUIStatic.emitSendScalarPairConst(a, mutationSenderVir, settingId, value, value2);
	a.label(skipLabel);
};

AutoCombatUIStatic.emitSendScalarPairMemIfFeature = function(
	a, stateVir, mutationSenderVir, featureMask, settingId, valueVir, value2, id
)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	const skipLabel = `send_scalar_pair_mem_${id}_skip`;
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(0xA9); a.dword(featureMask);
	a.jcc(0x84, skipLabel);
	AutoCombatUIStatic.pushImm(a, value2);
	a.emit(0xFF, 0x35); a.dword(valueVir);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
	a.label(skipLabel);
};

AutoCombatUIStatic.emitSendScalarFlagToggle = function(a, stateVir, mutationSenderVir, settingId, mask)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	a.emit(0x33, 0xC9);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.emit(0xA9); a.dword(mask);
	a.emit(0x0F, 0x94, 0xC1);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x51);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
	a.emit(0x81, 0x35); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.dword(mask);
};

AutoCombatUIStatic.emitSendScalarEqToggle = function(
	a, stateVir, mutationSenderVir, offset, eqValue, settingId, eqSendValue, neSendValue, id
)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	const neLabel = `send_scalar_${id}_ne`;
	const callLabel = `send_scalar_${id}_call`;
	a.emit(0x83, 0x3D); a.dword(stateVir + offset); a.emit(eqValue);
	a.jcc(0x85, neLabel);
	a.emit(0xC7, 0x05); a.dword(stateVir + offset); a.dword(eqSendValue);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, eqSendValue);
	a.jmp(callLabel);
	a.label(neLabel);
	a.emit(0xC7, 0x05); a.dword(stateVir + offset); a.dword(neSendValue);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, neSendValue);
	a.label(callLabel);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

