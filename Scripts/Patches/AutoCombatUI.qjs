		lootDropdownArrow: AutoCombatUIStatic.allocateString("v"),
		lootPriorityHeading: AutoCombatUIStatic.allocateString("Choose action priority."),
		lootFightFirst: AutoCombatUIStatic.allocateString(
			"Fight First - defeat targets before picking up items."
		),
		lootLootFirst: AutoCombatUIStatic.allocateString(
			"Loot First - pick up eligible items before fighting."
		),
		lootReturn: AutoCombatUIStatic.allocateString("Return to Town Settings"),
		lootReturnHint: AutoCombatUIStatic.allocateString(
			"Automatically return to town when the configured weight is exceeded."
		),
		lootContinue: AutoCombatUIStatic.allocateString("Continue hunting without looting when the weight exceeds the limit."),
		lootContinueHint: AutoCombatUIStatic.allocateString(
			"When weight reaches 90%, Stop Hunting and return to town"
		),
		registerItem: AutoCombatUIStatic.allocateString("Register Item"),
		registerSkill: AutoCombatUIStatic.allocateString("Register Skill"),
		moveDescriptions: [
			"Register Item", "Register Skill", "Register Item", "Register Skill"
		].map(text => AutoCombatUIStatic.allocateString(text)),

		returnTown: AutoCombatUIStatic.allocateString("Return to Town Settings"),
		reset: AutoCombatUIStatic.allocateString("Reset"),
		close: AutoCombatUIStatic.allocateString("Close")
	};

	const state = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.StateSize).fill(0), 4
	);
	const monsterRows = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.MonsterRowsSize).fill(0), 4
	);
	const attackSkillRows = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.AttackSkillRowsSize).fill(0), 4
	);
	const attackSkillIconKeys = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.SkillIconKeysSize).fill(0), 4
	);
	const supportSkillRows = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.AttackSkillRowsSize).fill(0), 4
	);
	const supportSkillIconKeys = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.SkillIconKeysSize).fill(0), 4
	);
	const healingSkillRow = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.AttackSkillRowSize).fill(0), 4
	);
	const healingSkillIconKey = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.SkillIconKeySize).fill(0), 4
	);
	const recoverySkillRows = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.RecoverySkillRowsSize).fill(0), 4
	);
	const recoverySkillIconKeys = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.RecoverySkillIconKeysSize).fill(0), 4
	);
	const itemRows = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.ItemRowsSize).fill(0), 4
	);
	const itemIconKeys = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.ItemIconKeysSize).fill(0), 4
	);
	const potionRows = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.PotionRowsSize).fill(0), 4
	);
	const potionIconKeys = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.PotionIconKeysSize).fill(0), 4
	);
	const moveRows = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.MoveRowsSize).fill(0), 4
	);
	const moveIconKeys = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.MoveIconKeysSize).fill(0), 4
	);
	const skillIconPath = AutoCombatUIStatic.allocateBytes(new Array(128).fill(0), 4);
	const skillLevelText = AutoCombatUIStatic.allocateBytes(new Array(8).fill(0), 4);
	const sliderPercentText = AutoCombatUIStatic.allocateBytes(new Array(16).fill(0), 4);
	const hoverText = AutoCombatUIStatic.allocateBytes(new Array(256).fill(0), 4);
	const lootWeaponText = AutoCombatUIStatic.allocateBytes(new Array(8).fill(0), 4);
	const lootArmorText = AutoCombatUIStatic.allocateBytes(new Array(8).fill(0), 4);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateSkillPage, 1);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StatePotionPage, 1);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateLootingPage, 1);

	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateMonsterBits, 0x07);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateLootCategoryBits, 0x0F);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateHealHpThreshold, 50);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateLootWeightLimit, 90);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateNormalAttackSpThreshold, 10);
	Exe.SetUint32(state.phy + AutoCombatUIStatic.StateStopAttackSpThreshold, 5);

	$$(_, 3, "Create the AutoHunt UI AHUI packet sender and snapshot receiver");
	const packetRefs = AutoCombatUIStatic.resolvePacketRefs(_);
	const openSender = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildOpenSender(state.vir, packetRefs)
	);
	const scalarSender = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildScalarSender(state.vir, packetRefs)
	);
	const snapshotReceiverVir = AutoCombatUIStatic.installSnapshotReceiver(
		_, state.vir, monsterRows.vir, attackSkillRows.vir,
		attackSkillIconKeys.vir, supportSkillRows.vir, supportSkillIconKeys.vir,
		healingSkillRow.vir, healingSkillIconKey.vir, recoverySkillRows.vir,
		recoverySkillIconKeys.vir, itemRows.vir, itemIconKeys.vir,
		potionRows.vir, potionIconKeys.vir, moveRows.vir, moveIconKeys.vir
	);

	$$(_, 4, "Create the QJS-only Auto Combat UIFrameWnd renderer and input path");
	const fillRect = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildFillRect()
	);
	const colorKeyBlit = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildColorKeyBlit()
	);
	AutoCombatUIStatic.ColorKeyBlitVir = colorKeyBlit.vir;
	const itemResolver = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildItemIconResolver()
	);
	const draw = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildDraw(
			state.vir, paths, fillRect.vir, strings, monsterRows.vir, attackSkillRows.vir,
			attackSkillIconKeys.vir, supportSkillRows.vir, supportSkillIconKeys.vir,
			healingSkillRow.vir, healingSkillIconKey.vir, recoverySkillRows.vir,
			recoverySkillIconKeys.vir, itemRows.vir, itemIconKeys.vir, potionRows.vir,
			potionIconKeys.vir, moveRows.vir, moveIconKeys.vir, itemResolver.vir,
			skillIconPath.vir, skillLevelText.vir, lootWeaponText.vir, lootArmorText.vir
		)
	);
	const mouseDown = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildMouseDown(
			state.vir, scalarSender.vir, monsterRows.vir,
			attackSkillRows.vir, supportSkillRows.vir,
			healingSkillRow.vir, recoverySkillRows.vir, itemRows.vir,
			potionRows.vir, moveRows.vir
		)
	);
	const sliderHover = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildNativeSliderMouseMove(
			state.vir, strings.sliderPercentFormat.vir, sliderPercentText.vir,
			potionRows.vir, attackSkillRows.vir, supportSkillRows.vir,
			healingSkillRow.vir, recoverySkillRows.vir, moveRows.vir,
			itemRows.vir, strings.skillTooltipFormat.vir,
			strings.moveSkillTooltipFormat.vir, strings.itemTooltipFormat.vir,
			hoverText.vir
		)
	);
	const mouseUp = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildMouseUp(state.vir, scalarSender.vir, potionRows.vir)
	);
	const mouseWheel = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildMouseWheel(state.vir)
	);
	const destructor = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildDestructor(state.vir)
	);
	const vtable = AutoCombatUIStatic.cloneFrameVtable(
		draw.vir, mouseDown.vir, mouseUp.vir, destructor.vir, sliderHover.vir,
		mouseWheel.vir
	);
	const autoBattleVisual = AutoCombatUIStatic.prepareControllerVisual(
		"autobattle", paths.autoBattle.blueIcon
	);
	const autoSupportVisual = AutoCombatUIStatic.prepareControllerVisual(
		"autopotion", paths.autoSupport.blueIcon
	);
	const controllerDraw = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildControllerDraw(
			state.vir, autoBattleVisual, autoSupportVisual
		)
	);
	const controllerMouseDown = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildControllerMouseDown(
			state.vir, AutoCombatUIStatic.StateAutoBattleDownX,
			AutoCombatUIStatic.StateAutoBattleDownY
		)
	);
	const controllerMouseUp = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildControllerMouseUp(
			state.vir, scalarSender.vir,
			AutoCombatUIStatic.StateAutoBattleDownX,
			AutoCombatUIStatic.StateAutoBattleDownY
		)
	);
	const controllerDestructor = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildControllerDestructor(
			state.vir, AutoCombatUIStatic.StateAutoBattleWindow
		)
	);
	const controllerVtable = AutoCombatUIStatic.cloneFrameVtable(
		controllerDraw.vir, controllerMouseDown.vir,
		controllerMouseUp.vir, controllerDestructor.vir
	);
	const ensureController = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildEnsureController(
			state.vir, AutoCombatUIStatic.StateAutoBattleWindow,
			controllerVtable.vir, [autoBattleVisual, autoSupportVisual],
			0x3F1, 160, 260,
			AutoCombatUIStatic.ControllerGroupWidth,
			AutoCombatUIStatic.ControllerGroupHeight
		)
	);
	const syncController = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildSyncController(state.vir, controllerVtable.vir)
	);
	const controllerRedraw = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildControllerRedrawBridge(controllerVtable.vir)
	);
	const controllerDirtyPhy = Exe.Vir2Phy(
		AutoCombatUIStatic.UiUpdateSurfaceDirty, CODE
	);
	if (controllerDirtyPhy < 0)
		throw Error("AutoCombatUI: UI dirty-clear instruction is not mapped");
	Exe.SetJMP(controllerDirtyPhy, controllerRedraw.vir, 2);
	const toggle = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildToggle(
			state.vir, vtable.vir, openSender.vir, [ensureController.vir]
		)
	);
	const menuTogglePending = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.MenuToggleStateSize).fill(0), 4
	);
	const menuToggleRequest = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildMenuToggleRequest(menuTogglePending.vir)
	);
	const controllerBootstrap = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildControllerBootstrap(
			state.vir, openSender.vir, ensureController.vir,
			syncController.vir, menuTogglePending.vir, toggle.vir,
			getAsyncKeyStateIat
		)
	);
	Exe.SetCALL(verified.controllerBootstrapPhy, controllerBootstrap.vir, 0);
	const menuButtonVisible = AutoCombatUIStatic.allocateBytes([1, 0, 0, 0], 4);
	CACHE.put("AutoCombatUI.MenuButton.v1", {
		toggleVir: toggle.vir,
		requestVir: menuToggleRequest.vir,
		pendingVir: menuTogglePending.vir,
		visibleVir: menuButtonVisible.vir,
		visiblePhy: menuButtonVisible.phy,
		label: "Auto Hunt"
	});

	// Keep one test-cycle fallback. Remove after the native menu click is
	// accepted in-game so a bad client ABI cannot strand the settings UI.
	CustomSlashCommand.register(_ + ".SlashCommand", {
		command: "/autohunt",
		targetVir: toggle.vir
	});

	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
	{
		PatchDiagnostics.add("AutoCombatUI.QjsOnly", {
			buildDate: Exe.BuildDate,
			opener: "ROGlobalZeroMenu.AutoHuntButton",
			fallbackCommand: "/autohunt",
			nativeHost: "UIFrameWnd",
			windowSize: [
				AutoCombatUIStatic.WindowWidth,
				AutoCombatUIStatic.WindowHeight
			],
			tabs: tabLabels,
			pages: {Basic: 1, Monster: 1, Skill: 3, Potion: 2, Looting: 2, Move: 1, Item: 1},
			stateVir: state.vir,
			vtableVir: vtable.vir,
			drawVir: draw.vir,
			mouseDownVir: mouseDown.vir,
			mouseUpVir: mouseUp.vir,
			toggleVir: toggle.vir,
			menuToggleRequestVir: menuToggleRequest.vir,
			menuTogglePendingVir: menuTogglePending.vir,
			menuButtonVisibleVir: menuButtonVisible.vir,
			openSenderVir: openSender.vir,
			scalarSenderVir: scalarSender.vir,
			snapshotReceiverVir,
			monsterRowsVir: monsterRows.vir,
			clientPacketId: AutoCombatUIStatic.ClientPacketId,
			serverPacketId: AutoCombatUIStatic.ServerPacketId,
			externalModules: 0,
			serverBehavior: "snapshot-open-set-scalar-native-delay-input",
			controllerSize: AutoCombatUIStatic.ControllerSize,
			controllerGroupSize: [
				AutoCombatUIStatic.ControllerGroupWidth,
				AutoCombatUIStatic.ControllerGroupHeight
			],
			controllerLayout: "autocombat-left-autosupport-right",
			controllerBootstrapVir: controllerBootstrap.vir,
			controllerAnimation: "native-str-baked-frames",
			persistence: true
		});
	}
	return true;
};

AutoCombatUI.validate = function()
{
	if (Exe.BuildDate !== AutoCombatUIStatic.BuildDate)
		return false;
	try
	{
		AutoCombatUIStatic.verifyNativeContracts();
		return true;
	}
	catch (_)
	{
		return false;
	}
};
