	a.label("body_done");
};

AutoCombatUIStatic.emitChrome = function(a, stateVir, fillRectVir, strings)
{
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 0, 0, 470, 17, 0xFF7E97BE);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 1, 1, 468, 15, 0xFFDDEBFA);
	for (let y = 3; y < 15; y += 2)
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, 2, y, 466, 1, 0xFFEEF5FD);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 0, 16, 470, 1, 0xFF7892BA);
	for (const x of [6, 441, 456])
	{
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, 6, 7, 7, 0xFF708FC1);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, 6, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 5, 6, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, 11, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 5, 11, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 2, 8, 3, 3, 0xFFDDEBFA);
	}

	const widths = [67, 67, 67, 67, 67, 67, 68];
	let left = 0;
	for (let index = 0; index < 7; index++)
	{
		const normalLabel = `tab_${index}_normal`;
		const doneLabel = `tab_${index}_done`;
		a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab);
		a.emit(0x00 + index);
		a.jcc(0x85, normalLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, widths[index], 21, 0xFFD8E7FA
		);
		a.jmp(doneLabel);
		a.label(normalLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, widths[index], 21, 0xFFF2F6FC
		);
		a.label(doneLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, 1, 21, 0xFF97ADCF
		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 37, widths[index], 1, 0xFF97ADCF
		);
		AutoCombatUIStatic.emitText(
				a, strings.tabs[index].vir, left + 14, 20, 14, 0x00844E30
		);
		left += widths[index];
	}
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 469, 17, 1, 21, 0xFF97ADCF);
};

AutoCombatUIStatic.emitPageText = function(a, stateVir, strings)
{
	const emitPair = function(heading, subtitle, headingX, subtitleX)
	{
		AutoCombatUIStatic.emitText(a, heading.vir, headingX, 42, 15, 0x0078432C);
		AutoCombatUIStatic.emitText(a, subtitle.vir, subtitleX, 60, 14, 0x00B27E41);
	};
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x00); a.jcc(0x85, "text_monster");
	emitPair(strings.headings[0], strings.subtitles[0], 112, 53);
	a.jmp("page_text_done");
	a.label("text_monster");
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_skill");
	emitPair(strings.headings[1], strings.subtitles[1], 131, 126);
	a.jmp("page_text_done");
	a.label("text_skill");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "text_potion");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_skill_2");
	emitPair(strings.skillHeadings[0], strings.skillSubtitles[0], 178, 139);
	AutoCombatUIStatic.emitText(a, strings.attackSettings.vir, 177, 87, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.normalAttack.vir, 48, 276, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_skill_2");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "text_skill_3");
	emitPair(strings.skillHeadings[1], strings.skillSubtitles[1], 174, 128);
	AutoCombatUIStatic.emitText(a, strings.supportSettings.vir, 170, 87, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_skill_3");
	emitPair(strings.skillHeadings[2], strings.skillSubtitles[2], 158, 126);
	AutoCombatUIStatic.emitText(a, strings.healSettings.vir, 76, 87, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.statusSettings.vir, 304, 87, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_potion");
	a.emit(0x83, 0xF8, 0x03); a.jcc(0x85, "text_looting");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StatePotionPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_potion_2");
	emitPair(strings.potionHeadings[0], strings.potionSubtitles[0], 139, 78);
	a.jmp("page_text_done");
	a.label("text_potion_2");
	emitPair(strings.potionHeadings[1], strings.potionSubtitles[1], 130, 112);
	AutoCombatUIStatic.emitText(a, strings.statusPotion.vir, 164, 87, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_looting");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x85, "text_move");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_looting_2");
	emitPair(strings.lootingHeadings[0], strings.lootingSubtitles[0], 159, 112);
	AutoCombatUIStatic.emitText(a, strings.weight.vir, 198, 104, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_looting_2");
	emitPair(strings.lootingHeadings[1], strings.lootingSubtitles[1], 142, 118);
	a.jmp("page_text_done");
	a.label("text_move");
	a.emit(0x83, 0xF8, 0x05); a.jcc(0x85, "text_item");
	emitPair(strings.headings[5], strings.subtitles[5], 160, 128);
	AutoCombatUIStatic.emitText(a, strings.teleport.vir, 195, 88, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.returning.vir, 198, 183, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_item");
	emitPair(strings.headings[6], strings.subtitles[6], 169, 79);
	AutoCombatUIStatic.emitText(a, strings.buffItems.vir, 185, 87, 14, 0x0078432C);
	a.label("page_text_done");
	AutoCombatUIStatic.emitText(a, strings.reset.vir, 15, 322, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.close.vir, 431, 322, 14, 0x0078432C);
};

AutoCombatUIStatic.emitPageControls = function(
	a, stateVir, paths, fillRectVir, strings
)
{
	const dark = 0x00554B46;
	const blue = 0x0078432C;
	const link = 0x00B27E41;
	const drawCheck = function(on, x, y, label, id)
	{
		AutoCombatUIStatic.emitDrawFull(
			a, (on ? paths.checkboxOn : paths.checkboxOff).vir, x, y,
			`control_check_${id}`
		);
		if (label)
			AutoCombatUIStatic.emitText(a, label.vir, x + 20, y - 2, 14, dark);
	};

	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x00); a.jcc(0x85, "controls_monster");
	for (let index = 0; index < strings.basicOptions.length; index++)
