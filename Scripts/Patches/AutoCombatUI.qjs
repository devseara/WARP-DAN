	a.emit(0x8B, 0xD8);
	a.emit(0xA1); a.dword(valueVir);
	a.emit(0x83, 0xF8, AutoCombatUIStatic.LootSliderMaximum);
	a.jcc(0x86, `${label}_thumb_value_clamped`);
	a.emit(0xB8); a.dword(AutoCombatUIStatic.LootSliderMaximum);
	a.label(`${label}_thumb_value_clamped`);
	a.emit(0x69, 0xC0); a.dword(AutoCombatUIStatic.LootSliderThumbTravel);
	a.emit(0x33, 0xD2, 0xB9); a.dword(AutoCombatUIStatic.LootSliderMaximum);
	a.emit(0xF7, 0xF1);
	a.emit(0x05); a.dword(AutoCombatUIStatic.LootSliderTrackX);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.LootSliderThumbY);
	a.emit(0x50, 0x53, 0x56);
	a.call(AutoCombatUIStatic.ColorKeyBlitVir);
	a.label(thumbMissing);
	a.emit(0x5B);

	drawArrow(
		8, paths.sliderLeft, paths.sliderLeftOver,
		paths.sliderLeftPressed, AutoCombatUIStatic.LootSliderGroupX, "left"
