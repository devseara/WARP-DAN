	BuildDate: 20250716,
	WindowManager: 0x0131F4E8,
	Renderer: 0x012515F8,
	OperatorNew: 0x00DBBC4F,
	FrameConstructor: 0x0086B950,
	FrameDeletingDestructor: 0x0086E240,
	FrameMouseDown: 0x00880AD0,
	WindowSetSize: 0x00A245C0,
	WindowAddTopLevelFront: 0x00A2D240,
	WindowBringToFront: 0x00A4B750,
	WindowClearSurface: 0x00A1CB30,
	FrameVtable: 0x0102FE08,
	FrameVtableEntries: 53,
	FrameVtableDestructor: 0x0086E240,
	FrameVtableDraw: 0x005DD270,
	FrameVtableMouseDown: 0x00880AD0,
	FrameObjectSize: 0xB4,
	WindowWidthOffset: 0x14,
	WindowHeightOffset: 0x18,
	WindowXOffset: 0x1C,
	WindowYOffset: 0x20,
	WindowSurfaceOffset: 0x24,
	WindowVisibleOffset: 0x28,
	WindowIdOffset: 0x2C,
	WindowDirtyOffset: 0x58,
	SurfaceWidthOffset: 0x04,
	SurfacePixelsOffset: 0x18,
	RendererWidthOffset: 0x28,
	RendererHeightOffset: 0x2C,
	GetTexMgr: 0x00A90350,
	ConvPath: 0x00A9F030,
	LoadSurface: 0x00A8D4A0,
	ImageDraw: 0x00A1D260,
	TextDraw: 0x00A25A70,
	TabItmFormat: 0x0102AC48,
	WindowWidth: 470,
	WindowHeight: 346,
	TitleHeight: 17,
	TabsBottom: 38,
