		a, paths.scrollThumbDown.vir, AutoCombatUIStatic.BasicScrollX,
		stateVir + AutoCombatUIStatic.StateMonsterThumbY,
		3 + middleCount * 3, "monster_scroll_thumb_down"
	);
};

AutoCombatUIStatic.emitFormatUint = function(a, valueVir, formatVir, textVir)
{
	a.emit(0xFF, 0x35); a.dword(valueVir);
	AutoCombatUIStatic.pushImm(a, formatVir);
	AutoCombatUIStatic.pushImm(a, textVir);
	a.call(AutoCombatUIStatic.StringFormat);
	a.emit(0x83, 0xC4, 0x0C);
};

AutoCombatUIStatic.buildFillRect = function()
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.emit(0x8B, 0x75, 0x08);
	a.emit(0x8B, 0x76, AutoCombatUIStatic.WindowSurfaceOffset);
