	a.emit(0x0F, 0xB7, 0x86); a.dword(AutoCombatUIStatic.SnapshotLootDetailsOffset + 4);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateLootWeaponOptionMin);
	a.emit(0x0F, 0xB7, 0x86); a.dword(AutoCombatUIStatic.SnapshotLootDetailsOffset + 6);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateLootArmorOptionMin);
	a.emit(0x81, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
