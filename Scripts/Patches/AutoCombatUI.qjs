AutoCombatUIStatic.emitFooterButtons = function(a, stateVir, paths)
{
	const drawButton = function(controlId, normal, pressed, x, label)
	{
		const normalLabel = `${label}_normal`;
		const doneLabel = `${label}_done`;
		a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StatePressedControl);
		a.emit(controlId);
		a.jcc(0x85, normalLabel);
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, pressed.vir, x, AutoCombatUIStatic.FooterButtonY,
			`${label}_pressed_draw`
		);
		a.jmp(doneLabel);
		a.label(normalLabel);
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, normal.vir, x, AutoCombatUIStatic.FooterButtonY,
			`${label}_normal_draw`
		);
		a.label(doneLabel);
	};
	drawButton(
		1, paths.btnReset, paths.btnResetPressed,
		AutoCombatUIStatic.FooterResetX, "footer_reset"
	);
	drawButton(
		2, paths.btnClose, paths.btnClosePressed,
		AutoCombatUIStatic.FooterCloseX, "footer_close"
	);
};

AutoCombatUIStatic.emitPageControls = function(
	a, stateVir, paths, fillRectVir, strings, monsterRowsVir, attackSkillRowsVir,
	attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, healingSkillRowVir,
	healingSkillIconKeyVir, recoverySkillRowsVir, recoverySkillIconKeysVir, itemRowsVir,
	itemIconKeysVir, potionRowsVir, potionIconKeysVir, moveRowsVir, moveIconKeysVir,
	itemResolverVir, skillIconPathVir, skillLevelTextVir, lootWeaponTextVir, lootArmorTextVir
)
{
	const dark = 0x00554B46;
	const blue = 0x0078432C;
	const link = 0x00B27E41;
	const drawCheck = function(on, x, y, label, id)
	{
		AutoCombatUIStatic.emitDrawFull(
			a, (on ? paths.checkboxOn : paths.checkboxOff).vir, x, y,
			`control_check_${id}`
		);
		if (label)
			AutoCombatUIStatic.emitText(a, label.vir, x + 20, y - 2, 14, dark);
	};
	const drawStateCheck = function(test, x, y, label, id, fontSize = 14)
	{
		const offLabel = `control_check_${id}_off`;
		const doneLabel = `control_check_${id}_done`;
		if (test.kind === "flag")
		{
			a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
			a.emit(0xA9); a.dword(test.mask);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "nonzero")
		{
			a.emit(0x83, 0x3D); a.dword(stateVir + test.offset); a.emit(0);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "eq")
		{
			a.emit(0x83, 0x3D); a.dword(stateVir + test.offset); a.emit(test.value);
			a.jcc(0x85, offLabel);
		}
		else if (test.kind === "neq")
		{
			a.emit(0x83, 0x3D); a.dword(stateVir + test.offset); a.emit(test.value);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "bit")
		{
			a.emit(0xA1); a.dword(stateVir + test.offset);
			a.emit(0xA9); a.dword(test.mask);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "mem_bit")
		{
			a.emit(0xA1); a.dword(test.address);
			a.emit(0xA9); a.dword(test.mask);
			a.jcc(0x84, offLabel);
		}
		AutoCombatUIStatic.emitDrawFull(
			a, paths.checkboxOn.vir, x, y, `control_check_${id}_on`
		);
		a.jmp(doneLabel);
		a.label(offLabel);
		AutoCombatUIStatic.emitDrawFull(
