		const boxX = basicValueX[option];
		const boxWidth = basicValueWidth[option];
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, boxX, y - 3, boxWidth, 19, 0xFFB7C3D2);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, boxX + 1, y - 2, boxWidth - 2, 17, 0xFFFFFFFF);
		AutoCombatUIStatic.emitFormatUint(
