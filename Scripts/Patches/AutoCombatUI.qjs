		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 259, 319 + row, width, 1, 0xFF486A9E
		);
	}
	for (let row = 0; row < 6; row++)
	{
		const width = 6 - row;
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 206 + row, 326 + row, width, 1, 0xFF486A9E
		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 259, 326 + row, width, 1, 0xFF486A9E
		);
	}
	for (let row = 0; row < 5; row++)
	{
		const width = row + 1;
