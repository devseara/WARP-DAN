AutoCombatUIStatic.emitDrawColorKeyStateY = function(
	a, pathVir, x, stateYVir, yOffset, label
)
{
	const done = `${label}_done`;
	AutoCombatUIStatic.emitLoadSurface(a, pathVir, done);
	a.emit(0x8B, 0x15); a.dword(stateYVir);
	if (yOffset !== 0)
	{
		a.emit(0x81, 0xC2); a.dword(yOffset);
	}
	a.emit(0x52);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x50, 0x56);
	a.call(AutoCombatUIStatic.ColorKeyBlitVir);
	a.label(done);
};

AutoCombatUIStatic.emitScrollbar = function(
	a, stateVir, paths, stateOffset, maximum, thumbMiddleCount, label
)
{
	AutoCombatUIStatic.emitDrawColorKeyFull(
		a, paths.scrollUp.vir, AutoCombatUIStatic.BasicScrollX,
		AutoCombatUIStatic.BasicScrollTop, `${label}_scroll_up_draw`
	);
	for (let y = AutoCombatUIStatic.BasicScrollTop + 3;
		y < AutoCombatUIStatic.BasicScrollBottom; y += 3)
	{
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, paths.scrollTrack.vir, AutoCombatUIStatic.BasicScrollX, y,
			`${label}_scroll_track_${y}`
		);
	}
	AutoCombatUIStatic.emitDrawColorKeyFull(
		a, paths.scrollDown.vir, AutoCombatUIStatic.BasicScrollX,
		AutoCombatUIStatic.BasicScrollBottom, `${label}_scroll_down_draw`
	);
	for (let offset = 0; offset <= maximum; offset++)
	{
		const next = `${label}_scroll_thumb_${offset}_next`;
		a.emit(0x83, 0x3D); a.dword(stateVir + stateOffset);
		a.emit(offset);
		a.jcc(0x85, next);
		const thumbHeight = 6 + thumbMiddleCount * 3;
		const thumbTop = AutoCombatUIStatic.BasicScrollTop + 3;
		const thumbTravel = AutoCombatUIStatic.BasicScrollBottom - thumbTop - thumbHeight;
		const y = thumbTop + Math.round(offset * thumbTravel / maximum);
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, paths.scrollThumbUp.vir, AutoCombatUIStatic.BasicScrollX, y,
			`${label}_scroll_thumb_${offset}_up`
		);
		for (let middle = 0; middle < thumbMiddleCount; middle++)
			AutoCombatUIStatic.emitDrawColorKeyFull(
				a, paths.scrollThumbMid.vir, AutoCombatUIStatic.BasicScrollX,
				y + 3 + middle * 3, `${label}_scroll_thumb_${offset}_mid_${middle}`
			);
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, paths.scrollThumbDown.vir, AutoCombatUIStatic.BasicScrollX,
			y + 3 + thumbMiddleCount * 3,
			`${label}_scroll_thumb_${offset}_down`
		);
		a.label(next);
	}
};
AutoCombatUIStatic.emitMonsterScrollbar = function(a, stateVir, paths)
{
	const label = "monster";
	AutoCombatUIStatic.emitDrawColorKeyFull(
		a, paths.scrollUp.vir, AutoCombatUIStatic.BasicScrollX,
		AutoCombatUIStatic.BasicScrollTop, `${label}_scroll_up_draw`
	);
	for (let y = AutoCombatUIStatic.BasicScrollTop + 3;
		y < AutoCombatUIStatic.BasicScrollBottom; y += 3)
	{
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, paths.scrollTrack.vir, AutoCombatUIStatic.BasicScrollX, y,
			`${label}_scroll_track_${y}`
		);
	}
	AutoCombatUIStatic.emitDrawColorKeyFull(
		a, paths.scrollDown.vir, AutoCombatUIStatic.BasicScrollX,
		AutoCombatUIStatic.BasicScrollBottom, `${label}_scroll_down_draw`
	);

	const middleCount = 15;
	const thumbHeight = 6 + middleCount * 3;
	const thumbTop = AutoCombatUIStatic.BasicScrollTop + 3;
	const thumbTravel = AutoCombatUIStatic.BasicScrollBottom - thumbTop - thumbHeight;
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateMonsterRowCount);
	a.emit(0x83, 0xE8, AutoCombatUIStatic.MonsterVisibleRows);
	a.jcc(0x89, "monster_thumb_limit_nonnegative");
	a.emit(0x33, 0xC0);
	a.label("monster_thumb_limit_nonnegative");
