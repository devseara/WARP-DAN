AutoCombatUIStatic.bytesToHex = function(bytes)
{
	return bytes.map(value =>
		(value & 0xFF).toString(16).padStart(2, "0")
	).join(" ");
};

AutoCombatUIStatic.asm = function()
{
	const bytes = [];
	const labels = {};
	const fixups = [];
	const put32 = function(out, pos, value)
	{
		const v = value >>> 0;
		out[pos] = v & 0xFF;
		out[pos + 1] = (v >>> 8) & 0xFF;
		out[pos + 2] = (v >>> 16) & 0xFF;
		out[pos + 3] = (v >>> 24) & 0xFF;
	};
	return {
		bytes,
		emit: function(...values)
		{
			for (const value of values)
				bytes.push(value & 0xFF);
		},
		dword: function(value)
		{
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			put32(bytes, pos, value);
		},
		word: function(value)
		{
			bytes.push(value & 0xFF, (value >>> 8) & 0xFF);
		},
		label: function(name)
		{
			if (Object.prototype.hasOwnProperty.call(labels, name))
				throw Error(`AutoCombatUI: duplicate label ${name}`);
			labels[name] = bytes.length;
		},
		rel32: function(opcode, target)
		{
			bytes.push(opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		call: function(target) { this.rel32(0xE8, target); },
		jmp: function(target) { this.rel32(0xE9, target); },
		jcc: function(opcode, target)
		{
			bytes.push(0x0F, opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		finish: function(baseVir)
		{
			const out = bytes.slice();
			for (const fixup of fixups)
			{
				if (typeof fixup.target === "string" &&
					!Object.prototype.hasOwnProperty.call(labels, fixup.target))
					throw Error(`AutoCombatUI: unresolved label ${fixup.target}`);
				const targetVir = typeof fixup.target === "string"
					? baseVir + labels[fixup.target]
					: fixup.target;
				put32(out, fixup.pos, targetVir - (baseVir + fixup.pos + 4));
			}
			return AutoCombatUIStatic.bytesToHex(out);
		}
	};
};

AutoCombatUIStatic.allocateBytes = function(bytes, alignment = 1)
{
	const [phy, vir] = Exe.Allocate(bytes.length, alignment);
	Exe.SetHex(phy, AutoCombatUIStatic.bytesToHex(bytes));
	return {phy, vir, size: bytes.length};
};

AutoCombatUIStatic.allocateCode = function(assembler)
{
	const [phy, vir] = Exe.Allocate(assembler.bytes.length, 0x10);
	Exe.SetHex(phy, assembler.finish(vir));
	return {phy, vir, size: assembler.bytes.length};
};

AutoCombatUIStatic.asciiBytes = function(text, nulTerminate = true)
{
	const bytes = [];
	for (let i = 0; i < text.length; i++)
		bytes.push(text.charCodeAt(i) & 0xFF);
	if (nulTerminate)
		bytes.push(0);
	return bytes;
};

AutoCombatUIStatic.findBytes = function(bytes, needle)
{
	for (let i = 0; i <= bytes.length - needle.length; i++)
	{
		let match = true;
		for (let j = 0; j < needle.length; j++)
		{
			if (bytes[i + j] !== needle[j])
			{
				match = false;
				break;
			}
		}
		if (match)
			return i;
	}
	return -1;
};

AutoCombatUIStatic.readCString = function(virAddr, maxLength)
{
	const phy = Exe.Vir2Phy(virAddr);
	if (phy < 0)
		throw Error(`AutoCombatUI: string 0x${virAddr.toString(16)} is not mapped`);
	const bytes = [];
	for (let i = 0; i < maxLength; i++)
	{
		const value = Exe.GetUint8(phy + i);
		bytes.push(value);
		if (value === 0)
			return bytes;
	}
	throw Error(`AutoCombatUI: unterminated string at 0x${virAddr.toString(16)}`);
};

AutoCombatUIStatic.buildResourcePath = function(relativePath)
{
	const source = AutoCombatUIStatic.readCString(
		AutoCombatUIStatic.TabItmFormat, 192
	);
	const needle = AutoCombatUIStatic.asciiBytes("basic_interface\\", false);
	const pos = AutoCombatUIStatic.findBytes(source, needle);
	if (pos < 0)
		throw Error("AutoCombatUI: texture directory prefix not found");
	return AutoCombatUIStatic.allocateBytes(
		source.slice(0, pos).concat(AutoCombatUIStatic.asciiBytes(relativePath))
	);
};

AutoCombatUIStatic.buildTexturePath = function(relativePath)
{
	// ConvPath resolves the stock effect namespace below data\\texture.
	// Parent traversal is not supported by the GRF resolver even when its error
	// log prints a normalized texture\\effect path.
	return AutoCombatUIStatic.allocateBytes(
		AutoCombatUIStatic.asciiBytes(relativePath)
	);
};

AutoCombatUIStatic.allocateString = function(text)
{
	return AutoCombatUIStatic.allocateBytes(
		AutoCombatUIStatic.asciiBytes(text)
	);
};

AutoCombatUIStatic.pushImm = function(a, value)
{
	if (value >= -128 && value <= 127)
		a.emit(0x6A, value);
	else
	{
		a.emit(0x68);
		a.dword(value);
	}
};

AutoCombatUIStatic.SharedPacketRouteGlobalKey = "AutoHuntPincode.Packet0BEF.Router.Global.v1";

AutoCombatUIStatic.beginSharedPacketRoute = function(patchName)
{
	CACHE.addUser(AutoCombatUIStatic.SharedPacketRouteGlobalKey, patchName);
	Exe.ActivateGlobal();
	Exe.BeginTag(CACHE.getTag(AutoCombatUIStatic.SharedPacketRouteGlobalKey));
};

AutoCombatUIStatic.endSharedPacketRoute = function(patchName)
{
	Exe.EndTag();
	Exe.ActivePatch = patchName;
};

AutoCombatUIStatic.packetTableEntryVir = function(packetId)
{
	return AutoCombatUIStatic.PacketSwitchTable + (packetId - 0x73) * 4;
};

AutoCombatUIStatic.buildSharedPacketRouter = function(route)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x3E); a.word(AutoCombatUIStatic.ServerPacketId);
	a.jcc(0x85, "fallback");
	a.emit(0x66, 0x83, 0x7E, 0x02, 0x08);
	a.jcc(0x82, "fallback");
	a.emit(0x81, 0x7E, 0x04); a.dword(AutoCombatUIStatic.PacketMagic);
	a.jcc(0x84, "route_ahui");
	a.emit(0x81, 0x7E, 0x04); a.dword(AutoCombatUIStatic.PincodeMagic);
	a.jcc(0x84, "route_pincode");
	a.jmp("fallback");

	a.label("route_ahui");
	a.emit(0xA1); a.dword(route.ahuiHandlerCellVir);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "fallback");
	a.emit(0x61, 0x9D);
	a.emit(0xA1); a.dword(route.ahuiHandlerCellVir);
	a.emit(0xFF, 0xE0);

	a.label("route_pincode");
	a.emit(0xA1); a.dword(route.pincodeHandlerCellVir);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "fallback");
	a.emit(0x61, 0x9D);
	a.emit(0xA1); a.dword(route.pincodeHandlerCellVir);
	a.emit(0xFF, 0xE0);

	a.label("fallback");
	a.emit(0x61, 0x9D);
	a.emit(0xA1); a.dword(route.fallbackCellVir);
	a.emit(0xFF, 0xE0);
	return a;
};

AutoCombatUIStatic.ensureSharedPacketRoute = function(entryVir, entryPhy)
{
	const key = "AutoCombatUI.Packet0BEF.Router.v2";
	const cached = CACHE.get(key);
	if (cached && cached.entryVir === entryVir)
	{
		if (Exe.GetUint32(entryPhy) !== cached.routerVir)
			Exe.SetUint32(entryPhy, cached.routerVir);
		return cached;
	}

	const peerRoute = CACHE.get("InGamePincodeUI.Packet0BEF.Router.v2");
	if (peerRoute && peerRoute.entryVir === entryVir)
	{
		if (Exe.GetUint32(entryPhy) !== peerRoute.routerVir)
			Exe.SetUint32(entryPhy, peerRoute.routerVir);
		CACHE.put(key, peerRoute);
		return peerRoute;
	}

	const current = Exe.GetUint32(entryPhy);
	let fallbackVir = current;
	if (current === AutoCombatUIStatic.PacketDefaultHandler)
		fallbackVir = AutoCombatUIStatic.PacketMainLoopReturn;
	else if (Exe.Vir2Phy(current, CODE) < 0)
		throw Error(
			`AutoCombatUI: shared 0x0BEF fallback ${current.toHex(true)} is not executable`
		);

	const [dataPhy, dataVir] = Exe.Allocate(12, 4);
	const route = {
		entryVir,
		ahuiHandlerCellPhy: dataPhy,
		ahuiHandlerCellVir: dataVir,
		pincodeHandlerCellPhy: dataPhy + 4,
		pincodeHandlerCellVir: dataVir + 4,
		fallbackCellPhy: dataPhy + 8,
		fallbackCellVir: dataVir + 8,
		fallbackVir
	};
	Exe.SetUint32(route.ahuiHandlerCellPhy, 0);
	Exe.SetUint32(route.pincodeHandlerCellPhy, 0);
	Exe.SetUint32(route.fallbackCellPhy, fallbackVir);
	const router = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildSharedPacketRouter(route)
	);
	route.routerPhy = router.phy;
	route.routerVir = router.vir;
	if (Exe.GetUint32(entryPhy) !== current)
		throw Error("AutoCombatUI: dispatcher entry changed while installing shared router");
	Exe.SetUint32(entryPhy, route.routerVir);
	CACHE.put(key, route);
	return route;
};

AutoCombatUIStatic.resolvePacketRefs = function(_)
{
	const cacheKey = "AutoCombatUI.PacketRefs";
	if (CACHE.has(cacheKey))
		return CACHE.get(cacheKey);

	const packetTemplate =
		MOV(EAX, 0x0844) +
		PUSH(ESI) +
		MOV([EBP, 0x8], AX);
	const packetTemplateAddrs = Exe.FindHexN(packetTemplate);
	if (packetTemplateAddrs.isEmpty())
		throw Error("AutoCombatUI: packet sender template not found");

	const senderCandidates = packetTemplateAddrs.filter(addr =>
		Exe.FindLastHex(PUSH(0x13E), addr, addr - 0x80) > 0
	);
	if (senderCandidates.length !== 1)
		throw Error(
			"AutoCombatUI: expected one packet sender template, found " +
			senderCandidates.length
		);

	const packetSender = senderCandidates[0];
	const refs = {
		packetCtorA: Exe.GetTgtAddr(packetSender + 0x0A + 1),
		packetSend: Exe.GetTgtAddr(packetSender + 0x29 + 1)
	};
	CACHE.put(cacheKey, refs);
	return refs;
};

AutoCombatUIStatic.buildOpenSender = function(stateVir, refs)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, AutoCombatUIStatic.ClientHeaderSize);
	a.emit(0x56);
	a.emit(0x66, 0xC7, 0x45, 0xEC); a.word(AutoCombatUIStatic.ClientPacketId);
	a.emit(0x66, 0xC7, 0x45, 0xEE); a.word(AutoCombatUIStatic.ClientHeaderSize);
	a.emit(0xC7, 0x45, 0xF0); a.dword(AutoCombatUIStatic.PacketMagic);
	a.emit(0x66, 0xC7, 0x45, 0xF4); a.word(AutoCombatUIStatic.ProtocolVersion);
	a.emit(0x66, 0xC7, 0x45, 0xF6); a.word(AutoCombatUIStatic.MessageOpen);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x40);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRevision);
	a.emit(0x89, 0x45, 0xFC);
	a.call(refs.packetCtorA);
	a.emit(0x8B, 0xF0);
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "done");
	a.emit(0x8D, 0x45, 0xEC);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.ClientHeaderSize);
	a.emit(0x8B, 0xCE);
	a.call(refs.packetSend);
	a.label("done");
	a.emit(0x5E, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

AutoCombatUIStatic.buildScalarSender = function(stateVir, refs)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, AutoCombatUIStatic.ScalarHeaderSize);
	a.emit(0x56);
	a.emit(0x66, 0xC7, 0x45, 0xE0); a.word(AutoCombatUIStatic.ClientPacketId);
	a.emit(0x66, 0xC7, 0x45, 0xE2); a.word(AutoCombatUIStatic.ScalarHeaderSize);
	a.emit(0xC7, 0x45, 0xE4); a.dword(AutoCombatUIStatic.PacketMagic);
	a.emit(0x66, 0xC7, 0x45, 0xE8); a.word(AutoCombatUIStatic.ProtocolVersion);
	a.emit(0x66, 0xC7, 0x45, 0xEA); a.word(AutoCombatUIStatic.MessageSetScalar);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x40);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x89, 0x45, 0xEC);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRevision);
	a.emit(0x89, 0x45, 0xF0);
	a.emit(0x8B, 0x45, 0x08);
	a.emit(0x89, 0x45, 0xF4);
	a.emit(0x8B, 0x45, 0x0C);
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0x8B, 0x45, 0x10);
	a.emit(0x89, 0x45, 0xFC);
	a.call(refs.packetCtorA);
	a.emit(0x8B, 0xF0);
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "done");
	a.emit(0x8D, 0x45, 0xE0);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.ScalarHeaderSize);
	a.emit(0x8B, 0xCE);
	a.call(refs.packetSend);
	a.label("done");
	a.emit(0x5E, 0x8B, 0xE5, 0x5D, 0xC2, 0x0C, 0x00);
	return a;
};

