	a.jcc(0x84, "done");
	a.emit(0x8B, 0x7E, AutoCombatUIStatic.SurfacePixelsOffset);
	a.emit(0x85, 0xFF);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x5E, AutoCombatUIStatic.SurfaceWidthOffset);
	a.emit(0x8B, 0x45, 0x10);
	a.emit(0x0F, 0xAF, 0xC3);
	a.emit(0x03, 0x45, 0x0C);
	a.emit(0x8D, 0x3C, 0x87);
	a.emit(0x8B, 0x55, 0x18);
	a.label("row");
	a.emit(0x8B, 0x4D, 0x14);
	a.emit(0x8B, 0xC7);
	a.label("pixel");
	a.emit(0x8B, 0x75, 0x1C);
	a.emit(0x89, 0x30);
	a.emit(0x83, 0xC0, 0x04);
	a.emit(0x49);
	a.jcc(0x85, "pixel");
	a.emit(0x8D, 0x3C, 0x9F);
	a.emit(0x4A);
	a.jcc(0x85, "row");
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x5D);
	a.emit(0xC2, 0x18, 0x00);
	return a;
};

