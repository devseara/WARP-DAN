		throw Error("AutoCombatUI: CustomSlashCommand helper unavailable");

	$$(_, 1, "Verify the native UIFrameWnd ABI and input handlers");
	const verified = AutoCombatUIStatic.verifyNativeContracts();
	const getAsyncKeyStateIat = Exe.FindFunc("GetAsyncKeyState", "USER32.dll");
	if (!Number.isInteger(getAsyncKeyStateIat) || getAsyncKeyStateIat < 0)
		throw Error("AutoCombatUI: GetAsyncKeyState import not found");

	$$(_, 2, "Build client-native Auto Hunt resource paths");
	const paths = {
