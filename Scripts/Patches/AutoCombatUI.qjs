	a.emit(0xB8); a.dword(AutoCombatUIStatic.LootSliderMaximum);
	a.jmp("loot_drag_store");
	a.label("loot_drag_scale");
	a.emit(0x2D); a.dword(AutoCombatUIStatic.LootSliderTrackX);
	a.emit(0x69, 0xC0); a.dword(AutoCombatUIStatic.LootSliderMaximum);
	a.emit(0x33, 0xD2, 0xB9); a.dword(AutoCombatUIStatic.LootSliderThumbTravel);
