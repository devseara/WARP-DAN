AutoCombatUIStatic.emitChrome = function(a, stateVir, paths, fillRectVir, strings)
{
	AutoCombatUIStatic.emitDrawFull(
		a, paths.titleBar.vir, 0, 0, "native_title_bar"
	);
	const drawTitleButton = function(controlId, normal, pressed, x, label)
	{
		const normalLabel = `${label}_normal`;
		const doneLabel = `${label}_done`;
		a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StatePressedControl);
		a.emit(controlId);
		a.jcc(0x85, normalLabel);
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, pressed.vir, x, 3, `${label}_pressed_draw`
		);
		a.jmp(doneLabel);
		a.label(normalLabel);
		AutoCombatUIStatic.emitDrawColorKeyFull(
			a, normal.vir, x, 3, `${label}_normal_draw`
		);
		a.label(doneLabel);
	};
	AutoCombatUIStatic.emitDrawColorKeyFull(
		a, paths.sysBaseOff.vir, 3, 3, "title_base_left"
	);
	drawTitleButton(3, paths.sysBaseOff, paths.sysBaseOn, 441, "title_minimize");
	drawTitleButton(4, paths.sysCloseOff, paths.sysCloseOn, 456, "title_close");
	AutoCombatUIStatic.emitText(a, strings.windowTitle.vir, 167, 1, 12, 0x0078432C);

	const widths = [67, 67, 67, 67, 67, 67, 68];
	let left = 0;
	for (let index = 0; index < 7; index++)
	{
		const normalLabel = `tab_${index}_normal`;
		const doneLabel = `tab_${index}_done`;
		a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab);
		a.emit(0x00 + index);
		a.jcc(0x85, normalLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, widths[index], 21, 0xFFD8E7FA
		);
		a.jmp(doneLabel);
		a.label(normalLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, widths[index], 21, 0xFFF2F6FC
		);
		a.label(doneLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, 1, 21, 0xFF97ADCF
		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 37, widths[index], 1, 0xFF97ADCF
		);
		AutoCombatUIStatic.emitCenteredText(
			a, strings.tabs[index].vir, left, 20, widths[index], 14, 0x00844E30,
			12, `tab_label_${index}`
		);
		left += widths[index];
	}
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 469, 17, 1, 21, 0xFF97ADCF);
};

AutoCombatUIStatic.emitPageText = function(a, stateVir, strings)
{
	const emitPair = function(heading, subtitle, headingX, subtitleX)
	{
		AutoCombatUIStatic.emitCenteredText(
			a, heading.vir, 0, 42, AutoCombatUIStatic.WindowWidth, 15,
			0x0078432C, 72, `page_heading_${heading.vir}`, 1
		);
		AutoCombatUIStatic.emitCenteredText(
			a, subtitle.vir, 0, 60, AutoCombatUIStatic.WindowWidth, 14,
			0x00B27E41, 80, `page_subtitle_${subtitle.vir}`
		);
	};
	const emitCenteredHighlightedText = function(
		full, prefix, highlight, left, y, width, height, baseColor, highlightColor
	)
	{
		a.emit(0x53, 0x57);
		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, height);
		AutoCombatUIStatic.pushImm(a, 1);
		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, full.vir);
		a.emit(0x8B, 0xCE);
		a.call(AutoCombatUIStatic.TextWidth);
		a.emit(0xBB); a.dword(width);
		a.emit(0x2B, 0xD8, 0xD1, 0xFB);
		a.emit(0x81, 0xC3); a.dword(left);

		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, height);
		AutoCombatUIStatic.pushImm(a, 1);
		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, prefix.vir);
		a.emit(0x8B, 0xCE);
		a.call(AutoCombatUIStatic.TextWidth);
		a.emit(0x8B, 0xFB, 0x03, 0xF8);

		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, baseColor);
		AutoCombatUIStatic.pushImm(a, height);
		AutoCombatUIStatic.pushImm(a, 1);
		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, full.vir);
		AutoCombatUIStatic.pushImm(a, y);
		a.emit(0x53, 0x8B, 0xCE);
		a.call(AutoCombatUIStatic.TextDraw);

		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, highlightColor);
		AutoCombatUIStatic.pushImm(a, height);
		AutoCombatUIStatic.pushImm(a, 1);
		AutoCombatUIStatic.pushImm(a, 0);
		AutoCombatUIStatic.pushImm(a, highlight.vir);
		AutoCombatUIStatic.pushImm(a, y);
		a.emit(0x57, 0x8B, 0xCE);
		a.call(AutoCombatUIStatic.TextDraw);
		a.emit(0x5F, 0x5B);
	};
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x00); a.jcc(0x85, "text_monster");
	AutoCombatUIStatic.emitCenteredText(
		a, strings.headings[0].vir, 0, 41, AutoCombatUIStatic.WindowWidth, 17,
		0x0078432C, 72, "page_heading_basic", 1
	);
	emitCenteredHighlightedText(
		strings.basicIntroFull, strings.basicIntroPrefix, strings.basicIntroLink,
		0, 83, AutoCombatUIStatic.WindowWidth, 13, 0x00554B46, 0x00B27E41
	);
	AutoCombatUIStatic.emitCenteredText(
		a, strings.basicIntroSaved.vir, 0, 100, AutoCombatUIStatic.WindowWidth, 13,
		0x00554B46, 80, "page_basic_saved"
	);
	a.jmp("page_text_done");
	a.label("text_monster");
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_skill");
	emitPair(strings.headings[1], strings.subtitles[1], 131, 126);
	a.jmp("page_text_done");
	a.label("text_skill");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "text_potion");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_skill_2");
	emitPair(strings.skillHeadings[0], strings.skillSubtitles[0], 158, 83);
	AutoCombatUIStatic.emitCenteredText(a, strings.attackSettings.vir, 25, 87, 420, 14, 0x0078432C, 40, "attack_settings", 1);
	AutoCombatUIStatic.emitText(a, strings.normalAttack.vir, 48, 276, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.normalAttackHint.vir, 48, 294, 12, 0x00B27E41);
	a.jmp("page_text_done");
	a.label("text_skill_2");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "text_skill_3");
	emitPair(strings.skillHeadings[1], strings.skillSubtitles[1], 154, 79);
	AutoCombatUIStatic.emitCenteredText(a, strings.supportSettings.vir, 25, 87, 420, 14, 0x0078432C, 40, "support_settings", 1);
	a.jmp("page_text_done");
	a.label("text_skill_3");
	emitPair(strings.skillHeadings[2], strings.skillSubtitles[2], 158, 126);
	AutoCombatUIStatic.emitCenteredText(a, strings.healSettings.vir, 25, 87, 261, 14, 0x0078432C, 30, "heal_settings", 1);
	AutoCombatUIStatic.emitCenteredText(a, strings.statusSettings.vir, 291, 87, 168, 14, 0x0078432C, 30, "status_settings", 1);
	a.jmp("page_text_done");
	a.label("text_potion");
	a.emit(0x83, 0xF8, 0x03); a.jcc(0x85, "text_looting");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StatePotionPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_potion_2");
	emitPair(strings.potionHeadings[0], strings.potionSubtitles[0], 139, 78);
	a.jmp("page_text_done");
	a.label("text_potion_2");
	emitPair(strings.potionHeadings[1], strings.potionSubtitles[1], 130, 112);
	AutoCombatUIStatic.emitCenteredText(
		a, strings.statusPotion.vir, 25, 87, 420, 14, 0x0078432C, 40,
		"status_potion_heading", 1
	);
	a.jmp("page_text_done");
	a.label("text_looting");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x85, "text_move");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_looting_2");
	emitPair(strings.lootingHeadings[0], strings.lootingSubtitles[0], 159, 112);
	AutoCombatUIStatic.emitCenteredText(
		a, strings.weight.vir, 75, 104, 319, 12, 0x0078432C, 30,
		"looting_weight_heading", 1
	);
	a.jmp("page_text_done");
	a.label("text_looting_2");
	emitPair(strings.lootingHeadings[1], strings.lootingSubtitles[1], 142, 118);
	a.jmp("page_text_done");
	a.label("text_move");
	a.emit(0x83, 0xF8, 0x05); a.jcc(0x85, "text_item");
	emitPair(strings.headings[5], strings.subtitles[5], 160, 128);
	AutoCombatUIStatic.emitCenteredText(a, strings.teleport.vir, 25, 88, 420, 14, 0x0078432C, 30, "move_teleport_heading", 1);
	AutoCombatUIStatic.emitCenteredText(a, strings.returning.vir, 25, 183, 420, 14, 0x0078432C, 30, "move_return_heading", 1);
	a.jmp("page_text_done");
	a.label("text_item");
	emitPair(strings.headings[6], strings.subtitles[6], 169, 79);
	AutoCombatUIStatic.emitCenteredText(a, strings.buffItems.vir, 25, 87, 420, 14, 0x0078432C, 30, "buff_item_heading", 1);
	a.label("page_text_done");
};

