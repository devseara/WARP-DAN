	{
		AutoCombatUIStatic.emitDrawFull(
			a, (index < 3 ? paths.monsterRowOn : paths.monsterRowOff).vir,
			14, 87 + index * 38, `monster_row_${index}`
		);
		AutoCombatUIStatic.emitText(a, strings.monsters[index].vir, 90, 96 + index * 38, 14, dark);
		AutoCombatUIStatic.emitDrawFull(
			a, (index < 3 ? paths.checkboxOn : paths.checkboxOff).vir,
			420, 97 + index * 38, `monster_check_${index}`
		);
	}
	a.jmp("controls_done");

	a.label("controls_skill");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "controls_potion");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "controls_done");
	const skillXs = [108, 185, 262];
	const skillColors = [0xFFDF564C, 0xFFEF9F41, 0xFF648FDB];
