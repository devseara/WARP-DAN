};

AutoCombatUIStatic.buildControllerMouseUp = function(
	stateVir, mutationSenderVir, downXOffset, downYOffset, flagBit, settingId
)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	a.emit(0x8B, 0x5D, 0x08, 0x8B, 0x7D, 0x0C);
	a.emit(0x57, 0x53, 0x8B, 0xCE);
	a.call(AutoCombatUIStatic.FrameMouseUp);
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowXOffset, 0x2B, 0x05); a.dword(stateVir + downXOffset);
	a.emit(0x99, 0x33, 0xC2, 0x2B, 0xC2, 0x83, 0xF8, 0x03);
	a.jcc(0x87, "controller_mouse_done");
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowYOffset, 0x2B, 0x05); a.dword(stateVir + downYOffset);
	a.emit(0x99, 0x33, 0xC2, 0x2B, 0xC2, 0x83, 0xF8, 0x03);
	a.jcc(0x87, "controller_mouse_done");
	a.emit(0x33, 0xC9, 0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.emit(0xA9); a.dword(1 << flagBit);
	a.emit(0x0F, 0x94, 0xC1);
	AutoCombatUIStatic.pushImm(a, 0);
