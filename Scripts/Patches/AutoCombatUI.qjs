AutoCombatUIStatic.bytesToHex = function(bytes)
{
	return bytes.map(value =>
		(value & 0xFF).toString(16).padStart(2, "0")
	).join(" ");
};

AutoCombatUIStatic.asm = function()
{
	const bytes = [];
	const labels = {};
	const fixups = [];
	const put32 = function(out, pos, value)
	{
		const v = value >>> 0;
		out[pos] = v & 0xFF;
		out[pos + 1] = (v >>> 8) & 0xFF;
		out[pos + 2] = (v >>> 16) & 0xFF;
		out[pos + 3] = (v >>> 24) & 0xFF;
	};
	return {
		bytes,
		emit: function(...values)
		{
			for (const value of values)
				bytes.push(value & 0xFF);
		},
		dword: function(value)
		{
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			put32(bytes, pos, value);
		},
		word: function(value)
		{
			bytes.push(value & 0xFF, (value >>> 8) & 0xFF);
		},
		label: function(name)
		{
			if (Object.prototype.hasOwnProperty.call(labels, name))
				throw Error(`AutoCombatUI: duplicate label ${name}`);
			labels[name] = bytes.length;
		},
		rel32: function(opcode, target)
		{
			bytes.push(opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		call: function(target) { this.rel32(0xE8, target); },
		jmp: function(target) { this.rel32(0xE9, target); },
		jcc: function(opcode, target)
		{
			bytes.push(0x0F, opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		finish: function(baseVir)
		{
			const out = bytes.slice();
			for (const fixup of fixups)
			{
				if (typeof fixup.target === "string" &&
					!Object.prototype.hasOwnProperty.call(labels, fixup.target))
					throw Error(`AutoCombatUI: unresolved label ${fixup.target}`);
				const targetVir = typeof fixup.target === "string"
					? baseVir + labels[fixup.target]
					: fixup.target;
				put32(out, fixup.pos, targetVir - (baseVir + fixup.pos + 4));
			}
			return AutoCombatUIStatic.bytesToHex(out);
		}
	};
};

AutoCombatUIStatic.allocateBytes = function(bytes, alignment = 1)
{
	const [phy, vir] = Exe.Allocate(bytes.length, alignment);
	Exe.SetHex(phy, AutoCombatUIStatic.bytesToHex(bytes));
	return {phy, vir, size: bytes.length};
};

AutoCombatUIStatic.allocateCode = function(assembler)
{
	const [phy, vir] = Exe.Allocate(assembler.bytes.length, 0x10);
	Exe.SetHex(phy, assembler.finish(vir));
	return {phy, vir, size: assembler.bytes.length};
};

AutoCombatUIStatic.asciiBytes = function(text, nulTerminate = true)
{
	const bytes = [];
	for (let i = 0; i < text.length; i++)
		bytes.push(text.charCodeAt(i) & 0xFF);
	if (nulTerminate)
		bytes.push(0);
	return bytes;
};

AutoCombatUIStatic.findBytes = function(bytes, needle)
{
	for (let i = 0; i <= bytes.length - needle.length; i++)
	{
		let match = true;
		for (let j = 0; j < needle.length; j++)
		{
			if (bytes[i + j] !== needle[j])
			{
				match = false;
				break;
			}
		}
		if (match)
			return i;
	}
	return -1;
};

AutoCombatUIStatic.readCString = function(virAddr, maxLength)
{
	const phy = Exe.Vir2Phy(virAddr);
	if (phy < 0)
		throw Error(`AutoCombatUI: string 0x${virAddr.toString(16)} is not mapped`);
	const bytes = [];
	for (let i = 0; i < maxLength; i++)
	{
		const value = Exe.GetUint8(phy + i);
		bytes.push(value);
		if (value === 0)
			return bytes;
	}
	throw Error(`AutoCombatUI: unterminated string at 0x${virAddr.toString(16)}`);
};

AutoCombatUIStatic.buildResourcePath = function(relativePath)
{
	const source = AutoCombatUIStatic.readCString(
		AutoCombatUIStatic.TabItmFormat, 192
	);
	const needle = AutoCombatUIStatic.asciiBytes("basic_interface\\", false);
	const pos = AutoCombatUIStatic.findBytes(source, needle);
	if (pos < 0)
		throw Error("AutoCombatUI: texture directory prefix not found");
	return AutoCombatUIStatic.allocateBytes(
		source.slice(0, pos).concat(AutoCombatUIStatic.asciiBytes(relativePath))
	);
};

AutoCombatUIStatic.buildTexturePath = function(relativePath)
{
	// ConvPath resolves the stock effect namespace below data\\texture.
	// Parent traversal is not supported by the GRF resolver even when its error
	// log prints a normalized texture\\effect path.
	return AutoCombatUIStatic.allocateBytes(
		AutoCombatUIStatic.asciiBytes(relativePath)
	);
};
AutoCombatUIStatic.allocateString = function(text)
{
	return AutoCombatUIStatic.allocateBytes(
		AutoCombatUIStatic.asciiBytes(text)
	);
};

AutoCombatUIStatic.pushImm = function(a, value)
{
	if (value >= -128 && value <= 127)
		a.emit(0x6A, value);
	else
	{
		a.emit(0x68);
		a.dword(value);
	}
};

AutoCombatUIStatic.SharedPacketRouteGlobalKey = "AutoHuntPincode.Packet0BEF.Router.Global.v1";

AutoCombatUIStatic.beginSharedPacketRoute = function(patchName)
{
	CACHE.addUser(AutoCombatUIStatic.SharedPacketRouteGlobalKey, patchName);
	Exe.ActivateGlobal();
	Exe.BeginTag(CACHE.getTag(AutoCombatUIStatic.SharedPacketRouteGlobalKey));
};

AutoCombatUIStatic.endSharedPacketRoute = function(patchName)
{
	Exe.EndTag();
	Exe.ActivePatch = patchName;
};
AutoCombatUIStatic.packetTableEntryVir = function(packetId)
{
	return AutoCombatUIStatic.PacketSwitchTable + (packetId - 0x73) * 4;
};

AutoCombatUIStatic.buildSharedPacketRouter = function(route)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x3E); a.word(AutoCombatUIStatic.ServerPacketId);
	a.jcc(0x85, "fallback");
	a.emit(0x66, 0x83, 0x7E, 0x02, 0x08);
	a.jcc(0x82, "fallback");
	a.emit(0x81, 0x7E, 0x04); a.dword(AutoCombatUIStatic.PacketMagic);
	a.jcc(0x84, "route_ahui");
	a.emit(0x81, 0x7E, 0x04); a.dword(AutoCombatUIStatic.PincodeMagic);
	a.jcc(0x84, "route_pincode");
	a.jmp("fallback");

	a.label("route_ahui");
	a.emit(0xA1); a.dword(route.ahuiHandlerCellVir);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "fallback");
	a.emit(0x61, 0x9D);
	a.emit(0xA1); a.dword(route.ahuiHandlerCellVir);
	a.emit(0xFF, 0xE0);

	a.label("route_pincode");
	a.emit(0xA1); a.dword(route.pincodeHandlerCellVir);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "fallback");
	a.emit(0x61, 0x9D);
	a.emit(0xA1); a.dword(route.pincodeHandlerCellVir);
	a.emit(0xFF, 0xE0);

	a.label("fallback");
	a.emit(0x61, 0x9D);
	a.emit(0xA1); a.dword(route.fallbackCellVir);
	a.emit(0xFF, 0xE0);
	return a;
};

AutoCombatUIStatic.ensureSharedPacketRoute = function(entryVir, entryPhy)
{
	const key = "AutoCombatUI.Packet0BEF.Router.v2";
	const cached = CACHE.get(key);
	if (cached && cached.entryVir === entryVir)
	{
		if (Exe.GetUint32(entryPhy) !== cached.routerVir)
			Exe.SetUint32(entryPhy, cached.routerVir);
		return cached;
	}

	const peerRoute = CACHE.get("InGamePincodeUI.Packet0BEF.Router.v2");
	if (peerRoute && peerRoute.entryVir === entryVir)
	{
		if (Exe.GetUint32(entryPhy) !== peerRoute.routerVir)
			Exe.SetUint32(entryPhy, peerRoute.routerVir);
		CACHE.put(key, peerRoute);
		return peerRoute;
	}

	const current = Exe.GetUint32(entryPhy);
	let fallbackVir = current;
	if (current === AutoCombatUIStatic.PacketDefaultHandler)
		fallbackVir = AutoCombatUIStatic.PacketMainLoopReturn;
	else if (Exe.Vir2Phy(current, CODE) < 0)
		throw Error(
			`AutoCombatUI: shared 0x0BEF fallback ${current.toHex(true)} is not executable`
		);

	const [dataPhy, dataVir] = Exe.Allocate(12, 4);
	const route = {
		entryVir,
		ahuiHandlerCellPhy: dataPhy,
		ahuiHandlerCellVir: dataVir,
		pincodeHandlerCellPhy: dataPhy + 4,
		pincodeHandlerCellVir: dataVir + 4,
		fallbackCellPhy: dataPhy + 8,
		fallbackCellVir: dataVir + 8,
		fallbackVir
	};
	Exe.SetUint32(route.ahuiHandlerCellPhy, 0);
	Exe.SetUint32(route.pincodeHandlerCellPhy, 0);
	Exe.SetUint32(route.fallbackCellPhy, fallbackVir);
	const router = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildSharedPacketRouter(route)
	);
	route.routerPhy = router.phy;
	route.routerVir = router.vir;
	if (Exe.GetUint32(entryPhy) !== current)
		throw Error("AutoCombatUI: dispatcher entry changed while installing shared router");
	Exe.SetUint32(entryPhy, route.routerVir);
	CACHE.put(key, route);
	return route;
};

AutoCombatUIStatic.resolvePacketRefs = function(_)
{
	const cacheKey = "AutoCombatUI.PacketRefs";
	if (CACHE.has(cacheKey))
		return CACHE.get(cacheKey);

	const packetTemplate =
		MOV(EAX, 0x0844) +
		PUSH(ESI) +
		MOV([EBP, 0x8], AX);
	const packetTemplateAddrs = Exe.FindHexN(packetTemplate);
	if (packetTemplateAddrs.isEmpty())
		throw Error("AutoCombatUI: packet sender template not found");

	const senderCandidates = packetTemplateAddrs.filter(addr =>
		Exe.FindLastHex(PUSH(0x13E), addr, addr - 0x80) > 0
	);
	if (senderCandidates.length !== 1)
		throw Error(
			"AutoCombatUI: expected one packet sender template, found " +
			senderCandidates.length
		);

	const packetSender = senderCandidates[0];
	const refs = {
		packetCtorA: Exe.GetTgtAddr(packetSender + 0x0A + 1),
		packetSend: Exe.GetTgtAddr(packetSender + 0x29 + 1)
	};
	CACHE.put(cacheKey, refs);
	return refs;
};

AutoCombatUIStatic.buildOpenSender = function(stateVir, refs)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, AutoCombatUIStatic.ClientHeaderSize);
	a.emit(0x56);
	a.emit(0x66, 0xC7, 0x45, 0xEC); a.word(AutoCombatUIStatic.ClientPacketId);
	a.emit(0x66, 0xC7, 0x45, 0xEE); a.word(AutoCombatUIStatic.ClientHeaderSize);
	a.emit(0xC7, 0x45, 0xF0); a.dword(AutoCombatUIStatic.PacketMagic);
	a.emit(0x66, 0xC7, 0x45, 0xF4); a.word(AutoCombatUIStatic.ProtocolVersion);
	a.emit(0x66, 0xC7, 0x45, 0xF6); a.word(AutoCombatUIStatic.MessageOpen);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x40);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRevision);
	a.emit(0x89, 0x45, 0xFC);
	a.call(refs.packetCtorA);
	a.emit(0x8B, 0xF0);
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "done");
	a.emit(0x8D, 0x45, 0xEC);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.ClientHeaderSize);
	a.emit(0x8B, 0xCE);
	a.call(refs.packetSend);
	a.label("done");
	a.emit(0x5E, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

AutoCombatUIStatic.buildScalarSender = function(stateVir, refs)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, AutoCombatUIStatic.ScalarHeaderSize);
	a.emit(0x56);
	a.emit(0x66, 0xC7, 0x45, 0xE0); a.word(AutoCombatUIStatic.ClientPacketId);
	a.emit(0x66, 0xC7, 0x45, 0xE2); a.word(AutoCombatUIStatic.ScalarHeaderSize);
	a.emit(0xC7, 0x45, 0xE4); a.dword(AutoCombatUIStatic.PacketMagic);
	a.emit(0x66, 0xC7, 0x45, 0xE8); a.word(AutoCombatUIStatic.ProtocolVersion);
	a.emit(0x66, 0xC7, 0x45, 0xEA); a.word(AutoCombatUIStatic.MessageSetScalar);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x40);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x89, 0x45, 0xEC);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRevision);
	a.emit(0x89, 0x45, 0xF0);
	a.emit(0x8B, 0x45, 0x08);
	a.emit(0x89, 0x45, 0xF4);
	a.emit(0x8B, 0x45, 0x0C);
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0x8B, 0x45, 0x10);
	a.emit(0x89, 0x45, 0xFC);
	a.call(refs.packetCtorA);
	a.emit(0x8B, 0xF0);
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "done");
	a.emit(0x8D, 0x45, 0xE0);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.ScalarHeaderSize);
	a.emit(0x8B, 0xCE);
	a.call(refs.packetSend);
	a.label("done");
	a.emit(0x5E, 0x8B, 0xE5, 0x5D, 0xC2, 0x0C, 0x00);
	return a;
};

AutoCombatUIStatic.buildSnapshotReceiver = function(stateVir, monsterRowsVir, attackSkillRowsVir, attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, route)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x3E); a.word(AutoCombatUIStatic.ServerPacketId);
	a.jcc(0x85, "fallback");
	a.emit(0x66, 0x83, 0x7E, 0x02); a.emit(AutoCombatUIStatic.SnapshotSize);
	a.jcc(0x82, "fallback");
	a.emit(0x81, 0x7E, 0x04); a.dword(AutoCombatUIStatic.PacketMagic);
	a.jcc(0x85, "fallback");
	a.emit(0x66, 0x83, 0x7E, 0x08); a.emit(AutoCombatUIStatic.ProtocolVersion);
	a.jcc(0x85, "fallback");
	a.emit(0x66, 0x83, 0x7E, 0x0A); a.emit(AutoCombatUIStatic.MessageSnapshot);
	a.jcc(0x85, "fallback");
	a.emit(0x8B, 0x46, 0x0C);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x8B, 0x46, 0x10);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRevision);
	a.emit(0x8B, 0x46, 0x14);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.emit(0x0F, 0xB7, 0x46, 0x18);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateStopMelee);
	a.emit(0x0F, 0xB7, 0x46, 0x1A);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StatePickupMode);
	a.emit(0x0F, 0xB7, 0x46, 0x1C);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StatePrioMode);
	a.emit(0x0F, 0xB7, 0x46, 0x34);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateListCounts);
	a.emit(0x0F, 0xB7, 0x46, 0x32);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateActionOnEnd);
	a.emit(0x0F, 0xB7, 0x46, 0x30);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateMonsterSurround);
	a.emit(0x8B, 0x46, 0x2C);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateTeleportNoMobDelay);
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.dword(0);
	a.emit(0x66, 0x83, 0x7E, 0x02); a.emit(AutoCombatUIStatic.SnapshotMonsterBitsSize);
	a.jcc(0x82, "snapshot_no_monster_bits");
	a.emit(0x8B, 0x46); a.emit(AutoCombatUIStatic.SnapshotMonsterBitsOffset);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateMonsterBits);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureMonsterSelection);
	a.label("snapshot_no_monster_bits");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateMonsterRowCount);
	a.dword(0);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotMonsterRowsSize);
	a.jcc(0x82, "snapshot_no_monster_rows");
	a.emit(0x0F, 0xB7, 0x46, AutoCombatUIStatic.SnapshotMonsterRowCountOffset);
	a.emit(0x83, 0xF8, AutoCombatUIStatic.MonsterDynamicRows);
	a.jcc(0x86, "snapshot_monster_row_count_ok");
	a.emit(0xB8); a.dword(AutoCombatUIStatic.MonsterDynamicRows);
	a.label("snapshot_monster_row_count_ok");
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateMonsterRowCount);
	a.emit(0x8D, 0x76, AutoCombatUIStatic.SnapshotMonsterRowsOffset);
	a.emit(0xBF); a.dword(monsterRowsVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.MonsterRowsSize / 4);
	a.emit(0xF3, 0xA5);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureMonsterRows);
	a.label("snapshot_no_monster_rows");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotLootCategoriesSize);
	a.jcc(0x82, "snapshot_no_loot_categories");
	a.emit(0x8B, 0x86); a.dword(AutoCombatUIStatic.SnapshotLootCategoriesOffset);
	a.emit(0x83, 0xE0, 0x0F);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateLootCategoryBits);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureLootCategories);
	a.label("snapshot_no_loot_categories");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotAttackSkillRowsSize);
	a.jcc(0x82, "snapshot_no_attack_skills");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotAttackSkillRowsOffset);
	a.emit(0xBF); a.dword(attackSkillRowsVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.AttackSkillRowsSize / 4);
	a.emit(0xF3, 0xA5);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureAttackSkills);
	a.label("snapshot_no_attack_skills");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotAttackSkillIconKeysSize);
	a.jcc(0x82, "snapshot_no_attack_skill_icons");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotAttackSkillIconKeysOffset);
	a.emit(0xBF); a.dword(attackSkillIconKeysVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.SkillIconKeysSize / 4);
	a.emit(0xF3, 0xA5);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureAttackSkillIcons);
	a.label("snapshot_no_attack_skill_icons");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotSupportSkillRowsSize);
	a.jcc(0x82, "snapshot_no_support_skills");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotSupportSkillRowsOffset);
	a.emit(0xBF); a.dword(supportSkillRowsVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.AttackSkillRowsSize / 4);
	a.emit(0xF3, 0xA5);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureSupportSkills);
	a.label("snapshot_no_support_skills");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotSupportSkillIconKeysSize);
	a.jcc(0x82, "snapshot_no_support_skill_icons");
	a.emit(0x8D, 0xB6); a.dword(AutoCombatUIStatic.SnapshotSupportSkillIconKeysOffset);
	a.emit(0xBF); a.dword(supportSkillIconKeysVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.SkillIconKeysSize / 4);
	a.emit(0xF3, 0xA5);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureSupportSkillIcons);
	a.label("snapshot_no_support_skill_icons");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateReady);
	a.dword(1);
	a.emit(0x8B, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateWindow);
	a.emit(0x85, 0xFF);
	a.jcc(0x84, "settings_dirty_done");
	a.emit(0xC7, 0x47, AutoCombatUIStatic.WindowDirtyOffset);
	a.dword(1);
	a.label("settings_dirty_done");
	for (const windowOffset of [
		AutoCombatUIStatic.StateAutoBattleWindow,
		AutoCombatUIStatic.StateAutoSupportWindow
	])
	{
		a.emit(0x8B, 0x3D); a.dword(stateVir + windowOffset);
		a.emit(0x85, 0xFF);
		a.jcc(0x84, `controller_dirty_next_${windowOffset}`);
		a.emit(0xC7, 0x47, AutoCombatUIStatic.WindowDirtyOffset);
		a.dword(1);
		a.label(`controller_dirty_next_${windowOffset}`);
	}
	a.label("handled");
	a.emit(0x61, 0x9D);
	a.emit(0xB8); a.dword(AutoCombatUIStatic.PacketMainLoopReturn);
	a.emit(0xFF, 0xE0);
	a.label("fallback");
	a.emit(0x61, 0x9D);
	a.emit(0xA1); a.dword(route.fallbackCellVir);
	a.emit(0xFF, 0xE0);
	return a;
};

AutoCombatUIStatic.installSnapshotReceiver = function(_, stateVir, monsterRowsVir, attackSkillRowsVir, attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir)
{
	const entryVir = AutoCombatUIStatic.packetTableEntryVir(
		AutoCombatUIStatic.ServerPacketId
	);
	const entryPhy = Exe.Vir2Phy(entryVir, CODE);
	if (entryPhy < 0)
		throw Error("AutoCombatUI: could not resolve AHUI dispatcher entry");
	AutoCombatUIStatic.beginSharedPacketRoute(_);
	const route = AutoCombatUIStatic.ensureSharedPacketRoute(entryVir, entryPhy);
	AutoCombatUIStatic.endSharedPacketRoute(_);

	const stateKey = "AutoCombatUI.SnapshotReceiver.v8";
	const receiver = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildSnapshotReceiver(stateVir, monsterRowsVir, attackSkillRowsVir, attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, route)
	);
	const ahuiHandlerCellPhy = route.ahuiHandlerCellPhy;
	const pincodeHandlerCellPhy = route.pincodeHandlerCellPhy;
	if (!Number.isInteger(ahuiHandlerCellPhy) || !Number.isInteger(pincodeHandlerCellPhy))
		throw Error("AutoCombatUI: shared 0x0BEF router cells are unavailable");
	const pincodeState = CACHE.get("InGamePincodeUI.State.StockUi.v8");
	AutoCombatUIStatic.beginSharedPacketRoute(_);
	if (Exe.GetUint32(entryPhy) !== route.routerVir)
		Exe.SetUint32(entryPhy, route.routerVir);
	if (pincodeState && pincodeState.entryVir === entryVir)
		Exe.SetUint32(pincodeHandlerCellPhy, pincodeState.handlerVir);
	Exe.SetUint32(ahuiHandlerCellPhy, receiver.vir);
	AutoCombatUIStatic.endSharedPacketRoute(_);

	CACHE.put(stateKey, {
		packetId: AutoCombatUIStatic.ServerPacketId,
		entryVir,
		handlerVir: receiver.vir,
		continueVir: route.fallbackVir,
		stateVir,
		monsterRowsVir,
		attackSkillRowsVir,
		attackSkillIconKeysVir,
		supportSkillRowsVir,
		supportSkillIconKeysVir,
		routerVir: route.routerVir
	});
	return receiver.vir;
};

AutoCombatUIStatic.emitPreserveSurfaceAlpha = function(a, label)
{
	const done = `${label}_surface_alpha_done`;
	a.emit(0x8B, 0x46, AutoCombatUIStatic.WindowSurfaceOffset);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, done);
	a.emit(0xC6, 0x40, AutoCombatUIStatic.SurfaceAlphaOffset, 0x01);
	a.label(done);
};
AutoCombatUIStatic.emitLoadSurface = function(a, pathVir, missingLabel)
{
	a.call(AutoCombatUIStatic.GetTexMgr);
	a.emit(0x8B, 0xD8, 0x85, 0xDB);
	a.jcc(0x84, missingLabel);
	AutoCombatUIStatic.pushImm(a, pathVir);
	a.call(AutoCombatUIStatic.ConvPath);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, missingLabel);
	a.emit(0x50, 0x8B, 0xCB);
	a.call(AutoCombatUIStatic.LoadSurface);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, missingLabel);
};

AutoCombatUIStatic.emitDrawFull = function(a, pathVir, x, y, label)
{
	const done = `${label}_done`;
	AutoCombatUIStatic.emitLoadSurface(a, pathVir, done);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.ImageDraw);
	a.label(done);
};


AutoCombatUIStatic.readBakedTga = function(relativePath)
{
	const fullPath = Warp.Path + "/" + relativePath;
	const handle = new BinFile(fullPath, 'r');
	if (!handle.Valid)
		throw Error(`AutoCombatUI: unable to read baked controller frame ${fullPath}`);
	const hex = handle.ReadHex();
	handle.Close();
	const pairs = hex.match(/[0-9A-Fa-f]{2}/g) || [];
	const bytes = pairs.map(value => parseInt(value, 16));
	if (bytes.length < 18 || bytes[1] !== 0 || bytes[2] !== 2 || bytes[16] !== 32)
		throw Error(`AutoCombatUI: unsupported baked TGA ${relativePath}`);
	const width = bytes[12] | (bytes[13] << 8);
	const height = bytes[14] | (bytes[15] << 8);
	if (width !== AutoCombatUIStatic.ControllerSize ||
		height !== AutoCombatUIStatic.ControllerSize)
	{
		throw Error(
			`AutoCombatUI: baked TGA ${relativePath} is ${width}x${height}, ` +
			`expected ${AutoCombatUIStatic.ControllerSize}x${AutoCombatUIStatic.ControllerSize}`
		);
	}
	const dataOffset = 18 + bytes[0];
	const rowBytes = width * 4;
	if (dataOffset + rowBytes * height > bytes.length)
		throw Error(`AutoCombatUI: truncated baked TGA ${relativePath}`);
	const topOrigin = (bytes[17] & 0x20) !== 0;
	const rightOrigin = (bytes[17] & 0x10) !== 0;
	const pixels = new Array(rowBytes * height);
	for (let y = 0; y < height; ++y)
	{
		const sourceY = topOrigin ? y : height - 1 - y;
		for (let x = 0; x < width; ++x)
		{
			const sourceX = rightOrigin ? width - 1 - x : x;
			const source = dataOffset + sourceY * rowBytes + sourceX * 4;
			const target = (y * width + x) * 4;
			pixels[target] = bytes[source];
			pixels[target + 1] = bytes[source + 1];
			pixels[target + 2] = bytes[source + 2];
			pixels[target + 3] = bytes[source + 3];
		}
	}
	return pixels;
};

AutoCombatUIStatic.allocateBakedSurface = function(relativePath)
{
	const descriptor = AutoCombatUIStatic.allocateBytes(
		new Array(AutoCombatUIStatic.TextureDescriptorSize).fill(0), 4
	);
	const pixels = AutoCombatUIStatic.allocateBytes(
		AutoCombatUIStatic.readBakedTga(relativePath), 4
	);
	Exe.SetUint32(
		descriptor.phy + AutoCombatUIStatic.TextureWidthOffset,
		AutoCombatUIStatic.ControllerSize
	);
	Exe.SetUint32(
		descriptor.phy + AutoCombatUIStatic.TextureHeightOffset,
		AutoCombatUIStatic.ControllerSize
	);
	Exe.SetUint32(
		descriptor.phy + AutoCombatUIStatic.TexturePixelsOffset,
		pixels.vir
	);
	return {
		descriptorPhy: descriptor.phy,
		descriptorVir: descriptor.vir,
		pixelsVir: pixels.vir
	};
};

AutoCombatUIStatic.buildBakedSurfaceInitializer = function(referencePathVir, surfaces)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	a.emit(0x83, 0x3D); a.dword(
		surfaces[0].descriptorVir + AutoCombatUIStatic.TextureReadyOffset
	); a.emit(0x01);
	a.jcc(0x84, "baked_done");
	AutoCombatUIStatic.emitLoadSurface(a, referencePathVir, "baked_done");
	a.emit(0x8B, 0x98); a.dword(AutoCombatUIStatic.TextureFlagsOffset);
	for (const surface of surfaces)
	{
		a.emit(0x89, 0x1D); a.dword(
			surface.descriptorVir + AutoCombatUIStatic.TextureFlagsOffset
		);
		a.emit(0xC7, 0x05); a.dword(
			surface.descriptorVir + AutoCombatUIStatic.TextureReadyOffset
		); a.dword(1);
	}
	a.label("baked_done");
	a.emit(0x61, 0x9D, 0xC3);
	return a;
};

AutoCombatUIStatic.prepareControllerVisual = function(group, referencePath)
{
	const prepared = {initializers: [], surfaces: []};
	const prepare = function(name)
	{
		const relativePath =
			`${AutoCombatUIStatic.ControllerAssetPath}/${group}/${name}`;
		const surface = AutoCombatUIStatic.allocateBakedSurface(relativePath);
		prepared.surfaces.push(surface);
		return surface;
	};
	prepared.activeFrames = [];
	for (let index = 0; index < AutoCombatUIStatic.ControllerFrameCount; ++index)
		prepared.activeFrames.push(prepare(`active_${index.toString().padStart(2, "0")}.tga`));
	prepared.inactive = prepare("inactive.tga");
	const initializer = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildBakedSurfaceInitializer(
			referencePath.vir, prepared.surfaces
		)
	);
	prepared.initializers.push(initializer.vir);
	return prepared;
};
AutoCombatUIStatic.emitDrawSurface = function(a, surface, x, y)
{
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, surface.descriptorVir);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.ImageDraw);
};

AutoCombatUIStatic.emitDrawSkillIcon = function(
	a, fillRectVir, iconKeyVir, iconFormatVir, iconPathVir, x, y, fallbackColor, label
)
{
	const missing = `${label}_missing`;
	const done = `${label}_done`;
	a.emit(0x80, 0x3D); a.dword(iconKeyVir); a.emit(0x00);
	a.jcc(0x84, missing);
	AutoCombatUIStatic.pushImm(a, iconKeyVir);
	AutoCombatUIStatic.pushImm(a, iconFormatVir);
	AutoCombatUIStatic.pushImm(a, iconPathVir);
	a.call(AutoCombatUIStatic.StringFormat);
	a.emit(0x83, 0xC4, 0x0C);
	AutoCombatUIStatic.emitLoadSurface(a, iconPathVir, missing);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.ImageDraw);
	a.jmp(done);
	a.label(missing);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 2, y + 2, 20, 20, fallbackColor);
	a.label(done);
};

AutoCombatUIStatic.emitDrawSkillLevel = function(
	a, fillRectVir, skillLevelVir, levelFormatVir, levelTextVir, x, y
)
{
	a.emit(0x0F, 0xB7, 0x05); a.dword(skillLevelVir);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, levelFormatVir);
	AutoCombatUIStatic.pushImm(a, levelTextVir);
	a.call(AutoCombatUIStatic.StringFormat);
	a.emit(0x83, 0xC4, 0x0C);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 14, y + 14, 15, 12, 0xFF486A9E);
	AutoCombatUIStatic.emitText(a, levelTextVir, x + 17, y + 13, 10, 0x00FFFFFF);
};

AutoCombatUIStatic.emitFillRect = function(a, fillRectVir, x, y, width, height, color)
{
	AutoCombatUIStatic.pushImm(a, color);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, width);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x56);
	a.call(fillRectVir);
};

AutoCombatUIStatic.emitText = function(a, textVir, x, y, height, color)
{
	if (!Number.isInteger(textVir) || textVir <= 0)
		throw Error("AutoCombatUI: invalid native text pointer");
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, color);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, 1);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, textVir);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.TextDraw);
};

AutoCombatUIStatic.buildFillRect = function()
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.emit(0x8B, 0x75, 0x08);
	a.emit(0x8B, 0x76, AutoCombatUIStatic.WindowSurfaceOffset);
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x7E, AutoCombatUIStatic.SurfacePixelsOffset);
	a.emit(0x85, 0xFF);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x5E, AutoCombatUIStatic.SurfaceWidthOffset);
	a.emit(0x8B, 0x45, 0x10);
	a.emit(0x0F, 0xAF, 0xC3);
	a.emit(0x03, 0x45, 0x0C);
	a.emit(0x8D, 0x3C, 0x87);
	a.emit(0x8B, 0x55, 0x18);
	a.label("row");
	a.emit(0x8B, 0x4D, 0x14);
	a.emit(0x8B, 0xC7);
	a.label("pixel");
	a.emit(0x8B, 0x75, 0x1C);
	a.emit(0x89, 0x30);
	a.emit(0x83, 0xC0, 0x04);
	a.emit(0x49);
	a.jcc(0x85, "pixel");
	a.emit(0x8D, 0x3C, 0x9F);
	a.emit(0x4A);
	a.jcc(0x85, "row");
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x5D);
	a.emit(0xC2, 0x18, 0x00);
	return a;
};

AutoCombatUIStatic.emitBody = function(a, stateVir, paths)
{
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x00);
	a.jcc(0x85, "body_monster");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.basic.vir, 0, AutoCombatUIStatic.TabsBottom, "body_basic"
	);
	a.jmp("body_done");
	a.label("body_monster");
	a.emit(0x83, 0xF8, 0x01);
	a.jcc(0x85, "body_skill");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.monster.vir, 0, AutoCombatUIStatic.TabsBottom, "body_monster_page"
	);
	a.jmp("body_done");
	a.label("body_skill");
	a.emit(0x83, 0xF8, 0x02);
	a.jcc(0x85, "body_potion");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage);
	a.emit(0x83, 0xF8, 0x01);
	a.jcc(0x85, "body_skill_2");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.skill1.vir, 0, AutoCombatUIStatic.TabsBottom, "body_skill_1_page"
	);
	a.jmp("body_done");
	a.label("body_skill_2");
	a.emit(0x83, 0xF8, 0x02);
	a.jcc(0x85, "body_skill_3");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.skill2.vir, 0, AutoCombatUIStatic.TabsBottom, "body_skill_2_page"
	);
	a.jmp("body_done");
	a.label("body_skill_3");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.skill3.vir, 0, AutoCombatUIStatic.TabsBottom, "body_skill_3_page"
	);
	a.jmp("body_done");
	a.label("body_potion");
	a.emit(0x83, 0xF8, 0x03);
	a.jcc(0x85, "body_looting");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StatePotionPage);
	a.emit(0x83, 0xF8, 0x01);
	a.jcc(0x85, "body_potion_2");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.potion1.vir, 0, AutoCombatUIStatic.TabsBottom, "body_potion_1_page"
	);
	a.jmp("body_done");
	a.label("body_potion_2");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.potion2.vir, 0, AutoCombatUIStatic.TabsBottom, "body_potion_2_page"
	);
	a.jmp("body_done");
	a.label("body_looting");
	a.emit(0x83, 0xF8, 0x04);
	a.jcc(0x85, "body_move");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage);
	a.emit(0x83, 0xF8, 0x01);
	a.jcc(0x85, "body_looting_2");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.looting1.vir, 0, AutoCombatUIStatic.TabsBottom, "body_looting_1_page"
	);
	a.jmp("body_done");
	a.label("body_looting_2");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.looting2.vir, 0, AutoCombatUIStatic.TabsBottom, "body_looting_2_page"
	);
	a.jmp("body_done");
	a.label("body_move");
	a.emit(0x83, 0xF8, 0x05);
	a.jcc(0x85, "body_item");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.move.vir, 0, AutoCombatUIStatic.TabsBottom, "body_move_page"
	);
	a.jmp("body_done");
	a.label("body_item");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.item.vir, 0, AutoCombatUIStatic.TabsBottom, "body_item_page"
	);
	a.label("body_done");
};

AutoCombatUIStatic.emitChrome = function(a, stateVir, fillRectVir, strings)
{
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 0, 0, 470, 17, 0xFF7E97BE);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 1, 1, 468, 15, 0xFFDDEBFA);
	for (let y = 3; y < 15; y += 2)
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, 2, y, 466, 1, 0xFFEEF5FD);
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 0, 16, 470, 1, 0xFF7892BA);
	for (const x of [6, 441, 456])
	{
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, 6, 7, 7, 0xFF708FC1);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, 6, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 5, 6, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, 11, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 5, 11, 2, 2, 0xFFDDEBFA);
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, x + 2, 8, 3, 3, 0xFFDDEBFA);
	}

	const widths = [67, 67, 67, 67, 67, 67, 68];
	let left = 0;
	for (let index = 0; index < 7; index++)
	{
		const normalLabel = `tab_${index}_normal`;
		const doneLabel = `tab_${index}_done`;
		a.emit(0x83, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateTab);
		a.emit(0x00 + index);
		a.jcc(0x85, normalLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, widths[index], 21, 0xFFD8E7FA
		);
		a.jmp(doneLabel);
		a.label(normalLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, widths[index], 21, 0xFFF2F6FC
		);
		a.label(doneLabel);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 17, 1, 21, 0xFF97ADCF
		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, left, 37, widths[index], 1, 0xFF97ADCF
		);
		AutoCombatUIStatic.emitText(
				a, strings.tabs[index].vir, left + 14, 20, 14, 0x00844E30
		);
		left += widths[index];
	}
	AutoCombatUIStatic.emitFillRect(a, fillRectVir, 469, 17, 1, 21, 0xFF97ADCF);
};

AutoCombatUIStatic.emitPageText = function(a, stateVir, strings)
{
	const emitPair = function(heading, subtitle, headingX, subtitleX)
	{
		AutoCombatUIStatic.emitText(a, heading.vir, headingX, 42, 15, 0x0078432C);
		AutoCombatUIStatic.emitText(a, subtitle.vir, subtitleX, 60, 14, 0x00B27E41);
	};
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x00); a.jcc(0x85, "text_monster");
	emitPair(strings.headings[0], strings.subtitles[0], 112, 53);
	a.jmp("page_text_done");
	a.label("text_monster");
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_skill");
	emitPair(strings.headings[1], strings.subtitles[1], 131, 126);
	a.jmp("page_text_done");
	a.label("text_skill");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "text_potion");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_skill_2");
	emitPair(strings.skillHeadings[0], strings.skillSubtitles[0], 158, 83);
	AutoCombatUIStatic.emitText(a, strings.attackSettings.vir, 177, 87, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.normalAttack.vir, 48, 276, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_skill_2");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "text_skill_3");
	emitPair(strings.skillHeadings[1], strings.skillSubtitles[1], 154, 79);
	AutoCombatUIStatic.emitText(a, strings.supportSettings.vir, 170, 87, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_skill_3");
	emitPair(strings.skillHeadings[2], strings.skillSubtitles[2], 158, 126);
	AutoCombatUIStatic.emitText(a, strings.healSettings.vir, 76, 87, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.statusSettings.vir, 304, 87, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_potion");
	a.emit(0x83, 0xF8, 0x03); a.jcc(0x85, "text_looting");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StatePotionPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_potion_2");
	emitPair(strings.potionHeadings[0], strings.potionSubtitles[0], 139, 78);
	a.jmp("page_text_done");
	a.label("text_potion_2");
	emitPair(strings.potionHeadings[1], strings.potionSubtitles[1], 130, 112);
	AutoCombatUIStatic.emitText(a, strings.statusPotion.vir, 164, 87, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_looting");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x85, "text_move");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "text_looting_2");
	emitPair(strings.lootingHeadings[0], strings.lootingSubtitles[0], 159, 112);
	AutoCombatUIStatic.emitText(a, strings.weight.vir, 198, 104, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_looting_2");
	emitPair(strings.lootingHeadings[1], strings.lootingSubtitles[1], 142, 118);
	a.jmp("page_text_done");
	a.label("text_move");
	a.emit(0x83, 0xF8, 0x05); a.jcc(0x85, "text_item");
	emitPair(strings.headings[5], strings.subtitles[5], 160, 128);
	AutoCombatUIStatic.emitText(a, strings.teleport.vir, 195, 88, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.returning.vir, 198, 183, 14, 0x0078432C);
	a.jmp("page_text_done");
	a.label("text_item");
	emitPair(strings.headings[6], strings.subtitles[6], 169, 79);
	AutoCombatUIStatic.emitText(a, strings.buffItems.vir, 185, 87, 14, 0x0078432C);
	a.label("page_text_done");
	AutoCombatUIStatic.emitText(a, strings.reset.vir, 15, 322, 14, 0x0078432C);
	AutoCombatUIStatic.emitText(a, strings.close.vir, 431, 322, 14, 0x0078432C);
};

AutoCombatUIStatic.emitPageControls = function(
	a, stateVir, paths, fillRectVir, strings, monsterRowsVir, attackSkillRowsVir,
	attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, skillIconPathVir,
	skillLevelTextVir
)
{
	const dark = 0x00554B46;
	const blue = 0x0078432C;
	const link = 0x00B27E41;
	const drawCheck = function(on, x, y, label, id)
	{
		AutoCombatUIStatic.emitDrawFull(
			a, (on ? paths.checkboxOn : paths.checkboxOff).vir, x, y,
			`control_check_${id}`
		);
		if (label)
			AutoCombatUIStatic.emitText(a, label.vir, x + 20, y - 2, 14, dark);
	};
	const drawStateCheck = function(test, x, y, label, id)
	{
		const offLabel = `control_check_${id}_off`;
		const doneLabel = `control_check_${id}_done`;
		if (test.kind === "flag")
		{
			a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
			a.emit(0xA9); a.dword(test.mask);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "nonzero")
		{
			a.emit(0x83, 0x3D); a.dword(stateVir + test.offset); a.emit(0);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "eq")
		{
			a.emit(0x83, 0x3D); a.dword(stateVir + test.offset); a.emit(test.value);
			a.jcc(0x85, offLabel);
		}
		else if (test.kind === "neq")
		{
			a.emit(0x83, 0x3D); a.dword(stateVir + test.offset); a.emit(test.value);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "bit")
		{
			a.emit(0xA1); a.dword(stateVir + test.offset);
			a.emit(0xA9); a.dword(test.mask);
			a.jcc(0x84, offLabel);
		}
		else if (test.kind === "mem_bit")
		{
			a.emit(0xA1); a.dword(test.address);
			a.emit(0xA9); a.dword(test.mask);
			a.jcc(0x84, offLabel);
		}
		AutoCombatUIStatic.emitDrawFull(
			a, paths.checkboxOn.vir, x, y, `control_check_${id}_on`
		);
		a.jmp(doneLabel);
		a.label(offLabel);
		AutoCombatUIStatic.emitDrawFull(
			a, paths.checkboxOff.vir, x, y, `control_check_${id}_off_draw`
		);
		a.label(doneLabel);
		if (label)
			AutoCombatUIStatic.emitText(a, label.vir, x + 20, y - 2, 14, dark);
	};
	const drawMonsterRow = function(mask, textVir, y, id)
	{
		const offLabel = `monster_row_${id}_off`;
		const doneLabel = `monster_row_${id}_done`;
		a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateMonsterBits);
		a.emit(0xA9); a.dword(mask);
		a.jcc(0x84, offLabel);
		AutoCombatUIStatic.emitDrawFull(
			a, paths.monsterRowOn.vir, 14, y, `monster_row_${id}_on_draw`
		);
		a.jmp(doneLabel);
		a.label(offLabel);
		AutoCombatUIStatic.emitDrawFull(
			a, paths.monsterRowOff.vir, 14, y, `monster_row_${id}_off_draw`
		);
		a.label(doneLabel);
		AutoCombatUIStatic.emitText(a, textVir, 90, y + 9, 14, dark);
		drawStateCheck(
			{kind: "bit", offset: AutoCombatUIStatic.StateMonsterBits, mask},
			420, y + 10, null, `monster_${id}`
		);
	};

	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x00); a.jcc(0x85, "controls_monster");
	drawStateCheck({kind: "eq", offset: AutoCombatUIStatic.StateStopMelee, value: 2}, 28, 143, strings.basicOptions[0], "basic_0");
	drawStateCheck({kind: "eq", offset: AutoCombatUIStatic.StateStopMelee, value: 1}, 28, 177, strings.basicOptions[1], "basic_1");
	drawStateCheck({kind: "nonzero", offset: AutoCombatUIStatic.StateTeleportNoMobDelay}, 28, 211, strings.basicOptions[2], "basic_2");
	drawStateCheck({kind: "nonzero", offset: AutoCombatUIStatic.StateMonsterSurround}, 28, 245, strings.basicOptions[3], "basic_3");
	drawStateCheck({kind: "flag", mask: 1 << 7}, 28, 279, strings.basicOptions[4], "basic_4");
	AutoCombatUIStatic.emitText(a, strings.basicNormal.vir, 48, 160, 13, link);
	a.jmp("controls_done");

	a.label("controls_monster");
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "controls_skill");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(0xA9); a.dword(AutoCombatUIStatic.FeatureMonsterRows);
	a.jcc(0x84, "controls_monster_static");
	drawMonsterRow(1, strings.monsters[0].vir, 87, "dynamic_all");
	for (let index = 0; index < AutoCombatUIStatic.MonsterDynamicRows; index++)
	{
		const visibleLabel = `monster_dynamic_${index}_visible`;
		const skipLabel = `monster_dynamic_${index}_skip`;
		a.emit(0x83, 0x3D);
		a.dword(stateVir + AutoCombatUIStatic.StateMonsterRowCount);
		a.emit(index + 1);
		a.jcc(0x83, visibleLabel);
		a.jmp(skipLabel);
		a.label(visibleLabel);
		drawMonsterRow(
			1 << (index + 1),
			monsterRowsVir + index * AutoCombatUIStatic.MonsterRowSize +
				AutoCombatUIStatic.MonsterRowNameOffset,
			87 + (index + 1) * 38,
			`dynamic_${index}`
		);
		a.label(skipLabel);
	}
	a.jmp("controls_done");
	a.label("controls_monster_static");
	for (let index = 0; index < strings.monsters.length; index++)
	{
		const mask = 1 << index;
		drawMonsterRow(mask, strings.monsters[index].vir, 87 + index * 38, `static_${index}`);
	}
	a.jmp("controls_done");

	a.label("controls_skill");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "controls_potion");
	const skillXs = [108, 185, 262, 339];
	const skillColors = [0xFFDF564C, 0xFFEF9F41, 0xFF648FDB, 0xFF9A6FD6];
	const emitSkillGrid = function(rowBaseVir, iconKeyBaseVir, featureMask, prefix, slotBase)
	{
		a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
		a.emit(0xA9); a.dword(featureMask);
		a.jcc(0x84, `${prefix}_unavailable`);
		for (let index = 0; index < AutoCombatUIStatic.AttackSkillDynamicRows; index++)
		{
			const x = skillXs[index % skillXs.length];
			const y = 132 + Math.floor(index / skillXs.length) * 74;
			const rowVir = rowBaseVir + index * AutoCombatUIStatic.AttackSkillRowSize;
			const iconKeyVir = iconKeyBaseVir + index * AutoCombatUIStatic.SkillIconKeySize;
			const emptyLabel = `${prefix}_${index}_empty`;
			const contentDoneLabel = `${prefix}_${index}_content_done`;
			a.emit(0x83, 0x3D); a.dword(rowVir + AutoCombatUIStatic.AttackSkillRowIdOffset); a.emit(0);
			a.jcc(0x84, emptyLabel);
			AutoCombatUIStatic.emitText(a,
				rowVir + AutoCombatUIStatic.AttackSkillRowNameOffset,
				x - 31, y - 20, 14, dark);
			AutoCombatUIStatic.emitDrawSkillIcon(
				a, fillRectVir, iconKeyVir, paths.skillIconFormat.vir, skillIconPathVir,
				x - 2, y - 2, skillColors[index % skillColors.length], `${prefix}_${index}_icon`
			);
			AutoCombatUIStatic.emitDrawSkillLevel(
				a, fillRectVir,
				rowVir + AutoCombatUIStatic.AttackSkillRowLevelOffset,
				strings.skillLevelFormat.vir, skillLevelTextVir, x - 2, y - 2
			);
			a.jmp(contentDoneLabel);
			a.label(emptyLabel);
			AutoCombatUIStatic.emitFillRect(a, fillRectVir, x, y, 20, 20, 0xFFE8F1FC);
			AutoCombatUIStatic.emitText(a, strings.skillEmpty.vir, x + 5, y + 2, 14, link);
			a.label(contentDoneLabel);

			AutoCombatUIStatic.emitFillRect(a, fillRectVir, x - 6, y + 31, 34, 16, 0xFF97ADCF);
			AutoCombatUIStatic.emitFillRect(a, fillRectVir, x - 5, y + 32, 32, 14, 0xFFFFFFFF);
			AutoCombatUIStatic.emitText(a,
				rowVir + AutoCombatUIStatic.AttackSkillRowDelayTextOffset,
				x - 2, y + 32, 12, dark);
			AutoCombatUIStatic.emitText(a, strings.secondsSuffix.vir, x + 31, y + 32, 12, dark);
		}
		a.jmp(`${prefix}_done`);
		a.label(`${prefix}_unavailable`);
		a.label(`${prefix}_done`);
	};
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateSkillPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "controls_skill_support");
	emitSkillGrid(
		attackSkillRowsVir, attackSkillIconKeysVir,
		AutoCombatUIStatic.FeatureAttackSkills, "attack_skill", 0
	);
	a.label("controls_skill_normal_attack");
	drawStateCheck({kind: "neq", offset: AutoCombatUIStatic.StateStopMelee, value: 1}, 28, 277, null, "normal_attack");
	a.jmp("controls_done");

	a.label("controls_skill_support");
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x85, "controls_done");
	emitSkillGrid(
		supportSkillRowsVir, supportSkillIconKeysVir,
		AutoCombatUIStatic.FeatureSupportSkills, "support_skill", 8
	);
	a.jmp("controls_done");

	a.label("controls_potion");
	a.emit(0x83, 0xF8, 0x03); a.jcc(0x85, "controls_looting");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StatePotionPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "controls_done");
	for (let index = 0; index < 4; index++)
	{
		const x = index % 2 === 0 ? 21 : 247;
		const y = index < 2 ? 89 : 200;
		AutoCombatUIStatic.emitDrawFull(a, paths.toggleOn.vir, x + 182, y, `potion_toggle_${index}`);
		AutoCombatUIStatic.emitText(a, strings.potionPanels[index].vir, x + 70, y, 14, blue);
		AutoCombatUIStatic.emitText(a, strings.useBelow.vir, x + 16, y + 39, 13, dark);
	}
	a.jmp("controls_done");

	a.label("controls_looting");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x85, "controls_move");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateLootingPage);
	a.emit(0x83, 0xF8, 0x01); a.jcc(0x85, "controls_done");
	drawStateCheck({kind: "bit", offset: AutoCombatUIStatic.StateLootCategoryBits, mask: 1 << 0}, 28, 226, strings.lootOptions[0], "loot_0");
	drawStateCheck({kind: "bit", offset: AutoCombatUIStatic.StateLootCategoryBits, mask: 1 << 1}, 136, 226, strings.lootOptions[1], "loot_1");
	drawStateCheck({kind: "bit", offset: AutoCombatUIStatic.StateLootCategoryBits, mask: 1 << 2}, 232, 226, strings.lootOptions[2], "loot_2");
	drawStateCheck({kind: "bit", offset: AutoCombatUIStatic.StateLootCategoryBits, mask: 1 << 3}, 354, 226, strings.lootOptions[3], "loot_3");
	AutoCombatUIStatic.emitText(a, strings.weightNote.vir, 37, 78, 13, dark);
	a.jmp("controls_done");

	a.label("controls_move");
	a.emit(0x83, 0xF8, 0x05); a.jcc(0x85, "controls_item");
	drawStateCheck({kind: "flag", mask: 1 << 6}, 129, 116, null, "move_0");
	drawStateCheck({kind: "flag", mask: 1 << 5}, 277, 116, null, "move_1");
	drawStateCheck({kind: "flag", mask: 1 << 1}, 129, 211, null, "move_2");
	drawStateCheck({kind: "nonzero", offset: AutoCombatUIStatic.StateActionOnEnd}, 277, 211, null, "move_3");
	AutoCombatUIStatic.emitText(a, strings.registerItem.vir, 116, 146, 13, dark);
	AutoCombatUIStatic.emitText(a, strings.registerSkill.vir, 265, 146, 13, dark);
	AutoCombatUIStatic.emitText(a, strings.registerItem.vir, 116, 241, 13, dark);
	AutoCombatUIStatic.emitText(a, strings.registerSkill.vir, 265, 241, 13, dark);
	a.jmp("controls_done");

	a.label("controls_item");
	const itemXs = [108, 185, 262];
	for (let index = 0; index < 3; index++)
	{
		AutoCombatUIStatic.emitFillRect(a, fillRectVir, itemXs[index], 122 + (index === 2 ? 74 : 0), 20, 20, skillColors[index]);
		AutoCombatUIStatic.emitText(a, strings.itemLetters[index].vir, itemXs[index] + 5, 124 + (index === 2 ? 74 : 0), 14, 0x00FFFFFF);
	}
	drawStateCheck({kind: "nonzero", offset: AutoCombatUIStatic.StateActionOnEnd}, 28, 275, strings.returnTown, "item_return");
	a.label("controls_done");
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x02); a.jcc(0x8C, "navigation_done");
	a.emit(0x83, 0xF8, 0x04); a.jcc(0x8F, "navigation_done");
	for (let row = 0; row < 7; row++)
	{
		const width = row + 1;
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 211 - row, 319 + row, width, 1, 0xFF486A9E
		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 259, 319 + row, width, 1, 0xFF486A9E
		);
	}
	for (let row = 0; row < 6; row++)
	{
		const width = 6 - row;
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 206 + row, 326 + row, width, 1, 0xFF486A9E
		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 259, 326 + row, width, 1, 0xFF486A9E
		);
	}
	for (let row = 0; row < 5; row++)
	{
		const width = row + 1;
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 209 - row, 321 + row, width, 1, 0xFF9FD8F2
		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 261, 321 + row, width, 1, 0xFF9FD8F2
		);
	}
	for (let row = 0; row < 4; row++)
	{
		const width = 4 - row;
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 206 + row, 326 + row, width, 1, 0xFF9FD8F2
		);
		AutoCombatUIStatic.emitFillRect(
			a, fillRectVir, 261, 326 + row, width, 1, 0xFF9FD8F2
		);
	}
	a.label("navigation_done");
};

AutoCombatUIStatic.buildDraw = function(stateVir, paths, fillRectVir, strings, monsterRowsVir, attackSkillRowsVir, attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, skillIconPathVir, skillLevelTextVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	AutoCombatUIStatic.pushImm(a, 0x00FFFFFF);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.WindowClearSurface);
	AutoCombatUIStatic.emitBody(a, stateVir, paths);
	AutoCombatUIStatic.emitChrome(a, stateVir, fillRectVir, strings);
	AutoCombatUIStatic.emitPageText(a, stateVir, strings);
	AutoCombatUIStatic.emitPageControls(
		a, stateVir, paths, fillRectVir, strings, monsterRowsVir, attackSkillRowsVir,
		attackSkillIconKeysVir, supportSkillRowsVir, supportSkillIconKeysVir, skillIconPathVir,
		skillLevelTextVir
	);

	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

AutoCombatUIStatic.emitMarkDirty = function(a)
{
	a.emit(0xC7, 0x46, AutoCombatUIStatic.WindowDirtyOffset);
	a.dword(1);
};

AutoCombatUIStatic.emitRectGate = function(a, left, top, right, bottom, failLabel)
{
	a.emit(0x81, 0xFB); a.dword(left);
	a.jcc(0x8C, failLabel);
	a.emit(0x81, 0xFB); a.dword(right);
	a.jcc(0x8D, failLabel);
	a.emit(0x81, 0xFA); a.dword(top);
	a.jcc(0x8C, failLabel);
	a.emit(0x81, 0xFA); a.dword(bottom);
	a.jcc(0x8D, failLabel);
};

AutoCombatUIStatic.emitSendScalarConst = function(a, mutationSenderVir, settingId, value)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, value);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.emitSendScalarPairConst = function(a, mutationSenderVir, settingId, value, value2)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	AutoCombatUIStatic.pushImm(a, value2);
	AutoCombatUIStatic.pushImm(a, value);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.emitSendScalarPairMem = function(a, mutationSenderVir, settingId, valueVir, value2)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	AutoCombatUIStatic.pushImm(a, value2);
	a.emit(0xFF, 0x35); a.dword(valueVir);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

AutoCombatUIStatic.emitSendScalarPairConstIfFeature = function(
	a, stateVir, mutationSenderVir, featureMask, settingId, value, value2, id
)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	const skipLabel = `send_scalar_pair_${id}_skip`;
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(0xA9); a.dword(featureMask);
	a.jcc(0x84, skipLabel);
	AutoCombatUIStatic.emitSendScalarPairConst(a, mutationSenderVir, settingId, value, value2);
	a.label(skipLabel);
};

AutoCombatUIStatic.emitSendScalarPairMemIfFeature = function(
	a, stateVir, mutationSenderVir, featureMask, settingId, valueVir, value2, id
)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	const skipLabel = `send_scalar_pair_mem_${id}_skip`;
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(0xA9); a.dword(featureMask);
	a.jcc(0x84, skipLabel);
	AutoCombatUIStatic.pushImm(a, value2);
	a.emit(0xFF, 0x35); a.dword(valueVir);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
	a.label(skipLabel);
};

AutoCombatUIStatic.emitSendScalarFlagToggle = function(a, stateVir, mutationSenderVir, settingId, mask)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	a.emit(0x33, 0xC9);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.emit(0xA9); a.dword(mask);
	a.emit(0x0F, 0x94, 0xC1);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x51);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
	a.emit(0x81, 0x35); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.dword(mask);
};

AutoCombatUIStatic.emitSendScalarEqToggle = function(
	a, stateVir, mutationSenderVir, offset, eqValue, settingId, eqSendValue, neSendValue, id
)
{
	if (!Number.isInteger(mutationSenderVir) || mutationSenderVir <= 0)
		return;
	const neLabel = `send_scalar_${id}_ne`;
	const callLabel = `send_scalar_${id}_call`;
	a.emit(0x83, 0x3D); a.dword(stateVir + offset); a.emit(eqValue);
	a.jcc(0x85, neLabel);
	a.emit(0xC7, 0x05); a.dword(stateVir + offset); a.dword(eqSendValue);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, eqSendValue);
	a.jmp(callLabel);
	a.label(neLabel);
	a.emit(0xC7, 0x05); a.dword(stateVir + offset); a.dword(neSendValue);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, neSendValue);
	a.label(callLabel);
	AutoCombatUIStatic.pushImm(a, settingId);
	a.call(mutationSenderVir);
};

