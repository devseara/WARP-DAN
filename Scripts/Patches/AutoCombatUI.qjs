AutoCombatUIStatic.bytesToHex = function(bytes)
{
	return bytes.map(value =>
		(value & 0xFF).toString(16).padStart(2, "0")
	).join(" ");
};

AutoCombatUIStatic.asm = function()
{
	const bytes = [];
	const labels = {};
	const fixups = [];
	const put32 = function(out, pos, value)
	{
		const v = value >>> 0;
		out[pos] = v & 0xFF;
		out[pos + 1] = (v >>> 8) & 0xFF;
		out[pos + 2] = (v >>> 16) & 0xFF;
		out[pos + 3] = (v >>> 24) & 0xFF;
	};
	return {
		bytes,
		emit: function(...values)
		{
			for (const value of values)
				bytes.push(value & 0xFF);
		},
		dword: function(value)
		{
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			put32(bytes, pos, value);
		},
		word: function(value)
		{
			bytes.push(value & 0xFF, (value >>> 8) & 0xFF);
		},
		label: function(name)
		{
			if (Object.prototype.hasOwnProperty.call(labels, name))
				throw Error(`AutoCombatUI: duplicate label ${name}`);
			labels[name] = bytes.length;
		},
		rel32: function(opcode, target)
		{
			bytes.push(opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		call: function(target) { this.rel32(0xE8, target); },
		jmp: function(target) { this.rel32(0xE9, target); },
		jcc: function(opcode, target)
		{
			bytes.push(0x0F, opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		finish: function(baseVir)
		{
			const out = bytes.slice();
			for (const fixup of fixups)
			{
				if (typeof fixup.target === "string" &&
					!Object.prototype.hasOwnProperty.call(labels, fixup.target))
					throw Error(`AutoCombatUI: unresolved label ${fixup.target}`);
				const targetVir = typeof fixup.target === "string"
					? baseVir + labels[fixup.target]
					: fixup.target;
				put32(out, fixup.pos, targetVir - (baseVir + fixup.pos + 4));
			}
			return AutoCombatUIStatic.bytesToHex(out);
		}
	};
};

AutoCombatUIStatic.allocateBytes = function(bytes, alignment = 1)
{
	const [phy, vir] = Exe.Allocate(bytes.length, alignment);
	Exe.SetHex(phy, AutoCombatUIStatic.bytesToHex(bytes));
	return {phy, vir, size: bytes.length};
};

AutoCombatUIStatic.allocateCode = function(assembler)
{
	const [phy, vir] = Exe.Allocate(assembler.bytes.length, 0x10);
	Exe.SetHex(phy, assembler.finish(vir));
	return {phy, vir, size: assembler.bytes.length};
};

AutoCombatUIStatic.asciiBytes = function(text, nulTerminate = true)
{
	const bytes = [];
	for (let i = 0; i < text.length; i++)
		bytes.push(text.charCodeAt(i) & 0xFF);
	if (nulTerminate)
		bytes.push(0);
	return bytes;
};

AutoCombatUIStatic.findBytes = function(bytes, needle)
{
	for (let i = 0; i <= bytes.length - needle.length; i++)
	{
		let match = true;
		for (let j = 0; j < needle.length; j++)
		{
			if (bytes[i + j] !== needle[j])
			{
				match = false;
				break;
			}
		}
		if (match)
			return i;
	}
	return -1;
};

AutoCombatUIStatic.readCString = function(virAddr, maxLength)
{
	const phy = Exe.Vir2Phy(virAddr);
	if (phy < 0)
		throw Error(`AutoCombatUI: string 0x${virAddr.toString(16)} is not mapped`);
	const bytes = [];
	for (let i = 0; i < maxLength; i++)
	{
		const value = Exe.GetUint8(phy + i);
		bytes.push(value);
		if (value === 0)
			return bytes;
	}
	throw Error(`AutoCombatUI: unterminated string at 0x${virAddr.toString(16)}`);
};

AutoCombatUIStatic.buildResourcePath = function(relativePath)
{
	const source = AutoCombatUIStatic.readCString(
		AutoCombatUIStatic.TabItmFormat, 192
	);
	const needle = AutoCombatUIStatic.asciiBytes("basic_interface\\", false);
	const pos = AutoCombatUIStatic.findBytes(source, needle);
	if (pos < 0)
		throw Error("AutoCombatUI: texture directory prefix not found");
	return AutoCombatUIStatic.allocateBytes(
		source.slice(0, pos).concat(AutoCombatUIStatic.asciiBytes(relativePath))
	);
};

AutoCombatUIStatic.allocateString = function(text)
{
	return AutoCombatUIStatic.allocateBytes(
		AutoCombatUIStatic.asciiBytes(text)
	);
};

AutoCombatUIStatic.pushImm = function(a, value)
{
	if (value >= -128 && value <= 127)
		a.emit(0x6A, value);
	else
	{
		a.emit(0x68);
		a.dword(value);
	}
};

AutoCombatUIStatic.packetTableEntryVir = function(packetId)
{
	return AutoCombatUIStatic.PacketSwitchTable + (packetId - 0x73) * 4;
};

AutoCombatUIStatic.resolvePacketRefs = function(_)
{
	const cacheKey = "AutoCombatUI.PacketRefs";
	if (CACHE.has(cacheKey))
		return CACHE.get(cacheKey);

	const packetTemplate =
		MOV(EAX, 0x0844) +
		PUSH(ESI) +
		MOV([EBP, 0x8], AX);
	const packetTemplateAddrs = Exe.FindHexN(packetTemplate);
	if (packetTemplateAddrs.isEmpty())
		throw Error("AutoCombatUI: packet sender template not found");

	const senderCandidates = packetTemplateAddrs.filter(addr =>
		Exe.FindLastHex(PUSH(0x13E), addr, addr - 0x80) > 0
	);
	if (senderCandidates.length !== 1)
		throw Error(
			"AutoCombatUI: expected one packet sender template, found " +
			senderCandidates.length
		);

	const packetSender = senderCandidates[0];
	const refs = {
		packetCtorA: Exe.GetTgtAddr(packetSender + 0x0A + 1),
		packetSend: Exe.GetTgtAddr(packetSender + 0x29 + 1)
	};
	CACHE.put(cacheKey, refs);
	return refs;
};

AutoCombatUIStatic.buildOpenSender = function(stateVir, refs)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, AutoCombatUIStatic.ClientHeaderSize);
	a.emit(0x56);
	a.emit(0x66, 0xC7, 0x45, 0xEC); a.word(AutoCombatUIStatic.ClientPacketId);
	a.emit(0x66, 0xC7, 0x45, 0xEE); a.word(AutoCombatUIStatic.ClientHeaderSize);
	a.emit(0xC7, 0x45, 0xF0); a.dword(AutoCombatUIStatic.PacketMagic);
	a.emit(0x66, 0xC7, 0x45, 0xF4); a.word(AutoCombatUIStatic.ProtocolVersion);
	a.emit(0x66, 0xC7, 0x45, 0xF6); a.word(AutoCombatUIStatic.MessageOpen);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x40);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRevision);
	a.emit(0x89, 0x45, 0xFC);
	a.call(refs.packetCtorA);
	a.emit(0x8B, 0xF0);
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "done");
	a.emit(0x8D, 0x45, 0xEC);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.ClientHeaderSize);
	a.emit(0x8B, 0xCE);
	a.call(refs.packetSend);
	a.label("done");
	a.emit(0x5E, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

AutoCombatUIStatic.buildScalarSender = function(stateVir, refs)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, AutoCombatUIStatic.ScalarHeaderSize);
	a.emit(0x56);
	a.emit(0x66, 0xC7, 0x45, 0xE0); a.word(AutoCombatUIStatic.ClientPacketId);
	a.emit(0x66, 0xC7, 0x45, 0xE2); a.word(AutoCombatUIStatic.ScalarHeaderSize);
	a.emit(0xC7, 0x45, 0xE4); a.dword(AutoCombatUIStatic.PacketMagic);
	a.emit(0x66, 0xC7, 0x45, 0xE8); a.word(AutoCombatUIStatic.ProtocolVersion);
	a.emit(0x66, 0xC7, 0x45, 0xEA); a.word(AutoCombatUIStatic.MessageSetScalar);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x40);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x89, 0x45, 0xEC);
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateRevision);
	a.emit(0x89, 0x45, 0xF0);
	a.emit(0x8B, 0x45, 0x08);
	a.emit(0x89, 0x45, 0xF4);
	a.emit(0x8B, 0x45, 0x0C);
	a.emit(0x89, 0x45, 0xF8);
	a.emit(0x8B, 0x45, 0x10);
	a.emit(0x89, 0x45, 0xFC);
	a.call(refs.packetCtorA);
	a.emit(0x8B, 0xF0);
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "done");
	a.emit(0x8D, 0x45, 0xE0);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.ScalarHeaderSize);
	a.emit(0x8B, 0xCE);
	a.call(refs.packetSend);
	a.label("done");
	a.emit(0x5E, 0x8B, 0xE5, 0x5D, 0xC2, 0x0C, 0x00);
	return a;
};

AutoCombatUIStatic.buildSnapshotReceiver = function(stateVir, monsterRowsVir, continueVir)
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x9C, 0x60);
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x3E); a.word(AutoCombatUIStatic.ServerPacketId);
	a.jcc(0x85, "fallback");
	a.emit(0x66, 0x83, 0x7E, 0x02); a.emit(AutoCombatUIStatic.SnapshotSize);
	a.jcc(0x82, "fallback");
	a.emit(0x81, 0x7E, 0x04); a.dword(AutoCombatUIStatic.PacketMagic);
	a.jcc(0x85, "fallback");
	a.emit(0x66, 0x83, 0x7E, 0x08); a.emit(AutoCombatUIStatic.ProtocolVersion);
	a.jcc(0x85, "fallback");
	a.emit(0x66, 0x83, 0x7E, 0x0A); a.emit(AutoCombatUIStatic.MessageSnapshot);
	a.jcc(0x85, "fallback");
	a.emit(0x8B, 0x46, 0x0C);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRequest);
	a.emit(0x8B, 0x46, 0x10);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateRevision);
	a.emit(0x8B, 0x46, 0x14);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateFlags);
	a.emit(0x0F, 0xB7, 0x46, 0x18);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateStopMelee);
	a.emit(0x0F, 0xB7, 0x46, 0x1A);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StatePickupMode);
	a.emit(0x0F, 0xB7, 0x46, 0x1C);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StatePrioMode);
	a.emit(0x0F, 0xB7, 0x46, 0x34);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateListCounts);
	a.emit(0x0F, 0xB7, 0x46, 0x32);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateActionOnEnd);
	a.emit(0x0F, 0xB7, 0x46, 0x30);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateMonsterSurround);
	a.emit(0x8B, 0x46, 0x2C);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateTeleportNoMobDelay);
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.dword(0);
	a.emit(0x66, 0x83, 0x7E, 0x02); a.emit(AutoCombatUIStatic.SnapshotMonsterBitsSize);
	a.jcc(0x82, "snapshot_no_monster_bits");
	a.emit(0x8B, 0x46); a.emit(AutoCombatUIStatic.SnapshotMonsterBitsOffset);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateMonsterBits);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureMonsterSelection);
	a.label("snapshot_no_monster_bits");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateMonsterRowCount);
	a.dword(0);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotMonsterRowsSize);
	a.jcc(0x82, "snapshot_no_monster_rows");
	a.emit(0x0F, 0xB7, 0x46, AutoCombatUIStatic.SnapshotMonsterRowCountOffset);
	a.emit(0x83, 0xF8, AutoCombatUIStatic.MonsterDynamicRows);
	a.jcc(0x86, "snapshot_monster_row_count_ok");
	a.emit(0xB8); a.dword(AutoCombatUIStatic.MonsterDynamicRows);
	a.label("snapshot_monster_row_count_ok");
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateMonsterRowCount);
	a.emit(0x8D, 0x76, AutoCombatUIStatic.SnapshotMonsterRowsOffset);
	a.emit(0xBF); a.dword(monsterRowsVir);
	a.emit(0xB9); a.dword(AutoCombatUIStatic.MonsterRowsSize / 4);
	a.emit(0xF3, 0xA5);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureMonsterRows);
	a.label("snapshot_no_monster_rows");
	a.emit(0xBE); a.dword(AutoCombatUIStatic.PacketBuffer);
	a.emit(0x66, 0x81, 0x7E, 0x02); a.word(AutoCombatUIStatic.SnapshotLootCategoriesSize);
	a.jcc(0x82, "snapshot_no_loot_categories");
	a.emit(0x8B, 0x86); a.dword(AutoCombatUIStatic.SnapshotLootCategoriesOffset);
	a.emit(0x83, 0xE0, 0x0F);
	a.emit(0xA3); a.dword(stateVir + AutoCombatUIStatic.StateLootCategoryBits);
	a.emit(0x83, 0x0D); a.dword(stateVir + AutoCombatUIStatic.StateServerFeatures);
	a.emit(AutoCombatUIStatic.FeatureLootCategories);
	a.label("snapshot_no_loot_categories");
	a.emit(0xC7, 0x05); a.dword(stateVir + AutoCombatUIStatic.StateReady);
	a.dword(1);
	a.emit(0x8B, 0x3D); a.dword(stateVir + AutoCombatUIStatic.StateWindow);
	a.emit(0x85, 0xFF);
	a.jcc(0x84, "handled");
	a.emit(0xC7, 0x47, AutoCombatUIStatic.WindowDirtyOffset);
	a.dword(1);
	a.label("handled");
	a.emit(0x61, 0x9D);
	a.emit(0xB8); a.dword(AutoCombatUIStatic.PacketMainLoopReturn);
	a.emit(0xFF, 0xE0);
	a.label("fallback");
	a.emit(0x61, 0x9D);
	a.emit(0xB8); a.dword(continueVir);
	a.emit(0xFF, 0xE0);
	return a;
};

AutoCombatUIStatic.installSnapshotReceiver = function(_, stateVir, monsterRowsVir)
{
	const entryVir = AutoCombatUIStatic.packetTableEntryVir(
		AutoCombatUIStatic.ServerPacketId
	);
	const entryPhy = Exe.Vir2Phy(entryVir, CODE);
	if (entryPhy < 0)
		throw Error("AutoCombatUI: could not resolve AHUI dispatcher entry");

	const stateKey = "AutoCombatUI.SnapshotReceiver.v5";
	const oldState = CACHE.get(stateKey);
	const current = Exe.GetUint32(entryPhy);
	if (oldState && oldState.entryVir === entryVir &&
		current === oldState.handlerVir)
		return oldState.handlerVir;

	const continueVir = current === AutoCombatUIStatic.PacketDefaultHandler
		? AutoCombatUIStatic.PacketMainLoopReturn
		: current;

	const receiver = AutoCombatUIStatic.allocateCode(
		AutoCombatUIStatic.buildSnapshotReceiver(stateVir, monsterRowsVir, continueVir)
	);
	Exe.SetUint32(entryPhy, receiver.vir);
	CACHE.put(stateKey, {
		packetId: AutoCombatUIStatic.ServerPacketId,
		entryVir,
		handlerVir: receiver.vir,
		continueVir,
		stateVir,
		monsterRowsVir
	});
	return receiver.vir;
};

AutoCombatUIStatic.emitLoadSurface = function(a, pathVir, missingLabel)
{
	a.call(AutoCombatUIStatic.GetTexMgr);
	a.emit(0x8B, 0xD8, 0x85, 0xDB);
	a.jcc(0x84, missingLabel);
	AutoCombatUIStatic.pushImm(a, pathVir);
	a.call(AutoCombatUIStatic.ConvPath);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, missingLabel);
	a.emit(0x50, 0x8B, 0xCB);
	a.call(AutoCombatUIStatic.LoadSurface);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, missingLabel);
};

AutoCombatUIStatic.emitDrawFull = function(a, pathVir, x, y, label)
{
	const done = `${label}_done`;
	AutoCombatUIStatic.emitLoadSurface(a, pathVir, done);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.ImageDraw);
	a.label(done);
};

AutoCombatUIStatic.emitFillRect = function(a, fillRectVir, x, y, width, height, color)
{
	AutoCombatUIStatic.pushImm(a, color);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, width);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x56);
	a.call(fillRectVir);
};

AutoCombatUIStatic.emitText = function(a, textVir, x, y, height, color)
{
	if (!Number.isInteger(textVir) || textVir <= 0)
		throw Error("AutoCombatUI: invalid native text pointer");
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, color);
	AutoCombatUIStatic.pushImm(a, height);
	AutoCombatUIStatic.pushImm(a, 1);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, textVir);
	AutoCombatUIStatic.pushImm(a, y);
	AutoCombatUIStatic.pushImm(a, x);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.TextDraw);
};

AutoCombatUIStatic.buildFillRect = function()
{
	const a = AutoCombatUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
	a.emit(0x8B, 0x75, 0x08);
	a.emit(0x8B, 0x76, AutoCombatUIStatic.WindowSurfaceOffset);
	a.emit(0x85, 0xF6);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x7E, AutoCombatUIStatic.SurfacePixelsOffset);
	a.emit(0x85, 0xFF);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0x5E, AutoCombatUIStatic.SurfaceWidthOffset);
	a.emit(0x8B, 0x45, 0x10);
	a.emit(0x0F, 0xAF, 0xC3);
	a.emit(0x03, 0x45, 0x0C);
	a.emit(0x8D, 0x3C, 0x87);
	a.emit(0x8B, 0x55, 0x18);
	a.label("row");
	a.emit(0x8B, 0x4D, 0x14);
	a.emit(0x8B, 0xC7);
	a.label("pixel");
	a.emit(0x8B, 0x75, 0x1C);
	a.emit(0x89, 0x30);
	a.emit(0x83, 0xC0, 0x04);
	a.emit(0x49);
	a.jcc(0x85, "pixel");
	a.emit(0x8D, 0x3C, 0x9F);
	a.emit(0x4A);
	a.jcc(0x85, "row");
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x5D);
	a.emit(0xC2, 0x18, 0x00);
	return a;
};

AutoCombatUIStatic.emitBody = function(a, stateVir, paths)
{
	a.emit(0xA1); a.dword(stateVir + AutoCombatUIStatic.StateTab);
	a.emit(0x83, 0xF8, 0x00);
	a.jcc(0x85, "body_monster");
	AutoCombatUIStatic.emitDrawFull(
		a, paths.basic.vir, 0, AutoCombatUIStatic.TabsBottom, "body_basic"
	);
	a.jmp("body_done");
	a.label("body_monster");
