	a.emit(0x69, 0xC0); a.dword(AutoCombatUIStatic.LootSliderThumbTravel);
	a.emit(0x33, 0xD2, 0xB9); a.dword(AutoCombatUIStatic.LootSliderMaximum);
	a.emit(0xF7, 0xF1, 0x83, 0xC0, 0x07);
	AutoCombatUIStatic.pushImm(a, 9);
	a.emit(0x50);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	AutoCombatUIStatic.pushImm(a, 0);
	a.emit(0x53);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.LootSliderTrackY);
	AutoCombatUIStatic.pushImm(a, AutoCombatUIStatic.LootSliderTrackX);
	a.emit(0x8B, 0xCE);
	a.call(AutoCombatUIStatic.ImageDrawRect);
