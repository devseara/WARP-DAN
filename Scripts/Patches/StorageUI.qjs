/*
 * Description: Independent storage artwork, search and categories for the
 * 2025-07-16 client. Clones only UIStorageWnd and its own native editor;
 * retains the native storage factory, packets, CItem and amount dialogs.
 * Read-only filtered views keep exact slot identity, including duplicate IDs.
 * No shared item renderer, server, inventory or gameplay hooks are changed.
 */
StorageUI = function(_)
{
	if(!StorageUI.validate())throw Error("StorageUI requires 2025-07-16 Ragexe");
	const n=AutoCombatUI.nativeHelpers;
	const read=path=>{const f=new BinFile(path,"r");if(!f.Valid)throw Error("StorageUI: missing "+path);const h=f.ReadHex();f.Close();return(h.match(/[0-9a-fA-F]{2}/g)||[]).map(v=>parseInt(v,16));};
	const u32=(b,o)=>(b[o]|b[o+1]<<8|b[o+2]<<16|b[o+3]<<24)>>>0;
	const put=(b,o,v)=>{for(let i=0;i<4;++i)b[o+i]=v>>>(i*8)&255;};
	const bytes=read(Warp.Path+"/Inputs/StorageUI/runtime.bin"),meta=JSON.parse(String.fromCharCode(...read(Warp.Path+"/Inputs/StorageUI/runtime.json")));
	const size=u32(bytes,8),count=u32(bytes,12),api=u32(bytes,16),start=32+count*4;
	let crc=0xFFFFFFFF;for(let i=32;i<bytes.length;++i){crc^=bytes[i];for(let j=0;j<8;++j)crc=(crc>>>1)^((crc&1)?0xEDB88320:0);}
	if(bytes.length<32 || u32(bytes,0)!==0x49555353 || u32(bytes,4)!==1 || meta.version!==1 || meta.client!==20250716 ||
		start+size!==bytes.length || size!==meta.size || api!==meta.exports.StorageApi || meta.api_size!==152 || api+152>size || u32(bytes,20)!==152 || u32(bytes,24)!==20250716 || ((crc^0xFFFFFFFF)>>>0)!==u32(bytes,28))throw Error("StorageUI: invalid payload");
	const names=["StorageApi","StorageState","@StorageConstruct@8","@StorageCreate@16","@StorageProcess@8","@StorageDraw@8","@StorageDown@16","@StorageUp@16","@StorageMove@16","@StorageDrag@16","@StorageRight@16","@StorageDestroy@12","@StorageEvent@32","@StorageEditEvent@32","@StorageWheel@12","@StorageSelect@20","_StorageBuildView@0","_StorageCategory@12","_StorageContains@8","_StorageHit@8","_StorageItemHit@8","@StorageEditDraw@8","@StorageCursorDraw@8","@StorageDrop@20","@StorageTooltipAnchor@16"];
	for(const name of names)if(!Number.isInteger(meta.exports[name]) || meta.exports[name]<0 || meta.exports[name]>=size)throw Error("StorageUI: missing "+name);
	n.assertCode("StorageUI factory constructor",0xA3A694,"E8 47 A4 EF FF");
	n.assertCode("StorageUI native create",0x93DC60,"55 8B EC 6A FF 68 83 31 EC 00");
	n.assertCode("StorageUI session storage count",0xD5CF90,"8B 81 1C 17 00 00 C3");
	n.assertCode("StorageUI session storage list",0xD5E500,"8B 91 18 17 00 00 33 C9 8B 02");
	n.assertCode("StorageUI CItem copy",0x5B72D0,"55 8B EC 6A FF 68 7B 7C E2 00");
	n.assertCode("StorageUI CItem empty",0x6A1A90,"55 8B EC 6A FF 68 4B 54 E5 00");
	const selectors=[[0x94AEDA,"E8 11 EE FE FF"],[0x94D28F,"E8 5C CA FE FF"],[0x94F239,"E8 B2 AA FE FF"]];
	for(const [site,expected] of selectors)n.assertCode("StorageUI scoped item selector",site,expected);
	n.assertCode("StorageUI tooltip origin",0x94D2E1,"E8 8A 1C 0D 00");
	const original=0x103CA40,slots=53,changes=[[10,"@StorageDrop@20",0x938490],[0,"@StorageDestroy@12",0x936640],[15,"@StorageCreate@16",0x93DC60],[19,"@StorageProcess@8",0x5A8A20],[20,"@StorageDraw@8",0x946730],[25,"@StorageDown@16",0x94AE80],[27,"@StorageDrag@16",0x880E00],[28,"@StorageMove@16",0x94D250],[31,"@StorageUp@16",0x880BB0],[32,"@StorageRight@16",0x94F200],[35,"@StorageWheel@12",0x9500C0],[37,"@StorageEvent@32",0x9544F0]];
	for(const [slot,name,expected] of changes)if(Exe.GetUint32(Exe.Vir2Phy(original+slot*4))!==expected)throw Error("StorageUI: native vtable changed: "+name);
	if(Exe.GetUint32(Exe.Vir2Phy(0xFD9190+37*4))!==0x82C4E0)throw Error("StorageUI: native search editor changed");
	const code=bytes.slice(start),[phy,vir]=Exe.Allocate(size,16);
	for(let i=0;i<count;++i){const off=u32(bytes,32+i*4);if(off+4>size || u32(code,off)>=size)throw Error("StorageUI: invalid relocation");put(code,off,u32(code,off)+vir);}
	const e=name=>vir+meta.exports[name];
	const table=n.allocateBytes(new Array(4+slots*4).fill(0),4);Exe.SetHex(table.phy,Exe.GetHex(Exe.Vir2Phy(original-4),table.size));
	for(const [slot,name] of changes)Exe.SetUint32(table.phy+4+slot*4,e(name));
	const edit=n.allocateBytes(new Array(4+58*4).fill(0),4);Exe.SetHex(edit.phy,Exe.GetHex(Exe.Vir2Phy(0xFD9190-4),edit.size));
	Exe.SetUint32(edit.phy+4+37*4,e("@StorageEditEvent@32"));
	Exe.SetUint32(edit.phy+4+20*4,e("@StorageEditDraw@8"));
	const fit=n.allocateCode(VipUI.nativeDrawing.fit(11,false,false)),name=n.allocateCode(BestiaryUI.nativeDrawing.itemName());
	const blend=n.allocateCode(ModernChatUI.nativeHelpers.buildBlendPixel()),rawPng=n.allocateCode(ModernChatUI.nativeHelpers.buildPngDraw(blend.vir));
	const draw=n.asm();draw.emit(0x55,0x8B,0xEC,0x53,0x56,0x8B,0x71,0x24,0x85,0xF6);draw.jcc(0x84,"done");
	draw.emit(0x0F,0xB6,0x5E,0x28);for(const off of [20,16,12,8])draw.emit(0xFF,0x75,off);
	draw.call(rawPng.vir);draw.emit(0x88,0x5E,0x28);draw.label("done");draw.emit(0x5E,0x5B,0x5D,0xC2,16,0);
	const png=n.allocateCode(draw),paths=StorageUI.runtimeAssets().map(p=>p.replace(/\//g,'\\'));
	[1,table.vir+4,edit.vir+4,fit.vir,png.vir,name.vir,...paths.map(p=>n.buildResourcePath(p).vir),StorageUI.cursorTarget()].forEach((v,i)=>put(code,api+i*4,v));
	for(let i=0;i<code.length;i+=4096)Exe.SetHex(phy+i,n.bytesToHex(code.slice(i,i+4096)));
	Exe.SetCALL(Exe.Vir2Phy(0xA3A694),e("@StorageConstruct@8"));
	for(const [site] of selectors)Exe.SetCALL(Exe.Vir2Phy(site),e("@StorageSelect@20"));
	Exe.SetCALL(Exe.Vir2Phy(0x94D2E1),e("@StorageTooltipAnchor@16"));
	const record=[];for(const v of [n.allocateString("StorageUI.v1").vir,...names.map(e)])record.push(v&255,v>>>8&255,v>>>16&255,v>>>24);n.allocateBytes(record,4);
	StorageUI.installCursor(e("@StorageCursorDraw@8"));
	StorageUI.onApplied();return true;
};
StorageUI.validate=()=>Exe.BuildDate===20250716;
StorageUI.assets=()=>['storageui/bg.png',...['search','usable','weapon','armor','misc','cards','ammo','costume','shadow','pet','sticker','cash'].map(s=>'storageui/menu_'+s+'.png'),
	'storageui/search.png','storageui/toggle_block.png','storageui/toggle_list.png',...['null','down','up'].map(s=>'storageui/refine_order_'+s+'.png'),
	...['out','over','press'].map(s=>'genericsui/clos_'+s+'.png'),'genericsui/cls_x_out.png','genericsui/cls_x_over.png','storageui/storagelock.png','storageui/bg_.png','battlepassui/Cursor_Hover.bmp','inventoryui/selected_bg.png'];
StorageUI.runtimeAssets=()=>[...StorageUI.assets().slice(0,27),'btn_resize.bmp','inventory/icon_num.bmp','inventory/item_drop_lock_off.bmp','inventoryui/selected_bg.png'];
StorageUI.onApplied=function()
{
	if(Warp.TestMode)return;
	const root=System.DirPath(Warp.TgtExe),folders=['data','texture',ModernChatUI.nativeHelpers.uiPrefix()],target=root+'/'+folders.join('/'),missing=[];
	for(const file of StorageUI.assets()){
		const existing=new BinFile(target+'/'+file,'r'),exists=existing.Valid;existing.Close();if(exists)continue;
		const source=new BinFile(Warp.Path+'/Assets/StorageInventoryUI/'+file,'r'),valid=source.Valid;source.Close();if(!valid)throw Error('StorageUI: missing bundled asset '+file);missing.push(file);
	}
	if(!missing.length)return;
	let path=root;for(const folder of folders){path+='/'+folder;if(!System.MkDir(path))throw Error('StorageUI: cannot create '+path);}
	for(const folder of ['storageui','genericsui','battlepassui','inventoryui'])if(!System.MkDir(target+'/'+folder))throw Error('StorageUI: cannot create '+target+'/'+folder);
	for(const file of missing)if(!System.Copy(Warp.Path+'/Assets/StorageInventoryUI/'+file,target+'/'+file,false))throw Error('StorageUI: cannot copy '+file);
};

// Global cursor registrations are completely re-emitted after BeginTag replacement.
StorageUI.cursorRoute=function()
{
	const n=AutoCombatUI.nativeHelpers,key="StorageInventoryCart.Cursor.Global.v3",cacheKey="StorageInventoryCart.Cursor.v3";
	for(const address of [0xC75165,0xD26DA0,0xD27471]){
		const rel=(0xA74410-address-5)>>>0;
		n.assertCode("Inventory/Cart/Storage original cursor call",address,n.bytesToHex([0xE8,rel&255,rel>>>8&255,rel>>>16&255,rel>>>24]));
	}
	let route=CACHE.get(cacheKey);
	if(!route)CACHE.setup(key,"StorageInventoryCartCursorV3",{cleanTag_after_userDel:false,dealloc_after_zeroUsers:false});
	const previous=Exe.ActivePatch;
	Exe.ActivateGlobal();Exe.BeginTag(CACHE.getTag(key));
	try {
		if(!route){
			const cells=n.allocateBytes(new Array(12).fill(0),4);
			route={inventoryCellPhy:cells.phy,inventoryCellVir:cells.vir,cartCellPhy:cells.phy+4,cartCellVir:cells.vir+4,storageCellPhy:cells.phy+8,storageCellVir:cells.vir+8,inventoryVir:0,cartVir:0,storageVir:0,code:[]};
			const dispatch=(cell,fallback)=>{
				const a=n.asm();a.emit(0x9C,0x83,0x3D);a.dword(cell);a.emit(0);a.jcc(0x85,"selected");
				a.emit(0x9D);a.jmp(fallback);a.label("selected");a.emit(0x9D,0xFF,0x25);a.dword(cell);
				const stub=n.allocateCode(a);route.code.push({phy:stub.phy,hex:a.finish(stub.vir)});return stub.vir;
			};
			route.storageDispatchVir=dispatch(route.storageCellVir,0xA74410);
			route.cartDispatchVir=dispatch(route.cartCellVir,route.storageDispatchVir);
			route.routerVir=dispatch(route.inventoryCellVir,route.cartDispatchVir);
			CACHE.put(cacheKey,route);
		}
		StorageUI.writeCursorRoute(route);
	} finally {Exe.EndTag();Exe.ActivePatch=previous;}
	CACHE.addUser(key,"StorageUI");return route;
};
// Emit every byte owned by the open global tag, including all three registrations.
StorageUI.writeCursorRoute=function(route)
{
	for(const stub of route.code)Exe.SetHex(stub.phy,stub.hex);
	Exe.SetUint32(route.inventoryCellPhy,route.inventoryVir);
	Exe.SetUint32(route.cartCellPhy,route.cartVir);
	Exe.SetUint32(route.storageCellPhy,route.storageVir);
	for(const address of [0xC75165,0xD26DA0,0xD27471])Exe.SetCALL(Exe.Vir2Phy(address),route.routerVir);
};
StorageUI.cursorTarget=function()
{
	const route=StorageUI.cursorRoute();return 0xA74410;
};
StorageUI.installCursor=function(entry)
{
	const route=CACHE.get("StorageInventoryCart.Cursor.v3"),previous=Exe.ActivePatch;
	if(!route || !Number.isInteger(entry) || entry<=0)throw Error("StorageUI: invalid cursor registration");
	Exe.ActivateGlobal();Exe.BeginTag(CACHE.getTag("StorageInventoryCart.Cursor.Global.v3"));
	try {route.storageVir=entry;StorageUI.writeCursorRoute(route);}
	finally {Exe.EndTag();Exe.ActivePatch=previous;}
};
StorageUI.cleanup=function()
{
	const key="StorageInventoryCart.Cursor.Global.v3",cacheKey="StorageInventoryCart.Cursor.v3",route=CACHE.get(cacheKey);
	if(!route)return;
	const previous=Exe.ActivePatch;
	Exe.ActivateGlobal();Exe.BeginTag(CACHE.getTag(key));
	try {route.storageVir=0;StorageUI.writeCursorRoute(route);}
	finally {Exe.EndTag();Exe.ActivePatch=previous;}
	CACHE.delUser(key,"StorageUI");
	if(!CACHE.hasUsers(key))CACHE.del(cacheKey);
};
