/**************************************************************************\
* Canonical 128-byte clan names for Main 2025-07-16.                         *
* Description: Validate the 282-byte header and 128-byte alliance strings;  *
* feed full pointers into the existing native strings and linked list.      *
\**************************************************************************/
ClanNamesStatic = {};
ClanNamesStatic.buildDispatch = function(buffer,returnVir)
{
	const a=ExtNameStaticAsm.asm();
	a.emit(0x0F,0xB7,0x15);a.dword(buffer+2);
	a.emit(0x81,0xFA);a.dword(282);a.jcc(0x82,"done");
	a.emit(0x0F,0xB6,0x05);a.dword(buffer+280);
	a.emit(0x0F,0xB6,0x0D);a.dword(buffer+281);
	a.emit(0x03,0xC1,0xC1,0xE0,0x07,0x05);a.dword(282);
	a.emit(0x3B,0xC2);a.jcc(0x85,"done");
	a.emit(0x68);a.dword(buffer);a.emit(0x8B,0xCF);a.call(0x00CF7950);
	a.label("done");a.jmp(returnVir);return a;
};
ClanNamesStatic.buildAssign = function()
{
	const a=ExtNameStaticAsm.asm();
	// Tail call keeps the native caller's SEH frame and std::string receiver.
	a.emit(0x8B,0x85);a.dword(0xFFFFFF60);
	a.emit(0x89,0x44,0x24,0x04);a.jmp(0x004F1940);return a;
};
ClanNamesStatic.install=function(state,routes)
{
	if(ExtNameTextStatic.ActiveBuildDate!==20250716||state.clanNames128)return state;
	const edits=[
		// Remove unused legacy short-name copies (strcpy_s would reject >23 bytes).
		[0x00CF79BD,"FF 15 5C 1B FC 00","90 90 90 90 90 90"],
		[0x00CF7A43,"FF D6","90 90"],
		[0x00CF7AEA,"E8 01 53 8A FF","90 90 90 90 90"],
		[0x00CF7D5A,"E8 91 50 8A FF","90 90 90 90 90"],
		[0x00CF79C9,"8D 55 C8","8D 56 08"],
		[0x00CF79DE,"8D 45 C8","8D 46 FF"],
		[0x00CF7A4B,"8D 55 B0","8D 57 20"],
		[0x00CF7A6D,"8D 45 B0","8D 47 20"]
	];
	const leaves=[
		[0x00CF7A21,"8B BD 44 FF FF FF 0F 57 C0",[0x8B,0xBD,0x44,0xFF,0xFF,0xFF,0x83,0xC7,0x68,0x0F,0x57,0xC0],0x00CF7A2A],
		// Map and following lists are after two expanded name fields.
		[0x00CF7A77,"8D 47 38 0F 57 C0",[0x83,0xC7,0x68,0x89,0xBD,0x44,0xFF,0xFF,0xFF,0x8D,0x47,0x38,0x0F,0x57,0xC0],0x00CF7A7D],
		[0x00CF7B32,"8D 4D 98 C7 85 64 FF FF FF 00 00 00 00",[0x8B,0x8D,0x60,0xFF,0xFF,0xFF,0xC7,0x85,0x64,0xFF,0xFF,0xFF,0,0,0,0],0x00CF7B3F],
		[0x00CF7DA2,"8D 45 80 C7 85 64 FF FF FF 01 00 00 00",[0x8B,0x85,0x60,0xFF,0xFF,0xFF,0xC7,0x85,0x64,0xFF,0xFF,0xFF,1,0,0,0],0x00CF7DAF],
		[0x00CF7CA4,"83 C1 18 89 8D 60 FF FF FF",[0x81,0xC1,0x80,0,0,0,0x89,0x8D,0x60,0xFF,0xFF,0xFF],0x00CF7CAD],
		[0x00CF7F66,"83 C1 18 89 8D 60 FF FF FF",[0x81,0xC1,0x80,0,0,0,0x89,0x8D,0x60,0xFF,0xFF,0xFF],0x00CF7F6F]
	];
	for(const edit of edits)edit.push(ExtNameStaticAsm.assertCode("clan full name",edit[0],edit[1]));
	for(const leaf of leaves){
		leaf.push(ExtNameStaticAsm.assertCode("clan field/stride",leaf[0],leaf[1]));
		leaf.push(ExtNameTextStatic.allocateCode(GuildNamesStatic.leaf(leaf[2],leaf[3])));
	}
	const assignSites=[
		ExtNameStaticAsm.assertCode("clan alliance name",0x00CF7B56,"E8 E5 9D 7F FF"),
		ExtNameStaticAsm.assertCode("clan opposition name",0x00CF7DC6,"E8 75 9B 7F FF")
	];
	const entry=Exe.Vir2Phy(CustomPacketDispatch.tableEntryVir(routes.switchTableVir,0x098A),CODE);
	if(entry<0||Exe.GetUint32(entry)!==0x00CA8B12)throw Error("ClanNamesStatic: clan dispatch changed");
	const assign=ExtNameTextStatic.allocateCode(ClanNamesStatic.buildAssign());
	const dispatch=ExtNameTextStatic.allocateCode(ClanNamesStatic.buildDispatch(routes.packetBufferVir,routes.mainLoopReturnVir));
	const owner=Exe.ActivePatch;Exe.ActivateGlobal();Exe.BeginTag(CACHE.getTag("ClanNamesStatic.NamePackets128"),true);
	try {
		for(const edit of edits)Exe.SetHex(edit[3],edit[2]);
		for(const leaf of leaves){Exe.SetJMP(leaf[4],leaf[5].virAddr,0);Exe.SetNOPs(leaf[4]+5,leaf[1].split(" ").length-5);}
		for(const site of assignSites)Exe.SetCALL(site,assign.virAddr,0);
		Exe.SetUint32(entry,dispatch.virAddr);
	} finally {Exe.EndTag();Exe.ActivePatch=owner;}
	state.clanNames128=true;return state;
};
