*   Description   : Target: Main 2025-07-16 Ragexe. Grow its embedded      *
*                   CHARACTER_INFO and owner by104 bytes, keep native      *
*                   stats/edit controls coherent, and use a128-byte stack  *
*                   name. Prefix validation stays native; exact            *
*                   branch-aware caves avoid overlap. Native hooks, data   *
*                   and code revert together with the selecting patch.     *
*                                                                          *
\**************************************************************************/

CharacterCreateNamesStatic = {};
CharacterCreateNamesStatic.Edits = [[7993747,"C7 87 C4 02 00 00 00 00 00 00","C7 87 2C 03 00 00 00 00 00 00"],[7993757,"C7 87 C0 02 00 00 00 00 00 00","C7 87 28 03 00 00 00 00 00 00"],[7993767,"C7 87 C8 02 00 00 00 00 00 00","C7 87 30 03 00 00 00 00 00 00"],[7993777,"C7 87 CC 02 00 00 00 00 00 00","C7 87 34 03 00 00 00 00 00 00"],[7993824,"88 87 94 02 00 00","88 87 FC 02 00 00"],[7993833,"88 87 95 02 00 00","88 87 FD 02 00 00"],[7993842,"88 87 96 02 00 00","88 87 FE 02 00 00"],[7993851,"88 87 97 02 00 00","88 87 FF 02 00 00"],[7993860,"88 87 98 02 00 00","88 87 00 03 00 00"],[7993869,"88 87 99 02 00 00","88 87 01 03 00 00"],[7994016,"88 87 9A 02 00 00","88 87 02 03 00 00"],[7994057,"88 87 BE 02 00 00","88 87 26 03 00 00"],[7994170,"0F B6 87 BE 02 00 00","0F B6 87 26 03 00 00"],[7994270,"80 BF BE 02 00 00 01","80 BF 26 03 00 00 01"],[7994324,"0F B6 87 BE 02 00 00","0F B6 87 26 03 00 00"],[7994402,"0F B6 87 BE 02 00 00","0F B6 87 26 03 00 00"],[7994505,"0F B6 87 BE 02 00 00","0F B6 87 26 03 00 00"],[7994600,"0F B6 87 BE 02 00 00","0F B6 87 26 03 00 00"],[7994696,"0F B6 87 BE 02 00 00","0F B6 87 26 03 00 00"],[7994860,"C7 87 5C 03 00 00 00 00 00 00","C7 87 C4 03 00 00 00 00 00 00"],[7994876,"89 87 60 03 00 00","89 87 C8 03 00 00"],[7994885,"C7 87 64 03 00 00 00 00 00 00","C7 87 CC 03 00 00 00 00 00 00"],[7994897,"C7 87 68 03 00 00 00 00 00 00","C7 87 D0 03 00 00 00 00 00 00"],[7994907,"0F 11 87 D0 02 00 00","0F 11 87 38 03 00 00"],[7994914,"66 0F D6 87 E0 02 00 00","66 0F D6 87 48 03 00 00"],[7994922,"66 0F D6 87 30 03 00 00","66 0F D6 87 98 03 00 00"],[7994930,"C6 87 38 03 00 00 00","C6 87 A0 03 00 00 00"],[7994937,"66 89 87 54 03 00 00","66 89 87 BC 03 00 00"],[7995557,"68 6C 03 00 00","68 D4 03 00 00"],[7996881,"89 83 C0 02 00 00","89 83 28 03 00 00"],[7996892,"8B 8B C0 02 00 00","8B 8B 28 03 00 00"],[7996913,"8B 83 C0 02 00 00","8B 83 28 03 00 00"],[7996921,"C7 80 88 00 00 00 17 00 00 00","C7 80 88 00 00 00 7F 00 00 00"],[7996931,"FF B3 C0 02 00 00","FF B3 28 03 00