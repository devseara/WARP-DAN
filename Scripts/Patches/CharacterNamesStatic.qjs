CharacterNamesStatic.SelectedRefs = [[7973642,138],[7975700,138],[7984373,138],[7984872,138],[7985370,138],[7985448,138],[7985560,138],[7985834,138],[7986419,138],[7986457,138],[7986610,138],[7986622,138],[7986922,138],[7987002,138],[7987068,138],[7987498,138],[7987516,138],[7990208,138],[7994012,138],[8001338,0],[8001360,0],[8001396,108],[8830543,138],[8933813,0],[8933835,0],[8933871,108],[13762111,138],[13763235,0],[13763266,0],[13775312,138],[13785945,108],[13785964,104],[13785978,86],[13785990,138],[13786003,84],[13786024,124],[13786029,174],[13786255,138],[13786548,138],[13788991,138],[13793455,138],[13798454,0],[13805082,138],[13805119,138]];
CharacterNamesStatic.install = function(state)
{
	if(ExtNameTextStatic.ActiveBuildDate!==20250716||state.characterInfo128)return state;
	const edits=CharacterNamesStatic.Profile.map(e=>[ExtNameStaticAsm.assertCode("CHARACTER_INFO layout",e[0],e[1]),e[2]]);
	const refs=CharacterNamesStatic.SelectedRefs.map(e=>{
		const phy=Exe.Vir2Phy(e[0],CODE);
		if(phy<0||Exe.GetUint32(phy)!==0x015F81D8+e[1])throw Error("CharacterNamesStatic: selected field changed");
		return [phy,e[1]<132?e[1]:e[1]+104];
	});
	const luckPhy=ExtNameStaticAsm.assertCode("character indexed luck",0x00D2A75A,
		"8D 46 5F B9 C0 A3 5F 01 69 C0 AF 00 00 00 0F B6 04 18");
	const a=ExtNameStaticAsm.asm();
	a.emit(0x8B,0xC6,0x69,0xC0);a.dword(279);
	a.emit(0xB9);a.dword(0x015FA3C0);
	a.emit(0x0F,0xB6,0x84,0x18);a.dword(0x4159);
	a.jmp(0x00D2A76C);
	const luck=ExtNameTextStatic.allocateCode(a);
	const [selectedPhy,selectedVir]=Exe.Allocate(279,0x10);
	ExtNameTextStatic.zeroBlock(selectedPhy,279);
	const owner=Exe.ActivePatch;Exe.ActivateGlobal();Exe.BeginTag(CACHE.getTag("CharacterNamesStatic.Info128"),true);
	try{
		for(const e of edits)Exe.SetHex(e[0],e[1]);
		for(const r of refs)Exe.SetUint32(r[0],selectedVir+r[1]);
		Exe.SetJMP(luckPhy,luck.virAddr,0);Exe.SetNOPs(luckPhy+5,13);
	}finally{Exe.EndTag();Exe.ActivePatch=owner;}
	state.characterInfo128={selectedVir};
	return state;
};
