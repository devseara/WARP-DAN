RedesignedEquipmentWindow.patchFooterControls = function(_)
{
	$$(_, 3.4, 'Move native Equipment action controls onto the footer baseline');

	$$(_, 3.42, 'Hide the legacy Off artwork while retaining its native release event');
	const offControlAddr = RedesignedEquipmentWindow.findUnique(
		'8B 8E D0 00 00 00 6A 01 8B 01 FF 90 D4 00 00 00 8B 8E CC 00 00 00 6A 01 8B 01 FF 90 D4 00 00 00',
		'Equipment native Off control visibility'
	);
	if (Exe.GetUint8(offControlAddr + 23) !== 1)
		throw Error('RedesignedEquipmentWindow: Equipment native Off visibility changed');
	Exe.SetUint8(offControlAddr + 23, 0);

	const controls = [
		{
			pattern: '8B 8F 2C 01 00 00 68 A7 00 00 00 68 C1 00 00 00 8B 01 FF 50 10',
			label: 'Equipment-change control'
		},
		{
			pattern: '8B 8F 30 01 00 00 68 A7 00 00 00 68 EB 00 00 00 8B 01 FF 50 10',
			label: 'Unequip-all control'
		},
		{
			pattern: '8B 8F 38 01 00 00 68 A7 00 00 00 68 A0 00 00 00 8B 01 FF 50 10',
			label: 'Apply control'
		},
		{
			pattern: '8B 8F 3C 01 00 00 68 A7 00 00 00 68 DC 00 00 00 8B 01 FF 50 10',
			label: 'Close control'
		}
	];
	for (const control of controls)
	{
		const addr = RedesignedEquipmentWindow.findUnique(control.pattern, control.label);
		Exe.SetUint32(addr + 7, 220);
	}

	const addr = RedesignedEquipmentWindow.findUnique(
		'FF 35 48 49 20 01 FF 35 44 49 20 01 8B 01 FF 50 10',
		'Equipment-ability control coordinates'
	);
	const yVir = Exe.GetUint32(addr + 2);
	const yPhy = Exe.Vir2Phy(yVir);
	if (Exe.GetUint32(yPhy) !== 0xA7)
		throw Error('RedesignedEquipmentWindow: Equipment-ability Y coordinate changed');
	Exe.SetUint32(yPhy, 220);

	$$(_, 3.44, 'Place native Items above Cart and hide it with Cart inactive');
	const itemsXAddr = RedesignedEquipmentWindow.findUnique(
		'D1 FE 68 20 01 00 00 83 EE 0E 89 85 68 FF FF FF',
		'Equipment native Items constructor X position'
	);
	Exe.SetHex(itemsXAddr + 7, '83 C6 1B');

	const itemsAddr = RedesignedEquipmentWindow.findUnique(
		'B8 AA 00 00 00 0F 4F C7 03 85 68 FF FF FF 50 56 FF D2',
		'Equipment native Items constructor position'
	);
	if (Exe.GetUint32(itemsAddr - 16) !== 0xFFFFFFC4)
		throw Error('RedesignedEquipmentWindow: Items constructor offset changed');
	Exe.SetUint32(itemsAddr - 16, 0xFFFFFFBB);

	const itemsLayoutAddr = RedesignedEquipmentWindow.findUnique(
		'B9 C4 FF FF FF 8B 50 10 B8 AA 00 00 00 0F 4F C1 8B 8E D0 00 00 00 03 45 CC 50 57 FF D2',
		'Equipment native Items primary layout position'
	);
	Exe.SetHex(itemsLayoutAddr,
		'BF AB 00 00 00 8B 50 10 B8 9A 01 00 00 0F 4F C7 ' +
		'BF A7 00 00 00 90 90 90 90');

	const itemsRefreshAddr = RedesignedEquipmentWindow.findUnique(
		'BF C4 FF FF FF 83 3D BC FF 5F 01 00 8B 01 8B 50 10 B8 AA 00 00 00 ' +
		'0F 4F C7 03 45 D0 50 FF 75 CC FF D2',
		'Equipment native Items refresh layout position'
	);
	Exe.SetHex(itemsRefreshAddr,
		'BF AB 00 00 00 83 3D BC FF 5F 01 00 8B 01 8B 50 10 B8 9A 01 00 00 ' +
		'0F 4F C7 BF A7 00 00 00 50 57');
};
RedesignedEquipmentWindow.patchEquipmentHitTest = function(_)
{
	$$(_, 4.1, 'Align native item hit testing with the renewal slots');
	let addr = RedesignedEquipmentWindow.findUnique(
		'8B 98 F4 00 00 00 8D 43 11 3B C8 0F 8C D4 00 00 00',
		'Equipment hit-test upper origin'
	);
	Exe.SetUint8(addr + 8, 0x1D);

	addr = RedesignedEquipmentWindow.findUnique(
		'8D 83 91 00 00 00 3B C8 0F 8F C6 00 00 00',
		'Equipment hit-test lower bound'
	);
	Exe.SetUint32(addr + 2, 0xC6);

	addr = RedesignedEquipmentWindow.findUnique(
		'8B 7D 0C 83 FF 06 7C 05 83 FF 6A 7C 15 81 FF AA 00 00 00',
		'Equipment hit-test column bounds'
	);
	Exe.SetUint8(addr + 5, 56);
	Exe.SetUint8(addr + 10, 86);
	Exe.SetUint32(addr + 15, 225);

	addr = RedesignedEquipmentWindow.findUnique(
		'8B 45 F0 8B 40 14 83 E8 06 3B F8 7D 45',
		'Equipment right-slot hit-test bound'
	);
	Exe.SetUint8(addr + 8, 25);

	addr = RedesignedEquipmentWindow.findUnique(
		'2B CB B8 4F EC C4 4E 83 E9 11 F7 E9 B8 61 60 60 60 C1 FA 03',
		'Equipment hit-test row divisor'
	);
	Exe.SetUint32(addr + 3, 0x3A83A83B);
	Exe.SetUint8(addr + 9, 0x1D);

	$$(_, 4.2, 'Align native click and double-click hit testing with the renewal slots');
	addr = RedesignedEquipmentWindow.findUnique(
		'8B 98 F4 00 00 00 8D 43 11 3B C8 0F 8C CC 00 00 00',
		'Equipment click-picker upper origin'
	);
	Exe.SetUint8(addr + 8, 0x1D);

	addr = RedesignedEquipmentWindow.findUnique(
		'8D 83 91 00 00 00 3B C8 0F 8F BE 00 00 00',
		'Equipment click-picker lower bound'
	);
	Exe.SetUint32(addr + 2, 0xC6);

	addr = RedesignedEquipmentWindow.findUnique(
		'8B 7D 0C 83 FF 06 7C 05 83 FF 1E 7C 0B 8D 87 05 FF FF FF 83 F8 17 77 47',
		'Equipment click-picker column bounds'
	);
	Exe.SetUint8(addr + 5, 58);
	Exe.SetUint8(addr + 10, 82);
	Exe.SetUint32(addr + 15, 0xFFFFFF1D);

	addr = RedesignedEquipmentWindow.findUnique(
		'2B CB B8 4F EC C4 4E 83 E9 11 F7 E9 B8 BF BF 8C 82',
		'Equipment click-picker row divisor'
	);
	Exe.SetUint32(addr + 3, 0x3A83A83B);
	Exe.SetUint8(addr + 9, 0x1D);

	addr = RedesignedEquipmentWindow.findUnique(
		'B8 BF BF 8C 82 C1 FA 03 8B F2 C1 EE 1F 03 F2 F7 EF 03 D7 C1 FA 07',
		'Equipment click-picker side divisor'
	);
	Exe.SetUint32(addr + 1, 0x905A3864);
};

RedesignedEquipmentWindow.patchLeftRailSelectors = function(_)
{
	$$(_, 4.3, 'Route renewal rail and footer actions through native Equipment events');
	const hookAddr = RedesignedEquipmentWindow.findUnique(
		'55 8B EC 6A FF 68 C6 12 EB 00 64 A1 00 00 00 00 50 81 EC 08 01 00 00',
		'Equipment left-button handler'
	);
	const returnVir = Exe.Phy2Vir(hookAddr + 5, CODE);
	const eventVir = 0x008BF7D0;
	const parts = [
		[
			'83 B9 B4 00 00 00 00',            // local character only
			JNE(Filler(6)),
			'83 B9 F0 00 00 00 00',            // General mode for footer actions
			JNE(Filler(1, 1)),
			'8B 44 24 08',                      // local y
			'3D BF 00 00 00',
			JL(Filler(1, 1)),
			'3D D7 00 00 00',
			JGE(Filler(6)),
			'8B 44 24 04',                      // local x
			'3D 90 00 00 00',
			JL(Filler(6)),
			'3D A7 00 00 00',
			JL(Filler(3, 1)),                    // Falcon/Peco cell
			'3D AB 00 00 00',
			JL(Filler(6)),
			'3D C3 00 00 00',
			JGE(Filler(6)),
			'83 3D BC FF 5F 01 00',            // Cart cell is active
			JG(Filler(4, 1)),
			JMP(Filler(6))
		].join(' '),

		[
			' 83 7C 24 04 22',                 // x < 34: renewal rail
			JAE(Filler(6)),
			'8B 44 24 08 83 F8 11',            // y >= 17
			JL(Filler(6)),
			'83 F8 55',                         // y < 85
			JGE(Filler(6)),
			'83 F8 33',                         // first rail cell is General
			JL(Filler(2, 1)),
			'B8 01 00 00 00',                  // Costume index
			JMP(Filler(5, 1))
		].join(' '),

		[
			' 33 C0',                           // General index
			JMP(Filler(5, 1))
		].join(' '),

		[
			' A1 B4 B2 5F 01',                 // native option state
			'A8 30',                            // Falcon or Peco/Riding
			JNE(Filler(4, 1)),
			JMP(Filler(6))
		].join(' '),

		[
			' 6A 00 6A 00 6A 00 68 F8 00 00 00 6A 06 6A 00',
			CALL(Filler(10)),                   // stock click 0x06, control 0xF8
			'33 C0 C2 08 00'
		].join(' '),

		[
			' 6A 00 6A 00 6A 00 50 6A 16 6A 00',
			CALL(Filler(10)),                   // stock mode notification
			'33 C0 C2 08 00'
		].join(' '),

		[
			' 55 8B EC 6A FF',                 // replay the stock prologue
			JMP(Filler(11))
		].join(' ')
	];
	const [,
		railTarget,
		generalTarget,
		mountTarget,
		releaseTarget,
		railDispatchTarget,
		stockTarget
	] = MapAddrs(parts);
	AutoHook(hookAddr, parts, {
		nops: 0,
		localTgts: {
			'1,1': railTarget,
			'2,1': generalTarget,
			'3,1': mountTarget,
			'4,1': releaseTarget,
			'5,1': railDispatchTarget,
			6: stockTarget
		},
		targets: {
			10: eventVir,
			11: returnVir
		}
	});

	RedesignedEquipmentWindow.patchLeftRailHoverLabels(_);
};
RedesignedEquipmentWindow.patchLeftRailHoverLabels = function(_)
{
	$$(_, 4.4, 'Show native cursor-relative rail and footer action balloons');
	const generalTextVir = RedesignedEquipmentWindow.writeCString('General Equipment');
	const costumeTextVir = RedesignedEquipmentWindow.writeCString('Costume Equipment');
	const falconTextVir = RedesignedEquipmentWindow.writeCString('Release Falcon');
	const pecoTextVir = RedesignedEquipmentWindow.writeCString('Release Pecopeco');
	const cartTextVir = RedesignedEquipmentWindow.writeCString('Release Cart');
	const hookAddr = RedesignedEquipmentWindow.findUnique(
		'55 8B EC 6A FF 68 BF 13 EB 00 64 A1 00 00 00 00 50 81 EC 40 02 00 00',
		'Equipment mouse-move handler'
	);
	const returnVir = Exe.Phy2Vir(hookAddr + 5, CODE);
	const parts = [
		[
			'60',
			'8B 44 24 28',                       // local mouse y after PUSHAD
			'3D BF 00 00 00',
			JL(Filler(1, 1)),
			'3D D7 00 00 00',
			JGE(Filler(7)),
			'83 B9 B4 00 00 00 00',             // local character only
			JNE(Filler(7)),
			'83 B9 F0 00 00 00 00',             // General mode only
			JNE(Filler(7)),
			'8B 54 24 24',                       // local mouse x
			'81 FA 90 00 00 00',
			JL(Filler(7)),                    // ammunition retains item tooltip
			'81 FA A7 00 00 00',
			JL(Filler(3, 1)),                    // Falcon/Peco cell
			'81 FA AB 00 00 00',
			JL(Filler(7)),
			'81 FA C3 00 00 00',
			JGE(Filler(7)),
			'83 3D BC FF 5F 01 00',             // Cart is present
			JLE(Filler(7)),
			'BF ' + RedesignedEquipmentWindow.P32(cartTextVir),
			JMP(Filler(6, 1))
		].join(' '),

		[
			' 83 7C 24 24 22',                  // x < 34 after PUSHAD
			JAE(Filler(7)),
			'83 F8 11',                          // y >= 17
			JL(Filler(7)),
			'83 F8 55',                          // y < 85
			JGE(Filler(7)),
			'83 F8 33',                          // first rail cell is General
			JL(Filler(2, 1)),
			'BF ' + RedesignedEquipmentWindow.P32(costumeTextVir),
			JMP(Filler(6, 1))
		].join(' '),

		[
			' BF ' + RedesignedEquipmentWindow.P32(generalTextVir),
			JMP(Filler(6, 1))
		].join(' '),

		[
			' A1 B4 B2 5F 01',                  // native option state
			'A8 10',                             // Falcon
			JNE(Filler(4, 1)),
			'A8 20',                             // Peco/Riding
			JNE(Filler(5, 1)),
			JMP(Filler(7))
		].join(' '),

		[
			' BF ' + RedesignedEquipmentWindow.P32(falconTextVir),
			JMP(Filler(6, 1))
		].join(' '),

		[
			' BF ' + RedesignedEquipmentWindow.P32(pecoTextVir),
			JMP(Filler(6, 1))
		].join(' '),

		[
			' 8B 44 24 24',                     // local mouse x
			'83 E8 10',                          // native control-tooltip offset
			'8B 5C 24 28',                      // local mouse y
			'83 EB 0D',                          // native control-tooltip offset
			'8B F1',                             // preserve Equipment receiver
			'83 EC 08',
			'89 04 24 89 5C 24 04',
			'8D 04 24 8D 5C 24 04 53 50 8B CE',
			CALL(Filler(10)),                    // convert to screen coordinates
			'8B 04 24 8B 5C 24 04',
			'8B 0D 3C 33 21 01',                // global tooltip manager
			'6A 01 6A 01 6A FF 53 50 57',      // native control-tooltip flags
			CALL(Filler(11)),
			'83 C4 08'
		].join(' '),

		[
			' 61',
			'55 8B EC 6A FF',                    // replay the stock prologue
			JMP(Filler(12))
		].join(' ')
	];
	const [,
		railTarget,
		generalTarget,
		mountTarget,
		falconTarget,
		pecoTarget,
		tooltipTarget,
		originalTarget
	] = MapAddrs(parts);
	AutoHook(hookAddr, parts, {
		nops: 0,
		localTgts: {
			'1,1': railTarget,
			'2,1': generalTarget,
			'3,1': mountTarget,
			'4,1': falconTarget,
			'5,1': pecoTarget,
			'6,1': tooltipTarget,
			7: originalTarget
		},
		targets: {
			10: 0x00A1EF70,
			11: 0x00A753D0,
			12: returnVir
		}
	});
};
RedesignedEquipmentWindow.writeCString = function(text)
{
	const [phy, vir] = Exe.Allocate(text.length + 1, 0x10);
	for (let i = 0; i < text.length; i++)
		Exe.SetUint8(phy + i, text.charCodeAt(i) & 0xFF);
	Exe.SetUint8(phy + text.length, 0);
	return vir;
};

RedesignedEquipmentWindow.redirect = function(_, spec)
{
	const label = `RedesignedEquipmentWindow: ${spec.label}`;
	$$(_, 1.1, `Find the legacy ${spec.label} resource`);
	const oldVir = Exe.FindText(spec.legacy, CASE_INSENSITIVE);
	if (oldVir < 0)
		throw Error(`${label}: legacy resource string not found`);

	const newVir = spec.replacementVir ?? RedesignedEquipmentWindow.writeCString(spec.replacement);
	const refs = new Set();
	for (const opcode of spec.opcodes)
	{
		const pattern = opcode + ' ' + RedesignedEquipmentWindow.P32(oldVir);
		for (const addr of Exe.FindHexN(pattern))
			refs.add(addr);
	}

	if (refs.size === 0)
		throw Error(`${label}: no immediate resource references found`);

	$$(_, 1.2, `Redirect ${refs.size} immediate resource reference(s)`);
	for (const addr of refs)
	{
		const opcode = Exe.GetUint8(addr);
		if (opcode !== 0x68 && (opcode < 0xB8 || opcode > 0xBF))
			throw Error(`${label}: unexpected immediate opcode at ${addr.toHex(true)}`);
		if (Exe.GetUint32(addr + 1) !== oldVir)
			throw Error(`${label}: legacy pointer changed before patch`);
		Exe.SetUint32(addr + 1, newVir);
	}
};

RedesignedEquipmentWindow.onApplied = function()
{
	if (Warp.TestMode || !Exe.GetSavedInput('$copyRedesignedEquipmentAssets'))
		return;

	const source = Warp.Path + RedesignedEquipmentWindow.AssetPath;
	const clientDir = System.DirPath(Warp.TgtExe);
	const target = clientDir + '/' + RedesignedEquipmentWindow.TargetPath;
	if (!System.MkDir(target))
		throw Error(`RedesignedEquipmentWindow: unable to create ${target}`);

	for (const file of RedesignedEquipmentWindow.Assets)
	{
		if (!System.Copy(source + '/' + file, target + '/' + file, true))
			throw Error(`RedesignedEquipmentWindow: unable to copy ${file}`);
	}
};

RedesignedEquipmentWindow.validate = function()
{
	if (Exe.BuildDate !== RedesignedEquipmentWindow.BuildDate)
		return false;

	for (const patch of RedesignedEquipmentWindow.conflicts)
	{
		try
		{
			if (Warp.GetPatchState(patch))
				return false;
		}
		catch (e)
		{
			// Older WARP runtimes may not expose the optional patch-state query.
		}
	}

	const prefix = RedesignedEquipmentWindow.uiPrefix();
	return Exe.FindText(prefix + '\\basic_interface\\equipwin_bg.bmp', CASE_INSENSITIVE) > 0 &&
		Exe.FindText(prefix + '\\basic_interface\\equipwin_bg2.bmp', CASE_INSENSITIVE) > 0;
};
