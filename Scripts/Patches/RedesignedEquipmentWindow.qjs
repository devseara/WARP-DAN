RedesignedEquipmentWindow = function(_)
{
	const name = 'RedesignedEquipmentWindow';
	$$(_, 1, 'Install the asset-backed renewal Equipment body');

	if (RedesignedEquipmentWindow.conflicts.some(patch =>
	{
		try
		{
			return Warp.GetPatchState(patch);
		}
		catch (e)
		{
			return false;
		}
	}))
		throw Error(`${name}: disable NoEquipSwap and NoEquipWinTitle first`);

	const assetPrefix = RedesignedEquipmentWindow.uiPrefix() +
		'\\uirenewal\\equipmentui\\';
	const background = assetPrefix + 'bg.png';
	const backgroundVir = RedesignedEquipmentWindow.writeCString(background);
	const primaryVir = RedesignedEquipmentWindow.writeCString(assetPrefix + 'bg_primary.png');
	const primary2Vir = RedesignedEquipmentWindow.writeCString(assetPrefix + 'bg_primary2.png');
	const swapVir = RedesignedEquipmentWindow.writeCString(assetPrefix + 'bg_swap.png');
	const menuPrimaryVir = RedesignedEquipmentWindow.writeCString(assetPrefix + 'menu_primary.png');
	const menuSecondaryVir = RedesignedEquipmentWindow.writeCString(assetPrefix + 'menu_secundary.png');
	const iconFalconVir = RedesignedEquipmentWindow.writeCString(assetPrefix + 'icon_falcon.png');
	const iconPecoVir = RedesignedEquipmentWindow.writeCString(assetPrefix + 'icon_peco.png');
	const iconCartVir = RedesignedEquipmentWindow.writeCString(assetPrefix + 'icon_cart.png');
	const shadowVir = RedesignedEquipmentWindow.writeCString(assetPrefix + 'ibox_shadow.png');
	const redirects = [
		{
			label: 'viewed-character equipment body',
			legacy: RedesignedEquipmentWindow.uiPrefix() + '\\basic_interface\\equipwin_bg.bmp',
			replacement: background,
			replacementVir: backgroundVir,
			opcodes: ['B8', 'B9']
		},
		{
			label: 'local-character equipment body',
			legacy: RedesignedEquipmentWindow.uiPrefix() + '\\basic_interface\\equipwin_bg2.bmp',
			replacement: background,
			replacementVir: backgroundVir,
			opcodes: ['B8', 'B9']
		},
		{
			label: 'Equipment compatible-slot shadow',
			legacy: RedesignedEquipmentWindow.uiPrefix() + '\\basic_interface\\item_invert.bmp',
			replacement: assetPrefix + 'ibox_shadow.png',
			replacementVir: shadowVir,
			opcodes: ['68']
		},
		{
			label: 'Swap normal button',
			legacy: RedesignedEquipmentWindow.uiPrefix() + '\\swap_equipment\\btn_change2_normal.bmp',
			replacement: assetPrefix + 'swapr_out.png',
			opcodes: ['68', 'BA']
		},
		{
			label: 'Swap hover button',
			legacy: RedesignedEquipmentWindow.uiPrefix() + '\\swap_equipment\\btn_change2_over.bmp',
			replacement: assetPrefix + 'swapr_over.png',
			opcodes: ['68', 'B8']
		},
		{
			label: 'Swap pressed button',
			legacy: RedesignedEquipmentWindow.uiPrefix() + '\\swap_equipment\\btn_change2_press.bmp',
			replacement: assetPrefix + 'swapr_press.png',
			opcodes: ['68', 'B8']
		},
		{
			label: 'Swap disabled button',
			legacy: RedesignedEquipmentWindow.uiPrefix() + '\\swap_equipment\\btn_change2_disable.bmp',
			replacement: assetPrefix + 'swapr_out.png',
			opcodes: ['BB']
		}
	];

	for (const spec of redirects)
		RedesignedEquipmentWindow.redirect(_, spec);

	RedesignedEquipmentWindow.patchEquipmentLayers(
		_, primaryVir, primary2Vir, menuPrimaryVir, menuSecondaryVir,
		iconFalconVir, iconPecoVir, iconCartVir
	);
	RedesignedEquipmentWindow.patchSurfaceModeLock(_);
	RedesignedEquipmentWindow.patchWindowGeometry(_);
	RedesignedEquipmentWindow.patchLegacyTabVisibility(_);
	RedesignedEquipmentWindow.patchEquipmentRows(_);
	RedesignedEquipmentWindow.patchEquipmentDragShadow(_);
	RedesignedEquipmentWindow.patchCostumeBody(_);
	RedesignedEquipmentWindow.patchAmmunitionSlot(_);
	RedesignedEquipmentWindow.patchFooterControls(_);
	RedesignedEquipmentWindow.patchEquipmentHitTest(_);
	RedesignedEquipmentWindow.patchLeftRailSelectors(_);
	RedesignedEquipmentWindow.patchSwapPane(_, swapVir);

	if (!Warp.TestMode)
		Exe.GetUserInput(
			'$copyRedesignedEquipmentAssets',
			D_Bool,
			'Copy Equipment UI Assets',
			'Copy the redesigned Equipment UI assets into the target client data folder?',
			true
		);

	$$(_, 5, 'Keep stock item identity, Costume, Swap, tooltip, drag, and packet ownership');
	return true;
};

RedesignedEquipmentWindow.BuildDate = 20250716;
RedesignedEquipmentWindow.PreserveLegacyTabOwnership = true;
RedesignedEquipmentWindow.RemapSwapAmmunition = false;

RedesignedEquipmentWindow.uiPrefix = function()
{
	return String.fromCharCode(
		0xC0, 0xAF, 0xC0, 0xFA, 0xC0, 0xCE, 0xC5, 0xCD,
		0xC6, 0xE4, 0xC0, 0xCC, 0xBD, 0xBA
	);
};

RedesignedEquipmentWindow.AssetPath = 'Images/EquipmentUI';
RedesignedEquipmentWindow.TargetPath =
	'data/texture/' + RedesignedEquipmentWindow.uiPrefix() +
	'/uirenewal/equipmentui';

RedesignedEquipmentWindow.Assets = [
	'bg.png',
	'bg_primary.png',
	'bg_primary2.png',
	'bg_swap.png',
	'ibox_costume.png',
	'ibox_gear.png',
	'ibox_gearcircle.png',
	'ibox_shadow.png',
	'ibox_swap.png',
	'icon_cart.png',
	'icon_falcon.png',
	'icon_peco.png',
	'menu_primary.png',
	'menu_secundary.png',
	'swapb_out.png',
	'swapb_over.png',
	'swapb_press.png',
	'swapr_out.png',
	'swapr_over.png',
	'swapr_press.png',
	'unnequip_out.png',
	'unnequip_over.png',
	'unnequip_press.png'
];

RedesignedEquipmentWindow.conflicts = [
	'NoEquipSwap',
	'NoEquipWinTitle'
];

RedesignedEquipmentWindow.P32 = function(value)
{
	const bytes = [
		value & 0xFF,
		(value >>> 8) & 0xFF,
		(value >>> 16) & 0xFF,
		(value >>> 24) & 0xFF
	];
	return bytes.map(byte => byte.toString(16).padStart(2, '0')).join(' ').toUpperCase();
};

RedesignedEquipmentWindow.findUnique = function(pattern, label)
{
	const matches = Exe.FindHexN(pattern);
	if (matches.length !== 1)
		throw Error(`RedesignedEquipmentWindow: ${label}: expected one match, found ${matches.length}`);
	return matches[0];
};

RedesignedEquipmentWindow.patchEquipmentLayers = function(
	_, primaryVir, primary2Vir, menuPrimaryVir, menuSecondaryVir,
	iconFalconVir, iconPecoVir, iconCartVir
)
{
	$$(_, 1.3, 'Draw the supplied Equipment assets as native runtime layers');
	let addr = RedesignedEquipmentWindow.findUnique(
		'8B 86 F4 00 00 00 8B CE 83 C0 11 50 6A 00 E8 ?? ?? ?? ?? 8B 86 F0 00 00 00',
		'Equipment base-background draw position'
	);
	Exe.SetUint8(addr + 10, 0);

	const hookAddr = RedesignedEquipmentWindow.findUnique(
		'8B 86 F0 00 00 00 83 F8 02 0F 85 A3 00 00 00',
		'Equipment layered-body insertion point'
	);
	const returnVir = Exe.Phy2Vir(hookAddr + 6, CODE);
	const parts = [
		[
			'60',
			'BF ' + RedesignedEquipmentWindow.P32(primary2Vir),
			'BD ' + RedesignedEquipmentWindow.P32(menuPrimaryVir),
			'83 BE B4 00 00 00 00',              // viewed characters use Primary2
			JNE(Filler(1, 1)),
			'83 BE F0 00 00 00 01',              // Costume mode uses Primary2
			JE(Filler(2, 1)),
			'BF ' + RedesignedEquipmentWindow.P32(primaryVir),
			JMP(Filler(1, 1))
		].join(' '),

		' BD ' + RedesignedEquipmentWindow.P32(menuSecondaryVir),

		[
			' 57',                               // body resource path
			CALL(Filler(10)),
			'83 C4 04',
			'8B CB',
			'50',
			CALL(Filler(11)),
			'85 C0',
			JE(Filler(3, 1)),
			'6A 00 50 6A 11 6A 22 8B CE',       // x=34, y=17
			CALL(Filler(12))
		].join(' '),

		[
			' 55',                               // selected menu resource path
			CALL(Filler(10)),
			'83 C4 04',
			'8B CB',
			'50',
			CALL(Filler(11)),
			'85 C0',
			JE(Filler(4, 1)),
			'6A 00 50 6A 11 6A 00 8B CE',       // x=0, y=17
			CALL(Filler(12))
		].join(' '),

		[
			' 83 BE B4 00 00 00 00',            // local character only
			JNE(Filler(9)),
			'83 BE F0 00 00 00 00',             // General mode only
			JNE(Filler(9)),
			'A1 B4 B2 5F 01',                    // native option state
			'A8 10',                              // Falcon
			JNE(Filler(5, 1)),
			'A8 20',                              // Peco/Riding
			JNE(Filler(6, 1)),
			JMP(Filler(8, 1))
		].join(' '),

		[
			' BF ' + RedesignedEquipmentWindow.P32(iconFalconVir),
			'BD 90 00 00 00',                    // x=144
			JMP(Filler(7, 1))
		].join(' '),

		[
			' BF ' + RedesignedEquipmentWindow.P32(iconPecoVir),
			'BD 91 00 00 00',                    // x=145
			JMP(Filler(7, 1))
		].join(' '),

		[
			' 57',
			CALL(Filler(10)),
			'83 C4 04',
			'8B CB 50',
			CALL(Filler(11)),
			'85 C0',
			JE(Filler(8, 1)),
			'6A 00 50 68 BF 00 00 00 55 8B CE', // y=191, selected x
			CALL(Filler(12))
		].join(' '),

		[
			' 83 3D BC FF 5F 01 00',            // native Cart presence
			JLE(Filler(9)),
			'68 ' + RedesignedEquipmentWindow.P32(iconCartVir),
			CALL(Filler(10)),
			'83 C4 04',
			'8B CB 50',
			CALL(Filler(11)),
			'85 C0',
			JE(Filler(9)),
			'6A 00 50 68 BF 00 00 00 68 AA 00 00 00 8B CE', // x=170, y=191
			CALL(Filler(12))
		].join(' '),

		[
			' 61',
			'8B 86 F0 00 00 00',                // replay stock mode load
			JMP(Filler(13))
		].join(' ')
	];
	const [,
		costumeTarget,
		bodyTarget,
		menuTarget,
		statusTarget,
		falconTarget,
		pecoTarget,
		mountDrawTarget,
		cartTarget,
		doneTarget
	] = MapAddrs(parts);
	AutoHook(hookAddr, parts, {
		nops: 0,
		localTgts: {
			'1,1': bodyTarget,
			'2,1': costumeTarget,
			'3,1': menuTarget,
			'4,1': statusTarget,
			'5,1': falconTarget,
			'6,1': pecoTarget,
			'7,1': mountDrawTarget,
			'8,1': cartTarget,
			9: doneTarget
		},
		targets: {
			10: 0x00A9F030,
			11: 0x00A8D4A0,
			12: 0x00A1D260,
			13: returnVir
		}
	});
};
RedesignedEquipmentWindow.patchSurfaceModeLock = function(_)
{
	$$(_, 1.4, 'Lock the Equipment backing surface to stock tiled mode');
	let hookAddr = RedesignedEquipmentWindow.findUnique(
		'8B 8E 24 01 00 00 85 C9 74 14 8B 01 6A 00 6A 00 6A 00 6A 00 6A 3C 6A 00 FF 90 94 00 00 00 8B 4D F4 64 89 0D 00 00 00 00',
		'Equipment draw epilogue'
	);
	hookAddr += 30;
	const returnVir = Exe.Phy2Vir(hookAddr + 10, CODE);
	const parts = [
		[
			'8B 46 24',                         // current backing surface
			'85 C0',
			JE(Filler(1, 1)),
			'C6 40 28 00'                       // force two-tile mode before flush
		].join(' '),

		[
			' 8B 4D F4',                        // replay SEH unlink
			'64 89 0D 00 00 00 00',
			JMP(Filler(2))
		].join(' ')
	];
	const [, replayTarget] = MapAddrs(parts);
	AutoHook(hookAddr, parts, {
		nops: 5,
		localTgts: {
			'1,1': replayTarget
		},
		targets: {
			2: returnVir
		}
	});
};
RedesignedEquipmentWindow.patchWindowGeometry = function(_)
{
	$$(_, 2.1, 'Resize Alt+Q directly to 280x240');
	let addr = RedesignedEquipmentWindow.findUnique(
		'C7 45 FC FF FF FF FF 8B C8 68 A7 00 00 00 89 87 E0 01 00 00 68 18 01 00 00',
		'Equipment factory dimensions'
	);
	Exe.SetUint32(addr + 10, 0xF0);
	$$(_, 2.2, 'Remove the inherited 20-pixel tab offset');
	addr = RedesignedEquipmentWindow.findUnique(
		'C7 86 D8 00 00 00 00 00 00 00 C7 86 F0 00 00 00 00 00 00 00 C7 86 F4 00 00 00 14 00 00 00',
		'Equipment constructor tab offset'
	);
	Exe.SetUint32(addr + 26, 0);

	addr = RedesignedEquipmentWindow.findUnique(
		'33 F6 33 C0 89 B5 64 FF FF FF B9 14 00 00 00 8B 97 B4 00 00 00 85 D2',
		'Equipment initializer tab-height delta'
	);
	Exe.SetUint32(addr + 11, 0);

	if (RedesignedEquipmentWindow.PreserveLegacyTabOwnership)
		return;


	$$(_, 2.3, 'Detach the legacy General/Costume/Title tab child');
	addr = RedesignedEquipmentWindow.findUnique(
		'FF B7 EC 00 00 00 8B CF E8 49 61 17 00',
		'Equipment horizontal tab AddChildDirect call'
	);
	Exe.SetNOPs(addr, 13);
};

RedesignedEquipmentWindow.patchLegacyTabVisibility = function(_)
{
	$$(_, 2.2, 'Retain parent ownership of the legacy tab child while hiding it');
	const hookAddr = RedesignedEquipmentWindow.findUnique(
		'FF B7 EC 00 00 00 8B CF E8 49 61 17 00',
		'Equipment horizontal tab AddChildDirect call'
	);
	const returnVir = Exe.Phy2Vir(hookAddr + 12, CODE);
	const parts = [
		[
			'FF B7 EC 00 00 00',                // child argument
			'8B CF',                            // parent receiver
			CALL(Filler(10)),                   // replay AddChildDirect
			'50',                               // preserve its return value
			'8B 8F EC 00 00 00',                // legacy tab child
			'85 C9',
			JE(Filler(1, 1)),
			'8B 11',
			'6A 00',
			'FF 52 38'                          // child->SetVisible(false)
		].join(' '),

		[
			'58',
			JMP(Filler(11))
		].join(' ')
	];
	const [, resumeTarget] = MapAddrs(parts);
	AutoHook(hookAddr, parts, {
		nops: 8,
		localTgts: {
			'1,1': resumeTarget
		},
		targets: {
			10: 0x00A1B780,
			11: returnVir
		}
	});
};

RedesignedEquipmentWindow.patchEquipmentRows = function(_)
{
	$$(_, 3.1, 'Move native item sprites onto the renewal slot grid');
	let addr = RedesignedEquipmentWindow.findUnique(
		'C7 85 C8 FA FF FF 06 00 00 00 C7 85 CC FA FF FF FB 00 00 00 C7 85 B8 FA FF FF 1C 00 00 00 C7 85 BC FA FF FF A7 00 00 00',
		'Equipment row coordinate table'
	);
	Exe.SetUint32(addr + 6, 58);
	Exe.SetUint32(addr + 16, 227);

	addr = RedesignedEquipmentWindow.findUnique(
		'6B C1 1A 8B FE 83 C2 2C 83 E7 FC 8B CB',
		'Equipment lower-row spacing'
	);
	Exe.SetUint8(addr + 2, 0x23);
	Exe.SetUint8(addr + 7, 0x42);

	addr = RedesignedEquipmentWindow.findUnique(
		'8D 42 12 50 FF B4 8D C8 FA FF FF 8B CB E8 19 90 FD FF',
		'Equipment first-row vertical position'
	);
	Exe.SetUint8(addr + 2, 0x1F);

	addr = RedesignedEquipmentWindow.findUnique(
		'8B CE 83 E1 03 6B D1 1A 8B 8B F4 00 00 00 83 C1 38',
		'Equipment lower-row overlay spacing'
	);
	Exe.SetUint8(addr + 7, 0x23);
	Exe.SetUint8(addr + 16, 0x4E);

	addr = RedesignedEquipmentWindow.findUnique(
		'8B 93 F4 00 00 00 8B CE 6A 01 83 E1 03 83 C2 1E',
		'Equipment first-row overlay position'
	);
	Exe.SetUint8(addr + 15, 0x2B);

	addr = RedesignedEquipmentWindow.findUnique(
		'8D 4B 01 8B 9D C4 FA FF FF 6B C9 1A 6A 01 8B 92 F4 00 00 00 50 8B 85 D4 FA FF FF 03 CA 83 FE 08 0F 43 CA 83 C1 12',
		'Equipment empty-slot overlay grid'
	);
	Exe.SetUint8(addr + 11, 0x23);
	Exe.SetUint8(addr + 37, 0x1F);

	$$(_, 3.2, 'Suppress legacy item-name rows without removing item objects');
	addr = RedesignedEquipmentWindow.findUnique(
		'83 C0 05 50 E8 93 F6 FF FF 8B BD D0 FA FF FF EB 38',
		'Equipment lower-row label call'
	);
	Exe.SetHex(addr + 4, '83 C4 1C 90 90');

	addr = RedesignedEquipmentWindow.findUnique(
		'83 C0 05 50 E8 53 F6 FF FF 33 C0 66 3B 85 60 FB FF FF',
		'Equipment first-row label call'
	);
	Exe.SetHex(addr + 4, '83 C4 1C 90 90');

	$$(_, 3.3, 'Pin the stock character preview to the primary-canvas center');
	addr = RedesignedEquipmentWindow.findUnique(
		'99 2B C2 D1 F8 68 95 00 00 00 40 50 56 E8 C2 8C EF FF',
		'Equipment character-preview center'
	);
	Exe.SetHex(addr, '33 C0 B0 9B 99');         // X=155, then stock INC -> 156
};

RedesignedEquipmentWindow.patchEquipmentDragShadow = function(_)
{
	$$(_, 3.35, 'Align the native compatible-slot shadow with the renewal slot grid');
	let addr = RedesignedEquipmentWindow.findUnique(
		'C7 85 D4 FE FF FF 04 00 00 00 8D BE B8 00 00 00 C7 85 D8 FE FF FF F8 00 00 00 BB 03 00 00 00',
		'Equipment compatible-slot shadow columns'
	);
	Exe.SetUint32(addr + 6, 56);
	Exe.SetUint32(addr + 22, 225);

	addr = RedesignedEquipmentWindow.findUnique(
		'6B C8 1A 8B 86 F4 00 00 00 83 C0 33',
		'Equipment compatible-slot shadow lower rows'
	);
	Exe.SetUint8(addr + 2, 0x23);
	Exe.SetUint8(addr + 11, 0x40);

	addr = RedesignedEquipmentWindow.findUnique(
		'8B 86 F4 00 00 00 83 C0 19 50 81 E2 03 00 00 80',
		'Equipment compatible-slot shadow first row'
	);
	Exe.SetUint8(addr + 8, 0x1D);
};

RedesignedEquipmentWindow.patchCostumeBody = function(_)
{
	$$(_, 3.4, 'Suppress the stock Costume panel while retaining its native item renderer');
	let addr = RedesignedEquipmentWindow.findUnique(
		'83 BB F0 00 00 00 01 75 36 E8 ?? ?? ?? ?? 68 ?? ?? ?? ??',
		'Costume stock-panel branch'
	);
	if (Exe.GetUint8(addr + 7) !== 0x75)
		throw Error('RedesignedEquipmentWindow: Costume stock-panel branch changed');
	Exe.SetUint8(addr + 7, 0xEB);

	$$(_, 3.45, 'Retain native Show Equip and View Costumes checkbox visibility');
};

RedesignedEquipmentWindow.patchAmmunitionSlot = function(_)
{
	$$(_, 3.5, 'Preserve native item-provider identities and route ammunition');

	$$(_, 3.51, 'Suppress the separate width-relative legacy ammunition preview');
	const legacyAmmoAddr = RedesignedEquipmentWindow.findUnique(
		'83 BD E4 FE FF FF 00 76 52 6A 00 8D 85 E0 FE FF FF',
		'Equipment legacy ammunition preview'
	);
	Exe.SetHex(legacyAmmoAddr + 7, 'EB 52');

	let hookAddr = RedesignedEquipmentWindow.findUnique(
		'83 BB F0 00 00 00 01 8B 83 B4 00 00 00 56 75 75 85 C0',
		'Equipment renderer slot lookup'
	) + 13;
	let returnVir = Exe.Phy2Vir(hookAddr + 5, CODE);
	const generalTargetVir = Exe.Phy2Vir(hookAddr + 3 + 0x75, CODE);
	let parts = [
		[
			'83 BB F0 00 00 00 00',
			JNE(Filler(1, 1)),
			'83 FE 0A',
			JNE(Filler(1, 1)),
			'6A 0F',
			JMP(Filler(2, 1))
		].join(' '),

		' 56',

		[
			' 83 BB F0 00 00 00 01',
			JNE(Filler(3)),
			'85 C0',
			JMP(Filler(4))
		].join(' ')
	];
	let [, normalTarget, replayTarget] = MapAddrs(parts);
	AutoHook(hookAddr, parts, {
		nops: 0,
		localTgts: {
			'1,1': normalTarget,
			'2,1': replayTarget
		},
		targets: {
			3: generalTargetVir,
			4: returnVir
		}
	});

	RedesignedEquipmentWindow.patchAmmunitionRenderGeometry(_);
	RedesignedEquipmentWindow.patchAmmunitionHitTest(_);
	RedesignedEquipmentWindow.patchAmmunitionHoverLabel(_);
};


RedesignedEquipmentWindow.patchAmmunitionRenderGeometry = function(_)
{
	$$(_, 3.55, 'Add a General-only ammunition render pass at the footer arrow circle');
	let hookAddr = RedesignedEquipmentWindow.findUnique(
		'83 FE 0A 0F 8C 48 FC FF FF 8B 4D F4 64 89 0D 00 00 00 00',
		'Equipment item-loop bound'
	);
	let parts = [
		[
			'83 BB F0 00 00 00 00',
			JNE(Filler(1, 1)),
			'83 FE 0B',
			JL(Filler(10)),
			JMP(Filler(11))
		].join(' '),

		[
			' 83 FE 0A',
			JL(Filler(10)),
			JMP(Filler(11))
		].join(' ')
	];
	const [, stockBoundTarget] = MapAddrs(parts);
	AutoHook(hookAddr, parts, {
		nops: 4,
		localTgts: {
			'1,1': stockBoundTarget
		},
		targets: {
			10: 0x00897E70,
			11: 0x00898228
		}
	});

	const coordinateSites = [
		{
			pattern: '8D 42 12 50 FF B4 8D C8 FA FF FF 8B CB E8 ?? ?? ?? ??',
			label: 'Equipment ammunition item coordinates',
			replay: '8D 42 1F 50 FF B4 8D C8 FA FF FF',
			length: 11,
			y: 191,
			returnVir: 0x00898020
		},
		{
			pattern: '8B CE 6A 01 83 E1 03 83 C2 1E 50 52 FF B4 8D C8 FA FF FF 8B CB E8 ?? ?? ?? ??',
			offset: 11,
			label: 'Equipment ammunition status-overlay coordinates',
			replay: '52 FF B4 8D C8 FA FF FF',
			length: 8,
			y: 203,
			returnVir: 0x00898125
		},
		{
			pattern: '51 FF B4 85 C8 FA FF FF 8B CB E8 ?? ?? ?? ??',
			label: 'Equipment ammunition item-overlay coordinates',
			replay: '51 FF B4 85 C8 FA FF FF',
			length: 8,
			y: 191,
			returnVir: 0x008981E4
		}
	];
	for (const spec of coordinateSites)
	{
		hookAddr = RedesignedEquipmentWindow.findUnique(spec.pattern, spec.label) + (spec.offset ?? 0);
		parts = [
			[
				'83 FE 0A',
				JNE(Filler(1, 1)),
				'68 ' + RedesignedEquipmentWindow.P32(spec.y),
				'6A 75',
				JMP(Filler(2))
			].join(' '),

			[
				' ' + spec.replay,
				JMP(Filler(2))
			].join(' ')
		];
		const [, stockCoordinateTarget] = MapAddrs(parts);
		AutoHook(hookAddr, parts, {
			nops: spec.length - 5,
			localTgts: {
				'1,1': stockCoordinateTarget
			},
			targets: {
				2: spec.returnVir
			}
		});
	}

	$$(_, 3.57, 'End the synthetic ammunition row after its fixed footer item draw');
	hookAddr = RedesignedEquipmentWindow.findUnique(
		'8B CB E8 ?? ?? ?? ?? 6A 0C 6A 00 6A 00 8D 85 D8 FA FF FF',
		'Equipment ammunition post-item draw'
	) + 7;
	parts = [
		[
			'83 FE 0A',
			JE(Filler(1, 1)),
			'6A 0C 6A 00 6A 00',
			JMP(Filler(2))
		].join(' '),

		' ' + JMP(Filler(3))
	];
	const [, ammunitionDoneTarget] = MapAddrs(parts);
	AutoHook(hookAddr, parts, {
		nops: 1,
		localTgts: {
			'1,1': ammunitionDoneTarget
		},
		targets: {
			2: 0x0089802D,
			3: 0x008981F1
		}
	});
};

RedesignedEquipmentWindow.patchAmmunitionHitTest = function(_)
{
	$$(_, 3.6, 'Select native slot 15 before the stock body-only vertical prefilter');
	const pickerStarts = Exe.FindHexN(
		'8B 4D 10 83 CE FF C7 45 EC 00 00 00 00 8B 98 F4 00 00 00 8D 43 11'
	);
	if (pickerStarts.length !== 2)
		throw Error(`RedesignedEquipmentWindow: expected two ammunition picker starts, found ${pickerStarts.length}`);

	const pickerReturnVirs = [0x0089E546, 0x0089ED5E];
	for (let index = 0; index < pickerStarts.length; ++index)
	{
		const hookAddr = pickerStarts[index];
		const stockVir = Exe.Phy2Vir(hookAddr + 13, CODE);
		const parts = [
			[
				'83 B8 F0 00 00 00 00',              // General mode only
				JNE(Filler(1, 1)),
				'81 7D 0C 75 00 00 00',              // local x >= 117
				JL(Filler(1, 1)),
				'81 7D 0C 8D 00 00 00',              // local x < 141
				JGE(Filler(1, 1)),
				'8B 4D 10',
				'8B 98 F4 00 00 00',
				'8D 93 BF 00 00 00',                 // screen y >= window top + 191
				'3B CA',
				JL(Filler(1, 1)),
				'8D 93 D7 00 00 00',                 // screen y < window top + 215
				'3B CA',
				JGE(Filler(1, 1)),
				'C7 45 EC 00 00 00 00',
				'BE 0F 00 00 00',
				JMP(Filler(2))
			].join(' '),

			[
				' 8B 4D 10',                         // replay overwritten stock initialization
				'83 CE FF',
				'C7 45 EC 00 00 00 00',
				JMP(Filler(3))
			].join(' ')
		];
		const [, stockTarget] = MapAddrs(parts);
		AutoHook(hookAddr, parts, {
			nops: 8,
			localTgts: {
				'1,1': stockTarget
			},
			targets: {
				2: pickerReturnVirs[index],
				3: stockVir
			}
		});
	}
};

RedesignedEquipmentWindow.patchAmmunitionHoverLabel = function(_)
{
	$$(_, 3.63, 'Pin the Arrow balloon anchor to the closed primary-canvas position');
	const anchorAddr = RedesignedEquipmentWindow.findUnique(
		'8B 47 14 99 2B C2 D1 F8 83 E8 14 89 85 C0 FD FF FF',
		'Equipment center-column tooltip anchor'
	);
	Exe.SetHex(anchorAddr, 'B8 78 00 00 00 90 90 90 90 90 90');

	$$(_, 3.65, 'Prefix the ammunition label before its native tooltip CALL');
	const formatVir = RedesignedEquipmentWindow.writeCString('Unequip %s');
	const [bufferPhy, bufferVir] = Exe.Allocate(0x400, 0x10);
	Exe.SetUint8(bufferPhy, 0);

	const hoverStart = RedesignedEquipmentWindow.findUnique(
		'55 8B EC 6A FF 68 BF 13 EB 00 64 A1 00 00 00 00 50 81 EC 40 02 00 00',
		'Equipment mouse-move handler for ammunition balloon'
	);
	const hoverEnd = RedesignedEquipmentWindow.findUnique(
		'55 8B EC 6A FF 68 2E 14 EB 00 64 A1 00 00 00 00 50 81 EC 3C 01 00 00',
		'Equipment mouse-move handler boundary'
	);
	const labelPointerSites = Exe.FindHexN('83 78 14 10 72 02 8B 00')
		.filter(addr => addr >= hoverStart && addr < hoverEnd);
	if (labelPointerSites.length !== 4)
		throw Error(`RedesignedEquipmentWindow: expected four local Equipment label-pointer sites, found ${labelPointerSites.length}`);

	for (const hookAddr of labelPointerSites)
	{
		const returnVir = Exe.Phy2Vir(hookAddr + 8, CODE);
		const parts = [
			[
				'83 78 14 10',                     // replay std::string SSO check
				JAE(Filler(1, 1)),
				JMP(Filler(2, 1))
			].join(' '),

			' 8B 00',                             // long string data pointer

			[
				' 81 7D 08 75 00 00 00',          // local x >= 117
				JL(Filler(4, 1)),
				'81 7D 08 8D 00 00 00',           // local x < 141
				JGE(Filler(4, 1)),
				'81 7D 0C BF 00 00 00',           // local y >= 191
				JL(Filler(4, 1)),
				'81 7D 0C D7 00 00 00',           // local y < 215
				JGE(Filler(4, 1)),
				JMP(Filler(3, 1))
			].join(' '),

			[
				' 60',
				'8B 44 24 1C',                     // current native item label
				'50',
				'68 ' + RedesignedEquipmentWindow.P32(formatVir),
				'68 ' + RedesignedEquipmentWindow.P32(bufferVir),
				'FF 15 2C 16 FC 00',               // USER32!wsprintfA IAT
				'83 C4 0C',
				'61',
				'B8 ' + RedesignedEquipmentWindow.P32(bufferVir)
			].join(' '),

			' ' + JMP(Filler(10))
		];
		const [,
			longStringTarget,
			coordinateTarget,
			formatTarget,
			doneTarget
		] = MapAddrs(parts);
		AutoHook(hookAddr, parts, {
			nops: 3,
			localTgts: {
				'1,1': longStringTarget,
				'2,1': coordinateTarget,
				'3,1': formatTarget,
				'4,1': doneTarget
			},
			targets: {
				10: returnVir
			}
		});
	}
};
RedesignedEquipmentWindow.patchSwapPane = function(_, swapVir)
{
