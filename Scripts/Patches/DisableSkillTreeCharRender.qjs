*   Last Modified : 2026-06-10                                             *
*                                                                          *
*   Description   : Prevents FPS lag in the ALT+S skill tree window by     *
*                   NOPing the AddChild calls inside both UIDisplayChar    *
*                   factory functions (0x00893DF0 and 0x00893FA0).         *
*                                                                          *
*                   Combine with DisableExpensiveCharRender for full fix.  *
*                                                                          *
\**************************************************************************/

///
/// \brief NOP the AddChild call (push esi; mov ecx,edi/ebx; call) inside
///        each UIDisplayCharacter factory function. 8 bytes each.
///
DisableSkillTreeCharRender = function(_)
{
	$$(_, 1, `NOP AddChild in factory #1 (0x00893E94)`);
	Exe.SetNOPs(0x00893E94, 8);

	$$(_, 2, `NOP AddChild in factory #2 (0x00894069)`);
	Exe.SetNOPs(0x00894069, 8);

	return true;
};

///
/// \brief Validate both AddChild sites: first byte is 0x56 (push esi) or
///        already 0x90 (NOP'd from prior run).
///
DisableSkillTreeCharRender.validate = function()
{
	const b1 = Exe.GetUint8(0x00893E94);
	const b2 = Exe.GetUint8(0x00894069);
	return (b1 === 0x56 || b1 === 0x90) && (b2 === 0x56 || b2 === 0x90);
};
