*                                                                          *
*   Description   : One-click companion for custom extended names. WARP    *
*                   loads the chosen visual DLL as a normal startup import,*
*                   just like CustomRuneSystem does. Packet transport is   *
*                   controlled by the DLL config: recv for no-Gepard,      *
*                   shared/static-stub for Gepard.                         *
*                   HISTORICAL / DEBUG ONLY -- use CustomExtName instead.  *
*                                                                          *
\**************************************************************************/

CustomExtNameVisualDLL = function(_)
{
    $$(_, 1, `Add named visual DLL as startup import`);

    return CustomExtNameVisualDLL.addVisualDll(`${_}.CustomDLL`);
};

CustomExtNameVisualDLL.addVisualDll = function(_)
{
    if (typeof CustomPacketDispatch === "undefined" ||
        typeof CustomPacketDispatch.addVisualDll !== "function")
        throw Error("CustomPacketDispatch.addVisualDll helper is unavailable");

    return CustomPacketDispatch.addVisualDll(_, {
        inputKey: '$extNameVisualDLLName',
        title: "Extended Name Visual DLL",
        exportName: "ExtNameVisualInit",
        defaultName: "boh.dll",
        dedicatedName: "boh_text.dll"
    });
};

CustomExtNameVisualDLL.validate = function()
{
    return Exe.BuildDate >= 20250700;
};
