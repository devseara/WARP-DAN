*   Created Date  : 2026-06-14                                             *
*                                                                          *
*   Description   : Image-based inventory tabs. Imports a passive DLL and  *
*                   installs WARP-time vtable bridges for the inventory    *
*                   window and tab control draw/mouse handlers.            *
*                                                                          *
*                                                                          *
\**************************************************************************/

ImageBasedInventoryTabs = function(_)
{
	$$(_, 1, `Add the inventory-tabs DLL to startup imports`);
	if (typeof CustomDLL === 'undefined' || typeof CustomDLL.applySpec !== 'function')
		throw new Error("CustomDLL module not available — load CustomDLL patch first");

	const dllName = CustomDLL.getDllName(
		'$inventoryTabsDLLName',
		"Inventory Tabs DLL",
		"Enter the inventory-tabs DLL filename. Use boh.dll for the combined build or boh_inventory_tabs.dll for the dedicated build. Place it beside the patched EXE.",
		"boh.dll",
		"boh_inventory_tabs.dll"
	);

	CustomDLL.applySpec(`${_}.CustomDLL`, [
		{
			Name: dllName,
			Funcs: [
				{Name: 'InventoryTabsInit'},
				{Name: 'InventoryTabsWindowDraw'},
				{Name: 'InventoryTabsTabDraw'},
				{Name: 'InventoryTabsTabMouseMove'}
			]
		}
	]);

	ImageBasedInventoryTabs.installStaticVtableBridges(`${_}.Bridges`, dllName);
	if (typeof CustomDLL.addRefreshHook === "function")
	{
		CustomDLL.addRefreshHook(
			`${_}.Bridges`,
			function() { return ImageBasedInventoryTabs.installStaticVtableBridges(`${_}.Bridges`, dllName); }
		);
	}

	$$(_, 2, `Image-based inventory tab static bridges enabled`);
	return true;
};

ImageBasedInventoryTabs.findIat = function(dllName, exportName)
{
	const iat = (
		typeof CustomDLL !== "undefined" &&
		typeof CustomDLL.findIat === "function"
	)
		? CustomDLL.findIat(exportName, dllName)
		: Exe.FindFunc(exportName, dllName);
	if (iat < 0)
		throw Error(`ImageBasedInventoryTabs: import not found: ${dllName}!${exportName}`);
	return iat;
};

ImageBasedInventoryTabs.installBridge = function(stateByLabel, spec, dllName)
{
	const entryPhy = Exe.Vir2Phy(spec.entryVir);
	if (entryPhy < 0)
		throw Error(`ImageBasedInventoryTabs: ${spec.label} vtable entry is not mapped`);

	let state = stateByLabel[spec.label];
	const current = Exe.GetUint32(entryPhy);
	if (!state || typeof state.cavePhy !== "number" ||
	    typeof state.caveVir !== "number")
	{
		if (current !== spec.originalVir)
			throw Error(
				`ImageBasedInventoryTabs: ${spec.label} expected 0x${spec.originalVir.toString(16)}` +
				`, got 0x${current.toString(16)}`
			);

		const cave = Exe.Allocate(0x10, 0x10);
		state = {
			entryVir: spec.entryVir,
			originalVir: spec.originalVir,
			cavePhy: cave[0],
			caveVir: cave[1]
		};
	}
	else if (current !== state.caveVir && current !== spec.originalVir)
	{
		throw Error(
			`ImageBasedInventoryTabs: ${spec.label} already points to 0x${current.toString(16)}`
		);
	}

	const iat = ImageBasedInventoryTabs.findIat(dllName, spec.exportName);
	Exe.SetHex(state.cavePhy, ' FF 25 ' + iat.toHex());
	Exe.SetUint32(entryPhy, state.caveVir);
	state.iat = iat;
	stateByLabel[spec.label] = state;
};

ImageBasedInventoryTabs.installStaticVtableBridges = function(_, dllName)
{
	if (Exe.BuildDate !== 20250716)
		throw Error("ImageBasedInventoryTabs supports only the 2025-07-16 client");

	const specs = [
		{
			label: "inventory window draw",
			entryVir: 0x0103D4B0,
			originalVir: 0x00946DA0,
			exportName: "InventoryTabsWindowDraw"
		},
		{
			label: "tab control draw",
			entryVir: 0x0102DD94,
			originalVir: 0x00857910,
			exportName: "InventoryTabsTabDraw"
		},
		{
			label: "tab control mousemove",
			entryVir: 0x0102DDB4,
			originalVir: 0x0085A170,
			exportName: "InventoryTabsTabMouseMove"
		}
	];

	const cacheKey = 'ImageBasedInventoryTabs.StaticBridges';
	const stateByLabel = CACHE.get(cacheKey) ?? {};
	for (const spec of specs)
		ImageBasedInventoryTabs.installBridge(stateByLabel, spec, dllName);
	CACHE.put(cacheKey, stateByLabel);

	if (typeof PatchDiagnostics !== "undefined" &&
	    typeof PatchDiagnostics.add === "function")
		PatchDiagnostics.add('ImageBasedInventoryTabs.StaticBridges', stateByLabel);

	return true;
};

///
/// \brief Only valid for the 2025-07-16+ Ragexe family this DLL targets.
///        The DLL hard-codes 2025-07-16 client offsets and self-aborts at
///        runtime if the inventory vtable slot does not match, so guard the
///        build date here as a first line of defence.
///
ImageBasedInventoryTabs.validate = function()
{
	return Exe.BuildDate === 20250716;
};
