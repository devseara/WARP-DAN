*                                                                          *
*   Author(s)     : Louis T Steinhil                                       *
*   Last Modified : 2026-06-07                                             *
*                                                                          *
*   Description   : Loads the ping overlay command independently from FPS. *
*                                                                          *
\**************************************************************************/

PingOverlay = function(_)
{
	if (typeof CustomDLL === "undefined" ||
	    typeof CustomDLL.applySpec !== "function")
		throw Error("PingOverlay: CustomDLL.applySpec helper unavailable");
	if (typeof FpsOverlay === "undefined" ||
	    typeof FpsOverlay.getDllName !== "function")
		throw Error("PingOverlay: FpsOverlay helper unavailable");

	const dllName = FpsOverlay.getDllName();

	$$(_, 1, 'Register ping visual DLL');
	CustomDLL.applySpec(`${_}.CustomDLL`, [{
		Name: dllName,
		Funcs: [
			{Name: "FpsPingOverlayInit"},
			{Name: "TogglePingOverlay"}
		]
	}]);

	FpsOverlay.installSlashCmd(`${_}.SlashCommands`, dllName, {
		command: "/ping",
		exportName: "TogglePingOverlay"
	});
	return true;
};

PingOverlay.validate = function()
{
	return Exe.BuildDate > 0;
};
