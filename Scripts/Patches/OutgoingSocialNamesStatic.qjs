/**************************************************************************\
* Description: Serialize canonical 128-byte social request names in Main   *
* 2025-07-16. Each invocation owns a zero-initialized packet on its stack.   *
* Native networking remains responsible for encryption and FIFO ownership. *
\**************************************************************************/
OutgoingSocialNamesStatic = {};
OutgoingSocialNamesStatic.build = function(kind, copy)
{
	const a=ExtNameStaticAsm.asm(), friend=kind==="friend";
	if(friend)a.emit(0x55,0x8B,0xEC);
	a.emit(0x60,0x81,0xEC);a.dword(144);
	// Preserve the original frame and registers; reserve a private packet.
	a.emit(0x8B,0xFC,0x33,0xC0,0xB9);a.dword(36);a.emit(0xF3,0xAB,0x8B,0xF4);
	const op=friend?0x202:kind==="party"?0x1E8:kind==="invite"?0x2C4:kind==="roomrole"?0xE0:kind==="roomkick"?0xE2:kind==="guildinvite"?0x916:0x165;
	const off=(kind==="guild"||kind==="roomrole")?6:2, size=kind==="party"?132:off===6?134:130;
	a.emit(0x66,0xC7,0x06,op&255,(op>>>8)&255);
	if(friend)a.emit(0x8B,0x45,8);
	else if(kind==="party") {a.emit(0xB9);a.dword(0x015FF84C);a.call(0x005D4140);}
	else if(kind==="invite"||kind==="roomrole"||kind==="roomkick"||kind==="guildinvite") {a.emit(0x8B,0x84,0x24);a.dword(164);}
	else {a.emit(0xA1);a.dword(0x015FB9A8);a.emit(0x89,0x46,2,0x8B,0x85);a.dword(0xFFFEFC8C);}
	// Reject overlength input instead of silently producing another identity.
	a.emit(0x8B,0xD0,0x33,0xC9);a.label("scan");a.emit(0x80,0x3C,0x0A,0);a.jcc(0x84,"copy");
	a.emit(0x41,0x81,0xF9);a.dword(128);a.jcc(0x82,"scan");a.jmp("done");
	a.label("copy");a.emit(0x68);a.dword(128);a.emit(0x52,0x8D,0x46,off,0x50);a.call(copy);
	if(kind==="party") {
		a.emit(0x8B,0x85);a.dword(0xFFFEFC88);a.emit(0x88,0x86);a.dword(130);
		a.emit(0x8B,0x85);a.dword(0xFFFEFC80);a.emit(0x88,0x86);a.dword(131);
	}
	if(kind==="roomrole"){a.emit(0x8B,0x84,0x24);a.dword(168);a.emit(0x89,0x46,2);}
	a.call(0x00C14D60);a.emit(0x8B,0xC8,0x56,0x68);a.dword(size);a.call(0x00C14920);
	a.label("done");a.emit(0x81,0xC4);a.dword(144);a.emit(0x61);
	if(friend)a.emit(0x33,0xC0,0x5D,0xC2,4,0);
	else a.jmp(kind==="party"?0x00C8D0CE:kind==="invite"?0x00C8D135:kind==="roomrole"?0x00C8C25E:kind==="roomkick"?0x00C8C2CA:kind==="guildinvite"?0x00C8F19E:0x00C8F05D);
	return a;
};
OutgoingSocialNamesStatic.install = function(state)
{
	if(ExtNameTextStatic.ActiveBuildDate!==20250716 || state.outgoingSocial128)return state;
	const copy=ExtNameTextStatic.allocateCode(ExtNameTextStatic.buildCopyZ()).virAddr;
	const sites=[
		[0x00A2C600,"55 8B EC 83 EC 20","friend"],
		[0x00C8D066,"B8 E8 01 00 00","party"],
		[0x00C8D0D5,"8B CA B8 C4 02 00 00","invite"],
		[0x00C8F000,"B8 65 01 00 00","guild"],
		[0x00C8C1F3,"B8 E0 00 00 00","roomrole"],
		[0x00C8C265,"B8 E2 00 00 00","roomkick"],
		[0x00C8F143,"B8 16 09 00 00","guildinvite"]
	];
	for(const s of sites){s.push(ExtNameStaticAsm.assertCode("outgoing social packet",s[0],s[1]));s.push(ExtNameTextStatic.allocateCode(OutgoingSocialNamesStatic.build(s[2],copy)));}
	const inputLimits=[0x008AB99E,0x008AC1B2,0x0091DF9E].map(v=>ExtNameStaticAsm.assertCode("social edit capacity",v,"C7 80 88 00 00 00 17 00 00 00"));
	const gate=ExtNameStaticAsm.assertCode("party creation name gate",0x00C8CF6E,"83 F9 18 72 1D");
	const a=ExtNameStaticAsm.asm();a.emit(0x81,0xF9);a.dword(128);a.jcc(0x82,0x00C8CF90);a.jmp(0x00C8CF73);
	const limit=ExtNameTextStatic.allocateCode(a);
	const owner=Exe.ActivePatch;Exe.ActivateGlobal();Exe.BeginTag(CACHE.getTag("OutgoingSocialNamesStatic.NamePackets128"),true);
	try{
		for(const s of sites){Exe.SetJMP(s[3],s[4].virAddr,0);Exe.SetNOPs(s[3]+5,s[1].split(" ").length-5);}
		Exe.SetJMP(gate,limit.virAddr,0);
		for(const phy of inputLimits)Exe.SetUint32(phy+6,127);
	}finally{Exe.EndTag();Exe.ActivePatch=owner;}
	state.outgoingSocial128=true;return state;
};
