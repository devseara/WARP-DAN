/*
 * Description: Five native item-obtained notices on the left, newest first.
 * Target: 2025-07-16 Ragexe. Seven-second lifetime, final three seconds fade.
 * Only UINotifyItemObtainWnd owns this queue. Native pickup, chat, item title
 * formatting and all other windows retain their original handlers.
 */
LeftLootNotices = function(_)
{
	if(!LeftLootNotices.validate())throw Error("LeftLootNotices requires 2025-07-16 Ragexe");
	const n=AutoCombatUI.nativeHelpers;
	const read=path=>{const f=new BinFile(path,"r");if(!f.Valid)throw Error("LeftLootNotices: missing "+path);const h=f.ReadHex();f.Close();return(h.match(/[0-9a-fA-F]{2}/g)||[]).map(v=>parseInt(v,16));};
	const u32=(b,o)=>(b[o]|b[o+1]<<8|b[o+2]<<16|b[o+3]<<24)>>>0;
	const put=(b,o,v)=>{for(let i=0;i<4;++i)b[o+i]=v>>>(i*8)&255;};
	const bytes=read(Warp.Path+"/Inputs/LeftLootNotices/runtime.bin"),meta=JSON.parse(String.fromCharCode(...read(Warp.Path+"/Inputs/LeftLootNotices/runtime.json")));
	const size=u32(bytes,8),count=u32(bytes,12),api=u32(bytes,16),start=32+count*4;
	let crc=0xFFFFFFFF;for(let i=32;i<bytes.length;++i){crc^=bytes[i];for(let j=0;j<8;++j)crc=(crc>>>1)^((crc&1)?0xEDB88320:0);}
	if(bytes.length<32 || u32(bytes,0)!==0x544F4F4C || u32(bytes,4)!==1 || meta.version!==1 || meta.client!==20250716 ||
		start+size!==bytes.length || size!==meta.size || api!==meta.exports.LootApi || meta.api_size!==16 || api+16>size || u32(bytes,20)!==16 || u32(bytes,24)!==20250716 || ((crc^0xFFFFFFFF)>>>0)!==u32(bytes,28))throw Error("LeftLootNotices: invalid payload");
	const names=["LootApi","LootState","LootRows","@LootMessage@32","@LootDraw@8","@LootTick@8","@LootDestroy@12","@LootPosition@16"];
	for(const name of names)if(!Number.isInteger(meta.exports[name]) || meta.exports[name]<0 || meta.exports[name]>=size)throw Error("LeftLootNotices: missing "+name);
	const original=0x103274C,changes=[[0,"@LootDestroy@12",0x893200],[4,"@LootPosition@16",0x874AF0],[19,"@LootTick@8",0x8BAF00],[20,"@LootDraw@8",0x8B5520],[37,"@LootMessage@32",0x8C5860]];
	for(const [slot,name,expected] of changes)if(Exe.GetUint32(Exe.Vir2Phy(original+slot*4))!==expected)throw Error("LeftLootNotices: native vtable changed: "+name);
	n.assertCode("LeftLootNotices native constructor",0x88E5C7,"C7 06 4C 27 03 01");
	n.assertCode("LeftLootNotices complete native item copy",0x8C5ABE,"51 8D 8F F0 00 00 00 E8 26 CB DD FF");
	n.assertCode("LeftLootNotices surface resize",0xA245C0,"55 8B EC 53 8B D9 56 57 8B 4B 24");
	const code=bytes.slice(start);
	for(let i=0;i<count;++i){const off=u32(bytes,32+i*4);if(off+4>size || u32(code,off)>size+16)throw Error("LeftLootNotices: invalid relocation");}
	const [phy,vir]=Exe.Allocate(size,16),e=name=>vir+meta.exports[name];
	for(let i=0;i<count;++i){const off=u32(bytes,32+i*4);put(code,off,u32(code,off)+vir);}
	[0x8C5860,0x8B5520,0x8BAF00,0x893200].forEach((v,i)=>put(code,api+i*4,v));
	for(let i=0;i<code.length;i+=4096)Exe.SetHex(phy+i,n.bytesToHex(code.slice(i,i+4096)));
	for(const [slot,name] of changes)Exe.SetUint32(Exe.Vir2Phy(original+slot*4),e(name));
	const record=[];for(const v of [n.allocateString("LeftLootNotices.v1").vir,...names.map(e)])record.push(v&255,v>>>8&255,v>>>16&255,v>>>24);n.allocateBytes(record,4);
	return true;
};
LeftLootNotices.validate=()=>Exe.BuildDate===20250716;
