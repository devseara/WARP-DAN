*                                                                          *
*   Description   : Versioned shared telemetry renderer for 2025-07-16.    *
*                   Replays the six-byte post-Present store and draws     *
*                   registered feature channels through native GDI.      *
*                   Sampling and packet capture belong to feature files; *
*                   one shared owner retains the static EXE bridge.      *
*                                                                          *
\**************************************************************************/

NativeTelemetryOverlay = {
	ApiVersion: 1,
	Version: "1.0.0",
	Channels: {},
	BuildDate: 20250716,
	PresentStore: 0x00543441,
	PresentReturn: 0x00543447,
	PresentStoreBytes: "89 86 8C 06 00 00",
	GetOption: 0x0068EA70,
	GetModuleHandleIat: 0x00FC1268,
	GetProcAddressIat: 0x00FC1390,
	TextOutAIat: 0x00FC10D8,
	SetTextColorIat: 0x00FC10E0,
	SetBkModeIat: 0x00FC10E8,
	CreateFontAIat: 0x00FC1114,
	SelectObjectIat: 0x00FC1120,
	GetClientRectIat: 0x00FC16B8,
	GetDCIat: 0x00FC16D8,
	StateReleaseDC: 40,
	StateFont: 108,
	StateFontSize: 112,
	StateSize: 116,
	CacheKey: "NativeTelemetryOverlay"
};

// Descriptors are registered while WARP loads feature scripts; no EXE writes.
// The core has no FPS sampler or Ping packet capture implementation.
NativeTelemetryOverlay.requireApi = function(version)
{
	if (version !== NativeTelemetryOverlay.ApiVersion)
		throw Error("NativeTelemetryOverlay: incompatible support API; install a matching customer package");
};

NativeTelemetryOverlay.registerChannel = function(channel)
{
	NativeTelemetryOverlay.requireApi(channel.apiVersion);
	if (!channel.id || NativeTelemetryOverlay.Channels[channel.id] ||
		!Number.isInteger(channel.flag) || ![1, 2].includes(channel.flag) ||
		typeof channel.emitColor !== "function")
		throw Error("NativeTelemetryOverlay: invalid or duplicate channel");
	for (const existing of Object.values(NativeTelemetryOverlay.Channels))
		if (existing.flag === channel.flag)
			throw Error("NativeTelemetryOverlay: duplicate channel slot");
	NativeTelemetryOverlay.Channels[channel.id] = channel;
};

NativeTelemetryOverlay.bytesToHex = function(bytes)
{
	return bytes.map(value =>
		(value & 0xFF).toString(16).padStart(2, "0")
	).join(" ");
};

NativeTelemetryOverlay.asm = function()
{
	const bytes = [];
	const labels = {};
	const fixups = [];
	const put32 = function(out, pos, value)
	{
		const v = value >>> 0;
		out[pos] = v & 0xFF;
		out[pos + 1] = (v >>> 8) & 0xFF;
		out[pos + 2] = (v >>> 16) & 0xFF;
		out[pos + 3] = (v >>> 24) & 0xFF;
	};

	return {
		bytes,
		emit: function(...values)
		{
			for (const value of values)
				bytes.push(value & 0xFF);
		},
		dword: function(value)
		{
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			put32(bytes, pos, value);
		},
		label: function(name)
		{
			if (Object.prototype.hasOwnProperty.call(labels, name))
				throw Error(`NativeTelemetryOverlay: duplicate label ${name}`);
			labels[name] = bytes.length;
		},
		rel32: function(opcode, target)
		{
			bytes.push(opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		call: function(target) { this.rel32(0xE8, target); },
		jmp: function(target) { this.rel32(0xE9, target); },
		jcc: function(opcode, target)
		{
			bytes.push(0x0F, opcode);
			const pos = bytes.length;
			bytes.push(0, 0, 0, 0);
			fixups.push({pos, target});
		},
		finish: function(baseVir)
		{
			const out = bytes.slice();
			for (const fixup of fixups)
			{
				if (typeof fixup.target === "string" &&
					!Object.prototype.hasOwnProperty.call(labels, fixup.target))
					throw Error(`NativeTelemetryOverlay: unresolved label ${fixup.target}`);
				const targetVir = typeof fixup.target === "string"
					? baseVir + labels[fixup.target]
					: fixup.target;
				put32(out, fixup.pos, targetVir - (baseVir + fixup.pos + 4));
			}
			return NativeTelemetryOverlay.bytesToHex(out);
		}
	};
};

NativeTelemetryOverlay.allocateBytes = function(bytes, alignment = 1)
{
	const [phyAddr, virAddr] = Exe.Allocate(bytes.length, alignment);
	Exe.SetHex(phyAddr, NativeTelemetryOverlay.bytesToHex(bytes));
	return {phyAddr, virAddr, size: bytes.length};
};

NativeTelemetryOverlay.allocateText = function(text)
{
	const bytes = [];
	for (let i = 0; i < text.length; ++i)
		bytes.push(text.charCodeAt(i) & 0x7F);
	bytes.push(0);
	return NativeTelemetryOverlay.allocateBytes(bytes, 1);
};

NativeTelemetryOverlay.allocateCode = function(assembler)
{
	const [phyAddr, virAddr] = Exe.Allocate(assembler.bytes.length, 0x10);
	Exe.SetHex(phyAddr, assembler.finish(virAddr));
	return {phyAddr, virAddr, size: assembler.bytes.length};
};

NativeTelemetryOverlay.assertCode = function(label, virAddr, expectedHex)
{
	const phyAddr = Exe.Vir2Phy(virAddr, CODE);
	if (phyAddr < 0)
		throw Error(`NativeTelemetryOverlay: ${label} is not mapped`);
	const expected = expectedHex.replace(/\s+/g, " ").trim().toUpperCase();
	const actual = Exe.GetHex(phyAddr, expected.split(" ").length)
		.replace(/\s+/g, " ").trim().toUpperCase();
	if (actual !== expected)
		throw Error(`NativeTelemetryOverlay: ${label} mismatch, got ${actual}`);
	return phyAddr;
};

NativeTelemetryOverlay.buildFormat = function()
{
	const a = NativeTelemetryOverlay.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x10, 0x53, 0x56, 0x57);
	a.emit(0x8B, 0x7D, 0x08, 0x8B, 0x75, 0x0C);
	a.label("copy_prefix");
	a.emit(0xAC, 0x84, 0xC0);
	a.jcc(0x84, "digits");
	a.emit(0xAA);
	a.jmp("copy_prefix");
	a.label("digits");
	a.emit(0x8B, 0x45, 0x10, 0x85, 0xC0);
	a.jcc(0x85, "convert");
	a.emit(0xC6, 0x07, 0x30, 0x47);
	a.jmp("suffix");
	a.label("convert");
	a.emit(0xBB); a.dword(10);
	a.emit(0x33, 0xC9);
	a.label("convert_loop");
	a.emit(0x33, 0xD2, 0xF7, 0xF3, 0x80, 0xC2, 0x30);
	a.emit(0x88, 0x54, 0x0D, 0xF0, 0x41, 0x85, 0xC0);
	a.jcc(0x85, "convert_loop");
	a.label("reverse_loop");
	a.emit(0x49, 0x8A, 0x54, 0x0D, 0xF0, 0x88, 0x17, 0x47, 0x85, 0xC9);
	a.jcc(0x85, "reverse_loop");
	a.label("suffix");
	a.emit(0x8B, 0x75, 0x14);
	a.label("copy_suffix");
	a.emit(0xAC, 0x84, 0xC0);
	a.jcc(0x84, "finish");
	a.emit(0xAA);
	a.jmp("copy_suffix");
	a.label("finish");
	a.emit(0xC6, 0x07, 0x00, 0x8B, 0xC7, 0x2B, 0x45, 0x08);
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x10, 0x00);
	return a;
};

NativeTelemetryOverlay.callIat = function(a, iat)
{
	a.emit(0xFF, 0x15); a.dword(iat);
};

NativeTelemetryOverlay.buildDrawLine = function()
{
	const a = NativeTelemetryOverlay.asm();
	a.emit(0x55, 0x8B, 0xEC);
	a.emit(0x6A, 0x00, 0xFF, 0x75, 0x08);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.SetTextColorIat);
	a.emit(0xFF, 0x75, 0x18, 0xFF, 0x75, 0x14);
	a.emit(0x8B, 0x45, 0x10, 0x40, 0x50);
	a.emit(0x8B, 0x45, 0x0C, 0x40, 0x50, 0xFF, 0x75, 0x08);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.TextOutAIat);
	a.emit(0xFF, 0x75, 0x1C);
	a.emit(0xFF, 0x75, 0x08);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.SetTextColorIat);
	a.emit(0xFF, 0x75, 0x18, 0xFF, 0x75, 0x14, 0xFF, 0x75, 0x10);
	a.emit(0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.TextOutAIat);
	a.emit(0x5D, 0xC2, 0x18, 0x00);
	return a;
};

NativeTelemetryOverlay.emitOptionCheck = function(a, installedVir, optionId, flag)
{
	a.emit(0x83, 0x3D); a.dword(installedVir); a.emit(0x00);
	a.jcc(0x84, `option_${flag}_done`);
	a.emit(0x68); a.dword(optionId);
	a.call(NativeTelemetryOverlay.GetOption);
	a.emit(0x83, 0xC4, 0x04, 0x84, 0xC0);
	a.jcc(0x84, `option_${flag}_done`);
	a.emit(0x83, 0xCF, flag);
	a.label(`option_${flag}_done`);
};

NativeTelemetryOverlay.emitLine = function(
	a,
	stateVir,
	flag,
	xOffset,
	yOffset,
	valueOffset,
	bufferOffset,
	prefixVir,
	suffixVir,
	formatVir,
	drawLineVir,
	emitColor
)
{
	a.emit(0xF7, 0xC7); a.dword(flag);
	a.jcc(0x84, `line_${flag}_done`);
	a.emit(0xA1); a.dword(stateVir + xOffset);
	a.emit(0x85, 0xC0);
	a.jcc(0x89, `line_${flag}_x_ready`);
	a.emit(0x03, 0x45, 0x10);
	a.label(`line_${flag}_x_ready`);
	a.emit(0x89, 0x45, 0x00);
	a.emit(0xA1); a.dword(stateVir + yOffset);
	a.emit(0x85, 0xC0);
	a.jcc(0x89, `line_${flag}_y_ready`);
	a.emit(0x03, 0x45, 0x14);
	a.label(`line_${flag}_y_ready`);
	a.emit(0x89, 0x45, 0x04);
	a.emit(0x68); a.dword(suffixVir);
	a.emit(0xFF, 0x35); a.dword(stateVir + valueOffset);
	a.emit(0x68); a.dword(prefixVir);
	a.emit(0x68); a.dword(stateVir + bufferOffset);
	a.call(formatVir);
	emitColor(a, stateVir + valueOffset, flag);
	a.emit(0x50);
	a.emit(0x68); a.dword(stateVir + bufferOffset);
	a.emit(0xFF, 0x75, 0x04, 0xFF, 0x75, 0x00, 0xFF, 0x75, 0x1C);
	a.call(drawLineVir);
	a.label(`line_${flag}_done`);
};

NativeTelemetryOverlay.buildPresent = function(
	stateVir,
	formatVir,
	drawLineVir,
	channels,
	fontFaceVir,
	user32Vir,
	releaseDCVir
)
{
	const a = NativeTelemetryOverlay.asm();
	a.emit(0x89, 0x86, 0x8C, 0x06, 0x00, 0x00);
	a.emit(0x9C, 0x60, 0x83, 0xEC, 0x24, 0x8B, 0xEC);
	a.emit(0xC7, 0x45, 0x20); a.dword(0);
	for (const channel of channels)
	{
		if (!channel.emitSample) continue;
		a.emit(0x83, 0x3D); a.dword(stateVir + channel.installedOffset); a.emit(0);
		a.jcc(0x84, `sample_${channel.flag}_done`);
		channel.emitSample(a, stateVir);
		a.label(`sample_${channel.flag}_done`);
	}
	a.emit(0x33, 0xFF);
	for (const channel of channels)
		NativeTelemetryOverlay.emitOptionCheck(
			a, stateVir + channel.installedOffset, channel.optionId, channel.flag);
	a.emit(0x85, 0xFF);
	a.jcc(0x84, "cleanup");
	a.emit(0x8B, 0x45, 0x28, 0x8B, 0x00, 0x89, 0x45, 0x18);
	a.emit(0x8D, 0x4D, 0x00, 0x51, 0x50);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.GetClientRectIat);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "cleanup");
	a.emit(0x8B, 0x45, 0x08, 0x2B, 0x45, 0x00, 0x89, 0x45, 0x10);
	a.emit(0x8B, 0x45, 0x0C, 0x2B, 0x45, 0x04, 0x89, 0x45, 0x14);
	a.emit(0xFF, 0x75, 0x18);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.GetDCIat);
	a.emit(0x89, 0x45, 0x1C, 0x85, 0xC0);
	a.jcc(0x84, "cleanup");
	a.emit(0x83, 0x3D); a.dword(stateVir + NativeTelemetryOverlay.StateReleaseDC); a.emit(0x00);
	a.jcc(0x85, "release_ready");
	a.emit(0x68); a.dword(user32Vir);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.GetModuleHandleIat);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "release_ready");
	a.emit(0x68); a.dword(releaseDCVir);
	a.emit(0x50);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.GetProcAddressIat);
	a.emit(0xA3); a.dword(stateVir + NativeTelemetryOverlay.StateReleaseDC);
	a.label("release_ready");
	a.emit(0x6A, 0x01, 0xFF, 0x75, 0x1C);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.SetBkModeIat);
	a.emit(0xA1); a.dword(stateVir + NativeTelemetryOverlay.StateFont);
	a.emit(0x85, 0xC0);
	a.jcc(0x85, "font_ready");
	a.emit(0x68); a.dword(fontFaceVir);
	a.emit(0x6A, 0x00, 0x6A, 0x05, 0x6A, 0x00, 0x6A, 0x00);
	a.emit(0x6A, 0x01, 0x6A, 0x00, 0x6A, 0x00, 0x6A, 0x00);
	a.emit(0x68); a.dword(400);
	a.emit(0x6A, 0x00, 0x6A, 0x00, 0x6A, 0x00);
	a.emit(0xA1); a.dword(stateVir + NativeTelemetryOverlay.StateFontSize);
	a.emit(0xF7, 0xD8, 0x50);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.CreateFontAIat);
	a.emit(0xA3); a.dword(stateVir + NativeTelemetryOverlay.StateFont);
	a.label("font_ready");
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "font_selected");
	a.emit(0x50, 0xFF, 0x75, 0x1C);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.SelectObjectIat);
	a.emit(0x89, 0x45, 0x20);
	a.label("font_selected");
	for (const channel of channels)
		NativeTelemetryOverlay.emitLine(
			a, stateVir, channel.flag, channel.xOffset, channel.yOffset,
			channel.valueOffset, channel.bufferOffset, channel.prefixVir,
			channel.suffixVir, formatVir, drawLineVir, channel.emitColor);
	a.emit(0x8B, 0x45, 0x20, 0x85, 0xC0);
	a.jcc(0x84, "font_restored");
	a.emit(0x83, 0xF8, 0xFF);
	a.jcc(0x84, "font_restored");
	a.emit(0x50, 0xFF, 0x75, 0x1C);
	NativeTelemetryOverlay.callIat(a, NativeTelemetryOverlay.SelectObjectIat);
	a.label("font_restored");
	a.emit(0xA1); a.dword(stateVir + NativeTelemetryOverlay.StateReleaseDC);
	a.emit(0x85, 0xC0);
	a.jcc(0x84, "cleanup");
	a.emit(0xFF, 0x75, 0x1C, 0xFF, 0x75, 0x18, 0xFF, 0xD0);
	a.label("cleanup");
	a.emit(0x83, 0xC4, 0x24, 0x61, 0x9D);
	a.jmp(NativeTelemetryOverlay.PresentReturn);
	return a;
};

NativeTelemetryOverlay.buildToggle = function(optionId)
{
	const a = NativeTelemetryOverlay.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x68); a.dword(optionId);
	a.call(NativeTelemetryOverlay.GetOption);
	a.emit(0x83, 0xC4, 0x04, 0x84, 0xC0, 0x0F, 0x94, 0xC0);
	a.emit(0x0F, 0xB6, 0xC0, 0x50, 0x68); a.dword(optionId);
	a.call(0x0068FD50);
	a.emit(0x83, 0xC4, 0x08, 0x5D, 0xC3);
	return a;
};

NativeTelemetryOverlay.getCoordinates = function(inputKey, title, defaults)
{
	const result = Exe.GetUserInput(
		inputKey,
		D_VecI16,
		title,
		"Enter overlay coordinates (negative values are w.r.t. the client right/bottom side)",
		defaults,
		{
			name0: "X Coord ", min0: -7680, max0: 7680,
			name1: "Y Coord ", min1: -4320, max1: 4320
		}
	);
	if (result === false)
		Cancel("Coordinates", `(${defaults[0]},${defaults[1]})`);
	return result;
};

NativeTelemetryOverlay.getFontSettings = function()
{
	const cacheKey = `${NativeTelemetryOverlay.CacheKey}.FontSettings`;
	const existing = CACHE.get(cacheKey);
	if (existing)
		return existing;
	const name = Exe.GetUserInput(
		"$telemetryFontName",
		D_FontName,
		"Overlay Font",
		"Select the Overlay overlay font family",
		"Arial",
		{saveDefault: true, sampleSize: 14}
	);
	if (name === false)
		Cancel("Overlay Font", "Arial");
	const size = Exe.GetUserInput(
		"$telemetryFontSize",
		D_FontSize,
		"Overlay Font Size",
		"Select the Overlay overlay font size",
		14,
		{sampleName: name}
	);
	if (size === false)
		Cancel("Overlay Font Size", 14);
	const settings = {name, size};
	CACHE.put(cacheKey, settings);
	return settings;
};

NativeTelemetryOverlay.ensure = function(patchName)
{
	const cacheKey = NativeTelemetryOverlay.CacheKey;
	if (!CACHE.getTag(cacheKey))
		CACHE.setup(cacheKey, "NativeTelemetryOverlay.Runtime.v1", {
			cleanTag_after_userDel: false
		});
	const firstUser = !CACHE.hasUsers(cacheKey);
	if (!firstUser)
	{
		const existing = CACHE.get(`${cacheKey}.State`);
		if (!existing) throw Error("NativeTelemetryOverlay: shared state missing");
		CACHE.addUser(cacheKey, patchName);
		return existing;
	}

	if (Exe.BuildDate !== NativeTelemetryOverlay.BuildDate)
		throw Error("NativeTelemetryOverlay supports only the 2025-07-16 client");

	const callerPatch = Exe.ActivePatch;
	Exe.ActivateGlobal();
	Exe.BeginTag(CACHE.getTag(cacheKey));
	try
	{
		const fontSettings = NativeTelemetryOverlay.getFontSettings();
		const sitePhy = NativeTelemetryOverlay.assertCode(
			"post-Present store",
			NativeTelemetryOverlay.PresentStore,
			NativeTelemetryOverlay.PresentStoreBytes
		);
		const state = NativeTelemetryOverlay.allocateBytes(
			new Array(NativeTelemetryOverlay.StateSize).fill(0),
			0x10
		);
		Exe.SetUint32(
			state.phyAddr + NativeTelemetryOverlay.StateFontSize,
			fontSettings.size
		);
		const channels = Object.values(NativeTelemetryOverlay.Channels)
			.sort((a, b) => a.flag - b.flag).map(channel => Object.assign({}, channel, {
				prefixVir: NativeTelemetryOverlay.allocateText(channel.prefix).virAddr,
				suffixVir: NativeTelemetryOverlay.allocateText(channel.suffix).virAddr
			}));
		if (channels.length === 0) throw Error("NativeTelemetryOverlay: no feature modules loaded");
		const fontFace = NativeTelemetryOverlay.allocateText(fontSettings.name);
		const user32 = NativeTelemetryOverlay.allocateText("user32.dll");
		const releaseDC = NativeTelemetryOverlay.allocateText("ReleaseDC");
		const format = NativeTelemetryOverlay.allocateCode(
			NativeTelemetryOverlay.buildFormat()
		);
		const drawLine = NativeTelemetryOverlay.allocateCode(
			NativeTelemetryOverlay.buildDrawLine()
		);
		const present = NativeTelemetryOverlay.allocateCode(
			NativeTelemetryOverlay.buildPresent(
				state.virAddr,
				format.virAddr,
				drawLine.virAddr,
				channels,
				fontFace.virAddr,
				user32.virAddr,
				releaseDC.virAddr
			)
		);
		Exe.SetJMP(sitePhy, present.virAddr, 1);
		const result = {
			statePhy: state.phyAddr,
			stateVir: state.virAddr,
			presentVir: present.virAddr,
			channels: channels.map(channel => channel.id),
			formatVir: format.virAddr,
			drawLineVir: drawLine.virAddr
		};
		CACHE.put(`${cacheKey}.State`, result);
		CACHE.addUser(cacheKey, patchName);
		return result;
	}
	catch (error)
	{
		CACHE.cleanTag(cacheKey, true);
		CACHE.del(`${cacheKey}.State`);
		throw error;
	}
	finally
	{
		Exe.EndTag();
		Exe.ActivePatch = callerPatch;
	}
};

NativeTelemetryOverlay.configure = function(state, installedOffset, xOffset, yOffset, coordinates)
{
	const callerPatch = Exe.ActivePatch;
	Exe.ActivateGlobal();
	Exe.BeginTag(`NativeTelemetryOverlay.Config.${installedOffset}`);
	try
	{
		Exe.SetUint32(state.statePhy + installedOffset, 1);
		Exe.SetUint32(state.statePhy + xOffset, coordinates[0] >>> 0);
		Exe.SetUint32(state.statePhy + yOffset, coordinates[1] >>> 0);
	}
	finally
	{
		Exe.EndTag();
		Exe.ActivePatch = callerPatch;
	}
};

NativeTelemetryOverlay.disable = function(installedOffset)
{
	// Configuration has its own tag: opening a WARP tag replaces its writes.
	// Never reopen the code-allocation tag merely to update an enable flag.
	Exe.DelTag(`NativeTelemetryOverlay.Config.${installedOffset}`);
};

NativeTelemetryOverlay.registerCommand = function(_, command, optionId)
{
	if (typeof CustomSlashCommand === "undefined" ||
		typeof CustomSlashCommand.register !== "function")
		throw Error("NativeTelemetryOverlay: CustomSlashCommand helper unavailable");
	const toggle = NativeTelemetryOverlay.allocateCode(
		NativeTelemetryOverlay.buildToggle(optionId)
	);
	CustomSlashCommand.register(`${_}.SlashCommand`, {
		command,
		targetVir: toggle.virAddr,
		optionId
	});
	return toggle.virAddr;
};

NativeTelemetryOverlay.release = function(patchName, installedOffset)
{
	// Remove command targets before WARP clears the feature's private caves.
	CustomSlashCommand.unregister(patchName);
	NativeTelemetryOverlay.disable(installedOffset);
	CACHE.delUser(NativeTelemetryOverlay.CacheKey, patchName);
	if (!CACHE.hasUsers(NativeTelemetryOverlay.CacheKey))
		CACHE.del(`${NativeTelemetryOverlay.CacheKey}.State`);
};
